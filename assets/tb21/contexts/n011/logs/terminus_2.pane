[?2004l[?2004h> import struct, math
[?2004l[?2004h> f=open('gpt2-124M.ckpt','rb').read()
[?2004l[?2004h> n=len(f)//4
[?2004l[?2004h> 
[?2004l[?2004h> def chunk_stats(off,size):
[?2004l[?2004h>     a=struct.unpack_from('<%df'%size, f, off*4)
[?2004l[?2004h>     m=sum(a)/size
[?2004l[?2004h>     var=sum((x-m)**2 for x in a)/size
[?2004l[?2004h>     return m, math.sqrt(var), min(a), max(a)
[?2004l[?2004h> 
[?2004l[?2004h> # Scan for 768-length segments with mean >0.7 (LN gains) at candidate offsets.
[?2004l[?2004h> print('Scan LN-gain-like 768 segments')
[?2004l[?2004h> # candidate offsets every 768 up to maybe 50M floats, but after embeddings only
[?2004l[?2004h> for off in range(39_000_000, 50_000_000, 768):
[?2004l[?2004h>     m,s,mn,mx=chunk_stats(off,768)
[?2004l[?2004h>     if m>0.6 and s<0.2:
[?2004l[?2004h>         print(off, off*4, m,s,mn,mx)
[?2004l[?2004h> 
[?2004l[?2004h> print('Scan bias-like 768 segments with |mean| small, std<0.1')
[?2004l[?2004h> c=0
[?2004l[?2004h> for off in range(39_000_000, 100_000_000, 768):
[?2004l[?2004h>     m,s,mn,mx=chunk_stats(off,768)
[?2004l[?2004h>     if abs(m)<0.03 and s<0.08:
[?2004l[?2004h>         print(off, off*4, m,s,mn,mx)
[?2004l[?2004h>         c+=1
[?2004l[?2004h>         if c>40: break
[?2004l[?2004h> 
[?2004l[?2004h> # Look at first ~40M offset 39,383,808 etc
[?2004l[?2004h> for off in [0, 786432, 38597376, 39383808, 39384576, 39386112, 39386880, 39392256, 39393024, 39395328, 39396096]:
[?2004l[?2004h>     m,s,mn,mx=chunk_stats(off,768)
