[?2004l[?2004h> import struct, math
[?2004l[?2004h> f=open('gpt2-124M.ckpt','rb').read()
[?2004l[?2004h> n=len(f)//4
[?2004l[?2004h> 
[?2004l[?2004h> def row_stats(off):
[?2004l[?2004h>     a=struct.unpack_from('<768f', f, off*4)
[?2004l[?2004h>     m=sum(a)/768
[?2004l[?2004h>     s=math.sqrt(sum((x-m)*(x-m) for x in a)/768)
[?2004l[?2004h>     return m,s
[?2004l[?2004h> 
[?2004l[?2004h> # Sample row stats for possible wte ranges: start 0, 786432, 38597376, and after all blocks
[?2004l[?2004h> for base in [0, 786432, 38597376, 124439808-38597376-786432]:
[?2004l[?2004h>     print('base',base)
[?2004l[?2004h>     vals=[]
[?2004l[?2004h>     for i in range(20):
[?2004l[?2004h>         o=base+i*768
[?2004l[?2004h>         if o+768<=n:
[?2004l[?2004h>             m,s=row_stats(o)
[?2004l[?2004h>             vals.append(round(s,4))
[?2004l[?2004h>     print('first 20 std', vals)
[?2004l[?2004h>     if base+1024*768<=n:
[?2004l[?2004h>         adj=0
[?2004l[?2004h>         for i in range(1023):
[?2004l[?2004h>             _,s1=row_stats(base+i*768); _,s2=row_stats(base+(i+1)*768)
[?2004l[?2004h>             adj += abs(s1-s2)/1023
[?2004l[?2004h>         print('adj std diff first 1024',adj)
[?2004l[?2004h> # Search for a large range where row std stable around .1-.15 by scanning all starts at 768 intervals
[?2004l[?2004h> best=[]
[?2004l[?2004h> for base in range(0,n-50257*768+1,768):
[?2004l[?2004h>     ss=[]
[?2004l[?2004h>     for i in range(0,50257,100):
[?2004l[?2004h>         m,s=row_stats(base+i*768)
[?2004l[?2004h>         ss.append(s)
[?2004l[?2004h>     avg=sum(ss)/len(ss); dev=math.sqrt(sum((x-avg)**2 for x in ss)/len(ss))
[?2004l[?2004h>     best.append((dev,avg,base))
[?2004l[?2004h> best.sort()
[?2004l[?2004h> print('best sampled embedding-like starts')
[?2004l[?2004h> for dev,avg,base in best[:10]: print(base,avg,dev)
