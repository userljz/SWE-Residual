[?2004l[?2004h>     var=sum((x-m)*(x-m) for x in a)/768
[?2004l[?2004h>     s=math.sqrt(var)
[?2004l[?2004h>     mn=min(a); mx=max(a)
[?2004l[?2004h>     if 0.5<m<1.5 and s<0.3:
