[?2004l[?2004h>     # forward primer = fwd_tail + tmpl[fwd_s:fwd_s+fwd_len]
[?2004l[?2004h>     # reverse primer = rev_tail + rc(tmpl[rev_s:rev_s+rev_len])
[?2004l[?2004h>     # product top = fwd_tail + tmpl[fwd_s:fwd_s+fwd_len] + tmpl[fwd_s+fwd_len:rev_s] + rc(rev_tail)
