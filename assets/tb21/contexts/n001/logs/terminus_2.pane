[?2004l[?2004h> 
[?2004l[?2004h> def bp_ok(a,b):
[?2004l[?2004h>     # a and b antiparallel strands that should base-pair (both given 5'->3')
[?2004l[?2004h>     for i in range(len(a)):
[?2004l[?2004h>         x=a[i]; y=b[3-i]
[?2004l[?2004h>         if not ((x,y) in [('a','t'),('t','a'),('g','c'),('c','g')]):
[?2004l[?2004h>             return False
[?2004l[?2004h>     return True
[?2004l[?2004h> 
[?2004l[?2004h> print("Junction base-pairing check (L right-end bottom vs R left-end top=ovL[R]):")
[?2004l[?2004h> for i in range(4):
[?2004l[?2004h>     L=order[i]; R=order[(i+1)%4]
[?2004l[?2004h>     candA=ovL[R]      # candidate A: rev_code = ovL[R]
[?2004l[?2004h>     candB=rc(ovL[R])  # candidate B: rev_code = rc(ovL[R])
[?2004l[?2004h>     print(f"\n{L} -> {R}: R's left top overhang = {ovL[R]}")
[?2004l[?2004h>     print(f"  candA rev_code={candA}: bp_ok={bp_ok(candA, ovL[R])}")
[?2004l[?2004h>     print(f"  candB rev_code={candB}: bp_ok={bp_ok(candB, ovL[R])}")
[?2004l[?2004h> 
[?2004l[?2004h> # Now determine which candidate corresponds to 'the part that is the non-annealed 5' tail'
[?2004l[?2004h> # In a real Golden Gate: rev primer 5' = [overhang][anneal to bottom of template near rev_end]
[?2004l[?2004h> # The overhang tail after digestion on the top strand = the overhang. 
[?2004l[?2004h> # The top-strand 5' overhang at a fragment's RIGHT end equals the rev primer's 5' overhang code.
[?2004l[?2004h> # That top overhang must = the right end's 5' single-strand extension = the 4nt that pairs with the NEXT fragment's left-bottom.
[?2004l[?2004h> # Equivalent: top overhang at right end = ovL[next]. So rev_code (top,5') = ovL[next] = candA.
[?2004l[?2004h> # But wait: the rev primer's 5' tail is on the BOTTOM strand after extension? Let's just trust: top right overhang = ovL[next].
[?2004l[?2004h> print("\n=> Reverse primer 5' overhang code should = ovL[next] (candidate A) so that the digest leaves the top-strand 4nt = ovL[next].")
