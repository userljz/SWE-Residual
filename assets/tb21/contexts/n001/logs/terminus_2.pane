[?2004l[?2004h> def bsaI_digest(top, d_top, d_bot):
[?2004l[?2004h>     # Find BsaI sites. Site on top strand: top[i:i+6]=='GGTCTC'.
[?2004l[?2004h>     # Site on bottom strand: rc(top)[i:i+6]=='GGTCTC' i.e. top[i:i+6]=='GAGACC'.
[?2004l[?2004h>     n=len(top)
[?2004l[?2004h>     cuts=[]  # (strand, cut_pos) where cut_pos is 0-based position 'after' which nt (index into top strand coords)
[?2004l[?2004h>     # We'll represent cuts as positions on the top-strand coordinate axis (0..n), a cut at position p means between nt p-1 and p.
[?2004l[?2004h>     for i in range(n-5):
[?2004l[?2004h>         if top[i:i+6]=='GGTCTC':
[?2004l[?2004h>             # top-strand site; cut top at i+6+d_top, bottom at i+6+d_bot (positions on top axis)
[?2004l[?2004h>             cuts.append(('T', i+6+d_top))
[?2004l[?2004h>             cuts.append(('B', i+6+d_bot))
[?2004l[?2004h>         if top[i:i+6]=='GAGACC':
[?2004l[?2004h>             # bottom-strand site (GAGACC on top = GGTCTC on bottom 5'->3')
[?2004l[?2004h>             # bottom 5'->3' corresponds to top axis going right->left. The site on bottom at index i in rc(top)
[?2004l[?2004h>             # maps to top axis position (n-1-i-5) .. (n-1-i). Cutting bottom 'd' downstream (in bottom 5'->3')
[?2004l[?2004h>             # = moving toward bottom 5' = decreasing top index. So cut bottom at (n-1-i-5) - d_bot?
[?2004l[?2004h>             # Let's compute: rc(top) index i corresponds to top index n-1-i. The site occupies rc(top)[i:i+6] = top[n-1-i : n-1-i-6 : -1].
[?2004l[?2004h>             # 'd downstream' on the bottom (5'->3', which is top n-1-i down to n-1-i-6) means moving toward bottom 5' end = smaller top index.
[?2004l[?2004h>             # The recognition's 'end' on the bottom (3' side in bottom 5'->3') is at top index n-1-i-5.
[?2004l[?2004h>             # d downstream on bottom = top index n-1-i-5 - d.
[?2004l[?2004h>             cuts.append(('B', n-1-i-5-d_bot))
[?2004l[?2004h>             cuts.append(('T', n-1-i-5-d_top))
[?2004l[?2004h>     return cuts
