[?2004l[?2004h> def read_fasta(fn):
[?2004l[?2004h>     seqs={}; name=None
[?2004l[?2004h>     with open(fn) as f:
[?2004l[?2004h>         for line in f:
[?2004l[?2004h>             line=line.strip()
[?2004l[?2004h>             if not line: continue
[?2004l[?2004h>             if line.startswith('>'): name=line[1:].strip(); seqs[name]=''
[?2004l[?2004h>             else: seqs[name]+=line
[?2004l[?2004h>     return seqs
[?2004l[?2004h> seqs=read_fasta('/app/sequences.fasta')
[?2004l[?2004h> inp=seqs['input']; egfp=seqs['egfp']; flag=seqs['flag']; snap=seqs['snap']; output=seqs['output']
[?2004l[?2004h> 
[?2004l[?2004h> LCP=0
[?2004l[?2004h> while LCP<min(len(inp),len(output)) and inp[LCP]==output[LCP]: LCP+=1
[?2004l[?2004h> LCS=0
[?2004l[?2004h> while LCS<min(len(inp),len(output)) and inp[-1-LCS]==output[-1-LCS]: LCS+=1
[?2004l[?2004h> M=output[LCP:len(output)-LCS]
[?2004l[?2004h> print("LCP",LCP,"LCS",LCS)
[?2004l[?2004h> print("M len", len(M))
[?2004l[?2004h> print("M[0:40]   =", M[0:40])
[?2004l[?2004h> print("egfp[0:40]=", egfp[0:40])
[?2004l[?2004h> 
[?2004l[?2004h> # egfp part: find i and max L such that M[0:L]==egfp[i:i+L]
[?2004l[?2004h> best=(0,0)
[?2004l[?2004h> for i in range(len(egfp)):
[?2004l[?2004h>     L=0
[?2004l[?2004h>     while L<min(len(M),len(egfp)-i) and M[L]==egfp[i+L]:
[?2004l[?2004h>         L+=1
[?2004l[?2004h>     if L>best[0]:
[?2004l[?2004h>         best=(L,i)
[?2004l[?2004h> L_eg, i_eg = best
[?2004l[?2004h> print(f"\nEGFP in M: starts at M[0], egfp index {i_eg}, matched {L_eg} nt")
[?2004l[?2004h> print(f"egfp[{i_eg}:{i_eg+L_eg}] = {egfp[i_eg:i_eg+L_eg]}")
[?2004l[?2004h> print(f"egfp full len {len(egfp)}, so egfp[{i_eg+L_eg}:] missing at end = {egfp[i_eg+L_eg:]} (len {len(egfp)-(i_eg+L_eg)})")
[?2004l[?2004h> 
[?2004l[?2004h> pos_in_M = L_eg  # end of egfp in M
[?2004l[?2004h> print(f"\nM[{pos_in_M-5}:{pos_in_M+25}] = {M[pos_in_M-5:pos_in_M+25]}")
[?2004l[?2004h> print(f"egfp tail: ...{egfp[i_eg+L_eg-5:i_eg+L_eg]}")
[?2004l[?2004h> 
[?2004l[?2004h> # Now flag: search for flag in M[pos_in_M:] with overhang. find best (j, k) such that M[pos_in_M+ov:]==flag[j:j+k]
[?2004l[?2004h> # Let's search all positions in a window and flag start index
[?2004l[?2004h> # find where flag matches best in M from pos_in_M onward
[?2004l[?2004h> def find_gene_in(gene, M, start, window=20):
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for p in range(start, min(len(M), start+window)):
[?2004l[?2004h>         for j in range(len(gene)):
[?2004l[?2004h>             k=0
[?2004l[?2004h>             while p+k < len(M) and j+k < len(gene) and M[p+k]==gene[j+k]:
[?2004l[?2004h>                 k+=1
[?2004l[?2004h>             if best is None or k>best[2]:
[?2004l[?2004h>                 best=(p,j,k)
[?2004l[?2004h>     return best
[?2004l[?2004h> res=find_gene_in(flag, M, pos_in_M, 15)
