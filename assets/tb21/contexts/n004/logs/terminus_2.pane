[?2004lvoid HU_Init(void)
{

    int         i;
    int         j;
    char        buffer[9];
    int         fallback;

    fallback = W_CheckNumForName("STCFN033");
    if (fallback < 0)
        fallback = W_GetNumForName("STCFN033");

    // load the heads-up font; missing optional STCFN lumps use an existing glyph.
    j = HU_FONTSTART;
    for (i=0;i<HU_FONTSIZE;i++)
    {
        int n = j++;
        int lumpnum;

        buffer[0] = 'S';
        buffer[1] = 'T';
        buffer[2] = 'C';
        buffer[3] = 'F';
        buffer[4] = 'N';
        buffer[5] = (char)('0' + (n / 100) % 10);
        buffer[6] = (char)('0' + (n / 10) % 10);
        buffer[7] = (char)('0' + n % 10);
        buffer[8] = 0;

        lumpnum = W_CheckNumForName(buffer);
        if (lumpnum < 0)
            lumpnum = fallback;
        hu_font[i] = (patch_t *) W_CacheLumpNum(lumpnum, PU_STATIC);
    }

}

void HU_Stop(void)
{
    headsupactive = false;
}

