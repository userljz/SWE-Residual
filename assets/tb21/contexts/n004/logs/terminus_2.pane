        if (*fmt != '%') {
            if (space > 1) { *p++ = *fmt; space--; }
            fmt++; continue;
        }
        fmt++;
        if (*fmt == '%') { if (space > 1) { *p++ = '%'; space--; } fmt++; continue; }

