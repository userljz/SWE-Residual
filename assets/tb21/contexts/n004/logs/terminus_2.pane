  nor(rs, rt, rd) {
    // NOR rd,rs,rt - Bitwise NOR
    this.registers[rd] = ~(this.registers[rs] | this.registers[rt]) >>> 0; // Force 32-bit unsigned
  }
  
  or(rs, rt, rd) {
