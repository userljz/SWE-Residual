426-//
427-// W_CacheLumpName
428-//
429-void *W_CacheLumpName(char *name, int tag)
430-{
431:    return W_CacheLumpNum(W_GetNumForName(name), tag);
432-}
433-
434-// 
435-// Release a lump back to the cache, so that it can be reused later 
436-// without having to read from disk again, or alternatively, discarded
437-// if we run out of memory.
438-//
