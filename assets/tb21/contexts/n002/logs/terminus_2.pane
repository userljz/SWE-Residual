[?2004l[?2004h> 
[?2004l[?2004h> def _partition(n, rank, world_size):
[?2004l[?2004h>     """Balanced partition of n layers into world_size contiguous chunks.
[?2004l[?2004h>     Returns (start, end) index range (exclusive) for the given rank."""
