=== create_causal_mask source (first 60 lines) ===
  0: def create_causal_mask(
  1:     config: PreTrainedConfig,
  2:     inputs_embeds: torch.Tensor,
  3:     attention_mask: torch.Tensor | None,
  4:     past_key_values: Cache | None,
  5:     position_ids: torch.Tensor | None = None,
  6:     or_mask_function: Callable | None = None,
  7:     and_mask_function: Callable | None = None,
  8:     block_sequence_ids: torch.Tensor | None = None,
  9:     layer_idx: int | None = None,
 10:     allow_is_causal_skip: bool = True,
 11: ) -> torch.Tensor | BlockMask | None:
 12:     """
 13:     Create a standard causal mask based on the attention implementation used (stored in the config). If `past_key_values`
 14:     has a hybrid cache structure, this function will return the mask corresponding to one of the "full_attention" layers (to align
 15:     to what is needed in the `modeling_xxx.py` files).
 16: 
 17:     Args:
 18:         config (`PreTrainedConfig`):
 19:             The model config.
 20:         inputs_embeds (`torch.Tensor`):
 21:             The input embeddings of shape (batch_size, query_length, hidden_dim). This is used only to infer the
 22:             batch size, query length and dtype.
 23:         attention_mask (`torch.Tensor`, optional):
 24:             The 2D attention mask corresponding to padded tokens of shape (batch_size, number_of_seen_tokens+q_length).
 25:             It can also be an already prepared 4D mask, in which case it is returned as-is.
 26:         past_key_values (`Cache`, optional):
 27:             The past key values, if we use a cache.
 28:         position_ids (`torch.Tensor`, optional)
 29:             A 2D tensor of shape (batch_size, query_length) indicating the positions of each token in the sequences.
 30:         or_mask_function (`Callable`, optional):
 31:             An optional mask function to combine with the causal mask function (by doing the union of both). This is
 32:             useful to easily overlay another mask on top of the causal one, for example for image tokens handling.
 33:         and_mask_function (`Callable`, optional):
 34:             An optional mask function to combine with the causal mask function (by doing the intersection of both). This is
 35:             useful to easily overlay another mask on top of the causal one, for example for image tokens handling.
 36:         block_sequence_ids (`torch.Tensor`, *optional*):
 37:             A tensor of same shape as input IDs indicating to which block or group each token belongs to. Tokens from
 38:             the same block will keep a bidirectional mask within the block, attending causally to the past. Index `-1`
 39:             can be used for blocks that have to keep complete causality within itself.
 40:         layer_idx (`int`, *optional*):
 41:             The cache layer to size the mask against. By default, the first "full_attention" layer is used, which is
 42:             correct whenever all layers of a given mask type have seen the same tokens. Pass it explicitly for caches
 43:             where layers of the same type hold different lengths (e.g. per-depth MTP streams).
 44:         allow_is_causal_skip (`bool`, optional):
 45:             Whether to allow returning `None` (and relying on `sdpa`'s `is_causal` argument) when the mask would be a
 46:             plain causal mask. Set to `False` to always materialize the mask, e.g. when it is later concatenated with
 47:             another mask. Defaults to `True`.
 48:     """
 49:     # Power feature: if `is_causal` is False, then fallback to bi-directional mask for bi-directional attention.
 50:     # It allows to use decoder-only models with bi-directional attention as well
 51:     if not getattr(config, "is_causal", True):
 52:         return create_bidirectional_mask(
 53:             config,
 54:             inputs_embeds,
 55:             attention_mask,
 56:             past_key_values=past_key_values,
 57:             or_mask_function=or_mask_function,
 58:             and_mask_function=and_mask_function,
 59:             allow_is_bidirectional_skip=allow_is_causal_skip,
