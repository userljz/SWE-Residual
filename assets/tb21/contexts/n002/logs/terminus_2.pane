  0:     @merge_with_config_defaults
  1:     @capture_outputs
  2:     @auto_docstring
  3:     def forward(
  4:         self,
  5:         input_ids: torch.LongTensor | None = None,
  6:         attention_mask: torch.Tensor | None = None,
  7:         position_ids: torch.LongTensor | None = None,
  8:         past_key_values: Cache | None = None,
  9:         inputs_embeds: torch.FloatTensor | None = None,
 10:         use_cache: bool | None = None,
 11:         **kwargs: Unpack[TransformersKwargs],
 12:     ) -> BaseModelOutputWithPast:
 13:         if (input_ids is None) ^ (inputs_embeds is not None):
 14:             raise ValueError("You must specify exactly one of input_ids or inputs_embeds")
 15: 
 16:         if inputs_embeds is None:
 17:             inputs_embeds: torch.Tensor = self.embed_tokens(input_ids)
 18: 
 19:         if use_cache and past_key_values is None:
 20:             past_key_values = DynamicCache(config=self.config)
 21: 
 22:         if position_ids is None:
 23:             past_seen_tokens = past_key_values.get_seq_length() if past_key_values is not None else 0
 24:             position_ids = torch.arange(inputs_embeds.shape[1], device=inputs_embeds.device) + past_seen_tokens
 25:             position_ids = position_ids.unsqueeze(0)
 26: 
 27:         causal_mask = create_causal_mask(
 28:             config=self.config,
 29:             inputs_embeds=inputs_embeds,
 30:             attention_mask=attention_mask,
 31:             past_key_values=past_key_values,
 32:             position_ids=position_ids,
 33:         )
 34: 
 35:         hidden_states = inputs_embeds
 36:         position_embeddings = self.rotary_emb(hidden_states, position_ids=position_ids)
 37: 
 38:         for decoder_layer in self.layers[: self.config.num_hidden_layers]:
 39:             hidden_states = decoder_layer(
 40:                 hidden_states,
 41:                 attention_mask=causal_mask,
 42:                 position_embeddings=position_embeddings,
 43:                 position_ids=position_ids,
 44:                 past_key_values=past_key_values,
 45:                 use_cache=use_cache,
 46:                 **kwargs,
 47:             )
 48: 
 49:         hidden_states = self.norm(hidden_states)
 50:         return BaseModelOutputWithPast(
 51:             last_hidden_state=hidden_states,
 52:             past_key_values=past_key_values,
 53:         )
 54: 
