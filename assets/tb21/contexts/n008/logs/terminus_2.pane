641:swl(rt, offset, base) {
642-  // SWL rt,offset(base) - Store Word Left
643-  const addr = (this.registers[base] + offset) >>> 0;
644-  const wordAddr = addr & ~0x3;
645-  const bytePosition = addr & 0x3;
646-  
647-  const word = this.memory[wordAddr] || 0;
648-  
649-  // Create mask for bytes to preserve (right side)
650-  let preserveMask = 0;
651-  for (let i = 0; i < 3 - bytePosition; i++) {
652-    preserveMask = (preserveMask << 8) | 0xFF;
653-  }
654-  preserveMask = preserveMask << 8;
655-  
656-  const shiftAmount = (3 - bytePosition) * 8;
657-  const valueMask = 0xFFFFFFFF << shiftAmount;
658-  
659-  // CHANGE HERE: Shift RIGHT instead of LEFT
660-  const newWord = (word & preserveMask) | ((this.registers[rt] & valueMask) >> shiftAmount);
661-  
662-  this.memory[wordAddr] = newWord >>> 0;
663-}
