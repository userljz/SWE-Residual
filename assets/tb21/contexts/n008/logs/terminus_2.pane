   218	            if (width < 0) { left = 1; width = -width; }
   219	            p++;
   220	        } else while (*p >= '0' && *p <= '9') width = width * 10 + (*p++ - '0');
   221	        if (*p == '.') {
   222	            p++;
   223	            precision = 0;
   224	            if (*p == '*') {
   225	                precision = va_arg(arguments, int);
   226	                if (precision < 0) precision = -1;
   227	                p++;
   228	            } else while (*p >= '0' && *p <= '9') precision = precision * 10 + (*p++ - '0');
   229	        }
   230	        while (*p == 'l' || *p == 'h' || *p == 'z' || *p == 'j' || *p == 't') {
   231	            if (*p == 'l' && length < 2) length++;
   232	            if (*p == 'z') length = 1;
   233	            p++;
   234	        }
   235	
   236	        switch (*p) {
   237	        case '%':
   238	            output_char(&out, '%');
   239	            p++;
   240	            continue;
   241	        case 'c':
   242	            c = va_arg(arguments, int);
   243	            if (width > 1 && !left) while (--width) output_char(&out, ' ');
   244	            output_char(&out, (char)c);
   245	            if (width > 1 && left) while (--width) output_char(&out, ' ');
   246	            break;
   247	        case 's':
