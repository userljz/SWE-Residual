   286	void HU_Init(void)
   287	{
   288	
   289	    int		i;
   290	    int		j;
   291	    char	buffer[9];
   292	
   293	    // load the heads-up font
   294	    j = HU_FONTSTART;
   295	    for (i=0;i<HU_FONTSIZE;i++)
   296	    {
   297		DEH_snprintf(buffer, 9, "STCFN%.3d", j++);
   298		hu_font[i] = (patch_t *) W_CacheLumpName(buffer, PU_STATIC);
   299	    }
   300	
   301	}
