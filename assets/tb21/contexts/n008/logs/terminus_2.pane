   257	                format_unsigned(number, unsigned_value, 10, 0, precision);
   258	                emit_number(&out, number, 1, left, zero, width, precision);
   259	            } else {
   260	                format_unsigned(number, (unsigned long long)signed_value, 10, 0, precision);
   261	                emit_number(&out, number, 0, left, zero, width, precision);
   262	            }
   263	            break;
   264	        case 'u':
   265	        case 'x':
   266	        case 'X':
   267	        case 'o':
   268	            if (length == 2) unsigned_value = va_arg(arguments, unsigned long long);
   269	            else unsigned_value = va_arg(arguments, unsigned int);
   270	            format_unsigned(number, unsigned_value,
   271	                            *p == 'o' ? 8U : (*p == 'u' ? 10U : 16U),
   272	                            *p == 'X', precision);
   273	            emit_number(&out, number, 0, left, zero, width, precision);
