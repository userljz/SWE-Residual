197-		}
198-
199-		header.numlumps = LONG(header.numlumps);
200-		header.infotableofs = LONG(header.infotableofs);
201-		length = header.numlumps*sizeof(filelump_t);
202-		fileinfo = Z_Malloc(length, PU_STATIC, 0);
