172-            if (cnum != i && c->sfxinfo == channels[i].sfxinfo)
173-            {
174-                break;
175-            }
176-        }
177-        
178-        // degrade usefulness of sound data
179-
180-        c->sfxinfo->usefulness--;
181-        c->sfxinfo = NULL;
182-    }
