   593	    {
   594		if (!slideFrameNames[i].frontFrame1[0])
   595		    break;
   596				
   597		f1 = R_TextureNumForName(slideFrameNames[i].frontFrame1);
   598		f2 = R_TextureNumForName(slideFrameNames[i].frontFrame2);
   599		f3 = R_TextureNumForName(slideFrameNames[i].frontFrame3);
   600		f4 = R_TextureNumForName(slideFrameNames[i].frontFrame4);
   601	
   602		slideFrames[i].frontFrames[0] = f1;
   603		slideFrames[i].frontFrames[1] = f2;
   604		slideFrames[i].frontFrames[2] = f3;
   605		slideFrames[i].frontFrames[3] = f4;
   606			
   607		f1 = R_TextureNumForName(slideFrameNames[i].backFrame1);
   608		f2 = R_TextureNumForName(slideFrameNames[i].backFrame2);
   609		f3 = R_TextureNumForName(slideFrameNames[i].backFrame3);
   610		f4 = R_TextureNumForName(slideFrameNames[i].backFrame4);
   611	
   612		slideFrames[i].backFrames[0] = f1;
   613		slideFrames[i].backFrames[1] = f2;
   614		slideFrames[i].backFrames[2] = f3;
   615		slideFrames[i].backFrames[3] = f4;
   616	    }
   617	}
