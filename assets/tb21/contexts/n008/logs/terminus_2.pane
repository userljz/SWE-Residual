   524	  const wordAddr = addr & ~0x3;  // Clear bottom 2 bits for word alignment
   525	  const bytePosition = addr & 0x3;  // Byte position within the word (0-3)
   526	  
   527	  // Get the word from memory
   528	  const word = this.memory[wordAddr] || 0;
   529	
   530	    //console.log("STUDY", word);
   531	    
   532	  // Create a mask based on the byte position
   533	  // For each valid byte, we'll include 8 bits of 1s
   534	  let mask = 0;
   535	  for (let i = 0; i <= bytePosition; i++) {
   536	    mask = (mask << 8) | 0xFF;
   537	  }
