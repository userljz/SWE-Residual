[59.840335, "i", "cd /app && python3 - <<'PY'\nimport json\nfruits = [\"apple\",\"banana\",\"cherry\",\"date\",\"elderberry\",\"fig\",\"grape\",\"honeydew\",\"kiwi\",\"lemon\",\"mango\"]\nrecs = [{\"id\": i+1, \"name\": fruits[i], \"value\": (i+1)*100} for i in range(len(fruits))]\nrecs.sort(key=lambda r: r[\"id\"])\nwith open(\"/app/recovered.json\",\"w\") as f:\n    json.dump(recs, f)\nprint(json.dumps(recs, indent=2))\nPY\n"]
