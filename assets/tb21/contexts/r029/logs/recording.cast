[596.60975, "i", "python3 - <<'PY'\nimport os, errno\npaths=['/app','/app/main.db','/','/tmp','/etc/hostname']\nfor p in paths:\n    print('PATH', p, os.stat(p))\n    try:\n        xs=os.listxattr(p)\n        print(' xattrs', xs)\n        for x in xs:\n            try:\n                print('  ', x, os.getxattr(p,x)[:200].hex(), repr(os.getxattr(p,x)[:200]))\n            except Exception as e:\n                print('  getxattr ERR', x, repr(e))\n    except Exception as e:\n        print(' listxattr ERR', repr(e))\nPY\n"]
