[400.262554, "i", "python3 - <<'PY'\nimport os\nfor fn in ['/proc/kcore']:\n    fd=os.open(fn, os.O_RDONLY)\n    for off in [0, 0x1000, 0x100000, 0x1000000]:\n        try:\n            os.lseek(fd, off, os.SEEK_SET)\n            d=os.read(fd, 32)\n            print('off',hex(off),'len',len(d),'hex',d.hex())\n        except Exception as e:\n            print('off',hex(off),'ERR',repr(e))\n    os.close(fd)\nPY\n"]
