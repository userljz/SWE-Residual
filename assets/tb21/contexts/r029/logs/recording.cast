[311.047224, "i", "python3 - <<'PY'\nimport sqlite3, json\ncon = sqlite3.connect('/app/main.db')\ncon.execute('PRAGMA wal_autocheckpoint=0')\ncon.execute('BEGIN')\ncon.executemany('INSERT INTO items(id,name,value) VALUES (?,?,?)', [\n    (6,'fig',600),\n    (7,'grape',700),\n    (8,'honeydew',800),\n    (9,'kiwi',900),\n    (10,'lemon',1000),\n    (11,'mango',1100)\n])\ncon.execute('COMMIT')\nrows = con.execute('SELECT id, name, value FROM items ORDER BY id').fetchall()\ncon.close()\ndata = [{'id': i, 'name': n, 'value': v} for i,n,v in rows]\nwith open('/app/recovered.json','w') as f:\n    json.dump(data, f)\nprint('rows in db:', len(data))\nprint('ids:', [x['id'] for x in data])\nPY\n"]
