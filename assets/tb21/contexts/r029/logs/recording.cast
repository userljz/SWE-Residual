[455.155124, "i", "python3 - <<'PY'\nimport sqlite3, os, json\npath='/tmp/sim_wal.db'\nfor f in [path,path+'-wal',path+'-shm']:\n    try: os.remove(f)\n    except FileNotFoundError: pass\ncon=sqlite3.connect(path)\ncon.execute('CREATE TABLE items(id INTEGER PRIMARY KEY, name TEXT, value INTEGER)')\ncon.execute('PRAGMA journal_mode=WAL')\ncon.execute('PRAGMA wal_autocheckpoint=0')\nnames=['apple','banana','cherry','date','elderberry','fig','grape','honeydew','kiwi','lemon','mango']\nfor i,n in enumerate(names,1):\n    con.execute('INSERT INTO items VALUES (?,?,?)',(i,n,i*100))\ncon.commit()\nprint('wal sizes before exit:', os.path.getsize(path), os.path.getsize(path+'-wal') if os.path.exists(path+'-wal') else None)\nimport ctypes\nlibc=ctypes.CDLL(None, use_errno=True)\nlibc._exit(0)\nPY\n"]
