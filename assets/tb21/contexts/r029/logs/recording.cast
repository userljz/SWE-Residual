[455.386279, "o", "mango\r\nlemon\r\nkiwi\r\nhoneydew\r\ngrape\r\nelderberry\r\ndate\r\ncherry\r\nbanana\r\nappled\r\n"]
[455.386751, "o", "\u001b[?2004hroot@ce2e7a678869:/app# "]
[455.565876, "i", "python3 - <<'PY'\nimport sqlite3, os, ctypes\npath='/tmp/sim2.db'\nfor f in [path,path+'-wal',path+'-shm']:\n    try: os.remove(f)\n    except FileNotFoundError: pass\ncon=sqlite3.connect(path)\ncon.execute('CREATE TABLE items(id INTEGER PRIMARY KEY, name TEXT, value INTEGER)')\ncon.execute('INSERT INTO items VALUES (1,\"apple\",100),(2,\"banana\",200),(3,\"cherry\",300),(4,\"date\",400),(5,\"elderberry\",500)')\ncon.commit()\ncon.execute('PRAGMA journal_mode=WAL')\ncon.execute('PRAGMA wal_autocheckpoint=0')\nfor i,n in [(6,'fig',600),(7,'grape',700),(8,'honeydew',800),(9,'kiwi',900),(10,'lemon',1000),(11,'mango',1100)]:\n    con.execute('INSERT INTO items VALUES (?,?,?)',(i,n,i*100))\ncon.commit()\nprint('wal sizes before exit:', os.path.getsize(path), os.path.getsize(path+'-wal') if os.path.exists(path+'-wal') else None)\nctypes.CDLL(None, use_errno=True)._exit(0)\nPY\n"]
