[152.995134, "i", "python3 - <<'PY'\nimport ctypes, ctypes.util, os, errno\nlibc=ctypes.CDLL(None, use_errno=True)\nAT_FDCWD=-100\nMAX_HANDLE=128\nclass FileHandle(ctypes.Structure):\n    _fields_=[('handleBytes', ctypes.c_uint), ('f_handle', ctypes.c_ubyte * 128)]\n\ndef name_to_handle(path):\n    h=FileHandle(); h.handleBytes=128\n    mnt=ctypes.c_int()\n    r=libc.name_to_handle_at(AT_FDCWD, path.encode(), ctypes.byref(h), ctypes.byref(mnt), 0)\n    e=ctypes.get_errno()\n    print('name_to_handle_at', path, 'ret', r, 'errno', e, os.strerror(e), 'mnt', mnt, 'bytes', h.handleBytes, 'handle', bytes(h.f_handle[:h.handleBytes]).hex())\n    return r,h,mnt.value\ndef open_by_handle(mntfd, h, flags=os.O_RDONLY):\n    r=libc.open_by_handle_at(mntfd, ctypes.byref(h), flags)\n    e=ctypes.get_errno()\n    print('open_by_handle_at ret', r, 'errno', e, os.strerror(e))\n    return r\npaths=['/app','/app/main.db','/','/etc/hostname']\nhandles=[]\nfor p in paths:\n    r,h,mnt=name_to_handle(p)\n    if r==0:\n        fd=open_by_handle(mnt,h)\n        if fd>=0: os.close(fd)\nPY\n"]
