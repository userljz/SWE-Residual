[570.995141, "i", "python3 - <<'PY'\nimport sqlite3, json, os\ncon=sqlite3.connect('/app/main.db')\nrows=[{'id':i,'name':n,'value':v} for i,n,v in con.execute('SELECT id,name,value FROM items ORDER BY id')]\ncon.close()\nwith open('/app/recovered.json','w') as f:\n    json.dump(rows, f)\nprint('recovered.json rows:', len(rows))\nprint('wal exists after query:', os.path.exists('/app/main.db-wal'), os.path.getsize('/app/main.db-wal') if os.path.exists('/app/main.db-wal') else None)\nPY\n"]
