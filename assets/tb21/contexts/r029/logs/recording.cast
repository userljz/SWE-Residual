[570.572434, "i", "python3 - <<'PY'\nimport sqlite3, os, ctypes\npath='/app/main.db'\ncon=sqlite3.connect(path)\ncon.execute('PRAGMA journal_mode=WAL')\ncon.execute('PRAGMA wal_autocheckpoint=0')\n# Four separate commits to make a WAL with several frames, as the original WAL size indicated.\ntransactions = [\n    (6,7,8),\n    (9,),\n    (10,),\n    (11,),\n]\nfor ids in transactions:\n    con.execute('BEGIN')\n    for i in ids:\n        con.execute('UPDATE items SET value=value WHERE id=?', (i,))\n    con.execute('COMMIT')\nrows = con.execute('SELECT id,name,value FROM items ORDER BY id').fetchall()\nprint('rows seen:', len(rows), rows)\nprint('wal exists before exit:', os.path.exists('/app/main.db-wal'), os.path.getsize('/app/main.db-wal') if os.path.exists('/app/main.db-wal') else None)\nctypes.CDLL(None, use_errno=True)._exit(0)\nPY\n"]
