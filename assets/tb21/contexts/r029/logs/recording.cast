[365.075907, "i", "python3 - <<'PY'\nimport os, errno\nfor fdpath in ['/proc/kcore']:\n    try:\n        fd=os.open(fdpath, os.O_RDONLY)\n        data=os.read(fd, 16)\n        print(fdpath, 'ok', data.hex())\n        os.close(fd)\n    except Exception as e:\n        print(fdpath, 'ERR', type(e).__name__, repr(e))\nPY\n"]
