def _cross_entropy_loss(
    logits: torch.Tensor,
    target_ids: torch.Tensor,
    num_microbatches: int,
) -> torch.Tensor:
    """Compute target-aligned cross entropy for one microbatch."""
    # The API provides targets already aligned with logits, rather than
    # Hugging Face's optional `labels` argument. Preserve the requested
    # dtype, then scale the loss for gradient accumulation.
    logits = logits.contiguous()
    target_ids = target_ids.contiguous().long()
    loss = torch.nn.functional.cross_entropy(
        logits.view(-1, logits.shape[-1]),
        target_ids.view(-1),
        ignore_index=-100,
        reduction="mean",
    )
    return loss / num_microbatches


