            backbone,
            local_layers,
            rank == last_rank,
            input_ids=input_ids if rank == 0 else None,
            hidden_states=None if rank == 0 else stage_input,
        )
        stage_output = _to_device_dtype(stage_output, device, dtype)

        if rank == last_rank:
            target_ids = targets[microbatch_index].to(device=device)
            logits = model.lm_head(stage_output)
