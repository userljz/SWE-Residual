[?2004l            "input microbatches"
        )

    # Share every microbatch's [batch, sequence] shape so receivers can
    # allocate hidden-state buffers without requiring local input tensors.
    shapes: List[Tuple[int, int]] = []
    if world_size == 1:
        shapes = [tuple(item.shape[:2]) for item in inputs]
    else:
        for _ in range(num_microbatches):
            if rank == 0:
                shape_tensor = torch.tensor(
                    tuple(inputs[len(shapes)].shape[:2]),
                    device=device,
                    dtype=torch.long,
                )
            else:
                shape_tensor = torch.empty(
                    2, device=device, dtype=torch.long
                )
                shape_tensor = _p2p_recv(shape_tensor, rank - 1)

            if rank < last_rank:
                _p2p_send(shape_tensor, rank + 1)
            shapes.append(tuple(int(value) for value in shape_tensor.tolist()))

    hidden_size = int(
        getattr(model.config, "hidden_size", backbone.embed_tokens.weight.shape[1])
    )

    # Keep a local autograd graph for every microbatch throughout the entire
    # forward phase. Boundary tensors on receiving ranks are leaves; their
    # .grad values become the backward messages to the preceding rank.
    saved_inputs = []
    saved_outputs = []
    losses = []

    # ------------------------------ all forward ------------------------------
    for microbatch_index in range(num_microbatches):
        if rank == 0:
            # Token ids must retain an integer dtype, unlike hidden states.
            input_ids = inputs[microbatch_index].to(device=device)
            stage_input = backbone.embed_tokens(input_ids)
            stage_input = _to_device_dtype(stage_input, device, dtype)
        else:
            batch_size, sequence_length = shapes[microbatch_index]
            stage_input = torch.empty(
                (batch_size, sequence_length, hidden_size),
                device=device,
                dtype=dtype,
            )
            stage_input = _p2p_recv(stage_input, rank - 1)
            stage_input = _to_device_dtype(stage_input, device, dtype)
            stage_input.requires_grad_(True)

        stage_output = _run_stage(
            backbone,
            local_layers,
            stage_input,
            rank == last_rank,
        )
        stage_output = _to_device_dtype(stage_output, device, dtype)

        if rank == last_rank:
            target_ids = targets[microbatch_index].to(device=device)
            logits = model.lm_head(stage_output)
            losses.append(
                _cross_entropy_loss(logits, target_ids, num_microbatches)
            )
        else:
            # Detaching in _p2p_send deliberately creates an autograd boundary.
            # The matching gradient is received and applied during backward.
            _p2p_send(stage_output, rank + 1)

        saved_inputs.append(stage_input)
        saved_outputs.append(stage_output)

    # ------------------------------ all backward -----------------------------
    # GPipe/AFAB schedules customarily unwind microbatches in reverse order.
    # Each rank has already completed all of its forward work at this point.
    for microbatch_index in reversed(range(num_microbatches)):
        stage_input = saved_inputs[microbatch_index]
        stage_output = saved_outputs[microbatch_index]

        if rank == last_rank:
            losses[microbatch_index].backward()

            if world_size > 1:
                output_gradient = stage_input.grad
                if output_gradient is None:
                    output_gradient = torch.zeros_like(stage_input)
                output_gradient = _to_device_dtype(
                    output_gradient, device, dtype
                )
                _p2p_send(output_gradient, rank - 1)
        else:
            output_gradient = torch.empty_like(stage_output)
            output_gradient = _p2p_recv(output_gradient, rank + 1)
            output_gradient = _to_device_dtype(
                output_gradient, device, dtype
            )

            torch.autograd.backward(
                stage_output, grad_tensors=output_gradient
            )

            if rank > 0:
                input_gradient = stage_input.grad
                if input_gradient is None:
                    input_gradient = torch.zeros_like(stage_input)
                input_gradient = _to_device_dtype(
                    input_gradient, device, dtype
                )
                _p2p_send(input_gradient, rank - 1)

    # The final rank returns the batch loss formed from already-scaled
    # microbatch losses. Other ranks have no loss and return None.
    if losses:
        return torch.stack(losses).sum().detach()
    return None
