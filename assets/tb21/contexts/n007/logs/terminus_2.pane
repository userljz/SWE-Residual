[?2004l"""All-forward/all-backward pipeline-parallel training for Llama models."""

from __future__ import annotations

from typing import List, Optional, Tuple

import torch
import torch.distributed as dist


def _partition_layers(
    num_layers: int, rank: int, world_size: int
) -> Tuple[int, int]:
    """Return a rank's inclusive start and exclusive end layer indices."""
    if world_size <= 0:
        raise ValueError("world_size must be positive")
    if num_layers < 0:
        raise ValueError("the model cannot have a negative number of layers")

    base = num_layers // world_size
    remainder = num_layers % world_size
    start = rank * base + min(rank, remainder)
    count = base + (1 if rank < remainder else 0)
    return start, start + count


def _wait_works(works) -> None:
    """Wait for either a Work object or the list returned by batch P2P."""
    if works is None:
        return
    if isinstance(works, (list, tuple)):
        for work in works:
            if work is not None and hasattr(work, "wait"):
                work.wait()
    elif hasattr(works, "wait"):
        works.wait()


def _use_batch_p2p() -> bool:
    """Use batched P2P where it is well supported (notably NCCL)."""
    if not (hasattr(dist, "P2POp") and hasattr(dist, "batch_isend_irecv")):
        return False
    try:
        backend = dist.get_backend().lower()
    except Exception:
        return False
    return "nccl" in backend


def _p2p_send(tensor: torch.Tensor, peer: int) -> None:
    """Send a detached, contiguous tensor to an adjacent pipeline rank."""
    tensor = tensor.detach().contiguous()
    if _use_batch_p2p():
        op = dist.P2POp(dist.isend, tensor, peer)
        _wait_works(dist.batch_isend_irecv([op]))
    else:
        # Blocking sends are portable to Gloo, which is commonly used by
        # CPU-based multi-process tests.
        dist.send(tensor, peer)


def _p2p_recv(buffer: torch.Tensor, peer: int) -> torch.Tensor:
    """Receive into an already allocated, contiguous tensor."""
    buffer = buffer.contiguous()
    if _use_batch_p2p():
        op = dist.P2POp(dist.irecv, buffer, peer)
        _wait_works(dist.batch_isend_irecv([op]))
    else:
        dist.recv(buffer, peer)
    return buffer


def _to_device_dtype(
    tensor: torch.Tensor,
    device: torch.device,
    dtype: Optional[torch.dtype],
) -> torch.Tensor:
    """Move a tensor, allowing dtype to be omitted when it is None."""
    if dtype is None:
        return tensor.to(device=device)
    return tensor.to(device=device, dtype=dtype)


def _move_stage_modules(modules, device: torch.device, dtype) -> None:
    """Move only modules owned and executed by this pipeline stage."""
