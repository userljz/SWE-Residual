[?2004hroot@2d847769624e:/app# cat > /app/analyze2.py << 'EOF'
[?2004l[?2004h> import cv2, numpy as np
[?2004l[?2004h> cap = cv2.VideoCapture('/app/example_video.mp4')
[?2004l[?2004h> frames = []
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, f = cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     frames.append(f)
[?2004l[?2004h> cap.release()
[?2004l[?2004h> bg = cv2.cvtColor(frames[0], cv2.COLOR_BGR2GRAY).astype(np.int16)
[?2004l[?2004h> kernel = np.ones((3,3),np.uint8)
[?2004l[?2004h> def largest_cc(mask):
[?2004l[?2004h>     n, labels, stats, cent = cv2.connectedComponentsWithStats(mask, 8)
[?2004l[?2004h>     if n <= 1:
[?2004l[?2004h>         return None
[?2004l[?2004h>     # skip background label 0, pick largest area
[?2004l[?2004h>     areas = stats[1:, cv2.CC_STAT_AREA]
[?2004l[?2004h>     best = 1 + int(np.argmax(areas))
[?2004l[?2004h>     return stats[best]
[?2004l[?2004h> for i in range(len(frames)):
[?2004l[?2004h>     g = cv2.cvtColor(frames[i], cv2.COLOR_BGR2GRAY).astype(np.int16)
[?2004l[?2004h>     diff = np.abs(g - bg)
[?2004l[?2004h>     mask = (diff > 40).astype(np.uint8)
[?2004l[?2004h>     mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel, iterations=1)
[?2004l[?2004h>     st = largest_cc(mask)
[?2004l[?2004h>     if st is None:
[?2004l[?2004h>         print(f'{i:3d}: empty')
[?2004l[?2004h>         continue
[?2004l[?2004h>     x,y,w,h,area = st
[?2004l[?2004h>     cx = x + w/2
[?2004l[?2004h>     print(f'{i:3d}: area={area:5d} x=[{x:3d},{x+w:3d}] y=[{y:3d},{y+h:3d}] feet={y+h:3d} top={y:3d} h={h:3d} cx={cx:.0f}')
[?2004l[?2004h> EOF
