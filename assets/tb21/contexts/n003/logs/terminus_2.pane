[?2004l[?2004h> import cv2, numpy as np
[?2004l[?2004h> cap = cv2.VideoCapture('/app/example_video.mp4')
[?2004l[?2004h> frames = []
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, f = cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     frames.append(f)
[?2004l[?2004h> cap.release()
[?2004l[?2004h> chars = ' .:-=+*#%@'
[?2004l[?2004h> def crop(i, x0, x1, y0, y1, W=120, H=50):
[?2004l[?2004h>     g = cv2.cvtColor(frames[i], cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     sub = g[y0:y1, x0:x1]
[?2004l[?2004h>     small = cv2.resize(sub, (W, H), interpolation=cv2.INTER_AREA)
[?2004l[?2004h>     print(f'--- frame {i}  crop x[{x0}:{x1}] y[{y0}:{y1}] ---')
[?2004l[?2004h>     for r in range(H):
[?2004l[?2004h>         print(''.join(chars[int(v/256*len(chars))] for v in small[r]))
[?2004l[?2004h> crop(49, 300, 960, 0, 420)
[?2004l[?2004h> crop(58, 300, 960, 0, 420)
[?2004l[?2004h> EOF
