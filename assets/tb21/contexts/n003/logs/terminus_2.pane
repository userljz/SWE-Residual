[?2004l[?2004h>     apex_h = ground - apex
[?2004l[?2004h>     if apex_h < 15:
[?2004l[?2004h>         return (s, e)
[?2004l[?2004h>     clear = 0.25 * apex_h
[?2004l[?2004h>     airborne = [i for i in range(s, e + 1) if i in feet and (ground - feet[i]) > clear]
[?2004l[?2004h>     if not airborne:
[?2004l[?2004h>         return (s, e)
[?2004l[?2004h>     takeoff = min(airborne)
[?2004l[?2004h>     landing = max(airborne) + 1
[?2004l[?2004h>     return (takeoff, landing)
