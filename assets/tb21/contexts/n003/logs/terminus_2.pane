[?2004l[?2004h> import cv2, numpy as np
[?2004l[?2004h> cap = cv2.VideoCapture('/app/example_video.mp4')
[?2004l[?2004h> frames = []
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, f = cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     frames.append(f.astype(np.float32))
[?2004l[?2004h> cap.release()
[?2004l[?2004h> N = len(frames)
[?2004l[?2004h> bgB = frames[0]
[?2004l[?2004h> 
[?2004l[?2004h> def largest_cc(mask):
[?2004l[?2004h>     n, labels, stats, cent = cv2.connectedComponentsWithStats(mask, 8)
[?2004l[?2004h>     if n <= 1: return None
[?2004l[?2004h>     areas = stats[1:, cv2.CC_STAT_AREA]
[?2004l[?2004h>     best = 1 + int(np.argmax(areas))
[?2004l[?2004h>     return stats[best]
[?2004l[?2004h> 
[?2004l[?2004h> def method_corrected(i, thr):
[?2004l[?2004h>     f = frames[i]
[?2004l[?2004h>     # global gain/offset vs bg over all pixels (background dominates)
[?2004l[?2004h>     a = f.reshape(-1,3); b = bgB.reshape(-1,3)
[?2004l[?2004h>     # per-channel robust: estimate offset = median(f-bg), gain from ratio of means
[?2004l[?2004h>     offset = np.median(f - bgB, axis=0, keepdims=True)  # per channel
[?2004l[?2004h>     fc = (f - offset)
[?2004l[?2004h>     # gain: use ratio of std or just 1.0
[?2004l[?2004h>     diff = np.abs(fc - bgB).max(axis=2)
[?2004l[?2004h>     mask = (diff > thr).astype(np.uint8)
[?2004l[?2004h>     mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((5,5),np.uint8), iterations=2)
[?2004l[?2004h>     mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((5,5),np.uint8), iterations=1)
[?2004l[?2004h>     return largest_cc(mask)
[?2004l[?2004h> 
[?2004l[?2004h> def method_consec(i, thr):
[?2004l[?2004h>     f = frames[i]; p = frames[i-1] if i>0 else frames[i]
[?2004l[?2004h>     diff = np.abs(f - p).max(axis=2)
[?2004l[?2004h>     mask = (diff > thr).astype(np.uint8)
[?2004l[?2004h>     mask = cv2.dilate(mask, np.ones((7,7),np.uint8), iterations=2)
[?2004l[?2004h>     mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((9,9),np.uint8), iterations=2)
[?2004l[?2004h>     return largest_cc(mask)
[?2004l[?2004h> 
[?2004l[?2004h> print('=== method_corrected thr=20 ===')
[?2004l[?2004h> for i in range(40, 85):
[?2004l[?2004h>     st = method_corrected(i, 20)
[?2004l[?2004h>     if st is None:
[?2004l[?2004h>         print(f'{i:3d}: empty'); continue
[?2004l[?2004h>     x,y,w,h,area = st
[?2004l[?2004h>     print(f'{i:3d}: area={area:6d} x=[{x:3d},{x+w:3d}] feet={y+h:3d} top={y:3d} h={h:3d} cx={x+w/2:.0f}')
[?2004l[?2004h> print('=== method_consec thr=25 ===')
[?2004l[?2004h> for i in range(40, 85):
[?2004l[?2004h>     st = method_consec(i, 25)
[?2004l[?2004h>     if st is None:
[?2004l[?2004h>         print(f'{i:3d}: empty'); continue
[?2004l[?2004h>     x,y,w,h,area = st
[?2004l[?2004h>     print(f'{i:3d}: area={area:6d} x=[{x:3d},{x+w:3d}] feet={y+h:3d} top={y:3d} h={h:3d} cx={x+w/2:.0f}')
[?2004l[?2004h> EOF
