[?2004l[?2004h> import cv2, numpy as np
[?2004l[?2004h> cap = cv2.VideoCapture('/app/example_video.mp4')
[?2004l[?2004h> frames = []
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, f = cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     frames.append(f.astype(np.float32))
[?2004l[?2004h> cap.release()
[?2004l[?2004h> N=len(frames)
[?2004l[?2004h> f0 = frames[0]
[?2004l[?2004h> ker = np.ones((7,7),np.uint8)
[?2004l[?2004h> def mask_cc(i):
[?2004l[?2004h>     bg = np.abs(frames[i]-f0).max(axis=2)
[?2004l[?2004h>     con = np.abs(frames[i]-frames[i-1]).max(axis=2) if i>0 else np.zeros_like(bg)
[?2004l[?2004h>     m = ((bg>30)|(con>22)).astype(np.uint8)
[?2004l[?2004h>     m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, ker, iterations=2)
[?2004l[?2004h>     n,lab,stats,cent = cv2.connectedComponentsWithStats(m,8)
[?2004l[?2004h>     if n<=1: return None
[?2004l[?2004h>     a=stats[1:,cv2.CC_STAT_AREA]; best=1+int(np.argmax(a))
[?2004l[?2004h>     return stats[best]
[?2004l[?2004h> for i in range(N):
[?2004l[?2004h>     st=mask_cc(i)
[?2004l[?2004h>     if st is None: print(f'{i:3d}: empty'); continue
[?2004l[?2004h>     x,y,w,h,area=st
