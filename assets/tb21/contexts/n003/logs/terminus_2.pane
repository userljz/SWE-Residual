[?2004l[?2004h> import cv2, numpy as np
[?2004l[?2004h> cap = cv2.VideoCapture('/app/example_video.mp4')
[?2004l[?2004h> frames = []
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, f = cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     frames.append(f.astype(np.float32))
[?2004l[?2004h> cap.release()
[?2004l[?2004h> N=len(frames); f0=frames[0]
[?2004l[?2004h> y0=230
[?2004l[?2004h> ok=np.ones((9,9),np.uint8); ck=np.ones((13,13),np.uint8)
[?2004l[?2004h> feet={}; top={}; area={}; cx={}
[?2004l[?2004h> for i in range(1,N):
[?2004l[?2004h>     diff=np.abs(frames[i][y0:]-f0[y0:]).max(axis=2)
[?2004l[?2004h>     m=(diff>35).astype(np.uint8)
[?2004l[?2004h>     m=cv2.morphologyEx(m,cv2.MORPH_OPEN,ok,iterations=1)
[?2004l[?2004h>     m=cv2.morphologyEx(m,cv2.MORPH_CLOSE,ck,iterations=2)
[?2004l[?2004h>     n,lab,stats,cent=cv2.connectedComponentsWithStats(m,8)
[?2004l[?2004h>     best=None
[?2004l[?2004h>     for k in range(1,n):
[?2004l[?2004h>         a=stats[k,cv2.CC_STAT_AREA]
[?2004l[?2004h>         if a>=1500 and (best is None or a>stats[best,cv2.CC_STAT_AREA]):
[?2004l[?2004h>             best=k
[?2004l[?2004h>     if best is None:
[?2004l[?2004h>         continue
[?2004l[?2004h>     x,y,w,h,a=stats[best]
[?2004l[?2004h>     feet[i]=y+y0+h; top[i]=y+y0; area[i]=a; cx[i]=x+w/2
[?2004l[?2004h> print('frame area feet top cx')
[?2004l[?2004h> for i in sorted(area):
[?2004l[?2004h>     print(f'{i:3d} {area[i]:6d} {feet[i]:4d} {top[i]:4d} {cx[i]:6.1f}')
