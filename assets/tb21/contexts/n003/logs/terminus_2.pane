[?2004hroot@2d847769624e:/app# cat > /app/jump_analyzer.py << 'PYEOF'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """Detect hurdle-jump takeoff and landing frames in a fixed-camera MP4 video.
[?2004l[?2004h> 
[?2004l[?2004h> Strategy
[?2004l[?2004h> --------
[?2004l[?2004h> * The camera is static and the first frame has no runner -> use frame 0 as background.
[?2004l[?2004h> * The athlete is the only thing that moves fast. Consecutive-frame difference
[?2004l[?2004h>   (a high-pass) cleanly highlights the athlete and cancels the static scene.
[?2004l[?2004h> * Isolate the athlete's time window as the longest contiguous run of strong
[?2004l[?2004h>   motion (this ignores sporadic compression-noise elsewhere in the video).
[?2004l[?2004h> * Within that window, measure the athlete's lowest point (feet) each frame by
[?2004l[?2004h>   localizing the athlete with motion and then background-subtracting frame 0 in
[?2004l[?2004h>   a window around it (masked to the frame interior so border noise is ignored).
[?2004l[?2004h> * On the ground the feet sit at a stable level; during the flight the feet rise
[?2004l[?2004h>   well above it. Takeoff = first airborne frame, landing = last airborne + 1.
[?2004l[?2004h> """
[?2004l[?2004h> import sys
[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> MOTION_THR = 18     # consecutive-frame difference threshold
[?2004l[?2004h> BG_THR = 25         # background-difference threshold
[?2004l[?2004h> PRESENCE_MIN = 400  # motion area that counts as "athlete present"
[?2004l[?2004h> LOCALIZER_MIN = 2000
[?2004l[?2004h> SIL_MIN = 600
[?2004l[?2004h> INTERIOR = 8        # ignore this many border pixels
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def load_frames(path):
[?2004l[?2004h>     cap = cv2.VideoCapture(path)
[?2004l[?2004h>     frames = []
[?2004l[?2004h>     while True:
[?2004l[?2004h>         ret, f = cap.read()
[?2004l[?2004h>         if not ret:
[?2004l[?2004h>             break
[?2004l[?2004h>         frames.append(f.astype(np.float32))
[?2004l[?2004h>     cap.release()
[?2004l[?2004h>     return frames
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def largest_cc(m, min_area):
[?2004l[?2004h>     n, lab, stats, cent = cv2.connectedComponentsWithStats(m, 8)
[?2004l[?2004h>     if n <= 1:
[?2004l[?2004h>         return None
[?2004l[?2004h>     best_k, best_a = -1, min_area - 1
[?2004l[?2004h>     for k in range(1, n):
[?2004l[?2004h>         a = stats[k, cv2.CC_STAT_AREA]
[?2004l[?2004h>         if a > best_a:
[?2004l[?2004h>             best_a, best_k = a, k
[?2004l[?2004h>     if best_k < 0:
[?2004l[?2004h>         return None
[?2004l[?2004h>     return (int(stats[best_k, 0]), int(stats[best_k, 1]), int(stats[best_k, 2]),
[?2004l[?2004h>             int(stats[best_k, 3]), int(stats[best_k, 4]),
[?2004l[?2004h>             float(cent[best_k][0]), float(cent[best_k][1]))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def motion_mask(frames, i, ts):
[?2004l[?2004h>     H, W = frames[0].shape[:2]
[?2004l[?2004h>     m = (np.abs(frames[i] - frames[i - 1]).max(axis=2) > MOTION_THR).astype(np.uint8)
[?2004l[?2004h>     m[:ts] = 0
[?2004l[?2004h>     return m
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def find_window(mot_area, N):
[?2004l[?2004h>     pres = [i for i in range(1, N) if mot_area[i] > PRESENCE_MIN]
[?2004l[?2004h>     if not pres:
[?2004l[?2004h>         return None
