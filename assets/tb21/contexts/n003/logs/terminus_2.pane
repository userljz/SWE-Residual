[?2004hroot@2d847769624e:/app# cat > /app/ascii3.py << 'EOF'
[?2004l[?2004h> import cv2, numpy as np
[?2004l[?2004h> cap = cv2.VideoCapture('/app/example_video.mp4')
[?2004l[?2004h> frames = []
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, f = cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     frames.append(f.astype(np.float32))
[?2004l[?2004h> cap.release()
[?2004l[?2004h> chars = ' .:-=+*#%@'
[?2004l[?2004h> y0, y1 = 236, 540
[?2004l[?2004h> bg = frames[0][y0:y1]
[?2004l[?2004h> def raw(i, x0, x1, W=140, H=40):
[?2004l[?2004h>     g = cv2.cvtColor(frames[i][y0:y1].astype(np.uint8), cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     sub = g[:, x0:x1]
[?2004l[?2004h>     small = cv2.resize(sub, (W, H), interpolation=cv2.INTER_AREA)
[?2004l[?2004h>     print(f'--- RAW frame {i} x[{x0}:{x1}] ---')
[?2004l[?2004h>     for r in range(H):
[?2004l[?2004h>         print(''.join(chars[int(v/256*len(chars))] for v in small[r]))
[?2004l[?2004h> def mask(i, x0, x1, thr=25, W=140, H=40):
[?2004l[?2004h>     diff = np.abs(frames[i][y0:y1]-bg).max(axis=2)
[?2004l[?2004h>     m = (diff>thr).astype(np.uint8)
[?2004l[?2004h>     m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, np.ones((7,7),np.uint8), iterations=1)
[?2004l[?2004h>     sub = m[:, x0:x1]
[?2004l[?2004h>     small = cv2.resize(sub*255, (W,H), interpolation=cv2.INTER_AREA)
[?2004l[?2004h>     print(f'--- MASK frame {i} x[{x0}:{x1}] ---')
[?2004l[?2004h>     for r in range(H):
[?2004l[?2004h>         line=''.join('#' if small[r,c]>40 else '.' for c in range(W))
[?2004l[?2004h>         print(line)
[?2004l[?2004h> for i in [49,58,61]:
[?2004l[?2004h>     raw(i, 300, 720)
[?2004l[?2004h>     mask(i, 300, 720)
[?2004l[?2004h> EOF
[?2004l[?2004hroot@2d847769624e:/app# python3 /app/ascii3.py
