[?2004h> def load_frames(path):
[?2004l[?2004h>     cap = cv2.VideoCapture(path)
[?2004l[?2004h>     frames = []
[?2004l[?2004h>     while True:
[?2004l[?2004h>         ret, f = cap.read()
[?2004l[?2004h>         if not ret:
[?2004l[?2004h>             break
[?2004l[?2004h>         frames.append(f.astype(np.float32))
[?2004l[?2004h>     cap.release()
[?2004l[?2004h>     return frames
[?2004l[?2004h> 
[?2004l[?2004h> def largest_cc(m, min_area):
[?2004l[?2004h>     n, lab, stats, cent = cv2.connectedComponentsWithStats(m, 8)
[?2004l[?2004h>     if n <= 1:
[?2004l[?2004h>         return None
[?2004l[?2004h>     best = None
[?2004l[?2004h>     for k in range(1, n):
[?2004l[?2004h>         if stats[k, cv2.CC_STAT_AREA] >= min_area:
[?2004l[?2004h>             if best is None or stats[k, cv2.CC_STAT_AREA] > stats[best, cv2.CC_STAT_AREA]:
[?2004l[?2004h>                 best = k
[?2004l[?2004h>     return (best, lab, stats, cent)
[?2004l[?2004h> 
[?2004l[?2004h> def compute_feet(frames):
[?2004l[?2004h>     N = len(frames)
[?2004l[?2004h>     H, W = frames[0].shape[:2]
[?2004l[?2004h>     f0 = frames[0]
[?2004l[?2004h>     track_start = int(0.45 * H)      # athlete runs in lower part of frame
[?2004l[?2004h>     dil = np.ones((9, 9), np.uint8)
[?2004l[?2004h>     close = np.ones((7, 7), np.uint8)
[?2004l[?2004h>     margin = max(35, int(0.08 * W))
[?2004l[?2004h>     motion_thr = 18
[?2004l[?2004h>     bg_thr = 25
[?2004l[?2004h>     rec = {}   # i -> dict(feet, top, x0, x1, area, cx)
[?2004l[?2004h>     for i in range(1, N):
[?2004l[?2004h>         # localizer: union of motion over i-2..i+2, restricted to track region
[?2004l[?2004h>         u = np.zeros((H, W), np.uint8)
[?2004l[?2004h>         for j in range(max(1, i - 2), min(N, i + 2) + 1):
[?2004l[?2004h>             if j - 1 < 0:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             m = (np.abs(frames[j] - frames[j - 1]).max(axis=2) > motion_thr).astype(np.uint8)
[?2004l[?2004h>             m[:track_start] = 0
[?2004l[?2004h>             u = np.maximum(u, m)
[?2004l[?2004h>         u = cv2.dilate(u, dil, iterations=1)
[?2004l[?2004h>         res = largest_cc(u, 150)
[?2004l[?2004h>         if res is None:
[?2004l[?2004h>             continue
[?2004l[?2004h>         _, _, stats, _ = res
[?2004l[?2004h>         k = res[0]
[?2004l[?2004h>         x, y, w, h = stats[k, 0], stats[k, 1], stats[k, 2], stats[k, 3]
[?2004l[?2004h>         x0 = max(0, x - margin); x1 = min(W, x + w + margin)
[?2004l[?2004h>         y0 = max(0, y - margin); y1 = min(H, y + h + margin)
[?2004l[?2004h>         # background subtraction in local window -> true silhouette
[?2004l[?2004h>         d = np.abs(frames[i][y0:y1, x0:x1] - f0[y0:y1, x0:x1]).max(axis=2)
[?2004l[?2004h>         mm = (d > bg_thr).astype(np.uint8)
[?2004l[?2004h>         mm = cv2.morphologyEx(mm, cv2.MORPH_CLOSE, close, iterations=1)
[?2004l[?2004h>         res2 = largest_cc(mm, 500)
[?2004l[?2004h>         if res2 is None:
[?2004l[?2004h>             continue
[?2004l[?2004h>         _, lab2, stats2, cent2 = res2
[?2004l[?2004h>         k2 = res2[0]
[?2004l[?2004h>         ax0 = stats2[k2, 0] + x0
[?2004l[?2004h>         ax1 = ax0 + stats2[k2, 2]
[?2004l[?2004h>         ay0 = stats2[k2, 1] + y0
[?2004l[?2004h>         ay1 = ay0 + stats2[k2, 3]
[?2004l[?2004h>         area = int(stats2[k2, cv2.CC_STAT_AREA])
[?2004l[?2004h>         # exclude frames where the athlete is clipped by the left/right border
[?2004l[?2004h>         if ax0 <= 3 or ax1 >= W - 3:
[?2004l[?2004h>             continue
[?2004l[?2004h>         rec[i] = dict(feet=ay1, top=ay0, x0=ax0, x1=ax1, area=area,
[?2004l[?2004h>                       cx=cent2[k2][0] + x0)
[?2004l[?2004h>     return rec
[?2004l[?2004h> 
[?2004l[?2004h> def detect_jump(rec):
[?2004l[?2004h>     if not rec:
[?2004l[?2004h>         return 0, 0
[?2004l[?2004h>     idx = sorted(rec)
[?2004l[?2004h>     feet = np.array([rec[i]['feet'] for i in idx], dtype=float)
[?2004l[?2004h>     ground = float(np.percentile(feet, 80))
[?2004l[?2004h>     # apex = highest point of feet (smallest y)
[?2004l[?2004h>     apex_i = idx[int(np.argmin(feet))]
[?2004l[?2004h>     apex_feet = rec[apex_i]['feet']
[?2004l[?2004h>     if ground - apex_feet < 15:
[?2004l[?2004h>         # not a clear jump; fallback
[?2004l[?2004h>         return idx[0], idx[-1]
[?2004l[?2004h>     thr = ground - max(20.0, 0.1 * (ground - apex_feet))
[?2004l[?2004h>     # airborne run containing the apex
[?2004l[?2004h>     pos = {i: rec[i]['feet'] for i in rec}
[?2004l[?2004h>     L = apex_i
[?2004l[?2004h>     while (L - 1) in pos and pos[L - 1] < thr:
[?2004l[?2004h>         L -= 1
[?2004l[?2004h>     R = apex_i
[?2004l[?2004h>     while (R + 1) in pos and pos[R + 1] < thr:
[?2004l[?2004h>         R += 1
[?2004l[?2004h>     takeoff = L
[?2004l[?2004h>     landing = R + 1
[?2004l[?2004h>     return takeoff, landing
[?2004l[?2004h> 
[?2004l[?2004h> def write_toml(path, takeoff, landing):
[?2004l[?2004h>     with open(path, 'w') as f:
[?2004l[?2004h>         f.write(f'jump_takeoff_frame_number = {int(takeoff)}\n')
[?2004l[?2004h>         f.write(f'jump_land_frame_number = {int(landing)}\n')
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     video = sys.argv[1] if len(sys.argv) > 1 else '/app/example_video.mp4'
[?2004l[?2004h>     frames = load_frames(video)
[?2004l[?2004h>     if not frames:
[?2004l[?2004h>         raise RuntimeError('could not read video: ' + video)
[?2004l[?2004h>     rec = compute_feet(frames)
[?2004l[?2004h>     takeoff, landing = detect_jump(rec)
[?2004l[?2004h>     out = '/app/output.toml'
[?2004l[?2004h>     write_toml(out, takeoff, landing)
[?2004l[?2004h>     print(f'takeoff={takeoff} landing={landing} -> {out}')
[?2004l[?2004h> 
