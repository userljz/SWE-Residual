[?2004l[?2004h> import cv2, numpy as np
[?2004l[?2004h> cap = cv2.VideoCapture('/app/example_video.mp4')
[?2004l[?2004h> frames = []
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, f = cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     frames.append(f)
[?2004l[?2004h> cap.release()
[?2004l[?2004h> chars = ' .:-=+*#%@'
[?2004l[?2004h> def show(i, label):
[?2004l[?2004h>     g = cv2.cvtColor(frames[i], cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     H, W = g.shape
[?2004l[?2004h>     cols, rows = 96, 48
[?2004l[?2004h>     small = cv2.resize(g, (cols, rows), interpolation=cv2.INTER_AREA)
[?2004l[?2004h>     print(f'--- frame {i} ({label}) ---')
[?2004l[?2004h>     for r in range(rows):
[?2004l[?2004h>         line = ''
[?2004l[?2004h>         for c in range(cols):
[?2004l[?2004h>             v = small[r,c]
[?2004l[?2004h>             idx = int(v / 256 * len(chars))
[?2004l[?2004h>             line += chars[idx]
[?2004l[?2004h>         print(line)
[?2004l[?2004h> show(0,'background')
[?2004l[?2004h> EOF
