[?2004l[?2004h>     # row-wise and col-wise mean to see where change is
[?2004l[?2004h>     rowm = diff.mean(axis=1); colm = diff.mean(axis=0)
[?2004l[?2004h>     print(f'   rowmax at y={rowm.argmax()} val={rowm.max():.1f}  colmax at x={colm.argmax()} val={colm.max():.1f}')
