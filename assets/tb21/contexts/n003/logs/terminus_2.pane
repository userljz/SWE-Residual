[?2004l[?2004h> import cv2, numpy as np
[?2004l[?2004h> cap = cv2.VideoCapture('/app/example_video.mp4')
[?2004l[?2004h> frames = []
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, f = cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     frames.append(f.astype(np.float32))
[?2004l[?2004h> cap.release()
[?2004l[?2004h> N=len(frames); f0=frames[0]
[?2004l[?2004h> 
[?2004l[?2004h> def run(thr, close_k, open_k, label):
[?2004l[?2004h>     print(f'=== {label} ===')
[?2004l[?2004h>     ck=np.ones((close_k,close_k),np.uint8); ok=np.ones((open_k,open_k),np.uint8)
[?2004l[?2004h>     for i in range(N):
[?2004l[?2004h>         bg=np.abs(frames[i]-f0).max(axis=2)
[?2004l[?2004h>         m=(bg>thr).astype(np.uint8)
[?2004l[?2004h>         m=cv2.morphologyEx(m,cv2.MORPH_CLOSE,ck,iterations=2)
[?2004l[?2004h>         m=cv2.morphologyEx(m,cv2.MORPH_OPEN,ok,iterations=1)
[?2004l[?2004h>         n,lab,stats,cent=cv2.connectedComponentsWithStats(m,8)
[?2004l[?2004h>         if n<=1: print(f'{i:3d}: empty'); continue
[?2004l[?2004h>         a=stats[1:,cv2.CC_STAT_AREA]; best=1+int(np.argmax(a))
[?2004l[?2004h>         x,y,w,h,area=stats[best]
[?2004l[?2004h>         if area<200: print(f'{i:3d}: tiny({area})'); continue
[?2004l[?2004h>         print(f'{i:3d}: area={area:6d} feet={y+h:3d} top={y:3d} h={h:3d} x=[{x:3d},{x+w:3d}] cx={x+w/2:.0f}')
[?2004l[?2004h> 
[?2004l[?2004h> run(45,15,9,'bg thr45 close15 open9')
