[?2004l[?2004h>         d = np.abs(frames[i][y0:y1, x0:x1] - f0[y0:y1, x0:x1]).max(axis=2)
[?2004l[?2004h>         mm = (d > BG_THR).astype(np.uint8)
[?2004l[?2004h>         mm = cv2.morphologyEx(mm, cv2.MORPH_CLOSE, close, iterations=1)
[?2004l[?2004h>         sc = largest_cc(mm, SIL_MIN)
[?2004l[?2004h>         if sc is None:
[?2004l[?2004h>             continue
[?2004l[?2004h>         ax0 = sc[0] + x0
[?2004l[?2004h>         ax1 = ax0 + sc[2]
[?2004l[?2004h>         ay1 = sc[1] + y0 + sc[3]
[?2004l[?2004h>         if ax0 <= INTERIOR or ax1 >= W - INTERIOR:
[?2004l[?2004h>             continue
[?2004l[?2004h>         feet[i] = ay1
[?2004l[?2004h>     return feet
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def detect_jump(feet, window):
[?2004l[?2004h>     s, e = window
[?2004l[?2004h>     vals = [feet[i] for i in range(s, e + 1) if i in feet]
