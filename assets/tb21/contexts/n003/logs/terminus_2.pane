[?2004l[?2004h> 
[?2004l[?2004h> def compute_feet(frames, window):
[?2004l[?2004h>     N = len(frames)
[?2004l[?2004h>     H, W = frames[0].shape[:2]
[?2004l[?2004h>     f0 = frames[0]
[?2004l[?2004h>     ts = int(0.45 * H)
[?2004l[?2004h>     dil = np.ones((9, 9), np.uint8)
[?2004l[?2004h>     close = np.ones((5, 5), np.uint8)
[?2004l[?2004h>     s, e = window
[?2004l[?2004h>     feet = {}
[?2004l[?2004h>     for i in range(max(1, s - 1), min(N, e + 2)):
[?2004l[?2004h>         # localizer: union of motion over a 5-frame span (robust at the apex)
[?2004l[?2004h>         u = np.zeros((H, W), np.uint8)
[?2004l[?2004h>         for j in range(max(1, i - 2), min(N, i + 2) + 1):
[?2004l[?2004h>             if j < 1 or j >= N:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             u = np.maximum(u, motion_mask(frames, j, ts))
[?2004l[?2004h>         u = cv2.dilate(u, dil, iterations=1)
[?2004l[?2004h>         lc = largest_cc(u, LOCALIZER_MIN)
[?2004l[?2004h>         if lc is None:
[?2004l[?2004h>             continue
[?2004l[?2004h>         cx = lc[5]
[?2004l[?2004h>         x0 = max(INTERIOR, int(cx - 120))
[?2004l[?2004h>         x1 = min(W - INTERIOR, int(cx + 120))
