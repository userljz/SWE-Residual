[?2004hroot@2d847769624e:/app# cat > /app/film.py << 'EOF'
[?2004l[?2004h> import cv2, numpy as np
[?2004l[?2004h> cap = cv2.VideoCapture('/app/example_video.mp4')
[?2004l[?2004h> frames = []
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, f = cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     frames.append(f)
[?2004l[?2004h> cap.release()
[?2004l[?2004h> chars = ' .:-=+*#%@'
[?2004l[?2004h> H, W = 14, 100
[?2004l[?2004h> for i in range(0, len(frames)):
[?2004l[?2004h>     g = cv2.cvtColor(frames[i], cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>     small = cv2.resize(g, (W, H), interpolation=cv2.INTER_AREA)
[?2004l[?2004h>     rows = [''.join(chars[int(v/256*len(chars))] for v in small[r]) for r in range(H)]
[?2004l[?2004h>     print(f'{i:3d}|' + rows[0])
[?2004l[?2004h> EOF
[?2004l[?2004hroot@2d847769624e:/app# python3 /app/film.py 2>&1 | head -130
