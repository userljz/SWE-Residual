    18	# Principal axes from /tmp/pca_pure.py.
    19	mean=[129.795530,112.372980,32.261357]
    20	axes=[[0.866572,0.355702,0.350043],[-0.394770,0.917689,0.044774]]
    21	def proj(p): return [sum((p[i]-mean[i])*a[i] for i in range(3)) for a in axes]
    22	ps=[(proj((s[0],s[1],s[2])),proj((s[3],s[4],s[5]))) for s in segs]
    23	vals=[q for pair in ps for q in pair]
    24	u0=min(q[0] for q in vals); u1=max(q[0] for q in vals)
    25	v0=min(q[1] for q in vals); v1=max(q[1] for q in vals)
    26	
    27	# 6 pixels/mm, with a modest dilation representing extrusion width.
    28	S=6.0
    29	W=int(math.ceil((u1-u0)*S))+1; H=int(math.ceil((v1-v0)*S))+1
    30	pix=[[0]*W for _ in range(H)]
    31	def mark(x,y,r=1):
    32	    for yy in range(max(0,y-r),min(H,y+r+1)):
    33	        for xx in range(max(0,x-r),min(W,x+r+1)):
    34	            pix[yy][xx]=1
    35	for a,b in ps:
    36	    ax=round((a[0]-u0)*S); ay=round((a[1]-v0)*S)
    37	    bx=round((b[0]-u0)*S); by=round((b[1]-v0)*S)
    38	    dx=abs(bx-ax); dy=-abs(by-ay); sx=1 if ax<bx else -1; sy=1 if ay<by else -1; err=dx+dy
    39	    while True:
    40	        mark(ax,ay,1)
    41	        if ax==bx and ay==by: break
    42	        e2=2*err
    43	        if e2>=dy: err+=dy; ax+=sx
    44	        if e2<=dx: err+=dx; ay+=sy
    45	
    46	# Downsample 6x6 source pixels to one terminal character (about 1 mm wide x 0.5 mm tall).
    47	def render(flip_x=False,flip_y=False,chunk=100):
    48	    CW=6; CH=3  # source pixels per character; S/CW=1 mm, S/CH=2 mm vertically
    49	    outw=math.ceil(W/CW); outh=math.ceil(H/CH)
    50	    rows=[]
    51	    for cy in range(outh):
    52	        row=''
    53	        for cx in range(outw):
    54	            n=0
    55	            for yy in range(cy*CH,min(H,(cy+1)*CH)):
    56	                for xx in range(cx*CW,min(W,(cx+1)*CW)):
    57	                    n+=pix[yy][xx]
    58	            row += '#' if n>=2 else ('+' if n==1 else ' ')
    59	        if flip_y: row=row[::-1]
    60	        rows.append(row)
    61	    if flip_x: rows=rows[::-1]
    62	    # Trim blank edges.
    63	    while rows and not rows[0].strip(): rows.pop(0)
    64	    while rows and not rows[-1].strip(): rows.pop()
    65	    if rows:
    66	        lo=min(next((i for i,c in enumerate(r) if c!=' '),len(r)) for r in rows)
    67	        hi=max(next((len(r)-i-1 for i,c in reversed(list(enumerate(r))) if c!=' '),-1) for r in rows)
    68	        rows=[r[lo:hi+1] for r in rows]
    69	    print(f'\n=== flip_x={flip_x} flip_y={flip_y}; plane size {u1-u0:.1f} x {v1-v0:.1f} mm; chars {max(map(len,rows),default=0)}x{len(rows)} ===')
    70	    for start in range(0,max(map(len,rows),default=1),chunk):
    71	        print(f'-- columns {start+1}-{min(start+chunk,max(map(len,rows),default=0))} --')
    72	        for r in rows: print(r[start:start+chunk])
    73	        print()
    74	
    75	print(f'{len(segs)} extruding segments; principal-plane bounds U {u0:.3f}..{u1:.3f}, V {v0:.3f}..{v1:.3f}; raster {W}x{H}')
    76	for fx in (False,True):
    77	    for fy in (False,True): render(fx,fy)
