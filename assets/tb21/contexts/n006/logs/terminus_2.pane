[?2004l[?2004h> import re, math
[?2004l[?2004h> fn='/app/text.gcode'
[?2004l[?2004h> cmd=re.compile(r'^([GM])(\d+(?:\.\d+)?)(?:\s+(.*))?$')
[?2004l[?2004h> word=re.compile(r'([A-Za-z])([-+]?\d*\.?\d+)')
[?2004l[?2004h> pos={'X':0.,'Y':0.,'Z':0.}; obj=None; segs=[]
[?2004l[?2004h> for line in open(fn):
[?2004l[?2004h>     line=line.split(';',1)[0].strip(); m=cmd.match(line)
[?2004l[?2004h>     if not m: continue
[?2004l[?2004h>     typ,num,rest=m.group(1),float(m.group(2)),m.group(3) or ''
[?2004l[?2004h>     w={k:float(v) for k,v in word.findall(rest)}
[?2004l[?2004h>     if typ=='M' and num==486 and 'S' in w: obj=int(w['S']); continue
[?2004l[?2004h>     if typ=='G' and num in (0,1):
[?2004l[?2004h>         old=(pos['X'],pos['Y'],pos['Z']); new=tuple(w.get(a,pos[a]) for a in ('X','Y','Z'))
[?2004l[?2004h>         if obj==0 and w.get('E',0.)>0 and math.dist(old,new)>1e-7: segs.append((old,new))
[?2004l[?2004h>         pos=dict(zip(('X','Y','Z'),new))
[?2004l[?2004h> mean=[129.795530,112.372980,32.261357]
[?2004l[?2004h> axes=[[0.866572,0.355702,0.350043],[-0.394770,0.917689,0.044774]]
[?2004l[?2004h> def pr(p): return tuple(sum((p[i]-mean[i])*axes[j][i] for i in range(3)) for j in range(2))
[?2004l[?2004h> ps=[(pr(a),pr(b)) for a,b in segs]
[?2004l[?2004h> vals=[p for pair in ps for p in pair]
[?2004l[?2004h> u0=min(x for x,y in vals); u1=max(x for x,y in vals)
[?2004l[?2004h> v0=min(y for x,y in vals); v1=max(y for x,y in vals)
[?2004l[?2004h> S=10.; W=math.ceil((u1-u0)*S)+1; H=math.ceil((v1-v0)*S)+1
[?2004l[?2004h> pix=[[0]*W for _ in range(H)]
[?2004l[?2004h> def mark(x,y,r=2):
[?2004l[?2004h>     for yy in range(max(0,y-r),min(H,y+r+1)):
[?2004l[?2004h>         for xx in range(max(0,x-r),min(W,x+r+1)): pix[yy][xx]=1
[?2004l[?2004h> for a,b in ps:
[?2004l[?2004h>     ax=round((a[0]-u0)*S); ay=round((a[1]-v0)*S)
[?2004l[?2004h>     bx=round((b[0]-u0)*S); by=round((b[1]-v0)*S)
[?2004l[?2004h>     dx=abs(bx-ax); dy=-abs(by-ay); sx=1 if ax<bx else -1; sy=1 if ay<by else -1; err=dx+dy
[?2004l[?2004h>     while True:
[?2004l[?2004h>         mark(ax,ay)
[?2004l[?2004h>         if ax==bx and ay==by: break
[?2004l[?2004h>         e2=2*err
[?2004l[?2004h>         if e2>=dy: err+=dy; ax+=sx
[?2004l[?2004h>         if e2<=dx: err+=dx; ay+=sy
[?2004l[?2004h> # Correct orientation: horizontal and vertical flip.
[?2004l[?2004h> a=[row[::-1] for row in pix][::-1]
[?2004l[?2004h> margin=50; w=len(a[0])+2*margin; h=len(a)+2*margin
[?2004l[?2004h> with open('/tmp/all_paths.pgm','wb') as f:
[?2004l[?2004h>     f.write(f'P5\n{w} {h}\n255\n'.encode()); blank=bytearray([255])*w
[?2004l[?2004h>     for _ in range(margin): f.write(blank)
[?2004l[?2004h>     for row in a:
[?2004l[?2004h>         f.write(bytearray([255])*margin); f.write(bytearray(0 if v else 255 for v in row)); f.write(bytearray([255])*margin)
[?2004l[?2004h>     for _ in range(margin): f.write(blank)
