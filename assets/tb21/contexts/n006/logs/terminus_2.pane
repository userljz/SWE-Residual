[?2004l[?2004h>             segs.append((pos['X'],pos['Y'],new['X'],new['Y']))
[?2004l[?2004h>         pos=new
[?2004l[?2004h> 
[?2004l[?2004h> xs=[v for s in segs for v in (s[0],s[2])]
[?2004l[?2004h> ys=[v for s in segs for v in (s[1],s[3])]
[?2004l[?2004h> x0,x1=min(xs),max(xs); y0,y1=min(ys),max(ys)
[?2004l[?2004h> scale=2.0
[?2004l[?2004h> W=int(math.ceil((x1-x0)*scale))+1
[?2004l[?2004h> H=int(math.ceil((y1-y0)*scale))+1
[?2004l[?2004h> pix=[[0]*W for _ in range(H)]
[?2004l[?2004h> 
[?2004l[?2004h> def plot(x,y):
[?2004l[?2004h>     xi=round((x-x0)*scale); yi=round((y-y0)*scale)
[?2004l[?2004h>     if 0<=xi<W and 0<=yi<H: pix[yi][xi]=1
[?2004l[?2004h> 
[?2004l[?2004h> for x_a,y_a,x_b,y_b in segs:
[?2004l[?2004h>     ax=round((x_a-x0)*scale); ay=round((y_a-y0)*scale)
[?2004l[?2004h>     bx=round((x_b-x0)*scale); by=round((y_b-y0)*scale)
[?2004l[?2004h>     dx=abs(bx-ax); dy=-abs(by-ay); sx=1 if ax<bx else -1; sy=1 if ay<by else -1
[?2004l[?2004h>     err=dx+dy
[?2004l[?2004h>     while True:
[?2004l[?2004h>         if 0<=ax<W and 0<=ay<H: pix[ay][ax]=1
[?2004l[?2004h>         if ax==bx and ay==by: break
[?2004l[?2004h>         e2=2*err
[?2004l[?2004h>         if e2>=dy: err+=dy; ax+=sx
[?2004l[?2004h>         if e2<=dx: err+=dx; ay+=sy
[?2004l[?2004h> 
[?2004l[?2004h> # Add immediate neighbors so thin diagonal strokes remain connected/visible.
[?2004l[?2004h> base=[row[:] for row in pix]
[?2004l[?2004h> for y,row in enumerate(base):
[?2004l[?2004h>     for x,v in enumerate(row):
[?2004l[?2004h>         if v:
[?2004l[?2004h>             for yy in range(max(0,y-1),min(H,y+2)):
[?2004l[?2004h>                 for xx in range(max(0,x-1),min(W,x+2)):
[?2004l[?2004h>                     pix[yy][xx]=1
[?2004l[?2004h> 
[?2004l[?2004h> def braille(flip_y=False):
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for cy in range(0,H,4):
[?2004l[?2004h>         row=''
[?2004l[?2004h>         for cx in range(0,W,2):
[?2004l[?2004h>             code=0
[?2004l[?2004h>             for dy in range(4):
[?2004l[?2004h>                 for dx in range(2):
[?2004l[?2004h>                     y=H-1-(cy+dy) if flip_y else cy+dy
[?2004l[?2004h>                     if 0<=y<H and 0<=cx+dx<W and pix[y][cx+dx]:
[?2004l[?2004h>                         code |= 1 << (dy*2+dx)
[?2004l[?2004h>             row+=chr(0x2800+code)
[?2004l[?2004h>         out.append(row.rstrip(chr(0x2800)))
[?2004l[?2004h>     while out and not out[-1]: out.pop()
[?2004l[?2004h>     return '\n'.join(out)
[?2004l[?2004h> 
[?2004l[?2004h> print(f'{len(segs)} segments; bounds X {x0:.3f}..{x1:.3f}, Y {y0:.3f}..{y1:.3f}; raster {W}x{H}')
[?2004l[?2004h> print('\n=== Y INCREASING UPWARD (standard plot orientation) ===')
[?2004l[?2004h> print(braille(False))
[?2004l[?2004h> print('\n=== Y INCREASING DOWNWARD (printer top-view orientation) ===')
[?2004l[?2004h> print(braille(True))
[?2004l[?2004h> PY
