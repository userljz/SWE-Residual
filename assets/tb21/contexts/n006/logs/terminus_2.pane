[?2004l[?2004h> from collections import defaultdict
[?2004l[?2004h> byz=defaultdict(list)
[?2004l[?2004h> for s in segments: byz[round(s[6],3)].append(s)
[?2004l[?2004h> for z in [float(x) for x in sys.argv[1:]]:
[?2004l[?2004h>  ss=byz[round(z,3)]
[?2004l[?2004h>  pts=[(x,y) for s in ss for x,y in ((s[1],s[2]),(s[4],s[5]))]
[?2004l[?2004h>  x0,x1=min(x for x,y in pts),max(x for x,y in pts); y0,y1=min(y for x,y in pts),max(y for x,y in pts)
[?2004l[?2004h>  W=72; H=max(1,round(W*(y1-y0)/max(x1-x0,.001)/2))
[?2004l[?2004h>  grid=[[' ']*W for _ in range(H)]
[?2004l[?2004h>  for s in ss:
[?2004l[?2004h>   ax=(s[1]-x0)/(x1-x0+1e-9)*(W-1); bx=(s[4]-x0)/(x1-x0+1e-9)*(W-1)
[?2004l[?2004h>   ay=(s[2]-y0)/(y1-y0+1e-9)*(H-1); by=(s[5]-y0)/(y1-y0+1e-9)*(H-1)
