[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> 
[?2004l[?2004h> def read_pgm(path):
[?2004l[?2004h>     data=Path(path).read_bytes()
[?2004l[?2004h>     assert data[:2]==b'P5'
[?2004l[?2004h>     pos=2; vals=[]
[?2004l[?2004h>     while len(vals)<3:
[?2004l[?2004h>         while pos<len(data) and data[pos:pos+1].isspace(): pos+=1
[?2004l[?2004h>         if data[pos:pos+1]==b'#':
[?2004l[?2004h>             while data[pos:pos+1] not in b'\r\n': pos+=1
[?2004l[?2004h>             continue
[?2004l[?2004h>         start=pos
[?2004l[?2004h>         while pos<len(data) and not data[pos:pos+1].isspace(): pos+=1
[?2004l[?2004h>         vals.append(int(data[start:pos]))
[?2004l[?2004h>     pos+=1
[?2004l[?2004h>     w,h,maxval=vals
[?2004l[?2004h>     return w,h,data[pos:pos+w*h]
[?2004l[?2004h> 
[?2004l[?2004h> w,h,pix=read_pgm('/tmp/text_fx0_fy1.pgm')
[?2004l[?2004h> def show(name,x0,x1,ytop,ybottom,pad=8):
[?2004l[?2004h>     x0=max(0,x0-pad); x1=min(w,x1+pad)
[?2004l[?2004h>     y0=max(0,ytop-pad); y1=min(h,ybottom+pad)
[?2004l[?2004h>     print(f'\n=== {name}: x {x0}..{x1}, y {y0}..{y1} ===')
[?2004l[?2004h>     for yy in range(y0,y1,2):
[?2004l[?2004h>         row=''
[?2004l[?2004h>         for xx in range(x0,x1):
[?2004l[?2004h>             top=pix[yy*w+xx] < 128
[?2004l[?2004h>             bot=(yy+1<y1 and pix[(yy+1)*w+xx] < 128)
[?2004l[?2004h>             row += '█' if top and bot else ('▀' if top else ('▄' if bot else ' '))
[?2004l[?2004h>         print(row.rstrip())
[?2004l[?2004h> 
[?2004l[?2004h> # Tesseract boxes use bottom-origin coordinates; convert y to image coordinates.
[?2004l[?2004h> show('O or 0',441,504,h-171,h-77)
