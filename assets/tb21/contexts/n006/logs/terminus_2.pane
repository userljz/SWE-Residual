[?2004l[?2004h> word=re.compile(r'([A-Za-z])([-+]?\d*\.?\d+)')
[?2004l[?2004h> pos={'X':0.,'Y':0.,'Z':0.}; obj=None; f=0
[?2004l[?2004h> chains=[]; cur=[]; last_endpoint=None
[?2004l[?2004h> 
[?2004l[?2004h> def dist3(a,b): return math.dist(a,b)
[?2004l[?2004h> def flush():
[?2004l[?2004h>  global cur
[?2004l[?2004h>  if cur:
[?2004l[?2004h>   chains.append(cur); cur=[]
[?2004l[?2004h> for n,line in enumerate(open(fn),1):
[?2004l[?2004h>  line=line.split(';',1)[0].strip(); m=cmd.match(line)
[?2004l[?2004h>  if not m: continue
[?2004l[?2004h>  typ,num,rest=m.group(1),float(m.group(2)),m.group(3) or ''; w={k:float(v) for k,v in word.findall(rest)}
[?2004l[?2004h>  if typ=='M' and num==486 and 'S' in w:
[?2004l[?2004h>   flush(); obj=int(w['S']); continue
[?2004l[?2004h>  if typ=='G' and num in (0,1):
[?2004l[?2004h>   if 'F' in w: f=w['F']
[?2004l[?2004h>   old=(pos['X'],pos['Y'],pos['Z']); new=tuple(w.get(a,pos[a]) for a in ('X','Y','Z')); de=w.get('E',0.)
[?2004l[?2004h>   moved=dist3(old,new)>1e-7
[?2004l[?2004h>   if obj==0 and de>0 and moved:
[?2004l[?2004h>    if cur and dist3(cur[-1][1],old)>0.01: flush()
[?2004l[?2004h>    cur.append((n,old,new,de,f))
[?2004l[?2004h>   elif moved or de<0:
[?2004l[?2004h>    flush()
[?2004l[?2004h>   pos={'X':new[0],'Y':new[1],'Z':new[2]}
[?2004l[?2004h> flush()
[?2004l[?2004h> print('chains',len(chains))
[?2004l[?2004h> stats=collections.Counter(); examples=[]
[?2004l[?2004h> prepared=[]
[?2004l[?2004h> for c in chains:
[?2004l[?2004h>  pts=[c[0][1]]+[x[2] for x in c]
[?2004l[?2004h>  length=sum(math.dist(a[2],a[1]) for a in c)
[?2004l[?2004h>  closure=math.dist(pts[0],pts[-1])
[?2004l[?2004h>  closed=closure<0.08
[?2004l[?2004h>  stats['closed' if closed else 'open']+=1
[?2004l[?2004h>  if closed:
[?2004l[?2004h>   xs=[p[0] for p in pts]; ys=[p[1] for p in pts]; zs=[p[2] for p in pts]
[?2004l[?2004h>   prepared.append((c,pts,length,closure,(min(xs),max(xs),min(ys),max(ys),min(zs),max(zs))))
[?2004l[?2004h>   if len(examples)<15: examples.append((len(c),length,closure,pts[0],pts[-1],(min(xs),max(xs),min(ys),max(ys))))
[?2004l[?2004h> print('stats',dict(stats))
[?2004l[?2004h> print('closed examples: command_count length closure start end bbox')
[?2004l[?2004h> for x in examples: print(x)
[?2004l[?2004h> print('closed length distribution:')
