     5	pos={'X':0.0,'Y':0.0,'Z':0.0}; cur=None; segs=[]
     6	for line in open(fn,errors='replace'):
     7	    line=line.split(';',1)[0].strip(); m=cmd_re.match(line)
     8	    if not m: continue
     9	    typ,num,rest=m.group(1),float(m.group(2)),m.group(3) or ''
    10	    words={k:float(v) for k,v in word_re.findall(rest)}
    11	    if typ=='M' and num==486 and 'S' in words: cur=int(words['S']); continue
    12	    if typ=='G' and num in (0,1):
    13	        new={a:words.get(a,pos[a]) for a in ('X','Y','Z')}; de=words.get('E',0.0)
    14	        if cur==0 and de>0 and any(abs(new[a]-pos[a])>1e-7 for a in ('X','Y','Z')):
    15	            segs.append((pos['X'],pos['Y'],pos['Z'],new['X'],new['Y'],new['Z']))
    16	        pos=new
