[?2004l[?2004h> import pickle, math
[?2004l[?2004h> paths=pickle.load(open('/tmp/closed_points.pkl','rb'))
[?2004l[?2004h> mean=[129.795530,112.372980,32.261357]
[?2004l[?2004h> axes=[[0.866572,0.355702,0.350043],[-0.394770,0.917689,0.044774]]
[?2004l[?2004h> def pr(p): return (sum((p[i]-mean[i])*axes[0][i] for i in range(3)), sum((p[i]-mean[i])*axes[1][i] for i in range(3)))
[?2004l[?2004h> segs=[]
[?2004l[?2004h> for pts in paths:
[?2004l[?2004h>     q=[pr(p) for p in pts]
[?2004l[?2004h>     segs.extend(zip(q,q[1:]))
[?2004l[?2004h> vals=[p for pair in segs for p in pair]
[?2004l[?2004h> u0=min(x for x,y in vals); u1=max(x for x,y in vals)
[?2004l[?2004h> v0=min(y for x,y in vals); v1=max(y for x,y in vals)
[?2004l[?2004h> S=12.0
[?2004l[?2004h> W=math.ceil((u1-u0)*S)+1; H=math.ceil((v1-v0)*S)+1
[?2004l[?2004h> pix=[[0]*W for _ in range(H)]
[?2004l[?2004h> def mark(x,y,r=2):
[?2004l[?2004h>     for yy in range(max(0,y-r),min(H,y+r+1)):
[?2004l[?2004h>         for xx in range(max(0,x-r),min(W,x+r+1)): pix[yy][xx]=1
[?2004l[?2004h> for a,b in segs:
[?2004l[?2004h>     ax=round((a[0]-u0)*S); ay=round((a[1]-v0)*S)
[?2004l[?2004h>     bx=round((b[0]-u0)*S); by=round((b[1]-v0)*S)
[?2004l[?2004h>     dx=abs(bx-ax); dy=-abs(by-ay); sx=1 if ax<bx else -1; sy=1 if ay<by else -1; err=dx+dy
[?2004l[?2004h>     while True:
[?2004l[?2004h>         mark(ax,ay)
[?2004l[?2004h>         if ax==bx and ay==by: break
[?2004l[?2004h>         e2=2*err
[?2004l[?2004h>         if e2>=dy: err+=dy; ax+=sx
[?2004l[?2004h>         if e2<=dx: err+=dx; ay+=sy
[?2004l[?2004h> # CW=6 and CH=3 gives 0.5 mm wide by 0.25 mm tall per character;
[?2004l[?2004h> # with terminal cell aspect ~2:1, glyphs display with correct proportions.
[?2004l[?2004h> CW=6; CH=3
[?2004l[?2004h> outw=math.ceil(W/CW); outh=math.ceil(H/CH)
[?2004l[?2004h> base=[]
[?2004l[?2004h> for cy in range(outh):
[?2004l[?2004h>     row=''
[?2004l[?2004h>     for cx in range(outw):
[?2004l[?2004h>         n=sum(pix[y][x] for y in range(cy*CH,min(H,(cy+1)*CH)) for x in range(cx*CW,min(W,(cx+1)*CW)))
[?2004l[?2004h>         row += '#' if n>=2 else ('+' if n==1 else ' ')
[?2004l[?2004h>     base.append(row)
[?2004l[?2004h> 
[?2004l[?2004h> def clean(rows):
[?2004l[?2004h>     while rows and not rows[0].strip(): rows.pop(0)
[?2004l[?2004h>     while rows and not rows[-1].strip(): rows.pop()
[?2004l[?2004h>     if not rows: return []
[?2004l[?2004h>     lo=min(next((i for i,c in enumerate(r) if c!=' '),len(r)) for r in rows)
[?2004l[?2004h>     hi=max(next((i for i in range(len(r)-1,-1,-1) if r[i]!=' '),-1) for r in rows)
[?2004l[?2004h>     return [r[lo:hi+1] for r in rows]
[?2004l[?2004h> 
[?2004l[?2004h> variants=[]
[?2004l[?2004h> for fy in (False,True):
[?2004l[?2004h>     for fx in (False,True):
[?2004l[?2004h>         rows=[r[::-1] if fy else r for r in base]
[?2004l[?2004h>         if fx: rows=rows[::-1]
[?2004l[?2004h>         variants.append(((fx,fy),clean(rows)))
[?2004l[?2004h> print(f'{len(paths)} closed loops, {len(segs)} loop segments; bounds {u1-u0:.1f} x {v1-v0:.1f} mm; chars {outw}x{outh}')
[?2004l[?2004h> for key,rows in variants:
[?2004l[?2004h>     print(f'\n=== flip_x={key[0]} flip_y={key[1]} chars={max(map(len,rows),default=0)}x{len(rows)} ===')
[?2004l[?2004h> PY
