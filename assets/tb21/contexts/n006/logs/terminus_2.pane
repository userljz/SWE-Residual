[?2004l[?2004h> import re, collections, math
[?2004l[?2004h> fn='/app/text.gcode'
[?2004l[?2004h> cmd=re.compile(r'^([GM])(\d+(?:\.\d+)?)(?:\s+(.*))?$'); word=re.compile(r'([A-Za-z])([-+]?\d*\.?\d+)')
[?2004l[?2004h> pos={'X':0.,'Y':0.,'Z':0.}; obj=None; f=0; speeds=collections.Counter(); lens=collections.Counter(); examples={}
[?2004l[?2004h> for n,line in enumerate(open(fn),1):
[?2004l[?2004h>  line=line.split(';',1)[0].strip(); m=cmd.match(line)
[?2004l[?2004h>  if not m: continue
