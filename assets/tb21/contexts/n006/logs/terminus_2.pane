[?2004l[?2004h> import re, math
[?2004l[?2004h> fn='/app/text.gcode'
[?2004l[?2004h> cmd_re=re.compile(r'^([GM])(\d+(?:\.\d+)?)(?:\s+(.*))?$')
[?2004l[?2004h> word_re=re.compile(r'([A-Za-z])([-+]?\d*\.?\d+)')
[?2004l[?2004h> pos={'X':0.0,'Y':0.0,'Z':0.0}; cur=None; segs=[]
