[?2004l[?2004h> import numpy as np
[?2004l[?2004h> pts=[]
[?2004l[?2004h> for s in segments:
[?2004l[?2004h>     # Weight each segment by its extrusion amount and include both endpoints.
[?2004l[?2004h>     w=max(s[7],1e-6)
[?2004l[?2004h>     pts.extend([(s[1],s[2],s[3],w),(s[4],s[5],s[6],w)])
[?2004l[?2004h> a=np.array(pts,dtype=float); p=a[:,:3]; w=a[:,3]
[?2004l[?2004h> mean=np.average(p,axis=0,weights=w)
[?2004l[?2004h> Q=p-mean
[?2004l[?2004h> C=(Q*w[:,None]).T@Q/w.sum()
[?2004l[?2004h> val,vec=np.linalg.eigh(C)
[?2004l[?2004h> print('mean',mean)
[?2004l[?2004h> print('variances',val)
[?2004l[?2004h> print('stddevs',np.sqrt(val))
[?2004l[?2004h> for i in range(3):
[?2004l[?2004h>  print('component',i,'eigenvalue',val[i],'vector',vec[:,i])
[?2004l[?2004h> normal=vec[:,0]
[?2004l[?2004h> print('plane normal',normal,'distance',-mean@normal)
[?2004l[?2004h> # Extents along principal axes
[?2004l[?2004h> P=Q@vec
[?2004l[?2004h> for i in range(3): print(f'axis {i}: {P[:,i].min():.3f} .. {P[:,i].max():.3f}, range={P[:,i].max()-P[:,i].min():.3f}')
[?2004l[?2004h> PY
