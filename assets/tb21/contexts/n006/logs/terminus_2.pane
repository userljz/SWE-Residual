[?2004l[?2004h>     if not m: continue
[?2004l[?2004h>     typ,num,rest=m.group(1),float(m.group(2)),m.group(3) or ''
[?2004l[?2004h>     words={k:float(v) for k,v in word_re.findall(rest)}
[?2004l[?2004h>     if typ=='M' and num==486 and 'S' in words: cur=int(words['S']); continue
[?2004l[?2004h>     if typ=='G' and num in (0,1):
[?2004l[?2004h>         new={a:words.get(a,pos[a]) for a in ('X','Y','Z')}; de=words.get('E',0.0)
[?2004l[?2004h>         if cur==0 and de>0 and any(abs(new[a]-pos[a])>1e-7 for a in ('X','Y','Z')):
[?2004l[?2004h>             segs.append((pos['X'],pos['Y'],pos['Z'],new['X'],new['Y'],new['Z']))
[?2004l[?2004h>         pos=new
[?2004l[?2004h> 
[?2004l[?2004h> # Principal axes from /tmp/pca_pure.py.
[?2004l[?2004h> mean=[129.795530,112.372980,32.261357]
[?2004l[?2004h> axes=[[0.866572,0.355702,0.350043],[-0.394770,0.917689,0.044774]]
[?2004l[?2004h> def proj(p): return [sum((p[i]-mean[i])*a[i] for i in range(3)) for a in axes]
[?2004l[?2004h> ps=[(proj((s[0],s[1],s[2])),proj((s[3],s[4],s[5]))) for s in segs]
[?2004l[?2004h> vals=[q for pair in ps for q in pair]
[?2004l[?2004h> u0=min(q[0] for q in vals); u1=max(q[0] for q in vals)
[?2004l[?2004h> v0=min(q[1] for q in vals); v1=max(q[1] for q in vals)
[?2004l[?2004h> 
[?2004l[?2004h> # 6 pixels/mm, with a modest dilation representing extrusion width.
[?2004l[?2004h> S=6.0
[?2004l[?2004h> W=int(math.ceil((u1-u0)*S))+1; H=int(math.ceil((v1-v0)*S))+1
[?2004l[?2004h> pix=[[0]*W for _ in range(H)]
[?2004l[?2004h> def mark(x,y,r=1):
[?2004l[?2004h>     for yy in range(max(0,y-r),min(H,y+r+1)):
[?2004l[?2004h>         for xx in range(max(0,x-r),min(W,x+r+1)):
[?2004l[?2004h>             pix[yy][xx]=1
[?2004l[?2004h> for a,b in ps:
[?2004l[?2004h>     ax=round((a[0]-u0)*S); ay=round((a[1]-v0)*S)
[?2004l[?2004h>     bx=round((b[0]-u0)*S); by=round((b[1]-v0)*S)
[?2004l[?2004h>     dx=abs(bx-ax); dy=-abs(by-ay); sx=1 if ax<bx else -1; sy=1 if ay<by else -1; err=dx+dy
[?2004l[?2004h>     while True:
[?2004l[?2004h>         mark(ax,ay,1)
[?2004l[?2004h>         if ax==bx and ay==by: break
[?2004l[?2004h>         e2=2*err
[?2004l[?2004h>         if e2>=dy: err+=dy; ax+=sx
[?2004l[?2004h>         if e2<=dx: err+=dx; ay+=sy
[?2004l[?2004h> 
[?2004l[?2004h> # Downsample 6x6 source pixels to one terminal character (about 1 mm wide x 0.5 mm tall).
[?2004l[?2004h> def render(flip_x=False,flip_y=False,chunk=100):
[?2004l[?2004h>     CW=6; CH=3  # source pixels per character; S/CW=1 mm, S/CH=2 mm vertically
[?2004l[?2004h>     outw=math.ceil(W/CW); outh=math.ceil(H/CH)
[?2004l[?2004h>     rows=[]
[?2004l[?2004h>     for cy in range(outh):
[?2004l[?2004h>         row=''
[?2004l[?2004h>         for cx in range(outw):
[?2004l[?2004h>             n=0
[?2004l[?2004h>             for yy in range(cy*CH,min(H,(cy+1)*CH)):
[?2004l[?2004h>                 for xx in range(cx*CW,min(W,(cx+1)*CW)):
[?2004l[?2004h>                     n+=pix[yy][xx]
[?2004l[?2004h>             row += '#' if n>=2 else ('+' if n==1 else ' ')
[?2004l[?2004h>         if flip_y: row=row[::-1]
[?2004l[?2004h>         rows.append(row)
[?2004l[?2004h>     if flip_x: rows=rows[::-1]
[?2004l[?2004h>     # Trim blank edges.
[?2004l[?2004h>     while rows and not rows[0].strip(): rows.pop(0)
[?2004l[?2004h>     while rows and not rows[-1].strip(): rows.pop()
[?2004l[?2004h>     if rows:
[?2004l[?2004h>         lo=min(next((i for i,c in enumerate(r) if c!=' '),len(r)) for r in rows)
[?2004l[?2004h>         hi=max(next((len(r)-i-1 for i,c in reversed(list(enumerate(r))) if c!=' '),-1) for r in rows)
[?2004l[?2004h>         rows=[r[lo:hi+1] for r in rows]
[?2004l[?2004h>     print(f'\n=== flip_x={flip_x} flip_y={flip_y}; plane size {u1-u0:.1f} x {v1-v0:.1f} mm; chars {max(map(len,rows),default=0)}x{len(rows)} ===')
[?2004l[?2004h>     for start in range(0,max(map(len,rows),default=1),chunk):
[?2004l[?2004h>         print(f'-- columns {start+1}-{min(start+chunk,max(map(len,rows),default=0))} --')
[?2004l[?2004h>         for r in rows: print(r[start:start+chunk])
[?2004l[?2004h>         print()
[?2004l[?2004h> 
[?2004l[?2004h> print(f'{len(segs)} extruding segments; principal-plane bounds U {u0:.3f}..{u1:.3f}, V {v0:.3f}..{v1:.3f}; raster {W}x{H}')
[?2004l[?2004h> for fx in (False,True):
[?2004l[?2004h>     for fy in (False,True): render(fx,fy)
