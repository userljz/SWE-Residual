[?2004l[?2004h> import pickle, math
[?2004l[?2004h> paths=pickle.load(open('/tmp/closed_points.pkl','rb'))
[?2004l[?2004h> mean=[129.795530,112.372980,32.261357]
[?2004l[?2004h> axes=[[0.866572,0.355702,0.350043],[-0.394770,0.917689,0.044774]]
[?2004l[?2004h> def pr(p):
[?2004l[?2004h>     return (sum((p[i]-mean[i])*axes[0][i] for i in range(3)),
[?2004l[?2004h>             sum((p[i]-mean[i])*axes[1][i] for i in range(3)))
[?2004l[?2004h> segs=[]
[?2004l[?2004h> for path in paths:
[?2004l[?2004h>     q=[pr(p) for p in path]
[?2004l[?2004h>     segs.extend(zip(q,q[1:]))
[?2004l[?2004h> vals=[p for pair in segs for p in pair]
[?2004l[?2004h> u0=min(x for x,y in vals); u1=max(x for x,y in vals)
[?2004l[?2004h> v0=min(y for x,y in vals); v1=max(y for x,y in vals)
[?2004l[?2004h> S=10.0
[?2004l[?2004h> W=math.ceil((u1-u0)*S)+1; H=math.ceil((v1-v0)*S)+1
[?2004l[?2004h> pix=[[0]*W for _ in range(H)]
[?2004l[?2004h> def mark(x,y,r=2):
[?2004l[?2004h>     for yy in range(max(0,y-r),min(H,y+r+1)):
[?2004l[?2004h>         for xx in range(max(0,x-r),min(W,x+r+1)):
[?2004l[?2004h>             pix[yy][xx]=1
[?2004l[?2004h> for a,b in segs:
[?2004l[?2004h>     ax=round((a[0]-u0)*S); ay=round((a[1]-v0)*S)
[?2004l[?2004h>     bx=round((b[0]-u0)*S); by=round((b[1]-v0)*S)
[?2004l[?2004h>     dx=abs(bx-ax); dy=-abs(by-ay)
[?2004l[?2004h>     sx=1 if ax<bx else -1; sy=1 if ay<by else -1; err=dx+dy
[?2004l[?2004h>     while True:
[?2004l[?2004h>         mark(ax,ay)
[?2004l[?2004h>         if ax==bx and ay==by: break
[?2004l[?2004h>         e2=2*err
[?2004l[?2004h>         if e2>=dy: err+=dy; ax+=sx
[?2004l[?2004h>         if e2<=dx: err+=dx; ay+=sy
[?2004l[?2004h> 
[?2004l[?2004h> def write_pgm(fn, flip_x=False, flip_y=False, margin=50):
[?2004l[?2004h>     a=[row[:] for row in pix]
[?2004l[?2004h>     if flip_x: a=[row[::-1] for row in a]
[?2004l[?2004h>     if flip_y: a=a[::-1]
[?2004l[?2004h>     h=len(a)+2*margin; w=len(a[0])+2*margin
[?2004l[?2004h>     with open(fn,'wb') as f:
[?2004l[?2004h>         f.write(f'P5\n{w} {h}\n255\n'.encode())
[?2004l[?2004h>         blank=bytearray([255])*w
[?2004l[?2004h>         for _ in range(margin): f.write(blank)
[?2004l[?2004h>         for row in a:
[?2004l[?2004h>             f.write(bytearray([255]*margin))
[?2004l[?2004h>             f.write(bytearray(0 if v else 255 for v in row))
[?2004l[?2004h>             f.write(bytearray([255]*margin))
[?2004l[?2004h>         for _ in range(margin): f.write(blank)
[?2004l[?2004h>     print(fn,w,h)
[?2004l[?2004h> 
[?2004l[?2004h> for fx in (False,True):
[?2004l[?2004h>     for fy in (False,True):
[?2004l[?2004h>         write_pgm(f'/tmp/text_fx{int(fx)}_fy{int(fy)}.pgm',fx,fy)
[?2004l[?2004h> PY
